{"id":32,"cluster_id":"CL-002","conclusion":"Court_of_X_has_jurisdiction","forum":"捷克法院","forum_type":"exclusive","alternative_forum_types":[],"conditional_answer":false,"explicit_abstention":false,"legal_basis":[{"instrument":"BRUSSELS_I_BIS","provision":"Art.24(3)"},{"instrument":"BRUSSELS_I_BIS","provision":"Art.24(1)"},{"instrument":"BRUSSELS_I_BIS","provision":"Art.27"}],"reasoning":"请求直接要求更正捷克不动产登记中体现所有权的记载，属于 Art.24(1) 的不动产物权专属管辖；德国法院应依 Art.27 依职权否认管辖。参见 C-417/15, Schmidt。","missing_facts":[],"accepted_conclusions":["Court_of_X_has_jurisdiction"],"accepted_forum_types":["exclusive"],"required_evidence":["BRUSSELS_I_BIS:Art.24(3)"],"accepted_evidence":["BRUSSELS_I_BIS:Art.24(3)","BRUSSELS_I_BIS:Art.24(1)","BRUSSELS_I_BIS:Art.27"],"review_source_stage":"A1_C1_AGREEMENT"}
