{"id":39,"cluster_id":"CL-007","conclusion":"Decline_in_favor_of_chosen_court","forum":"荷兰阿姆斯特丹法院","forum_type":"agreement","alternative_forum_types":[],"conditional_answer":false,"explicit_abstention":false,"legal_basis":[{"instrument":"BRUSSELS_I_BIS","provision":"Art.25(1)"},{"instrument":"BRUSSELS_I_BIS","provision":"Art.31(2)"},{"instrument":"BRUSSELS_I_BIS","provision":"Art.31(3)"}],"reasoning":"有效专属选择法院条款触发反“鱼雷”例外；荷兰指定法院受理后，法国法院应中止并在其确认管辖后让位。","missing_facts":[],"accepted_conclusions":["Decline_in_favor_of_chosen_court"],"accepted_forum_types":["agreement"],"required_evidence":["BRUSSELS_I_BIS:Art.25(1)"],"accepted_evidence":["BRUSSELS_I_BIS:Art.25(1)","BRUSSELS_I_BIS:Art.31(2)","BRUSSELS_I_BIS:Art.31(3)"],"review_source_stage":"A1_C1_AGREEMENT"}
