{"id":11,"cluster_id":"CL-011","conclusion":"Stay_for_first_seised","forum":"法国法院（先受理）；德国法院中止","forum_type":"lis_pendens","alternative_forum_types":[],"conditional_answer":false,"explicit_abstention":false,"legal_basis":[{"instrument":"BRUSSELS_I_BIS","provision":"Art.29"},{"instrument":"BRUSSELS_I_BIS","provision":"Art.29(1)"},{"instrument":"BRUSSELS_I_BIS","provision":"Art.29(3)"}],"reasoning":"合同赔偿与同一责任关系的消极确认具有同一诉因和对象；后受理的德国法院应中止。参见 C-406/92, Tatry。","missing_facts":[],"accepted_conclusions":["Stay_for_first_seised"],"accepted_forum_types":["lis_pendens"],"required_evidence":["BRUSSELS_I_BIS:Art.29(1)"],"accepted_evidence":["BRUSSELS_I_BIS:Art.29","BRUSSELS_I_BIS:Art.29(1)","BRUSSELS_I_BIS:Art.29(3)"],"review_source_stage":"A1_C1_AGREEMENT"}
