<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR>
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>DataTypes</SHORT-NAME>
      <ELEMENTS>

        <!-- 测试用例1：有VALUE-AXIS-DATA-TYPE-REF（优先级覆盖场景） -->
        <APPLICATION-PRIMITIVE-DATA-TYPE>
          <SHORT-NAME>SpeedDataType</SHORT-NAME>
          <SW-DATA-DEF-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <SW-DATA-DEF-PROPS-CONTENT>
                  <VALUE-AXIS-DATA-TYPE-REF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/DataTypes/BaseSpeedType</VALUE-AXIS-DATA-TYPE-REF>
                  <!-- 以下定义被VALUE-AXIS-DATA-TYPE-REF优先级覆盖 -->
                  <COMPU-METHOD-REF DEST="COMPU-METHOD">/CompuMethods/SpeedCompu</COMPU-METHOD-REF>
                  <UNIT-REF DEST="UNIT">/Units/KmPerHour</UNIT-REF>
                  <BASE-TYPE-REF DEST="SW-BASE-TYPE">/BaseTypes/Float32</BASE-TYPE-REF>
                </SW-DATA-DEF-PROPS-CONTENT>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </SW-DATA-DEF-PROPS>
        </APPLICATION-PRIMITIVE-DATA-TYPE>

        <!-- 测试用例2：无VALUE-AXIS-DATA-TYPE-REF（正常定义） -->
        <APPLICATION-PRIMITIVE-DATA-TYPE>
          <SHORT-NAME>TemperatureDataType</SHORT-NAME>
          <SW-DATA-DEF-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <SW-DATA-DEF-PROPS-CONTENT>
                  <COMPU-METHOD-REF DEST="COMPU-METHOD">/CompuMethods/TempCompu</COMPU-METHOD-REF>
                  <UNIT-REF DEST="UNIT">/Units/Celsius</UNIT-REF>
                  <BASE-TYPE-REF DEST="SW-BASE-TYPE">/BaseTypes/Float32</BASE-TYPE-REF>
                </SW-DATA-DEF-PROPS-CONTENT>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </SW-DATA-DEF-PROPS>
        </APPLICATION-PRIMITIVE-DATA-TYPE>

        <!-- 测试用例3：仅有VALUE-AXIS-DATA-TYPE-REF -->
        <APPLICATION-PRIMITIVE-DATA-TYPE>
          <SHORT-NAME>PressureDataType</SHORT-NAME>
          <SW-DATA-DEF-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <SW-DATA-DEF-PROPS-CONTENT>
                  <VALUE-AXIS-DATA-TYPE-REF DEST="APPLICATION-PRIMITIVE-DATA-TYPE">/DataTypes/BasePressureType</VALUE-AXIS-DATA-TYPE-REF>
                </SW-DATA-DEF-PROPS-CONTENT>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </SW-DATA-DEF-PROPS>
        </APPLICATION-PRIMITIVE-DATA-TYPE>

      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>