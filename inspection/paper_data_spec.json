        "auto.baseline.init",
        "auto.cases",
        "auto.required.p_ports",
        "auto.required.r_ports",
        "auto.required.runnables",
        "auto.required.timing_events",
        "auto.required.variable_accesses"
      ]
    },
    {
      "label": "app:A-1",
      "pattern": "^The 60 generation runs produced",
      "metrics": [
        "auto.n",
        "auto.components",
        "auto.interfaces",
        "auto.components.elements.min",
        "auto.components.elements.max",
        "auto.interfaces.elements.min",
        "auto.xml.depth.max",
        "auto.root_level",
        "auto.largest.elements"
      ]
    },
    {
      "label": "app:A-2",
      "pattern": "^The model generation experiment used",
      "metrics": [
        "icm.constraints",
        "icm.links",
        "icm.nodes",
        "icm.relationships"
      ]
    },
    {
      "label": "app:A-2",
      "pattern": "^The validation plan contains",
      "metrics": [
        "icm.rules",
        "icm.rules.python",
        "icm.rules.dsl"
      ]
    },
    {
      "label": "app:A-3",
      "pattern": "^Controlled repair used reference",
      "metrics": [
        "auto.repair.core.n",
        "auto.repair.sub.n"
      ]
    },
    {
      "label": "app:A-3",
      "pattern": "^The reference file sets",
      "metrics": [
        "auto.repair.core.pass",
        "auto.repair.core.n",
        "auto.repair.sub.pass",
        "auto.repair.sub.n",
        "auto.repair.core.responses",
        "auto.repair.core.tokens",
        "auto.repair.sub.responses",
        "auto.repair.sub.tokens"
      ]
    },
    {
      "label": "app:B-2",
      "pattern": "^All 60 audited generations",
      "metrics": [
        "vllm.bound_runs",
        "vllm.bound.min",
        "vllm.bound.max",
        "vllm.bound",
        "vllm.steps",
        "vllm.equal_pairs"
      ]
    },
    {
      "label": "app:B-2",
      "pattern": "^Auditing added a mean",
      "metrics": [
        "vllm.overhead.mean",
        "vllm.overhead.median",
        "vllm.overhead.percent"
      ]
    },
    {
      "label": "app:C-2",
      "pattern": "^Across the 48 fixed-damage",
      "metrics": [
        "rail.R.inputs",
        "rail.R.S.stable",
        "rail.R.V.stable"
      ]
    },
    {
      "label": "app:C-2",
      "pattern": "^Of the 49 failed initial",
      "metrics": [
        "rail.G.failed",
        "rail.G.failed_models",
        "rail.G.GF.recovered",
        "rail.G.remaining_models",
        "rail.G.GF.stop.regression",
        "rail.G.GF.stop.ABSTAIN",
        "rail.G.GF.stop.no_finding_resolved",
        "rail.G.missing"
      ]
    },
    {
      "label": "app:C-2",
      "pattern": "^The 72 responses for G0",
      "metrics": [
        "rail.G.G0.responses",
        "rail.G.G0.tokens",
        "rail.G.G0.seconds",
        "rail.G.GS.responses",
        "rail.G.GS.tokens",
        "rail.G.GS.seconds",
        "rail.G.GF.responses",
        "rail.G.GF.tokens",
        "rail.G.GF.seconds",
        "rail.total.responses",
        "rail.total.tokens",
        "rail.total.seconds"
      ]
    },
    {
      "label": "app:C-3",
      "pattern": "^The 60 retained Terra responses",
      "metrics": [
        "terra.responses",
        "terra.tokens",
        "terra.input",
        "terra.output"
      ]
    },
    {
      "label": "app:D-2",
      "pattern": "^Mean citation F1 scores",
      "metrics": [
        "pil.p0.f1",
        "pil.p1.f1",
        "pil.p2.f1",
        "pil.p3.f1",
        "pil.p0.tokens.mean",
        "pil.p1.tokens.mean",
        "pil.p2.tokens.mean",
        "pil.p3.tokens.mean"
      ]
    },
    {
      "label": "sec:eval-4-2",
      "pattern": "^AUTOSAR describes automotive",
      "metrics": [
        "auto.cases",
        "auto.tier.minimal",
        "auto.tier.standard",
        "auto.tier.full"
      ],
      "capture": "designed (\\d+) requirements.*produced (\\d+) minimal, (\\d+) standard, and (\\d+) full"
    },
    {
      "label": "sec:eval-4-2",
      "pattern": "^Constructing these models involves",
      "metrics": [
        "auto.xml.depth.max",
        "auto.root_level"
      ]
    },
    {
      "label": "sec:eval-4-2",
      "pattern": "^The existence of a period",
      "metrics": [
        "auto.baseline.period_ms",
        "auto.baseline.period"
      ]
    },
    {
      "label": "sec:eval-4-4",
      "pattern": "^The railway experiment uses the existing",
      "metrics": [
        "rail.cases"
      ]
    },
    {
      "label": "sec:eval-4-4",
      "pattern": "^Each task was run three times",
      "metrics": [
        "rail.G.G0.n"
      ]
    },
    {
      "label": "sec:eval-4-5",
      "pattern": "^Two graduate students in private",
      "metrics": [
        "pil.cases"
      ]
    },
    {
      "label": "app:A-1",
      "pattern": "^The 20 requirements were designed",
      "metrics": [
        "auto.cases"
      ],
      "capture": "^The (\\d+) requirements"
    },
    {
      "label": "app:A-2",
      "pattern": "^All 60 generation runs passed",
      "metrics": [
        "auto.pass"
      ]
    },
    {
      "label": "app:A-2",
      "pattern": "^Post-generation validation first checks the actual",
      "metrics": [
        "auto.baseline.period_ms",
        "auto.baseline.period"
      ]
    },
    {
      "label": "app:C-1",
      "pattern": "^The experiment reused the Train",
      "metrics": [
        "rail.cases"
      ]
    },
    {
      "label": "app:C-2",
      "pattern": "^For example, repair with validation feedback and self",
      "metrics": [
        "rail.G.GF.pass",
        "rail.G.GF.n",
        "rail.G.GS.pass",
        "rail.G.GS.n",
        "rail.G.GF-GS.diff"
      ]
    },
    {
      "label": "app:C-3",
      "pattern": "^The second model was",
      "metrics": [
        "rail.seed1",
        "terra.n"
      ]
    },
    {
      "label": "app:D-2",
      "pattern": "^The P3 records that passed",
      "metrics": [
        "pil.p3.system_release",
        "pil.p3.endpoint_success",
        "pil.repairs",
        "pil.recovered",
        "pil.repaired_endpoint",
        "pil.induced"
      ]
    },
    {
      "label": "app:C-2",
      "pattern": "^Across the 48 fixed-damage",
      "metrics": [
        "rail.R.F.stable"
      ],
      "capture": "and (\\d+) inputs under each of V and F"
    },
    {
      "label": "app:C-2",
      "pattern": "^Results are paired by condition within each",
      "metrics": [
        "rail.cases",
        "rail.stats.draws",
        "rail.stats.confidence",
        "rail.cases"
      ],
      "capture": "each of the (\\d+) tasks.*from ([\\d,]+) paired resamples.*= ([\\d.]+)\\\\%.*tasks is (\\d+)"
    }
  ]
}
