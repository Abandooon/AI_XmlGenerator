{
  "task_id": "BAL-1-01",
  "requirements": [
    {
      "id": "REQ-LAYOUT",
      "text": "Configure the supplied engineering model of a directed six-segment chain. Preserve all physical connections, objects and unlisted fields. The JSON physical model is the exact directed layout. This is a configuration model, not a proof of physical train routing or operational safety."
    },
    {
      "id": "REQ-SERVICE",
      "text": "Create and keep active services r1 and r2. Service r1 starts at m_in and follows p1 on w1. Service r2 ends at m_out and follows the declared position objects. Every planned switch position is DIVERGING and must be preserved. Configure actual switch positions and route sensor requirements using the public typed domains; satisfy all six supplied Train queries. The exact r2 plan is p2 on w2."
    },
    {
      "id": "REQ-BOUNDARY",
      "text": "Select the exit of r1 from m_boundary or m_out and the entry of r2 from m_in or m_boundary. These are configuration choices; satisfy the supplied SemaphoreNeighbor relation wherever required sensors monitor adjacent track elements. Both permitted entry signals are GO."
    },
    {
      "id": "REQ-MONITOR",
      "text": "Sensor n1 must monitor w1 and t1; n2 must monitor w2 and t2; n3 must monitor t3. Existing sensors n4 and n6 monitor t4, and n5 monitors t5; preserve their monitoring. Additional monitoring by n1, n2 or n3 is permitted only within each public field domain and must satisfy the supplied constraints. Do not remove mandatory coverage to avoid a query violation."
    },
    {
      "id": "REQ-FIELDS",
      "text": "Each route must require at least two distinct permitted sensors. Repair declared segment lengths only to 20 or 40. Semantic assignment slots start unresolved; all listed obligations and the fixed structural plan must hold in the delivered native model."
    }
  ],
