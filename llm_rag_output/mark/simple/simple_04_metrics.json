          "data_category": "控制命令（门锁）",
          "connected_components": [
            "CAN_Gateway",
            "DoorLock_Controller"
          ],
          "performance_requirements": "端到端传输<20ms；丢包可接受（最新值语义）；命令变化抖动<10ms。",
          "data_elements": [
