            "door_id:uint8",
            "action:enum{LOCK,UNLOCK,STOP}",
            "request_id:uint16",
            "timestamp:uint32"
          ],
          "direct_paths": "CAN_Gateway Decode_Runnable -> SR publish -> Controllers R-Port"
        },
        {
          "interface_id": "if_uds_01",
          "name": "UDS_Service_IF",
          "type": "CLIENT-SERVER-INTERFACE",
          "communication_pattern": "客户端（CAN_Gateway）发起异步或同步服务调用到Diagnostic_Manager（支持同步调用用于敏感NV访问，支持异步用于转发场景）；传输可能为分帧TP，需上层重组；错误处理遵循UDS（NRC/timeout/retry）。",
          "data_category": "Diagnostic_TP",
          "connected_components": [
            "CAN_Gateway",
            "Diagnostic_Manager"
          ],
          "performance_requirements": "P2响应时间遵循UDS配置（典型<=100ms），超时与重试策略配置化；分帧重组有缓冲与超时保护。",
          "data_elements": [
            "uds_payload:byte[]",
            "session_type:uint8",
            "request_id:uint16"
          ],
          "direct_paths": "CAN_Gateway SERVER-CALL -> Diagnostic_Manager R-Port -> Diagnostic_Manager processes -> response via CLIENT callback"
        }
      ],
      "component_generation_order": [
        "Diagnostic_Manager",
        "CAN_Gateway",
        "Door_Lock_Controller",
        "Window_Controller"
      ],
      "connection_topology": {
        "component_connections": "CAN_Bus_IF连接外部CAN硬件与CAN_Gateway；CAN_Gateway通过CAN_Command_IF向Door_Lock_Controller和Window_Controller发布解码后的命令；CAN_Gateway通过UDS_Service_IF与Diagnostic_Manager建立Client-Server关系。",
        "data_flow_paths": "外部CAN->CAN_Gateway(CAN_Bus_IF)->内部解码->CAN_Command_IF->Door_Lock_Controller/Window_Controller; 诊断帧: CAN_Gateway->UDS_Service_IF->Diagnostic_Manager->响应返回。",
        "control_flow_paths": "控制命令触发控制器runnable（事件驱动）并在Control_Cycle中执行伺服逻辑；Diagnostic_Manager对NV访问为同步ServerCall；CAN_Gateway对Diagnostic_Manager支持异步与同步两种调用模式。"
      },
      "architecture_rationale": {
        "design_decisions": "采用集中式CAN解码与路由(CAN_Gateway)以避免每个控制器重复解析CAN帧，便于消息过滤和安全性检查；控制器专注电机控制逻辑并通过同步ServerCall访问驱动，保持硬件抽象；Diagnostic_Manager集中处理UDS以保证一致的诊断行为和NV管理。",
        "tradeoff_analysis": "集中解码简化控制器实现但增加了CAN_Gateway负载，选择表驱动解码和可扩展解析线程以应对负载；同步ServerCall保证一致的NV访问但可能增加延迟，针对非关键路径使用异步转发以提高响应性；将诊断集中有利于一致性但在高负载下可能成为瓶颈，需增加优先级管理。",
        "alternative_considerations": "可选方案为分布式CAN解析（每控制器解析各自ID）以降低Gateway负载，但增加重复代码与一致性风险；另一方案是将驱动抽象单独作为ECU_Abstraction组件，当前设计将驱动访问通过ServerCall抽象以便Round2扩展为单独组件。",
        "risk_assessment": "风险：CAN_Gateway成为单点性能瓶颈或故障点（缓解：队列深度/多线程/优先级）；UDS处理逻辑错误可能影响车辆诊断（缓解：单元测试与故障隔离）；电机控制超时或ServerCall失败可能导致功能不可用（缓解：超时与回退策略、故障上报）。"
