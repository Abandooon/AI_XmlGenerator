          ],
          "performance_requirements": "接收处理延时<5ms；丢帧率低于0.1%；使用硬件中断+软件队列缓冲（深度可配置）",
          "data_elements": [
            "can_id:uint32",
            "dlc:uint8",
            "data:byte[8]",
            "timestamp:uint32"
          ],
          "direct_paths": "硬件CAN控制器 -> CAN_Gateway R-Port (中断触发 -> 软件队列)"
        },
        {
          "interface_id": "if_cmd_01",
          "name": "CAN_Command_IF",
          "type": "SENDER-RECEIVER-INTERFACE",
          "communication_pattern": "解码后命令以Sender-Receiver发布（事件触发）；采用最新值策略并支持短期队列用于突发负载",
          "data_category": "Control_Command",
          "connected_components": [
            "CAN_Gateway",
            "Door_Lock_Controller",
            "Window_Controller"
          ],
          "performance_requirements": "端到端延时（CAN_Gateway解码到控制器接收）<=10ms；消息优先级支持锁命令优先。",
          "data_elements": [
