          "data_category": "measurement",
          "connected_components": [
            "VoltageMonitor",
            "DataAggregator"
          ],
          "performance_requirements": "更新周期10ms; 最长传输与调度延迟≤1ms; 数据最大老化≤50ms。",
          "data_elements": [
            "voltage_mV"
          ],
          "direct_paths": "VoltageMonitor.P_Voltage -> DataAggregator.R_Voltage"
        },
        {
          "interface_id": "if.current_meas",
          "name": "Current_Measurement_I",
          "type": "SENDER-RECEIVER-INTERFACE",
