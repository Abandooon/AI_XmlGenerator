  "requirement": {
    "system_name": "BodyComfortController",
    "description": "管理门窗、座椅、空调、氛围灯",
    "components_count": 7,
    "component_types": [
      "DoorWindowManager",
      "SeatManager",
      "ClimateControl",
      "AmbientLighting",
