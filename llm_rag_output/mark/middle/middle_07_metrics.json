          "estimated_complexity": "Complex",
          "port_estimates": {
            "input_ports": "4",
            "output_ports": "4"
          },
          "behavioral_characteristics": "聚合来自Temp_Monitor和各Cooling SWC的温度与状态，运行优化算法（周期性或事件触发，默认200ms）生成泵速/阀门设定与优先级，并通过同步客户端调用下发命令；包含策略选择、约束检查与冲突解决。数据流：收集→评估→优化→下发→确认/回退。",
          "element_design": {
            "ports": {
              "needed": true,
              "types": [
                "PR-PORT-PROTOTYPE",
                "P-PORT-PROTOTYPE",
                "R-PORT-PROTOTYPE"
              ],
              "details": "作为Pump/Valve的客户端（PR-PORT），订阅温度与状态（R-PORT），发布优化决策日志（P-PORT）。"
            },
            "internal_behaviors": {
              "needed": true,
              "events": [
                {
                  "type": "TIMING-EVENT",
                  "name": "Optimizer_Cycle_200ms",
                  "trigger": "周期200ms执行优化"
