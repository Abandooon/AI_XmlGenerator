      "ABSController防抱死制动",
      "EPSController电动助力转向",
      "ESPController车身稳定控制",
      "WheelSpeedProcessor处理4个轮速传感器数据",
      "SafetyMonitor实现ASIL-D安全监控",
      "多条CAN总线互联"
    ]
  },
  "start_time": "2025-10-23T20:13:15.679250",
  "phase1": {
    "duration": 160.6391966342926,
