{
  "SENSOR-ACTUATOR-SW-COMPONENT-TYPE": {
    "SHORT-NAME": "Radar_Processor",
    "PORTS": {
      "P-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "P_Port_RadarDataIn",
          "PROVIDED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/Sensor_Data_Interface_RadarCamera"
          }
        }
      ],
      "R-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "R_Port_RadarDataOut",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/Sensor_Data_Interface_RadarCamera"
          },
          "SYMBOL": "RadarDataOutSymbol"
        }
      ]
    },
    "SWC-INTERNAL-BEHAVIOR": {
      "SHORT-NAME": "RadarDataAcquisition_BHV",
      "RUNNABLE-ENTITY": [
        {
          "SHORT-NAME": "RadarDataAcquisition_Runnable",
          "MINIMUM-START-INTERVAL": 0,
          "CAN-BE-INVOKED-CONCURRENTLY": "false",
          "DATA-RECEIVE-POINT-BY-ARGUMENTS": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "RadarDataInput",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "P-PORT-PROTOTYPE",
                      "#text": "/Components/Radar_Processor/P_Port_RadarDataIn"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "VARIABLE-DATA-PROTOTYPE",
                      "#text": "/Interfaces/Sensor_Data_Interface_RadarCamera/RadarData"
                    }
                  }
                }
              }
            ]
          },
          "DATA-SEND-POINTS": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "RadarDataOutput",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "R-PORT-PROTOTYPE",
                      "#text": "/Components/Radar_Processor/R_Port_RadarDataOut"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "VARIABLE-DATA-PROTOTYPE",
                      "#text": "/Interfaces/Sensor_Data_Interface_RadarCamera/RadarData"
                    }
                  }
                }
              }
            ]
          },
          "notes": "RadarDataAcquisition_Runnable handles input RadarData and outputs RadarData via RadarDataOut"
        }
      ],
      "EVENTS": {
        "DATA-RECEIVED-EVENT": {
          "DATA-RECEIVED-EVENT": [
            {
              "SHORT-NAME": "RadarDataReady",
              "START-ON-EVENT-REF": {
                "@DEST": "RUNNABLE-ENTITY",
                "#text": "/Components/Radar_Processor/RadarDataAcquisition_Runnable"
              },
              "EVENT-SOURCE-REF": {
                "@DEST": "VARIABLE-ACCESS",
                "#text": "/Interfaces/Sensor_Data_Interface_RadarCamera/RadarData"
              }
            }
          ]
        },
        "DATA-SEND-COMPLETED-EVENT": {
          "DATA-SEND-COMPLETED-EVENT": [
            {
              "SHORT-NAME": "RadarDataSent",
              "START-ON-EVENT-REF": {
                "@DEST": "RUNNABLE-ENTITY",
                "#text": "/Components/Radar_Processor/RadarDataAcquisition_Runnable"
              },
              "EVENT-SOURCE-REF": {
                "@DEST": "VARIABLE-ACCESS",
                "#text": "/Interfaces/Sensor_Data_Interface_RadarCamera/RadarData"
              }
            }
          ]
        }
      }
    }
  }
}