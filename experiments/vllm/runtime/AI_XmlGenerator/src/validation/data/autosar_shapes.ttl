#################################################################
# SHACL for swImplPolicy for ParameterDataPrototype in role constantMemory
#################################################################

autosar:constr_2046_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:PARAMETER-DATA-PROTOTYPE ;

    # SW-DATA-DEF-PROPS is optional; if present, we check its SW-IMPL-POLICY
    sh:property [
        sh:path autosar:SW-DATA-DEF-PROPS ;
        sh:node autosar:constr_2046_SwDataDefPropsShape
    ] ;
.

autosar:constr_2046_SwDataDefPropsShape
    a sh:NodeShape ;
    sh:property [
        sh:path ( autosar:SW-DATA-DEF-PROPS-CONTENT autosar:SW-IMPL-POLICY ) ;
        sh:in ( "standard" "const" "fixed" )
    ] ;
.

#################################################################
# SHACL for swImplPolicy for ArgumentDataPrototype
#################################################################

autosar:constr_2047_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:ARGUMENT-DATA-PROTOTYPE ;

    sh:property [
        sh:path autosar:SW-DATA-DEF-PROPS ;
        sh:node autosar:constr_2047_SwDataDefPropsShape
    ] ;
.

autosar:constr_2047_SwDataDefPropsShape
    a sh:NodeShape ;
    sh:property [
        sh:path ( autosar:SW-DATA-DEF-PROPS-CONTENT autosar:SW-IMPL-POLICY ) ;
        sh:hasValue "standard"
    ] ;
.

#################################################################
# SHACL for swImplPolicy for SwServiceArg
#################################################################

autosar:constr_2048_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:SW-SERVICE-ARG ;

    sh:property [
        sh:path autosar:SW-DATA-DEF-PROPS ;
        sh:node autosar:constr_2048_SwDataDefPropsShape
    ] ;
.

autosar:constr_2048_SwDataDefPropsShape
    a sh:NodeShape ;
    sh:property [
        sh:path ( autosar:SW-DATA-DEF-PROPS-CONTENT autosar:SW-IMPL-POLICY ) ;
        sh:in ( "standard" "const" )
    ] ;
.

#################################################################
# SHACL for Different ModeDeclarationGroups shall have different shortNames.
# (structural part only: SHORT-NAME must exist on MODE-DECLARATION-GROUP)
#################################################################

autosar:constr_2049_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:MODE-DECLARATION-GROUP ;

    sh:property [
        sh:path autosar:SHORT-NAME ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
.

#################################################################
# SHACL for Mandatory information of a SwAxisCont
#################################################################

autosar:constr_2050_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:SW-AXIS-CONT ;

    sh:property [
        sh:path autosar:SW-AXIS-INDEX ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;

    sh:property [
        sh:path autosar:SW-ARRAYSIZE ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
.

#################################################################
# SHACL for Mandatory information of a SwValueCont
# (conditional in expression; SHACL only enforces if-present-then-structure)
#################################################################

autosar:constr_2051_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:SW-VALUE-CONT ;

    # swArraysize is optional in schema; no minCount here (C1)
    sh:property [
        sh:path autosar:SW-ARRAYSIZE
    ] ;
.

#################################################################
# SHACL for consistency of swArraySize and swValuesPhys
# (only basic existence; numeric consistency handled in SMT)
#################################################################

autosar:constr_2052_Shape_SwAxisCont
    a sh:NodeShape ;
    sh:targetClass autosar:SW-AXIS-CONT ;

    sh:property [
        sh:path autosar:SW-ARRAYSIZE ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;

    sh:property [
        sh:path autosar:SW-VALUES-PHYS ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
.

autosar:constr_2052_Shape_SwValueCont
    a sh:NodeShape ;
    sh:targetClass autosar:SW-VALUE-CONT ;

    # swArraysize and swValuesPhys are optional structurally
    sh:property [
        sh:path autosar:SW-ARRAYSIZE
    ] ;

    sh:property [
        sh:path autosar:SW-VALUES-PHYS
    ] ;
.


autosar:Constr_2053_Consistency_IUMPRNumerator_ObdRatioServiceNeedsConnectionType
    a sh:NodeShape ;
    sh:targetClass autosar:SWC-SERVICE-DEPENDENCY ;
    sh:property [
        sh:path ( autosar:SERVICE-NEEDS autosar:OBD-RATIO-SERVICE-NEEDS autosar:CONNECTION-TYPE ) ;
    ] ;
    sh:property [
        sh:path ( autosar:ROLE-BASED-PORT-ASSIGNMENT autosar:ROLE ) ;
    ] ;
    sh:sparql [
        sh:message "If a SwcServiceDependency with an ObdRatioServiceNeeds is defined and connectionType = apiUse, a RoleBasedPortAssignment with role IUMPRNumerator shall be defined; if connectionType = observer, role IUMPRNumerator is not applicable." ;
        sh:severity sh:Violation ;
        sh:select """
PREFIX autosar: <http://autosar.org/>

SELECT ?this
WHERE {
  ?this autosar:SERVICE-NEEDS ?sn .
  ?sn autosar:OBD-RATIO-SERVICE-NEEDS ?orn .
  ?orn autosar:CONNECTION-TYPE ?ct .

  OPTIONAL {
    ?this autosar:ROLE-BASED-PORT-ASSIGNMENT ?rpa .
    ?rpa autosar:ROLE ?roleVal .
  }

  FILTER (
    (?ct = "apiUse" && (!bound(?roleVal) || ?roleVal != "IUMPRNumerator")) ||
    (?ct = "observer" && bound(?roleVal) && ?roleVal = "IUMPRNumerator")
  )
}
""" ;
    ] .

autosar:Constr_2054_ValidTargets_rptSystem
    a sh:NodeShape ;
    sh:targetClass autosar:SYSTEM ;
    sh:property [
        sh:path autosar:CATEGORY ;
        sh:hasValue "RPT_SYSTEM" ;
        sh:severity sh:Violation ;
        sh:message "The System referenced in the role rptSystem shall be of category RPT_SYSTEM." ;
    ] .

autosar:Constr_2055_ValidTargets_byPassPoint_rptHook
    a sh:NodeShape ;
    sh:targetClass autosar:RPT-CONTAINER ;
    sh:property [
        sh:path autosar:CATEGORY ;
    ] ;
    sh:property [
        sh:path ( autosar:BY-PASS-POINT-IREFS autosar:BY-PASS-POINT-IREF ) ;
    ] ;
    sh:property [
        sh:path ( autosar:RPT-HOOK autosar:RPT-AR-HOOK-IREF ) ;
    ] .

autosar:Constr_2056_Consistency_RapidPrototypingScenario_rptSystem_rptArHook
    a sh:NodeShape ;
    sh:targetClass autosar:RAPID-PROTOTYPING-SCENARIO ;
    sh:property [
        sh:path autosar:RPT-SYSTEM-REF ;
    ] ;
    sh:property [
        sh:path ( autosar:RPT-HOOK autosar:RPT-AR-HOOK-IREF ) ;
    ] ;
    sh:sparql [
        sh:message "Within one RapidPrototypingScenario all rptSystem references shall point to instances in one and only one System and, if existent, all rptArHook shall point to instances in one other and only one other System." ;
        sh:severity sh:Violation ;
        sh:select """
PREFIX autosar: <http://autosar.org/>

SELECT ?this
WHERE {
  {
    SELECT ?this (COUNT(DISTINCT ?sys) AS ?sysCount)
    WHERE {
      ?this autosar:RPT-SYSTEM-REF ?rptSysRef .
      ?rptSysRef autosar:DEST ?sys .
    }
    GROUP BY ?this
  }
  FILTER(?sysCount != 1)

  UNION

  {
    SELECT ?this (COUNT(DISTINCT ?hookSys) AS ?hookSysCount)
    WHERE {
      ?this autosar:RPT-HOOK ?hook .
      ?hook autosar:RPT-AR-HOOK-IREF ?href .
      ?href autosar:DEST ?hookSys .
    }
    GROUP BY ?this
    HAVING(?hookSysCount != 1)
  }
}
""" ;
    ] .

autosar:Constr_2057_Mandatory_RuleBasedAxisCont
    a sh:NodeShape ;
    sh:targetClass autosar:RULE-BASED-AXIS-CONT ;
    sh:property [
        sh:path autosar:SW-ARRAYSIZE ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "RuleBasedAxisCont shall define one swArraysize value per dimension when swAxisCont is defined on the owning ApplicationRuleBasedValueSpecification." ;
    ] ;
    sh:property [
        sh:path autosar:SW-AXIS-INDEX ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "RuleBasedAxisCont shall define one swAxisIndex value per dimension when swAxisCont is defined on the owning ApplicationRuleBasedValueSpecification." ;
    ] .

autosar:Constr_2058_Mandatory_RuleBasedValueCont_swArraysize
    a sh:NodeShape ;
    sh:targetClass autosar:RULE-BASED-VALUE-CONT ;
    sh:property [
        sh:path autosar:SW-ARRAYSIZE ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "If swValueCont is defined and the owning ApplicationRuleBasedValueSpecification is of category CURVE, MAP, CUBOID, CUBE_4, CUBE_5, COM_AXIS, RES_AXIS, CURVE_AXIS, VAL_BLK or ARRAY, RuleBasedValueCont shall define swArraysize." ;
    ] .

autosar:Constr_2535_Target_autosarParameterRef_parameter
    a sh:NodeShape ;
    sh:targetClass autosar:AUTOSAR-PARAMETER-REF ;
    sh:property [
        sh:path autosar:AUTOSAR-PARAMETER-IREF ;
    ] .


#################################################################
# SHACL shapes
#################################################################

########## constr_2536 - Target of an autosarVariable in AutosarVariableRef shall refer to a variable

autosar:Constr_2536_TargetOfAutosarVariableRefShape
    a sh:NodeShape ;
    sh:severity sh:Violation ;
    sh:targetClass autosar:AUTOSAR-VARIABLE-REF ;

    sh:property [
        sh:path ( autosar:AUTOSAR-VARIABLE-REF autosar:AUTOSAR-VARIABLE-IREF ) ;
        sh:maxCount 1 ;
    ] .

########## constr_2544 - Limits need to be consistent
# Complex numeric / range consistency across ApplicationDataType, CompuMethod,
# ImplementationDataType and BaseType; left to SMT.

########## constr_2545 - invalidValue shall fit in the specified ranges

autosar:Constr_2545_InvalidValueRangeShape
    a sh:NodeShape ;
    sh:severity sh:Info ;
    sh:targetClass autosar:IMPLEMENTATION-DATA-TYPE ;

    sh:property [
        sh:path ( autosar:SW-DATA-DEF-PROPS-CONTENT autosar:INVALID-VALUE ) ;
        sh:maxCount 1 ;
    ] .

########## constr_2548 - Data constraint of value axis shall match
# Cross-object semantic inclusion of dataConstr ranges; handled in SMT.

autosar:Constr_2548_DataConstrOfValueAxisShape
    a sh:NodeShape ;
    sh:severity sh:Violation ;
    sh:targetClass autosar:SW-DATA-DEF-PROPS-CONTENT ;

    sh:property [
        sh:path ( autosar:SW-DATA-DEF-PROPS-CONTENT autosar:DATA-CONSTR-REF ) ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path ( autosar:SW-DATA-DEF-PROPS-CONTENT autosar:VALUE-AXIS-DATA-TYPE-REF ) ;
        sh:maxCount 1 ;
    ] .

########## constr_2549 - Units of input axis shall be consistent
# Only structural parts in SHACL; semantic “compatible units” in SMT.

autosar:Constr_2549_UnitsOfInputAxisShape
    a sh:NodeShape ;
    sh:severity sh:Info ;
    sh:targetClass autosar:SW-AXIS-INDIVIDUAL ;

    sh:property [
        sh:path ( autosar:SW-AXIS-INDIVIDUAL autosar:INPUT-VARIABLE-TYPE-REF ) ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path ( autosar:SW-AXIS-INDIVIDUAL autosar:SW-VARIABLE-REFS ) ;
    ] ;

    sh:property [
        sh:path ( autosar:SW-AXIS-INDIVIDUAL autosar:COMPU-METHOD-REF ) ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path ( autosar:SW-AXIS-INDIVIDUAL autosar:UNIT-REF ) ;
        sh:maxCount 1 ;
    ] .

########## constr_2550 - Units of value axis shall be consistent
# Structural part only; semantic “same units” in SMT.

autosar:Constr_2550_UnitsOfValueAxisShape
    a sh:NodeShape ;
    sh:severity sh:Info ;
    sh:targetClass autosar:SW-DATA-DEF-PROPS-CONTENT ;

    sh:property [
        sh:path ( autosar:SW-DATA-DEF-PROPS-CONTENT autosar:COMPU-METHOD-REF ) ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path ( autosar:SW-DATA-DEF-PROPS-CONTENT autosar:UNIT-REF ) ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path ( autosar:SW-DATA-DEF-PROPS-CONTENT autosar:VALUE-AXIS-DATA-TYPE-REF ) ;
        sh:maxCount 1 ;
    ] .

########## constr_2561 - Application of DataConstrRule.constrLevel

autosar:Constr_2561_DataConstrRuleConstrLevelShape
    a sh:NodeShape ;
    sh:severity sh:Violation ;
    sh:targetClass autosar:DATA-CONSTR-RULE ;

    sh:property [
        sh:path ( autosar:DATA-CONSTR-RULE autosar:CONSTR-LEVEL ) ;
        sh:maxCount 1 ;
        sh:in ( 0 1 ) ;
    ] .


#################################################################
# SHACL shapes for given constraints
#################################################################

########## constr_4000 – Local communication of mode switches ##########
# Semantics: purely deployment / ECU-boundary related, no stable
# XML-local structure to express in SHACL → left to SMT only.


########## constr_4002 – Unambiguous mapping of modes to data types ##########
# Semantics: uniqueness of mapping of a ModeDeclarationGroup to
# ImplementationDataTypes within one DATA-TYPE-MAPPING-SET.
# This is a global uniqueness constraint → handled in SMT only.


########## constr_4003 – Semantics of SwcModeSwitchEvent ##########

autosar:Constr_4003_SwcModeSwitchEventShape
    a sh:NodeShape ;
    sh:targetClass autosar:SWC-MODE-SWITCH-EVENT ;

    # activation is mandatory and of type ModeActivationKind (structural)
    sh:property [
        sh:path autosar:ACTIVATION ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    # MODE-IREFs wrapper and MODE-IREF elements
    sh:property [
        sh:path ( autosar:MODE-IREFS autosar:MODE-IREF ) ;
        sh:minCount 1 ;
        sh:maxCount 2 ;
    ] ;

    # Informational SPARQL check for the "onTransition ⇒ exactly two modes"
    sh:sparql [
        sh:message "If ACTIVATION is 'onTransition' then there shall be exactly two MODE-IREFs; otherwise exactly one." ;
        sh:severity sh:Info ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this
            WHERE {
              ?this autosar:ACTIVATION ?act .
              OPTIONAL {
                ?this autosar:MODE-IREFS ?w .
                ?w autosar:MODE-IREF ?m .
              }
              BIND(COALESCE(COUNT(?m), 0) AS ?cnt)
              FILTER(
                (?act = autosar:ON-TRANSITION && ?cnt != 2) ||
                (?act != autosar:ON-TRANSITION && ?cnt != 1)
              )
            }
            GROUP BY ?this ?act
        """ ;
    ] .

########## constr_4004 – Context of SenderReceiverAnnotation ##########

# Target is SenderReceiverAnnotation; we only check local aggregation context.
# autosar:Constr_4004_SenderReceiverAnnotationShape
#     a sh:NodeShape ;
#     sh:targetClass autosar:SENDER-RECEIVER-ANNOTATION ;

    # Informational: must be aggregated by a PortPrototype that is typed
    # by a SenderReceiverInterface – requires cross-element reasoning,
    # left mainly to SMT. No stable local path from the annotation itself.


########## constr_4005 – Context of ClientServerAnnotation ##########

autosar:Constr_4005_ClientServerAnnotationShape
    a sh:NodeShape ;
    sh:targetClass autosar:CLIENT-SERVER-ANNOTATION ;

    # Structural: occurrence under the various PortPrototype specializations
    sh:property [
        sh:path ( autosar:CLIENT-SERVER-ANNOTATIONS autosar:CLIENT-SERVER-ANNOTATION ) ;
    ] .

########## constr_4006 – Context of ParameterPortAnnotation ##########

autosar:Constr_4006_ParameterPortAnnotationShape
    a sh:NodeShape ;
    sh:targetClass autosar:PARAMETER-PORT-ANNOTATION ;

    # Structural: occurrence under P-PORT-PROTOTYPE
    sh:property [
        sh:path ( autosar:PARAMETER-PORT-ANNOTATIONS autosar:PARAMETER-PORT-ANNOTATION ) ;
    ] .

########## constr_4007 – Context of ModePortAnnotation ##########

autosar:Constr_4007_ModePortAnnotationShape
    a sh:NodeShape ;
    sh:targetClass autosar:MODE-PORT-ANNOTATION ;

    # Structural: occurrence under PortPrototype specializations
    sh:property [
        sh:path ( autosar:MODE-PORT-ANNOTATIONS autosar:MODE-PORT-ANNOTATION ) ;
    ] .


#################################################################
# SHACL shapes
#################################################################

#################################################################
# constr_4008 - Context of TriggerPortAnnotation
# A TriggerPortAnnotation shall only be aggregated by a
# PortPrototype typed by a TriggerInterface.
#################################################################

autosar:Constr_4008_TriggerPortAnnotationShape
    a sh:NodeShape ;
    sh:targetClass autosar:TRIGGER-PORT-ANNOTATION ;
    sh:severity sh:Violation ;
    sh:message "A TRIGGER-PORT-ANNOTATION shall only be aggregated by a PortPrototype typed by a TRIGGER-INTERFACE." ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "TRIGGER-PORT-ANNOTATION must be attached to a PortPrototype whose type is TRIGGER-INTERFACE." ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this
            WHERE {
              ?port (autosar:TRIGGER-PORT-ANNOTATIONS/autosar:TRIGGER-PORT-ANNOTATION) ?this .
              OPTIONAL { ?port autosar:TYPE ?ifc . }
              FILTER ( !BOUND(?ifc) || !EXISTS { ?ifc a autosar:TRIGGER-INTERFACE } )
            }
        """ ;
    ] .

#################################################################
# constr_4009 - Context of NvDataPortAnnotation
# An NvDataPortAnnotation shall only be aggregated by a
# PortPrototype typed by an NvDataInterface.
#################################################################

autosar:Constr_4009_NvDataPortAnnotationShape
    a sh:NodeShape ;
    sh:targetClass autosar:NV-DATA-PORT-ANNOTATION ;
    sh:severity sh:Violation ;
    sh:message "An NV-DATA-PORT-ANNOTATION shall only be aggregated by a PortPrototype typed by an NV-DATA-INTERFACE." ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "NV-DATA-PORT-ANNOTATION must be attached to a PortPrototype whose type is NV-DATA-INTERFACE." ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this
            WHERE {
              ?port (autosar:NV-DATA-PORT-ANNOTATIONS/autosar:NV-DATA-PORT-ANNOTATION) ?this .
              OPTIONAL { ?port autosar:TYPE ?ifc . }
              FILTER ( !BOUND(?ifc) || !EXISTS { ?ifc a autosar:NV-DATA-INTERFACE } )
            }
        """ ;
    ] .

#################################################################
# constr_4010 - Context of DelegatedPortAnnotation
# A DelegatedPortAnnotation shall only be aggregated by a
# PortPrototype aggregated by a CompositionSwComponentType.
#################################################################

autosar:Constr_4010_DelegatedPortAnnotationShape
    a sh:NodeShape ;
    sh:targetClass autosar:DELEGATED-PORT-ANNOTATION ;
    sh:severity sh:Violation ;
    sh:message "A DELEGATED-PORT-ANNOTATION shall only be aggregated by a PortPrototype aggregated by a COMPOSITION-SW-COMPONENT-TYPE." ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "DELEGATED-PORT-ANNOTATION must be attached to a PortPrototype that is contained in a COMPOSITION-SW-COMPONENT-TYPE." ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this
            WHERE {
              ?port autosar:DELEGATED-PORT-ANNOTATION ?this .
              FILTER NOT EXISTS {
                ?comp a autosar:COMPOSITION-SW-COMPONENT-TYPE ;
                      autosar:PORTS ?ports .
                ?ports ?p ?port .
              }
            }
        """ ;
    ] .

#################################################################
# constr_4012 - Timeout of ModeSwitchedAckEvent
# The timeout value of a Wait Point associated with a
# ModeSwitchedAckEvent shall be equal to the corresponding
# ModeSwitchedAckRequest.timeout.
#################################################################

autosar:Constr_4012_ModeSwitchedAckEventTimeoutShape
    a sh:NodeShape ;
    sh:targetClass autosar:MODE-SWITCHED-ACK-EVENT ;
    sh:severity sh:Violation ;
    sh:message "The timeout of the WAIT-POINT associated with a MODE-SWITCHED-ACK-EVENT shall equal the corresponding MODE-SWITCHED-ACK-REQUEST/TIMEOUT." ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "WAIT-POINT/TIMEOUT must equal MODE-SWITCHED-ACK-REQUEST/TIMEOUT for a MODE-SWITCHED-ACK-EVENT." ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this
            WHERE {
              ?this autosar:WAIT-POINT ?wp ;
                    autosar:MODE-SWITCHED-ACK-REQUEST ?req .
              ?wp autosar:TIMEOUT ?wpTimeout .
              ?req autosar:TIMEOUT ?reqTimeout .
              FILTER ( ?wpTimeout != ?reqTimeout )
            }
        """ ;
    ] .

#################################################################
# constr_4035 - ValueSpecification shall fit into data type
# Semantic / range-fit constraint – left to SMT, no SHACL.
#################################################################


#################################################################
# constr_4082 - RunnableEntity.reentrancyLevel shall not be set.
#################################################################

autosar:Constr_4082_RunnableEntityReentrancyLevelShape
    a sh:NodeShape ;
    sh:targetClass autosar:RUNNABLE-ENTITY ;
    sh:severity sh:Violation ;
    sh:message "For RUNNABLE-ENTITY, the optional REENTRANCY-LEVEL shall not be set." ;
    sh:property [
        sh:path autosar:REENTRANCY-LEVEL ;
        sh:maxCount 0 ;
    ] .
