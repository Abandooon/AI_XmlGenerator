#################################################################

autosar:TPS_SWCT_01159 a sh:NodeShape ;
  sh:targetClass autosar:PORT-INTERFACE-MAPPING ;
  sh:severity sh:Info ;
  sh:message "PortInterfaceMapping is modeled as reusable ARElement and grouped in PortInterfaceMappingSet (documentation / structural modeling hint)." .

#################################################################
# SHACL for TPS_SWCT_01162 - Existence of TextTableMapping
#################################################################

autosar:TPS_SWCT_01162 a sh:NodeShape ;
  sh:targetClass autosar:AUTOSAR-DATA-TYPE ;
  sh:severity sh:Info ;
  sh:message "A TextTableMapping to CompuMethods of category TEXTTABLE, SCALE_LINEAR_AND_TEXTTABLE, or BITFIELD_TEXTTABLE can be defined if the AutosarDataTypes refer (behavioral / cross-element, not structurally enforced here)." .

#################################################################
# SHACL for TPS_SWCT_01163 - Conversion from firstValue to secondValue
#################################################################

autosar:TPS_SWCT_01163 a sh:NodeShape ;
  sh:targetClass autosar:DATA-PROTOTYPE-MAPPING ;
  sh:property [
    sh:path autosar:FIRST-DATA-PROTOTYPE-REF ;
    sh:minCount 1
  ] ;
  sh:property [
    sh:path autosar:SECOND-DATA-PROTOTYPE-REF ;
    sh:minCount 1
  ] ;
  sh:severity sh:Info ;
  sh:message "Behavioral: for data flow from firstDataPrototype to secondDataPrototype, firstValue is converted into secondValue (runtime semantics, not enforced structurally)." .

#################################################################
# SHACL for TPS_SWCT_01164 - Conversion from secondValue to firstValue
#################################################################

autosar:TPS_SWCT_01164 a sh:NodeShape ;
  sh:targetClass autosar:DATA-PROTOTYPE-MAPPING ;
  sh:property [
    sh:path autosar:FIRST-DATA-PROTOTYPE-REF ;
    sh:minCount 1
  ] ;
  sh:property [
    sh:path autosar:SECOND-DATA-PROTOTYPE-REF ;
    sh:minCount 1
  ] ;
  sh:severity sh:Info ;
  sh:message "Behavioral: for data flow from secondDataPrototype to firstDataPrototype, secondValue is substituted by firstValue (runtime semantics, not enforced structurally)." .

#################################################################
# SHACL for TPS_SWCT_01165 - Invertible mapping
#################################################################

autosar:TPS_SWCT_01165 a sh:NodeShape ;
  sh:targetClass autosar:TEXT-TABLE-MAPPING ;

  # mappingDirection must exist
  sh:property [
    sh:path autosar:MAPPING-DIRECTION ;
    sh:minCount 1 ;
    sh:in ( "bidirectional" "unidirectional" )  # value space hint; actual enumeration is type-specific
  ] ;

  # If mappingDirection = bidirectional, then firstValues in all value pairs must be unique
  sh:sparql [
    sh:message "For bidirectional TextTableMapping, all FIRST-VALUE entries must be pairwise distinct." ;
    sh:severity sh:Violation ;
    sh:select """
      PREFIX autosar: <http://autosar.org/>
      SELECT ?this
      WHERE {
        ?this autosar:MAPPING-DIRECTION ?dir .
        FILTER(str(?dir) = "bidirectional") .

        ?this autosar:TEXT-TABLE-VALUE-PAIR ?vp1 .
        ?this autosar:TEXT-TABLE-VALUE-PAIR ?vp2 .
        FILTER(?vp1 != ?vp2) .

        ?vp1 autosar:FIRST-VALUE ?v1 .
        ?vp2 autosar:FIRST-VALUE ?v2 .
        FILTER(?v1 = ?v2) .
      }
    """
  ] ;

  # If mappingDirection = bidirectional, then secondValues in all value pairs must be unique
  sh:sparql [
    sh:message "For bidirectional TextTableMapping, all SECOND-VALUE entries must be pairwise distinct." ;
    sh:severity sh:Violation ;
    sh:select """
      PREFIX autosar: <http://autosar.org/>
      SELECT ?this
      WHERE {
        ?this autosar:MAPPING-DIRECTION ?dir .
        FILTER(str(?dir) = "bidirectional") .

        ?this autosar:TEXT-TABLE-VALUE-PAIR ?vp1 .
        ?this autosar:TEXT-TABLE-VALUE-PAIR ?vp2 .
        FILTER(?vp1 != ?vp2) .

        ?vp1 autosar:SECOND-VALUE ?v1 .
        ?vp2 autosar:SECOND-VALUE ?v2 .
        FILTER(?v1 = ?v2) .
      }
    """
  ] ;

  sh:severity sh:Violation ;
  sh:message "If mappingDirection is bidirectional, the TextTableMapping must be invertible: FIRST-VALUEs and SECOND-VALUEs must be unique within their respective lists." .

#################################################################
# SHACL for TPS_SWCT_01166 - Non-invertible mapping
#################################################################

autosar:TPS_SWCT_01166 a sh:NodeShape ;
  sh:targetClass autosar:TEXT-TABLE-MAPPING ;
  sh:severity sh:Info ;
  sh:message "For non-invertible TextTableMapping, a dedicated TextTableMapping for each direction can be defined (modeling recommendation)." .


