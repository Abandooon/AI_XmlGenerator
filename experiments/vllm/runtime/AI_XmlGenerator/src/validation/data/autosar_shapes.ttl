        sh:message "SW-IMPL-POLICY, if present, must follow the supported combinations with SW-CALIBRATION-ACCESS (see SMT rules / table 5.49)." ;
    ] .

#################################################################
# SHACL for constr_1018 - measurementPoint shall not be referenced ...
#################################################################

autosar:Constr_1018_MeasurementPointNotReferencedByDataReadAccess
    a sh:NodeShape ;
    sh:targetClass autosar:VARIABLE-ACCESS ;
    sh:severity sh:Violation ;
    sh:message "A data element with swImplPolicy = measurementPoint shall not be referenced by a VARIABLE-ACCESS aggregated by RUNNABLE-ENTITY in the role DATA-READ-ACCESSS." .

#################################################################
# SHACL for constr_1019 - Compatibility of input value and axis
# (semantic compatibility; structural presence only)
#################################################################

autosar:Constr_1019_CompatibilityOfInputValueAndAxis
    a sh:NodeShape ;
    sh:targetClass autosar:SW-DATA-DEF-PROPS ;
    sh:property [
        sh:path autosar:COMPU-METHOD-REF ;
        sh:maxCount 1 ;
        sh:severity sh:Info ;
        sh:message "If COMPU-METHOD-REF is present on SW-AXIS-INDIVIDUAL, the SwDataDefProps of the input variable shall be compatible to the datatype/compuMethod/unit of the SwAxisIndividual (checked by SMT/other means)." ;
    ] ;
    sh:property [
        sh:path autosar:UNIT-REF ;
        sh:maxCount 1 ;
        sh:severity sh:Info ;
        sh:message "If UNIT-REF is present on SW-AXIS-INDIVIDUAL, the SwDataDefProps of the input variable shall be compatible to the datatype/compuMethod/unit of the SwAxisIndividual (checked by SMT/other means)." ;
