    ] ;
    .


#################################################################
# SHACL shapes for TPS_SWCT constraints
#################################################################

#################################################################
# TPS_SWCT_01001  Prefix symbols generated for the RunnableEntity
#################################################################

autosar:TPS_SWCT_01001_SymbolPropsShape
    a sh:NodeShape ;
    sh:severity sh:Violation ;

    # 目标：所有 AtomicSwComponentType（含其具体子类，依赖 rdfs:subClassOf + RDFS 推理）
    sh:targetClass autosar:ATOMIC-SW-COMPONENT-TYPE ;

    # 结构约束：如果存在 SYMBOL-PROPS/SYMBOL，则最多一个
    sh:property [
        sh:path ( autosar:SYMBOL-PROPS autosar:SYMBOL ) ;
        sh:maxCount 1 ;
        sh:message "SYMBOL-PROPS/SYMBOL shall exist at most once on an AtomicSwComponentType."@en ;
        sh:severity sh:Violation ;
    ] ;

    # 信息性 SPARQL：只要存在 SYMBOL-PROPS/SYMBOL，就给出一条提示
    # （具体“是否作为前缀使用”由 SMT 或人工检查）
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Info ;
        sh:message "If SYMBOL-PROPS/SYMBOL exists on an AtomicSwComponentType, its value should be used as prefix for symbols of owned RUNNABLE-ENTITYs (informational, not fully enforced structurally)."@en ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>

            SELECT ?this
            WHERE {
              ?this a autosar:ATOMIC-SW-COMPONENT-TYPE .
              ?this autosar:SYMBOL-PROPS ?sp .
              ?sp  autosar:SYMBOL ?sym .
              # 这里只是枚举存在这种情况的组件，不做进一步结构检查
            }
        """ ;
    ] .


#################################################################
# TPS_SWCT_01002  SwComponentTypes may only interact by PortPrototypes
#################################################################

# Purely behavioral / architectural; no stable structural pattern
# to check “hidden communication dependencies”. Leave SHACL empty.

#################################################################
# TPS_SWCT_01003  Inconsistencies regarding serviceKind vs implementation
#################################################################

# Behavioral: “implementation wins” – this is a semantic precedence rule,
# not a structural inconsistency. No SHACL structural violation to assert.

#################################################################
# TPS_SWCT_01004  Default value if serviceKind is not defined
#################################################################

autosar:TPS_SWCT_01004_ServiceKindDefaultShape
    a sh:NodeShape ;
    sh:severity sh:Info ;

    # target: concrete PortInterface specializations that can own SERVICE-KIND
    sh:targetClass autosar:CLIENT-SERVER-INTERFACE ;
    sh:targetClass autosar:NV-DATA-INTERFACE ;
    sh:targetClass autosar:PARAMETER-INTERFACE ;
    sh:targetClass autosar:SENDER-RECEIVER-INTERFACE ;
    sh:targetClass autosar:MODE-SWITCH-INTERFACE ;
    sh:targetClass autosar:TRIGGER-INTERFACE ;

    # Info: if SERVICE-KIND is absent, assume default anyStandardized (not stored in XML)
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "If SERVICE-KIND is not defined for a PortInterface, the default value anyStandardized shall be assumed (informational default, not enforced as data value)." ;
        sh:severity sh:Info ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>

            SELECT ?this
            WHERE {
              # 这里 ?this 已经是 targetClass 的节点，无需再检查类型
              FILTER NOT EXISTS { ?this autosar:SERVICE-KIND ?sk . }
            }
        """ ;
    ] .


#################################################################
# TPS_SWCT_01005  Usage of SwcServiceDependencys for vendor-specific services
#################################################################

# Target_class is ServiceNeeds but has no concrete xml_tag here and
# the rule is semantic (“shall not contain standardized ServiceNeeds”).
# Leave SHACL empty; handled in SMT only if needed.

#################################################################
# TPS_SWCT_01006  ImplementationDataType.subElement.arraySize used for array size
#################################################################

autosar:TPS_SWCT_01006_ArraySizeUsageShape
    a sh:NodeShape ;
    sh:severity sh:Info ;

    sh:targetClass autosar:IMPLEMENTATION-DATA-TYPE ;

    # Info: array size shall be defined via SUB-ELEMENTS/IMPLEMENTATION-DATA-TYPE-ELEMENT/ARRAY-SIZE
    sh:sparql [
        sh:message "For ImplementationDataType arrays, the size shall be defined via SUB-ELEMENTS/IMPLEMENTATION-DATA-TYPE-ELEMENT/ARRAY-SIZE (informational usage rule)." ;
        sh:severity sh:Info ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this
            WHERE {
              ?this a autosar:IMPLEMENTATION-DATA-TYPE .
              OPTIONAL {
                ?this autosar:SUB-ELEMENTS ?subs .
                ?subs autosar:IMPLEMENTATION-DATA-TYPE-ELEMENT ?elt .
                ?elt autosar:ARRAY-SIZE ?asz .
              }
              # This query only reports IMPLEMENTATION-DATA-TYPEs; the actual
              # semantic “shall be used” is not structurally checkable here.
            }
        """ ;
    ] .

#################################################################
# TPS_SWCT_01007  Semantics of array index
#################################################################

autosar:TPS_SWCT_01007_ArrayIndexSemanticsShape
    a sh:NodeShape ;
    sh:severity sh:Info ;

    sh:targetClass autosar:IMPLEMENTATION-DATA-TYPE ;

    # Info: for array ImplementationDataType, index runs from 0 to arraySize-1
    sh:sparql [
        sh:message "For an ImplementationDataType that implements an array data type, the array index shall start at 0 and run to arraySize-1 (semantic rule, not directly checkable on XML)." ;
        sh:severity sh:Info ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this
            WHERE {
              ?this a autosar:IMPLEMENTATION-DATA-TYPE .
              OPTIONAL { ?this autosar:CATEGORY ?cat . }
              # Heuristic: treat CATEGORY containing 'ARRAY' as array data type
              FILTER(BOUND(?cat))
            }
        """ ;
    ] .


# SHACL for TPS_SWCT_01011 - Default category of a ModeDeclarationGroup

autosar:TPS_SWCT_01011_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:MODE-DECLARATION-GROUP ;
    sh:property [
        sh:path ( autosar:MODE-DECLARATION-GROUP autosar:CATEGORY ) ;
        sh:severity sh:Info ;
        sh:message "If CATEGORY is omitted for MODE-DECLARATION-GROUP, its default is ALPHABETIC_ORDER (backwards compatibility)." ;
    ] .

# Note:
# TPS_SWCT_01009 is purely permissive (values may be arbitrary, non-consecutive, gaps allowed)
# and does not impose a restriction → no SHACL shape generated.
# TPS_SWCT_01012..01016 describe semantic roles / valid role names, but without a
# machine-checkable enumeration or structural condition in the given data → no SHACL here.


# 1) TPS_SWCT_01017 – AtomicSwComponentType wants to select a boot target (flexible variant)
# Semantics: if a RoleBasedPortAssignment is used for this purpose, its ROLE must be "EcuM_BootTarget".

autosar:TPS_SWCT_01017_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:ROLE-BASED-PORT-ASSIGNMENT ;
    sh:property [
        sh:path autosar:ROLE ;
        sh:in ( "EcuM_BootTarget" ) ;
        sh:severity sh:Violation ;
        sh:message "ROLE of ROLE-BASED-PORT-ASSIGNMENT used for boot target must be 'EcuM_BootTarget'." ;
    ] .

# 2) TPS_SWCT_01018 – AtomicSwComponentType wants to use an alarm clock (flexible variant)
# Semantics: if a RoleBasedPortAssignment is used for this purpose, its ROLE must be "EcuM_AlarmClock".

autosar:TPS_SWCT_01018_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:ROLE-BASED-PORT-ASSIGNMENT ;
    sh:property [
        sh:path autosar:ROLE ;
        sh:in ( "EcuM_AlarmClock" ) ;
        sh:severity sh:Violation ;
        sh:message "ROLE of ROLE-BASED-PORT-ASSIGNMENT used for alarm clock must be 'EcuM_AlarmClock'." ;
    ] .

# 3) TPS_SWCT_01019 – AtomicSwComponentType reads the current ComM mode
# Semantics: RoleBasedPortAssignment valid roles: ComM_CurrentMode [1]
# We model: any ROLE-BASED-PORT-ASSIGNMENT used in this context must have ROLE = "ComM_CurrentMode".

autosar:TPS_SWCT_01019_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:ROLE-BASED-PORT-ASSIGNMENT ;
    sh:property [
        sh:path autosar:ROLE ;
        sh:in ( "ComM_CurrentMode" ) ;
        sh:severity sh:Violation ;
        sh:message "ROLE of ROLE-BASED-PORT-ASSIGNMENT for reading ComM mode must be 'ComM_CurrentMode'." ;
    ] .

# 4) TPS_SWCT_01020 – AtomicSwComponentType requests a ComM mode...
# Semantics: valid roles: ComM_CurrentMode [1], ComM_UserRequest [1]
# We model: ROLE must be one of these two literals.

autosar:TPS_SWCT_01020_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:ROLE-BASED-PORT-ASSIGNMENT ;
    sh:property [
        sh:path autosar:ROLE ;
        sh:in ( "ComM_CurrentMode" "ComM_UserRequest" ) ;
        sh:severity sh:Violation ;
        sh:message "ROLE of ROLE-BASED-PORT-ASSIGNMENT must be 'ComM_CurrentMode' or 'ComM_UserRequest'." ;
    ] .

# 5) TPS_SWCT_01021 – AtomicSwComponentType acts as a mode manager that influences the ECU state
# Semantics: valid roles:
#   ComM_CurrentMode [0..1]
#   ComM_UserRequest [0..1]
#   ComM_ECUModeLimitation [1]
# SHACL can only express allowed literals here; exact cardinalities are handled in SMT.

autosar:TPS_SWCT_01021_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:ROLE-BASED-PORT-ASSIGNMENT ;
    sh:property [
        sh:path autosar:ROLE ;
        sh:in ( "ComM_CurrentMode" "ComM_UserRequest" "ComM_ECUModeLimitation" ) ;
        sh:severity sh:Violation ;
        sh:message "ROLE of ROLE-BASED-PORT-ASSIGNMENT must be one of: 'ComM_CurrentMode', 'ComM_UserRequest', 'ComM_ECUModeLimitation'." ;
    ] .

# 6) TPS_SWCT_01022 – Queued processing of internal trigger
# Semantics: attribute INTERNAL-TRIGGERING-POINT/SW-IMPL-POLICY is optional and descriptive.
# No hard structural restriction beyond type; we omit SHACL (handled as documentation/SMT if needed).

# 7) TPS_SWCT_01023 – Mapping of elements of composite data types
# Semantics: DataInterface can be used to describe mapping between composite data types of category STRUCTURE or ARRAY.
# This is descriptive; no strict structural constraint derivable. No SHACL emitted.


# 1) SHACL

# TPS_SWCT_01024 - Combination of ApplicationCompositeDataType and nested ImplementationDataType
# 该约束是说明性/关系性描述，不给出可观测的结构或计数条件，暂不生成结构性 SHACL 规则。

# TPS_SWCT_01028 - AtomicSwComponentType implements a Diagnostic Monitor (variant 1)
# 仅给出角色列表及基数，但缺少明确的 XML 结构（例如 ServiceNeeds、RoleBasedPortAssignment 在 ATOMIC-SW-COMPONENT-TYPE 下的路径），
# 且未给出角色值的枚举（如 'DiagnosticMonitor' 等）在 XML 中的具体编码方式（字符串/枚举）。
# 因此不生成部分结构性 SHACL，以避免错误假设。

# TPS_SWCT_01029 - AtomicSwComponentType implements a Diagnostic Monitor (variant 2)
# 同上，缺乏可安全使用的路径与枚举值信息，不生成 SHACL。

# TPS_SWCT_01030 - RunnableEntity (definition)
# 纯定义性描述，无可观测结构约束，不生成 SHACL。

# TPS_SWCT_01031 - ExclusiveArea (behavioral scheduling constraint)
# 运行时调度行为约束，无法从静态 XML 结构直接验证，不生成 SHACL。

# TPS_SWCT_01033 - Nested definition of CompositionSwComponentTypes
# 描述 CompositionSwComponentType 可以被进一步聚合为其他 CompositionSwComponentType。
# 缺少明确的 XML 聚合路径（例如 COMPONENTS/COMPONENT-REF 等），不生成 SHACL。

# TPS_SWCT_01034 - CompositionSwComponentTypes do not have any binary footprint
# 运行时/实现层面的属性，非 XML 结构约束，不生成 SHACL。


# 1) SHACL 约束

#################################################################
# TPS_SWCT_01035 - CompositionSwComponentType aggregates SwComponentPrototypes
#################################################################

autosar:TPS_SWCT_01035 a sh:NodeShape ;
  sh:targetClass autosar:COMPOSITION-SW-COMPONENT-TYPE ;
  sh:property [
    sh:path ( autosar:COMPONENTS autosar:SW-COMPONENT-PROTOTYPE ) ;
    sh:class autosar:SW-COMPONENT-PROTOTYPE ;
    sh:severity sh:Violation ;
    sh:message "COMPOSITION-SW-COMPONENT-TYPE aggregates SW-COMPONENT-PROTOTYPE elements."@en
  ] ;
  sh:property [
    sh:path autosar:TYPE-TREF ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    sh:message "Each SW-COMPONENT-PROTOTYPE shall be typed by a SwComponentType via TYPE-TREF."@en
  ] .

#################################################################
# TPS_SWCT_01037 - arbitrary numbers of SwComponentPrototypes can be created
#################################################################

autosar:TPS_SWCT_01037 a sh:NodeShape ;
  sh:targetClass autosar:SW-COMPONENT-PROTOTYPE ;
  sh:severity sh:Info ;
  sh:message "Arbitrary numbers of SwComponentPrototypes that refer to specific SwComponentTypes can be created."@en .

#################################################################
# TPS_SWCT_01038 - Support for Variant Handling in the Software Component Template
#################################################################

# PortPrototype is abstract; concrete XML tags are P-PORT-PROTOTYPE, PR-PORT-PROTOTYPE, R-PORT-PROTOTYPE

autosar:TPS_SWCT_01038_PPort a sh:NodeShape ;
  sh:targetClass autosar:P-PORT-PROTOTYPE ;
  sh:property [
    sh:path autosar:VARIATION-POINT ;
    sh:severity sh:Info ;
    sh:message "Variant handling may vary the existence of PortPrototypes via VARIATION-POINT."@en
  ] .

autosar:TPS_SWCT_01038_PRPort a sh:NodeShape ;
  sh:targetClass autosar:PR-PORT-PROTOTYPE ;
  sh:property [
    sh:path autosar:VARIATION-POINT ;
    sh:severity sh:Info ;
    sh:message "Variant handling may vary the existence of PortPrototypes via VARIATION-POINT."@en
  ] .

autosar:TPS_SWCT_01038_RPort a sh:NodeShape ;
  sh:targetClass autosar:R-PORT-PROTOTYPE ;
  sh:property [
    sh:path autosar:VARIATION-POINT ;
    sh:severity sh:Info ;
    sh:message "Variant handling may vary the existence of PortPrototypes via VARIATION-POINT."@en
  ] .

autosar:TPS_SWCT_01038_SwComponentDocumentation a sh:NodeShape ;
  sh:targetClass autosar:SW-COMPONENT-DOCUMENTATION ;
  sh:property [
    sh:path autosar:VARIATION-POINT ;
    sh:severity sh:Info ;
    sh:message "Variant handling may vary the existence of Chapters of SwComponentDocumentation via VARIATION-POINT."@en
  ] .

# SwConnector is abstract; concrete XML tags are ASSEMBLY-SW-CONNECTOR, DELEGATION-SW-CONNECTOR, PASS-THROUGH-SW-CONNECTOR

autosar:TPS_SWCT_01038_AssemblyConnector a sh:NodeShape ;
  sh:targetClass autosar:ASSEMBLY-SW-CONNECTOR ;
  sh:property [
    sh:path autosar:VARIATION-POINT ;
    sh:severity sh:Info ;
    sh:message "Variant handling may vary the existence of SwConnectors via VARIATION-POINT."@en
  ] .

autosar:TPS_SWCT_01038_DelegationConnector a sh:NodeShape ;
  sh:targetClass autosar:DELEGATION-SW-CONNECTOR ;
  sh:property [
    sh:path autosar:VARIATION-POINT ;
    sh:severity sh:Info ;
    sh:message "Variant handling may vary the existence of SwConnectors via VARIATION-POINT."@en
  ] .

autosar:TPS_SWCT_01038_PassThroughConnector a sh:NodeShape ;
  sh:targetClass autosar:PASS-THROUGH-SW-CONNECTOR ;
  sh:property [
    sh:path autosar:VARIATION-POINT ;
    sh:severity sh:Info ;
    sh:message "Variant handling may vary the existence of SwConnectors via VARIATION-POINT."@en
  ] .

#################################################################
# TPS_SWCT_01040 - SwConnector exists depending on a PostBuild condition
#################################################################

autosar:TPS_SWCT_01040_AssemblyConnector a sh:NodeShape ;
  sh:targetClass autosar:ASSEMBLY-SW-CONNECTOR ;
  sh:property [
    sh:path autosar:VARIATION-POINT ;
    sh:severity sh:Info ;
    sh:message "If an Assembly SwConnector exists depending on a PostBuild condition, RTE API behavior must resemble an unconnected PortPrototype when it does not exist."@en
  ] .

autosar:TPS_SWCT_01040_DelegationConnector a sh:NodeShape ;
  sh:targetClass autosar:DELEGATION-SW-CONNECTOR ;
  sh:property [
    sh:path autosar:VARIATION-POINT ;
    sh:severity sh:Info ;
    sh:message "If a Delegation SwConnector exists depending on a PostBuild condition, RTE API behavior must resemble an unconnected PortPrototype when it does not exist."@en
  ] .

autosar:TPS_SWCT_01040_PassThroughConnector a sh:NodeShape ;
  sh:targetClass autosar:PASS-THROUGH-SW-CONNECTOR ;
  sh:property [
    sh:path autosar:VARIATION-POINT ;
    sh:severity sh:Info ;
    sh:message "If a Pass-Through SwConnector exists depending on a PostBuild condition, RTE API behavior must resemble an unconnected PortPrototype when it does not exist."@en
  ] .

#################################################################
# TPS_SWCT_01041 - API functions of not existing SwConnector are still part of the implementation
#################################################################

autosar:TPS_SWCT_01041_PPort a sh:NodeShape ;
  sh:targetClass autosar:P-PORT-PROTOTYPE ;
  sh:property [
    sh:path autosar:VARIATION-POINT ;
    sh:severity sh:Info ;
    sh:message "Latest reasonable Binding Time for conditional existence of a PortPrototype is preCompileTime; API functions cannot be removed post-build."@en
  ] .

autosar:TPS_SWCT_01041_PRPort a sh:NodeShape ;
  sh:targetClass autosar:PR-PORT-PROTOTYPE ;
  sh:property [
    sh:path autosar:VARIATION-POINT ;
    sh:severity sh:Info ;
    sh:message "Latest reasonable Binding Time for conditional existence of a PortPrototype is preCompileTime; API functions cannot be removed post-build."@en
  ] .

autosar:TPS_SWCT_01041_RPort a sh:NodeShape ;
  sh:targetClass autosar:R-PORT-PROTOTYPE ;
  sh:property [
    sh:path autosar:VARIATION-POINT ;
    sh:severity sh:Info ;
    sh:message "Latest reasonable Binding Time for conditional existence of a PortPrototype is preCompileTime; API functions cannot be removed post-build."@en
  ] .


# 1) TPS_SWCT_01047 – Reference from SensorActuatorSwComponentType to HW element

autosar:TPS_SWCT_01047_SensorActuatorRefShape
    a sh:NodeShape ;
    sh:targetClass autosar:SENSOR-ACTUATOR-SW-COMPONENT-TYPE ;
    sh:property [
        sh:path autosar:SENSOR-ACTUATOR-REF ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;
    sh:severity sh:Violation .

# 2) TPS_SWCT_01049 – Two ways to use the ExclusiveAreas
# 结构层面：两个引用的 DEST 类型约束（若存在则必须指向 EXCLUSIVE-AREA）

autosar:TPS_SWCT_01049_CanEnterExclusiveAreaRefShape
    a sh:NodeShape ;
    sh:targetClass autosar:RUNNABLE-ENTITY ;
    sh:property [
        sh:path ( autosar:CAN-ENTER-EXCLUSIVE-AREA-REFS autosar:CAN-ENTER-EXCLUSIVE-AREA-REF ) ;
        sh:severity sh:Violation ;
        sh:node [
            a sh:NodeShape ;
            sh:property [
                sh:path autosar:DEST ;
                sh:in ( "EXCLUSIVE-AREA" ) ;
                sh:severity sh:Violation ;
            ]
        ]
    ] ;
    sh:severity sh:Violation .

autosar:TPS_SWCT_01049_RunsInsideExclusiveAreaRefShape
    a sh:NodeShape ;
    sh:targetClass autosar:RUNNABLE-ENTITY ;
    sh:property [
        sh:path ( autosar:RUNS-INSIDE-EXCLUSIVE-AREA-REFS autosar:RUNS-INSIDE-EXCLUSIVE-AREA-REF ) ;
        sh:severity sh:Violation ;
        sh:node [
            a sh:NodeShape ;
            sh:property [
                sh:path autosar:DEST ;
                sh:in ( "EXCLUSIVE-AREA" ) ;
                sh:severity sh:Violation ;
            ]
        ]
    ] ;
    sh:severity sh:Violation .

# 3) TPS_SWCT_01050 – RunnableEntity always runs inside an ExclusiveArea
# 结构层面：若采用“always runs inside”方式，则至少有一个 RUNS-INSIDE-EXCLUSIVE-AREA-REF

autosar:TPS_SWCT_01050_RunsInsideExclusiveAreaExistsShape
    a sh:NodeShape ;
    sh:targetClass autosar:RUNNABLE-ENTITY ;
    sh:property [
        sh:path ( autosar:RUNS-INSIDE-EXCLUSIVE-AREA-REFS autosar:RUNS-INSIDE-EXCLUSIVE-AREA-REF ) ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
    ] ;
    sh:severity sh:Violation .


# 1) TPS_SWCT_01051 - RunnableEntity explicitly enters and leaves a specific ExclusiveArea
# 该约束是运行时行为（Runnable 内部调用 RTE 进入/离开 ExclusiveArea），
# 无法从静态 XML 结构直接验证，因此不生成结构性 SHACL 约束。

# 2) TPS_SWCT_01052 - Inter-runnable variable
# 纯定义性描述：显式/隐式 inter-runnable variable 都是 VariableDataPrototype，
# 已由元模型结构体现，不额外增加结构性约束。

# 3) TPS_SWCT_01053 - Relationship of interchanged data with RunnableEntitys
# 语义核心是关系/连接（通过 LOCAL-VARIABLE-REF 建立），属于跨元素/跨文件逻辑，
# 主要由 SMT 处理，这里不添加结构性 SHACL（基础结构已由 schema 给出）。

# 4) TPS_SWCT_01057 - Unit references one physical dimension
# “references one physical dimension” 在文本中是定义性描述（说明含义），
# minOccurs=0 表明引用是可选的，因此不强制存在，仅在存在时要求类型正确。
# 类型 DEST 已由工具链在解析 REF 时保证，这里不重复建模。

# 5) TPS_SWCT_01058 - UnitGroup
# 行为性描述（UnitGroup 决定转换是否合适），不对应静态 XML 结构约束。

# 6) TPS_SWCT_01059 - Exponent for each of the seven fundamental dimensions
# 文本语义：当一个物理维度基于 SI 基本单位时，需要为七个基本量都给出指数。
# 但输入数据中没有可观测的“基于 SI 单位”的触发条件标志，
# 无法在纯结构层面区分“需要全部 7 个指数”的场景与“可省略”的场景。
# 因此不在 SHACL 中强制 7 个指数全部存在，由 SMT 以条件形式建模。

# 7) TPS_SWCT_01060 - Negative exponents
# 仅说明允许负指数，不构成额外结构性约束（值域/数值类型由基础类型定义承担）。

# 综上，本批约束不生成额外 SHACL shapes（结构约束要么已由 schema 给出，要么需要运行时/语义信息）。


# 1) SHACL shapes

#################################################################
# TPS_SWCT_01061 - Conversion of units
# Semantic is behavioral and depends on "chosen country code" and
# "conversion target" which are not observable here -> no SHACL.
#################################################################


#################################################################
# TPS_SWCT_01062 - Documentation of software-components
# Purely descriptive, no normative structural rule -> no SHACL.
#################################################################


#################################################################
# TPS_SWCT_01063 - PortGroup (definition)
# Describes possibility of grouping ports, no structural must/iff.
#################################################################


#################################################################
# TPS_SWCT_01064 - PortGroups have to be defined on the VFB level
# Normative: PortGroups must be definable for both Atomic and
# Composition SwComponentTypes (VFB level). This is a modeling
# rule, not a per-instance XML structural rule -> no SHACL.
#################################################################


#################################################################
# TPS_SWCT_01065 - PortPrototype may belong to more than one PortGroups
# "may belong to more than one" is permissive, not restrictive.
# No minimum or maximum cardinality is imposed -> no SHACL.
#################################################################


#################################################################
# TPS_SWCT_01066 - PortGroups can be associated with certain ServiceNeeds
# Purely descriptive ("can"), no structural obligation -> no SHACL.
#################################################################


#################################################################
# TPS_SWCT_01071 - ModeDeclaration
# "The name of the mode is the most important attribute that has
#  to be provided for each ModeDeclaration."
# This is a strict existence constraint on SHORT-NAME of each
# MODE-DECLARATION.
#################################################################

autosar:TPS_SWCT_01071_ModeDeclarationShape
    a sh:NodeShape ;
    sh:targetClass autosar:MODE-DECLARATION ;

    # Each MODE-DECLARATION must have exactly one SHORT-NAME
    sh:property [
        sh:path autosar:SHORT-NAME ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Each MODE-DECLARATION shall provide exactly one SHORT-NAME (mode name)." ;
    ] .


# TPS_SWCT_01073 – Composite ApplicationDataType
# 语义：ApplicationCompositeDataType 的元素可以由其他 ApplicationDataType 进行类型化。
# 这里仅对 TYPE-TREF 的 DEST 类型做结构约束；可以不强制存在。

autosar:TPS_SWCT_01073_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:APPLICATION-COMPOSITE-DATA-TYPE ;

    # 元素类型引用：APPLICATION-ARRAY-ELEMENT/TYPE-TREF
    sh:property [
        sh:path ( autosar:APPLICATION-ARRAY-ELEMENT autosar:TYPE-TREF ) ;
        sh:nodeKind sh:IRI ;
        # TYPE-TREF 所指向的节点必须是 ApplicationDataType（含其子类）
        sh:class autosar:APPLICATION-DATA-TYPE ;
        sh:severity sh:Violation ;
        sh:message "TYPE-TREF of composite elements shall reference an ApplicationDataType (array/composite/primitive/record)." ;
    ] ;

    # 元素类型引用：APPLICATION-RECORD-ELEMENT/TYPE-TREF
    sh:property [
        sh:path ( autosar:APPLICATION-RECORD-ELEMENT autosar:TYPE-TREF ) ;
        sh:nodeKind sh:IRI ;
        # 同样要求为 ApplicationDataType
        sh:class autosar:APPLICATION-DATA-TYPE ;
        sh:severity sh:Violation ;
        sh:message "TYPE-TREF of composite elements shall reference an ApplicationDataType (array/composite/primitive/record)." ;
    ] ;
.


# TPS_SWCT_01074 – Composite ImplementationDataType
# 语义：ImplementationDataType 可以由 ImplementationDataTypeElement 组成（无 type/prototype 概念）。
# 这里只建模“可以有多个子元素”的结构关系，不强制存在。

autosar:TPS_SWCT_01074_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:IMPLEMENTATION-DATA-TYPE ;

    sh:property [
        sh:path ( autosar:SUB-ELEMENTS autosar:IMPLEMENTATION-DATA-TYPE-ELEMENT ) ;
        sh:minCount 0 ;
        sh:severity sh:Info ;
        sh:message "IMPLEMENTATION-DATA-TYPE may aggregate IMPLEMENTATION-DATA-TYPE-ELEMENTs (composite implementation data type)." ;
    ] ;
.

# TPS_SWCT_01076 – Number of elements of a specific ApplicationArrayDataType might vary at run-time
# 语义：ApplicationArrayDataType 至少有一个 ELEMENT；ELEMENT 至少有 MAX-NUMBER-OF-ELEMENTS，可选 ARRAY-SIZE-SEMANTICS。

autosar:TPS_SWCT_01076_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:APPLICATION-ARRAY-DATA-TYPE ;

    # ApplicationArrayDataType 至少有一个 ELEMENT
    sh:property [
        sh:path ( autosar:ELEMENT ) ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "APPLICATION-ARRAY-DATA-TYPE shall have at least one ELEMENT." ;
    ] ;
.

# 对 APPLICATION-ARRAY-ELEMENT 的结构约束
autosar:TPS_SWCT_01076_Element_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:APPLICATION-ARRAY-ELEMENT ;

    # 可选 ARRAY-SIZE-SEMANTICS
    sh:property [
        sh:path autosar:ARRAY-SIZE-SEMANTICS ;
        sh:minCount 0 ;
        sh:severity sh:Info ;
        sh:message "ARRAY-SIZE-SEMANTICS is optional and clarifies the meaning of MAX-NUMBER-OF-ELEMENTS." ;
    ] ;

    # 必须存在 MAX-NUMBER-OF-ELEMENTS
    sh:property [
        sh:path autosar:MAX-NUMBER-OF-ELEMENTS ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "APPLICATION-ARRAY-ELEMENT shall have exactly one MAX-NUMBER-OF-ELEMENTS." ;
    ] ;
.

# TPS_SWCT_01078 – Configurable array size
# 语义（结构部分）：ApplicationArrayDataType 至少有一个 ELEMENT；
# 每个 ApplicationArrayElement 至少有一个 MAX-NUMBER-OF-ELEMENTS，
# 且 TYPE-TREF 指向 ApplicationDataType。

autosar:TPS_SWCT_01078_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:APPLICATION-ARRAY-DATA-TYPE ;

    # 至少一个 ELEMENT（与 01076 一致，重复无害）
    sh:property [
        sh:path autosar:ELEMENT ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "APPLICATION-ARRAY-DATA-TYPE shall have at least one ELEMENT." ;
    ] ;
.

autosar:TPS_SWCT_01078_Element_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:APPLICATION-ARRAY-ELEMENT ;

    # MAX-NUMBER-OF-ELEMENTS 必须存在（且唯一）
    sh:property [
        sh:path autosar:MAX-NUMBER-OF-ELEMENTS ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "APPLICATION-ARRAY-ELEMENT shall have exactly one MAX-NUMBER-OF-ELEMENTS." ;
    ] ;

    # TYPE-TREF 指向 ApplicationDataType（array/composite/primitive/record）
    sh:property [
        sh:path autosar:TYPE-TREF ;
        sh:nodeKind sh:IRI ;
        # 指向的节点的 rdf:type 必须是 ApplicationDataType（含其子类）
        sh:class autosar:APPLICATION-DATA-TYPE ;
        sh:severity sh:Violation ;
        sh:message "TYPE-TREF of APPLICATION-ARRAY-ELEMENT shall reference an ApplicationDataType (array/composite/primitive/record)." ;
    ] ;
.


# TPS_SWCT_01079 – SwConnector
# 语义：CompositionSwComponentType 聚合 SW-CONNECTOR，通过 CONNECTORS 容器。
# 这里只建模 CONNECTORS 容器的存在性为可选。

autosar:TPS_SWCT_01079_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:COMPOSITION-SW-COMPONENT-TYPE ;

    sh:property [
        sh:path autosar:CONNECTORS ;
        sh:minCount 0 ;
        sh:severity sh:Info ;
        sh:message "COMPOSITION-SW-COMPONENT-TYPE may aggregate SW-CONNECTORs via CONNECTORS." ;
    ] ;
.


# 1) TPS_SWCT_01080 – Delegation ports
# 语义：说明性/行为性描述，不形成可观测的结构约束 → 不生成 SHACL

# 2) TPS_SWCT_01081 – Implications of being a delegation port
# 语义：说明性/行为性描述（委托规则、是否暴露内部端口），无可观测结构模式 → 不生成 SHACL

# 3) TPS_SWCT_01084 – Outer PortPrototype is referenced by multiple DelegationSwConnectors
# 语义：多重引用的语义解释，不是结构/计数约束 → 不生成 SHACL

# 4) TPS_SWCT_01085 – Variation on the behavior level
# 语义：说明“支持变体”的主要使用场景（哪些元素可以存在），未要求“必须存在”或“存在时必须带 VariationPoint”等强制结构规则 → 不生成 SHACL

# 5) TPS_SWCT_01086 – Request mode change
# 语义：描述请求模式变化的通信建模方式（接口类型、跨 ECU 等），无直接结构约束 → 不生成 SHACL

# 6) TPS_SWCT_01087 – Propagation of mode information
# 语义：描述 ModeDeclarationGroupPrototype 的通信概念与接口类型，未形成可观测的结构约束 → 不生成 SHACL

# 7) TPS_SWCT_01088 – ComSpecs defined by CompositionSwComponentTypes
# 语义：“It shall be possible to attach ComSpecs …” 表示能力/支持性，而非“必须存在 ComSpec”。
# 没有明确的 if-present-then-structure 规则（例如具体子标签、计数），因此不生成强制 SHACL 约束。


# 1) SHACL shapes

#################################################################
# TPS_SWCT_01089 - end-to-end communication protection
# Semantics: EndToEndProtection owns an EndToEndDescription via END-TO-END-PROFILE
#################################################################

autosar:TPS_SWCT_01089 a sh:NodeShape ;
  sh:targetClass autosar:END-TO-END-PROTECTION ;
  sh:property [
    sh:path ( autosar:END-TO-END-PROFILE ) ;
    sh:class autosar:END-TO-END-DESCRIPTION ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    sh:message "END-TO-END-PROTECTION shall own exactly one END-TO-END-PROFILE of type END-TO-END-DESCRIPTION." ;
  ] .

#################################################################
# TPS_SWCT_01090 - EndToEndProtection (definition / context only)
# Text is descriptive; no enforceable structural rule beyond model.
# No SHACL emitted.
#################################################################


#################################################################
# TPS_SWCT_01091 - Two cases for end-to-end protection
# Purely process/behavioral text (definition of two cases).
# No structural rule derivable without additional model info.
#################################################################


#################################################################
# TPS_SWCT_01092 - EndToEndProtectionSet (container definition)
# Describes meta-class as container; no concrete XML structure given.
# No SHACL emitted.
#################################################################


#################################################################
# TPS_SWCT_01094 - category of EndToEndDescription
# Semantics: END-TO-END-DESCRIPTION has a CATEGORY element (string, value space not restricted here).
#################################################################

autosar:TPS_SWCT_01094 a sh:NodeShape ;
  sh:targetClass autosar:END-TO-END-DESCRIPTION ;
  sh:property [
    sh:path autosar:CATEGORY ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    sh:message "END-TO-END-DESCRIPTION shall have exactly one CATEGORY element." ;
  ] .

#################################################################
# TPS_SWCT_01095 - category set to NONE
# Semantics: If CATEGORY = 'NONE', other attributes are ignored (runtime/interpretation).
# No structural SHACL; handled in SMT as a documentation-only behavioral rule.
#################################################################


#################################################################
# TPS_SWCT_01096 - PortGroup
# Descriptive text about logical grouping; no concrete XML structure given here.
# No SHACL emitted.
#################################################################


#################################################################
# SHACL shapes for TPS_SWCT constraints
#################################################################

#################################################################
# TPS_SWCT_01097 - CompositionSwComponentType cannot have RunnableEntitys
#################################################################

autosar:TPS_SWCT_01097 a sh:NodeShape ;
  sh:targetClass autosar:COMPOSITION-SW-COMPONENT-TYPE ;
  sh:severity sh:Violation ;
  sh:message "CompositionSwComponentType shall not define a SwcInternalBehavior and thus shall not have RunnableEntitys."@en .

#################################################################
# TPS_SWCT_01098 - Only AtomicSwComponentType can have RunnableEntitys
#################################################################

autosar:TPS_SWCT_01098 a sh:NodeShape ;
  sh:targetClass autosar:ATOMIC-SW-COMPONENT-TYPE ;
  sh:severity sh:Info ;
  sh:message "Only AtomicSwComponentType that populate a CompositionSwComponentType as SwComponentPrototypes may have RunnableEntitys (semantic, not structurally enforced here)."@en .

#################################################################
# TPS_SWCT_01099 - PortInterfaceMapping (documentation only)
#################################################################

autosar:TPS_SWCT_01099 a sh:NodeShape ;
  sh:targetClass autosar:PORT-INTERFACE ;
  sh:severity sh:Info ;
  sh:message "Each PortInterfaceMapping describes the mapping of the PortInterface elements of exactly two PortInterfaces (semantic, not structurally enforced here)."@en .

#################################################################
# TPS_SWCT_01100 - Precedence of PortInterfaceMapping (documentation only)
#################################################################

autosar:TPS_SWCT_01100 a sh:NodeShape ;
  sh:targetClass autosar:PORT-INTERFACE-MAPPING ;
  sh:severity sh:Info ;
  sh:message "If a connector has an associated PortInterfaceMapping this mapping has higher precedence than mapping by equal shortNames and is strictly binding w.r.t. number of mapped data elements (semantic, not structurally enforced here)."@en .

#################################################################
# TPS_SWCT_01101 - Unmapped elements of PortInterfaces (documentation only)
#################################################################

autosar:TPS_SWCT_01101 a sh:NodeShape ;
  sh:targetClass autosar:PORT-INTERFACE ;
  sh:severity sh:Info ;
  sh:message "Unmapped PortInterface elements will not be connected by the referencing SwConnector (semantic, not structurally enforced here)."@en .

#################################################################
# TPS_SWCT_01104 - Possible mappings are restricted by the swImplPolicy
#################################################################

autosar:TPS_SWCT_01104 a sh:NodeShape ;
  sh:targetClass autosar:PARAMETER-DATA-PROTOTYPE ;
  sh:severity sh:Info ;
  sh:property [
    sh:path autosar:SW-DATA-DEF-PROPS ;
    sh:message "Possible mappings of VariableDataPrototypes and ParameterDataPrototypes are restricted by the swImplPolicy attribute in SW-DATA-DEF-PROPS (semantic restriction, not fully enforced structurally here)."@en
  ] .

#################################################################
# TPS_SWCT_01106 - ClientServerOperation / ArgumentDataPrototype
#################################################################

# Argument direction must be present on each ArgumentDataPrototype
autosar:TPS_SWCT_01106_ArgumentDirection a sh:NodeShape ;
  sh:targetClass autosar:ARGUMENT-DATA-PROTOTYPE ;
  sh:severity sh:Violation ;
  sh:property [
    sh:path autosar:DIRECTION ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:message "Each ArgumentDataPrototype of a ClientServerOperation shall have exactly one DIRECTION (in, inout, or out)."@en
  ] .

# ClientServerOperation may have 0..* ArgumentDataPrototypes
autosar:TPS_SWCT_01106_ClientServerOperation a sh:NodeShape ;
  sh:targetClass autosar:CLIENT-SERVER-OPERATION ;
  sh:severity sh:Info ;
  sh:property [
    sh:path ( autosar:ARGUMENTS autosar:ARGUMENT-DATA-PROTOTYPE ) ;
    sh:message "A ClientServerOperation consists of 0..* ArgumentDataPrototypes; this aggregation represents a variation point."@en
  ] .


# 1) SHACL (Turtle)

# TPS_SWCT_01107 - swMinAxisPoints and swMaxAxisPoints represent variation points
autosar:TPS_SWCT_01107_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:SW-AXIS-INDIVIDUAL ;

    sh:property [
        sh:path autosar:SW-MIN-AXIS-POINTS ;
        sh:class autosar:INTEGER-VALUE-VARIATION-POINT ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "SW-MIN-AXIS-POINTS shall be modeled as an INTEGER-VALUE-VARIATION-POINT (variation point)." ;
    ] ;

    sh:property [
        sh:path autosar:SW-MAX-AXIS-POINTS ;
        sh:class autosar:INTEGER-VALUE-VARIATION-POINT ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "SW-MAX-AXIS-POINTS shall be modeled as an INTEGER-VALUE-VARIATION-POINT (variation point)." ;
    ] ;
.

# TPS_SWCT_01108 - Added value of an AtomicSwComponentType
# AtomicSwComponentType is abstract; expand to concrete XML tags from path_variants
autosar:TPS_SWCT_01108_Shape
    a sh:NodeShape ;

    sh:targetClass autosar:APPLICATION-SW-COMPONENT-TYPE ;
    sh:targetClass autosar:COMPLEX-DEVICE-DRIVER-SW-COMPONENT-TYPE ;
    sh:targetClass autosar:ECU-ABSTRACTION-SW-COMPONENT-TYPE ;
    sh:targetClass autosar:NV-BLOCK-SW-COMPONENT-TYPE ;
    sh:targetClass autosar:SENSOR-ACTUATOR-SW-COMPONENT-TYPE ;
    sh:targetClass autosar:SERVICE-PROXY-SW-COMPONENT-TYPE ;
    sh:targetClass autosar:SERVICE-SW-COMPONENT-TYPE ;

    sh:property [
        sh:path ( autosar:INTERNAL-BEHAVIORS autosar:SWC-INTERNAL-BEHAVIOR ) ;
        sh:class autosar:SWC-INTERNAL-BEHAVIOR ;
        sh:severity sh:Info ;
        sh:message "An AtomicSwComponentType can aggregate SWC-INTERNAL-BEHAVIOR as added value." ;
    ] ;
.

# TPS_SWCT_01109 - Adding the SwcInternalBehavior in a later process step
autosar:TPS_SWCT_01109_Shape
    a sh:NodeShape ;

    sh:targetClass autosar:SWC-INTERNAL-BEHAVIOR ;

    sh:severity sh:Info ;
    sh:message "SWC-INTERNAL-BEHAVIOR aggregation is atpSplitable and may be added in a later process step." ;
.

# TPS_SWCT_01110 - Symbolic name of a software-component
autosar:TPS_SWCT_01110_Shape
    a sh:NodeShape ;

    # AtomicSwComponentType is abstract; use concrete component types from path_variants
    sh:targetClass autosar:APPLICATION-SW-COMPONENT-TYPE ;
    sh:targetClass autosar:COMPLEX-DEVICE-DRIVER-SW-COMPONENT-TYPE ;
    sh:targetClass autosar:ECU-ABSTRACTION-SW-COMPONENT-TYPE ;
    sh:targetClass autosar:NV-BLOCK-SW-COMPONENT-TYPE ;
    sh:targetClass autosar:SENSOR-ACTUATOR-SW-COMPONENT-TYPE ;
    sh:targetClass autosar:SERVICE-PROXY-SW-COMPONENT-TYPE ;
    sh:targetClass autosar:SERVICE-SW-COMPONENT-TYPE ;

    sh:property [
        sh:path autosar:SYMBOL-PROPS ;
        sh:class autosar:SYMBOL-PROPS ;
        sh:maxCount 1 ;
        sh:severity sh:Info ;
        sh:message "AtomicSwComponentType may own SYMBOL-PROPS providing a symbolic name to resolve name clashes." ;
    ] ;
.

# TPS_SWCT_01111 - PortPrototypes need an additional model artifact, the PortInterface
autosar:TPS_SWCT_01111_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:PORT-PROTOTYPE ;
    sh:severity sh:Info ;
    sh:message "Each PORT-PROTOTYPE conceptually needs an associated PORT-INTERFACE as an additional model artifact." ;
.

# TPS_SWCT_01113 - Connecting two PortPrototypes
autosar:TPS_SWCT_01113_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:P-PORT-PROTOTYPE ;
    sh:severity sh:Info ;
    sh:message "Two SwComponentPrototypes are connected by hooking up P/PR-PORT-PROTOTYPEs to compatible R/PR-PORT-PROTOTYPEs." ;
.

# TPS_SWCT_01114 - SenderReceiverInterface
autosar:TPS_SWCT_01114_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:PORT-PROTOTYPE ;
    sh:severity sh:Info ;
    sh:message "SENDER-RECEIVER-INTERFACE describes what information is sent/received via PORT-PROTOTYPEs in an asynchronous communication pattern." ;
.


# 1) SHACL shapes

#################################################################
# TPS_SWCT_01115 - invalidationPolicy (structural only)
#################################################################

autosar:TPS_SWCT_01115
    a sh:NodeShape ;
    sh:severity sh:Info ;
    sh:targetClass autosar:INVALIDATION-POLICY ;

    # DATA-ELEMENT-REF : mandatory, DEST = VARIABLE-DATA-PROTOTYPE
    sh:property [
        sh:path autosar:DATA-ELEMENT-REF ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "INVALIDATION-POLICY must reference exactly one dataElement (VARIABLE-DATA-PROTOTYPE) via DATA-ELEMENT-REF." ;
    ] ;

    # HANDLE-INVALID : optional enum, if present must be single
    sh:property [
        sh:path autosar:HANDLE-INVALID ;
        sh:maxCount 1 ;
        sh:message "HANDLE-INVALID in INVALIDATION-POLICY, if present, shall occur at most once." ;
    ] .

#################################################################
# TPS_SWCT_01116 - swImplPolicy (definition only, no hard constraint)
#################################################################

# No structural constraint beyond existing schema; omit SHACL.

#################################################################
# TPS_SWCT_01117 - Communication patterns for sender-receiver communication
#################################################################

# Relationship is about possible connection multiplicities (1:n, n:1),
# which is not directly checkable from local XML structure alone.
# No SHACL shape emitted.

#################################################################
# TPS_SWCT_01118 - ClientServerInterface / ClientServerOperation reuse
#################################################################

autosar:TPS_SWCT_01118
    a sh:NodeShape ;
    sh:severity sh:Violation ;
    sh:targetClass autosar:CLIENT-SERVER-OPERATION ;

    # Each CLIENT-SERVER-OPERATION must belong to exactly one CLIENT-SERVER-INTERFACE.
    # This is modeled via SPARQL to ensure non-reuse.
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A CLIENT-SERVER-OPERATION must not be reused in more than one CLIENT-SERVER-INTERFACE." ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this
            WHERE {
              # Find all interfaces that contain this operation
              {
                ?iface a autosar:CLIENT-SERVER-INTERFACE .
                ?iface autosar:OPERATIONS ?ops .
                ?ops autosar:CLIENT-SERVER-OPERATION ?this .
              }
              GROUP BY ?this
              HAVING (COUNT(DISTINCT ?iface) > 1)
            }
        """ ;
    ] .

#################################################################
# TPS_SWCT_01119 - Direction of ArgumentDataPrototypes
#################################################################

autosar:TPS_SWCT_01119
    a sh:NodeShape ;
    sh:severity sh:Violation ;
    sh:targetClass autosar:ARGUMENT-DATA-PROTOTYPE ;

    sh:property [
        sh:path autosar:DIRECTION ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "ARGUMENT-DATA-PROTOTYPE must have exactly one DIRECTION (in, out, or inout)." ;
    ] .

#################################################################
# TPS_SWCT_01120 - Client needs to provide ArgumentDataPrototypes
#################################################################

# Behavioral / runtime requirement (client invocation), not statically
# checkable from design-time XML alone. No SHACL emitted.

#################################################################
# TPS_SWCT_01121 - Pass correct data type
#################################################################

autosar:TPS_SWCT_01121
    a sh:NodeShape ;
    sh:severity sh:Violation ;
    sh:targetClass autosar:ARGUMENT-DATA-PROTOTYPE ;

    # DIRECTION must exist (in/out/inout)
    sh:property [
        sh:path autosar:DIRECTION ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "ARGUMENT-DATA-PROTOTYPE must have exactly one DIRECTION." ;
    ] ;

    # TYPE-TREF must exist and be single; DEST restriction handled by cross-file resolver
    sh:property [
        sh:path autosar:TYPE-TREF ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "ARGUMENT-DATA-PROTOTYPE must have exactly one TYPE-TREF to its data type." ;
    ] .


#################################################################
# SHACL for TPS_SWCT_01122 - Synchronous call of ClientServerOperation
#################################################################

autosar:TPS_SWCT_01122 a sh:NodeShape ;
  sh:targetClass autosar:CLIENT-SERVER-OPERATION ;
  sh:severity sh:Info ;
  sh:message "For synchronous operation calls, for each ArgumentDataPrototype of direction out or inout, the client receives a value of the correct AutosarDataType as part of the response."@en .

#################################################################
# SHACL for TPS_SWCT_01123 - No default values for ArgumentDataPrototypes
#################################################################

autosar:TPS_SWCT_01123 a sh:NodeShape ;
  sh:targetClass autosar:ARGUMENT-DATA-PROTOTYPE ;
  sh:severity sh:Violation ;
  sh:message "ArgumentDataPrototypes defined in the context of a ClientServerOperation shall not define default values."@en .

#################################################################
# SHACL for TPS_SWCT_01125 - serverArgumentImplPolicy
#################################################################

autosar:TPS_SWCT_01125 a sh:NodeShape ;
  sh:targetClass autosar:ARGUMENT-DATA-PROTOTYPE ;
  sh:severity sh:Info ;
  sh:property [
    sh:path autosar:SERVER-ARGUMENT-IMPL-POLICY ;
    sh:datatype autosar:SERVER-ARGUMENT-IMPL-POLICY-ENUM
  ] ;
  sh:message "serverArgumentImplPolicy on ArgumentDataPrototype influences compatibility checks for ClientServerOperations (useArrayBaseType / useVoid)."@en .

#################################################################
# SHACL for TPS_SWCT_01126 - Access to partial networking via BswM
#################################################################

autosar:TPS_SWCT_01126 a sh:NodeShape ;
  sh:targetClass autosar:ROLE-BASED-PORT-ASSIGNMENT ;
  sh:severity sh:Violation ;
  sh:property [
    sh:path autosar:ROLE ;
    sh:datatype autosar:IDENTIFIER ;
    sh:minCount 1 ;
    sh:maxCount 1
  ] ;
  sh:message "RoleBasedPortAssignment valid roles: control [0..1], status [0..1]. RepresentedPortGroup shall reference the applicable PortGroup for the partial network."@en .

#################################################################
# SHACL for TPS_SWCT_01127 - Byte array with variable size
#################################################################

autosar:TPS_SWCT_01127 a sh:NodeShape ;
  sh:targetClass autosar:SW-TEXT-PROPS ;
  sh:severity sh:Info ;
  sh:message "SwTextProps can be used to define byte arrays of variable size."@en .

#################################################################
# SHACL for TPS_SWCT_01128 - SwRecordLayout needed for ApplicationPrimitiveDataType of category STRING
#################################################################

autosar:TPS_SWCT_01128 a sh:NodeShape ;
  sh:targetClass autosar:APPLICATION-PRIMITIVE-DATA-TYPE ;
  sh:severity sh:Violation ;
  sh:property [
    sh:path autosar:CATEGORY ;
    sh:datatype autosar:CATEGORY-STRING
  ] ;
  sh:property [
    sh:path autosar:SW-DATA-DEF-PROPS ;
    sh:minCount 1
  ] ;
  sh:message "ApplicationPrimitiveDataType of category STRING shall reference a SwRecordLayout via SwDataDefProps to enable creation of a matching ImplementationDataType."@en .

#################################################################
# SHACL for TPS_SWCT_01129 - Express diagnostic capabilities
#################################################################

autosar:TPS_SWCT_01129 a sh:NodeShape ;
  sh:targetClass autosar:ROLE-BASED-PORT-ASSIGNMENT ;
  sh:severity sh:Violation ;
  sh:property [
    sh:path autosar:ROLE ;
    sh:datatype autosar:IDENTIFIER ;
    sh:minCount 1 ;
    sh:maxCount 1
  ] ;
  sh:message "For every used ClientServerInterface there shall be a RoleBasedPortAssignment whose role equals the name of the standardized ClientServerInterface."@en .


# SHACL shapes for TPS_SWCT_01132 .. TPS_SWCT_01138

autosar:TPS_SWCT_01132_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:ATOMIC-SW-COMPONENT-TYPE ;
    sh:property [
        sh:path ( autosar:ROLE-BASED-PORT-ASSIGNMENT autosar:ROLE ) ;
        sh:hasValue "OperationCycle" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "AtomicSwComponentType with DiagnosticOperationCycleNeeds shall have exactly one RoleBasedPortAssignment with ROLE = 'OperationCycle'." ;
    ] .

autosar:TPS_SWCT_01133_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:ATOMIC-SW-COMPONENT-TYPE ;
    sh:property [
        sh:path ( autosar:ROLE-BASED-PORT-ASSIGNMENT autosar:ROLE ) ;
        sh:hasValue "AgingCycle" ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "AtomicSwComponentType with DiagnosticEventManagerNeeds shall have at most one RoleBasedPortAssignment with ROLE = 'AgingCycle'." ;
    ] .

autosar:TPS_SWCT_01134_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:ATOMIC-SW-COMPONENT-TYPE ;
    sh:property [
        sh:path ( autosar:ROLE-BASED-PORT-ASSIGNMENT autosar:ROLE ) ;
        sh:hasValue "EnableCondition" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "AtomicSwComponentType with DiagnosticEnableConditionNeeds shall have exactly one RoleBasedPortAssignment with ROLE = 'EnableCondition'." ;
    ] .

autosar:TPS_SWCT_01135_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:ATOMIC-SW-COMPONENT-TYPE ;
    sh:property [
        sh:path ( autosar:ROLE-BASED-PORT-ASSIGNMENT autosar:ROLE ) ;
        sh:hasValue "StorageCondition" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "AtomicSwComponentType with DiagnosticStorageConditionNeeds shall have exactly one RoleBasedPortAssignment with ROLE = 'StorageCondition'." ;
    ] .

autosar:TPS_SWCT_01136_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:ATOMIC-SW-COMPONENT-TYPE ;
    sh:property [
        sh:path ( autosar:ROLE-BASED-PORT-ASSIGNMENT autosar:ROLE ) ;
        sh:hasValue "IndicatorStatus" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "AtomicSwComponentType shall have exactly one RoleBasedPortAssignment with ROLE = 'IndicatorStatus' to retrieve lamp status." ;
    ] .

# TPS_SWCT_01137: target_class.xml_tag is null (ServiceNeeds is abstract / not directly instantiated),
# so no SHACL targetClass can be bound according to the rules; handled only in SMT.

autosar:TPS_SWCT_01138_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:ATOMIC-SW-COMPONENT-TYPE ;
    sh:property [
        sh:path ( autosar:ROLE-BASED-PORT-ASSIGNMENT autosar:ROLE ) ;
        sh:hasValue "DTCSuppression" ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "AtomicSwComponentType with DiagnosticEventManagerNeeds shall have exactly one RoleBasedPortAssignment with ROLE = 'DTCSuppression'." ;
    ] .


# 1) TPS_SWCT_01139 - AtomicSwComponentType informs the Dem that the PTO is active
autosar:TPS_SWCT_01139_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:ATOMIC-SW-COMPONENT-TYPE ;
    sh:property [
        sh:path ( autosar:ROLE-BASED-PORT-ASSIGNMENT autosar:ROLE ) ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "For DiagnosticEventManagerNeeds, the applicable role is PowerTakeOff." ;
        sh:severity sh:Warning
    ] .

# 2) TPS_SWCT_01140 - AtomicSwComponentType needs information about specific DTC without being a diagnostic monitor
autosar:TPS_SWCT_01140_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:ATOMIC-SW-COMPONENT-TYPE ;
    sh:property [
        sh:path ( autosar:ROLE-BASED-PORT-ASSIGNMENT autosar:ROLE ) ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "For DtcStatusChangeNotificationNeeds, the applicable role is CallbackDTCStatusChange." ;
        sh:severity sh:Warning
    ] .

# 3) TPS_SWCT_01141 - AbstractRequiredPortPrototypes typed by an NvDataInterface
# 运行时行为（未连接时仍需合理值），缺乏可观测结构，不建 SHACL

# 4) TPS_SWCT_01142 - NvBlockSwComponentType ports exclusively typed by NvDataInterfaces
autosar:TPS_SWCT_01142_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:NV-BLOCK-SW-COMPONENT-TYPE ;
    sh:property [
        sh:path ( autosar:PORTS ) ;
        sh:minCount 0 ;
        sh:message "Ports of NvBlockSwComponentType shall be exclusively typed by NvDataInterfaces (checked in SMT)." ;
        sh:severity sh:Info
    ] .

# 5) TPS_SWCT_01143 - NvBlockSwComponentType can have PPortPrototypes and RPortPrototypes
autosar:TPS_SWCT_01143_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:NV-BLOCK-SW-COMPONENT-TYPE ;
    sh:property [
        sh:path ( autosar:PORTS ) ;
        sh:minCount 0 ;
        sh:message "NvBlockSwComponentType may have PPortPrototypes and RPortPrototypes for reading/writing nv data." ;
        sh:severity sh:Info
    ] .

# 6) TPS_SWCT_01146 - romBlock is optional
autosar:TPS_SWCT_01146_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:NV-BLOCK-DESCRIPTOR ;
    sh:property [
        sh:path autosar:ROM-BLOCK ;
        sh:class autosar:PARAMETER-DATA-PROTOTYPE ;
        sh:maxCount 1 ;
        sh:message "ROM-BLOCK is optional (0..1) for NvBlockDescriptor." ;
        sh:severity sh:Info
    ] .

# 7) TPS_SWCT_01147 - No romBlock is configured
