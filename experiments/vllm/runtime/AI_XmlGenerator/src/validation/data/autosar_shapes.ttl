# 1) Existence of attributes of TransformerHardErrorEvent (constr_1397)

autosar:Constr_1397_TransformerHardErrorEvent
    a sh:NodeShape ;
    sh:targetClass autosar:TRANSFORMER-HARD-ERROR-EVENT ;

    # OPERATION-IREF present at most once
    sh:property [
        sh:path autosar:OPERATION-IREF ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "TRANSFORMER-HARD-ERROR-EVENT: OPERATION-IREF and TRIGGER-IREF shall be mutually exclusive and at least one of them shall exist."@en ;
    ] ;

    # TRIGGER-IREF present at most once
    sh:property [
        sh:path autosar:TRIGGER-IREF ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "TRANSFORMER-HARD-ERROR-EVENT: OPERATION-IREF and TRIGGER-IREF shall be mutually exclusive and at least one of them shall exist."@en ;
    ] ;

    # Structural part of mutual exclusion + existence is handled in SMT; here only a SPARQL info check
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Info ;
        sh:message "For each TRANSFORMER-HARD-ERROR-EVENT, either OPERATION-IREF or TRIGGER-IREF shall exist, and they shall not both exist."@en ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this
            WHERE {
              ?this a autosar:TRANSFORMER-HARD-ERROR-EVENT .
              OPTIONAL { ?this autosar:OPERATION-IREF ?op . }
              OPTIONAL { ?this autosar:TRIGGER-IREF ?tr . }
              FILTER( !bound(?op) && !bound(?tr) || (bound(?op) && bound(?tr)) )
            }
        """ ;
    ] .



# 2) Existence of attributes of BaseTypeDirectDefinition (constr_1398)

autosar:Constr_1398_BaseTypeDirectDefinition
    a sh:NodeShape ;
    sh:targetClass autosar:BASE-TYPE-DIRECT-DEFINITION ;

    # BASE-TYPE-ENCODING must exist exactly once
    sh:property [
        sh:path autosar:BASE-TYPE-ENCODING ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "BASE-TYPE-DIRECT-DEFINITION: BASE-TYPE-ENCODING shall exist exactly once."@en ;
    ] ;

    # BYTE-ORDER at most once (conditional existence + value restriction in SPARQL)
    sh:property [
        sh:path autosar:BYTE-ORDER ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "BASE-TYPE-DIRECT-DEFINITION: BYTE-ORDER shall exist at most once."@en ;
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "If BASE-TYPE-ENCODING is UTF-16 then BYTE-ORDER shall exist and be either mostSignificantByteFirst or mostSignificantByteLast."@en ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this
            WHERE {
              ?this a autosar:BASE-TYPE-DIRECT-DEFINITION .
              ?this autosar:BASE-TYPE-ENCODING ?enc .
              FILTER(str(?enc) = "UTF-16") .
              OPTIONAL { ?this autosar:BYTE-ORDER ?bo . }
              FILTER( !bound(?bo) || (str(?bo) != "mostSignificantByteFirst" && str(?bo) != "mostSignificantByteLast") )
            }
        """ ;
    ] .



# 3) Standardized values of ModeDeclarationGroup.category (constr_1399)

autosar:Constr_1399_ModeDeclarationGroup_Category
    a sh:NodeShape ;
    sh:targetClass autosar:MODE-DECLARATION-GROUP ;

    sh:property [
        sh:path autosar:CATEGORY ;
        sh:maxCount 1 ;
        sh:in ( "EXPLICIT_ORDER" "ALPHABETIC_ORDER" ) ;
        sh:severity sh:Violation ;
        sh:message "MODE-DECLARATION-GROUP: CATEGORY, if present, shall be either EXPLICIT_ORDER or ALPHABETIC_ORDER; custom values are not allowed."@en ;
    ] .



# 4) Reference to a specific DataTransformation (constr_1400)

# Structural DEST typing for the three references

autosar:Constr_1400_DataPrototypeMapping_FirstToSecond
    a sh:NodeShape ;
    sh:targetClass autosar:DATA-PROTOTYPE-MAPPING ;
    sh:property [
        sh:path autosar:FIRST-TO-SECOND-DATA-TRANSFORMATION-REF ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "DATA-PROTOTYPE-MAPPING: FIRST-TO-SECOND-DATA-TRANSFORMATION-REF shall reference a DATA-TRANSFORMATION."@en ;
    ] .

autosar:Constr_1400_ISignal_DataTransformation
    a sh:NodeShape ;
    sh:targetClass autosar:I-SIGNAL ;
    sh:property [
        sh:path ( autosar:DATA-TRANSFORMATIONS autosar:DATA-TRANSFORMATION-REF-CONDITIONAL ) ;
        sh:severity sh:Violation ;
        sh:message "I-SIGNAL: DATA-TRANSFORMATION-REF-CONDITIONAL shall reference a DATA-TRANSFORMATION."@en ;
    ] .

autosar:Constr_1400_ISignalGroup_ComBasedSignalGroupTransformation
    a sh:NodeShape ;
    sh:targetClass autosar:I-SIGNAL-GROUP ;
    sh:property [
        sh:path ( autosar:COM-BASED-SIGNAL-GROUP-TRANSFORMATIONS autosar:DATA-TRANSFORMATION-REF-CONDITIONAL ) ;
        sh:severity sh:Violation ;
        sh:message "I-SIGNAL-GROUP: COM-BASED-SIGNAL-GROUP-TRANSFORMATIONS/DATA-TRANSFORMATION-REF-CONDITIONAL shall reference a DATA-TRANSFORMATION."@en ;
    ] .

# The global uniqueness / exclusivity of references to a specific DATA-TRANSFORMATION
# is handled in SMT; SHACL does not enforce the global counting here.



# 5) Restrictions on the relation between DataPrototypeMapping and DataTransformation (constr_1401)

# No stable local path structure is given; this is a global relationship constraint.
# SHACL left empty; handled purely in SMT.



# 6) Applicability of core-related possible values ... (constr_1402)

# MemorySection part

autosar:Constr_1402_MemorySection
    a sh:NodeShape ;
    sh:targetClass autosar:MEMORY-SECTION ;

    # OPTIONS/OPTION (no hard cardinality, just structure)
    sh:property [
        sh:path ( autosar:OPTIONS autosar:OPTION ) ;
        sh:severity sh:Violation ;
        sh:message "MEMORY-SECTION: OPTIONS/OPTION structure."@en ;
    ] ;

    # SW-ADDRMETHOD-REF must exist exactly once
    sh:property [
        sh:path autosar:SW-ADDRMETHOD-REF ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "MEMORY-SECTION: SW-ADDRMETHOD-REF shall exist exactly once."@en ;
    ] .

# SwAddrMethod part

autosar:Constr_1402_SwAddrMethod
    a sh:NodeShape ;
    sh:targetClass autosar:SW-ADDR-METHOD ;

    sh:property [
        sh:path ( autosar:OPTIONS autosar:OPTION ) ;
        sh:severity sh:Violation ;
        sh:message "SW-ADDR-METHOD: OPTIONS/OPTION structure."@en ;
    ] ;

    sh:property [
        sh:path autosar:SECTION-INITIALIZATION-POLICY ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "SW-ADDR-METHOD: SECTION-INITIALIZATION-POLICY shall exist at most once."@en ;
    ] ;

    # Conditional value restriction in SPARQL
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "If OPTION is coreLocal then SECTION-INITIALIZATION-POLICY shall be INIT or CLEARED."@en ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this
            WHERE {
              ?this a autosar:SW-ADDR-METHOD .
              OPTIONAL {
                ?this autosar:OPTIONS ?opts .
                ?opts autosar:OPTION ?optVal .
              }
              FILTER( bound(?optVal) && str(?optVal) = "coreLocal" )
              OPTIONAL { ?this autosar:SECTION-INITIALIZATION-POLICY ?sip . }
              FILTER( !bound(?sip) || (str(?sip) != "INIT" && str(?sip) != "CLEARED") )
            }
        """ ;
    ] .



# 7) NvBlockDataMappings to a given nvData shall be unambiguous (constr_1403)

# Local structure for NvDataInterface.nvData

autosar:Constr_1403_NvDataInterface
    a sh:NodeShape ;
    sh:targetClass autosar:NV-DATA-INTERFACE ;

    sh:property [
        sh:path ( autosar:NV-DATAS autosar:VARIABLE-DATA-PROTOTYPE ) ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "NV-DATA-INTERFACE: At least one NV-DATAS/VARIABLE-DATA-PROTOTYPE (nvData) shall exist."@en ;
    ] .

# Global unambiguity of NvBlockDataMapping is handled in SMT.


# ===== SHACL for constr_1404 =====


# ===== SHACL for constr_2002 (dataReadAccess) =====
autosar:constr_2002
  a sh:NodeShape ;
  sh:targetClass autosar:RUNNABLE-ENTITY ;
  sh:severity sh:Violation ;
  sh:message "VariableAccess in role dataReadAccess shall refer to an RPortPrototype or PRPortPrototype typed by SenderReceiverInterface or NvDataInterface." ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "Each VARIABLE-ACCESS under DATA-READ-ACCESSS shall access a variable via a port that is an RPortPrototype or PRPortPrototype typed by SenderReceiverInterface or NvDataInterface." ;
    sh:select """
      PREFIX autosar: <http://autosar.org/>

      SELECT ?this ?va
      WHERE {
        ?this a autosar:RUNNABLE-ENTITY .
        ?this autosar:DATA-READ-ACCESSS ?readCont .
        ?readCont autosar:VARIABLE-ACCESS ?va .

        ?va autosar:ACCESSED-VARIABLE ?avar .
        ?avar autosar:AUTOSAR-VARIABLE-IREF ?viref .

        # Port reference inside the iref (abstracted as PORT-PROTOTYPE-REF)
        ?viref autosar:PORT-PROTOTYPE-REF ?port .

        FILTER NOT EXISTS {
          ?port a ?portType .
          FILTER (?portType IN (autosar:R-PORT-PROTOTYPE, autosar:PR-PORT-PROTOTYPE))
          ?port autosar:TYPE-TREF ?pi .
          ?pi a ?piType .
          FILTER (?piType IN (autosar:SENDER-RECEIVER-INTERFACE, autosar:NV-DATA-INTERFACE))
        }
      }
    """ ;
  ] .

# ===== SHACL for constr_2003 (dataWriteAccess) =====
autosar:constr_2003
  a sh:NodeShape ;
  sh:targetClass autosar:RUNNABLE-ENTITY ;
  sh:severity sh:Violation ;
  sh:message "VariableAccess in role dataWriteAccess shall refer to a PPortPrototype or PRPortPrototype typed by SenderReceiverInterface or NvDataInterface." ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "Each VARIABLE-ACCESS under DATA-WRITE-ACCESSS shall access a variable via a port that is a PPortPrototype or PRPortPrototype typed by SenderReceiverInterface or NvDataInterface." ;
    sh:select """
      PREFIX autosar: <http://autosar.org/>

      SELECT ?this ?va
      WHERE {
        ?this a autosar:RUNNABLE-ENTITY .
        ?this autosar:DATA-WRITE-ACCESSS ?writeCont .
        ?writeCont autosar:VARIABLE-ACCESS ?va .

        ?va autosar:ACCESSED-VARIABLE ?avar .
        ?avar autosar:AUTOSAR-VARIABLE-IREF ?viref .
        ?viref autosar:PORT-PROTOTYPE-REF ?port .

        FILTER NOT EXISTS {
          ?port a ?portType .
          FILTER (?portType IN (autosar:P-PORT-PROTOTYPE, autosar:PR-PORT-PROTOTYPE))
          ?port autosar:TYPE-TREF ?pi .
          ?pi a ?piType .
          FILTER (?piType IN (autosar:SENDER-RECEIVER-INTERFACE, autosar:NV-DATA-INTERFACE))
        }
      }
    """ ;
  ] .

# ===== SHACL for constr_2004 (dataSendPoint) =====
autosar:constr_2004
  a sh:NodeShape ;
  sh:targetClass autosar:RUNNABLE-ENTITY ;
  sh:severity sh:Violation ;
  sh:message "VariableAccess in role dataSendPoint shall refer to a PPortPrototype or PRPortPrototype typed by SenderReceiverInterface or NvDataInterface." ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "Each VARIABLE-ACCESS under DATA-SEND-POINTS shall access a variable via a port that is a PPortPrototype or PRPortPrototype typed by SenderReceiverInterface or NvDataInterface." ;
    sh:select """
      PREFIX autosar: <http://autosar.org/>

      SELECT ?this ?va
      WHERE {
        ?this a autosar:RUNNABLE-ENTITY .
        ?this autosar:DATA-SEND-POINTS ?sendCont .
        ?sendCont autosar:VARIABLE-ACCESS ?va .

        ?va autosar:ACCESSED-VARIABLE ?avar .
        ?avar autosar:AUTOSAR-VARIABLE-IREF ?viref .
        ?viref autosar:PORT-PROTOTYPE-REF ?port .

        FILTER NOT EXISTS {
          ?port a ?portType .
          FILTER (?portType IN (autosar:P-PORT-PROTOTYPE, autosar:PR-PORT-PROTOTYPE))
          ?port autosar:TYPE-TREF ?pi .
          ?pi a ?piType .
          FILTER (?piType IN (autosar:SENDER-RECEIVER-INTERFACE, autosar:NV-DATA-INTERFACE))
        }
      }
    """ ;
  ] .

# ===== SHACL for constr_2005 (dataReceivePointByValue / ByArgument) =====

# ===== SHACL for constr_2006 (AsynchronousServerCallPoint cardinality) =====
autosar:constr_2006
  a sh:NodeShape ;
  sh:targetClass autosar:ASYNCHRONOUS-SERVER-CALL-POINT ;
  sh:severity sh:Violation ;
  sh:message "Each AsynchronousServerCallPoint shall be referenced by exactly one AsynchronousServerCallResultPoint." ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "AsynchronousServerCallPoint must be referenced by exactly one AsynchronousServerCallResultPoint." ;
    sh:select """
      PREFIX autosar: <http://autosar.org/>

      SELECT ?this
      WHERE {
        ?this a autosar:ASYNCHRONOUS-SERVER-CALL-POINT .

        {
          SELECT ?this (COUNT(?resPt) AS ?cnt)
          WHERE {
            ?run a autosar:RUNNABLE-ENTITY .
            ?run autosar:ASYNCHRONOUS-SERVER-CALL-RESULT-POINTS ?resCont .
            ?resCont autosar:ASYNCHRONOUS-SERVER-CALL-RESULT-POINT ?resPt .
            ?resPt autosar:ASYNCHRONOUS-SERVER-CALL-POINT-REF ?this .
          }
          GROUP BY ?this
        }

        FILTER (?cnt != 1)
      }
    """ ;
  ] .

# ===== SHACL for constr_2007 (PerInstanceMemory type/typeDefinition consistency) =====
autosar:constr_2007
  a sh:NodeShape ;
  sh:targetClass autosar:SWC-INTERNAL-BEHAVIOR ;
  sh:severity sh:Violation ;
  sh:message "All PerInstanceMemorys of the same SwcInternalBehavior with identical TYPE shall define an identical TYPE-DEFINITION." ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "Within one SWC-INTERNAL-BEHAVIOR, PerInstanceMemory elements that share the same TYPE must have the same TYPE-DEFINITION." ;
    sh:select """
      PREFIX autosar: <http://autosar.org/>

      SELECT ?this ?pim1 ?pim2
      WHERE {
        ?this a autosar:SWC-INTERNAL-BEHAVIOR .
        ?this autosar:PER-INSTANCE-MEMORY ?pim1 .
        ?this autosar:PER-INSTANCE-MEMORY ?pim2 .
        FILTER (?pim1 != ?pim2)

        ?pim1 autosar:TYPE ?type1 .
        ?pim2 autosar:TYPE ?type2 .
        FILTER (STR(?type1) = STR(?type2))

        ?pim1 autosar:TYPE-DEFINITION ?td1 .
        ?pim2 autosar:TYPE-DEFINITION ?td2 .
        FILTER (STR(?td1) != STR(?td2))
      }
    """ ;
  ] .


# 1) constr_2009 - Supported kinds of PortPrototypes of a NvBlockSwComponentType
autosar:constr_2009_SupportedKindsOfPorts_NvBlockSwComponentType
    a sh:NodeShape ;
    sh:targetClass autosar:NV-BLOCK-SW-COMPONENT-TYPE ;
    sh:severity sh:Violation ;
    sh:message "With respect to external communication, NvBlockSwComponentType is limited to PortPrototypes typed by NvDataInterfaces or ClientServerInterfaces, and RPortPrototypes typed by ModeSwitchInterfaces."@en ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "NvBlockSwComponentType may only use ports typed by NvDataInterface/ClientServerInterface, and RPorts typed by ModeSwitchInterface."@en ;
        sh:select """
PREFIX autosar: <http://autosar.org/>

SELECT ?this
WHERE {
  ?this a autosar:NV-BLOCK-SW-COMPONENT-TYPE .

  # Any port of this component
  ?this autosar:PORTS ?port .

  # Port type reference (interface)
  ?port autosar:TYPE-TREF ?ifRef .
  ?ifRef autosar:DEST ?ifDest .

  # Port direction (if available)
  OPTIONAL { ?port autosar:PORT-DIRECTION ?dir . }

  FILTER NOT (
    # Non-RPort: NvDataInterface or ClientServerInterface
    ( (!BOUND(?dir) || ?dir != "R-PORT-PROTOTYPE")
      && (?ifDest = "NV-DATA-INTERFACE" || ?ifDest = "CLIENT-SERVER-INTERFACE")
    )
    ||
    # RPort: ModeSwitchInterface
    ( ?dir = "R-PORT-PROTOTYPE"
      && ?ifDest = "MODE-SWITCH-INTERFACE"
    )
  )
}
""" ;
    ] .



# 2) constr_2010 - Connections between SwComponentPrototypes of type NvBlockSwComponentType
# SHACL left empty (structural paths for this relationship are not fully specified here).



# 3) constr_2011 - Connections between SwComponentPrototypes typed by NvBlockSwComponentType and other AtomicSwComponentTypes
# SHACL left empty (requires full connector topology, better handled in SMT).



# 4) constr_2012 - Compatibility of ImplementationDataTypes used for ramBlock and romBlock
autosar:constr_2012_Compat_ImplDataType_RamRom
    a sh:NodeShape ;
    sh:targetClass autosar:NV-BLOCK-DESCRIPTOR ;
    sh:severity sh:Violation ;
    sh:message "The ImplementationDataTypes of ramBlock and romBlock of an NvBlockDescriptor shall be compatible."@en ;

    # ramBlock must exist exactly once
    sh:property [
        sh:path ( autosar:RAM-BLOCK ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    # romBlock is optional, but if present must be compatible with ramBlock (delegated to SMT / external check)
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "If ROM-BLOCK is present, its ImplementationDataType shall be compatible with that of RAM-BLOCK."@en ;
        sh:select """
PREFIX autosar: <http://autosar.org/>

SELECT ?this
WHERE {
  ?this a autosar:NV-BLOCK-DESCRIPTOR .

  ?this autosar:RAM-BLOCK ?ramBlock .
  OPTIONAL { ?this autosar:ROM-BLOCK ?romBlock . }

  FILTER(BOUND(?romBlock))

  # ImplementationDataType references (tool-specific properties, here modeled generically)
  ?ramBlock autosar:TYPE-TREF ?ramTypeRef .
  ?ramTypeRef autosar:DEST ?ramTypeDest .

  ?romBlock autosar:TYPE-TREF ?romTypeRef .
  ?romTypeRef autosar:DEST ?romTypeDest .

  FILTER (?ramTypeDest != ?romTypeDest)
}
""" ;
    ] .



# 5) constr_2013 - Compatibility of ImplementationDataTypes for NvBlockDataMapping
autosar:constr_2013_Compat_ImplDataType_NvBlockDataMapping
    a sh:NodeShape ;
    sh:targetClass autosar:NV-BLOCK-DATA-MAPPING ;
    sh:severity sh:Violation ;
    sh:message "NvBlockDataMapping is only valid if the ImplementationDataType of nvRamBlockElement is compatible to that of writtenNvData / writtenReadNvData / readNvData."@en ;

    # nvRamBlockElement must exist
    sh:property [
        sh:path autosar:NV-RAM-BLOCK-ELEMENT ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    # Optional roles: READ-NV-DATA, WRITTEN-NV-DATA, WRITTEN-READ-NV-DATA
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "ImplementationDataType of nvRamBlockElement must be compatible with ImplementationDataType of writtenNvData / writtenReadNvData / readNvData."@en ;
        sh:select """
PREFIX autosar: <http://autosar.org/>

SELECT ?this
WHERE {
  ?this a autosar:NV-BLOCK-DATA-MAPPING .

  ?this autosar:NV-RAM-BLOCK-ELEMENT ?ramElem .

  OPTIONAL { ?this autosar:READ-NV-DATA ?readVar . }
  OPTIONAL { ?this autosar:WRITTEN-NV-DATA ?writtenVar . }
  OPTIONAL { ?this autosar:WRITTEN-READ-NV-DATA ?writtenReadVar . }

  # At least one of the optional roles must be present to check compatibility
  FILTER(BOUND(?readVar) || BOUND(?writtenVar) || BOUND(?writtenReadVar))

  # Generic ImplementationDataType references (tool-specific)
  ?ramElem autosar:TYPE-TREF ?ramTypeRef .
  ?ramTypeRef autosar:DEST ?ramTypeDest .

  OPTIONAL {
    ?readVar autosar:TYPE-TREF ?readTypeRef .
    ?readTypeRef autosar:DEST ?readTypeDest .
  }
  OPTIONAL {
    ?writtenVar autosar:TYPE-TREF ?writtenTypeRef .
    ?writtenTypeRef autosar:DEST ?writtenTypeDest .
  }
  OPTIONAL {
    ?writtenReadVar autosar:TYPE-TREF ?writtenReadTypeRef .
    ?writtenReadTypeRef autosar:DEST ?writtenReadTypeDest .
  }

  FILTER (
    (BOUND(?readTypeDest)        && ?readTypeDest        != ?ramTypeDest) ||
    (BOUND(?writtenTypeDest)     && ?writtenTypeDest     != ?ramTypeDest) ||
    (BOUND(?writtenReadTypeDest) && ?writtenReadTypeDest != ?ramTypeDest)
  )
}
""" ;
    ] .



# 6) constr_2014 - Limitation of RoleBasedPortAssignment.role in NvBlockDescriptors
autosar:constr_2014_Limitation_RoleBasedPortAssignment_role
    a sh:NodeShape ;
    sh:targetClass autosar:ROLE-BASED-PORT-ASSIGNMENT ;
    sh:severity sh:Violation ;
    sh:message "ROLE of RoleBasedPortAssignment in NvBlockDescriptors must be a valid standardized AUTOSAR NVRAM Manager interface role (e.g. NvMNotifyJobFinished, NvMNotifyInitBlock)."@en ;

    sh:property [
        sh:path autosar:ROLE ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            "NvMNotifyJobFinished"
            "NvMNotifyInitBlock"
        ) ;
    ] .



# 7) constr_2015 - Limitation of SwcInternalBehavior of a NvBlockSwComponentType
# Structural parts that can be expressed with given paths:

# 7a) DataReceivedEvent.disabledMode (optional, if present must be a valid R-MODE-IN-ATOMIC-SWC-INSTANCE-REF)
autosar:constr_2015_DisabledMode_DataReceivedEvent
    a sh:NodeShape ;
    sh:targetClass autosar:DATA-RECEIVED-EVENT ;
    sh:severity sh:Info ;
    sh:message "In SwcInternalBehavior of NvBlockSwComponentType, DataReceivedEvents may include disabledMode references (DISABLED-MODE-IREF) only as R-MODE-IN-ATOMIC-SWC-INSTANCE-REF."@en ;

    sh:property [
        sh:path ( autosar:DISABLED-MODE-IREFS autosar:DISABLED-MODE-IREF ) ;
    ] .

# 7b) RunnableEntity mandatory attributes symbol and canBeInvokedConcurrently
autosar:constr_2015_RunnableEntity_MandatoryAttrs
    a sh:NodeShape ;
    sh:targetClass autosar:RUNNABLE-ENTITY ;
    sh:severity sh:Violation ;
    sh:message "RunnableEntitys in SwcInternalBehavior of NvBlockSwComponentType shall define the mandatory attributes SYMBOL and CAN-BE-INVOKED-CONCURRENTLY only."@en ;

    sh:property [
        sh:path autosar:SYMBOL ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path autosar:CAN-BE-INVOKED-CONCURRENTLY ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

# Remaining parts of constr_2015 (restriction to certain event kinds, triggers, etc.)
# are left to SMT because they require global behavioral/topology reasoning.


# 1) SHACL shapes

#################################################################
# constr_2016 - Connections between SwComponentPrototypes of type ServiceProxySwComponentType
#################################################################

autosar:Constr_2016 a sh:NodeShape ;
  sh:targetClass autosar:PORT-PROTOTYPE ;
  sh:severity sh:Violation ;
  sh:message "A connection between PortPrototypes belonging to SwComponentPrototypes where both are typed by ServiceProxySwComponentType is not permitted." ;
  .

#################################################################
# constr_2017 - Ports of ServiceProxySwComponentTypes
#################################################################

# 目标是 PortPrototype，但语义依赖其所属 ServiceProxySwComponentType 及 PortInterface 类型，
# 这些跨层关系不适合用简单路径表达，交由 SMT 处理。此处仅保留目标类与说明。

autosar:Constr_2017 a sh:NodeShape ;
  sh:targetClass autosar:PORT-PROTOTYPE ;
  sh:severity sh:Violation ;
  sh:message "Ports of ServiceProxySwComponentTypes: only RPortPrototypes typed by SenderReceiverInterface or ports typed by PortInterface with isService=true are permitted." ;
  .

#################################################################
# constr_2018 - Supported remote communication of a ServiceProxySwComponentType
#################################################################

autosar:Constr_2018 a sh:NodeShape ;
  sh:targetClass autosar:R-PORT-PROTOTYPE ;
  sh:severity sh:Violation ;
  sh:message "For remote communication, ServiceProxySwComponentType can have only RPortPrototypes typed by SenderReceiverInterfaces in a 1:n communication scenario." ;
  .

#################################################################
# constr_2019 - ServiceSwComponentType shall have service ports only
#################################################################

autosar:Constr_2019 a sh:NodeShape ;
  sh:targetClass autosar:PORT-PROTOTYPE ;
  sh:severity sh:Violation ;
  sh:message "In the case of ServiceSwComponentType, all aggregated PortPrototypes need to be typed by a PortInterface with isService=true (with specified exceptions)." ;
  .

#################################################################
# constr_2020 - dataReadAccess can not be used for queued communication
#################################################################

# 目标语义主体是 VariableDataPrototype（swImplPolicy），
# 但 expression 通过 RunnableEntity/VariableAccess 的 dataReadAccess 角色触发。
# 结构路径复杂，交由 SMT 处理；此处仅给出 VariableDataPrototype 的基本形状。

autosar:Constr_2020 a sh:NodeShape ;
  sh:targetClass autosar:VARIABLE-DATA-PROTOTYPE ;
  sh:severity sh:Violation ;
  sh:message "The swImplPolicy of the VariableDataPrototype referenced by a VariableAccess in role dataReadAccess shall not be set to queued." ;
  .

#################################################################
# constr_2021 - WaitPoint referencing a DataReceivedEvent can not be used for non-queued communication
#################################################################

autosar:Constr_2021 a sh:NodeShape ;
  sh:targetClass autosar:VARIABLE-DATA-PROTOTYPE ;
  sh:severity sh:Violation ;
  sh:message "A WaitPoint referencing a DataReceivedEvent is permitted iff the swImplPolicy of the VariableDataPrototype referenced by this DataReceivedEvent is set to queued." ;
  .

#################################################################
# constr_2022 - Mutually exclusive use of SynchronousServerCallPoints and AsynchronousServerCallPoints
#################################################################

autosar:Constr_2022 a sh:NodeShape ;
  sh:targetClass autosar:ASYNCHRONOUS-SERVER-CALL-POINT ;
  sh:severity sh:Violation ;
  sh:message "A ClientServerOperation of a particular RPortPrototype shall be mutually exclusive referenced by either SynchronousServerCallPoints or AsynchronousServerCallPoints." ;
  .


# SHACL for constr_2023 - Consistency of timeout values
autosar:constr_2023 a sh:NodeShape ;
  sh:targetClass autosar:CLIENT-SERVER-OPERATION ;
  sh:severity sh:Violation ;
  sh:message "The timeout values of all ServerCallPoints referencing the same instance of ClientServerOperation in a RPortPrototype shall be identical."@en .

# SHACL for constr_2024 - enableTakeAddress is restricted to single instantiation
autosar:constr_2024 a sh:NodeShape ;
  sh:targetClass autosar:SW-COMPONENT-TYPE ;
  sh:severity sh:Violation ;
  sh:message "The definition of a PortAPIOption with enableTakeAddress set to true is only permitted for software-components where SwcInternalBehavior.supportsMultipleInstantiation is false."@en .

# SHACL for constr_2026 - Referenced VariableDataPrototype from AutosarVariableRef ...
autosar:constr_2026 a sh:NodeShape ;
  sh:targetClass autosar:VARIABLE-DATA-PROTOTYPE ;
  sh:severity sh:Violation ;
  sh:message "VariableDataPrototype referenced via localVariableRef of VariableAccess in roles writtenLocalVariable/readLocalVariable must be owned by the same SwcInternalBehavior as the RunnableEntity and be in role implicitInterRunnableVariable or explicitInterRunnableVariable."@en .

# SHACL for constr_2027 - SwcServiceDependency shall be defined for service ports only
autosar:constr_2027 a sh:NodeShape ;
  sh:targetClass autosar:APPLICATION-SW-COMPONENT-TYPE ;
  sh:severity sh:Violation ;
  sh:message "A PortPrototype referenced by SwcServiceDependency.assignedPort shall be typed by a PortInterface with isService=true, except for NV data management connections."@en .

# SHACL for constr_2028 - staticMemory is restricted to single instantiation
autosar:constr_2028 a sh:NodeShape ;
  sh:targetClass autosar:SWC-INTERNAL-BEHAVIOR ;
  sh:severity sh:Violation ;
  sh:message "staticMemory is only supported if supportsMultipleInstantiation of the owning SwcInternalBehavior is false."@en .

# SHACL for constr_2029 - shortName of constantMemory and staticMemory
autosar:constr_2029 a sh:NodeShape ;
  sh:severity sh:Info ;
  sh:message "The shortName of a VariableDataPrototype in role staticMemory or a ParameterDataPrototype in role constantMemory has to be equal to the C identifier of the described variable/constant (not machine-checkable structurally)."@en ;
  sh:property [
    sh:path autosar:SHORT-NAME ;
    sh:minCount 1 ;
  ] .

# SHACL for constr_2030 - WaitPoint with AsynchronousServerCallResultPoint ...
autosar:constr_2030 a sh:NodeShape ;
  sh:targetClass autosar:ASYNCHRONOUS-SERVER-CALL-RESULT-POINT ;
  sh:severity sh:Violation ;
  sh:message "The WaitPoint referencing an AsynchronousServerCallReturnsEvent and the AsynchronousServerCallResultPoint referenced by this event shall be aggregated by the same RunnableEntity."@en .


# constr_2031 - Period of TimingEvent shall be greater than 0
autosar:constr_2031_PeriodOfTimingEventShape
    a sh:NodeShape ;
    sh:targetClass autosar:TIMING-EVENT ;
    sh:property [
        sh:path autosar:PERIOD ;
        sh:datatype xsd:decimal ;
        sh:minExclusive 0 ;
        sh:severity sh:Violation ;
        sh:message "The value of the attribute PERIOD of TIMING-EVENT shall be greater than 0." ;
    ] .

# constr_2033 - Timeout of DataSendCompletedEvent
# 语义涉及 WaitPoint、DataSendCompletedEvent、TransmissionAcknowledgementRequest 之间的相等关系，
# 主要由 SMT 负责；此处不建 SHACL 结构（路径不足以表达跨元素相等）。

# constr_2034 - SwAddrMethod referenced by RunnableEntitys or BswSchedulableEntitys
# 目标类：BswSchedulableEntity（给定）
# 语义是“RunnableEntitys and BswSchedulableEntitys shall not reference a SwAddrMethod
# whose MEMORY-ALLOCATION-KEYWORD-POLICY = addrMethodShortNameAndAlignment”，
# 需要跨引用与枚举值判断，交由 SMT 处理；SHACL 不建结构。

# constr_2035 - swImplPolicy for VariableDataPrototype in SenderReceiverInterface
# 约束：VariableDataPrototype in SenderReceiverInterface 的 overriding swImplPolicy ∈ {standard, queued, measurementPoint}
# 由于“in SenderReceiverInterface”这一上下文无法仅靠本地路径稳定识别，交由 SMT 处理；SHACL 不建结构。

# constr_2036 - swImplPolicy for VariableDataPrototype in NvDataInterface
# 同上，“in NvDataInterface”为上下文条件，交由 SMT；SHACL 不建结构。

# constr_2037 - swImplPolicy for VariableDataPrototype in the role ramBlock
# “in the role ramBlock”为语义角色条件，交由 SMT；SHACL 不建结构。

# constr_2038 - swImplPolicy for VariableDataPrototype in the role implicitInterRunnableVariable
# “in the role implicitInterRunnableVariable”为语义角色条件，交由 SMT；SHACL 不建结构。


# constr_2039 – VariableDataPrototype in role explicitInterRunnableVariable: swImplPolicy = standard
autosar:constr_2039 a sh:NodeShape ;
  sh:targetClass autosar:VARIABLE-DATA-PROTOTYPE ;
  sh:severity sh:Violation ;
  sh:message "The overriding swImplPolicy of a VariableDataPrototype in the role explicitInterRunnableVariable shall be 'standard'." ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "swImplPolicy must be 'standard' for VariableDataPrototype in role explicitInterRunnableVariable." ;
    sh:select """
      PREFIX autosar: <http://autosar.org/>
      SELECT ?this WHERE {
        ?this a autosar:VARIABLE-DATA-PROTOTYPE .

        # role-specific filter: explicitInterRunnableVariable
        ?this autosar:ROLE ?role .
        FILTER(str(?role) = "explicitInterRunnableVariable") .

        OPTIONAL {
          ?this autosar:SW-DATA-DEF-PROPS ?swProps .
          ?swProps autosar:SW-DATA-DEF-PROPS-CONTENT ?content .
          ?content autosar:SW-IMPL-POLICY ?policy .
        }
        FILTER(BOUND(?policy) && str(?policy) != "standard")
      }
    """
  ] .

# constr_2040 – VariableDataPrototype in role arTypedPerInstanceMemory: swImplPolicy ∈ {standard, measurementPoint}
autosar:constr_2040 a sh:NodeShape ;
  sh:targetClass autosar:VARIABLE-DATA-PROTOTYPE ;
  sh:severity sh:Violation ;
  sh:message "The overriding swImplPolicy of a VariableDataPrototype in the role arTypedPerInstanceMemory shall be 'standard' or 'measurementPoint'." ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "swImplPolicy must be 'standard' or 'measurementPoint' for VariableDataPrototype in role arTypedPerInstanceMemory." ;
    sh:select """
      PREFIX autosar: <http://autosar.org/>
      SELECT ?this WHERE {
        ?this a autosar:VARIABLE-DATA-PROTOTYPE .

        # role-specific filter: arTypedPerInstanceMemory
        ?this autosar:ROLE ?role .
        FILTER(str(?role) = "arTypedPerInstanceMemory") .

        OPTIONAL {
          ?this autosar:SW-DATA-DEF-PROPS ?swProps .
          ?swProps autosar:SW-DATA-DEF-PROPS-CONTENT ?content .
          ?content autosar:SW-IMPL-POLICY ?policy .
        }
        FILTER(
          BOUND(?policy) &&
          str(?policy) != "standard" &&
          str(?policy) != "measurementPoint"
        )
      }
    """
  ] .

# constr_2041 – VariableDataPrototype in role staticMemory: swImplPolicy ∈ {standard, measurementPoint, message}
autosar:constr_2041 a sh:NodeShape ;
  sh:targetClass autosar:VARIABLE-DATA-PROTOTYPE ;
  sh:severity sh:Violation ;
  sh:message "The overriding swImplPolicy of a VariableDataPrototype in the role staticMemory shall be 'standard', 'measurementPoint' or 'message'." ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "swImplPolicy must be 'standard', 'measurementPoint' or 'message' for VariableDataPrototype in role staticMemory." ;
    sh:select """
      PREFIX autosar: <http://autosar.org/>
      SELECT ?this WHERE {
        ?this a autosar:VARIABLE-DATA-PROTOTYPE .

        # role-specific filter: staticMemory
        ?this autosar:ROLE ?role .
        FILTER(str(?role) = "staticMemory") .

        OPTIONAL {
          ?this autosar:SW-DATA-DEF-PROPS ?swProps .
          ?swProps autosar:SW-DATA-DEF-PROPS-CONTENT ?content .
          ?content autosar:SW-IMPL-POLICY ?policy .
        }
        FILTER(
          BOUND(?policy) &&
          str(?policy) != "standard" &&
          str(?policy) != "measurementPoint" &&
          str(?policy) != "message"
        )
      }
    """
  ] .

# constr_2042 – ParameterDataPrototype in ParameterInterface: swImplPolicy ∈ {standard, const, fixed}
autosar:constr_2042 a sh:NodeShape ;
  sh:targetClass autosar:PARAMETER-DATA-PROTOTYPE ;
  sh:severity sh:Violation ;
  sh:message "The overriding swImplPolicy of a ParameterDataPrototype in ParameterInterface shall be 'standard', 'const' or 'fixed'." ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "swImplPolicy must be 'standard', 'const' or 'fixed' for ParameterDataPrototype in ParameterInterface." ;
    sh:select """
      PREFIX autosar: <http://autosar.org/>
      SELECT ?this WHERE {
        ?this a autosar:PARAMETER-DATA-PROTOTYPE .

        # context: ParameterInterface
        ?this autosar:IN-PARAMETER-INTERFACE ?pi .

        OPTIONAL {
          ?this autosar:SW-DATA-DEF-PROPS ?swProps .
          ?swProps autosar:SW-DATA-DEF-PROPS-CONTENT ?content .
          ?content autosar:SW-IMPL-POLICY ?policy .
        }
        FILTER(
          BOUND(?policy) &&
          str(?policy) != "standard" &&
          str(?policy) != "const" &&
          str(?policy) != "fixed"
        )
      }
    """
  ] .

