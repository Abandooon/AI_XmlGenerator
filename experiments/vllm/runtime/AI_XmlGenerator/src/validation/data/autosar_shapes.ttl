  ] .

# SHACL for constr_1286 - serverArgumentImplPolicy and ArgumentDataPrototype typed by primitive data types
autosar:constr_1286 a sh:NodeShape ;
  sh:targetClass autosar:ARGUMENT-DATA-PROTOTYPE ;
  sh:severity sh:Violation ;
  sh:message "ArgumentDataPrototype.serverArgumentImplPolicy shall not be useVoid for an in-direction ArgumentDataPrototype typed by a primitive C data type."@en ;
  sh:property [
    sh:path autosar:SERVER-ARGUMENT-IMPL-POLICY ;
  ] .

# SHACL for constr_1287 - Compatibility of SenderReceiverInterfaces with respect to invalidationPolicy
autosar:constr_1287 a sh:NodeShape ;
  sh:targetClass autosar:SENDER-RECEIVER-INTERFACE ;
  sh:severity sh:Violation ;
  sh:message "VariableDataPrototypes in one SenderReceiverInterface are only compatible if their invalidationPolicys have the same value."@en ;
