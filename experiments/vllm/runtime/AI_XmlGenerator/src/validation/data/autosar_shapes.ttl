    sh:targetClass autosar:RPT-HOOK ;
    sh:property [
        sh:path autosar:RPT-AR-HOOK-IREF ;
        sh:message "If a RunnableEntity is referenced as BY-PASS-POINT-IREF without sub RPT-CONTAINERs, all RTE interfaces of the RunnableEntity shall support connection to an RPT-HOOK (checked by SMT)." ;
        sh:severity sh:Info ;
    ] .


