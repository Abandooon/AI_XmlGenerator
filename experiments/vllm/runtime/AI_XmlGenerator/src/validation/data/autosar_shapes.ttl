# CATEGORY presence/type (if present) for composite types
autosar:Constr_1008_ApplicationArrayDataType_CategoryShape
    a sh:NodeShape ;
    sh:targetClass autosar:APPLICATION-ARRAY-DATA-TYPE ;
    sh:property [
        sh:path autosar:CATEGORY ;
        sh:datatype autosar:CATEGORY-STRING ;
        sh:severity sh:Violation ;
