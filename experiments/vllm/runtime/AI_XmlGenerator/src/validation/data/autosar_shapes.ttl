    sh:property [
        sh:path autosar:SW-REFRESH-TIMING ;
        sh:class autosar:MULTIDIMENSIONAL-TIME ;
        sh:maxCount 1 ;
    ] .


# 1) TPS_SWCT_01275 - swImplPolicy restricted depending on context
# 语义依赖“上下文”，文中未给出可枚举的具体限制集合，因此仅建模结构与类型

autosar:TPS_SWCT_01275_Shape
    a sh:NodeShape ;
    sh:severity sh:Info ;
    sh:targetClass autosar:DATA-PROTOTYPE ;

