# SHACL: Crypto Service role-based port assignments for AtomicSwComponentType

autosar:TPS_SWCT_02036_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:ATOMIC-SW-COMPONENT-TYPE ;
