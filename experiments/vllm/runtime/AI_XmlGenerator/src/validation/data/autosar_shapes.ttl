        a sh:SPARQLConstraint ;
        sh:message "AtomicSwComponentType must have exactly one CsmKeyExchangeCalcPubVal role and exactly one CsmCallback role in its RoleBasedPortAssignment for public value calculation." ;
        sh:select """
PREFIX autosar: <http://autosar.org/>

SELECT ?this
WHERE {
  ?this a autosar:ATOMIC-SW-COMPONENT-TYPE .

  # Application-specific: how roles are modeled is not defined in the input.
  # This SPARQL is a placeholder pattern and must be adapted to the concrete AUTOSAR RDF model.
  # Expected semantics (informal):
  #   count(roles with name 'CsmKeyExchangeCalcPubVal') = 1
  #   count(roles with name 'CsmCallback') = 1
  #   and no other roles are present in this RoleBasedPortAssignment.
}
""" ;
    ] .

