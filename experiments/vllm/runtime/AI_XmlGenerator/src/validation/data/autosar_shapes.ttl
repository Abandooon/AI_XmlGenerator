# SHACL for constr_1289 - Allowed Attributes vs. category for DataPrototypes typed by ApplicationDataTypes
autosar:constr_1289 a sh:NodeShape ;
  sh:targetClass autosar:SW-DATA-DEF-PROPS ;
  sh:severity sh:Info ;
  sh:message "Allowed attribute values per category for DataPrototypes typed by ApplicationDataTypes are defined in table 5.31."@en ;
  sh:property [
