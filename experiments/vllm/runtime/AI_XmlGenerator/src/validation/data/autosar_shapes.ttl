# SHACL for TPS_SWCT_01157 - Attribute literalPrefix of IncludedDataTypeSet
#################################################################

autosar:TPS_SWCT_01157 a sh:NodeShape ;
  sh:targetClass autosar:INCLUDED-DATA-TYPE-SET ;
  sh:property [
    sh:path autosar:LITERAL-PREFIX ;
    sh:datatype xsd:string
  ] ;
  sh:severity sh:Info ;
  sh:message "literalPrefix may be used to separate namespaces of C identifiers for equally named AutosarDataTypes in the same SWC implementation (documentation / behavioral, not machine-checked)." .

