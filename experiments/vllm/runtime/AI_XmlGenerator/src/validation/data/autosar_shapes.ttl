    a sh:NodeShape ;
    sh:targetClass autosar:ATOMIC-SW-COMPONENT-TYPE ;
    sh:property [
        sh:path ( autosar:RPT-CONTAINER autosar:BY-PASS-POINT-IREFS autosar:BY-PASS-POINT-IREF ) ;
        sh:message "If a SwComponentPrototype is referenced as BY-PASS-POINT-IREF without sub RPT-CONTAINERs, all RTE interfaces of the ATOMIC-SW-COMPONENT-TYPE shall support connection to an RPT-HOOK (checked by SMT)." ;
        sh:severity sh:Info ;
    ] .

# TPS_SWCT_02049 - Implicit RunnableEntity selection for Rapid Prototyping Scenario
autosar:TPS_SWCT_02049_Shape
