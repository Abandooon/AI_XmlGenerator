# 1) SHACL shapes

# TPS_SWCT_01148 - NvBlockDataMapping (definition only, no verifiable structure given)
# 语义是定义性描述，不形成可判定结构约束，因此此处不生成 SHACL 形状。


# TPS_SWCT_01149 - RoleBasedPortAssignment of NvBlockDescriptor
# 语义：NvBlockDescriptor 中的 clientServerPort 通过 RoleBasedPortAssignment，
# 其中 ROLE 是必填标识符，用于说明端口用途（块服务/管理/通知等）。

autosar:TPS_SWCT_01149 a sh:NodeShape ;
  sh:targetClass autosar:NV-BLOCK-DESCRIPTOR ;

  sh:property [
    sh:path ( autosar:CLIENT-SERVER-PORTS autosar:ROLE-BASED-PORT-ASSIGNMENT ) ;
    sh:node [
      a sh:NodeShape ;
      sh:property [
        sh:path autosar:ROLE ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype autosar:IDENTIFIER
      ]
    ]
  ] ;
  sh:severity sh:Violation
.


# TPS_SWCT_01150 - InternalBehavior of a NvBlockSwComponentType to enable access to the NVRAM Block management API
# 语义是推荐性的建模模式（需要 OperationInvokedEvents / server RunnableEntity / PortDefinedArgumentValues），
# 且未给出可直接映射的 XML 路径，这里不生成具体 SHACL 形状，由 SMT 或文档解释承担。


# TPS_SWCT_01151 - RunnableEntitys do not have further attributes
# TPS_SWCT_01152 - InternalBehavior does not have further attributes
# 两条均为“不要有额外属性”的建模风格约束，且未给出具体禁止的 XML 子元素集合，
# 不生成 SHACL，由 SMT 或人工审查承担。


# TPS_SWCT_01154 - Attribute prefix of IncludedModeDeclarationGroupSet
# 语义：PREFIX 是可选属性，用于避免符号名冲突；无“必须存在”或取值限制，仅 if-present-then-type。

autosar:TPS_SWCT_01154 a sh:NodeShape ;
  sh:targetClass autosar:INCLUDED-MODE-DECLARATION-GROUP-SET ;

  sh:property [
    sh:path autosar:PREFIX ;
    sh:datatype autosar:IDENTIFIER
  ] ;
  sh:severity sh:Info
.


# TPS_SWCT_01156 - Required if the AutosarDataType is not used for any DataPrototype
# 语义依赖“是否被本组件的 DataPrototype 使用”这一全局信息，缺少可观测结构信号，
# 不生成 SHACL，由 SMT 侧的全局逻辑承担。


