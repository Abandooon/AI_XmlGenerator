# 1) Recommendations for NvBlockNeeds.* in PortPrototype context
# These are recommendations about matching values across connected PortPrototypes.
# They are context / cross-element and not enforced structurally here, so no SHACL shapes are generated.

# 2) RptContainer category ACCESS_POINTS
autosar:Table_13_4_ACCESS_POINTS_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:RPT-CONTAINER ;
    sh:severity sh:Violation ;

    # CATEGORY (optional, but used as trigger in SMT)
    sh:property [
        sh:path autosar:CATEGORY ;
        sh:datatype xsd:string ;
    ] ;

    # BY-PASS-POINT-IREF (minOccurs = 1, maxOccurs = unbounded)
    sh:property [
        sh:path ( autosar:BY-PASS-POINT-IREFS autosar:BY-PASS-POINT-IREF ) ;
        sh:minCount 1 ;
    ] .

# 3) RptContainer category DATA_PROTOTYPE
autosar:Table_13_4_DATA_PROTOTYPE_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:RPT-CONTAINER ;
    sh:severity sh:Violation ;

    # CATEGORY (optional, but used as trigger in SMT)
    sh:property [
        sh:path autosar:CATEGORY ;
        sh:datatype xsd:string ;
    ] ;

    # BY-PASS-POINT-IREF (minOccurs = 1, maxOccurs = unbounded)
    sh:property [
        sh:path ( autosar:BY-PASS-POINT-IREFS autosar:BY-PASS-POINT-IREF ) ;
        sh:minCount 1 ;
    ] .


#################################################################
# SHACL shapes
#################################################################

########## 1. RptContainer category RUNNABLE_ENTITY ##########

autosar:Table_13_4_RUNNABLE_ENTITY_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:RPT-CONTAINER ;
    sh:severity sh:Violation ;

    # If category is RUNNABLE_ENTITY, then BY-PASS-POINT-IREF must be present
    sh:rule [
        a sh:TripleRule ;
        sh:condition [
            a sh:NodeShape ;
            sh:property [
                sh:path autosar:CATEGORY ;
                sh:hasValue "RUNNABLE_ENTITY"
            ]
        ] ;
        sh:subject sh:this ;
        sh:predicate autosar:requiresByPassPointForRunnableEntity ;
        sh:object true
    ] ;

    sh:property [
        sh:path ( autosar:BY-PASS-POINT-IREFS autosar:BY-PASS-POINT-IREF ) ;
        sh:minCount 1 ;
        sh:message "If RPT-CONTAINER/CATEGORY is 'RUNNABLE_ENTITY', BY-PASS-POINT-IREFS/BY-PASS-POINT-IREF shall reference RunnableEntity instances." ;
    ] .

########## 2. RptContainer category SW_COMPONENT_PROTOTYPE ##########

autosar:Table_13_4_SW_COMPONENT_PROTOTYPE_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:RPT-CONTAINER ;
    sh:severity sh:Violation ;

    # If category is SW_COMPONENT_PROTOTYPE, then BY-PASS-POINT-IREF must be present
    sh:rule [
        a sh:TripleRule ;
        sh:condition [
            a sh:NodeShape ;
            sh:property [
                sh:path autosar:CATEGORY ;
                sh:hasValue "SW_COMPONENT_PROTOTYPE"
            ]
        ] ;
        sh:subject sh:this ;
        sh:predicate autosar:requiresByPassPointForSwComponentPrototype ;
        sh:object true
    ] ;

    sh:property [
        sh:path ( autosar:BY-PASS-POINT-IREFS autosar:BY-PASS-POINT-IREF ) ;
        sh:minCount 1 ;
        sh:message "If RPT-CONTAINER/CATEGORY is 'SW_COMPONENT_PROTOTYPE', BY-PASS-POINT-IREFS/BY-PASS-POINT-IREF shall reference SwComponentPrototype instances." ;
    ] .

########## 3. Default behavior of invalidationPolicy for SenderReceiverInterface ##########

# Structural typing only; behavioral default is handled in SMT

autosar:Table_4_1_InvalidationPolicy_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:INVALIDATION-POLICY ;
    sh:severity sh:Info ;

    sh:property [
        sh:path autosar:DATA-ELEMENT-REF ;
        sh:class autosar:VARIABLE-DATA-PROTOTYPE ;
        sh:message "DATA-ELEMENT-REF of INVALIDATION-POLICY shall reference VARIABLE-DATA-PROTOTYPE." ;
    ] ;

    sh:property [
        sh:path autosar:HANDLE-INVALID ;
        sh:message "HANDLE-INVALID, if present, shall be a valid HandleInvalidEnum literal." ;
    ] .

autosar:Table_4_1_SenderReceiverInterface_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:SENDER-RECEIVER-INTERFACE ;
    sh:severity sh:Info ;

    sh:property [
        sh:path ( autosar:DATA-ELEMENTS autosar:VARIABLE-DATA-PROTOTYPE ) ;
        sh:minCount 1 ;
        sh:message "SENDER-RECEIVER-INTERFACE shall have at least one VARIABLE-DATA-PROTOTYPE in DATA-ELEMENTS." ;
    ] ;

    sh:property [
        sh:path ( autosar:INVALIDATION-POLICYS autosar:INVALIDATION-POLICY ) ;
        sh:message "INVALIDATION-POLICYS/INVALIDATION-POLICY, if present, define per-data-element invalidation behavior; default behavior is defined in SMT." ;
    ] .

########## 4. Definition of HandleInvalidEnum literals ##########

# Purely definitional / behavioral text, no structural constraint here.

########## 5. Supported AssemblySwConnector connections ##########

autosar:Table_4_4_AssemblySwConnector_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:ASSEMBLY-SW-CONNECTOR ;
    sh:severity sh:Violation ;

    sh:property [
        sh:path autosar:PROVIDER-IREF ;
        sh:minCount 1 ;
        sh:message "ASSEMBLY-SW-CONNECTOR shall have PROVIDER-IREF (P-PORT-IN-COMPOSITION-INSTANCE-REF)." ;
    ] ;

    sh:property [
        sh:path autosar:REQUESTER-IREF ;
        sh:minCount 1 ;
        sh:message "ASSEMBLY-SW-CONNECTOR shall have REQUESTER-IREF (R-PORT-IN-COMPOSITION-INSTANCE-REF)." ;
    ] .

########## 6. Supported DelegationSwConnector connections ##########

autosar:Table_4_5_DelegationSwConnector_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:DELEGATION-SW-CONNECTOR ;
    sh:severity sh:Violation ;

    sh:property [
        sh:path autosar:INNER-PORT-IREF ;
        sh:minCount 1 ;
        sh:message "DELEGATION-SW-CONNECTOR shall have INNER-PORT-IREF." ;
    ] ;

    sh:property [
        sh:path autosar:OUTER-PORT-REF ;
        sh:minCount 1 ;
        sh:message "DELEGATION-SW-CONNECTOR shall have OUTER-PORT-REF." ;
    ] .

########## 7. ClientServerInterface ComSpec Compatibility ##########

