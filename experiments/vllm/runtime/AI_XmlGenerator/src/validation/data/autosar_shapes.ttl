#################################################################
# SHACL for constr_1020 - ParameterDataPrototype needs compatible data type
#################################################################

autosar:Constr_1020_ParameterDataPrototypeCompatibleToSharedAxisType
    a sh:NodeShape ;
    sh:targetClass autosar:PARAMETER-DATA-PROTOTYPE ;
    sh:property [
        sh:path autosar:SHARED-AXIS-TYPE-REF ;
        sh:maxCount 1 ;
        sh:severity sh:Info ;
        sh:message "The ParameterDataPrototype assigned in swCalprmRef shall be typed by a data type compatible to the APPLICATION-PRIMITIVE-DATA-TYPE referenced via SHARED-AXIS-TYPE-REF (compatibility checked by SMT/other means)." ;
    ] .


#################################################################
# SHACL shapes
#################################################################

#################################################################
# constr_1021 - A CompuMethod shall specify instructions for both directions
#################################################################

autosar:Constr_1021_CompuMethod_BothDirectionsShape
    a sh:NodeShape ;
    sh:targetClass autosar:COMPU-METHOD ;
    sh:severity sh:Violation ;

    # If one direction is present, the other shall also be present
    sh:sparql [
        sh:message "A CompuMethod shall specify instructions for both directions: if COMPU-INTERNAL-TO-PHYS is present then COMPU-PHYS-TO-INTERNAL shall also be present, and vice versa." ;
        sh:severity sh:Violation ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this
            WHERE {
              ?this a autosar:COMPU-METHOD .

              BIND (EXISTS { ?this autosar:COMPU-INTERNAL-TO-PHYS ?cip } AS ?hasCIP)
              BIND (EXISTS { ?this autosar:COMPU-PHYS-TO-INTERNAL ?cpi } AS ?hasCPI)

              FILTER( (?hasCIP && !?hasCPI) || (!?hasCIP && ?hasCPI) )
            }
        """ ;
    ] .

#################################################################
# constr_1022 - Limits shall be defined for each direction of CompuMethod
#################################################################

# Structural: each COMPU-SCALE, if present, must have both LOWER-LIMIT and UPPER-LIMIT if any limit is present

autosar:Constr_1022_CompuScale_LimitsShape
    a sh:NodeShape ;
    sh:targetClass autosar:COMPU-SCALE ;
    sh:severity sh:Violation ;

    sh:sparql [
        sh:message "If limits are specified on a COMPU-SCALE, both LOWER-LIMIT and UPPER-LIMIT shall be explicitly defined." ;
        sh:severity sh:Violation ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this
            WHERE {
              ?this a autosar:COMPU-SCALE .

              BIND (EXISTS { ?this autosar:LOWER-LIMIT ?ll } AS ?hasLL)
              BIND (EXISTS { ?this autosar:UPPER-LIMIT ?ul } AS ?hasUL)

              FILTER( (?hasLL || ?hasUL) && (!?hasLL || !?hasUL) )
            }
        """ ;
    ] .

#################################################################
# constr_1024 - Stepwise definition of CompuMethods
#################################################################

# Informational: CompuMethods are expected to use stepwise definition (CompuScales)

autosar:Constr_1024_CompuMethod_StepwiseInfoShape
    a sh:NodeShape ;
    sh:targetClass autosar:COMPU-METHOD ;
    sh:severity sh:Info ;

    sh:message "Within AUTOSAR only the stepwise definition (CompuScales) is used for CompuMethods." .

