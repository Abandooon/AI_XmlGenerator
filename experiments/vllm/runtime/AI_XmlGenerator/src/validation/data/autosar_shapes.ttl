        sh:path ( autosar:SW-DATA-DEF-PROPS-CONTENT autosar:SW-IMPL-POLICY ) ;
        sh:class autosar:SW-IMPL-POLICY-ENUM
    ] .

# 2) TPS_SWCT_01279 - Preferred conversion direction depends on the use case
# 仅建模：如果存在转换，则类型为 COMPU；“依赖用例”的行为逻辑交由SMT或工具层

autosar:TPS_SWCT_01279_Shape
    a sh:NodeShape ;
    sh:severity sh:Info ;
    sh:targetClass autosar:COMPU-METHOD ;

    sh:property [
        sh:path ( autosar:COMPU-METHOD autosar:COMPU-INTERNAL-TO-PHYS ) ;
        sh:class autosar:COMPU
    ] ;

    sh:property [
        sh:path ( autosar:COMPU-METHOD autosar:COMPU-PHYS-TO-INTERNAL ) ;
        sh:class autosar:COMPU
    ] .

# 3) TPS_SWCT_01281 - Unit associated with a PhysicalDimension
# 文本是“can be associated”，非强制；这里仅对引用的 DEST 类型做约束

autosar:TPS_SWCT_01281_Shape
    a sh:NodeShape ;
    sh:severity sh:Info ;
    sh:targetClass autosar:UNIT ;

    sh:property [
        sh:path ( autosar:UNIT autosar:PHYSICAL-DIMENSION-REF ) ;
        sh:nodeKind sh:IRI ;
        sh:class autosar:PHYSICAL-DIMENSION
    ] .


# 1) TPS_SWCT_01287 – Standard / extended limits (ASAM-MCD2)
# 该约束主要描述 A2L 生成语义和“角色切换”，缺乏可观测结构模式，
# 不生成 SHACL 结构约束（由 SMT 或工具内部逻辑处理）。


# 2) TPS_SWCT_01288 – Interpretation of PhysConstrs / InternalConstrs
# 约束是工具解释语义（行为性），无稳定 XML 结构模式可检验，不生成 SHACL。


# 3) TPS_SWCT_01291 – Association of MemorySection with SwAddrMethod
# 语义主体：MemorySection（“the particular MemorySection is associated with the SwAddrMethod”）
# 结构层面：要求 MEMORY-SECTION/SW-ADDRMETHOD-REF 存在且 DEST=SW-ADDR-METHOD

autosar:TPS_SWCT_01291_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:MEMORY-SECTION ;

    sh:property [
        sh:path autosar:SW-ADDRMETHOD-REF ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "MEMORY-SECTION shall have exactly one SW-ADDRMETHOD-REF associating it with a SwAddrMethod (TPS_SWCT_01291)." ;
        sh:severity sh:Violation
    ] .


# 4) TPS_SWCT_01293 – RTE derives Memory Allocation Keyword from SwAddrMethod.shortName
# 约束是 RTE 生成器的行为性要求，结构上只要求 SwAddrMethod 有 SHORT-NAME。
# 语义主体：SW-ADDR-METHOD（因为从其 shortName 派生关键字）

autosar:TPS_SWCT_01293_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:SW-ADDR-METHOD ;

    sh:property [
        sh:path autosar:SHORT-NAME ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "SW-ADDR-METHOD shall have a SHORT-NAME from which the RTE derives the Memory Allocation Keyword (TPS_SWCT_01293)." ;
        sh:severity sh:Violation
    ] .


# 5) TPS_SWCT_01294 – Missing SwDataDefProps.swAddrMethod
# 结构层面：SW-DATA-DEF-PROPS-CONTENT/SW-ADDR-METHOD-REF 是可选引用；
# 逻辑“缺失则可任意放置；冲突请求需报错”由 SMT/工具处理，这里仅做 if-present-then-type。

autosar:TPS_SWCT_01294_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:SW-DATA-DEF-PROPS-CONTENT ;

    sh:property [
        sh:path autosar:SW-ADDR-METHOD-REF ;
        sh:maxCount 1 ;
        sh:message "If present, SW-ADDR-METHOD-REF in SW-DATA-DEF-PROPS-CONTENT shall reference a SwAddrMethod (TPS_SWCT_01294)." ;
        sh:severity sh:Violation
    ] .


# 6) TPS_SWCT_01297 – Compliance of ADT/IDT to swDataDefProps
# 主要描述建模/变换策略（手动或自动创建 ImplementationDataTypes），不生成 SHACL。


# 7) TPS_SWCT_01298 – Computing SwRecordLayout from ImplementationDataTypes not possible
# 说明性约束（不可从 IDT 反推 SwRecordLayout），不生成 SHACL。


# 1) TPS_SWCT_01299 - Relation of swRecordLayoutGroup to subElement
# 纯行为性 + 递归算法描述，缺乏可观测结构信号 → 不生成 SHACL

# 2) TPS_SWCT_01302 - Semantics of minimumStartInterval
# 纯语义定义（RTE 调度语义），无可观测结构约束 → 不生成 SHACL

# 3) TPS_SWCT_01303 - symbol attribute describes the RunnableEntity's entry point
# 纯语义定义（入口点含义），无额外结构约束 → 不生成 SHACL

# 4) TPS_SWCT_01304 - Cat. 1A and 1B RunnableEntitys will eventually terminate
# 运行时终止性属性，无法从静态 XML 直接验证 → 不生成 SHACL

# 5) TPS_SWCT_01305 - RunnableEntity as one that cannot be invoked concurrently
# 运行时调度责任（RTE 保证不并发），无额外结构约束 → 不生成 SHACL

# 6) TPS_SWCT_01306 - Software-component description does not bound number of concurrent invocations
# 说明性文字，强调“未限制并发次数”，无结构约束 → 不生成 SHACL

# 7) TPS_SWCT_01307 - supportsMultipleInstantiation vs. canBeInvokedConcurrently
# 仅说明“语义组合见表 7.4”，未给出可直接编码的布尔关系 → 不生成 SHACL


#################################################################
# SHACL for TPS_SWCT_01311 - Name of an operation argument
#################################################################

autosar:TPS_SWCT_01311_RunnableEntityArgumentShape
    a sh:NodeShape ;
    sh:targetClass autosar:RUNNABLE-ENTITY-ARGUMENT ;
    sh:property [
        sh:path autosar:SYMBOL ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "RunnableEntityArgument shall provide the name of the argument by means of the value of the attribute SYMBOL." ;
        sh:severity sh:Violation ;
    ] .

#################################################################
# SHACL for TPS_SWCT_01317 - RTE triggers RunnableEntity in response to occurring RTEEvent
# Structural part: START-ON-EVENT-REF type
#################################################################

autosar:TPS_SWCT_01317_StartOnEventRefShape
    a sh:NodeShape ;
    sh:targetClass autosar:ASYNCHRONOUS-SERVER-CALL-RETURNS-EVENT ,autosar:BACKGROUND-EVENT ,autosar:DATA-RECEIVE-ERROR-EVENT ,autosar:DATA-RECEIVED-EVENT ,autosar:DATA-SEND-COMPLETED-EVENT ,autosar:DATA-WRITE-COMPLETED-EVENT ,autosar:EXTERNAL-TRIGGER-OCCURRED-EVENT ,autosar:INIT-EVENT ,autosar:INTERNAL-TRIGGER-OCCURRED-EVENT ,autosar:MODE-SWITCHED-ACK-EVENT ,autosar:OPERATION-INVOKED-EVENT ,autosar:SWC-MODE-MANAGER-ERROR-EVENT ,autosar:SWC-MODE-SWITCH-EVENT ,autosar:TIMING-EVENT ,autosar:TRANSFORMER-HARD-ERROR-EVENT ;
    sh:property [
        sh:path autosar:START-ON-EVENT-REF ;
        sh:maxCount 1 ;
        sh:class autosar:RUNNABLE-ENTITY ;
        sh:message "If START-ON-EVENT-REF is present, it shall reference a RUNNABLE-ENTITY." ;
        sh:severity sh:Violation ;
    ] .

#################################################################
# SHACL for TPS_SWCT_01318 - RunnableEntity and WaitPoint
#################################################################

# WaitPoint must have exactly one TIMEOUT and one TRIGGER-REF

autosar:TPS_SWCT_01318_WaitPointShape
    a sh:NodeShape ;
    sh:targetClass autosar:WAIT-POINT ;
    sh:property [
        sh:path autosar:TIMEOUT ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A WaitPoint shall define a TIMEOUT." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path autosar:TRIGGER-REF ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A WaitPoint shall define exactly one TRIGGER-REF to an RTEEvent." ;
        sh:severity sh:Violation ;
    ] .

# RunnableEntity may define many ordered WaitPoints

autosar:TPS_SWCT_01318_RunnableEntity_WaitPointsShape
    a sh:NodeShape ;
    sh:targetClass autosar:RUNNABLE-ENTITY ;
    sh:property [
        sh:path ( autosar:WAIT-POINTS autosar:WAIT-POINT ) ;
        sh:message "A RunnableEntity may define many WaitPoints; the order of WaitPoints is significant (ordered aggregation)." ;
        sh:severity sh:Info ;
    ] .

#################################################################
# SHACL for TPS_SWCT_01311 - RunnableEntity arguments (multiplicity and ordering)
#################################################################

autosar:TPS_SWCT_01311_RunnableEntity_ArgumentsShape
    a sh:NodeShape ;
    sh:targetClass autosar:RUNNABLE-ENTITY ;
    sh:property [
        sh:path ( autosar:ARGUMENTS autosar:RUNNABLE-ENTITY-ARGUMENT ) ;
        sh:message "A RunnableEntity may define many arguments (0..*); the order of these arguments is significant (ordered aggregation)." ;
        sh:severity sh:Info ;
    ] .


# 1) TPS_SWCT_01319 - RTEEvent can be used to trigger WaitPoints in different RunnableEntitys
# 结构上仅要求 WaitPoint 的 TRIGGER-REF 指向 RTE-EVENT（以及其他允许的事件类型）

autosar:TPS_SWCT_01319 a sh:NodeShape ;
  sh:targetClass autosar:WAIT-POINT ;
  sh:property [
    sh:path autosar:TRIGGER-REF ;
    sh:class autosar:RTE-EVENT ;
    sh:severity sh:Info ;
    sh:message "TRIGGER-REF of a WAIT-POINT may reference an RTE-EVENT that can be shared by WaitPoints of different RunnableEntitys." ;
  ] .

# 2) TPS_SWCT_01323 - Read and write access to a dataElement
# 该条为说明性关系约束，未给出可直接验证的结构条件，不生成 SHACL 结构约束


# 3) TPS_SWCT_01324 - Mode switches need to be completed in finite time
# 行为/运行时性质，无法从静态 XML 结构直接验证，不生成 SHACL 结构约束


# 4) TPS_SWCT_01325 - Read and write access is only applicable for RunnableEntitys of category 1
# 若 RunnableEntity 使用 data read/write access，则其 CATEGORY 应为 "1"（示意性约束）

autosar:TPS_SWCT_01325 a sh:NodeShape ;
  sh:targetClass autosar:RUNNABLE-ENTITY ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:severity sh:Violation ;
    sh:message "Read/write VARIABLE-ACCESS is only applicable for RunnableEntitys of category 1." ;
    sh:select """
      PREFIX autosar: <http://autosar.org/>
      SELECT ?this
      WHERE {
        ?this a autosar:RUNNABLE-ENTITY .

        OPTIONAL { ?this autosar:CATEGORY ?cat . }

        OPTIONAL {
          ?this autosar:DATA-READ-ACCESSS ?readWrap .
          ?readWrap autosar:VARIABLE-ACCESS ?readVA .
        }
        OPTIONAL {
          ?this autosar:DATA-WRITE-ACCESSS ?writeWrap .
          ?writeWrap autosar:VARIABLE-ACCESS ?writeVA .
        }

        BIND(BOUND(?readVA) || BOUND(?writeVA) AS ?hasVA)

        FILTER(?hasVA && (!BOUND(?cat) || ?cat != "1"))
      }
    """ ;
  ] .


# 5) TPS_SWCT_01326 - Constrain the scope of a specific communication
# 说明性定义，未给出可验证的结构条件，不生成 SHACL 结构约束


# 6) TPS_SWCT_01328 - Default value of attribute scope
# 默认值是建模工具/模式层面的约定，XML 中缺失时无法区分“未显式设置”与“默认值”，不做强制结构约束
# 可给出信息级提示：若存在 SCOPE，则其值应为 communicationInterEcu（示意）

autosar:TPS_SWCT_01328 a sh:NodeShape ;
  sh:targetClass autosar:VARIABLE-ACCESS ;
  sh:property [
    sh:path autosar:SCOPE ;
    sh:severity sh:Info ;
    sh:message "If SCOPE is explicitly specified, its default/typical value is communicationInterEcu." ;
  ] .


