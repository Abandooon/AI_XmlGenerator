    .

# 其余 Table 5.39 相关约束为行为性/工具处理规则，缺乏可观测结构信号，不在 SHACL 中建模。


#################################################################
# 1) Usage of swIntendedResolution  (informational, non-binding)
#################################################################

autosar:Table_5_39_Note_swIntendedResolution_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:APPLICATION-DATA-TYPE ;
    sh:property [
        sh:path ( autosar:SW-DATA-DEF-PROPS-CONTENT autosar:SW-INTENDED-RESOLUTION ) ;
        sh:severity sh:Info ;
        sh:message "SW-INTENDED-RESOLUTION is intended for early blueprint phases only and represents a non-binding requirement to be considered when defining an appropriate COMPU-METHOD." ;
    ] .

#################################################################
# 2) Condition for COMPU-INTERNAL-TO-PHYS definition (Table 5.74 Ann.1)
#    For certain categories (LINEAR, SCALE_LINEAR), COMPU-INTERNAL-TO-PHYS
#    shall be defined if not already defined by COMPU-PHYS-TO-INTERNAL.
#################################################################

autosar:Table_5_74_Annotation_1_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:COMPU-METHOD ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "For COMPU-METHOD categories where this applies (e.g. LINEAR, SCALE_LINEAR), COMPU-INTERNAL-TO-PHYS shall be defined if not already defined by COMPU-PHYS-TO-INTERNAL." ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this
            WHERE {
              ?this a autosar:COMPU-METHOD .

              OPTIONAL { ?this autosar:CATEGORY ?cat . }
              FILTER(BOUND(?cat))  # category-based filtering is handled by higher-level configuration

              OPTIONAL { ?this autosar:COMPU-PHYS-TO-INTERNAL ?physToInt . }
              OPTIONAL { ?this autosar:COMPU-INTERNAL-TO-PHYS ?intToPhys . }

              FILTER( !BOUND(?physToInt) && !BOUND(?intToPhys) )
            }
        """ ;
    ] .

#################################################################
# 3) Definition of both conversion directions or inverse value
#    (Table 5.74 Ann.2)
#################################################################

autosar:Table_5_74_Annotation_2_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:COMPU-METHOD ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "For certain COMPU-METHOD categories (e.g. RAT_FUNC, SCALE_RAT_FUNC), both COMPU-PHYS-TO-INTERNAL and COMPU-INTERNAL-TO-PHYS shall be defined unless a COMPU-SCALE/COMPU-INVERSE-VALUE exists." ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this
            WHERE {
              ?this a autosar:COMPU-METHOD .

              OPTIONAL { ?this autosar:CATEGORY ?cat . }
              FILTER(BOUND(?cat))  # category-based filtering is handled by higher-level configuration

              OPTIONAL { ?this autosar:COMPU-PHYS-TO-INTERNAL ?physToInt . }
              OPTIONAL { ?this autosar:COMPU-INTERNAL-TO-PHYS ?intToPhys . }

              # any COMPU-SCALE belonging to this COMPU-METHOD that has COMPU-INVERSE-VALUE
              OPTIONAL {
                ?this autosar:COMPU-SCALES ?scalesWrapper .
                ?scalesWrapper autosar:COMPU-SCALE ?scale .
                ?scale autosar:COMPU-INVERSE-VALUE ?invVal .
              }

              FILTER( !BOUND(?invVal) && ( !BOUND(?physToInt) || !BOUND(?intToPhys) ) )
            }
        """ ;
    ] .

#################################################################
# 4) Non-applicability with COMPU-CONST (Table 5.74 Ann.3)
#################################################################

autosar:Table_5_74_Annotation_3_Shape a sh:NodeShape ; sh:targetClass autosar:COMPU-METHOD ; sh:sparql [ a sh:SPARQLConstraint ; sh:severity sh:Violation ; sh:message "For COMPU-METHOD category SCALE_RATIONAL_AND_TEXTTABLE, COMPU-PHYS-TO-INTERNAL is not applicable for COMPU-SCALEs where COMPU-CONST exists." ; sh:select """PREFIX autosar: <http://autosar.org/> SELECT ?this WHERE { ?this a autosar:COMPU-METHOD ; autosar:CATEGORY ?cat . FILTER(?cat = "SCALE_RATIONAL_AND_TEXTTABLE") OPTIONAL { ?this autosar:COMPU-PHYS-TO-INTERNAL ?physToInt . } ?this autosar:COMPU-SCALES ?scalesWrapper . ?scalesWrapper autosar:COMPU-SCALE ?scale . ?scale autosar:COMPU-CONST ?const . FILTER(BOUND(?physToInt)) }""" ] .



#################################################################
# 5) Limit definition requirement (Table 5.74 Ann.4)
#################################################################

autosar:Table_5_74_Annotation_4_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:COMPU-METHOD ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "For certain COMPU-METHOD categories (e.g. RAT_FUNC, SCALE_RAT_FUNC), each COMPU-SCALE shall define both LOWER-LIMIT and UPPER-LIMIT according to constr_1022." ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this
            WHERE {
              ?this a autosar:COMPU-METHOD .

              OPTIONAL { ?this autosar:CATEGORY ?cat . }
              FILTER(BOUND(?cat))  # category-based filtering is handled by higher-level configuration

              ?this autosar:COMPU-SCALES ?scalesWrapper .
              ?scalesWrapper autosar:COMPU-SCALE ?scale .

              OPTIONAL { ?scale autosar:LOWER-LIMIT ?ll . }
              OPTIONAL { ?scale autosar:UPPER-LIMIT ?ul . }

              FILTER( !BOUND(?ll) || !BOUND(?ul) )
            }
        """ ;
    ] .

#################################################################
# 6) Structural restrictions from constr_1134 (Table 5.74 Ann.5)
#    Only a hook; actual structural rules are in constr_1134.
#################################################################

autosar:Table_5_74_Annotation_5_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:COMPU-METHOD ;
    sh:property [
        sh:path ( autosar:COMPU-SCALE autosar:COMPU-INVERSE-VALUE ) ;
        sh:severity sh:Info ;
        sh:message "For certain COMPU-METHOD categories (e.g. TEXTTABLE), structural restrictions from constr_1134 apply to COMPU-SCALE/COMPU-INVERSE-VALUE." ;
    ] .

#################################################################
# 7) Default value on out-of-limit conversion (Table 5.74 Ann.6)
#    Behavioral, runtime; only informational hook in SHACL.
#################################################################

autosar:Table_5_74_Annotation_6_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:COMPU-METHOD ;
    sh:property [
        sh:path autosar:CATEGORY ;
        sh:severity sh:Info ;
        sh:message "For categories where COMPU-DEFAULT-VALUE is optional, it should specify an output value for inputs outside plausibility limits (behavioral recommendation)." ;
    ] .


