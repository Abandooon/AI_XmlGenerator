        sh:datatype autosar:CATEGORY-STRING ;
        sh:severity sh:Violation ;
    ] .

########## constr_1009 – SwDataDefProps applicable to ImplementationDataTypes
# Text refers to external table 5.18; we only model basic structure.

autosar:Constr_1009_ImplementationDataType_SwDataDefPropsShape
    a sh:NodeShape ;
    sh:targetClass autosar:IMPLEMENTATION-DATA-TYPE ;
    sh:property [
        sh:path autosar:SW-DATA-DEF-PROPS ;
        sh:class autosar:SW-DATA-DEF-PROPS ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path autosar:CATEGORY ;
        sh:datatype autosar:CATEGORY-STRING ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] .

########## constr_1010 – If nativeDeclaration does not exist
# Purely semantic (depends on predefined platform/standard type names) → SMT only, no SHACL.

########## constr_1011 – category of SwBaseType
autosar:Constr_1011_SwBaseType_CategoryShape
    a sh:NodeShape ;
    sh:targetClass autosar:SW-BASE-TYPE ;
    sh:property [
        sh:path autosar:CATEGORY ;
        sh:datatype autosar:CATEGORY-STRING ;
        sh:in ( "FIXED_LENGTH" "VARIABLE_LENGTH" ) ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] .

########## constr_1012 – Value of category is FIXED_LENGTH
# If CATEGORY = FIXED_LENGTH then:
#   BASE-TYPE-SIZE must exist (in BASE-TYPE-DIRECT-DEFINITION)
#   MAX-BASE-TYPE-SIZE must not exist
# Conditional logic → SMT. SHACL only models basic typing of the two size attributes.

autosar:Constr_1012_BaseTypeDirectDefinition_SizeShape
    a sh:NodeShape ;
    sh:targetClass autosar:BASE-TYPE-DIRECT-DEFINITION ;
    sh:property [
        sh:path autosar:BASE-TYPE-SIZE ;
        sh:datatype autosar:POSITIVE-INTEGER ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path autosar:MAX-BASE-TYPE-SIZE ;
        sh:datatype autosar:POSITIVE-INTEGER ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] .

########## constr_1013 – Value of category is VARIABLE_LENGTH
# Symmetric to 1012; conditional logic in SMT, SHACL already covered by 1012 shape.
# No additional SHACL needed.


#################################################################
# SHACL for constr_1014 - Supported value encodings for SwBaseType
#################################################################

autosar:Constr_1014_SupportedValueEncodingsForSwBaseType
    a sh:NodeShape ;
    sh:targetClass autosar:BASE-TYPE-DIRECT-DEFINITION ;
    sh:property [
        sh:path autosar:BASE-TYPE-ENCODING ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            "1C"
            "2C"
            "BCD-P"
            "BCD-UP"
            "DSP-FRACTIONAL"
            "SM"
            "IEEE754"
            "ISO-8859-1"
            "ISO-8859-2"
            "WINDOWS-1252"
            "UTF-8"
            "UTF-16"
            "UCS-2"
            "NONE"
            "VOID"
            "BOOLEAN"
        ) ;
        sh:severity sh:Violation ;
        sh:message "BASE-TYPE-ENCODING of BASE-TYPE-DIRECT-DEFINITION must be one of the supported encodings (1C, 2C, BCD-P, BCD-UP, DSP-FRACTIONAL, SM, IEEE754, ISO-8859-1, ISO-8859-2, WINDOWS-1252, UTF-8, UTF-16, UCS-2, NONE, VOID, BOOLEAN)." ;
    ] .

#################################################################
# SHACL for constr_1015 - Prioritization of SwDataDefProps
# (behavioral, table-based; no precise structural rule derivable)
#################################################################

# No SHACL rule generated; handled by SMT or documentation only.

#################################################################
# SHACL for constr_1016 - Restriction of invalidValue ...
#################################################################

autosar:Constr_1016_RestrictionOfInvalidValue
    a sh:NodeShape ;
    sh:targetClass autosar:SW-DATA-DEF-PROPS-CONTENT ;
    sh:property [
        sh:path autosar:INVALID-VALUE ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "If INVALID-VALUE is present, it shall be either a compatible NumericalValueSpecification, TextValueSpecification or a ConstantReference to a compatible ValueSpecification. (Detailed compatibility is checked by SMT/other means.)" ;
    ] .

#################################################################
# SHACL for constr_1017 - Supported combinations of swImplPolicy and swCalibrationAccess
# (table-based combinations; logical relation handled in SMT)
#################################################################

autosar:Constr_1017_SupportedCombinationsOfSwImplPolicyAndSwCalibrationAccess
    a sh:NodeShape ;
    sh:targetClass autosar:SW-DATA-DEF-PROPS-CONTENT ;
    sh:property [
        sh:path autosar:SW-CALIBRATION-ACCESS ;
