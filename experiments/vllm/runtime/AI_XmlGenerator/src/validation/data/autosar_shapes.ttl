.

# Constr_SwBaseType_Compatibility_SimpleConversion
# 语义：两个 SwBaseType 在底层编程语言存在简单转换规则时视为兼容。
# 这是运行时/语言层面的语义，不可从 XML 结构直接验证，不在 SHACL 中建模。


# 1) SwCalprmRefProxy Aggregation of AutosarParameterRef
# 语义是说明性/结构未给出，且目标类 AUTOSAR-PARAMETER-REF 本身是引用类型描述，
# 无可直接建模的结构约束，这里不生成 SHACL 形状。


# 2) Additional predefined and free chapters in SwComponentDocumentation
# 语义：SW-COMPONENT-DOCUMENTATION 中可以有 0..1 SW-FEATURE-DEF、0..1 SW-FEATURE-DESC，
# 以及任意数量的 CHAPTER（自由章节）。这是结构性定义，可直接建模。

autosar:Constr_SwComponentDocumentation_AdditionalChapters
    a sh:NodeShape ;
    sh:targetClass autosar:SW-COMPONENT-DOCUMENTATION ;

    # swFeatureDef: optional, at most one
    sh:property [
        sh:path autosar:SW-FEATURE-DEF ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "At most one SW-FEATURE-DEF (swFeatureDef) is allowed in SW-COMPONENT-DOCUMENTATION." ;
    ] ;

    # swFeatureDesc: optional, at most one
    sh:property [
        sh:path autosar:SW-FEATURE-DESC ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "At most one SW-FEATURE-DESC (swFeatureDesc) is allowed in SW-COMPONENT-DOCUMENTATION." ;
    ] ;

    # chapter: arbitrary number, no upper bound constraint
    sh:property [
        sh:path autosar:CHAPTER ;
        sh:severity sh:Info ;
        sh:message "Additional free CHAPTER elements may be defined in SW-COMPONENT-DOCUMENTATION." ;
    ]
.

# 3) SwComponentDocumentation is atpSplitable
# 语义是“文档可与组件分文件存储”，属于建模/文件组织特性，非 XML 内部结构约束，不建 SHACL。


# 4) SwDataDefProps compatibility when ImplementationDataType adds property
# 文本描述 ImplementationDataType 与 ApplicationDataType 在 note/displayFormat/swImplPolicy
# 上的兼容性规则，涉及两个类型间的语义关系和“添加但不改变”的概念，
# 仅靠本段结构信息无法在 SHACL 中稳定表达，这里不生成 SHACL 形状。


# 5) SwDataDefProps compatibility when ImplementationDataType defines property
# 语义：当只有 ImplementationDataType 可以定义 baseType 时，该定义需满足
# ApplicationDataType 的语义要求；这是跨类型的语义兼容性，非单一元素结构约束，
# 不生成 SHACL 形状。


# 6) SwDataDefProps redefinition relevance for compatibility
# 语义：ImplementationDataType 重新定义 swAddrMethod 或 dataConstr 对兼容性影响是项目特定，
# 标准本身不强制约束，因此不生成 SHACL 形状。


# 7) SwDataDefProps inheritance not relevant for compatibility
# 语义：某些属性 ImplementationDataType 不允许设置，只能继承；但具体属性列表未在此给出，
# 且本条说明“对兼容性不相关”，不生成 SHACL 形状。


