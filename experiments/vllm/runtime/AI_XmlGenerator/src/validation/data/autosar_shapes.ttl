########## constr_1197 – Existence of compositeNetworkRepresentation shall be comprehensive

# Structural coverage is complex (leaf ApplicationCompositeElementDataPrototype);
# we keep this to SMT for global reasoning. No additional SHACL beyond basic typing.

########## constr_1200 – Queued communication is not applicable for dataElements owned by PRPortPrototype

# Structural part: VARIABLE-DATA-PROTOTYPE/SW-DATA-DEF-PROPS is optional; no extra SHACL.
# Value restriction (swImplPolicy != queued) is handled in SMT.


# 1) constr_1201 - initValue shall exist in an RPortPrototype
# 语义：如果某 NonqueuedReceiverComSpec 处于 R-PORT-PROTOTYPE 的 REQUIRED-COM-SPECS 下，
#       则该 NonqueuedReceiverComSpec 必须具有 INIT-VALUE。
# 结构触发条件较复杂，主要由 SMT 负责；此处仅给出基本路径信息（不强制存在性）。

autosar:Constr_1201_InitValueInRPortPrototype
    a sh:NodeShape ;
    sh:severity sh:Violation ;
    sh:targetClass autosar:NONQUEUED-RECEIVER-COM-SPEC ;
    sh:property [
        sh:path autosar:INIT-VALUE
    ] .

# 2) constr_1202 - Supported connections by AssemblySwConnector (NvData / SR)
# 仅引用“Table 4.4”，缺乏可观测结构模式，交由 SMT/外部规则处理，这里只给出目标类占位。

autosar:Constr_1202_SupportedConnections_AssemblySwConnector_NvData
    a sh:NodeShape ;
    sh:severity sh:Info ;
    sh:targetClass autosar:ASSEMBLY-SW-CONNECTOR .

# 3) constr_1203 - Supported connections by DelegationSwConnector (NvData / SR)
# 同样依赖表 4.5，SHACL 仅给出目标类占位。

autosar:Constr_1203_SupportedConnections_DelegationSwConnector_NvData
    a sh:NodeShape ;
    sh:severity sh:Info ;
    sh:targetClass autosar:DELEGATION-SW-CONNECTOR .

# 4) constr_1204 - Supported connections by AssemblySwConnector (CS / MS / Trigger)
# 依赖表 4.11，SHACL 仅给出目标类占位。

autosar:Constr_1204_SupportedConnections_AssemblySwConnector_CS_MS_Trigger
    a sh:NodeShape ;
    sh:severity sh:Info ;
    sh:targetClass autosar:ASSEMBLY-SW-CONNECTOR .

# 5) constr_1205 - Supported connections by DelegationSwConnector (CS / MS / Trigger)
# 依赖表 4.12，SHACL 仅给出目标类占位。

autosar:Constr_1205_SupportedConnections_DelegationSwConnector_CS_MS_Trigger
    a sh:NodeShape ;
    sh:severity sh:Info ;
    sh:targetClass autosar:DELEGATION-SW-CONNECTOR .

# 6) constr_1209 - Mapping of ModeDeclarations of mode user to ModeDeclaration of mode manager
# 语义：不允许“多个 mode user 的 ModeDeclaration 映射到同一个 mode manager 的 ModeDeclaration”。
# 这是纯逻辑/全局唯一性约束，由 SMT 负责；SHACL 仅给出目标类占位。

autosar:Constr_1209_ModeDeclarationMapping_NoManyToOne
    a sh:NodeShape ;
    sh:severity sh:Violation ;
    sh:targetClass autosar:MODE-DECLARATION .

# 7) constr_1210 - Mapping of ModeDeclarations of mode user to all ModeDeclarations of mode manager
# 语义：若存在某个 mode manager 模式被映射，则该 mode manager 的所有模式都必须被映射。
# 这是覆盖性/全称约束，由 SMT 负责；SHACL 仅给出目标类占位。

autosar:Constr_1210_ModeDeclarationMapping_CoverAllManagerModes
    a sh:NodeShape ;
    sh:severity sh:Violation ;
    sh:targetClass autosar:MODE-DECLARATION .


