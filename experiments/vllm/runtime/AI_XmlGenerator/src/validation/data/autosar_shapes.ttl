# Target: APPLICATION-VALUE-SPECIFICATION
# Note: purely behavioral / semantic; no stable structural condition → no SHACL

# 2) Constr_SwDataDefProps_OverrideRestrictions_DataPrototype
# Target semantic: SwDataDefProps (abstract / meta-level restriction on override)
# No concrete, checkable structural pattern given → no SHACL

# 3) Constr_SwcInternalBehavior_DiagnosticEventManagerNeeds_Mapping
# Target semantic: DIAGNOSTIC-EVENT-MANAGER-NEEDS (relationship text only)
# No concrete path from SwcInternalBehavior to DIAGNOSTIC-EVENT-MANAGER-NEEDS given → no SHACL

# 4) Constr_SwcInternalBehavior_FunctionInhibitionNeeds_Cardinality
# Target: FUNCTION-INHIBITION-NEEDS
# Expression: "may provide several" → no minimum, only upper bound is unbounded
# This is already the default (0..*) → no additional SHACL constraint

# 5) Constr_SwcInternalBehavior_InputValuesList
# Target: RUNNABLE-ENTITY
# Expression talks about "a list of input values" but no concrete XML path is provided
# → cannot construct a stable sh:path → no SHACL

# 6) Constr_SwcInternalBehavior_NvBlockNeeds_Aggregation
# Target: NV-BLOCK-NEEDS
# Relationship text only, no concrete path → no SHACL

# 7) Constr_SwcServiceDependency_DiagnosticValueNeeds_Exception
# Target semantic: DIAGNOSTIC-VALUE-NEEDS
# Expression is a permission ("it is permitted that ...") not a restriction
# → no SHACL violation condition to enforce


# 1) SwcServiceDependency per DTC status change kind
# 描述性/推荐性关系约束，缺少可观测结构信号，不生成 SHACL 结构约束

# 2) Role for assignedPort in SwcServiceDependency for NvBlockNeeds
# 语义：当 SwcServiceDependency.serviceNeeds 为 NvBlockNeeds 且通过 assignedPort 关联到 Nv 数据 PortPrototype 时，
# 这些 ROLE-BASED-PORT-ASSIGNMENT/ROLE 的值应为 "NvDataPort"。
# 该约束依赖运行时/建模语义（“nv data PortPrototypes”识别），仅在 SMT 中建模逻辑，不在 SHACL 中强制具体值。

# 3) SyncTimeBaseMgrUserNeeds and SwcServiceDependency for StbM configuration
# 描述性关系约束，不生成 SHACL 结构约束

# 4) Recommended debouncing algorithm for Dem debouncing scenario
# 推荐性（id_type = additional_not_binding），不作为强制 SHACL 约束

# 5) Recommended debouncing algorithm for SWC debouncing scenario
# 推荐性（id_type = additional_not_binding），不作为强制 SHACL 约束

# 6) Recommendation for NvBlockDescriptor.timingEvent.period value
# 推荐性（id_type = additional_not_binding），不作为强制 SHACL 约束

# 7) Top-level composition unconnected ports for reuse
# 描述性（“might have”），不作为强制 SHACL 约束


# 1) Transformer applicability for TransformationComSpecProps subtypes
autosar:Constr_TransformerApplicability_TransformationComSpecProps_1
  a sh:NodeShape ;
  sh:targetClass autosar:END-TO-END-TRANSFORMATION-COM-SPEC-PROPS ;
  sh:property [
    sh:path ( autosar:TRANSFORMATION-TECHNOLOGY autosar:PROTOCOL ) ;
  ] ;
  sh:severity sh:Info ;
.

# 2) Rationale for Trigger Compatibility – no structural constraint (behavioral only)
#   → handled purely in SMT (logical documentation), no SHACL node shape emitted.


# 3) Reachability via Type-Prototype Chain for InstanceRef
#    (purely semantic / reachability, no stable structural pattern expressible in SHACL)
#    → no SHACL node shape emitted.


# 4) Recommended categories for UnitGroup
autosar:Constr_UnitGroup_RecommendedCategories
  a sh:NodeShape ;
  sh:targetClass autosar:UNIT-GROUP ;
  sh:property [
    sh:path autosar:CATEGORY ;
    sh:in ( "COUNTRY" "CALCULATION" "EQUIV_UNITS" ) ;
  ] ;
  sh:severity sh:Warning ;
.

# 5) Dimensionless Unit Implication
#    “unit itself may not have a dimension, i.e. all exponents of SI units are 0”
#    This is a semantic implication between Unit and PhysicalDimension; we keep SHACL
#    purely structural (no additional shape here), logic is in SMT.


# 6) ShortName identity not required for Unit compatibility
#    This is a negative statement about what is NOT required for compatibility,
#    not a structural restriction → no SHACL node shape emitted.


# 7) Conditional usage of VariationPointProxy attributes (introductory text)
#    The detailed binding-time/category rules are not given here, so SHACL is
#    limited to basic structural typing of the listed properties.

autosar:Constr_VariationPointProxy_AttributeUsageConditions_Intro
  a sh:NodeShape ;
  sh:targetClass autosar:VARIATION-POINT-PROXY ;

  sh:property [
    sh:path autosar:DESC ;
  ] ;

  sh:property [
    sh:path autosar:CATEGORY ;
  ] ;

  sh:property [
    sh:path autosar:ADMIN-DATA ;
  ] ;

  sh:property [
    sh:path autosar:INTRODUCTION ;
  ] ;

  sh:property [
    sh:path ( autosar:ANNOTATIONS autosar:ANNOTATION ) ;
  ] ;

  sh:property [
    sh:path autosar:LONG-NAME ;
  ] ;

  sh:property [
    sh:path autosar:SHORT-NAME ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;

  sh:property [
    sh:path ( autosar:SHORT-NAME-FRAGMENTS autosar:SHORT-NAME-FRAGMENT ) ;
  ] ;

  sh:property [
    sh:path autosar:CONDITION-ACCESS ;
  ] ;

  sh:property [
    sh:path autosar:IMPLEMENTATION-DATA-TYPE-REF ;
  ] ;

  sh:property [
    sh:path autosar:POST-BUILD-VALUE-ACCESS-REF ;
  ] ;

  sh:property [
    sh:path ( autosar:POST-BUILD-VARIANT-CONDITIONS autosar:POST-BUILD-VARIANT-CONDITION ) ;
  ] ;

  sh:property [
    sh:path autosar:VALUE-ACCESS ;
  ] ;

  sh:severity sh:Info ;
.


# 1) Constr_VariationPointProxy_ConditionAccessEvaluation
# Behavioral, runtime-like; no structural restriction derivable → no SHACL shape emitted.


# 2) Constr_WarningIndicatorNeeds_Triggers_PPort
# "To trigger the existence of the PPortPrototype, WarningIndicatorRequestedBitNeeds shall be defined."
# Purely behavioral/semantic trigger; no concrete XML path given for WarningIndicatorRequestedBitNeeds.
# No safe structural SHACL constraint can be derived → no SHACL shape emitted.


# 3) Definition_ParameterSwComponentType_No_InternalBehavior
# "ParameterSwComponentType cannot aggregate SwcInternalBehavior"

autosar:Definition_ParameterSwComponentType_No_InternalBehavior_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:PARAMETER-SW-COMPONENT-TYPE ;
    sh:severity sh:Violation ;

