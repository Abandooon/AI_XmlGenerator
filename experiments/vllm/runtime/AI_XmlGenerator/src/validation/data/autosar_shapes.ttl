    a sh:NodeShape ;
    sh:targetClass autosar:APPLICATION-SW-COMPONENT-TYPE ,autosar:COMPLEX-DEVICE-DRIVER-SW-COMPONENT-TYPE ,autosar:ECU-ABSTRACTION-SW-COMPONENT-TYPE ,autosar:NV-BLOCK-SW-COMPONENT-TYPE ,autosar:SENSOR-ACTUATOR-SW-COMPONENT-TYPE ,autosar:SERVICE-PROXY-SW-COMPONENT-TYPE ,autosar:SERVICE-SW-COMPONENT-TYPE ;
    sh:property [
        sh:path autosar:PORTS ;
        sh:severity sh:Info
    ] .

# TPS_SWCT_01400 - PortInterface selected from the set of standardized Service Interfaces
# 仅建模 isService 的存在性和布尔类型；“必须为服务接口”由 SMT 负责
autosar:TPS_SWCT_01400
    a sh:NodeShape ;
    sh:targetClass autosar:CLIENT-SERVER-INTERFACE ,autosar:NV-DATA-INTERFACE ,autosar:PARAMETER-INTERFACE ,autosar:SENDER-RECEIVER-INTERFACE ,autosar:MODE-SWITCH-INTERFACE ,autosar:TRIGGER-INTERFACE ;
    sh:property [
        sh:path autosar:IS-SERVICE ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation
    ] .


