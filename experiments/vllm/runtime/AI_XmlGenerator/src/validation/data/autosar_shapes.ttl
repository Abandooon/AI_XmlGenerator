#################################################################
# SHACL for constr_1381
#################################################################

autosar:constr_1381_MemorySection_OptionCoreShape
    a sh:NodeShape ;
    sh:targetClass autosar:MEMORY-SECTION ;
    sh:severity sh:Violation ;
    sh:property [
        sh:path ( autosar:OPTIONS autosar:OPTION ) ;
        sh:sparql [
            sh:message "Any given list of values stored in MemorySection.option shall include at most one of {coreGlobal, coreLocal}." ;
            sh:select """
                PREFIX autosar: <http://autosar.org/>
                SELECT $this
                WHERE {
                  $this autosar:OPTIONS/autosar:OPTION ?opt1 .
                  $this autosar:OPTIONS/autosar:OPTION ?opt2 .
                  FILTER (?opt1 != ?opt2)
                  FILTER (?opt1 IN ("coreGlobal","coreLocal"))
                  FILTER (?opt2 IN ("coreGlobal","coreLocal"))
                }
            """ ;
        ] ;
    ] .

autosar:constr_1381_SwAddrMethod_OptionCoreShape
    a sh:NodeShape ;
    sh:targetClass autosar:SW-ADDR-METHOD ;
    sh:severity sh:Violation ;
    sh:property [
        sh:path ( autosar:OPTIONS autosar:OPTION ) ;
        sh:sparql [
            sh:message "Any given list of values stored in SwAddrMethod.option shall include at most one of {coreGlobal, coreLocal}." ;
            sh:select """
                PREFIX autosar: <http://autosar.org/>
                SELECT $this
                WHERE {
                  $this autosar:OPTIONS/autosar:OPTION ?opt1 .
                  $this autosar:OPTIONS/autosar:OPTION ?opt2 .
                  FILTER (?opt1 != ?opt2)
                  FILTER (?opt1 IN ("coreGlobal","coreLocal"))
                  FILTER (?opt2 IN ("coreGlobal","coreLocal"))
                }
            """ ;
        ] ;
    ] .

#################################################################
# SHACL for constr_1382
#################################################################

autosar:constr_1382_SwVariableRefProxyShape
    a sh:NodeShape ;
    sh:severity sh:Violation ;
    # targetClass left empty – SwVariableRefProxy not given as concrete xml_tag
    sh:sparql [
        sh:message "SwVariableRefProxy.autosarVariable and SwVariableRefProxy.mcDataInstanceVar shall never exist at the same time." ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT $this
            WHERE {
              OPTIONAL { $this autosar:AUTOSAR-VARIABLE ?v . }
              OPTIONAL { $this autosar:MC-DATA-INSTANCE-VAR-REF ?m . }
              FILTER( bound(?v) && bound(?m) )
            }
        """ ;
    ] .

#################################################################
# SHACL for constr_1383
#################################################################

autosar:constr_1383_ImplDataTypeShape
    a sh:NodeShape ;
    sh:targetClass autosar:IMPLEMENTATION-DATA-TYPE ;
    sh:severity sh:Info ;
    sh:sparql [
        sh:message "For ImplementationDataType of category TYPE_REFERENCE, existence of swDataDefProps.compuMethod or swDataDefProps.dataConstr is only allowed if, after resolving type references, the resulting ImplementationDataType has category VALUE (checked by external SMT/semantic analysis)." ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT $this
            WHERE {
              $this autosar:CATEGORY ?cat .
              FILTER(?cat = "TYPE_REFERENCE")
              OPTIONAL {
                $this autosar:SW-DATA-DEF-PROPS/autosar:SW-DATA-DEF-PROPS-CONTENT ?content .
                OPTIONAL { ?content autosar:COMPU-METHOD-REF ?cm . }
                OPTIONAL { ?content autosar:DATA-CONSTR-REF ?dc . }
              }
              FILTER( bound(?cm) || bound(?dc) )
            }
        """ ;
    ] .

