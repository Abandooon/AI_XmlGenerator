# constr_2045 – ParameterDataPrototype in role perInstanceParameter: swImplPolicy = standard
autosar:constr_2045 a sh:NodeShape ;
  sh:targetClass autosar:PARAMETER-DATA-PROTOTYPE ;
  sh:severity sh:Violation ;
  sh:message "The overriding swImplPolicy of a ParameterDataPrototype in the role perInstanceParameter shall be 'standard'." ;
