# 1) SHACL 约束

# TPS_SWCT_01337 - DataReceivedEvent directly associated with VariableDataPrototype
# 语义偏运行时/行为（通知机制），缺少稳定结构路径，这里不生成结构性 SHACL

# TPS_SWCT_01338 - DataReceiveErrorEvent / aliveTimeout
# 约束主要描述运行时错误触发条件（COM 层监控 aliveTimeout），非纯结构约束，不生成 SHACL

# TPS_SWCT_01339 - RTE activates RunnableEntity in response to DataReceiveErrorEvent
# 运行时行为，不生成 SHACL

# TPS_SWCT_01340 - DataReceiveErrorEvent cannot be combined with a WaitPoint
# 文本中引用 [constr_1091]，且未给出 DataReceiveErrorEvent 与 WaitPoint 的结构关系，缺少路径信息，不生成 SHACL

# TPS_SWCT_01341 - DataReceiveErrorEvent directly associated with VariableDataPrototype
# 仅有“直接关联”语义，无具体 XML 路径信息，不生成 SHACL

# TPS_SWCT_01342 - Invocation of a server operation
# 运行时调用语义，不生成 SHACL

# TPS_SWCT_01343 - Synchronous vs. asynchronous invocation
# 运行时调用语义，不生成 SHACL


# 1) SHACL (Turtle)

#################################################################
# TPS_SWCT_01344 - Consistency of values of timeout
# Target: CLIENT-SERVER-OPERATION
#################################################################

autosar:TPS_SWCT_01344_TimeoutConsistency
    a sh:NodeShape ;
    sh:targetClass autosar:CLIENT-SERVER-OPERATION ;

    # Structural: timeout is a TimeValue on ServerCallPoints (if present)
    sh:property [
        sh:path ( autosar:ASYNCHRONOUS-SERVER-CALL-POINT autosar:TIMEOUT ) ;
        sh:datatype autosar:TIME-VALUE
    ] ;
    sh:property [
        sh:path ( autosar:SYNCHRONOUS-SERVER-CALL-POINT autosar:TIMEOUT ) ;
        sh:datatype autosar:TIME-VALUE
    ] ;

    # Logical: all ServerCallPoints referencing the same ClientServerOperation
    # must have identical TIMEOUT values
    sh:sparql [
        sh:message "All ServerCallPoints referencing the same ClientServerOperation shall have consistent TIMEOUT values." ;
        sh:severity sh:Violation ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>

            SELECT ?this ?scp1 ?scp2 ?timeout1 ?timeout2
            WHERE {
              ?scp1 autosar:OPERATION-REF ?this .
              ?scp2 autosar:OPERATION-REF ?this .
              FILTER(?scp1 != ?scp2)

              {
                ?scp1 autosar:TIMEOUT ?timeout1 .
              } UNION {
                ?scp1 autosar:ASYNCHRONOUS-SERVER-CALL-POINT/autosar:TIMEOUT ?timeout1 .
              } UNION {
                ?scp1 autosar:SYNCHRONOUS-SERVER-CALL-POINT/autosar:TIMEOUT ?timeout1 .
              }

              {
                ?scp2 autosar:TIMEOUT ?timeout2 .
              } UNION {
                ?scp2 autosar:ASYNCHRONOUS-SERVER-CALL-POINT/autosar:TIMEOUT ?timeout2 .
              } UNION {
                ?scp2 autosar:SYNCHRONOUS-SERVER-CALL-POINT/autosar:TIMEOUT ?timeout2 .
              }

              FILTER(?timeout1 != ?timeout2)
            }
        """
    ] .

#################################################################
# TPS_SWCT_01345 - Synchronous operation invocation
# Target: RUNNABLE-ENTITY
#################################################################

autosar:TPS_SWCT_01345_SynchronousInvocation
    a sh:NodeShape ;
    sh:targetClass autosar:RUNNABLE-ENTITY ;

    # Informational: a RunnableEntity that performs a synchronous operation
    # invocation needs a SynchronousServerCallPoint
    sh:sparql [
        sh:message "A RunnableEntity that performs a synchronous operation invocation should have a SynchronousServerCallPoint." ;
        sh:severity sh:Info ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>

            SELECT ?this
            WHERE {
              ?this a autosar:RUNNABLE-ENTITY .
              # Domain-specific trigger for 'performs synchronous operation invocation'
              # is not structurally observable; left as informational.
            }
        """
    ] .

#################################################################
# TPS_SWCT_01346 - Asynchronous operation invocation
# Target: ASYNCHRONOUS-SERVER-CALL-RETURNS-EVENT
#################################################################

autosar:TPS_SWCT_01346_AsynchronousInvocation
    a sh:NodeShape ;
    sh:targetClass autosar:ASYNCHRONOUS-SERVER-CALL-RETURNS-EVENT ;

    # Informational: if an AsynchronousServerCallReturnsEvent is raised,
    # RTE either triggers a RunnableEntity or a WaitPoint blocks execution.
    # This is behavioral and not fully structurally observable.
    sh:sparql [
        sh:message "For an AsynchronousServerCallReturnsEvent, either a RunnableEntity is triggered or a WaitPoint blocks the calling RunnableEntity." ;
        sh:severity sh:Info ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>

            SELECT ?this
            WHERE {
              ?this a autosar:ASYNCHRONOUS-SERVER-CALL-RETURNS-EVENT .
            }
        """
    ] .

#################################################################
# TPS_SWCT_01347 - Blocking access to operation result in an
#                  asynchronous operation invocation
# Target: ASYNCHRONOUS-SERVER-CALL-RESULT-POINT
#################################################################

autosar:TPS_SWCT_01347_BlockingAccessToAsyncResult
    a sh:NodeShape ;
    sh:targetClass autosar:ASYNCHRONOUS-SERVER-CALL-RESULT-POINT ;

    # Structural: START-ON-EVENT-REF (if present) must reference a RUNNABLE-ENTITY
    sh:property [
        sh:path autosar:START-ON-EVENT-REF ;
        sh:class autosar:RUNNABLE-ENTITY
    ] ;

    # Logical (Info): if the RTE call fetching the operation result blocks
    # via a WaitPoint referencing the AsynchronousServerCallReturnsEvent
    # associated with this ResultPoint, then that Event shall not define
    # a startOnEvent reference to a RunnableEntity.
    sh:sparql [
        sh:message "If blocking via WaitPoint is used for an AsynchronousServerCallResultPoint, the associated AsynchronousServerCallReturnsEvent shall not define a START-ON-EVENT-REF to a RunnableEntity." ;
        sh:severity sh:Info ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>

            SELECT ?this ?event
            WHERE {
              ?this a autosar:ASYNCHRONOUS-SERVER-CALL-RESULT-POINT .
              # Association to the corresponding AsynchronousServerCallReturnsEvent
              ?this autosar:RETURNS-EVENT-REF ?event .

              # Blocking behavior via WaitPoint is not structurally observable;
              # this query only documents the intended relation.
            }
        """
    ] .

#################################################################
# TPS_SWCT_01348 - Trigger source
# Target: ABSTRACT-PROVIDED-PORT-PROTOTYPE
#################################################################

autosar:TPS_SWCT_01348_TriggerSource
    a sh:NodeShape ;
    sh:targetClass autosar:ABSTRACT-PROVIDED-PORT-PROTOTYPE ;

    # Informational: a RunnableEntity that raises an external trigger event
    # via an AbstractProvidedPortPrototype needs an ExternalTriggeringPoint
    # that references the trigger instance in a PPortPrototype.
    sh:sparql [
        sh:message "A RunnableEntity that raises an external trigger via an AbstractProvidedPortPrototype should have an ExternalTriggeringPoint referencing the trigger in a PPortPrototype." ;
        sh:severity sh:Info ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>

            SELECT ?this
            WHERE {
              ?this a autosar:ABSTRACT-PROVIDED-PORT-PROTOTYPE .
            }
        """
    ] .

#################################################################
# TPS_SWCT_01350 - Calibration Parameters shared among several
#                  SwComponentTypes
# Target: PARAMETER-DATA-PROTOTYPE
#################################################################

autosar:TPS_SWCT_01350_SharedCalibrationParameters
    a sh:NodeShape ;
    sh:targetClass autosar:PARAMETER-DATA-PROTOTYPE ;

    # Informational: if Calibration Parameters are shared among several
    # SwComponentTypes, a dedicated PortInterface in a PortPrototype is used.
    sh:sparql [
        sh:message "Shared Calibration Parameters among several SwComponentTypes should be provided via a dedicated PortInterface in a PortPrototype." ;
        sh:severity sh:Info ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>

            SELECT ?this
            WHERE {
              ?this a autosar:PARAMETER-DATA-PROTOTYPE .
            }
        """
    ] .

#################################################################
# TPS_SWCT_01351 - Access to a ParameterDataPrototype
# Target: PARAMETER-ACCESS
#################################################################

autosar:TPS_SWCT_01351_ParameterAccess
    a sh:NodeShape ;
    sh:targetClass autosar:PARAMETER-ACCESS ;

    # Structural: perInstanceParameter and sharedParameter are ParameterDataPrototypes
    sh:property [
        sh:path ( autosar:SWC-INTERNAL-BEHAVIOR autosar:PER-INSTANCE-PARAMETERS autosar:PARAMETER-DATA-PROTOTYPE ) ;
        sh:class autosar:PARAMETER-DATA-PROTOTYPE
    ] ;
    sh:property [
        sh:path ( autosar:SWC-INTERNAL-BEHAVIOR autosar:SHARED-PARAMETERS autosar:PARAMETER-DATA-PROTOTYPE ) ;
        sh:class autosar:PARAMETER-DATA-PROTOTYPE
    ] ;

    # Informational: access to a ParameterDataPrototype is indicated either
    # via ParameterAccess from a RPortPrototype or via shared/perInstance roles.
    sh:sparql [
        sh:message "Access to a ParameterDataPrototype is indicated via ParameterAccess from a RPortPrototype or via sharedParameter/perInstanceParameter associations." ;
        sh:severity sh:Info ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>

            SELECT ?this
            WHERE {
              ?this a autosar:PARAMETER-ACCESS .
            }
        """
    ] .


