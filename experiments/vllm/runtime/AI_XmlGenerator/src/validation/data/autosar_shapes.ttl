# 约束为运行时/语义性说明（“values ... are for display only”），
# 不涉及结构性/计数/类型等可静态验证内容，因此不生成 SHACL 约束。


# TPS_SWCT_02500
# “Roles on Application/Service Components need to Match”
# 需要跨组件、跨端口的匹配关系，当前输入未提供端口连接结构的路径与类型，
# 无法稳定构造 SHACL 路径与 SPARQL，因此不生成 SHACL 约束。


# TPS_SWCT_02501
# Setup for Nvm Use Case: Permanent RAM Block
# 仅能对 RoleBasedDataAssignment 的 role 取值做静态约束：
#   - 必须存在一个 role = "ramBlock"
#   - 至多存在一个 role = "defaultValue"

autosar:RoleBasedDataAssignment_NvmPermanentRamBlockShape
    a sh:NodeShape ;
    sh:targetClass autosar:ROLE-BASED-DATA-ASSIGNMENT ;

    # 至少一个 RoleBasedDataAssignment/ROLE = "ramBlock"
    sh:property [
        sh:path autosar:ROLE ;
        sh:datatype xsd:string ;
        sh:hasValue "ramBlock" ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "For Nvm Permanent RAM Block, at least one RoleBasedDataAssignment shall have role = 'ramBlock'."@en ;
    ] ;

    # 至多一个 RoleBasedDataAssignment/ROLE = "defaultValue"
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "For Nvm Permanent RAM Block, at most one RoleBasedDataAssignment may have role = 'defaultValue'."@en ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this
            WHERE {
              {
                SELECT ?this (COUNT(?r) AS ?cnt)
                WHERE {
                  ?this autosar:ROLE ?r .
                  FILTER(str(?r) = "defaultValue")
                }
                GROUP BY ?this
                HAVING (?cnt > 1)
              }
            }
        """ ;
    ] .


# TPS_SWCT_02502
# Setup for Nvm Use Case: Temporary RAM Block
# 仅能对 RoleBasedDataAssignment / RoleBasedDataTypeAssignment 的 role 取值做静态约束：
#   - RoleBasedDataAssignment: 至多一个 role = "defaultValue"
#   - RoleBasedDataTypeAssignment: 至多一个 role = "temporaryRamBlock"

autosar:RoleBasedDataAssignment_NvmTemporaryRamBlockShape
    a sh:NodeShape ;
    sh:targetClass autosar:ROLE-BASED-DATA-ASSIGNMENT ;

    # 至多一个 RoleBasedDataAssignment/ROLE = "defaultValue"
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "For Nvm Temporary RAM Block, at most one RoleBasedDataAssignment may have role = 'defaultValue'."@en ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this
            WHERE {
              {
                SELECT ?this (COUNT(?r) AS ?cnt)
                WHERE {
                  ?this autosar:ROLE ?r .
                  FILTER(str(?r) = "defaultValue")
                }
                GROUP BY ?this
                HAVING (?cnt > 1)
              }
            }
        """ ;
    ] .

autosar:RoleBasedDataTypeAssignment_NvmTemporaryRamBlockShape
    a sh:NodeShape ;
    sh:targetClass autosar:ROLE-BASED-DATA-TYPE-ASSIGNMENT ;

    # 至多一个 RoleBasedDataTypeAssignment/ROLE = "temporaryRamBlock"
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "For Nvm Temporary RAM Block, at most one RoleBasedDataTypeAssignment may have role = 'temporaryRamBlock'."@en ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this
            WHERE {
              {
                SELECT ?this (COUNT(?r) AS ?cnt)
                WHERE {
                  ?this autosar:ROLE ?r .
                  FILTER(str(?r) = "temporaryRamBlock")
                }
                GROUP BY ?this
                HAVING (?cnt > 1)
              }
            }
        """ ;
    ] .


# TPS_SWCT_02503
# Setup for NVM Use Case: Software-Components using NvData provided by NvBlockSwComponentType
# 仅能对 SwcServiceDependency/ASSIGNED-PORTS/ROLE-BASED-PORT-ASSIGNMENT/ROLE 的取值做静态约束：
#   - 至少一个 RoleBasedPortAssignment/ROLE = "NvDataPort"

autosar:SwcServiceDependency_NvDataPortShape
    a sh:NodeShape ;
    sh:targetClass autosar:SWC-SERVICE-DEPENDENCY ;

    # 至少一个 ASSIGNED-PORTS/ROLE-BASED-PORT-ASSIGNMENT/ROLE = "NvDataPort"
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "For SwcServiceDependency using NvData, at least one assigned RoleBasedPortAssignment shall have role = 'NvDataPort'."@en ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this
            WHERE {
              {
                SELECT ?this (COUNT(?role) AS ?cnt)
                WHERE {
                  ?this autosar:ASSIGNED-PORTS ?ports .
                  ?ports autosar:ROLE-BASED-PORT-ASSIGNMENT ?rpa .
                  ?rpa autosar:ROLE ?role .
                  FILTER(str(?role) = "NvDataPort")
                }
                GROUP BY ?this
                HAVING (?cnt < 1)
              }
            }
        """ ;
    ] .


# 1) TPS_SWCT_02504 – Setup for Nvm Use Case: RAM Block with explicit synchronization using Mirror Interfaces

autosar:TPS_SWCT_02504 a sh:NodeShape ;
  sh:targetClass autosar:ATOMIC-SW-COMPONENT-TYPE ;
  sh:severity sh:Violation ;

  # RoleBasedPortAssignment: existence is mandatory for the described scenario,
  # and ROLE must be one of the listed ClientServerInterfaces with given multiplicities.
  sh:property [
    sh:path ( autosar:SWC-SERVICE-DEPENDENCY autosar:ASSIGNED-PORTS autosar:ROLE-BASED-PORT-ASSIGNMENT autosar:ROLE ) ;
    sh:in ( "NvMService" "NvMNotifyJobFinished" "NvMNotifyInitBlock" "NvMAdmin" "NvMMirror" ) ;
  ] ;

  # RoleBasedDataAssignment: existence optional; if present, USED-PARAMETER-ELEMENT must reference a parameter
  # aggregated by enclosing SwcInternalBehavior in perInstanceParameter or sharedParameter.
  # (Structural part only: presence of ROLE-BASED-DATA-ASSIGNMENT)
  sh:property [
    sh:path ( autosar:SWC-SERVICE-DEPENDENCY autosar:ASSIGNED-DATAS autosar:ROLE-BASED-DATA-ASSIGNMENT ) ;
  ] ;

  # RoleBasedDataTypeAssignment: USED-IMPLEMENTATION-DATA-TYPE-REF DEST must be IMPLEMENTATION-DATA-TYPE
  sh:property [
    sh:path ( autosar:BSW-SERVICE-DEPENDENCY autosar:ASSIGNED-DATA-TYPES autosar:ROLE-BASED-DATA-TYPE-ASSIGNMENT autosar:USED-IMPLEMENTATION-DATA-TYPE-REF ) ;
    sh:node [
      sh:property [
        sh:path autosar:DEST ;
        sh:hasValue "IMPLEMENTATION-DATA-TYPE" ;
      ]
    ]
  ] .

# 2) TPS_SWCT_02505 – Setup for Function Inhibition Manager Service use Case: read function permission

autosar:TPS_SWCT_02505 a sh:NodeShape ;
  sh:targetClass autosar:ATOMIC-SW-COMPONENT-TYPE ;
  sh:severity sh:Violation ;

  # RoleBasedPortAssignment valid roles: FunctionInhibition [1]
  sh:property [
    sh:path ( autosar:SWC-SERVICE-DEPENDENCY autosar:ASSIGNED-PORTS autosar:ROLE-BASED-PORT-ASSIGNMENT autosar:ROLE ) ;
    sh:in ( "FunctionInhibition" ) ;
    sh:minCount 1 ;
  ] .

# 3) TPS_SWCT_02506 – Setup for Dlt use Case: Application software component accesses the Synchronized Time-Base Manager

autosar:TPS_SWCT_02506 a sh:NodeShape ;
  sh:targetClass autosar:ATOMIC-SW-COMPONENT-TYPE ;
  sh:severity sh:Violation ;

  # RoleBasedPortAssignment valid roles:
  # DLTService [1], LogTraceSessionControl [1], VerboseModeControl [0..1], InjectionCallback [0..1]
  sh:property [
    sh:path ( autosar:SWC-SERVICE-DEPENDENCY autosar:ASSIGNED-PORTS autosar:ROLE-BASED-PORT-ASSIGNMENT autosar:ROLE ) ;
    sh:in ( "DLTService" "LogTraceSessionControl" "VerboseModeControl" "InjectionCallback" ) ;
  ] .

# 4) TPS_SWCT_02507 – Instantiation-specific RTEEvents

autosar:TPS_SWCT_02507 a sh:NodeShape ;
  sh:targetClass autosar:APPLICATION-SW-COMPONENT-TYPE ;
  sh:severity sh:Info ;

  # Optional instantiationRTEEventProps on CompositionSwComponentType
  sh:property [
    sh:path ( autosar:COMPOSITION-SW-COMPONENT-TYPE autosar:INSTANTIATION-RTE-EVENT-PROPSS autosar:INSTANTIATION-TIMING-EVENT-PROPS ) ;
  ] .

# 5) Table_11_1_Pattern_A_star – ServiceConnectorPattern A* (1:n, RPort:PPort) not supported

autosar:Table_11_1_Pattern_A_star a sh:NodeShape ;
  sh:targetClass autosar:PORT-PROTOTYPE ;
  sh:severity sh:Violation .

# 6) Table_11_1_Pattern_C_star – ServiceConnectorPattern C* (n:1, PPort:RPort) conceptually not used

autosar:Table_11_1_Pattern_C_star a sh:NodeShape ;
  sh:targetClass autosar:PORT-DEFINED-ARGUMENT-VALUE ;
  sh:severity sh:Info .

# 7) Table_11_7_NvBlockDescriptor_NvBlockNeeds_calcRamBlockCrc – Recommendation

autosar:Table_11_7_NvBlockDescriptor_NvBlockNeeds_calcRamBlockCrc a sh:NodeShape ;
  sh:targetClass autosar:PORT-PROTOTYPE ;
  sh:severity sh:Warning ;

  # Structural: presence of NV-BLOCK-NEEDS and optional CALC-RAM-BLOCK-CRC
  sh:property [
    sh:path ( autosar:NV-BLOCK-DESCRIPTOR autosar:NV-BLOCK-NEEDS autosar:CALC-RAM-BLOCK-CRC ) ;
    sh:datatype xsd:boolean ;
  ] .


