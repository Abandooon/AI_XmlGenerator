    ] .


# 1) SHACL 约束

# TPS_SWCT_01418 / TPS_SWCT_01423 / TPS_SWCT_01424
# 这些约束主要是定义性/说明性文字（“可以…的方式”、“描述实现方式”等），
# 不引入强制结构约束，因此不生成 SHACL 形状。

# TPS_SWCT_01420
# 语义：需要访问共享标定参数的 SwComponentType 必须有一个 RPortPrototype，
# 且该 RPortPrototype 的 REQUIRED-INTERFACE-TREF 的 DEST 为 PARAMETER-INTERFACE。
# 这里仅对 REQUIRED-INTERFACE-TREF 的 DEST 类型做结构性约束。

autosar:TPS_SWCT_01420_RequiredInterfaceDestShape
    a sh:NodeShape ;
    sh:targetClass autosar:R-PORT-PROTOTYPE ;

    sh:property [
        sh:path autosar:REQUIRED-INTERFACE-TREF ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            "CLIENT-SERVER-INTERFACE"
            "DATA-INTERFACE"
            "MODE-SWITCH-INTERFACE"
            "NV-DATA-INTERFACE"
            "PARAMETER-INTERFACE"
            "PORT-INTERFACE"
            "SENDER-RECEIVER-INTERFACE"
            "TRIGGER-INTERFACE"
        ) ;
        sh:severity sh:Violation ;
        sh:message "REQUIRED-INTERFACE-TREF@DEST must be one of the allowed interface types (including PARAMETER-INTERFACE)." ;
    ] .


# SHACL

# TPS_SWCT_01425 / TPS_SWCT_01426 / TPS_SWCT_01427 / TPS_SWCT_01428
# 这些约束涉及 RoleBasedPortAssignment 的角色语义和端口数量，
# 但当前输入未提供 RoleBasedPortAssignment 在 ATOMIC-SW-COMPONENT-TYPE /
# P-PORT-PROTOTYPE 下的完整 XML 路径及角色枚举值，因此暂不生成 SHACL。
# 逻辑由 SMT 负责。

# TPS_SWCT_01429 - [constr_1135] only applies for BITFIELD_TEXTTABLE
# 仅说明约束 1135 的适用范围，本身不对 VT/CATEGORY 施加结构性约束，故不生成 SHACL。

# TPS_SWCT_01431 - Finding the symbol for the representation of a CompuScale
# 该约束是优先级/回退逻辑（symbol/vt/shortLabel），不适合用纯 SHACL 计数表达，
# 由 SMT 负责，不生成 SHACL。

# TPS_SWCT_01432 - 运行时行为建议，不生成 SHACL。


# 1) SHACL

# TPS_SWCT_01437 - invalidValue can also be specified without setting a compuMethod
# 语义：允许 INVALID-VALUE 在没有 COMPU-METHOD-REF 的情况下存在；
# 不对 “有 INVALID-VALUE 时是否必须禁止 COMPU-METHOD-REF” 做强制约束，仅结构建模。

autosar:TPS_SWCT_01437_SwDataDefPropsContentShape
    a sh:NodeShape ;
    sh:targetClass autosar:SW-DATA-DEF-PROPS-CONTENT ;

    # COMPU-METHOD-REF：可选 0..1
    sh:property [
        sh:path autosar:COMPU-METHOD-REF ;
        sh:maxCount 1 ;
    ] ;

    # INVALID-VALUE：可选 0..1
    sh:property [
        sh:path autosar:INVALID-VALUE ;
        sh:maxCount 1 ;
    ] ;

    sh:severity sh:Info ;
    sh:message "INVALID-VALUE may be specified even if no COMPU-METHOD-REF is present (TPS_SWCT_01437)." .



# TPS_SWCT_01442 - ImplementationDataType of category TYPE_REFERENCE does not define own properties
# TPS_SWCT_01443 - ImplementationDataType of category TYPE_REFERENCE overwrites properties of refined ImplementationDataType
# 这两个约束主要是行为/继承语义，缺少可观测结构信号，这里仅对 CATEGORY 做基本建模。

autosar:TPS_SWCT_01442_01443_ImplementationDataTypeShape
    a sh:NodeShape ;
    sh:targetClass autosar:IMPLEMENTATION-DATA-TYPE ;

    sh:property [
        sh:path autosar:CATEGORY ;
        sh:maxCount 1 ;
    ] ;

    sh:severity sh:Info ;
    sh:message "For IMPLEMENTATION-DATA-TYPE of category TYPE_REFERENCE, own properties (if any) overwrite those of the refined type; if none are defined, refined type properties apply (TPS_SWCT_01442, TPS_SWCT_01443)." .


# TPS_SWCT_01444 - Size of SwBaseType is specified in bits
# 仅能从结构上约束 BASE-TYPE-SIZE / MAX-BASE-TYPE-SIZE 的存在性与计数，
# “单位为 bit” 属于语义说明，不在结构层强制。

autosar:TPS_SWCT_01444_BaseTypeDirectDefinitionShape
    a sh:NodeShape ;
    sh:targetClass autosar:BASE-TYPE-DIRECT-DEFINITION ;

    sh:property [
        sh:path autosar:BASE-TYPE-SIZE ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path autosar:MAX-BASE-TYPE-SIZE ;
        sh:maxCount 1 ;
    ] ;

    sh:severity sh:Info ;
    sh:message "BASE-TYPE-SIZE and MAX-BASE-TYPE-SIZE of BASE-TYPE-DIRECT-DEFINITION are specified in bits (TPS_SWCT_01444)." .


# 1) TPS_SWCT_01445 – Applicability of SwDataDefProps for DataPrototypes
# 该约束主要是说明性 + 依赖规范表格（5.8），缺乏可观测的形式条件，这里不生成强制 SHACL 结构约束。

# 2) TPS_SWCT_01446 – References to a DataPrototype may or may not imply the necessity for using an instanceRef
# 纯定义性说明，不生成 SHACL。

# 3) TPS_SWCT_01447 – Applicable binding times for model elements in the scope of the Software Component Template
# 文本描述 PortPrototype 的绑定时间支持范围，但未给出可直接从 XML 观测的布尔条件，不生成 SHACL。

# 4) TPS_SWCT_01448 – Pre-defined values for the category of VariationPointProxy

autosar:TPS_SWCT_01448_CategoryShape
    a sh:NodeShape ;
    sh:targetClass autosar:VARIATION-POINT-PROXY ;
    sh:severity sh:Violation ;
    sh:property [
        sh:path autosar:CATEGORY ;
        sh:in ( "VALUE" "CONDITION" ) ;
    ] .

# 其余关于 VALUE/CONDITION 下 valueAccess / postBuildValueAccess / conditionAccess /
# postBuildVariantCondition 的运行时语义（“yield integer/boolean value”、
# “and operator shall be applied” 等）属于行为层面，不在 SHACL 中建模。

# 5) TPS_SWCT_01451 – Relations between ModeTransition and ModeDeclaration
# 文本强调 ModeTransition 与 ModeDeclaration 的 1:1 关联，但在 XML 中表现为
# ENTERED-MODE-REF / EXITED-MODE-REF 的存在性与 DEST 类型。
# 1:1 关系（每个 ModeTransition 恰好一个 entered/exited）可用计数约束表达。

autosar:TPS_SWCT_01451_ModeTransitionShape
    a sh:NodeShape ;
    sh:targetClass autosar:MODE-TRANSITION ;
    sh:severity sh:Violation ;

    sh:property [
        sh:path autosar:ENTERED-MODE-REF ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path autosar:EXITED-MODE-REF ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

# DEST 类型约束（MODE-DECLARATION）由跨文件解析逻辑负责，不在 SHACL 中重复。

# 6) TPS_SWCT_01452 – Applicability of networkRepresentation for ApplicationCompositeDataType
# 文本语义：
# - 对 ApplicationPrimitiveDataType：Receiver/SenderComSpec 上可用 networkRepresentation。
# - 对 ApplicationCompositeDataType：应使用 compositeNetworkRepresentation（叶元素）。
# 需要检查 dataElement 所指向的类型是否为 ApplicationCompositeDataType，
# 这依赖跨文件类型解析和数据类型层次，超出纯路径/计数 SHACL 能力，因此不生成 SHACL。

# 7) TPS_SWCT_01453 – Software-component gets information about a specific DTC
# 文本给出 “RoleBasedPortAssignment valid roles: DiagnosticInfo [1]”，
# 但未明确约束是“唯一一个角色且值为 DiagnosticInfo”还是“至少包含一个 DiagnosticInfo”。
# 在缺乏精确定义的情况下，不生成强制 SHACL 以避免误判。


# 1) SHACL

# TPS_SWCT_01454 - PRPortPrototype can own both RPortComSpecs and PPortComSpecs
autosar:TPS_SWCT_01454
  a sh:NodeShape ;
  sh:targetClass autosar:PR-PORT-PROTOTYPE ;
  sh:severity sh:Info ;
  sh:message "PRPortPrototype can own both RPortComSpecs and PPortComSpecs at the same time (in contrast to PPortPrototype and RPortPrototype)." ;
  sh:property [
    sh:path ( autosar:PR-PORT-PROTOTYPE autosar:PROVIDED-COM-SPECS ) ;
  ] ;
  sh:property [
    sh:path ( autosar:PR-PORT-PROTOTYPE autosar:REQUIRED-COM-SPECS ) ;
  ] ;
.

# TPS_SWCT_01457 - ExclusiveAreaNestingOrder (definition / optional)
autosar:TPS_SWCT_01457
  a sh:NodeShape ;
  sh:targetClass autosar:EXCLUSIVE-AREA-NESTING-ORDER ;
  sh:severity sh:Info ;
  sh:message "Optional ExclusiveAreaNestingOrders describe possible nesting orders which can occur in the RunnableEntity; each locking situation requires its own ExclusiveAreaNestingOrder." ;
.

# TPS_SWCT_01458 - All ExclusiveAreas configured in the InternalBehavior should be referenced
# Structural part: basic typing of EXCLUSIVE-AREA-REF
autosar:TPS_SWCT_01458
  a sh:NodeShape ;
  sh:targetClass autosar:EXCLUSIVE-AREA-NESTING-ORDER ;
  sh:severity sh:Info ;
  sh:message "All ExclusiveAreas configured in the InternalBehavior should be referenced by an ExclusiveAreaNestingOrder to fully describe locking behavior for the RunnableEntity." ;
  sh:property [
    sh:path ( autosar:EXCLUSIVE-AREA-NESTING-ORDER autosar:EXCLUSIVE-AREA-REFS autosar:EXCLUSIVE-AREA-REF ) ;
    sh:node autosar:TPS_SWCT_01458_EXCLUSIVE-AREA-REF_Shape ;
  ] ;
.

autosar:TPS_SWCT_01458_EXCLUSIVE-AREA-REF_Shape
  a sh:NodeShape ;
  sh:property [
    sh:path autosar:EXCLUSIVE-AREA-REF ;
    sh:severity sh:Violation ;
    sh:message "EXCLUSIVE-AREA-REF must reference an EXCLUSIVE-AREA." ;
    # DEST typing left to SMT / external resolver
  ] ;
.

# TPS_SWCT_01459 - Locking behavior is not described for this RunnableEntity
# Purely behavioral / completeness information; no extra structural SHACL
autosar:TPS_SWCT_01459
  a sh:NodeShape ;
  sh:targetClass autosar:RUNNABLE-ENTITY ;
  sh:severity sh:Info ;
  sh:message "If ExclusiveAreas are not referenced by any ExclusiveAreaNestingOrder, locking behavior is not described for this RunnableEntity and information might be incomplete." ;
.

# TPS_SWCT_01460 - Relation of SynchronousServerCallPoint to ExclusiveAreaNestingOrder
autosar:TPS_SWCT_01460
  a sh:NodeShape ;
  sh:targetClass autosar:EXCLUSIVE-AREA-NESTING-ORDER ;
  sh:severity sh:Info ;
  sh:message "ExclusiveAreaNestingOrder can be referenced by one or several SynchronousServerCallPoints to specify the calling environment regarding ExclusiveAreas." ;
.

# TPS_SWCT_01461 - Existence of ImplementationDataType
autosar:TPS_SWCT_01461
  a sh:NodeShape ;
  sh:targetClass autosar:IMPLEMENTATION-DATA-TYPE ;
  sh:severity sh:Info ;
  sh:message "ImplementationDataTypes are not required before the RTE generation / contract phase; using only ApplicationDataTypes is feasible before that step." ;
.

# TPS_SWCT_01464 - ModeDeclaration mapping (behavioral)
autosar:TPS_SWCT_01464
  a sh:NodeShape ;
  sh:targetClass autosar:MODE-DECLARATION ;
  sh:severity sh:Info ;
  sh:message "ModeDeclaration of a mode user is mapped to exactly one ModeDeclaration of a mode manager (behavioral mapping, checked by SMT/other means)." ;
.


# 1) SHACL

# TPS_SWCT_01465
# Behavioral, temporal relation between ModeDeclarations of mode user and mode manager.
# No stable structural pattern in XML → leave SHACL empty for this constraint.


# TPS_SWCT_01466
# Behavioral, runtime behavior of ConsistencyNeeds vs implicit communication.
# No structural XML pattern that can be validated statically → leave SHACL empty.


# TPS_SWCT_01467
# ImplementationDataType references an SwBaseType with a string encoding
# Expression talks about numeric vs string encoding of initValue, not about XML structure.
# No reliable structural condition derivable → SHACL left empty.


# TPS_SWCT_01469
# RTE API for retrieving the current activation reason
# Purely about RTE generator capability, not XML structure → SHACL left empty.


# TPS_SWCT_01472
# Receiving SwComponentType owns a DataPrototypeGroup in the role dpgRequiresCoherence
# Behavioral (age/coherence of values), no static XML structure beyond presence of ConsistencyNeeds.
# Presence itself is not forbidden/required by the text → SHACL left empty.


# TPS_SWCT_01473
# Receiving SwComponentType owns a RunnableEntityGroup in the role regRequiresStability
# Behavioral (stability of implicitly communicated values), no static XML structure constraint.
# SHACL left empty.


# TPS_SWCT_01474
# RunnableEntityGroup regRequiresStability + DataPrototypeGroups dpgRequiresCoherence
# Behavioral (coherence + stability), no additional static XML structure constraint.
# SHACL left empty.


#################################################################
# SHACL shapes
#################################################################

######## TPS_SWCT_01475
# Sending SwComponentType owns a DataPrototypeGroup in the role dpgRequiresCoherence
# → 纯行为/时序语义，缺乏可观测结构信号，这里不建 SHACL 结构约束
#   由 SMT 负责高层逻辑（可选）

######## TPS_SWCT_01476
# Sender and receiver of the same implicitly communicated VariableDataPrototypes
# are associated with the same RunnableEntity Group
# → 运行时/调度与可见性语义，无稳定结构路径，这里不建 SHACL

######## TPS_SWCT_01479
# Applicability of ConsistencyNeeds
# “ConsistencyNeeds can only be applied to RunnableEntitys that make use of implicit communication.”
# → 缺少“implicit communication”可观测结构信号，不建 SHACL

######## TPS_SWCT_01480
# Stability and/or coherence is not required
# 描述 dpgDoesNotRequireCoherence / regDoesNotRequireStability 两个角色的存在方式，
# 但未给出额外结构约束（如互斥/必选），因此不建 SHACL 计数约束

######## TPS_SWCT_01483
# Use static and constant memory to support Measurement and Calibration
# 仅为工具行为建议，不对模型结构提出硬性约束，不建 SHACL

######## TPS_SWCT_01485
# The order of RuleArguments arguments shall be respected
# 顺序语义由数组顺序天然保证，无额外结构约束，不建 SHACL

######## TPS_SWCT_01486
# ApplicationPrimitiveDataType of category STRING may have invalidValue
# 结构上仅说明“允许”，不强制存在或禁止其他情况，SHACL 不施加硬性约束


# 1) TPS_SWCT_01487 – Correspondence of invalidValue for ApplicationPrimitiveDataType and ImplementationDataType
# 仅结构信息可见：ApplicationPrimitiveDataType 具有 SW-DATA-DEF-PROPS
autosar:TPS_SWCT_01487_Shape
    a sh:NodeShape ;
    sh:severity sh:Violation ;
    sh:targetClass autosar:APPLICATION-PRIMITIVE-DATA-TYPE ;
    sh:property [
        sh:path ( autosar:APPLICATION-PRIMITIVE-DATA-TYPE autosar:SW-DATA-DEF-PROPS ) ;
        sh:maxCount 1
    ] .

# 2) TPS_SWCT_01488 – ApplicationPrimitiveDataType interpreted as string of particular encoding
# 结构层面：存在 swDataDefProps.swTextProps.baseTypeRef 指向 SW-BASE-TYPE，
# 且该 SwBaseType 的 BASE-TYPE-DIRECT-DEFINITION/BASE-TYPE-ENCODING 存在
autosar:TPS_SWCT_01488_Shape
    a sh:NodeShape ;
    sh:severity sh:Info ;
    sh:targetClass autosar:APPLICATION-PRIMITIVE-DATA-TYPE ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "If an ApplicationPrimitiveDataType shall be interpreted as a string of a particular encoding it shall reference swDataDefProps.swTextProps.baseType and the relevant attribute is BaseTypeDirectDefinition.baseTypeEncoding." ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>

            SELECT ?this
            WHERE {
              ?this a autosar:APPLICATION-PRIMITIVE-DATA-TYPE .

              # swDataDefProps
              OPTIONAL {
                ?this autosar:SW-DATA-DEF-PROPS ?swProps .
                ?swProps autosar:SW-TEXT-PROPS ?swTextProps .
                ?swTextProps autosar:BASE-TYPE-REF ?baseTypeRef .
              }

              # If there is a BASE-TYPE-REF, then there shall be a BASE-TYPE-ENCODING on the referenced base type
              FILTER(BOUND(?baseTypeRef))

              # We cannot follow cross-file reference here in pure SHACL Core; this is an informational check only.
            }
        """ ;
        sh:severity sh:Info
    ] .

# 3) TPS_SWCT_01490 – ApplicationErrors only for ClientServerInterfaces
autosar:TPS_SWCT_01490_Shape
    a sh:NodeShape ;
    sh:severity sh:Violation ;
    sh:targetClass autosar:APPLICATION-ERROR ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "APPLICATION-ERROR shall only be used in the context of ClientServerInterfaces." ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>

            SELECT ?this
            WHERE {
              ?this a autosar:APPLICATION-ERROR .
              # Context relation to CLIENT-SERVER-INTERFACE is model-dependent and not expressed structurally here.
            }
        """ ;
        sh:severity sh:Violation
    ] .

# 4) TPS_SWCT_01492 – Default values for factorSiToUnit and offsetSiToUnit
# 仅当显式给出时检查其值
autosar:TPS_SWCT_01492_Shape
    a sh:NodeShape ;
    sh:severity sh:Info ;
    sh:targetClass autosar:UNIT ;
    sh:property [
        sh:path ( autosar:UNIT autosar:FACTOR-SI-TO-UNIT ) ;
        sh:datatype xsd:float
    ] ;
    sh:property [
        sh:path ( autosar:UNIT autosar:OFFSET-SI-TO-UNIT ) ;
        sh:datatype xsd:float
    ] .

# 5) TPS_SWCT_01493 – Number of RuleArguments.arguments vs array size
# 行为性约束，SHACL 无法直接访问“数组大小”，仅给出结构信息
autosar:TPS_SWCT_01493_Shape
    a sh:NodeShape ;
    sh:severity sh:Info ;
    sh:targetClass autosar:RULE-ARGUMENTS ;
    sh:property [
        sh:path ( autosar:RULE-ARGUMENTS autosar:V ) ;
    ] ;
    sh:property [
        sh:path ( autosar:RULE-ARGUMENTS autosar:VF ) ;
    ] ;
    sh:property [
        sh:path ( autosar:RULE-ARGUMENTS autosar:VT ) ;
    ] ;
    sh:property [
        sh:path ( autosar:RULE-ARGUMENTS autosar:VTF ) ;
    ] .

# 6) TPS_SWCT_01494 – FILL_UNTIL_END rule semantics
# 行为性约束，SHACL 仅标记结构
autosar:TPS_SWCT_01494_Shape
    a sh:NodeShape ;
    sh:severity sh:Info ;
    sh:targetClass autosar:RULE-BASED-VALUE-SPECIFICATION ;
    sh:property [
        sh:path ( autosar:RULE-BASED-VALUE-SPECIFICATION autosar:RULE ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .


#################################################################
# SHACL for TPS_SWCT_01495 – Standardized value of RULE
#################################################################

autosar:TPS_SWCT_01495_RuleBasedValueSpecification_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:RULE-BASED-VALUE-SPECIFICATION ;
    sh:property [
        sh:path autosar:RULE ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string
    ] .


#################################################################
# SHACL for TPS_SWCT_01502 – Precedence of the Unit of the input axis
#################################################################

autosar:TPS_SWCT_01502_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:SW-AXIS-INDIVIDUAL ;

    # SwAxisIndividual.unit
    sh:property [
        sh:path autosar:UNIT-REF ;
        sh:severity sh:Violation ;
    ] ;

    # SwAxisIndividual.compuMethod
    sh:property [
        sh:path autosar:COMPU-METHOD-REF ;
        sh:severity sh:Violation ;
    ] ;

    # SwAxisIndividual.inputVariableType
    sh:property [
        sh:path autosar:INPUT-VARIABLE-TYPE-REF ;
        sh:severity sh:Violation ;
    ] ;

    # SwAxisIndividual.swVariableRef (container)
    sh:property [
        sh:path autosar:SW-VARIABLE-REFS ;
        sh:severity sh:Violation ;
    ] .

#################################################################
# SHACL for TPS_SWCT_01503 – Precedence of the DataConstr of the input axis
#################################################################

autosar:TPS_SWCT_01503_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:SW-AXIS-INDIVIDUAL ;

    # SwAxisIndividual.dataConstr
    sh:property [
        sh:path autosar:DATA-CONSTR-REF ;
        sh:severity sh:Violation ;
    ] ;

    # SwAxisIndividual.inputVariableType
    sh:property [
        sh:path autosar:INPUT-VARIABLE-TYPE-REF ;
        sh:severity sh:Violation ;
    ] ;

    # SwAxisIndividual.swVariableRef (container)
    sh:property [
        sh:path autosar:SW-VARIABLE-REFS ;
        sh:severity sh:Violation ;
    ] .

#################################################################
# SHACL for TPS_SWCT_01505 – Precedence of calibration access along structure hierarchies
# (no stable structural hooks given – handled in SMT only)
#################################################################

# intentionally no SHACL shape generated

#################################################################
# SHACL for TPS_SWCT_01506 – Precedence of the calibration access of input axis
#################################################################

# This is a precedence rule between SwDataDefProps.swCalibrationAccess
# and SwCalprmAxis.swCalibrationAccess. No direct structural “must exist”
# constraint beyond basic typing, so SHACL is left empty and SMT handles logic.

# intentionally no SHACL shape generated

#################################################################
# SHACL for TPS_SWCT_01508 – Scope of end-to-end protection
#################################################################

# Behavioral / scope statement only – no structural constraint.

# intentionally no SHACL shape generated

#################################################################
# SHACL for TPS_SWCT_01511 – Configuration option is encoded into ModeDeclaration
#################################################################

autosar:TPS_SWCT_01511_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:MODE-DECLARATION ;

    # At least one MODE-DECLARATION must exist in MODE-DECLARATIONS of the group.
    # The precedence / encoding semantics are handled in SMT.
    sh:severity sh:Info .

#################################################################
# SHACL for TPS_SWCT_01512 – Request change of Pretended Networking mode
#################################################################

# Relationship / behavioral requirement; concrete structural pattern
# (which PPortPrototype, which interface) is not fully specified here.
# Leave to SMT / higher-level checks.

# intentionally no SHACL shape generated


# 1) SHACL

#################################################################
# TPS_SWCT_01513 - React on the change of Pretended Networking mode
# 语义：需要对 Pretended Networking 模式变化作出反应的 SwComponentType
#       应提供一个 RPortPrototype，其 REQUIRED-INTERFACE-TREF 指向 MODE-SWITCH-INTERFACE。
# 结构信息仅建模 R-PORT-PROTOTYPE/REQUIRED-INTERFACE-TREF 的 DEST 约束。
#################################################################

autosar:TPS_SWCT_01513_RequiredInterfaceShape
    a sh:NodeShape ;
    sh:targetClass autosar:R-PORT-PROTOTYPE ;
    sh:property [
        sh:path autosar:REQUIRED-INTERFACE-TREF ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            "CLIENT-SERVER-INTERFACE"
            "DATA-INTERFACE"
            "MODE-SWITCH-INTERFACE"
            "NV-DATA-INTERFACE"
            "PARAMETER-INTERFACE"
            "PORT-INTERFACE"
            "SENDER-RECEIVER-INTERFACE"
            "TRIGGER-INTERFACE"
        ) ;
        sh:severity sh:Violation ;
        sh:message "REQUIRED-INTERFACE-TREF must exist exactly once and its DEST must be one of the allowed interface types (including MODE-SWITCH-INTERFACE)." ;
    ] .

#################################################################
# TPS_SWCT_01514 - Duplicate existence of enhancedModeApi in PRPortPrototype context
# 语义：若 ENHANCED-MODE-API 在 PRPortPrototype 所拥有的 ModeSwitchReceiverComSpec 中被定义，其值应被忽略。
# 结构：仅建模 ENHANCED-MODE-API 的类型与可选性。
#################################################################

autosar:TPS_SWCT_01514_EnhancedModeApiShape
    a sh:NodeShape ;
    sh:targetClass autosar:MODE-SWITCH-RECEIVER-COM-SPEC ;
    sh:property [
        sh:path autosar:ENHANCED-MODE-API ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:severity sh:Info ;
        sh:message "If ENHANCED-MODE-API is defined in a ModeSwitchReceiverComSpec owned by a PR-PORT-PROTOTYPE, its value is ignored (behavioral, not structurally enforced)." ;
    ] .

#################################################################
# TPS_SWCT_01515 - PPortInCompositionInstanceRef shall be used
# 语义：用于将 DelegationSwConnector 附着到内部 PRPortPrototype 时，应使用 PPortInCompositionInstanceRef。
# 无稳定 XML 路径信息可建模，留给 SMT。
#################################################################

# (no SHACL shape – handled by SMT only)

#################################################################
# TPS_SWCT_01516 - PortInterface describes static structure
# 语义性/定义性描述，不做结构约束。
#################################################################

# (no SHACL shape – definition only, no structural constraint)

#################################################################
# TPS_SWCT_01517 - ClientServerOperation cannot be passed as a reference
# 语义：ArgumentDataPrototype 的 TYPE-TREF 不得引用 ClientServerOperation。
# 结构：仅建模 TYPE-TREF 的存在性与 DEST 候选集合（不含 ClientServerOperation）。
#################################################################

autosar:TPS_SWCT_01517_TypeRefShape
    a sh:NodeShape ;
    sh:targetClass autosar:ARGUMENT-DATA-PROTOTYPE ;
    sh:property [
        sh:path autosar:TYPE-TREF ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in (
            "APPLICATION-ARRAY-DATA-TYPE"
            "APPLICATION-COMPOSITE-DATA-TYPE"
            "APPLICATION-DATA-TYPE"
            "APPLICATION-PRIMITIVE-DATA-TYPE"
            "APPLICATION-RECORD-DATA-TYPE"
            "AUTOSAR-DATA-TYPE"
            "IMPLEMENTATION-DATA-TYPE"
        ) ;
        sh:severity sh:Violation ;
        sh:message "TYPE-TREF of ARGUMENT-DATA-PROTOTYPE must exist exactly once and must refer to a data type (not to a CLIENT-SERVER-OPERATION)." ;
    ] .

#################################################################
# TPS_SWCT_01518 - Priority of initial value definition
# 语义：低优先级概念层上的初始值被忽略。运行时/语义性，不做结构约束。
#################################################################

# (no SHACL shape – behavioral, handled by SMT or runtime)

#################################################################
# TPS_SWCT_01519 - RTE executes certain RunnableEntity periodically
# 语义：若 SwcInternalBehavior 要求 RTE 周期性执行某 RunnableEntity，则需定义 TimingEvent，
#       该 TimingEvent 必须有 PERIOD，并通过 START-ON-EVENT-REF 指向该 RunnableEntity。
# 结构：对 TIMING-EVENT 的 PERIOD 和 START-ON-EVENT-REF 做 if-present-then-type 约束。
#################################################################

autosar:TPS_SWCT_01519_TimingEventShape
    a sh:NodeShape ;
    sh:targetClass autosar:TIMING-EVENT ;
    sh:property [
        sh:path autosar:PERIOD ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "TIMING-EVENT must define a PERIOD when used for periodic execution of a RunnableEntity." ;
    ] ;
    sh:property [
        sh:path autosar:START-ON-EVENT-REF ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "If present, START-ON-EVENT-REF of TIMING-EVENT must refer to a RUNNABLE-ENTITY." ;
    ] .


# 1) TPS_SWCT_01520 - Implication of the existence of possibleError on compatibility of ClientServerOperations
# 仅能在结构上约束 POSSIBLE-ERROR-REF 的类型；兼容性逻辑交由 SMT 处理

autosar:TPS_SWCT_01520 a sh:NodeShape ;
  sh:targetClass autosar:CLIENT-SERVER-OPERATION ;
  sh:property [
    sh:path ( autosar:POSSIBLE-ERROR-REFS autosar:POSSIBLE-ERROR-REF ) ;
    sh:class autosar:APPLICATION-ERROR
  ] ;
  sh:severity sh:Violation .

# 2) TPS_SWCT_01521 - Use AutosarVariableRef.localVariable for referencing inter-runnable variables
# 结构层面：确保 ACCESSED-VARIABLE 存在且为 AUTOSAR-VARIABLE-REF，并可引用 LOCAL-VARIABLE-REF
# “在 writtenLocalVariable/readLocalVariable 角色时必须使用 localVariable” 的条件逻辑交由 SMT

autosar:TPS_SWCT_01521 a sh:NodeShape ;
  sh:targetClass autosar:RUNNABLE-ENTITY ;
  sh:property [
    sh:path ( autosar:READ-LOCAL-VARIABLES autosar:VARIABLE-ACCESS ) ;
    sh:class autosar:VARIABLE-ACCESS
  ] ;
  sh:property [
    sh:path ( autosar:WRITTEN-LOCAL-VARIABLES autosar:VARIABLE-ACCESS ) ;
    sh:class autosar:VARIABLE-ACCESS
  ] .

autosar:TPS_SWCT_01521_VariableAccess a sh:NodeShape ;
  sh:targetClass autosar:VARIABLE-ACCESS ;
  sh:property [
    sh:path autosar:ACCESSED-VARIABLE ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class autosar:AUTOSAR-VARIABLE-REF
  ] .

autosar:TPS_SWCT_01521_AutosarVariableRef a sh:NodeShape ;
  sh:targetClass autosar:AUTOSAR-VARIABLE-REF ;
  sh:property [
    sh:path autosar:LOCAL-VARIABLE-REF ;
    sh:class autosar:VARIABLE-DATA-PROTOTYPE
  ] .

# 3) TPS_SWCT_01522 - No initial value is specified for implicitInterRunnableVariable or explicitInterRunnableVariable
# 结构层面：建模 INIT-VALUE 的可选性；“未初始化即读取行为未定义”为运行时语义，不在 SHACL 中强制

autosar:TPS_SWCT_01522_ExplicitIRV a sh:NodeShape ;
  sh:targetClass autosar:VARIABLE-DATA-PROTOTYPE ;
  sh:property [
    sh:path autosar:INIT-VALUE
  ] ;
  sh:severity sh:Info .

# 4) TPS_SWCT_01523 - Internal trigger event
# 语义主体：InternalTriggerOccurredEvent（由 expression/title 判定）
# 要求：必须引用 InternalTriggeringPoint，可选引用 RunnableEntity

autosar:TPS_SWCT_01523 a sh:NodeShape ;
  sh:targetClass autosar:INTERNAL-TRIGGER-OCCURRED-EVENT ;
  sh:property [
    sh:path autosar:EVENT-SOURCE-REF ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class autosar:INTERNAL-TRIGGERING-POINT
  ] ;
  sh:property [
    sh:path autosar:START-ON-EVENT-REF ;
    sh:class autosar:RUNNABLE-ENTITY
  ] ;
  sh:severity sh:Violation .

# 5) TPS_SWCT_01524 - Usage of IoHwAbstractionServerAnnotation
# 仅能在结构上声明目标类；“不得用于 NvDataInterface” 需结合 PortInterface 类型，交由 SMT/SPARQL

autosar:TPS_SWCT_01524 a sh:NodeShape ;
  sh:targetClass autosar:IO-HW-ABSTRACTION-SERVER-ANNOTATION ;
  sh:severity sh:Violation .

# 6) TPS_SWCT_01525 - InitEvent references a RunnableEntity in the role startOnEvent
# 语义主体：InitEvent；要求可引用 RunnableEntity（可选）

autosar:TPS_SWCT_01525 a sh:NodeShape ;
  sh:targetClass autosar:INIT-EVENT ;
  sh:property [
    sh:path autosar:START-ON-EVENT-REF ;
    sh:class autosar:RUNNABLE-ENTITY
  ] ;
  sh:severity sh:Info .

# 7) TPS_SWCT_01529 - Default value for EndToEndDescription.dataIdNibbleOffset
# SHACL 无法表达“默认值假定”，仅建模结构；条件默认逻辑交由 SMT

autosar:TPS_SWCT_01529 a sh:NodeShape ;
  sh:targetClass autosar:END-TO-END-DESCRIPTION ;
  sh:property [
    sh:path autosar:CATEGORY
  ] ;
  sh:property [
    sh:path autosar:DATA-ID-MODE
  ] ;
  sh:property [
    sh:path autosar:DATA-ID-NIBBLE-OFFSET
  ] ;
  sh:severity sh:Info .


# 1) SHACL

#################################################################
# TPS_SWCT_01530 - Error behavior of mode manager and mode user
#################################################################

autosar:TPS_SWCT_01530_ModeDeclarationGroup_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:MODE-DECLARATION-GROUP ;

    # Optional MODE-MANAGER-ERROR-BEHAVIOR of type MODE-ERROR-BEHAVIOR
    sh:property [
        sh:path autosar:MODE-MANAGER-ERROR-BEHAVIOR ;
        sh:maxCount 1 ;
        sh:class autosar:MODE-ERROR-BEHAVIOR ;
        sh:severity sh:Info ;
        sh:message "Mode manager error behavior can be defined via MODE-MANAGER-ERROR-BEHAVIOR." ;
    ] ;

    # Optional MODE-USER-ERROR-BEHAVIOR of type MODE-ERROR-BEHAVIOR
    sh:property [
        sh:path autosar:MODE-USER-ERROR-BEHAVIOR ;
        sh:maxCount 1 ;
        sh:class autosar:MODE-ERROR-BEHAVIOR ;
        sh:severity sh:Info ;
        sh:message "Mode user error behavior can be defined via MODE-USER-ERROR-BEHAVIOR." ;
    ] ;
.

#################################################################
# TPS_SWCT_01532 - The role of ModeErrorBehavior.defaultMode
#################################################################

autosar:TPS_SWCT_01532_ModeErrorBehavior_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:MODE-ERROR-BEHAVIOR ;

    # ERROR-REACTION-POLICY is mandatory and single-valued
    sh:property [
        sh:path autosar:ERROR-REACTION-POLICY ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "ERROR-REACTION-POLICY of MODE-ERROR-BEHAVIOR shall be present exactly once." ;
    ] ;

    # DEFAULT-MODE-REF is optional cross-file reference to MODE-DECLARATION
    sh:property [
        sh:path autosar:DEFAULT-MODE-REF ;
        sh:maxCount 1 ;
        sh:severity sh:Info ;
        sh:message "DEFAULT-MODE-REF identifies the ModeDeclaration if ERROR-REACTION-POLICY is set to defaultMode." ;
    ] ;
.

#################################################################
# TPS_SWCT_01533 - initialMode assumed if no modeManagerErrorBehavior
#################################################################

autosar:TPS_SWCT_01533_ModeDeclarationGroup_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:MODE-DECLARATION-GROUP ;

    # INITIAL-MODE-REF mandatory, single-valued, cross-file reference to MODE-DECLARATION
    sh:property [
        sh:path autosar:INITIAL-MODE-REF ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "MODE-DECLARATION-GROUP shall define INITIAL-MODE-REF." ;
    ] ;

    # MODE-MANAGER-ERROR-BEHAVIOR optional, single-valued
    sh:property [
        sh:path autosar:MODE-MANAGER-ERROR-BEHAVIOR ;
        sh:maxCount 1 ;
        sh:severity sh:Info ;
        sh:message "If MODE-MANAGER-ERROR-BEHAVIOR is absent, INITIAL-MODE-REF is assumed as applicable mode in case of manager/user desynchronization." ;
    ] ;
.

#################################################################
# TPS_SWCT_01534 - initialMode assumed if no modeUserErrorBehavior
#################################################################

autosar:TPS_SWCT_01534_ModeDeclarationGroup_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:MODE-DECLARATION-GROUP ;

    # INITIAL-MODE-REF mandatory, single-valued, cross-file reference to MODE-DECLARATION
    sh:property [
        sh:path autosar:INITIAL-MODE-REF ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "MODE-DECLARATION-GROUP shall define INITIAL-MODE-REF." ;
    ] ;

    # MODE-USER-ERROR-BEHAVIOR optional, single-valued
    sh:property [
        sh:path autosar:MODE-USER-ERROR-BEHAVIOR ;
        sh:maxCount 1 ;
        sh:severity sh:Info ;
        sh:message "If MODE-USER-ERROR-BEHAVIOR is absent, INITIAL-MODE-REF is assumed as applicable mode in case of user/manager desynchronization." ;
    ] ;
.

#################################################################
# TPS_SWCT_01537 - GID synchronization roles for DoIpGidSynchronizationNeeds
#################################################################

autosar:TPS_SWCT_01537_DoIpGidSynchronizationNeeds_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:DO-IP-GID-SYNCHRONIZATION-NEEDS ;

    # SERVICE-NEEDS presence is structural on SWC-SERVICE-DEPENDENCY, not on DO-IP-GID-SYNCHRONIZATION-NEEDS itself,
    # so no direct SHACL path here for that part.

    # ROLE in ROLE-BASED-PORT-ASSIGNMENT is constrained via SMT (valid role name),
    # SHACL only captures basic structure if needed.
.

#################################################################
# TPS_SWCT_01538 - GID roles for DoIpGidNeeds
#################################################################

autosar:TPS_SWCT_01538_DoIpGidNeeds_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:DO-IP-GID-NEEDS ;

    # Similar to TPS_SWCT_01537: structural constraints handled elsewhere.
.


#################################################################
# SHACL shapes
#################################################################

# TPS_SWCT_01539
# ServiceNeeds kind DoIpPowerModeStatusNeeds
# RoleBasedPortAssignment valid roles: CallbackGetPowerMode [1]

autosar:TPS_SWCT_01539_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:DO-IP-POWER-MODE-STATUS-NEEDS ;

    # ServiceNeeds kind DoIpPowerModeStatusNeeds
    sh:property [
        sh:path ( autosar:SWC-SERVICE-DEPENDENCY autosar:SERVICE-NEEDS ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    # RoleBasedPortAssignment valid roles: CallbackGetPowerMode [1]
    sh:property [
        sh:path ( autosar:ROLE-BASED-PORT-ASSIGNMENT autosar:ROLE ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "CallbackGetPowerMode" ) ;
    ] ;

    sh:severity sh:Violation
.

# TPS_SWCT_01540
# ServiceNeeds kind DoIpRoutingActivationAuthenticationNeeds [0..1]
# RoleBasedPortAssignment valid roles: RoutingActivation [1]

autosar:TPS_SWCT_01540_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:DO-IP-ROUTING-ACTIVATION-AUTHENTICATION-NEEDS ;

    # ServiceNeeds kind DoIpRoutingActivationAuthenticationNeeds [0..1]
    sh:property [
        sh:path ( autosar:SWC-SERVICE-DEPENDENCY autosar:SERVICE-NEEDS ) ;
        sh:maxCount 1 ;
    ] ;

    # RoleBasedPortAssignment valid roles: RoutingActivation [1]
    sh:property [
        sh:path ( autosar:ROLE-BASED-PORT-ASSIGNMENT autosar:ROLE ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "RoutingActivation" ) ;
    ] ;

    sh:severity sh:Violation
.

# TPS_SWCT_01543
# PortInterfaceMapping overrides all other compatibility rules
# (behavioral / semantic, no stable structural pattern -> no SHACL)

# TPS_SWCT_01544
# prefix used for the actual name of the used PortInterface for the routing activation
# (naming relation between PortInterface.shortName and enclosing SwcServiceDependency.shortName;
#  cross-element string relation -> left to SMT, no SHACL here)

# TPS_SWCT_01545
# ModeDeclaration of a mode user that is not mapped to a ModeDeclaration of a mode manager is still valid
# (purely behavioral / runtime semantics -> no SHACL)

# TPS_SWCT_01546
# ServiceNeeds kind DoIpActivationLineNeeds
# RoleBasedPortAssignment valid roles: DoIPActivationLineStatus [1]

autosar:TPS_SWCT_01546_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:DO-IP-ACTIVATION-LINE-NEEDS ;

    # ServiceNeeds kind DoIpActivationLineNeeds
    sh:property [
        sh:path ( autosar:SWC-SERVICE-DEPENDENCY autosar:SERVICE-NEEDS ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    # RoleBasedPortAssignment valid roles: DoIPActivationLineStatus [1]
    sh:property [
        sh:path ( autosar:ROLE-BASED-PORT-ASSIGNMENT autosar:ROLE ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "DoIPActivationLineStatus" ) ;
    ] ;

    sh:severity sh:Violation
.

# TPS_SWCT_01547
# ServiceNeeds kind WarningIndicatorRequestedBitNeeds
# RoleBasedPortAssignment valid roles: EventStatus [1]

autosar:TPS_SWCT_01547_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:WARNING-INDICATOR-REQUESTED-BIT-NEEDS ;

    # ServiceNeeds kind WarningIndicatorRequestedBitNeeds
    sh:property [
        sh:path ( autosar:SWC-SERVICE-DEPENDENCY autosar:SERVICE-NEEDS ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    # RoleBasedPortAssignment valid roles: EventStatus [1]
    sh:property [
        sh:path ( autosar:ROLE-BASED-PORT-ASSIGNMENT autosar:ROLE ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "EventStatus" ) ;
    ] ;

    sh:severity sh:Violation
.


# 1) TPS_SWCT_01548 - Limits of a CompuMethod
# 语义是行为性说明（“逻辑上代表转换前的限制值”），无可观测结构约束 → 不生成 SHACL

# 2) TPS_SWCT_01551 - Mapping of elements on the sender side to elements on the receiver side
# 仅说明 swImplPolicy=queued 时的兼容性要求，未给出可观测结构/取值约束 → 不生成 SHACL

# 3) TPS_SWCT_01552 - Software-component acts as a mode manager
# 仅给出“有效角色”列表（AppModeInterface[1]），但未给出可观测的结构模式（如在哪个元素上计数、如何识别“acts as a mode manager”） → 不生成 SHACL

# 4) TPS_SWCT_01553 - Software-component acts as a mode user
# 同上，缺少可观测结构模式 → 不生成 SHACL

# 5) TPS_SWCT_01554 - Software-component acts as a mode requester
# 同上，缺少可观测结构模式 → 不生成 SHACL

# 6) TPS_SWCT_01556 - Rule for setting RoleBasedPortAssignment.role
# 约束核心是跨文件值相等（role 等于某 PortInterface.shortName），结构上无额外限制 → 不生成 SHACL

# 7) TPS_SWCT_01557 - dataWriteAccess also allows for the definition of a DataWriteCompletedEvent
# 语义是“允许”而非“必须”，且未给出 if-then 结构性约束（例如“若存在 dataWriteAccess 则必须存在某类 DataWriteCompletedEvent”） → 不生成 SHACL


#################################################################
# SHACL shapes
#################################################################

######## TPS_SWCT_01558  ########################################
# DataWriteCompletedEvent cannot be combined with a WaitPoint

autosar:TPS_SWCT_01558
    a sh:NodeShape ;
    sh:targetClass autosar:DATA-WRITE-COMPLETED-EVENT ;
    sh:severity sh:Violation ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A DATA-WRITE-COMPLETED-EVENT shall not be used as TRIGGER-REF of any WAIT-POINT." ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>

            SELECT ?this
            WHERE {
              ?waitPoint autosar:TRIGGER-REF ?this .
              ?waitPoint ^autosar:WAIT-POINT ?waitPointsWrapper .
              ?waitPointsWrapper ^autosar:WAIT-POINTS ?runnable .
              ?this a autosar:DATA-WRITE-COMPLETED-EVENT .
            }
        """ ;
    ] .

######## TPS_SWCT_01559  ########################################
# Default value for attribute SwDataDefProps.swCalibrationAccess
# (default value is not a structural constraint – no SHACL)

######## TPS_SWCT_01560  ########################################
# Supported categories of CompuMethods for data conversion
# (semantic / behavioral, not structurally enforceable – no SHACL)

######## TPS_SWCT_01561  ########################################
# Application of data conversion to composite AutosarDataTypes
# (behavioral, not structurally enforceable – no SHACL)

######## TPS_SWCT_01562  ########################################
# Specification of values of an enumeration
# (behavioral, not structurally enforceable – no SHACL)

######## TPS_SWCT_01563  ########################################
# Applicable values for nativeDeclaration
# (free-text C type restriction – no stable structural SHACL)

######## TPS_SWCT_01566  ########################################
# Define literals for an MCD system in the context of a FlatInstanceDescriptor
# (conditional / behavioral, cross-objects – no SHACL)


#################################################################
# SHACL for TPS_SWCT_01567 - Default behavior for invalidationPolicy
#################################################################

autosar:TPS_SWCT_01567_DefaultBehaviorForInvalidationPolicy
    a sh:NodeShape ;
    sh:targetClass autosar:NV-DATA-INTERFACE ;
    sh:severity sh:Info ;
    sh:message "For VariableDataPrototypes and ParameterDataPrototypes in the context of NvDataInterface respectively ParameterInterface, the invalidationPolicy is treated like 'Invalidation is switched off' (dontInvalidate)." ;
    sh:property [
        sh:path ( autosar:SENDER-RECEIVER-INTERFACE autosar:INVALIDATION-POLICYS autosar:INVALIDATION-POLICY ) ;
    ] .

#################################################################
# SHACL for TPS_SWCT_01570 - DataTypeMap mandatory
#################################################################

autosar:TPS_SWCT_01570_DataTypeMapMandatory
    a sh:NodeShape ;
    sh:targetClass autosar:DATA-TYPE-MAP ;
    sh:severity sh:Violation ;
    sh:message "The definition of a DataTypeMap is mandatory even if an ImplementationDataType has been derived from an ApplicationPrimitiveDataType that defines a SwRecordLayout." .

#################################################################
# SHACL for TPS_SWCT_01572 - ModeSwitchInterface.isService = false
#################################################################

autosar:TPS_SWCT_01572_ModeManagerBswMAndApps
    a sh:NodeShape ;
    sh:targetClass autosar:MODE-SWITCH-INTERFACE ;
    sh:severity sh:Info ;
    sh:message "For an Application Mode Manager that interacts with both BswM and other ApplicationSwComponentTypes, the value of ModeSwitchInterface.isService shall be set to false." ;
    sh:property [
        sh:path autosar:IS-SERVICE ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean
    ] .

#################################################################
# SHACL for TPS_SWCT_01573 - PRPortPrototype never considered unconnected
#################################################################

autosar:TPS_SWCT_01573_PRPortNeverUnconnected
    a sh:NodeShape ;
    sh:targetClass autosar:PR-PORT-PROTOTYPE ;
    sh:severity sh:Info ;
    sh:message "A PRPortPrototype is never considered unconnected, even if there are no SwConnectors actually referring to it." .

#################################################################
# SHACL for TPS_SWCT_01574 - PerInstanceMemory.typeDefinition no function pointer
#################################################################

autosar:TPS_SWCT_01574_PimTypeDefinitionNoFunctionPointer
    a sh:NodeShape ;
    sh:targetClass autosar:PER-INSTANCE-MEMORY ;
    sh:severity sh:Violation ;
    sh:message "The attribute PerInstanceMemory.typeDefinition is not allowed to contain a function pointer." ;
    sh:property [
        sh:path autosar:TYPE-DEFINITION ;
        sh:minCount 1 ;
        sh:datatype xsd:string
    ] .

#################################################################
# SHACL for TPS_SWCT_01577 - DiagnosticCommunicationManagerNeeds.serviceRequestCallbackType
#################################################################

autosar:TPS_SWCT_01577_DcmNeedsServiceRequestCallbackType
    a sh:NodeShape ;
    sh:targetClass autosar:DIAGNOSTIC-COMMUNICATION-MANAGER-NEEDS ;
    sh:severity sh:Violation ;
    sh:message "DiagnosticCommunicationManagerNeeds.serviceRequestCallbackType shall be set to the value requestCallbackTypeManufacturer." ;
    sh:property [
        sh:path autosar:SERVICE-REQUEST-CALLBACK-TYPE ;
        sh:datatype autosar:DIAGNOSTIC-SERVICE-REQUEST-CALLBACK-TYPE-ENUM
    ] .


# 1) TPS_SWCT_01578 – serviceRequestCallbackType fixed value

autosar:TPS_SWCT_01578_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:ATOMIC-SW-COMPONENT-TYPE ;
    sh:severity sh:Violation ;
    sh:property [
        sh:name "serviceRequestCallbackType" ;
        sh:path ( autosar:DIAGNOSTIC-COMMUNICATION-MANAGER-NEEDS autosar:SERVICE-REQUEST-CALLBACK-TYPE ) ;
        sh:hasValue autosar:requestCallbackTypeSupplier
    ] .

# 2) TPS_SWCT_01579 – SenderReceiverInterface may set isService to FALSE

autosar:TPS_SWCT_01579_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:SENDER-RECEIVER-INTERFACE ;
    sh:severity sh:Info ;
    sh:property [
        sh:name "isService" ;
        sh:path autosar:IS-SERVICE ;
        sh:datatype xsd:boolean
    ] .

# 3) TPS_SWCT_01580 – SenderReceiverInterface may set isService to FALSE (Dem case)

autosar:TPS_SWCT_01580_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:SENDER-RECEIVER-INTERFACE ;
    sh:severity sh:Info ;
    sh:property [
        sh:name "isService" ;
        sh:path autosar:IS-SERVICE ;
        sh:datatype xsd:boolean
    ] .

# 4) TPS_SWCT_01583 – CompuMethod category BITFIELD_TEXTTABLE (no completeness requirement)

autosar:TPS_SWCT_01583_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:COMPU-METHOD ;
    sh:severity sh:Info ;
    sh:property [
        sh:name "category" ;
        sh:path autosar:CATEGORY ;
        sh:datatype xsd:string
    ] .

# 5) TPS_SWCT_01584 – NvBlockNeeds writing strategy flags and disabledMode irefs

autosar:TPS_SWCT_01584_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:INTERNAL-BEHAVIOR ;
    sh:severity sh:Info ;
    sh:property [
        sh:name "storeAtShutdown" ;
        sh:path ( autosar:NV-BLOCK-NEEDS autosar:STORE-AT-SHUTDOWN ) ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:name "storeCyclic" ;
        sh:path ( autosar:NV-BLOCK-NEEDS autosar:STORE-CYCLIC ) ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:name "storeEmergency" ;
        sh:path ( autosar:NV-BLOCK-NEEDS autosar:STORE-EMERGENCY ) ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:name "storeImmediate" ;
        sh:path ( autosar:NV-BLOCK-NEEDS autosar:STORE-IMMEDIATE ) ;
        sh:datatype xsd:boolean
    ] ;
    sh:property [
        sh:name "disabledMode" ;
        sh:path ( autosar:DATA-RECEIVED-EVENT autosar:DISABLED-MODE-IREFS autosar:DISABLED-MODE-IREF )
    ] .

# 6) TPS_SWCT_01585 – structural typing only (behavioral part to SMT)

autosar:TPS_SWCT_01585_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:NV-BLOCK-DESCRIPTOR ;
    sh:severity sh:Info ;
    sh:property [
        sh:name "nvBlockNeeds" ;
        sh:path autosar:NV-BLOCK-NEEDS
    ] ;
    sh:property [
        sh:name "timingEvent" ;
        sh:path autosar:TIMING-EVENT-REF
    ] ;
    sh:property [
        sh:name "cyclicWritingPeriod" ;
        sh:path ( autosar:NV-BLOCK-NEEDS autosar:CYCLIC-WRITING-PERIOD )
    ] .


# SHACL for TPS_SWCT_01587 – cyclic writing requires a TimingEvent (informational, no structural path known)
[] a sh:NodeShape ;
   sh:severity sh:Info ;
   sh:message "The implementation of cyclic writing of nv data requires the existence of a TimingEvent that can trigger a RunnableEntity for writing the data (TPS_SWCT_01587)." .

# SHACL for TPS_SWCT_01588 – immediate writing requires DataReceivedEvent (informational)
[] a sh:NodeShape ;
   sh:severity sh:Info ;
   sh:message "Immediate storing of nv data requires activation of a RunnableEntity by a DataReceivedEvent (TPS_SWCT_01588)." .

# SHACL for TPS_SWCT_01589 – storeEmergency is behavioral only, no structural restriction
[] a sh:NodeShape ;
   sh:severity sh:Info ;
   sh:message "The use case for storeEmergency is implemented by a Complex Driver and is not structurally constrained in the AUTOSAR model (TPS_SWCT_01589)." .

# SHACL for TPS_SWCT_01590 – combinations of strategies are allowed (no restriction)
[] a sh:NodeShape ;
   sh:severity sh:Info ;
   sh:message "AUTOSAR supports combinations of nv data writing strategies; no structural restriction is imposed (TPS_SWCT_01590)." .

# SHACL for TPS_SWCT_01591 – reportBehavior shall be ignored in SwcServiceDependency context
# We model this as an informational constraint on SwcServiceDependency.
autosar:SwcServiceDependency_ReportBehaviorIgnored
    a sh:NodeShape ;
    sh:targetClass autosar:SWC-SERVICE-DEPENDENCY ;
    sh:severity sh:Info ;
    sh:message "DiagnosticEventNeeds.reportBehavior shall be ignored if specified in the context of a SwcServiceDependency (TPS_SWCT_01591)." .

# SHACL for TPS_SWCT_01592 – communication only via PortPrototypes (behavioral, no direct structural path)
[] a sh:NodeShape ;
   sh:targetClass autosar:ATOMIC-SW-COMPONENT-TYPE ;
   sh:severity sh:Info ;
   sh:message "Communication among RunnableEntitys of different instances of the same AtomicSwComponentType is only supported via PortPrototypes (TPS_SWCT_01592)." .


#################################################################
# SHACL shapes for selected structural / value constraints
#################################################################

#################################################################
# TPS_SWCT_01604 - Enable Size Indicator
# "ApplicationArrayDataType.dynamicArraySizeProfile of
#  ApplicationArrayDataType and ApplicationArrayElement.arraySizeHandling
#  shall be set."
#################################################################

autosar:TPS_SWCT_01604_ApplicationArrayDataType_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:APPLICATION-ARRAY-DATA-TYPE ;
    sh:severity sh:Violation ;
    sh:property [
        sh:path autosar:DYNAMIC-ARRAY-SIZE-PROFILE ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

autosar:TPS_SWCT_01604_ApplicationArrayElement_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:APPLICATION-ARRAY-ELEMENT ;
    sh:severity sh:Violation ;
    sh:property [
        sh:path autosar:ARRAY-SIZE-HANDLING ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

#################################################################
# TPS_SWCT_01607 - Profiles for internal structure of mapped ImplementationDataType
# dynamicArraySizeProfile: VSA_LINEAR, VSA_SQUARE, VSA_RECTANGULAR, VSA_FULLY_FLEXIBLE
#################################################################

autosar:TPS_SWCT_01607_ApplicationArrayDataType_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:APPLICATION-ARRAY-DATA-TYPE ;
    sh:severity sh:Violation ;
    sh:property [
        sh:path autosar:DYNAMIC-ARRAY-SIZE-PROFILE ;
        sh:in ( "VSA_LINEAR" "VSA_SQUARE" "VSA_RECTANGULAR" "VSA_FULLY_FLEXIBLE" ) ;
    ] .

#################################################################
# TPS_SWCT_01608 - Custom profiles naming convention
# Custom profiles shall have a company-specific prefix.
# (Only a weak pattern check is possible at schema level.)
#################################################################

autosar:TPS_SWCT_01608_ApplicationArrayDataType_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:APPLICATION-ARRAY-DATA-TYPE ;
    sh:severity sh:Info ;
    sh:property [
        sh:path autosar:DYNAMIC-ARRAY-SIZE-PROFILE ;
        # Example: enforce presence of at least one dash as a weak proxy
        sh:pattern ".+-.+" ;
    ] .


#################################################################
# SHACL for TPS_SWCT_01615
#################################################################

autosar:TPS_SWCT_01615_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:IMPLEMENTATION-DATA-TYPE ;
    sh:property [
        sh:path autosar:DYNAMIC-ARRAY-SIZE-PROFILE ;
        sh:datatype xsd:string ;
        sh:message "Custom profiles in DYNAMIC-ARRAY-SIZE-PROFILE shall have a company-specific prefix." ;
        sh:severity sh:Warning
    ] .

#################################################################
# SHACL for TPS_SWCT_01617
#################################################################

autosar:TPS_SWCT_01617_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:IMPLEMENTATION-DATA-TYPE ;
    sh:property [
        sh:path autosar:CATEGORY ;
        sh:hasValue "STRUCTURE" ;
        sh:message "ImplementationDataType representing a variable-sized array shall have CATEGORY = STRUCTURE." ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path ( autosar:SUB-ELEMENTS autosar:IMPLEMENTATION-DATA-TYPE-ELEMENT ) ;
        sh:minCount 2 ;
        sh:message "ImplementationDataType representing a variable-sized array shall have at least two subElements." ;
        sh:severity sh:Violation
    ] .

#################################################################
# SHACL for TPS_SWCT_01618
#################################################################

autosar:TPS_SWCT_01618_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:IMPLEMENTATION-DATA-TYPE ;
    sh:property [
        sh:path autosar:DYNAMIC-ARRAY-SIZE-PROFILE ;
        sh:in ( "VSA_LINEAR" "VSA_SQUARE" "VSA_FULLY_FLEXIBLE" ) ;
        sh:message "If DYNAMIC-ARRAY-SIZE-PROFILE is one of VSA_LINEAR, VSA_SQUARE, VSA_FULLY_FLEXIBLE, the first subElement shall be an integer size indicator (checked by SMT)." ;
        sh:severity sh:Info
    ] ;
    sh:property [
        sh:path ( autosar:SUB-ELEMENTS autosar:IMPLEMENTATION-DATA-TYPE-ELEMENT ) ;
        sh:minCount 1 ;
        sh:message "ImplementationDataType mapped to such ApplicationArrayDataType shall have at least one subElement (first is size indicator, checked by SMT)." ;
        sh:severity sh:Violation
    ] .

#################################################################
# SHACL for TPS_SWCT_01619
#################################################################

autosar:TPS_SWCT_01619_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:IMPLEMENTATION-DATA-TYPE-ELEMENT ;
    sh:property [
        sh:path autosar:CATEGORY ;
        sh:hasValue "ARRAY" ;
        sh:message "For VSA_RECTANGULAR, the first ImplementationDataType.subElement shall have CATEGORY = ARRAY (arraySize semantics checked by SMT)." ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path autosar:ARRAY-SIZE ;
        sh:minCount 1 ;
        sh:message "For VSA_RECTANGULAR, the first ImplementationDataType.subElement shall have ARRAY-SIZE present (value checked by SMT)." ;
        sh:severity sh:Violation
    ] .

#################################################################
# SHACL for TPS_SWCT_01620
#################################################################

autosar:TPS_SWCT_01620_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:IMPLEMENTATION-DATA-TYPE-ELEMENT ;
    sh:message "Elements of the Size Indicator array shall be integers large enough to hold the maximum number of valid elements (checked by SMT)." ;
    sh:severity sh:Info .

#################################################################
# SHACL for TPS_SWCT_01621
#################################################################

autosar:TPS_SWCT_01621_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:IMPLEMENTATION-DATA-TYPE-ELEMENT ;
    sh:property [
        sh:path autosar:CATEGORY ;
        sh:hasValue "ARRAY" ;
        sh:message "For dynamicArraySizeProfile, the second ImplementationDataType.subElement shall have CATEGORY = ARRAY." ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path autosar:ARRAY-SIZE ;
        sh:minCount 1 ;
        sh:message "For dynamicArraySizeProfile, the second ImplementationDataType.subElement shall have ARRAY-SIZE present (value = maxArraySize checked by SMT)." ;
        sh:severity sh:Violation
    ] .


# SHACL shapes for TPS_SWCT_01624 – TPS_SWCT_01630

#################################################################
# TPS_SWCT_01624 – Hard error occurs during the execution of a transformer chain
# Purely behavioral / runtime; no structural condition that can be checked on XML.
# → No SHACL shape generated.
#################################################################


#################################################################
# TPS_SWCT_01625 – Sending SwComponentType owns a DataPrototypeGroup
# Behavioral / runtime semantics about coherence vs. stability of values.
# No directly observable structural pattern beyond normal modeling.
# → No SHACL shape generated.
#################################################################


#################################################################
# TPS_SWCT_01626 – Error notification of data transformer errors
# If PortAPIOption.errorHandling == transformerErrorHandling then
# all RunnableEntitys accessing the referenced PortPrototype shall
# handle extended transformer error notification.
# Structural parts (existence / typing of properties) can be modeled.
#################################################################

autosar:TPS_SWCT_01626_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:PORT-API-OPTION ;

    # ERROR-HANDLING is optional (minOccurs=0) but if present must be of the given enum type.
    sh:property [
        sh:path autosar:ERROR-HANDLING ;
        sh:maxCount 1 ;
    ] ;

    # PORT-REF is mandatory (minOccurs=1) and cross-file typed via DEST.
    sh:property [
        sh:path autosar:PORT-REF ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        # DEST typing is handled by cross-file resolution, not by SHACL here.
    ] ;

    sh:severity sh:Violation
.


#################################################################
# TPS_SWCT_01627 – Suffix for PortInterface for Security Access
# Naming convention; requires relation to applicable SwcServiceDependency
# which is not structurally visible here.
# Only generic SHORT-NAME existence is already covered by base rules.
# → No additional SHACL beyond generic SHORT-NAME constraints.
#################################################################


#################################################################
# TPS_SWCT_01628 / 01629 / 01630 – Suffix for PortInterface for Data Services
# Same as 01627, repeated; no extra structural constraint derivable.
# → No SHACL shape generated.
#################################################################


# 1) TPS_SWCT_01631 / 01632 / 01633 / 01634
# 这些约束涉及 PortInterface 名称与 SwcServiceDependency.shortName 的命名约定，
# 但当前输入中没有 SwcServiceDependency 的结构与可观测路径，无法在 SHACL 中稳定表达。
# 按规则改由 SMT 承担，此处不生成对应 SHACL 形状。

# 2) TPS_SWCT_01635
# 语义：命名约定（如 SHORT-NAME-PATTERN）可以支持 SymbolProps 的有效性。
# 这是说明性/推荐性约束，不是硬性结构约束，因此不在 SHACL 中强制。
# 仅给出一个信息级别的形状，表示如果存在 SHORT-NAME-PATTERN，则其类型为字符串。

autosar:SHORT-NAME-PATTERN_ShortNamePattern_InfoShape
    a sh:NodeShape ;
    sh:severity sh:Info ;
    sh:targetClass autosar:APPLICATION-SW-COMPONENT-TYPE ,autosar:COMPLEX-DEVICE-DRIVER-SW-COMPONENT-TYPE ,autosar:ECU-ABSTRACTION-SW-COMPONENT-TYPE ,autosar:NV-BLOCK-SW-COMPONENT-TYPE ,autosar:SENSOR-ACTUATOR-SW-COMPONENT-TYPE ,autosar:SERVICE-PROXY-SW-COMPONENT-TYPE ,autosar:SERVICE-SW-COMPONENT-TYPE ,autosar:COMPOSITION-SW-COMPONENT-TYPE ,autosar:PARAMETER-SW-COMPONENT-TYPE ;
    sh:property [
        sh:path autosar:SHORT-NAME-PATTERN ;
        sh:datatype xsd:string
    ] .

# 3) TPS_SWCT_01637
# 语义：可以（但不必须）为 explicitInterRunnableVariable 或 implicitInterRunnableVariable
# 定义一个 INIT-VALUE。即：如果存在此 VariableDataPrototype，则其 INIT-VALUE 可选存在。
# 结构上 INIT-VALUE 已在模型中是可选的，本约束主要是说明性，因此 SHACL 不再重复强制。
# 仅给出 if-present-then-type 的信息级约束。

autosar:VariableDataPrototype_InitValue_InfoShape
    a sh:NodeShape ;
    sh:severity sh:Info ;
    sh:targetClass autosar:VARIABLE-DATA-PROTOTYPE ;
    sh:property [
        sh:path autosar:INIT-VALUE
    ] .

# 4) TPS_SWCT_01638
# 语义：当两个 PR-PORT-PROTOTYPE 通过连接器相连时，[constr_1086] 的约束同样适用，
# 且 AssemblySwConnector.requester/provider 与 PassThroughSwConnector.providedOuterPort/requiredOuterPort
# 在这种情况下不建立方向性。这是行为/语义层面的约束，难以用纯结构 SHACL 表达。
# 仅对涉及的引用元素给出基本类型/存在性约束。

# AssemblySwConnector.provider (optional)
autosar:AssemblySwConnector_Provider_InfoShape
    a sh:NodeShape ;
    sh:severity sh:Info ;
    sh:targetClass autosar:ASSEMBLY-SW-CONNECTOR ;
    sh:property [
        sh:path autosar:PROVIDER-IREF
    ] .

# AssemblySwConnector.requester (optional)
autosar:AssemblySwConnector_Requester_InfoShape
    a sh:NodeShape ;
    sh:severity sh:Info ;
    sh:targetClass autosar:ASSEMBLY-SW-CONNECTOR ;
    sh:property [
        sh:path autosar:REQUESTER-IREF
    ] .

# PassThroughSwConnector.providedOuterPort (required, with DEST restriction)
autosar:PassThroughSwConnector_ProvidedOuterPort_Shape
    a sh:NodeShape ;
    sh:severity sh:Violation ;
    sh:targetClass autosar:PASS-THROUGH-SW-CONNECTOR ;
    sh:property [
        sh:path autosar:PROVIDED-OUTER-PORT-REF ;
        sh:minCount 1
    ] .

# PassThroughSwConnector.requiredOuterPort (required, with DEST restriction)
autosar:PassThroughSwConnector_RequiredOuterPort_Shape
    a sh:NodeShape ;
    sh:severity sh:Violation ;
    sh:targetClass autosar:PASS-THROUGH-SW-CONNECTOR ;
    sh:property [
        sh:path autosar:REQUIRED-OUTER-PORT-REF ;
        sh:minCount 1
    ] .


# 1) TPS_SWCT_01639
# AtomicSwComponentType offers a PPortPrototype typed by ClientServerInterface to read/write current value via diagnostic services where the applicable DID is passed as an argument to the access functions
# 结构信息不足（ServiceNeeds/RoleBasedPortAssignment 未给出路径），由 SMT 负责逻辑约束，此处不建 SHACL 形状。


# 2) TPS_SWCT_01640
# Suffix used for the resulting name of the PortInterface for the Data Services
# 仅描述命名来源（SwcServiceDependency.shortName），属于生成规则/命名约定，缺少可观测结构，不建 SHACL 形状。


# 3) TPS_SWCT_01646
# Sending invalidValue without invalidation applied by intentionally sending invalidValue without RTE/Com
# For invalidation applied by RTE/Com the SenderReceiverInterface.invalidationPolicy.handleInvalid shall be set to the value HandleInvalidEnum.dontInvalidate.

autosar:TPS_SWCT_01646_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:INVALIDATION-POLICY ;
    sh:property [
        sh:path ( autosar:INVALIDATION-POLICY autosar:HANDLE-INVALID ) ;
        sh:in ( autosar:HandleInvalidEnum.dontInvalidate ) ;
        sh:severity sh:Violation ;
        sh:message "For invalidation applied by RTE/Com the InvalidationPolicy.HANDLE-INVALID shall be HandleInvalidEnum.dontInvalidate." ;
    ] .


# 4) TPS_SWCT_01647
# Size Indicator for dynamicArraySizeProfile set to VSA_LINEAR, VSA_SQUARE, or VSA_FULLY_FLEXIBLE if only ImplementationDataType is present
# 需要“第一个 subElement 是足够大的整数”以及与 maxArraySize 的关系，超出 SHACL 简单结构能力，由 SMT 负责；此处仅给出弱结构约束（存在性）。

autosar:TPS_SWCT_01647_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:IMPLEMENTATION-DATA-TYPE ;
    sh:property [
        sh:path ( autosar:IMPLEMENTATION-DATA-TYPE autosar:DYNAMIC-ARRAY-SIZE-PROFILE ) ;
        sh:severity sh:Info ;
        sh:message "dynamicArraySizeProfile is used together with SUB-ELEMENTS to model Variable-Size Array; detailed semantics checked by SMT." ;
    ] ;
    sh:property [
        sh:path ( autosar:IMPLEMENTATION-DATA-TYPE autosar:SUB-ELEMENTS autosar:IMPLEMENTATION-DATA-TYPE-ELEMENT ) ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "ImplementationDataType with dynamicArraySizeProfile must have at least one SUB-ELEMENTS/IMPLEMENTATION-DATA-TYPE-ELEMENT (size indicator)." ;
    ] .


# 5) TPS_SWCT_01648
# Size Indicator for dynamicArraySizeProfile set to VSA_RECTANGULAR if only ImplementationDataType is present

autosar:TPS_SWCT_01648_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:IMPLEMENTATION-DATA-TYPE ;
    sh:property [
        sh:path ( autosar:IMPLEMENTATION-DATA-TYPE autosar:DYNAMIC-ARRAY-SIZE-PROFILE ) ;
        sh:severity sh:Info ;
        sh:message "dynamicArraySizeProfile == VSA_RECTANGULAR implies constraints on first SUB-ELEMENTS/IMPLEMENTATION-DATA-TYPE-ELEMENT; detailed semantics checked by SMT." ;
    ] ;
    sh:property [
        sh:path ( autosar:IMPLEMENTATION-DATA-TYPE autosar:SUB-ELEMENTS autosar:IMPLEMENTATION-DATA-TYPE-ELEMENT ) ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "ImplementationDataType with dynamicArraySizeProfile == VSA_RECTANGULAR must have at least one SUB-ELEMENTS/IMPLEMENTATION-DATA-TYPE-ELEMENT (size indicator array element)." ;
    ] .

# 对 ImplementationDataTypeElement 的结构性约束（CATEGORY / ARRAY-SIZE）仅在 SMT 中精确建模，这里不再重复。


# 6) TPS_SWCT_01649
# Payload for dynamicArraySizeProfile if only ImplementationDataType is present

autosar:TPS_SWCT_01649_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:IMPLEMENTATION-DATA-TYPE ;
    sh:property [
        sh:path ( autosar:IMPLEMENTATION-DATA-TYPE autosar:DYNAMIC-ARRAY-SIZE-PROFILE ) ;
        sh:severity sh:Info ;
        sh:message "dynamicArraySizeProfile implies existence of a second SUB-ELEMENTS/IMPLEMENTATION-DATA-TYPE-ELEMENT as payload; detailed semantics checked by SMT." ;
    ] ;
    sh:property [
        sh:path ( autosar:IMPLEMENTATION-DATA-TYPE autosar:SUB-ELEMENTS autosar:IMPLEMENTATION-DATA-TYPE-ELEMENT ) ;
        sh:minCount 2 ;
        sh:severity sh:Violation ;
        sh:message "ImplementationDataType with dynamicArraySizeProfile must aggregate at least two SUB-ELEMENTS/IMPLEMENTATION-DATA-TYPE-ELEMENTs (size indicator + payload)." ;
    ] .


# 7) TPS_SWCT_01650
# Structure of the VSA ImplementationDataType

autosar:TPS_SWCT_01650_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:IMPLEMENTATION-DATA-TYPE ;
    sh:property [
        sh:path ( autosar:IMPLEMENTATION-DATA-TYPE autosar:SUB-ELEMENTS autosar:IMPLEMENTATION-DATA-TYPE-ELEMENT ) ;
        sh:minCount 2 ;
        sh:severity sh:Violation ;
        sh:message "VSA ImplementationDataType shall consist of two ImplementationDataTypeElements (size indicator and payload)." ;
    ] .


# 1) SHACL (Turtle)

# TPS_SWCT_01653 - UTF-16-encoded strings are not allowed to start with a BOM
# 结构层面：仅能检查 BaseTypeDirectDefinition.baseTypeEncoding 的取值；
# “字符串值不能以 BOM 开头” 属于运行时数据内容，这里交由 SMT 处理。

autosar:TPS_SWCT_01653_BaseTypeEncodingShape
    a sh:NodeShape ;
    sh:targetClass autosar:DATA-PROTOTYPE ;
    sh:property [
        sh:name "baseTypeEncoding" ;
        sh:path ( autosar:BASE-TYPE-DIRECT-DEFINITION autosar:BASE-TYPE-ENCODING ) ;
        sh:datatype xsd:string ;
    ] ;
    sh:severity sh:Violation ;
.

# TPS_SWCT_01654 - AtomicSwComponentType offers PortPrototypes typed by SenderReceiverInterfaces to adjust the IO signal via diagnostic services
# 该约束主要是服务建模语义（ServiceNeeds kind、角色集合），结构信息不足，交由 SMT 处理。
# 此处不生成 SHACL 结构约束。

# TPS_SWCT_01655 - Reference from DiagnosticIoControlNeeds to DiagnosticValueNeeds
# 语义：在 TPS_SWCT_01654 场景下，DiagnosticIoControlNeeds 应引用 DiagnosticValueNeeds。
# 结构上仅建模 DiagnosticValueNeeds 元素存在性（若出现）。

autosar:TPS_SWCT_01655_DiagnosticValueNeedsShape
    a sh:NodeShape ;
    sh:targetClass autosar:DIAGNOSTIC-VALUE-NEEDS ;
    sh:property [
        sh:name "diagnosticValueNeeds" ;
        sh:path ( autosar:DIAGNOSTIC-VALUE-NEEDS autosar:DIAGNOSTIC-VALUE-NEEDS ) ;
    ] ;
    sh:severity sh:Info ;
.

# TPS_SWCT_01656 - Suffix used for the resulting name of the PortInterface
# 语义涉及字符串拼接（IOControlRequest/Response + SwcServiceDependency.shortName），
# 需要跨元素命名规则，交由 SMT 处理；此处不生成额外 SHACL。

# TPS_SWCT_01657 - NamingRule for RPortPrototype with role "IOControlRequest"
# 结构上仅保证 R-PORT-PROTOTYPE 存在 SHORT-NAME；命名模式由 SMT 处理。

autosar:TPS_SWCT_01657_RPortPrototypeShape
    a sh:NodeShape ;
    sh:targetClass autosar:R-PORT-PROTOTYPE ;
    sh:property [
        sh:name "shortName" ;
        sh:path ( autosar:R-PORT-PROTOTYPE autosar:SHORT-NAME ) ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:severity sh:Violation ;
.

# TPS_SWCT_01658 - NamingRule for PPortPrototype with role "IOControlResponse"

autosar:TPS_SWCT_01658_PPortPrototypeShape
    a sh:NodeShape ;
    sh:targetClass autosar:P-PORT-PROTOTYPE ;
    sh:property [
        sh:name "shortName" ;
        sh:path ( autosar:P-PORT-PROTOTYPE autosar:SHORT-NAME ) ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:severity sh:Violation ;
.

# TPS_SWCT_01659 - Mapping of VariableDataPrototype to a NvBlockDescriptor
# 结构上建模 AutosarVariableRef 的两个可选引用和 NvBlockDescriptor/NvDataInterface 的相关元素；
# 具体“3 种映射方式”的互斥/覆盖逻辑交由 SMT 处理。

autosar:TPS_SWCT_01659_PortPrototypeShape
    a sh:NodeShape ;
    sh:targetClass autosar:PORT-PROTOTYPE ;
    sh:property [
        sh:name "autosarVariableInImplDatatype" ;
        sh:path ( autosar:AUTOSAR-VARIABLE-REF autosar:AUTOSAR-VARIABLE-IN-IMPL-DATATYPE ) ;
    ] ;
    sh:property [
        sh:name "autosarVariable" ;
        sh:path ( autosar:AUTOSAR-VARIABLE-REF autosar:AUTOSAR-VARIABLE-IREF ) ;
    ] ;
    sh:property [
        sh:name "ramBlock" ;
        sh:path ( autosar:NV-BLOCK-DESCRIPTOR autosar:RAM-BLOCK ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:name "nvData" ;
        sh:path ( autosar:NV-DATA-INTERFACE autosar:NV-DATAS autosar:VARIABLE-DATA-PROTOTYPE ) ;
        sh:minCount 1 ;
    ] ;
    sh:severity sh:Violation ;
.


# 1) TPS_SWCT_02000 - Default value for attribute swImplPolicy
# 语义主要是默认值与“未显式设置”的行为，运行时/工具行为，不做结构性 SHACL 约束
# 且 target_class 为空，仅有可选属性，按规则由 SMT 承担 ⇒ 此处不生成 SHACL shape


# 2) TPS_SWCT_02001 - Values of SwAxisCont with the category CURVE_AXIS, COM_AXIS, RES_AXIS are for display only
# 纯行为性说明，不涉及结构/计数/类型约束 ⇒ 不生成 SHACL


# 3) TPS_SWCT_02002 - AtomicSwComponentType offers a PPortPrototype typed by ClientServerInterface to read/write current value via diagnostic services
# 文本中给出“RoleBasedPortAssignment valid roles: DataServices [1]”
# 但缺少明确路径（RoleBasedPortAssignment 在 AtomicSwComponentType 下的具体 XML 结构未给出）
# 无法稳定构造 sh:path ⇒ 由 SMT 承担 ⇒ 不生成 SHACL


# 4) TPS_SWCT_02003 - AtomicSwComponentType offers PortPrototypes typed by SenderReceiverInterfaces to read/write current values via diagnostic services
# 文本中给出：
#  - RoleBasedDataAssignment valid roles: signalBasedDiagnostics [1..2]
#  - RepresentedPortGroups: N/A  ⇒ 不应出现 REPRESENTED-PORT-GROUP-REF
#  - ServiceNeeds kind DiagnosticValueNeeds
# 但缺少 RoleBasedDataAssignment 在 AtomicSwComponentType 下的完整路径，且 ServiceNeeds 的内部结构未给出
# 仅对“RepresentedPortGroups N/A”可做结构性约束：禁止出现 REPRESENTED-PORT-GROUP-REF
# 由于 path_variants 指向 SWC-SERVICE-DEPENDENCY/REPRESENTED-PORT-GROUP-REF，
# 而语义主体是 AtomicSwComponentType（target_class），路径跨层结构不明，避免错误拼接 ⇒ 交由 SMT 处理
# ⇒ 此处不生成 SHACL


# 5) TPS_SWCT_02003_PortOfferingRule - Port offering for diagnostic read/write signals
# 语义：读信号 ⇒ 提供 AbstractProvidedPortPrototype；写信号 ⇒ 提供 AbstractRequiredPortPrototype
# 这是条件/行为性约束，且涉及多个类（AtomicSwComponentType, AbstractProvidedPortPrototype, AbstractRequiredPortPrototype）
# 无法仅用简单路径表达 ⇒ 由 SMT 承担 ⇒ 不生成 SHACL


# 6) TPS_SWCT_02004 - DiagnosticRoutineNeeds
# 语义类似 02002：ServiceNeeds kind DiagnosticRoutineNeeds + RoleBasedPortAssignment valid roles: RoutineServices [1]
# 缺少稳定路径 ⇒ 由 SMT 承担 ⇒ 不生成 SHACL


# 7) TPS_SWCT_02005 - DiagnosticIoControlNeeds
# 语义类似 02002：ServiceNeeds kind DiagnosticIoControlNeeds + RoleBasedPortAssignment valid roles: DataServices [1]
# 缺少稳定路径 ⇒ 由 SMT 承担 ⇒ 不生成 SHACL


# SHACL for TPS_SWCT_02007
autosar:TPS_SWCT_02007
    a sh:NodeShape ;
    sh:targetClass autosar:ATOMIC-SW-COMPONENT-TYPE ;
    sh:property [
        sh:path ( autosar:SWC-SERVICE-DEPENDENCY autosar:SERVICE-NEEDS ) ;
        sh:message "AtomicSwComponentType implements an OBD system monitor with In-Use-Monitor Performance Ratio: ServiceNeeds shall be of kind ObdRatioServiceNeeds." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path ( autosar:ROLE-BASED-PORT-ASSIGNMENT autosar:ROLE ) ;
        sh:message "AtomicSwComponentType implements an OBD system monitor with In-Use-Monitor Performance Ratio: valid RoleBasedPortAssignment roles are IUMPRNumerator and IUMPRDenominator, each 0..1." ;
        sh:severity sh:Violation ;
    ] .

# SHACL for TPS_SWCT_02008
autosar:TPS_SWCT_02008
    a sh:NodeShape ;
    sh:targetClass autosar:ATOMIC-SW-COMPONENT-TYPE ;
    sh:property [
        sh:path ( autosar:SWC-SERVICE-DEPENDENCY autosar:SERVICE-NEEDS ) ;
        sh:message "AtomicSwComponentType offers a server port to read/write current value via OBD services: ServiceNeeds shall be of kind ObdPidServiceNeeds." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path ( autosar:ROLE-BASED-PORT-ASSIGNMENT autosar:ROLE ) ;
        sh:message "AtomicSwComponentType offers a server port to read/write current value via OBD services: RoleBasedPortAssignment role DataServices shall occur exactly once." ;
        sh:severity sh:Violation ;
    ] .

# SHACL for TPS_SWCT_02009
autosar:TPS_SWCT_02009
    a sh:NodeShape ;
    sh:targetClass autosar:ABSTRACT-PROVIDED-PORT-PROTOTYPE ;
    sh:property [
        sh:path ( autosar:SWC-SERVICE-DEPENDENCY autosar:SERVICE-NEEDS ) ;
        sh:message "AtomicSwComponentType offers sender receiver ports to read/write current values via OBD services: ServiceNeeds shall be of kind ObdPidServiceNeeds." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path ( autosar:ROLE-BASED-DATA-ASSIGNMENT autosar:ROLE ) ;
        sh:message "AtomicSwComponentType offers sender receiver ports to read/write current values via OBD services: RoleBasedDataAssignment role signalBasedDiagnostics shall occur between 1 and 2 times." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path autosar:PORTS ;
        sh:message "To read the signal the AtomicSwComponentType shall offer an AbstractProvidedPortPrototype, to write the signal the AtomicSwComponentType shall offer an AbstractRequiredPortPrototype." ;
        sh:severity sh:Violation ;
    ] .

# SHACL for TPS_SWCT_02010
autosar:TPS_SWCT_02010
    a sh:NodeShape ;
    sh:targetClass autosar:ATOMIC-SW-COMPONENT-TYPE ;
    sh:property [
        sh:path ( autosar:SWC-SERVICE-DEPENDENCY autosar:SERVICE-NEEDS ) ;
        sh:message "AtomicSwComponentType offers a server port to read vehicle information values via OBD services: ServiceNeeds shall be of kind ObdInfoServiceNeeds." ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path ( autosar:ROLE-BASED-PORT-ASSIGNMENT autosar:ROLE ) ;
        sh:message "AtomicSwComponentType offers a server port to read vehicle information values via OBD services: valid RoleBasedPortAssignment role is InfotypeServices [1]." ;
        sh:severity sh:Violation ;
