# SHACL

#################################################################
# constr_1218 - Interpretation of attribute syncCounterInit owned by EndToEndDescription in PROFILE_02
#################################################################

autosar:Constr_1218 a sh:NodeShape ;
  sh:targetClass autosar:VARIABLE-DATA-PROTOTYPE ;
  sh:severity sh:Violation ;
  sh:message "If EndToEndProtection.endToEndProtectionVariablePrototype.receiver is identical to the RPortPrototype.requiredComSpec.dataElement and RPortPrototype.requiredComSpec.syncCounterInit is defined then the value of RPortPrototype.requiredComSpec.syncCounterInit shall be preferred over the value of EndToEndProtection.endToEndProfile.syncCounterInit. If the value of category of EndToEndDescription is set to PROFILE_02 and either the described correspondence rule concerning the referenced VariableDataPrototype is not fulfilled or RPortPrototype.requiredComSpec.syncCounterInit is not defined then EndToEndProtection.endToEndProfile.syncCounterInit shall exist." ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "PROFILE_02 syncCounterInit interpretation and existence rule violated." ;
    sh:severity sh:Violation ;
    sh:select """
      PREFIX autosar: <http://autosar.org/>

      SELECT ?this
      WHERE {
        # This constraint is behavioral and cross-structural; structural checks are delegated to SMT.
        # SPARQL body intentionally left empty.
        FILTER(false)
      }
    """
  ] .

#################################################################
# constr_1219 - Invalidation depends on the value of swImplPolicy
#################################################################

autosar:Constr_1219 a sh:NodeShape ;
  sh:targetClass autosar:SW-DATA-DEF-PROPS-CONTENT ;
  sh:severity sh:Info ;
  sh:message "Invalidation of dataElements is only supported for dataElements where the value of swImplPolicy is not set to queued." ;
  sh:property [
    sh:path autosar:SW-IMPL-POLICY ;
  ] .

#################################################################
# constr_1220 - Compatibility of SwBaseType
#################################################################

autosar:Constr_1220 a sh:NodeShape ;
  sh:targetClass autosar:BASE-TYPE-DIRECT-DEFINITION ;
  sh:severity sh:Info ;
  sh:message "Two SwBaseTypes are compatible if and only if attributes baseTypeSize respectively maxBaseTypeSize, byteOrder, memAlignment, baseTypeEncoding, and nativeDeclaration have identical values." ;
  sh:property [
    sh:path autosar:BASE-TYPE-SIZE ;
  ] ;
  sh:property [
    sh:path autosar:MAX-BASE-TYPE-SIZE ;
  ] ;
  sh:property [
    sh:path autosar:BASE-TYPE-ENCODING ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path autosar:MEM-ALIGNMENT ;
  ] ;
  sh:property [
    sh:path autosar:BYTE-ORDER ;
  ] ;
  sh:property [
    sh:path autosar:NATIVE-DECLARATION ;
  ] .

#################################################################
# constr_1221 - DataPrototype is typed by an ApplicationPrimitive DataType
#################################################################

autosar:Constr_1221 a sh:NodeShape ;
  sh:targetClass autosar:APPLICATION-PRIMITIVE-DATA-TYPE ;
  sh:severity sh:Info ;
  sh:message "If a DataPrototype is typed by an ApplicationPrimitive DataType its initValue shall be provided by an ApplicationValueSpecification. If the underlying ApplicationPrimitiveDataType represents an enumeration, the value provided shall match to one of the applicable text values (vt, short Label, symbol) defined by the applicable CompuScales." ;
  sh:property [
    sh:path autosar:VT ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path autosar:SHORT-LABEL ;
  ] ;
  sh:property [
    sh:path autosar:SYMBOL ;
  ] ;
  sh:property [
    sh:path autosar:INIT-VALUE ;
  ] .

#################################################################
# constr_1222 - category of an AutosarDataType used to type a DataPrototype is set to STRING
#################################################################

autosar:Constr_1222 a sh:NodeShape ;
  sh:targetClass autosar:DATA-PROTOTYPE ;
  sh:severity sh:Violation ;
  sh:message "If the category of an AutosarDataType used to type a DataPrototype is set to STRING the ApplicationValueSpecification used to initialize the DataPrototype shall be of category STRING." ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "If the category of the AutosarDataType typing a DataPrototype is STRING, then the init ApplicationValueSpecification must have category STRING." ;
    sh:severity sh:Violation ;
    sh:select """
      PREFIX autosar: <http://autosar.org/>

      SELECT ?this
      WHERE {
        # Structural navigation is model-dependent; logical semantics handled in SMT.
        FILTER(false)
      }
    """
  ] .

#################################################################
# constr_1223 - DataPrototype is typed by an ApplicationRecordDataType
#################################################################

autosar:Constr_1223 a sh:NodeShape ;
  sh:targetClass autosar:APPLICATION-RECORD-DATA-TYPE ;
  sh:severity sh:Violation ;
  sh:message "If a DataPrototype is typed by an ApplicationRecordDataType the corresponding initValue shall be provided by a RecordValueSpecification." ;
  sh:property [
    sh:path autosar:INIT-VALUE ;
  ] .

#################################################################
# constr_1224 - DataPrototype is typed by an ApplicationArrayDataType
#################################################################

autosar:Constr_1224 a sh:NodeShape ;
  sh:targetClass autosar:APPLICATION-ARRAY-DATA-TYPE ;
  sh:severity sh:Violation ;
  sh:message "If a DataPrototype is typed by an ApplicationArrayDataType the corresponding initValue shall be provided by an ArrayValueSpecification or ApplicationRuleBasedValueSpecification." ;
  sh:property [
    sh:path autosar:INIT-VALUE ;
  ] .


autosar:constr_1225 a sh:NodeShape ;
  sh:severity sh:Violation ;
  sh:targetClass autosar:VALUE-SPECIFICATION ;
  sh:message "If a DataPrototype is typed by an ImplementationDataType that references a CompuMethod of category TEXTTABLE or BITFIELD_TEXTTABLE the applicable ValueSpecification shall be a TextValueSpecification and its value shall match one of the text values defined by the applicable CompuScales."@en .

autosar:constr_1226 a sh:NodeShape ;
  sh:severity sh:Violation ;
  sh:targetClass autosar:EXECUTABLE-ENTITY-ACTIVATION-REASON ;
  sh:property [
    sh:path autosar:BIT-POSITION ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:integer ;
    sh:minInclusive 0 ;
    sh:maxInclusive 31
  ] ;
  sh:message "The value of attribute ExecutableEntityActivationReason.bitPosition shall be in the range of 0 .. 31."@en .

autosar:constr_1227 a sh:NodeShape ;
  sh:severity sh:Violation ;
  sh:targetClass autosar:RUNNABLE-ENTITY ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "The values of ExecutableEntityActivationReason.bitPosition and ExecutableEntityActivationReason.symbol shall be unique in the context of the enclosing RunnableEntity."@en ;
    sh:select """
      PREFIX autosar: <http://autosar.org/>
      SELECT ?this
      WHERE {
        ?this autosar:EXECUTABLE-ENTITY-ACTIVATION-REASONS ?reasons .
        ?reasons autosar:EXECUTABLE-ENTITY-ACTIVATION-REASON ?r1 .
        ?reasons autosar:EXECUTABLE-ENTITY-ACTIVATION-REASON ?r2 .
        FILTER(?r1 != ?r2) .
        ?r1 autosar:BIT-POSITION ?bp1 .
        ?r2 autosar:BIT-POSITION ?bp2 .
        ?r1 autosar:SYMBOL ?sym1 .
        ?r2 autosar:SYMBOL ?sym2 .
        FILTER( (?bp1 = ?bp2) || (?sym1 = ?sym2) )
      }
    """
  ] .

autosar:constr_1228 a sh:NodeShape ;
  sh:severity sh:Violation ;
  sh:targetClass autosar:EXECUTABLE-ENTITY-ACTIVATION-REASON ;
  sh:message "An RTEEvent that is referenced by a WaitPoint in the role trigger shall not reference ExecutableEntityActivationReason in the role activationReasonRepresentation."@en .

autosar:constr_1231 a sh:NodeShape ;
  sh:severity sh:Info ;
  sh:targetClass autosar:CONSISTENCY-NEEDS ;
  sh:message "If ConsistencyNeeds are aggregated by a CompositionSwComponentType the instanceRef associations shall only refer to context and target elements within the context of this CompositionSwComponentType."@en .

autosar:constr_1232 a sh:NodeShape ;
  sh:severity sh:Info ;
  sh:targetClass autosar:CONSISTENCY-NEEDS ;
  sh:message "If ConsistencyNeeds are aggregated by an AtomicSwComponentType the instanceRef associations shall only refer to context and target elements within the context of this AtomicSwComponentType."@en .

autosar:constr_1233 a sh:NodeShape ;
  sh:severity sh:Violation ;
  sh:targetClass autosar:INSTANTIATION-TIMING-EVENT-PROPS ;
  sh:message "An InstantiationTimingEventProps shall only reference TimingEvent in the role refinedEvent."@en .


#################################################################
# SHACL shapes
#################################################################

#################################################################
# constr_1234 - Value of RunnableEntity.symbol
#################################################################

autosar:constr_1234 a sh:NodeShape ; sh:targetClass autosar:NV-BLOCK-SW-COMPONENT-TYPE ; sh:severity sh:Violation ; sh:message "The value of a RunnableEntity.symbol owned by an NvBlockSwComponentType that is triggered by an OperationInvokedEvent shall only be taken from the set of API names associated with the NvM." ; sh:sparql [ a sh:SPARQLConstraint ; sh:message "RunnableEntity.symbol for OperationInvokedEvent-triggered runnables of an NvBlockSwComponentType must be one of the NvM API names." ; sh:select """PREFIX autosar: <http://autosar.org/> SELECT ?this ?runnable ?symbol WHERE { ?this a autosar:NV-BLOCK-SW-COMPONENT-TYPE . ?this autosar:RUNNABLE-ENTITIES ?runnable . ?runnable autosar:SYMBOL ?symbol . ?event autosar:START-ON-EVENT ?runnable ; a autosar:OPERATION-INVOKED-EVENT . FILTER NOT EXISTS { ?apiName a autosar:NvMApiName ; autosar:SHORT-NAME ?symbol . } }""" ] .


#################################################################
# constr_1234_clarification_no_restriction
# (No structural restriction – modeled as Info-only clarification)
#################################################################

autosar:constr_1234_clarification_no_restriction a sh:NodeShape ;
  sh:targetClass autosar:NV-BLOCK-SW-COMPONENT-TYPE ;
  sh:severity sh:Info ;
  sh:message "No restriction applies for the value of RunnableEntity.symbol of runnables triggered by RTEEvents other than OperationInvokedEvent." .

#################################################################
# constr_1237 - Scope of mapped ClientServerOperations
#################################################################

# Structural: FIRST-OPERATION-REF / SECOND-OPERATION-REF DEST type
autosar:constr_1237 a sh:NodeShape ;
  sh:targetClass autosar:CLIENT-SERVER-OPERATION-MAPPING ;
  sh:severity sh:Violation ;
  sh:property [
    sh:path autosar:FIRST-OPERATION-REF ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class autosar:CLIENT-SERVER-OPERATION
  ] ;
  sh:property [
    sh:path autosar:SECOND-OPERATION-REF ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class autosar:CLIENT-SERVER-OPERATION
  ] .

#################################################################
# constr_1238 - Scope of mapped ApplicationErrors
#################################################################

autosar:constr_1238 a sh:NodeShape ;
  sh:targetClass autosar:CLIENT-SERVER-APPLICATION-ERROR-MAPPING ;
  sh:severity sh:Violation ;
  sh:property [
    sh:path autosar:FIRST-APPLICATION-ERROR-REF ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class autosar:APPLICATION-ERROR
  ] ;
  sh:property [
    sh:path autosar:SECOND-APPLICATION-ERROR-REF ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class autosar:APPLICATION-ERROR
  ] .

#################################################################
# constr_1240 - Consistency of ArgumentDataPrototypes
#################################################################

# Structural: existence and typing of DATA-PROTOTYPE-MAPPING elements
autosar:constr_1240 a sh:NodeShape ;
  sh:targetClass autosar:CLIENT-SERVER-OPERATION-MAPPING ;
  sh:severity sh:Violation ;
  sh:property [
    sh:path ( autosar:ARGUMENT-MAPPINGS autosar:DATA-PROTOTYPE-MAPPING ) ;
    sh:node autosar:DataPrototypeMappingShape
  ] ;
  sh:property [
    sh:path autosar:FIRST-OPERATION-REF ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class autosar:CLIENT-SERVER-OPERATION
  ] ;
  sh:property [
    sh:path autosar:SECOND-OPERATION-REF ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class autosar:CLIENT-SERVER-OPERATION
  ] .

autosar:DataPrototypeMappingShape a sh:NodeShape ;
  sh:property [
    sh:path autosar:FIRST-DATA-PROTOTYPE-REF ;
    sh:nodeKind sh:IRI ;
    sh:class autosar:ARGUMENT-DATA-PROTOTYPE ;
    sh:minCount 0 ;
    sh:maxCount 1
  ] ;
  sh:property [
    sh:path autosar:SECOND-DATA-PROTOTYPE-REF ;
    sh:nodeKind sh:IRI ;
    sh:class autosar:ARGUMENT-DATA-PROTOTYPE ;
    sh:minCount 0 ;
    sh:maxCount 1
  ] .

#################################################################
# constr_1241 - Compound Primitive Data Types and invalidValue
#################################################################

# Structural: CATEGORY and INVALID-VALUE are optional; logic in SMT
autosar:constr_1241 a sh:NodeShape ;
  sh:targetClass autosar:APPLICATION-PRIMITIVE-DATA-TYPE ;
  sh:severity sh:Violation ;
  sh:property [
    sh:path autosar:CATEGORY ;
    sh:datatype autosar:C-IDENTIFIER ;
    sh:maxCount 1
  ] ;
  sh:property [
    sh:path ( autosar:SW-DATA-DEF-PROPS-CONTENT autosar:INVALID-VALUE ) ;
    sh:maxCount 1
  ] .

#################################################################
# constr_1242 - Restriction of invalidValue for STRING category
#################################################################

autosar:constr_1242 a sh:NodeShape ;
  sh:targetClass autosar:APPLICATION-PRIMITIVE-DATA-TYPE ;
  sh:severity sh:Violation ;
  sh:property [
    sh:path ( autosar:SW-DATA-DEF-PROPS-CONTENT autosar:INVALID-VALUE ) ;
    sh:maxCount 1
  ] .


#################################################################
# SHACL shapes for the given constraints
#################################################################

########## constr_1243 – NumericalOrText shall either define vf or vt ##########

autosar:Constr_1243_NumericalOrText_vf_vt
    a sh:NodeShape ;
    sh:targetClass autosar:NUMERICAL-OR-TEXT ;

    # VF present ⇒ VT must be absent
    sh:sparql [
        sh:message "Within one NUMERICAL-OR-TEXT, either VF or VT shall be defined, but not both." ;
        sh:severity sh:Violation ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this
            WHERE {
              ?this a autosar:NUMERICAL-OR-TEXT .
              OPTIONAL { ?this autosar:VF ?vf . }
              OPTIONAL { ?this autosar:VT ?vt . }
              FILTER( bound(?vf) && bound(?vt) )
            }
        """ ;
    ] ;

    # At least one of VF / VT must exist
    sh:sparql [
        sh:message "Within one NUMERICAL-OR-TEXT, either VF or VT shall be defined (at least one must exist)." ;
        sh:severity sh:Violation ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this
            WHERE {
              ?this a autosar:NUMERICAL-OR-TEXT .
              OPTIONAL { ?this autosar:VF ?vf . }
              OPTIONAL { ?this autosar:VT ?vt . }
              FILTER( !bound(?vf) && !bound(?vt) )
            }
        """ ;
    ]
.

########## constr_1244 – DataPrototypes used in application software shall not be typed by C enums ##########

# Structural part: additionalNativeTypeQualifier is just a string, no extra SHACL beyond basic typing.
# The semantic “shall not set ... to enum” is handled in SMT (needs value inspection).

########## constr_1245 – Consideration of ModeTransitions for compatibility of ModeDeclarationGroups ##########

# This is a high-level behavioral/relationship constraint; no stable local XML paths are provided.
# Leave to SMT only (no SHACL).

########## constr_1246 – Consistency of firstMode and secondMode in one ModeDeclarationMappingSet ##########

# This requires reasoning over groups of MODE-DECLARATIONs and their owning MODE-DECLARATION-GROUPs.
# No direct local structural violation can be expressed with simple paths; handled in SMT.

########## constr_1247 – Consistency of ModeDeclarationMappingSet w.r.t. firstModeGroup / secondModeGroup ##########

# Cross-structure consistency between ModeDeclarationGroupPrototypeMapping and ModeDeclarationMappingSet.
# Leave to SMT.

########## constr_1248 – Compatibility of PortPrototypes of different DataInterfaces ##########

# Complex “if and only if” compatibility condition over pairs of PortPrototypes and PortInterfaces.
# No robust local SHACL; handled in SMT.

########## constr_1249 – Compatibility of ModeSwitchInterfaces in PassThroughSwConnector ##########

# Similar complex compatibility condition; handled in SMT.


# 1) constr_1250 – Compatibility of ClientServerInterfaces in the context of a PassThroughSwConnector
# 仅建模结构性信息：ClientServerInterface.isService 存在且为布尔

autosar:Constr_1250_IsServiceShape
    a sh:NodeShape ;
    sh:targetClass autosar:CLIENT-SERVER-INTERFACE ;
    sh:property [
        sh:path autosar:IS-SERVICE ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] .

# 2) constr_1251 – Compatibility of PortPrototypes of TriggerInterfaces in the context of a PassThroughSwConnector
# 仅建模结构性信息：TriggerInterface.isService 存在且为布尔

autosar:Constr_1251_IsServiceShape
    a sh:NodeShape ;
    sh:targetClass autosar:TRIGGER-INTERFACE ;
    sh:property [
        sh:path autosar:IS-SERVICE ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] .

# 3) constr_1252 – Creation of a loop involving a PassThroughSwConnector is not allowed
# 该约束涉及“直接或间接连接”的图遍历逻辑，交由 SMT 处理，此处不建 SHACL 结构约束。


# 4) constr_1253 – Supported usage of VariationPointProxy
# 语义依赖外部表 7.111，无法从当前信息推导具体 min/max，SHACL 仅保留基本类型约束（不改变原有 minOccurs 语义）

autosar:Constr_1253_VariationPointProxyShape
    a sh:NodeShape ;
    sh:targetClass autosar:VARIATION-POINT-PROXY ;

    # DESC [0..1]
    sh:property [
        sh:path autosar:DESC ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;

    # CATEGORY [0..1]
    sh:property [
        sh:path autosar:CATEGORY ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;

    # ADMIN-DATA [0..1]
    sh:property [
        sh:path autosar:ADMIN-DATA ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;

    # INTRODUCTION [0..1]
    sh:property [
        sh:path autosar:INTRODUCTION ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;

    # ANNOTATION [0..*] via ANNOTATIONS
    sh:property [
        sh:path ( autosar:ANNOTATIONS autosar:ANNOTATION ) ;
        sh:severity sh:Violation ;
    ] ;

    # LONG-NAME [0..1]
    sh:property [
        sh:path autosar:LONG-NAME ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;

    # SHORT-NAME [1..1]
    sh:property [
        sh:path autosar:SHORT-NAME ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;

    # SHORT-NAME-FRAGMENT [0..*] via SHORT-NAME-FRAGMENTS
    sh:property [
        sh:path ( autosar:SHORT-NAME-FRAGMENTS autosar:SHORT-NAME-FRAGMENT ) ;
        sh:severity sh:Violation ;
    ] ;

    # CONDITION-ACCESS [0..1]
    sh:property [
        sh:path autosar:CONDITION-ACCESS ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;

    # IMPLEMENTATION-DATA-TYPE-REF [0..1]
    sh:property [
        sh:path autosar:IMPLEMENTATION-DATA-TYPE-REF ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;

    # POST-BUILD-VALUE-ACCESS-REF [0..1]
    sh:property [
        sh:path autosar:POST-BUILD-VALUE-ACCESS-REF ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] ;

    # POST-BUILD-VARIANT-CONDITION [0..*] via POST-BUILD-VARIANT-CONDITIONS
    sh:property [
        sh:path ( autosar:POST-BUILD-VARIANT-CONDITIONS autosar:POST-BUILD-VARIANT-CONDITION ) ;
        sh:severity sh:Violation ;
    ] ;

    # VALUE-ACCESS [0..1]
    sh:property [
        sh:path autosar:VALUE-ACCESS ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
    ] .

# 5) constr_1255 – ApplicationPrimitiveDataTypes of category BOOLEAN and STRING
# 结构层：UNIT-REF 的 DEST 类型由 schema 处理，此处不再重复；逻辑约束交由 SMT。

# 6) constr_1256 – Acknowledgement feedback in n:1 writer case
# 结构层：仅建模 SwcInternalBehavior 中 RUNNABLE-ENTITY 的基本存在性

autosar:Constr_1256_SwcInternalBehaviorShape
    a sh:NodeShape ;
    sh:targetClass autosar:SWC-INTERNAL-BEHAVIOR ;
    sh:property [
        sh:path ( autosar:RUNNABLES autosar:RUNNABLE-ENTITY ) ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
    ] .

# 7) constr_1257 – No WaitPoints allowed
# 结构层：InitEvent.startOnEventRef 的类型由 DEST 处理；“不得聚合 WaitPoint”交由 SMT。


#################################################################
# SHACL shapes
#################################################################

########## constr_1258 ##########
# Value of minimumStartInterval for RunnableEntitys triggered by an InitEvent

autosar:constr_1258_MinimumStartIntervalInitEventShape
    a sh:NodeShape ;
    sh:targetClass autosar:INIT-EVENT ;
    sh:severity sh:Violation ;
    sh:message "The value of ExecutableEntity.minimumStartInterval for a RunnableEntity that is triggered by an InitEvent shall always be set to 0." ;
    sh:property [
        sh:path ( autosar:RUNNABLE-ENTITY autosar:MINIMUM-START-INTERVAL ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue 0
    ] .

########## constr_1259 ##########
# Aggregation of AsynchronousServerCallPoint and AsynchronousServerCallResultPoint

# SHACL cannot easily express the cross-element aggregation condition here in a stable way,
# so this constraint is handled in SMT only. No SHACL shape emitted.

########## constr_1260 ##########
# No mode disabling for InitEvents

autosar:constr_1260_NoModeDisablingInitEventShape
    a sh:NodeShape ;
    sh:targetClass autosar:INIT-EVENT ;
    sh:severity sh:Violation ;
    sh:message "An InitEvent shall not have a reference to a ModeDeclaration in the role disabledMode." ;
    sh:property [
        sh:path ( autosar:DISABLED-MODE-IREFS autosar:DISABLED-MODE-IREF ) ;
        sh:maxCount 0
    ] .

########## constr_1261 ##########
# Applicability for EndToEndDescription.dataIdNibbleOffset

autosar:constr_1261_E2EDataIdNibbleOffsetShape
    a sh:NodeShape ;
    sh:targetClass autosar:END-TO-END-DESCRIPTION ;
    sh:severity sh:Info ;
    sh:message "EndToEndDescription.dataIdNibbleOffset shall be used only if dataIdMode = 3 and category = PROFILE_01." ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "DATA-ID-NIBBLE-OFFSET is present although DATA-ID-MODE != 3 or CATEGORY != PROFILE_01." ;
        sh:severity sh:Violation ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this
            WHERE {
              ?this autosar:CATEGORY ?cat .
              OPTIONAL { ?this autosar:DATA-ID-MODE ?mode . }
              OPTIONAL { ?this autosar:DATA-ID-NIBBLE-OFFSET ?offset . }
              FILTER(BOUND(?offset) && ( ?mode != 3 || ?cat != "PROFILE_01" ))
            }
        """
    ] .

########## constr_1263 ##########
# Existence of ModeErrorBehavior.defaultMode

autosar:constr_1263_ModeErrorBehaviorDefaultModeShape
    a sh:NodeShape ;
    sh:targetClass autosar:MODE-ERROR-BEHAVIOR ;
    sh:severity sh:Violation ;
    sh:message "The optional attribute ModeErrorBehavior.defaultMode shall exist if errorReactionPolicy is set to defaultMode." ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "ERROR-REACTION-POLICY is defaultMode but DEFAULT-MODE-REF is missing." ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this
            WHERE {
              ?this autosar:ERROR-REACTION-POLICY ?pol .
              FILTER(?pol = "defaultMode")
              FILTER NOT EXISTS { ?this autosar:DEFAULT-MODE-REF ?dm . }
            }
        """
    ] .

########## constr_1264 ##########
# Iteration along output axis is only supported for VALUE and VAL_BLK

autosar:constr_1264_SwRecordLayoutVIndexShape
    a sh:NodeShape ;
    sh:targetClass autosar:SW-RECORD-LAYOUT-V ;
    sh:severity sh:Violation ;
    sh:message "swRecordLayoutVIndex in SwRecordLayoutV cannot be 0 for any category other than VALUE and VAL_BLK." ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "SW-RECORD-LAYOUT-V-INDEX is 0 while CATEGORY is neither VALUE nor VAL_BLK." ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this
            WHERE {
              OPTIONAL { ?this autosar:CATEGORY ?cat . }
              OPTIONAL { ?this autosar:SW-RECORD-LAYOUT-V-INDEX ?idx . }
              FILTER(BOUND(?idx) && ?idx = 0 && ( ?cat != "VALUE" && ?cat != "VAL_BLK" ))
            }
        """
    ] .

########## constr_1268 ##########
# ArgumentDataPrototype.direction shall be preserved in a ClientServerOperationMapping

# The constraint talks about two mapped ArgumentDataPrototype within a ClientServerOperationMapping.
# This mapping relation is not explicitly available in the provided structural data,
# so the precise equality condition is handled in SMT only. No SHACL shape emitted.


# 1) SHACL 约束

#################################################################
# constr_1269 - Number of arguments shall be preserved in a ClientServerOperationMapping
#################################################################

autosar:constr_1269 a sh:NodeShape ;
  sh:severity sh:Violation ;
  sh:targetClass autosar:CLIENT-SERVER-OPERATION-MAPPING ;
  sh:message "Within the context of a ClientServerOperationMapping, the number of arguments of firstOperation and secondOperation shall be identical." ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "The number of arguments of firstOperation and secondOperation in this ClientServerOperationMapping is not identical." ;
    sh:select """
      PREFIX autosar: <http://autosar.org/>
      SELECT ?this
      WHERE {
        ?this a autosar:CLIENT-SERVER-OPERATION-MAPPING .

        ?this autosar:FIRST-OPERATION-REF ?firstOpRef .
        ?this autosar:SECOND-OPERATION-REF ?secondOpRef .

        ?firstOpRef autosar:REFERS-TO ?firstOp .
        ?secondOpRef autosar:REFERS-TO ?secondOp .

        ?firstOp a autosar:CLIENT-SERVER-OPERATION .
        ?secondOp a autosar:CLIENT-SERVER-OPERATION .

        {
          SELECT ?firstOp (COUNT(?arg1) AS ?cnt1)
          WHERE {
            ?firstOp autosar:ARGUMENTS ?args1 .
            ?args1 autosar:ARGUMENT-DATA-PROTOTYPE ?arg1 .
          }
          GROUP BY ?firstOp
        }

        {
          SELECT ?secondOp (COUNT(?arg2) AS ?cnt2)
          WHERE {
            ?secondOp autosar:ARGUMENTS ?args2 .
            ?args2 autosar:ARGUMENT-DATA-PROTOTYPE ?arg2 .
          }
          GROUP BY ?secondOp
        }

        FILTER (?cnt1 != ?cnt2)
      }
    """ ;
  ] .

#################################################################
# constr_1270 - ArgumentDataPrototype shall be mapped only once in a ClientServerOperationMapping
#################################################################

autosar:constr_1270 a sh:NodeShape ;
  sh:severity sh:Violation ;
  sh:targetClass autosar:CLIENT-SERVER-OPERATION-MAPPING ;
  sh:message "Within the context of a ClientServerOperationMapping, each argument shall only be referenced once in the role firstDataPrototype or secondDataPrototype." ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "An ArgumentDataPrototype is referenced more than once as firstDataPrototype/secondDataPrototype within this ClientServerOperationMapping." ;
    sh:select """
      PREFIX autosar: <http://autosar.org/>
      SELECT ?this
      WHERE {
        ?this a autosar:CLIENT-SERVER-OPERATION-MAPPING .

        ?this autosar:ARGUMENT-MAPPINGS ?amCont .
        ?amCont autosar:DATA-PROTOTYPE-MAPPING ?m1 .

        ?m1 autosar:FIRST-DATA-PROTOTYPE-REF|autosar:SECOND-DATA-PROTOTYPE-REF ?ref1 .
        ?ref1 autosar:REFERS-TO ?arg .

        ?this autosar:ARGUMENT-MAPPINGS ?amCont2 .
        ?amCont2 autosar:DATA-PROTOTYPE-MAPPING ?m2 .

        ?m2 autosar:FIRST-DATA-PROTOTYPE-REF|autosar:SECOND-DATA-PROTOTYPE-REF ?ref2 .
        ?ref2 autosar:REFERS-TO ?arg .

        FILTER (?m1 != ?m2)
      }
      GROUP BY ?this ?arg
      HAVING (COUNT(*) > 1)
    """ ;
  ] .

#################################################################
# constr_1271 - RecordValueSpecification.elements vs ApplicationRecordDataType.elements
#################################################################

autosar:constr_1271 a sh:NodeShape ;
  sh:severity sh:Violation ;
  sh:targetClass autosar:DATA-PROTOTYPE ;
  sh:message "For a DataPrototype typed by an ApplicationRecordDataType, the number of RecordValueSpecification.fields shall equal the number of ApplicationRecordDataType.elements." ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "RecordValueSpecification.fields do not match the number of ApplicationRecordDataType.elements for this DataPrototype." ;
    sh:select """
      PREFIX autosar: <http://autosar.org/>
      SELECT ?this
      WHERE {
        ?this autosar:TYPE-TREF ?typeRef .
        ?typeRef autosar:REFERS-TO ?appRecType .
        ?appRecType a autosar:APPLICATION-RECORD-DATA-TYPE .

        {
          SELECT ?appRecType (COUNT(?el) AS ?cntEl)
          WHERE {
            ?appRecType autosar:ELEMENTS ?els .
            ?els autosar:APPLICATION-RECORD-ELEMENT ?el .
          }
          GROUP BY ?appRecType
        }

        ?this autosar:INIT-VALUE ?initVal .
        ?initVal autosar:RECORD-VALUE-SPECIFICATION ?rvs .

        {
          SELECT ?rvs (COUNT(?f) AS ?cntFld)
          WHERE {
            ?rvs autosar:FIELDS ?f .
          }
          GROUP BY ?rvs
        }

        FILTER (?cntEl != ?cntFld)
      }
    """ ;
  ] .

#################################################################
# constr_1272 - RecordValueSpecification.elements vs ImplementationDataType.subElements (STRUCTURE)
#################################################################

autosar:constr_1272 a sh:NodeShape ;
  sh:severity sh:Violation ;
  sh:targetClass autosar:DATA-PROTOTYPE ;
  sh:message "For a DataPrototype typed by an ImplementationDataType of category STRUCTURE, the number of RecordValueSpecification.fields shall equal the number of ImplementationDataType.subElements." ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "RecordValueSpecification.fields do not match the number of subElements of the STRUCTURE ImplementationDataType for this DataPrototype." ;
    sh:select """
      PREFIX autosar: <http://autosar.org/>
      SELECT ?this
      WHERE {
        ?this autosar:TYPE-TREF ?typeRef .
        ?typeRef autosar:REFERS-TO ?implType .
        ?implType a autosar:IMPLEMENTATION-DATA-TYPE .
        ?implType autosar:CATEGORY "STRUCTURE" .

        {
          SELECT ?implType (COUNT(?se) AS ?cntSe)
          WHERE {
            ?implType autosar:SUB-ELEMENTS ?seCont .
            ?seCont autosar:IMPLEMENTATION-DATA-TYPE-ELEMENT ?se .
          }
          GROUP BY ?implType
        }

        ?this autosar:INIT-VALUE ?initVal .
        ?initVal autosar:RECORD-VALUE-SPECIFICATION ?rvs .

        {
          SELECT ?rvs (COUNT(?f) AS ?cntFld)
          WHERE {
            ?rvs autosar:FIELDS ?f .
          }
          GROUP BY ?rvs
        }

        FILTER (?cntSe != ?cntFld)
      }
    """ ;
  ] .

#################################################################
# constr_1273 - ArrayValueSpecification.elements vs ApplicationArrayDataType.element.maxNumberOfElements
#################################################################

autosar:constr_1273 a sh:NodeShape ;
  sh:severity sh:Violation ;
  sh:targetClass autosar:DATA-PROTOTYPE ;
  sh:message "For a DataPrototype typed by an ApplicationArrayDataType, the number of ArrayValueSpecification.elements shall equal ApplicationArrayDataType.element.maxNumberOfElements." ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "ArrayValueSpecification.elements do not match ApplicationArrayDataType.element.maxNumberOfElements for this DataPrototype." ;
    sh:select """
      PREFIX autosar: <http://autosar.org/>
      SELECT ?this
      WHERE {
        ?this autosar:TYPE-TREF ?typeRef .
        ?typeRef autosar:REFERS-TO ?appArrType .
        ?appArrType a autosar:APPLICATION-ARRAY-DATA-TYPE .

        ?appArrType autosar:ELEMENT ?elem .
        ?elem autosar:MAX-NUMBER-OF-ELEMENTS ?maxNum .

        ?this autosar:INIT-VALUE ?initVal .
        ?initVal autosar:ARRAY-VALUE-SPECIFICATION ?avs .

        {
          SELECT ?avs (COUNT(?e) AS ?cntEl)
          WHERE {
            ?avs autosar:ELEMENTS ?e .
          }
          GROUP BY ?avs
        }

        FILTER (?cntEl != ?maxNum)
      }
    """ ;
  ] .

#################################################################
# constr_1274 - ArrayValueSpecification.elements vs ImplementationDataType.subElement.arraySize (ARRAY)
#################################################################

autosar:constr_1274 a sh:NodeShape ;
  sh:severity sh:Violation ;
  sh:targetClass autosar:DATA-PROTOTYPE ;
  sh:message "For a DataPrototype typed by an ImplementationDataType of category ARRAY, the number of ArrayValueSpecification.elements shall equal ImplementationDataType.subElement.arraySize." ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "ArrayValueSpecification.elements do not match ImplementationDataType.subElement.arraySize for this DataPrototype." ;
    sh:select """
      PREFIX autosar: <http://autosar.org/>
      SELECT ?this
      WHERE {
        ?this autosar:TYPE-TREF ?typeRef .
        ?typeRef autosar:REFERS-TO ?implType .
        ?implType a autosar:IMPLEMENTATION-DATA-TYPE .
        ?implType autosar:CATEGORY "ARRAY" .

        ?implType autosar:SUB-ELEMENTS ?seCont .
        ?seCont autosar:IMPLEMENTATION-DATA-TYPE-ELEMENT ?se .
        ?se autosar:ARRAY-SIZE ?arraySize .

        ?this autosar:INIT-VALUE ?initVal .
        ?initVal autosar:ARRAY-VALUE-SPECIFICATION ?avs .

        {
          SELECT ?avs (COUNT(?e) AS ?cntEl)
          WHERE {
            ?avs autosar:ELEMENTS ?e .
          }
          GROUP BY ?avs
        }

        FILTER (?cntEl != ?arraySize)
      }
    """ ;
  ] .

