    sh:targetClass autosar:SENDER-RECEIVER-INTERFACE ;
    sh:severity sh:Violation ;

    sh:property [
        sh:path ( autosar:DATA-ELEMENTS autosar:VARIABLE-DATA-PROTOTYPE ) ;
        sh:minCount 1
    ] .


# 6) Figure_6_11
# "Illegal split of delegation connector: Data set partitioning"
# Requires global reasoning over sets of DataPrototypes across connectors; not expressible in simple SHACL paths.
# No SHACL shape emitted; handled in SMT.


# 7) Figure_6_12
# "Illegal merge of delegation connector: Interface compatibility"
# Requires global reasoning over interface compatibility across multiple connectors; not expressible in simple SHACL paths.
# No SHACL shape emitted; handled in SMT.


# 1) Invalid end-to-end delegation of SwConnectors
# 语义涉及复杂拓扑与接口匹配，缺少可观测结构路径信息，交由 SMT 处理，此处不生成 SHACL。

