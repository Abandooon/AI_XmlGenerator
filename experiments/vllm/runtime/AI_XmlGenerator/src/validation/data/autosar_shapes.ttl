    sh:targetClass autosar:DATA-PROTOTYPE ;
    sh:severity sh:Info ;
    sh:message "A DataPrototype represents the implementation of a role of a data type (is-of-type relation, aggregated by another element)." .

# 7) TPS_SWCT_01265 – DataPrototype aggregates an own set of SwDataDefProps
# 关键语义：DataPrototype 拥有自己的 SwDataDefProps，可覆盖其 Application/ImplementationDataType 的 SwDataDefProps
# 这里仅建模“若存在则至多一个”，不强制必须存在

autosar:TPS_SWCT_01265_AutosarDataTypeSwDataDefPropsShape
    a sh:NodeShape ;
    sh:targetClass autosar:APPLICATION-ARRAY-DATA-TYPE ,autosar:APPLICATION-RECORD-DATA-TYPE ,autosar:APPLICATION-PRIMITIVE-DATA-TYPE ;
    sh:severity sh:Info ;
    sh:message "ApplicationDataType may define its own SW-DATA-DEF-PROPS, which can be extended/overwritten by DataPrototype." ;
    sh:property [
        sh:path autosar:SW-DATA-DEF-PROPS ;
        sh:maxCount 1 ;
    ] .

autosar:TPS_SWCT_01265_DataPrototypeSwDataDefPropsShape
    a sh:NodeShape ;
    sh:targetClass autosar:APPLICATION-ARRAY-ELEMENT ,autosar:APPLICATION-RECORD-ELEMENT ,autosar:ARGUMENT-DATA-PROTOTYPE ,autosar:PARAMETER-DATA-PROTOTYPE ,autosar:VARIABLE-DATA-PROTOTYPE ;
    sh:severity sh:Info ;
    sh:message "Each kind of DataPrototype may aggregate its own SW-DATA-DEF-PROPS to extend/overwrite those of its data type." ;
    sh:property [
        sh:path autosar:SW-DATA-DEF-PROPS ;
        sh:maxCount 1 ;
    ] .



# 1) TPS_SWCT_01269 – In PortInterfaces, initial values defined for DataPrototypes are ignored
