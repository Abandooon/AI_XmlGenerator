# SHACL

# TPS_SWCT_02046 - byPassPoint specifies the rapid prototyping capability
autosar:TPS_SWCT_02046_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:RAPID-PROTOTYPING-SCENARIO ;
    sh:property [
        sh:path ( autosar:RPT-CONTAINER autosar:BY-PASS-POINT-IREFS autosar:BY-PASS-POINT-IREF ) ;
        sh:minCount 1 ;
        sh:message "RAPID-PROTOTYPING-SCENARIO shall define at least one BY-PASS-POINT-IREF to describe rapid prototyping capability." ;
        sh:severity sh:Violation ;
    ] .

# TPS_SWCT_02047 - rptHook specifies the link to rapid prototyping algorithm
# 结构性部分：rptHook / codeLabel / mcdIdentifier / rptArHook 的可选存在
autosar:TPS_SWCT_02047_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:RPT-CONTAINER ;
    sh:property [
        sh:path ( autosar:RPT-CONTAINER autosar:RPT-HOOKS autosar:RPT-HOOK ) ;
        sh:message "RPT-CONTAINER may define RPT-HOOK elements to link byPassPoints to rapid prototyping algorithms." ;
        sh:severity sh:Info ;
    ] .

# RPT-HOOK 内部结构（if-present-then-type）
autosar:RPT-HOOK_Structure_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:RPT-HOOK ;

    # CODE-LABEL (optional)
    sh:property [
        sh:path autosar:CODE-LABEL ;
        sh:message "CODE-LABEL, if present in RPT-HOOK, represents a C identifier for the rapid prototyping hook." ;
        sh:severity sh:Info ;
    ] ;

    # MCD-IDENTIFIER (optional)
    sh:property [
        sh:path autosar:MCD-IDENTIFIER ;
        sh:message "MCD-IDENTIFIER, if present in RPT-HOOK, represents an MCD identifier for the rapid prototyping hook." ;
        sh:severity sh:Info ;
    ] ;

    # RPT-AR-HOOK-IREF (optional)
    sh:property [
        sh:path autosar:RPT-AR-HOOK-IREF ;
        sh:message "RPT-AR-HOOK-IREF, if present in RPT-HOOK, links the hook to an AUTOSAR Software Component." ;
        sh:severity sh:Info ;
    ] .

