@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix autosar: <http://autosar.org/> .

#################################################################
# SHACL shapes
#################################################################

#################################################################
# 4.3.1_Constr_SwConnector_PIMReference
# SwConnector Reference to PortInterfaceMapping
#################################################################

# 目标类是 PortInterfaceMapping，本身不携带 MAPPING-REF；
# 该约束主要是跨文件/跨元素关系，由 SMT 负责逻辑。
# 仅建一个空的结构 shape 以便分组（不强制任何结构）。
autosar:4.3.1_Constr_SwConnector_PIMReference_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:PORT-INTERFACE-MAPPING ;
    sh:severity sh:Violation ;
    sh:message "To apply a PortInterfaceMapping, a SwConnector has to reference that PortInterfaceMapping." .

#################################################################
# ComMgrUserNeeds_PortGroupAssociation
# ComMgrUserNeeds PortGroup Association
#################################################################

# 目标类：COM-MGR-USER-NEEDS
# 结构上只知道有一个 SWC-SERVICE-DEPENDENCY/REPRESENTED-PORT-GROUP-REF
# 的引用可以指向 PORT-GROUP。逻辑“定义哪个 PortGroup 与该 user 关联”
# 交由 SMT 处理。
autosar:ComMgrUserNeeds_PortGroupAssociation_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:COM-MGR-USER-NEEDS ;
    sh:severity sh:Info ;
    sh:message "ComMgrUserNeeds defines which PortGroup is associated with this user." .

#################################################################
# Constr_4.8_BSWInterfacingAlternatives
# BSW Interfacing Alternatives for Partial Networking
#################################################################

# 纯行为/建模风格约束，不做结构性 SHACL 规则。
# 留空，仅作信息提示。
autosar:Constr_4.8_BSWInterfacingAlternatives_Shape
    a sh:NodeShape ;
    sh:severity sh:Info ;
    sh:message "BSW for partial networking shall be interfaced in exactly one of the standardized ways (ComM ClientServerInterface, ComM ModeSwitchInterface, or BswM ModeSwitchInterface)." .

#################################################################
# Constr_4.8_ComMRetrievalChoice
# Choice of ComM Retrieval Method for Software Component Author
#################################################################

autosar:Constr_4.8_ComMRetrievalChoice_Shape
    a sh:NodeShape ;
    sh:severity sh:Info ;
    sh:message "The ComM can be retrieved either via ClientServerInterface or SenderReceiverInterface; the choice is up to the software-component author." .

#################################################################
# Constr_4.8_PartialNetworkStatusCheck
# Partial Network Status Check Before Communication
#################################################################

autosar:Constr_4.8_PartialNetworkStatusCheck_Shape
    a sh:NodeShape ;
    sh:severity sh:Info ;
    sh:message "Before communicating via PortPrototypes that belong to a partial network, the software component shall consider the status of the partial network to assert its activity." .

#################################################################
# Constr_4.9_ConsistencyNeedsDefinitionContext
# Context for Defining ConsistencyNeeds in Component Types
#################################################################

# 目标类：CONSISTENCY-NEEDS（非抽象）
# 结构信息已经由 schema 提供；此处只给出信息性 shape。
autosar:Constr_4.9_ConsistencyNeedsDefinitionContext_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:CONSISTENCY-NEEDS ;
    sh:severity sh:Info ;
    sh:message "ConsistencyNeeds can be defined during the design of an AtomicSwComponentType as well as during the definition of CompositionSwComponentTypes." .

#################################################################
# Constr_AppImplDataTypeMap_VSADT
# Companion ImplementationDataType and DataTypeMap for ApplicationDataType VSADT
#################################################################

# 目标类：APPLICATION-DATA-TYPE
# 具体 VSADT 标识及 ImplementationDataType/DataTypeMap 关系由 SMT 处理。
autosar:Constr_AppImplDataTypeMap_VSADT_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:APPLICATION-DATA-TYPE ;
    sh:severity sh:Violation ;
    sh:message "If a Variable-Size Array Data Type is modeled on the level of ApplicationDataType, a companion ImplementationDataType and a DataTypeMap referring to both shall be provided." .


# 1) Compatibility between ApplicationRecordDataType and ApplicationArrayDataType
# 语义涉及“兼容性”和 PortInterfaceMapping，结构路径信息不足，交由 SMT 处理，此处不建 SHACL 形状。


# 2) Application Responsibility for Size Indicator Consistency
# 运行时行为约束（应用负责保持一致），不适合静态结构验证，不建 SHACL 形状。


# 3) Semantic Meaning of ApplicationCompositeDataType
# 说明性语句（不能整体赋语义，但可对部分元素赋语义），无可观测结构条件，不建 SHACL 形状。


# 4) Precedence of ApplicationDataType for Functional Values Type
# 结构上仅能表达“这些引用是可选的且类型正确”，优先由 SMT 表达“优先级/覆盖”逻辑，此处不建额外 SHACL 形状。


# 5) ShortName identity not required for ApplicationPrimitiveDataType compatibility
# 仅说明“兼容性不要求 shortName 相同”，无结构性约束，不建 SHACL 形状。


# 6) AUTOSAR-typed PerInstanceMemory C++/Pointer Type Restriction
# TYPE-TREF 的 DEST 集合已在元模型层面约束，此处不再重复 SHACL 约束。


# 7) Avoid mapping multiple RunnableEntitys to the same symbol
# 需要对同一 AtomicSwComponentType 下的 RUNNABLE-ENTITY/SYMBOL 做唯一性检查，使用 SPARQL 形状。


autosar:Constr_AvoidMultipleRunnableEntitysSameSymbol_7_2_4_Shape
    a sh:NodeShape ;
    # 抽象父类：依赖 RDFS 推理把所有子类实例也当成 target
    sh:targetClass autosar:ATOMIC-SW-COMPONENT-TYPE ;
    sh:severity sh:Warning ;

    rdfs:comment "Avoid mapping multiple RunnableEntitys to the same symbol for one AtomicSwComponentType."@en ;
    rdfs:comment "对同一 AtomicSwComponentType 下的 RunnableEntity/SYMBOL 做唯一性检查。"@zh ;

    sh:sparql [
        a sh:SPARQLConstraint ;

        # 违反时的提示信息（可直接用你 JSON 里的 expression）
        sh:message "Mapping several RunnableEntitys to the same symbol for an AtomicSwComponentType shall be avoided as this scenario is not supported by RTE."@en ;

        # 语义：同一组件 this 下，存在某个 symbol 被多个不同 runnable 使用
        sh:select """
            PREFIX autosar: <http://autosar.org/>

            SELECT ?this ?symbol
            WHERE {
              # 聚焦一个 AtomicSwComponentType（包括其具体子类，依赖 RDFS 推理）
              ?this a autosar:ATOMIC-SW-COMPONENT-TYPE .

              # 通过容器结构找到所有 RunnableEntity
              ?this autosar:INTERNAL-BEHAVIORS ?ib .
              ?ib   autosar:SWC-INTERNAL-BEHAVIORS ?sib .
              ?sib  autosar:RUNNABLES ?runnablesCont .
              ?runnablesCont autosar:RUNNABLE-ENTITY ?r .

              # 取出 SYMBOL
              ?r autosar:SYMBOL ?symbol .
            }
            GROUP BY ?this ?symbol
            HAVING (COUNT(DISTINCT ?r) > 1)
        """ ;
    ] .



# 1) Axis Description Determination by SwDataDefProps
autosar:Constr_AxisDescription_Determination
    a sh:NodeShape ;
    sh:targetClass autosar:SW-DATA-DEF-PROPS ;
    sh:severity sh:Info ;
    sh:message "Its SwDataDefProps determine an axis description. (documentation-level statement, no structural check encoded)" .

# 2) Axis Values Type Determination
# 语义涉及“类型已被设置”的时间性与推导关系，缺少可观测结构信号，交由 SMT 处理，此处不建 SHACL 结构约束。

# 3) Binding Time for Behavioral Element Variability
# 约束是“latest binding time 为 preCompileTime”，属于变体绑定时机语义，XML 中无直接结构信号，此处不建 SHACL 结构约束。

# 4) Completeness of Sender Value Mapping within a Single Bitfield Mask
# 语义是“BITFIELD_TEXTTABLE mask 内 sender 侧所有值都要有映射”，需要遍历和覆盖性检查，超出简单结构约束范围，不建 SHACL。

# 5) Calibration Parameter Access Definition via InstantiationDataDefProps
autosar:Constr_CalibParamAccess_InstantiationDataDefProps
    a sh:NodeShape ;
    sh:targetClass autosar:INSTANTIATION-DATA-DEF-PROPS ;
    sh:severity sh:Info ;
    sh:message "It is possible (but not required) to define access to calibration parameters on the level of InstantiationDataDefProps. No structural obligation is enforced." .

# 6) Consistency of SwRecordLayoutV/Group category values
autosar:Constr_CategoryConsistency_AuthorResponsibility
    a sh:NodeShape ;
    sh:targetClass autosar:SW-RECORD-LAYOUT ;
    sh:severity sh:Info ;
    sh:message "Consistency of SwRecordLayoutV.category and SwRecordLayoutGroup.category with the structure of SwRecordLayout is the author's responsibility. No automatic structural check encoded." .

# 7) Chapters support atpVariation with post-build binding time
# 语义是“各 Chapter 的 VARIATION-POINT 使用 atpVariation stereotype 且 latest binding time 为 post-build”，
# 需要对 VariationPoint 的语义属性进行解释，缺少结构化字段，交由 SMT/人工，不建 SHACL 结构约束。


# 1) Constr_ClientServerOperation_SyncAsyncExclusivity
# 行为/运行时约束，缺少可观测结构信号，不生成 SHACL 结构约束

# 2) Constr_ClientServer_StaticCorrectness_Rationale
# 纯说明性/动机性文本，不生成 SHACL

# 3) Constr_ComSpec_Optionality
# “通信规范是可选的” → 不强制任何存在性，因此不生成 SHACL 约束

# 4) Constr_ComSpec_PortInterface_Typing
# 需要区分 ComSpec 子类与 PortInterface 类型，当前输入缺少结构化字段，不生成 SHACL

# 5) Constr_ComSpec_Usage_Scope
# “使用不被限制在 AtomicSwComponentType” → 仅说明不应有额外限制，不生成 SHACL

# 6) Constr_CompositionSwCT_DataTypeMappingCapability
# 语义：应当可以为 CompositionSwComponentType 定义 DATA-TYPE-MAPPING-SET 与 CONSTANT-SPECIFICATION-MAPPING-SET 的映射。
# 这是“能力/可支持性”描述，而非“每个实例必须拥有”，因此不强制 minCount，仅做 if-present-then-type 结构约束。

autosar:Constr_CompositionSwCT_DataTypeMappingCapability_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:COMPOSITION-SW-COMPONENT-TYPE ;

    # DATA-TYPE-MAPPING-REF: if present, DEST must be DATA-TYPE-MAPPING-SET
    sh:property [
        sh:path ( autosar:DATA-TYPE-MAPPING-REFS autosar:DATA-TYPE-MAPPING-REF ) ;
        sh:message "If DATA-TYPE-MAPPING-REF is present, its DEST shall be DATA-TYPE-MAPPING-SET." ;
        sh:severity sh:Violation ;
        # 仅建模 DEST 类型约束；具体属性名由实现环境补充
    ] ;

    # CONSTANT-VALUE-MAPPING-REF: if present, DEST must be CONSTANT-SPECIFICATION-MAPPING-SET
    sh:property [
        sh:path ( autosar:CONSTANT-VALUE-MAPPING-REFS autosar:CONSTANT-VALUE-MAPPING-REF ) ;
        sh:message "If CONSTANT-VALUE-MAPPING-REF is present, its DEST shall be CONSTANT-SPECIFICATION-MAPPING-SET." ;
        sh:severity sh:Violation ;
    ] .


# 1) ComSpecs on PortPrototypes of CompositionSwComponentType
# Expression: PortPrototypes owned by CompositionSwComponentTypes can have ComSpecs.
# 仅说明“可以有”，无强制结构要求 → 不建硬性 SHACL 约束（由模型结构本身允许）

# 2) ComSpec Matching Not Required for Compositions
# Expression: 不要求匹配 → 纯放宽语义，不产生结构/逻辑约束


# 3) Naming Convention for Custom Category Values in EndToEndDescription
# 仅给出命名建议，且未给出可判定的“标准值集合”或前缀集合 → 不生成可执行 SHACL

# 4) Custom Profile and Category Value Prefix Recommendation
# 纯推荐性文字，无可观测前缀集合 → 不生成可执行 SHACL


# 5) Requirements for Cyclic Writing Strategy
# Expression: Cyclic writing use case requires NvBlockDescriptor.nvBlockNeeds.storeCyclic to be true
#             and NvBlockDescriptor.nvBlockNeeds.cyclicWritingPeriod to exist with a reasonable value.
# “Cyclic writing use case” 为运行时/配置语义触发条件，XML 中无直接可观测触发标志，
# 且“reasonable value”不可形式化 → 不生成 SHACL，由 SMT 处理逻辑部分（忽略“reasonable”）

# 6) NvBlockNeeds.cyclicWritingPeriod ignored in favor of TimingEvent.period
# Expression: The value of NvBlockDescriptor.nvBlockNeeds.cyclicWritingPeriod shall be ignored
#             in favor of NvBlockDescriptor.timingEvent.period.
# 运行时行为约束（忽略哪个值），非结构一致性 → 不生成 SHACL


# 7) DTC Configuration in ECUC
# Expression: The relevant DTCs shall be configured in ECUC ...
# 运行时/流程性要求，未给出可观测 XML 结构模式 → 不生成 SHACL


# 1) Constr_DataConstr_RequiringNoConstraints
# 语义是“如果需求方没有约束，则总是允许”，涉及运行时/语义兼容性，不建模结构性 SHACL 约束
# => 留空

# 2) Constr_DataElement_RTE_Mapping_Requirement
# 语义涉及 SenderReceiverInterface 中 dataElement 与 ImplementationDataType 的映射关系，
# 需要接口/端口/数据类型之间的全局关系，超出简单结构检查范围
# => 留空

# 3) Constr_DataIdAssignmentAuthority_E2E
# 仅说明 dataId 的分配责任方（组织流程），不适合作为静态模型约束
# => 留空

# 4) Constr_DataIdAvailability_E2E
# “信息在发送端和接收端都可用”涉及运行时配置/部署一致性，不是单个元素的局部结构约束
# => 留空

# 5) Constr_DelegatedPortAnnotation_SignalFan_Nfold_Merge_n_to_1
# 6) Constr_DelegatedPortAnnotation_SignalFan_Nfold_Split
# 7) Constr_DelegatedPortAnnotation_SignalFan_Single_Merge_1_to_x
# 三个约束都依赖于 VFB 上的通信模式（n:1、1:n、1:x）和端口集合的组合/拆分，
# 这些模式无法仅从单个 DELEGATED-PORT-ANNOTATION 的局部 XML 结构直接观测，
# 因此不生成局部 SHACL 结构约束。
# => 留空


# 1) DelegatedPortAnnotation signalFan for n:1 split (recommended)
autosar:Constr_DelegatedPortAnnotation_SignalFan_Single_Split_n_to_1
    a sh:NodeShape ;
    sh:targetClass autosar:COMPOSITION-SW-COMPONENT-TYPE ;
    sh:severity sh:Info ;
    sh:message "For an n:1 communication pattern on VFB with a delegation split, the attribute SIGNAL-FAN of DELEGATED-PORT-ANNOTATION should be set to 'single'."@en ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For an n:1 communication pattern with delegation split, DelegatedPortAnnotation/SIGNAL-FAN should be 'single'."@en ;
        sh:select """
PREFIX autosar: <http://autosar.org/>

SELECT ?this ?delegAnn ?signalFan
WHERE {
  ?this a autosar:COMPOSITION-SW-COMPONENT-TYPE .

  # NOTE: The detection of an n:1 split communication pattern is domain-specific
  # and not fully observable from the given structural information.
  # Here we only check: if a DelegatedPortAnnotation exists and is marked as split
  # (via some project-specific indicator), then SIGNAL-FAN should be 'single'.
  # Implementers may need to refine the trigger pattern.

  ?this autosar:DELEGATED-PORT-ANNOTATION ?delegAnn .
  ?delegAnn autosar:SIGNAL-FAN ?signalFan .

  FILTER (?signalFan != "single")
}
""" ;
    ] .



# 2) Compatibility rules for delegation split apply per SwConnector
# No stable structural pattern given -> SHACL left empty on purpose.



# 3) Dependent Parameter Adjustability Recommendation
# No structural hooks given -> SHACL left empty on purpose.



# 4) Dependent Parameter Automatic Adjustment
autosar:Constr_DependentParameter_Adjustment
    a sh:NodeShape ;
    sh:targetClass autosar:PARAMETER-DATA-PROTOTYPE ;
    sh:severity sh:Info ;
    sh:message "Upon adjusting one of the parameters, the dependent parameter is automatically adjusted according to SW-DATA-DEPENDENCY-FORMULA."@en ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Dependent parameters should have a SW-DATA-DEPENDENCY-FORMULA defined on SW-DATA-DEPENDENCY to describe automatic adjustment."@en ;
        sh:select """
PREFIX autosar: <http://autosar.org/>

SELECT ?this
WHERE {
  ?this a autosar:PARAMETER-DATA-PROTOTYPE .

  # This is a soft recommendation: if a parameter is modeled as dependent
  # (implementation-specific detection), then there should be a SW-DATA-DEPENDENCY
  # with SW-DATA-DEPENDENCY-FORMULA present.
  # Here we only check that if a SW-DATA-DEPENDENCY exists, it should carry a formula.

  ?this autosar:SW-DATA-DEPENDENCY ?dep .
  FILTER NOT EXISTS {
    ?dep autosar:SW-DATA-DEPENDENCY-FORMULA ?formula .
  }
}
""" ;
    ] .



# 5) Influencing Dependent Parameter Value
# Behavioral / runtime semantics only -> SHACL left empty on purpose.



# 6) Purpose of DiagEventDebounceAlgorithm inheriting Identifiable
# Purely explanatory / meta-model design rationale -> SHACL left empty on purpose.



# 7) RoleBasedPortAssignment for Dlt Service ClientServerInterface
autosar:Constr_DltService_RoleBasedPortAssignment_Rule
    a sh:NodeShape ;
    sh:targetClass autosar:CLIENT-SERVER-INTERFACE ;
    sh:severity sh:Violation ;
    sh:message "For every used ClientServerInterface in the Dlt Service use case, a ROLE-BASED-PORT-ASSIGNMENT must exist and its ROLE must equal the name of the standardized ClientServerInterface."@en ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Missing or inconsistent ROLE-BASED-PORT-ASSIGNMENT for this CLIENT-SERVER-INTERFACE in the Dlt Service use case."@en ;
        sh:select """
PREFIX autosar: <http://autosar.org/>

SELECT ?this
WHERE {
  ?this a autosar:CLIENT-SERVER-INTERFACE .

  # Assume ?this autosar:SHORT-NAME ?sn is available as the standardized name.
  OPTIONAL { ?this autosar:SHORT-NAME ?sn . }

  # For the Dlt Service use case, there should be at least one ROLE-BASED-PORT-ASSIGNMENT
  # whose ROLE equals this standardized name.
  FILTER NOT EXISTS {
    ?this autosar:ROLE-BASED-PORT-ASSIGNMENT ?rpa .
    ?rpa autosar:ROLE ?roleVal .
    ?this autosar:SHORT-NAME ?sn .
    FILTER (?roleVal = ?sn)
  }
}
""" ;
    ] .


#################################################################
# SHACL for AUTOSAR constraints
#################################################################

#################################################################
# 1) Port requirements for AtomicSwComponentType in DLT use case
#    (DLTService, LogTraceSessionControl, VerboseModeControl, InjectionCallback)
#################################################################

autosar:Constr_DltUseCase_PortRequirements_AtomicSwComponentType
    a sh:NodeShape ;
    sh:targetClass autosar:ATOMIC-SW-COMPONENT-TYPE ;

    # At least one client port named "DLTService"
    sh:sparql [
        sh:message "AtomicSwComponentType shall provide at least one Client Port named 'DLTService'." ;
        sh:severity sh:Violation ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this
            WHERE {
              ?this a autosar:ATOMIC-SW-COMPONENT-TYPE .
              FILTER NOT EXISTS {
                ?this autosar:PORTS ?ports .
                ?ports autosar:P-PORT-PROTOTYPE ?pport .
                ?pport autosar:SHORT-NAME ?sn .
                FILTER (STR(?sn) = "DLTService")
              }
            }
        """ ;
    ] ;

    # At least one server port named "LogTraceSessionControl"
    sh:sparql [
        sh:message "AtomicSwComponentType shall provide at least one Server Port named 'LogTraceSessionControl'." ;
        sh:severity sh:Violation ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this
            WHERE {
              ?this a autosar:ATOMIC-SW-COMPONENT-TYPE .
              FILTER NOT EXISTS {
                ?this autosar:PORTS ?ports .
                ?ports autosar:R-PORT-PROTOTYPE ?rport .
                ?rport autosar:SHORT-NAME ?sn .
                FILTER (STR(?sn) = "LogTraceSessionControl")
              }
            }
        """ ;
    ] ;

    # Optional server ports VerboseModeControl and InjectionCallback:
    # no structural constraint beyond normal typing, so no extra SHACL here
.

#################################################################
# 2) DltUserNeeds and SwcServiceDependency for DLT configuration
#################################################################

# Purely descriptive relationship; no enforceable structural rule
# → no SHACL constraints generated.

#################################################################
# 3) DoIpActivationLineNeeds definition triggers PPortPrototype existence
#################################################################

autosar:Constr_DoIpActivationLineNeeds_Triggers_PPort
    a sh:NodeShape ;
    sh:targetClass autosar:DO-IP-ACTIVATION-LINE-NEEDS ;

    sh:sparql [
        sh:message "If DoIpActivationLineNeeds is defined, at least one PPortPrototype shall exist in the associated SWC." ;
        sh:severity sh:Info ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this
            WHERE {
              ?this a autosar:DO-IP-ACTIVATION-LINE-NEEDS .
              # Structural link to the owning SWC is not explicit in this model,
              # so this is only an informational check placeholder.
            }
        """ ;
    ]
.

#################################################################
# 4) Practical Collocation of ECU Abstraction and SensorActuatorSwComponentType
#################################################################

# This is a practical recommendation about deployment/collocation,
# not a structural XML constraint → no SHACL generated.

#################################################################
# 5) Requirement for Emergency Writing Strategy
#    NvBlockDescriptor.nvBlockNeeds.storeEmergency = true
#################################################################

autosar:Constr_EmergencyWrite_Requirement_from_TPS_SWCT_01586
    a sh:NodeShape ;
    sh:targetClass autosar:NV-BLOCK-DESCRIPTOR ;

    # NV-BLOCK-NEEDS must exist (minOccurs=1)
    sh:property [
        sh:path autosar:NV-BLOCK-NEEDS ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "NvBlockDescriptor shall have exactly one NV-BLOCK-NEEDS." ;
    ] ;

    # STORE-EMERGENCY = true (if present)
    sh:property [
        sh:path ( autosar:NV-BLOCK-NEEDS autosar:STORE-EMERGENCY ) ;
        sh:datatype xsd:boolean ;
        sh:severity sh:Violation ;
        sh:message "Emergency writing use case corresponds to NV-BLOCK-NEEDS/STORE-EMERGENCY = true." ;
    ] ;

    sh:sparql [
        sh:message "Emergency writing use case requires NV-BLOCK-NEEDS/STORE-EMERGENCY to be true." ;
        sh:severity sh:Violation ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
            SELECT ?this
            WHERE {
              ?this a autosar:NV-BLOCK-DESCRIPTOR .
              ?this autosar:NV-BLOCK-NEEDS ?needs .
              OPTIONAL { ?needs autosar:STORE-EMERGENCY ?se . }
              FILTER ( !BOUND(?se) || ?se != true )
            }
        """ ;
    ]
.

#################################################################
# 6) ExternalTriggeringPointIdent is a subclass of IdentCaption
#################################################################

# Class hierarchy constraint; typically handled in the ontology/TBox,
# not as instance-level SHACL. No additional SHACL needed here.

#################################################################
# 7) Optional 'ident' aggregation in ExternalTriggeringPoint
#################################################################

autosar:Constr_ExternalTriggeringPoint_OptionalIdentAggregation
    a sh:NodeShape ;
    sh:targetClass autosar:EXTERNAL-TRIGGERING-POINT ;

    sh:property [
        sh:path autosar:IDENT ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "ExternalTriggeringPoint may aggregate at most one IDENT (ExternalTriggeringPointIdent)." ;
    ]
.


# 所有给定约束均为行为性/结构性说明，缺乏可观测的 XML 结构或可计算字段，
# 无法在静态 ECU Extract / ARXML 结构层面进行自动验证。
