    a sh:NodeShape ;
    sh:targetClass autosar:IMPLEMENTATION-DATA-TYPE ;
    sh:severity sh:Info ;
    sh:message "ImplementationDataType is characterized by CATEGORY and SW-DATA-DEF-PROPS; for a given category only a limited set of SwDataDefProps attributes makes sense (semantic, not machine-enforced here)." ;
    sh:property [
        sh:path autosar:CATEGORY ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path autosar:SW-DATA-DEF-PROPS ;
        sh:maxCount 1 ;
    ] .

