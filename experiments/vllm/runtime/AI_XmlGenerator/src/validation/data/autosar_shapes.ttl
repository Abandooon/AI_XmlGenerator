# SHACL for constr_1141 - Applicability of the scope attribute
#################################################################



#################################################################
# SHACL for constr_1142 - category of CompuMethod shall not be extended
#################################################################

autosar:constr_1142_CompuMethodCategoryNotExtendedShape
    a sh:NodeShape ;
    sh:targetClass autosar:COMPU-METHOD ;
    sh:severity sh:Violation ;
    sh:message "The category of CompuMethod shall not be extended by user-specific values."@en ;
    sh:property [
        sh:path ( autosar:COMPU-METHOD autosar:CATEGORY ) ;
    ] .

#################################################################
# SHACL for constr_1143 - category of AutosarDataType shall not be extended
#################################################################

autosar:constr_1143_AutosarDataTypeCategoryNotExtendedShape
    a sh:NodeShape ;
    sh:severity sh:Violation ;
    sh:message "The category of AutosarDataType shall not be extended by user-specific values."@en ;
    sh:property [
        sh:path ( autosar:APPLICATION-ARRAY-DATA-TYPE autosar:CATEGORY ) ;
    ] ;
    sh:property [
        sh:path ( autosar:APPLICATION-RECORD-DATA-TYPE autosar:CATEGORY ) ;
    ] ;
    sh:property [
        sh:path ( autosar:APPLICATION-PRIMITIVE-DATA-TYPE autosar:CATEGORY ) ;
    ] ;
    sh:property [
        sh:path ( autosar:IMPLEMENTATION-DATA-TYPE autosar:CATEGORY ) ;
    ] .

#################################################################
# SHACL for constr_1144 - HwType-only references
#################################################################

autosar:constr_1144_HwTypeOnlyReferencesShape
    a sh:NodeShape ;
    sh:severity sh:Violation ;
    sh:message "sensorActuator and hardwareElement references may only reference a HwType."@en ;
    sh:property [
        sh:path ( autosar:SENSOR-ACTUATOR-SW-COMPONENT-TYPE autosar:SENSOR-ACTUATOR-REF ) ;
        sh:class autosar:HW-TYPE ;
    ] ;
    sh:property [
        sh:path ( autosar:ECU-ABSTRACTION-SW-COMPONENT-TYPE autosar:HARDWARE-ELEMENT-REFS autosar:HARDWARE-ELEMENT-REF ) ;
        sh:class autosar:HW-TYPE ;
    ] ;
    sh:property [
        sh:path ( autosar:COMPLEX-DEVICE-DRIVER-SW-COMPONENT-TYPE autosar:HARDWARE-ELEMENT-REFS autosar:HARDWARE-ELEMENT-REF ) ;
        sh:class autosar:HW-TYPE ;
    ] .


# ===== SHACL for constr_1146 =====
autosar:constr_1146 a sh:NodeShape ;
  sh:targetClass autosar:COMPU-SCALE ;
  sh:property [
    sh:path autosar:SYMBOL ;
    sh:message "SYMBOL shall only be provided if the enclosing COMPU-METHOD/CATEGORY is one of SCALE_LINEAR_AND_TEXTTABLE, SCALE_RATIONAL_AND_TEXTTABLE, TEXTTABLE, BITFIELD_TEXTTABLE." ;
    sh:severity sh:Violation
  ] .

# ===== SHACL for constr_1147 =====
autosar:constr_1147 a sh:NodeShape ;
  sh:targetClass autosar:PORT-GROUP ;
  sh:property [
    sh:path autosar:CATEGORY ;
    sh:in ( "MODE_MANAGEMENT" "PARTIAL_NETWORKING" ) ;
    sh:message "CATEGORY of PORT-GROUP uses standardized values MODE_MANAGEMENT or PARTIAL_NETWORKING (reserved by AUTOSAR)." ;
    sh:severity sh:Info
  ] .

# ===== SHACL for constr_1148 =====
# Target is PortInterface used with NvBlockSwComponentType; we only model the structural part:
autosar:constr_1148 a sh:NodeShape ;
  sh:targetClass autosar:CLIENT-SERVER-INTERFACE, autosar:NV-DATA-INTERFACE, autosar:PARAMETER-INTERFACE, autosar:SENDER-RECEIVER-INTERFACE, autosar:MODE-SWITCH-INTERFACE, autosar:TRIGGER-INTERFACE ;
  sh:property [
    sh:path autosar:IS-SERVICE ;
    sh:datatype xsd:boolean ;
    sh:hasValue false ;
    sh:message "IS-SERVICE shall be false for PortInterfaces of PortPrototypes used to connect to NvBlockSwComponentTypes." ;
    sh:severity sh:Violation
  ] .

# ===== SHACL for constr_1149 =====
# No structural details given; handled in SMT only.

# ===== SHACL for constr_1150 =====
# Structural typing only; logic in SMT.
autosar:constr_1150 a sh:NodeShape ;
  sh:targetClass autosar:PORT-DEFINED-ARGUMENT-VALUE ;
  sh:property [
    sh:path autosar:VALUE-TYPE-TREF ;
    sh:minCount 1 ;
    sh:message "PORT-DEFINED-ARGUMENT-VALUE shall have a VALUE-TYPE-TREF." ;
    sh:severity sh:Violation
  ] .

# ===== SHACL for constr_1151 =====
# Relationship constraint; handled in SMT only.

# ===== SHACL for constr_1152 =====
autosar:constr_1152 a sh:NodeShape ;
  sh:targetClass autosar:APPLICATION-ARRAY-ELEMENT ;
  sh:property [
    sh:path autosar:TYPE-TREF ;
    sh:minCount 1 ;
    sh:message "APPLICATION-ARRAY-ELEMENT shall have a TYPE-TREF." ;
    sh:severity sh:Violation
  ] ;
  sh:property [
    sh:path autosar:CATEGORY ;
    sh:message "CATEGORY of APPLICATION-ARRAY-ELEMENT shall be kept in sync with CATEGORY of referenced AutosarDataType (checked in SMT)." ;
    sh:severity sh:Violation
  ] .


#################################################################
# SHACL shapes
#################################################################

############ constr_1153 – Applicability of compatibility requirements for CompuScales
# Structural: restrict COMPU-METHOD/CATEGORY to the listed categories
autosar:Constr_1153_CompuMethod_Category_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:COMPU-METHOD ;
    sh:property [
        sh:path autosar:CATEGORY ;
        sh:in (
            "SCALE_LINEAR_AND_TEXTTABLE"
            "SCALE_RATIONAL_AND_TEXTTABLE"
            "TEXTTABLE"
            "TAB_NOINTP"
            "BITFIELD_TEXTTABLE"
            "LINEAR"
            "RAT_FUNC"
            "IDENTICAL"
        ) ;
        sh:severity sh:Violation ;
        sh:message "Compatibility requirements for CompuScales only apply if the enclosing COMPU-METHOD/CATEGORY is one of the allowed values." ;
    ] .

############ constr_1156 – Relevance of \"names\" of CompuScales
# Structural: COMPU-SCALE/COMPU-CONST is mandatory in this constraint’s context
autosar:Constr_1156_CompuScale_Structure_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:COMPU-SCALE ;
    sh:property [
        sh:path autosar:COMPU-CONST ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "For this constraint, only CompuScales with a COMPU-CONST are considered for name-based compatibility." ;
    ] .

############ constr_1158 – Applicable categories for ImplementationDataType.swDataDefProps.compuMethod
# Structural: COMPU-METHOD/CATEGORY restricted to BITFIELD_TEXTTABLE or TEXTTABLE
autosar:Constr_1158_CompuMethod_Category_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:COMPU-METHOD ;
    sh:property [
        sh:path autosar:CATEGORY ;
        sh:in (
            "BITFIELD_TEXTTABLE"
            "TEXTTABLE"
        ) ;
        sh:severity sh:Violation ;
        sh:message "ImplementationDataType.swDataDefProps.compuMethod shall reference a COMPU-METHOD whose CATEGORY is BITFIELD_TEXTTABLE or TEXTTABLE." ;
    ] .

############ constr_1159 – Consistency of VariableAndParameterInterfaceMapping
# No stable single-node structural pattern; handled in SMT only.


# SHACL shapes for the given constraints

#################################################################
# constr_1160 - Size of Compound Primitive Data Type is variant
# Purely semantic / value-range relation; no stable XML paths given.
# → Leave to SMT only (no SHACL shape).
#################################################################


#################################################################
# constr_1161 - Applicability of the index attribute of Ref
# Target: ANY-INSTANCE-REF
# Structural SHACL cannot express "index only used in certain use cases"
# without more detailed XML model of those use cases.
# → Leave to SMT only (no SHACL shape).
#################################################################


#################################################################
# constr_1162 - Compatibility of SwRecordLayouts
# Compatibility is a binary relation between two SW-RECORD-LAYOUTs.
# SHACL cannot naturally quantify over pairs of instances here.
# → Leave to SMT only (no SHACL shape).
#################################################################


#################################################################
# constr_1163 - Compatibility of CompuMethods
# Same situation as constr_1162.
# → Leave to SMT only (no SHACL shape).
#################################################################


#################################################################
# constr_1164 - Number of arguments owned by a RunnableEntity
#
# Expression talks about:
# - RunnableEntity.arguments (RUNNABLE-ENTITY/ARGUMENTS/RUNNABLE-ENTITY-ARGUMENT)
# - PortAPIOption.portArgValues (PORT-API-OPTION/PORT-ARG-VALUES/PORT-DEFINED-ARGUMENT-VALUE)
# - ClientServerOperation.arguments (CLIENT-SERVER-OPERATION/ARGUMENTS/ARGUMENT-DATA-PROTOTYPE)
# and equality of their counts in a specific reference context.
#
# This is global / cross-object cardinality equality → SMT.
# SHACL can only provide basic structural typing.
#################################################################

# RunnableEntityArgument structural shape (if present then correct type)
autosar:RunnableEntityArgument_StructuralShape
    a sh:NodeShape ;
    sh:targetClass autosar:RUNNABLE-ENTITY ;
    sh:property [
        sh:path ( autosar:ARGUMENTS autosar:RUNNABLE-ENTITY-ARGUMENT ) ;
        sh:node autosar:RunnableEntityArgument_NodeShape ;
    ] .

autosar:RunnableEntityArgument_NodeShape
    a sh:NodeShape ;
    sh:targetClass autosar:RUNNABLE-ENTITY-ARGUMENT .

# ArgumentDataPrototype structural shape
autosar:ArgumentDataPrototype_StructuralShape
    a sh:NodeShape ;
    sh:targetClass autosar:CLIENT-SERVER-OPERATION ;
    sh:property [
        sh:path ( autosar:ARGUMENTS autosar:ARGUMENT-DATA-PROTOTYPE ) ;
        sh:node autosar:ArgumentDataPrototype_NodeShape ;
    ] .

autosar:ArgumentDataPrototype_NodeShape
    a sh:NodeShape ;
    sh:targetClass autosar:ARGUMENT-DATA-PROTOTYPE .

# PortDefinedArgumentValue structural shape
autosar:PortDefinedArgumentValue_StructuralShape
    a sh:NodeShape ;
    sh:targetClass autosar:PORT-API-OPTION ;
    sh:property [
        sh:path ( autosar:PORT-ARG-VALUES autosar:PORT-DEFINED-ARGUMENT-VALUE ) ;
        sh:node autosar:PortDefinedArgumentValue_NodeShape ;
    ] .

autosar:PortDefinedArgumentValue_NodeShape
    a sh:NodeShape ;
    sh:targetClass autosar:PORT-DEFINED-ARGUMENT-VALUE .

# OperationInvokedEvent structural shape (references RunnableEntity)
autosar:OperationInvokedEvent_StructuralShape
    a sh:NodeShape ;
    sh:targetClass autosar:OPERATION-INVOKED-EVENT ;
    sh:property [
        sh:path autosar:START-ON-EVENT-REF ;
    ] ;
    sh:property [
        sh:path autosar:OPERATION-IREF ;
    ] .


#################################################################
# constr_1165 - Applicability of RunnableEntityArgument
#
# "The existence of a RunnableEntityArgument is limited to RunnableEntitys
#  triggered by a ClientServerOperation."
#
# This is a semantic condition on when arguments may exist, depending on
# trigger type. SHACL cannot see the trigger semantics; SMT will encode it.
# Structural typing already covered above.
#################################################################


#################################################################
# constr_1166 - Restrictions of ModeRequestTypeMap
#
# Complex cross-object existence condition involving:
# - ModeDeclarationGroupPrototype in PortPrototype
# - ModeSwitchInterface typing the PortPrototype
# - ModeRequestTypeMap in a DataTypeMappingSet
# - SwcInternalBehavior of the owning ApplicationSwComponentType
#
# This is a global ∀/∃ condition → SMT.
# No additional stable single-path structural constraint beyond
# standard AUTOSAR typing, so no extra SHACL here.
#################################################################


#################################################################
# SHACL for constr_1167
#################################################################

autosar:Constr_1167_ImplementationDataTypes_ModeRequestTypeMap
    a sh:NodeShape ;
    sh:targetClass autosar:IMPLEMENTATION-DATA-TYPE ;

    # CATEGORY must be VALUE or TYPE_REFERENCE
    sh:property [
        sh:path autosar:CATEGORY ;
        sh:in ( "VALUE" "TYPE_REFERENCE" ) ;
        sh:severity sh:Violation ;
        sh:message "ImplementationDataType used by ModeRequestTypeMap.implementationDataType shall have CATEGORY = VALUE or TYPE_REFERENCE." ;
    ] ;

    # BASE-TYPE-ENCODING of the referenced base type shall be NONE
    sh:property [
        sh:path ( autosar:SW-DATA-DEF-PROPS-CONTENT autosar:BASE-TYPE-REF ) ;
        sh:node [
            sh:property [
                sh:path ( autosar:BASE-TYPE-DIRECT-DEFINITION autosar:BASE-TYPE-ENCODING ) ;
                sh:hasValue "NONE" ;
            ]
        ] ;
        sh:severity sh:Violation ;
        sh:message "BaseTypeDirectDefinition.baseTypeEncoding of the baseType of the ImplementationDataType shall be NONE." ;
    ] .

#################################################################
# SHACL for constr_1168
# (purely behavioral / cross‑ID reference to constr_1167 & constr_1075)
# No stable structural pattern -> left to SMT only
#################################################################


#################################################################
# SHACL for constr_1169
#################################################################

autosar:Constr_1169_Trigger_swImplPolicy
    a sh:NodeShape ;
    sh:targetClass autosar:TRIGGER ;

    sh:property [
        sh:path autosar:SW-IMPL-POLICY ;
        sh:in ( "STANDARD" "QUEUED" ) ;
        sh:severity sh:Violation ;
        sh:message "Trigger.swImplPolicy shall be either STANDARD or QUEUED." ;
    ] .

#################################################################
# SHACL for constr_1170
# Complex conditional semantics; only minimal structural hints
#################################################################

autosar:Constr_1170_EndToEndDescription_Profile01
    a sh:NodeShape ;
    sh:targetClass autosar:END-TO-END-DESCRIPTION ;

    # CATEGORY exists and is PROFILE_01
    sh:property [
        sh:path autosar:CATEGORY ;
        sh:hasValue "PROFILE_01" ;
        sh:severity sh:Info ;
        sh:message "EndToEndDescription.category = PROFILE_01 participates in maxDeltaCounterInit interpretation (see constr_1170)." ;
    ] .

#################################################################
# SHACL for constr_1171
#################################################################

autosar:Constr_1171_EndToEndDescription_Profile02
    a sh:NodeShape ;
    sh:targetClass autosar:END-TO-END-DESCRIPTION ;

    # CATEGORY exists and is PROFILE_02
    sh:property [
        sh:path autosar:CATEGORY ;
        sh:hasValue "PROFILE_02" ;
        sh:severity sh:Info ;
        sh:message "EndToEndDescription.category = PROFILE_02 participates in maxDeltaCounterInit interpretation (see constr_1171)." ;
    ] .

#################################################################
# SHACL for constr_1172
#################################################################

autosar:Constr_1172_ModeDeclarationGroupPrototype_swCalibrationAccess
    a sh:NodeShape ;
    sh:targetClass autosar:MODE-DECLARATION-GROUP-PROTOTYPE ;

    sh:property [
        sh:path autosar:SW-CALIBRATION-ACCESS ;
        sh:in ( "notAccessible" "readOnly" ) ;
        sh:severity sh:Violation ;
        sh:message "ModeDeclarationGroupPrototype.swCalibrationAccess shall be either notAccessible or readOnly." ;
    ] .

#################################################################
# SHACL for constr_1173
# Applicability of AutosarParameterRef referencing VariableDataPrototype
# No stable structural discriminator for 'used in context of SwAxisGrouped'
# -> handled in SMT only
#################################################################


#################################################################
# SHACL shapes
#################################################################

########## constr_1174 ##########################################

autosar:Constr_1174 a sh:NodeShape ;
  sh:targetClass autosar:COMPOSITION-SW-COMPONENT-TYPE ;
  sh:severity sh:Violation ;
  sh:message "CompositionSwComponentTypes shall not own PortPrototypes typed by PortInterfaces where IS-SERVICE is true."@en ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "CompositionSwComponentTypes shall not own PortPrototypes typed by PortInterfaces where IS-SERVICE is true."@en ;
    sh:select """
      PREFIX autosar: <http://autosar.org/>
      SELECT ?this WHERE {
        ?this autosar:PORTS ?port .
        ?port autosar:REQUIRED-INTERFACE|autosar:PROVIDED-INTERFACE ?piRef .
        ?piRef autosar:DEST ?pi .
        ?pi autosar:IS-SERVICE ?isService .
        FILTER(?isService = true)
      }
    """ ;
  ] .

########## constr_1175 ##########################################

autosar:Constr_1175 a sh:NodeShape ;
  sh:targetClass autosar:COMPU-METHOD ;
  sh:severity sh:Violation ;
  sh:message "Depending on its category, CompuMethod shall refer to a unit unless category is TEXTTABLE, BITFIELD_TEXTTABLE, or IDENTICAL."@en ;
  sh:property [
    sh:path ( autosar:COMPU-METHOD autosar:UNIT-REF ) ;
    sh:class autosar:UNIT ;
    sh:severity sh:Violation ;
  ] ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "CompuMethod with category other than TEXTTABLE, BITFIELD_TEXTTABLE, IDENTICAL shall have a UNIT-REF."@en ;
    sh:select """
      PREFIX autosar: <http://autosar.org/>
      SELECT ?this WHERE {
        ?this autosar:CATEGORY ?cat .
        FILTER(?cat NOT IN ("TEXTTABLE", "BITFIELD_TEXTTABLE", "IDENTICAL")) .
        FILTER NOT EXISTS { ?this autosar:UNIT-REF ?uRef . }
      }
    """ ;
  ] .

########## constr_1176 ##########################################

# No SHACL structural constraint – handled purely in SMT because it is
# about numerical compatibility of two CompuScales.

########## constr_1177 ##########################################

autosar:Constr_1177 a sh:NodeShape ;
  sh:targetClass autosar:SW-POINTER-TARGET-PROPS ;
  sh:severity sh:Violation ;
  sh:message "Allowed targetCategory for SwPointerTargetProps: TYPE_REFERENCE or FUNCTION_REFERENCE; VALUE only if base type is void."@en ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "SwPointerTargetProps.targetCategory must be TYPE_REFERENCE or FUNCTION_REFERENCE, except VALUE is allowed if referenced SwBaseType has native type void."@en ;
    sh:select """
      PREFIX autosar: <http://autosar.org/>
      SELECT ?this WHERE {
        ?this autosar:TARGET-CATEGORY ?tc .
        FILTER(?tc NOT IN ("TYPE_REFERENCE", "FUNCTION_REFERENCE", "VALUE")) .
      }
    """ ;
  ] .

########## constr_1178 ##########################################

autosar:Constr_1178 a sh:NodeShape ;
  sh:targetClass autosar:SW-DATA-DEF-PROPS-CONTENT ;
  sh:severity sh:Violation ;
  sh:message "SwDataDefPropsContent in the context of ImplementationDataType may have at most one of BASE-TYPE-REF, IMPLEMENTATION-DATA-TYPE-REF, SW-POINTER-TARGET-PROPS."@en ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "At most one of BASE-TYPE-REF, IMPLEMENTATION-DATA-TYPE-REF, SW-POINTER-TARGET-PROPS is allowed."@en ;
    sh:select """
      PREFIX autosar: <http://autosar.org/>
      SELECT ?this WHERE {
        BIND( IF(EXISTS { ?this autosar:BASE-TYPE-REF ?b }, 1, 0) +
              IF(EXISTS { ?this autosar:IMPLEMENTATION-DATA-TYPE-REF ?i }, 1, 0) +
              IF(EXISTS { ?this autosar:SW-POINTER-TARGET-PROPS ?p }, 1, 0)
              AS ?cnt )
        FILTER(?cnt > 1)
      }
    """ ;
  ] .

########## constr_1181 ##########################################

# No SHACL structural constraint – overlap of numerical values across
# ModeDeclaration and ModeDeclarationGroup is handled in SMT.

########## constr_1182 ##########################################

autosar:Constr_1182 a sh:NodeShape ;
  sh:targetClass autosar:INTERNAL-TRIGGERING-POINT ;
  sh:severity sh:Violation ;
  sh:message "InternalTriggeringPoint.swImplPolicy must be STANDARD or QUEUED."@en ;
  sh:property [
    sh:path ( autosar:INTERNAL-TRIGGERING-POINT autosar:SW-IMPL-POLICY ) ;
    sh:in ( "STANDARD" "QUEUED" ) ;
    sh:severity sh:Violation ;
  ] .


# SHACL shapes for the given constraints

#################################################################
# constr_1183 - EndToEndProtectionVariablePrototypes aggregated by EndToEndProtection
#################################################################

autosar:Constr_1183_EndToEndProtectionVariablePrototypesByEndToEndProtection
    a sh:NodeShape ;
    sh:targetClass autosar:END-TO-END-PROTECTION ;
    sh:severity sh:Violation ;
    sh:message "All EndToEndProtectionVariablePrototypes aggregated by the same EndToEndProtection shall refer to the identical sender."@en ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "All EndToEndProtectionVariablePrototypes aggregated by the same EndToEndProtection shall refer to the identical sender."@en ;
        sh:select """
PREFIX autosar: <http://autosar.org/>

SELECT ?this
WHERE {
  ?this autosar:END-TO-END-PROTECTION-VARIABLE-PROTOTYPES ?vp1 .
  ?vp1 autosar:SENDER-IREF ?sender1 .

  ?this autosar:END-TO-END-PROTECTION-VARIABLE-PROTOTYPES ?vp2 .
  ?vp2 autosar:SENDER-IREF ?sender2 .

  FILTER (?vp1 != ?vp2 && ?sender1 != ?sender2)
}
""" ;
    ] .

#################################################################
# constr_1185 - Consistency of data types in ApplicationCompositeElementInPortInterfaceInstanceRef
#################################################################

# No stable structural path to the “enclosed in the context of the definition
# of the data type” relation; handled purely in SMT. No SHACL emitted.

#################################################################
# constr_1186 - Consistency of data types in ArVariableInImplementationDataInstanceRef
#################################################################

# Same as constr_1185: semantic “enclosed in the context of the definition
# of the data type” cannot be expressed structurally here; handled in SMT only.

#################################################################
# constr_1187 - Compatibility of VariableDataPrototypes / ParameterDataPrototypes
#################################################################

# Complex semantic compatibility (multi‑case, order, attributes, iff) is
# delegated to SMT. SHACL is used only for simple structural parts.

autosar:Constr_1187_ApplicationCompositeElementDataPrototype_Structure
    a sh:NodeShape ;
    sh:targetClass autosar:APPLICATION-COMPOSITE-ELEMENT-DATA-PROTOTYPE ;
    sh:severity sh:Info ;
    sh:message "Structural helper for compatibility of VariableDataPrototypes or ParameterDataPrototypes typed by composite data types."@en ;
    # SHORT-NAME must exist on concrete composite data types (array/record)
    sh:property [
        sh:path autosar:SHORT-NAME ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path autosar:CATEGORY ;
    ] .

#################################################################
# constr_1188 - Existence of ReceiverComSpec.replaceWith
#################################################################

# Structural part: REPLACE-WITH is optional; no unconditional minCount.

autosar:Constr_1188_ReceiverComSpec_ReplaceWith_Structure
    a sh:NodeShape ;
    sh:targetClass autosar:NONQUEUED-RECEIVER-COM-SPEC , autosar:QUEUED-RECEIVER-COM-SPEC ;
    sh:severity sh:Info ;
    sh:message "Structural helper for ReceiverComSpec.replaceWith existence."@en ;
    sh:property [
        sh:path autosar:HANDLE-OUT-OF-RANGE ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path autosar:REPLACE-WITH ;
        sh:maxCount 1 ;
    ] .

# Logical iff condition in SPARQL (informational; authoritative version in SMT)

autosar:Constr_1188_ReceiverComSpec_ReplaceWith_Logic
    a sh:NodeShape ;
    sh:targetClass autosar:NONQUEUED-RECEIVER-COM-SPEC , autosar:QUEUED-RECEIVER-COM-SPEC ;
    sh:severity sh:Info ;
    sh:message "REPLACE-WITH shall exist iff handleOutOfRange==externalReplacement or the associated SenderReceiverInterface.invalidationPolicy.handleInvalid==externalReplacement."@en ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Violation of ReceiverComSpec.replaceWith iff-condition."@en ;
        sh:select """
PREFIX autosar: <http://autosar.org/>

SELECT ?this
WHERE {
  # local flag: handleOutOfRange == externalReplacement ?
  OPTIONAL { ?this autosar:HANDLE-OUT-OF-RANGE ?hor . }
  BIND(BOUND(?hor) && ?hor = "externalReplacement" AS ?horExt)

  # associated SenderReceiverInterface and its invalidationPolicy
  OPTIONAL {
    ?this autosar:IS-ASSOCIATED-TO ?ifc .
    ?ifc autosar:INVALIDATION-POLICYS ?ips .
    ?ips autosar:INVALIDATION-POLICY ?ip .
    ?ip autosar:HANDLE-INVALID ?hi .
  }
  BIND(BOUND(?hi) && ?hi = "externalReplacement" AS ?ipExt)

  BIND((?horExt || ?ipExt) AS ?cond)

  OPTIONAL { ?this autosar:REPLACE-WITH ?rw . }
  BIND(BOUND(?rw) AS ?hasRW)

  FILTER (?cond != ?hasRW)
}
""" ;
    ] .

#################################################################
# constr_1190 - Only one mapping for composite to primitive use case
#################################################################

autosar:Constr_1190_OnlyOneSubElementMapping
    a sh:NodeShape ;
    sh:targetClass autosar:DATA-PROTOTYPE-MAPPING ;
    sh:severity sh:Violation ;
    sh:message "In the case described by [TPS_SWCT_01195] only one SUB-ELEMENT-MAPPING shall exist at the enclosing DATA-PROTOTYPE-MAPPING."@en ;
    sh:property [
        sh:path ( autosar:SUB-ELEMENT-MAPPINGS autosar:SUB-ELEMENT-MAPPING ) ;
        sh:maxCount 1 ;
    ] .

#################################################################
# constr_1191 - Value of Limit shall yield a numerical value
#################################################################

# No structural restriction beyond the class; “after variability is bound”
# and “yields a numerical value” are semantic/runtime notions → SMT only.

autosar:Constr_1191_Limit_Structure
    a sh:NodeShape ;
    sh:targetClass autosar:LIMIT ;
    sh:severity sh:Info ;
    sh:message "Limit instances are subject to a semantic constraint: after variability binding, the content shall yield a numerical value (checked in SMT)."@en .


#################################################################
# SHACL shapes for given constraints
#################################################################

########## constr_1192 – Compatibility of "IDENTICAL" to "RAT_FUNC" or "LINEAR"
# Purely semantic / numeric; no stable structural pattern → handled in SMT only.
# (Intentionally left without sh:NodeShape.)

########## constr_1193 – ModeDeclaration shall be referenced by at least one ModeTransition in the role enteredMode

autosar:Constr_1193_ModeDeclarationEnteredModeShape
    a sh:NodeShape ;
    sh:targetClass autosar:MODE-DECLARATION ;
    sh:severity sh:Violation ;
    sh:message "For each non-initial MODE-DECLARATION, if its enclosing MODE-DECLARATION-GROUP defines at least one MODE-TRANSITION, then at least one MODE-TRANSITION shall reference it via ENTERED-MODE-REF."@en ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "MODE-DECLARATION is not referenced as ENTERED-MODE-REF by any MODE-TRANSITION in its MODE-DECLARATION-GROUP (and it is not the INITIAL-MODE-REF)."@en ;
        sh:severity sh:Violation ;
        sh:select """
PREFIX autosar: <http://autosar.org/>

SELECT ?this
WHERE {
  ?mdg a autosar:MODE-DECLARATION-GROUP .

  # initialMode of the group
  ?mdg autosar:INITIAL-MODE-REF ?initialMode .

  # this MODE-DECLARATION belongs to the group
  ?mdg autosar:MODE-DECLARATIONS ?mds .
  ?mds autosar:MODE-DECLARATION ?this .

  # apply only if there is at least one MODE-TRANSITION in the group
  FILTER EXISTS {
    ?mdg autosar:MODE-TRANSITIONS ?mts .
    ?mts autosar:MODE-TRANSITION ?mt .
  }

  # skip the initialMode
  FILTER (?this != ?initialMode)

  # violation if there is no MODE-TRANSITION with ENTERED-MODE-REF = this
  FILTER NOT EXISTS {
    ?mdg autosar:MODE-TRANSITIONS ?mts2 .
    ?mts2 autosar:MODE-TRANSITION ?mt2 .
    ?mt2 autosar:ENTERED-MODE-REF ?this .
  }
}
        """ ;
    ] .

########## constr_1194 – Identical ModeTransitions (iff)

# Complex bi-directional correspondence between two MODE-DECLARATION-GROUPs;
# requires global reasoning over pairs of groups and their MODE-TRANSITIONs.
# Left to SMT; no stable SHACL structure beyond basic typing, so omitted here.

########## constr_1195 – SwcModeSwitchEvent and the definition of ModeTransition

autosar:Constr_1195_SwcModeSwitchEventModeTransitionShape
    a sh:NodeShape ;
    sh:targetClass autosar:SWC-MODE-SWITCH-EVENT ;
    sh:severity sh:Violation ;
    sh:message "For each pair of ModeDeclarations referenced by a SwcModeSwitchEvent with ACTIVATION = onTransition, a corresponding MODE-TRANSITION (from exitedMode to enteredMode) shall be defined in the respective MODE-DECLARATION-GROUP, provided the group defines at least one MODE-TRANSITION."@en ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Missing MODE-TRANSITION for a SwcModeSwitchEvent with ACTIVATION = onTransition between the referenced ModeDeclarations."@en ;
        sh:severity sh:Violation ;
        sh:select """
PREFIX autosar: <http://autosar.org/>

SELECT ?this
WHERE {
  ?this a autosar:SWC-MODE-SWITCH-EVENT .

  # activation must be onTransition
  ?this autosar:ACTIVATION ?act .
  FILTER (STR(?act) = "ON-TRANSITION" || STR(?act) = "onTransition")

  # two MODE-IREFs (from-mode and to-mode) – modelled generically here
  ?this autosar:MODE-IREFS ?irefs .
  ?irefs autosar:MODE-IREF ?iref1, ?iref2 .

  # referenced ModeDeclarations
  ?iref1 autosar:MODE-REF ?fromMode .
  ?iref2 autosar:MODE-REF ?toMode .

  # their common ModeDeclarationGroup
  ?mdg autosar:MODE-DECLARATIONS ?mds .
  ?mds autosar:MODE-DECLARATION ?fromMode, ?toMode .

  # apply only if group defines at least one MODE-TRANSITION
  FILTER EXISTS {
    ?mdg autosar:MODE-TRANSITIONS ?mts0 .
    ?mts0 autosar:MODE-TRANSITION ?mt0 .
  }

  # violation if no MODE-TRANSITION from fromMode to toMode
  FILTER NOT EXISTS {
    ?mdg autosar:MODE-TRANSITIONS ?mts .
    ?mts autosar:MODE-TRANSITION ?mt .
    ?mt autosar:EXITED-MODE-REF ?fromMode .
    ?mt autosar:ENTERED-MODE-REF ?toMode .
  }
}
        """ ;
    ] .

########## constr_1196 – Existence of networkRepresentation vs. compositeNetworkRepresentation

# Receiver side – NONQUEUED-RECEIVER-COM-SPEC
autosar:Constr_1196_NonqueuedReceiverComSpecShape
    a sh:NodeShape ;
    sh:targetClass autosar:NONQUEUED-RECEIVER-COM-SPEC ;
    sh:severity sh:Violation ;
    sh:message "NONQUEUED-RECEIVER-COM-SPEC shall not aggregate NETWORK-REPRESENTATION and COMPOSITE-NETWORK-REPRESENTATION at the same time."@en ;
    sh:property [
        sh:path autosar:NETWORK-REPRESENTATION ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path ( autosar:COMPOSITE-NETWORK-REPRESENTATIONS autosar:COMPOSITE-NETWORK-REPRESENTATION ) ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "NONQUEUED-RECEIVER-COM-SPEC aggregates both NETWORK-REPRESENTATION and COMPOSITE-NETWORK-REPRESENTATION."@en ;
        sh:severity sh:Violation ;
        sh:select """
PREFIX autosar: <http://autosar.org/>

SELECT ?this
WHERE {
  ?this a autosar:NONQUEUED-RECEIVER-COM-SPEC .

  FILTER EXISTS { ?this autosar:NETWORK-REPRESENTATION ?nr . }
  FILTER EXISTS {
    ?this autosar:COMPOSITE-NETWORK-REPRESENTATIONS ?cnrs .
    ?cnrs autosar:COMPOSITE-NETWORK-REPRESENTATION ?cnr .
  }
}
        """ ;
    ] .

