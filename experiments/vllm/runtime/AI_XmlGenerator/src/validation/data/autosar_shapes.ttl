# 未给出具体 category 枚举或与 SwDataDefProps 的可观测关系 → 不生成 SHACL


#################################################################
# SHACL for TPS_SWCT_01239
#################################################################

autosar:TPS_SWCT_01239_SwSystemconstCategoryDefault
    a sh:NodeShape ;
    sh:targetClass autosar:SW-SYSTEMCONST ;
    sh:property [
        sh:path autosar:CATEGORY ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:severity sh:Info ;
        sh:message "If CATEGORY is not explicitly defined for a SW-SYSTEMCONST, the default value shall be 'VALUE' (checked by SMT/semantic layer)." ;
    ] .

#################################################################
# SHACL for TPS_SWCT_01241
#################################################################

autosar:TPS_SWCT_01241_ApplicationCompositeDataType_CategoryAndSwDataDefProps
    a sh:NodeShape ;
    sh:targetClass autosar:APPLICATION-ARRAY-DATA-TYPE , autosar:APPLICATION-RECORD-DATA-TYPE ;

    # CATEGORY (optional, at most one)
    sh:property [
        sh:path autosar:CATEGORY ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:severity sh:Info ;
        sh:message "CATEGORY characterizes the nature of the application-level data type; only certain SwDataDefProps attributes make sense per category (semantic restrictions checked by SMT/semantic layer)." ;
    ] ;

    # SW-DATA-DEF-PROPS (optional, at most one)
    sh:property [
        sh:path autosar:SW-DATA-DEF-PROPS ;
        sh:maxCount 1 ;
        sh:severity sh:Info ;
        sh:message "SW-DATA-DEF-PROPS further characterizes the application-level data type; only certain attributes make sense per CATEGORY (semantic restrictions checked by SMT/semantic layer)." ;
    ] .

#################################################################
# SHACL for TPS_SWCT_01242
#################################################################

autosar:TPS_SWCT_01242_ApplicationDataType_CategoryNature
    a sh:NodeShape ;

    # 直接针对抽象的 ApplicationDataType，
    # 具体的 ARRAY / RECORD / PRIMITIVE / COMPOSITE 等通过 rdfs:subClassOf + RDFS 推理覆盖
    sh:targetClass autosar:APPLICATION-DATA-TYPE ;

    sh:property [
        sh:path autosar:CATEGORY ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;  # 至多一个 CATEGORY
        # 不设 minCount，表示 CATEGORY 可选，只做“存在时的结构检查”
        sh:severity sh:Info ;
        sh:message "CATEGORY is used to characterize the nature of an application-level data type (semantic interpretation checked by SMT/semantic layer)." ;
    ] .

#################################################################
# SHACL for TPS_SWCT_01249
#################################################################

autosar:TPS_SWCT_01249_ApplicationRecordDataType_UniqueRecordElementShortName
    a sh:NodeShape ;
    sh:targetClass autosar:APPLICATION-RECORD-DATA-TYPE ;

    # Structural: at least one APPLICATION-RECORD-ELEMENT
    sh:property [
        sh:path ( autosar:ELEMENTS autosar:APPLICATION-RECORD-ELEMENT ) ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "An APPLICATION-RECORD-DATA-TYPE shall declare a non-empty set of APPLICATION-RECORD-ELEMENTs." ;
    ] ;

    # Behavioral: uniqueness of SHORT-NAME of APPLICATION-RECORD-ELEMENTs
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "Within an APPLICATION-RECORD-DATA-TYPE, the SHORT-NAME of each APPLICATION-RECORD-ELEMENT shall be unique." ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this ?elem1 ?elem2 ?sn
            WHERE {
              ?this a autosar:APPLICATION-RECORD-DATA-TYPE .
              ?this autosar:ELEMENTS ?elements .
              ?elements autosar:APPLICATION-RECORD-ELEMENT ?elem1 .
              ?elements autosar:APPLICATION-RECORD-ELEMENT ?elem2 .
              FILTER (?elem1 != ?elem2) .
              ?elem1 autosar:SHORT-NAME ?sn .
              ?elem2 autosar:SHORT-NAME ?sn .
            }
        """ ;
    ] .


# 1) TPS_SWCT_01251 – Limited set of values for category are applicable for ImplementationDataType
# 语义偏行为/配置，且未给出具体“有限集合”，仅建立结构性 if-present 关联

