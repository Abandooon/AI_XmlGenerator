# SHACL for constr_1290 - Limitation on the number of PPortComSpecs in one PPortPrototype
autosar:constr_1290 a sh:NodeShape ;
  sh:targetClass autosar:P-PORT-PROTOTYPE ;
  sh:severity sh:Violation ;
  sh:message "Within one PPortPrototype there can only be one PPortComSpec that references a given dataElement or clientServerOperation."@en .


#################################################################
# SHACL shapes
#################################################################

#################################################################
# constr_1291 - Limitation on the number of RPortComSpecs
# Within one R-PORT-PROTOTYPE, for a given dataElement or
# clientServerOperation there is at most one R-PORT-COM-SPEC.
#################################################################

autosar:Constr_1291_RPortPrototype_RPortComSpec_Uniqueness
    a sh:NodeShape ;
    sh:targetClass autosar:R-PORT-PROTOTYPE ;

    # Structural hook: count R-PORT-COM-SPECs (no semantic grouping here)
    sh:property [
        sh:path autosar:R-PORT-COM-SPEC ;
        sh:severity sh:Violation ;
    ] ;

    # Logical uniqueness per referenced element/operation
    sh:sparql [
        sh:message "Within one RPortPrototype, there can only be one RPortComSpec that references a given dataElement or clientServerOperation (constr_1291)." ;
        sh:severity sh:Violation ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this
            WHERE {
              ?this a autosar:R-PORT-PROTOTYPE .

              # RPortComSpecs referencing the same dataElement
              {
                ?this autosar:R-PORT-COM-SPEC ?cs1 .
                ?this autosar:R-PORT-COM-SPEC ?cs2 .
                FILTER(?cs1 != ?cs2) .
                ?cs1 autosar:DATA-ELEMENT-REF ?de .
                ?cs2 autosar:DATA-ELEMENT-REF ?de .
              }
              UNION
              # RPortComSpecs referencing the same clientServerOperation
              {
                ?this autosar:R-PORT-COM-SPEC ?cs1 .
                ?this autosar:R-PORT-COM-SPEC ?cs2 .
                FILTER(?cs1 != ?cs2) .
                ?cs1 autosar:OPERATION-REF ?op .
                ?cs2 autosar:OPERATION-REF ?op .
              }
            }
        """ ;
    ] .

#################################################################
# constr_1292 - Limitation on the number of RPortComSpecs/PPortComSpecs
# Within one PR-PORT-PROTOTYPE, for a given dataElement or
# clientServerOperation there is at most one R-PORT-COM-SPEC and
# at most one P-PORT-COM-SPEC.
#################################################################

autosar:Constr_1292_PRPortPrototype_ComSpec_Uniqueness
    a sh:NodeShape ;
    sh:targetClass autosar:PR-PORT-PROTOTYPE ;

    sh:property [
        sh:path autosar:R-PORT-COM-SPEC ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        sh:path autosar:P-PORT-COM-SPEC ;
        sh:severity sh:Violation ;
    ] ;

    sh:sparql [
        sh:message "Within one PRPortPrototype, there can only be one RPortComSpec and one PPortComSpec that reference a given dataElement or clientServerOperation (constr_1292)." ;
        sh:severity sh:Violation ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this
            WHERE {
              ?this a autosar:PR-PORT-PROTOTYPE .

              # RPortComSpec uniqueness per dataElement
              {
                ?this autosar:R-PORT-COM-SPEC ?r1 .
                ?this autosar:R-PORT-COM-SPEC ?r2 .
                FILTER(?r1 != ?r2) .
                ?r1 autosar:DATA-ELEMENT-REF ?de .
                ?r2 autosar:DATA-ELEMENT-REF ?de .
              }
              UNION
              # PPortComSpec uniqueness per dataElement
              {
                ?this autosar:P-PORT-COM-SPEC ?p1 .
                ?this autosar:P-PORT-COM-SPEC ?p2 .
                FILTER(?p1 != ?p2) .
                ?p1 autosar:DATA-ELEMENT-REF ?de .
                ?p2 autosar:DATA-ELEMENT-REF ?de .
              }
              UNION
              # RPortComSpec uniqueness per operation
              {
                ?this autosar:R-PORT-COM-SPEC ?r1 .
                ?this autosar:R-PORT-COM-SPEC ?r2 .
                FILTER(?r1 != ?r2) .
                ?r1 autosar:OPERATION-REF ?op .
                ?r2 autosar:OPERATION-REF ?op .
              }
              UNION
              # PPortComSpec uniqueness per operation
              {
                ?this autosar:P-PORT-COM-SPEC ?p1 .
                ?this autosar:P-PORT-COM-SPEC ?p2 .
                FILTER(?p1 != ?p2) .
                ?p1 autosar:OPERATION-REF ?op .
                ?p2 autosar:OPERATION-REF ?op .
              }
            }
        """ ;
    ] .

#################################################################
# constr_1295 - PortInterfaces and category DATA_REFERENCE
# SHACL: only structural hook on IMPLEMENTATION-DATA-TYPE/CATEGORY.
# Semantic condition is handled in SMT.
#################################################################

autosar:Constr_1295_ImplementationDataType_Category_Hook
    a sh:NodeShape ;
    sh:targetClass autosar:IMPLEMENTATION-DATA-TYPE ;

    sh:property [
        sh:path autosar:CATEGORY ;
        sh:severity sh:Info ;
    ] .

#################################################################
# constr_1296 - DataPrototypes used as explicit/implicit IRV and DATA_REFERENCE
# SHACL: structural hooks for TYPE-TREF, CATEGORY and IRV collections.
# Semantic prohibition is handled in SMT.
#################################################################

autosar:Constr_1296_SwcInternalBehavior_IRV_Hook
    a sh:NodeShape ;
    sh:targetClass autosar:SWC-INTERNAL-BEHAVIOR ;

    sh:property [
        sh:path ( autosar:EXPLICIT-INTER-RUNNABLE-VARIABLES autosar:VARIABLE-DATA-PROTOTYPE ) ;
        sh:severity sh:Info ;
    ] ;
    sh:property [
        sh:path ( autosar:IMPLICIT-INTER-RUNNABLE-VARIABLES autosar:VARIABLE-DATA-PROTOTYPE ) ;
        sh:severity sh:Info ;
    ] .

#################################################################
# constr_1297 - Applicability of serverArgumentImplPolicy = useArrayBaseType
# SHACL: if-present-then-enum-value check on SERVER-ARGUMENT-IMPL-POLICY.
# Semantic typing condition is handled in SMT.
#################################################################

autosar:Constr_1297_ArgumentDataPrototype_ServerArgumentImplPolicy
    a sh:NodeShape ;
    sh:targetClass autosar:ARGUMENT-DATA-PROTOTYPE ;

    sh:property [
        sh:path autosar:SERVER-ARGUMENT-IMPL-POLICY ;
        sh:severity sh:Violation ;
        # value restriction is delegated to datatype/enum; no extra SHACL here
    ] .


#################################################################
# constr_1298 - EXPLICIT_ORDER => onTransitionValue & ModeDeclaration.value set
#################################################################

autosar:Constr_1298_ModeDeclarationGroup_ExplicitOrder_Existence a sh:NodeShape ; sh:targetClass autosar:MODE-DECLARATION-GROUP ; sh:property [ sh:path autosar:CATEGORY ; sh:severity sh:Violation ] ; sh:property [ sh:path autosar:ON-TRANSITION-VALUE ; sh:severity sh:Violation ] ; sh:property [ sh:path ( autosar:MODE-DECLARATIONS autosar:MODE-DECLARATION autosar:VALUE ) ; sh:severity sh:Violation ] ; sh:sparql [ sh:message "If ModeDeclarationGroup.category = EXPLICIT_ORDER, then ON-TRANSITION-VALUE and each ModeDeclaration.VALUE shall be set (constr_1298)." ; sh:severity sh:Violation ; sh:select """PREFIX autosar: <http://autosar.org/> SELECT ?this WHERE { ?this a autosar:MODE-DECLARATION-GROUP ; autosar:CATEGORY ?cat . FILTER(str(?cat) = "EXPLICIT_ORDER") . OPTIONAL { ?this autosar:ON-TRANSITION-VALUE ?otv . } FILTER(!bound(?otv)) . }""" ] ; sh:sparql [ sh:message "If ModeDeclarationGroup.category = EXPLICIT_ORDER, then each ModeDeclaration.VALUE shall be set (constr_1298)." ; sh:severity sh:Violation ; sh:select """PREFIX autosar: <http://autosar.org/> SELECT ?this ?md WHERE { ?this a autosar:MODE-DECLARATION-GROUP ; autosar:CATEGORY ?cat . FILTER(str(?cat) = "EXPLICIT_ORDER") . ?this autosar:MODE-DECLARATIONS ?mds . ?mds autosar:MODE-DECLARATION ?md . OPTIONAL { ?md autosar:VALUE ?v . } FILTER(!bound(?v)) . }""" ] .


#################################################################
# constr_1299 - category != EXPLICIT_ORDER => no onTransitionValue / ModeDeclaration.value
#################################################################

autosar:Constr_1299_ModeDeclarationGroup_NonExplicitOrder_Existence a sh:NodeShape ; sh:targetClass autosar:MODE-DECLARATION-GROUP ; sh:property [ sh:path autosar:CATEGORY ; sh:severity sh:Violation ] ; sh:property [ sh:path autosar:ON-TRANSITION-VALUE ; sh:severity sh:Violation ] ; sh:property [ sh:path ( autosar:MODE-DECLARATIONS autosar:MODE-DECLARATION autosar:VALUE ) ; sh:severity sh:Violation ] ; sh:sparql [ sh:message "If ModeDeclarationGroup.category != EXPLICIT_ORDER, then ON-TRANSITION-VALUE shall not be set (constr_1299)." ; sh:severity sh:Violation ; sh:select """PREFIX autosar: <http://autosar.org/> SELECT ?this WHERE { ?this a autosar:MODE-DECLARATION-GROUP ; autosar:CATEGORY ?cat . FILTER(str(?cat) != "EXPLICIT_ORDER") . ?this autosar:ON-TRANSITION-VALUE ?otv . }""" ] ; sh:sparql [ sh:message "If ModeDeclarationGroup.category != EXPLICIT_ORDER, then no ModeDeclaration.VALUE shall be set (constr_1299)." ; sh:severity sh:Violation ; sh:select """PREFIX autosar: <http://autosar.org/> SELECT ?this ?md WHERE { ?this a autosar:MODE-DECLARATION-GROUP ; autosar:CATEGORY ?cat . FILTER(str(?cat) != "EXPLICIT_ORDER") . ?this autosar:MODE-DECLARATIONS ?mds . ?mds autosar:MODE-DECLARATION ?md . ?md autosar:VALUE ?v . }""" ] .



