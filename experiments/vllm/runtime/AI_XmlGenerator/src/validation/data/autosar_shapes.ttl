# TPS_SWCT_01376 - Software-components need to be capable of reacting to state changes
# 行为能力要求，无直接结构条件（如必须存在某类 ModeSwitchEvent 的覆盖性约束未在文本中形式化）→ 不生成 SHACL


# TPS_SWCT_01378 - AtomicSwComponentType can define an SwcModeSwitchEvent to execute RunnableEntity
# “can define” 为能力/可选性描述，非强制结构约束 → 不生成 SHACL


# 1) TPS_SWCT_01379 – disabledMode semantics
# 目标：各具体 RTE-EVENT 子类上的 DISABLED-MODE-IREF（可选存在）

autosar:TPS_SWCT_01379 a sh:NodeShape ;
  sh:severity sh:Info ;
  sh:targetClass autosar:ASYNCHRONOUS-SERVER-CALL-RETURNS-EVENT ,autosar:BACKGROUND-EVENT ,autosar:DATA-RECEIVE-ERROR-EVENT ,autosar:DATA-RECEIVED-EVENT ,autosar:DATA-SEND-COMPLETED-EVENT ,autosar:DATA-WRITE-COMPLETED-EVENT ,autosar:EXTERNAL-TRIGGER-OCCURRED-EVENT ,autosar:INIT-EVENT ,autosar:INTERNAL-TRIGGER-OCCURRED-EVENT ,autosar:MODE-SWITCHED-ACK-EVENT ,autosar:OPERATION-INVOKED-EVENT ,autosar:SWC-MODE-MANAGER-ERROR-EVENT ,autosar:SWC-MODE-SWITCH-EVENT ,autosar:TIMING-EVENT ,autosar:TRANSFORMER-HARD-ERROR-EVENT ;

  # 结构层面：若存在 DISABLED-MODE-IREF，则其路径与类型正确
  sh:property [
    sh:path ( autosar:DISABLED-MODE-IREFS autosar:DISABLED-MODE-IREF ) ;
    sh:class autosar:R-MODE-IN-ATOMIC-SWC-INSTANCE-REF ;
  ] ;

  # 逻辑层面：行为语义仅作信息提示（运行时行为不强制）
  sh:sparql [
    sh:message "If a DISABLED-MODE-IREF is present for an RTEEvent, the associated RunnableEntity shall not be started when the referenced ModeDeclaration is active." ;
    sh:severity sh:Info ;
    sh:select """
      PREFIX autosar: <http://autosar.org/>
      SELECT ?this
      WHERE {
        ?this autosar:DISABLED-MODE-IREFS ?w .
        ?w autosar:DISABLED-MODE-IREF ?dm .
      }
    """ ;
  ] .

# 2) TPS_SWCT_01380 – Mode management behavior on the sender side
# 语义：发送方 RunnableEntity 应通过 ModeSwitchPoint 关联其管理的 ModeDeclarationGroup
# 结构上 MODE-DECLARATION-GROUP 不直接承载该元素，因此仅对 RUNNABLE-ENTITY 做 if-present-then-type

autosar:TPS_SWCT_01380 a sh:NodeShape ;
  sh:severity sh:Info ;
  sh:targetClass autosar:RUNNABLE-ENTITY ;

  sh:property [
    sh:path ( autosar:MODE-SWITCH-POINTS autosar:MODE-SWITCH-POINT ) ;
    sh:class autosar:MODE-SWITCH-POINT ;
  ] ;

  sh:sparql [
    sh:message "On the sender side, a RunnableEntity should have ModeSwitchPoints that associate it with the ModeDeclarationGroups it manages." ;
    sh:severity sh:Info ;
    sh:select """
      PREFIX autosar: <http://autosar.org/>
      SELECT ?this
      WHERE {
        ?this a autosar:RUNNABLE-ENTITY .
        OPTIONAL {
          ?this autosar:MODE-SWITCH-POINTS ?w .
          ?w autosar:MODE-SWITCH-POINT ?msp .
        }
      }
    """ ;
  ] .

# 3) TPS_SWCT_01381 – Read the currently active mode
# 语义：需要读取当前模式的 RunnableEntity 必须定义 ModeAccessPoint
# 结构上仅建模 if-present-then-type；“需要读取”是运行时语义，保持为 Info

autosar:TPS_SWCT_01381 a sh:NodeShape ;
  sh:severity sh:Info ;
  sh:targetClass autosar:RUNNABLE-ENTITY ;

  sh:property [
    sh:path ( autosar:MODE-ACCESS-POINTS autosar:MODE-ACCESS-POINT ) ;
    sh:class autosar:MODE-ACCESS-POINT ;
  ] ;

  sh:sparql [
    sh:message "A RunnableEntity that requires read access to the ModeDeclarationGroupPrototype's current mode has to define a ModeAccessPoint." ;
    sh:severity sh:Info ;
    sh:select """
      PREFIX autosar: <http://autosar.org/>
      SELECT ?this
      WHERE {
        ?this a autosar:RUNNABLE-ENTITY .
        OPTIONAL {
          ?this autosar:MODE-ACCESS-POINTS ?w .
          ?w autosar:MODE-ACCESS-POINT ?map .
        }
      }
    """ ;
  ] .

# 4) TPS_SWCT_01383 – ModeSwitchPoint (行为性描述，无结构细节)
# 无可观测结构约束，仅保留信息级别说明

autosar:TPS_SWCT_01383 a sh:NodeShape ;
  sh:severity sh:Info ;
  sh:targetClass autosar:MODE-SWITCH-POINT ;
  sh:message "A ModeSwitchPoint may define a ModeSwitchedAckEvent if requested by the PPortPrototype; this RTEEvent is owned by a mode manager to get confirmation of a mode change." .

# 5) TPS_SWCT_01384 – 初始化代码执行（纯行为性）
autosar:TPS_SWCT_01384 a sh:NodeShape ;
  sh:severity sh:Info ;
  sh:targetClass autosar:ATOMIC-SW-COMPONENT-TYPE ;
  sh:message "Most AtomicSwComponentTypes need initialization code that completes before any other code in the component is executed." .

# 6) TPS_SWCT_01385 – 终止代码执行（纯行为性）
autosar:TPS_SWCT_01385 a sh:NodeShape ;
  sh:severity sh:Info ;
  sh:targetClass autosar:ATOMIC-SW-COMPONENT-TYPE ;
  sh:message "Most AtomicSwComponentTypes need finalization code that completes before the application software is shut down." .

# 7) TPS_SWCT_01391 – ECU-ABSTRACTION-SW-COMPONENT-TYPE hardwareElement refs
# 语义：EcuAbstractionSwComponentType 通过 HARDWARE-ELEMENT-REF 依赖 HwElements 等

autosar:TPS_SWCT_01391 a sh:NodeShape ;
  sh:severity sh:Info ;
  sh:targetClass autosar:ECU-ABSTRACTION-SW-COMPONENT-TYPE ;

  sh:property [
    sh:path ( autosar:HARDWARE-ELEMENT-REFS autosar:HARDWARE-ELEMENT-REF ) ;
    sh:nodeKind sh:IRI ;
    sh:or (
      [ sh:class autosar:HW-DESCRIPTION-ENTITY ]
      [ sh:class autosar:HW-ELEMENT ]
      [ sh:class autosar:HW-PIN ]
      [ sh:class autosar:HW-PIN-GROUP ]
      [ sh:class autosar:HW-TYPE ]
    )
  ] .


