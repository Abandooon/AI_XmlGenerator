    sh:severity sh:Info ;
    sh:property [
        sh:path ( autosar:PORT-API-OPTION autosar:ENABLE-TAKE-ADDRESS ) ;
        sh:datatype xsd:boolean
    ] .

# 2) TPS_SWCT_01356 – indirectAPI option
autosar:TPS_SWCT_01356_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:PORT-PROTOTYPE ;
    sh:severity sh:Info ;
    sh:property [
        sh:path ( autosar:PORT-API-OPTION autosar:INDIRECT-API ) ;
        sh:datatype xsd:boolean
    ] .

# 3) TPS_SWCT_01359 – supportsMultipleInstantiation
autosar:TPS_SWCT_01359_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:ATOMIC-SW-COMPONENT-TYPE ;
    sh:severity sh:Info ;
    sh:property [
        sh:path ( autosar:SWC-INTERNAL-BEHAVIOR autosar:SUPPORTS-MULTIPLE-INSTANTIATION ) ;
        sh:datatype xsd:boolean
    ] .


# SHACL for TPS_SWCT_01361
autosar:TPS_SWCT_01361_Shape
  a sh:NodeShape ;
  sh:targetClass autosar:ATOMIC-SW-COMPONENT-TYPE ;
  sh:property [
    sh:path ( autosar:SWC-INTERNAL-BEHAVIOR autosar:SUPPORTS-MULTIPLE-INSTANTIATION ) ;
    sh:datatype xsd:boolean ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Info ;
    sh:message "AtomicSwComponentTypes with supportsMultipleInstantiation == false do not need to use PerInstanceMemory, but may use it."@en
  ] .

# SHACL for TPS_SWCT_01362
autosar:TPS_SWCT_01362_Shape
  a sh:NodeShape ;
  sh:targetClass autosar:PER-INSTANCE-MEMORY ;
  sh:property [
    sh:path autosar:INIT-VALUE ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Info ;
    sh:message "If no initValue is defined, the RTE does not initialize PerInstanceMemory; the AtomicSwComponentType must initialize it."@en
  ] .

# SHACL for TPS_SWCT_01363
autosar:TPS_SWCT_01363_Shape
  a sh:NodeShape ;
  sh:targetClass autosar:PER-INSTANCE-MEMORY ;
  sh:property [
    sh:path autosar:TYPE ;
    sh:datatype autosar:C-IDENTIFIER ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    sh:message "PerInstanceMemory shall provide the C type name in TYPE."@en
  ] ;
  sh:property [
    sh:path autosar:TYPE-DEFINITION ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    sh:message "PerInstanceMemory shall provide a C typedef in TYPE-DEFINITION."@en
  ] .

# SHACL for TPS_SWCT_01364
autosar:TPS_SWCT_01364_Shape
  a sh:NodeShape ;
  sh:targetClass autosar:PER-INSTANCE-MEMORY ;
  sh:property [
    sh:path autosar:INIT-VALUE ;
    sh:datatype xsd:string ;
    sh:maxCount 1 ;
    sh:severity sh:Info ;
    sh:message "INIT-VALUE of a C-typed PerInstanceMemory is a comma separated list usable as a constant initializer."@en
  ] .

# SHACL for TPS_SWCT_01366
autosar:TPS_SWCT_01366_Shape
  a sh:NodeShape ;
  sh:targetClass autosar:VARIABLE-DATA-PROTOTYPE ;
  sh:property [
    sh:path autosar:INIT-VALUE ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    sh:message "INIT-VALUE of AUTOSAR-typed PerInstanceMemory is described with a ValueSpecification."@en
  ] .

# SHACL for TPS_SWCT_01367
autosar:TPS_SWCT_01367_Shape
  a sh:NodeShape ;
  sh:targetClass autosar:VARIABLE-DATA-PROTOTYPE ;
  sh:property [
    sh:path autosar:SW-DATA-DEF-PROPS ;
    sh:class autosar:SW-DATA-DEF-PROPS ;
    sh:maxCount 1 ;
    sh:severity sh:Info ;
    sh:message "AUTOSAR-typed PerInstanceMemory may define SwDataDefProps for measurement or axis input."@en
  ] .

# SHACL for TPS_SWCT_01368
autosar:TPS_SWCT_01368_Shape
  a sh:NodeShape ;
  sh:targetClass autosar:ATOMIC-SW-COMPONENT-TYPE ;
  sh:property [
    sh:path ( autosar:SWC-INTERNAL-BEHAVIOR autosar:CONSTANT-MEMORYS autosar:PARAMETER-DATA-PROTOTYPE ) ;
    sh:class autosar:PARAMETER-DATA-PROTOTYPE ;
    sh:severity sh:Info ;
    sh:message "CONSTANT-MEMORYS can be used for AUTOSAR data types without RTE-managed memory."@en
  ] ;
  sh:property [
    sh:path ( autosar:SWC-INTERNAL-BEHAVIOR autosar:STATIC-MEMORYS autosar:VARIABLE-DATA-PROTOTYPE ) ;
    sh:class autosar:VARIABLE-DATA-PROTOTYPE ;
    sh:severity sh:Info ;
    sh:message "STATIC-MEMORYS can be used for AUTOSAR data types without RTE-managed memory."@en
  ] .


# 1) SHACL

# TPS_SWCT_01369 - Static and constant memory is not instantiated by the RTE
# 纯运行时行为描述，无可观测结构条件 → 不生成 SHACL 结构约束


# TPS_SWCT_01370 - VariationPointProxy
# 约束核心是“功能变体点”的定义与绑定时机说明，结构上仅有一条：
# 若 bindingTime = postBuildValueEvaluation，则 postBuildValueAccess 与 postBuildVariantCondition 应存在。
# 但 bindingTime 未在输入结构中出现，无法可靠定位触发条件 → 不生成 SHACL 结构约束


# TPS_SWCT_01373 - RTE generator shall evaluate the SwSystemconstDependentFormula
# 运行时行为（RTE 生成器职责），无结构性约束 → 不生成 SHACL


# TPS_SWCT_01374 - Implementation of AutosarParameterRef
# 语义：当且仅当 AutosarDataType 为 composite 时，需要 rootParameterDataPrototype；
# primitive 时只需 targetDataPrototype。由于“是否 composite/primitive”在给定结构中不可观测，
# 无法在 SHACL 中表达 iff 条件，仅能做存在性和类型的基本结构约束。

# 目标：AUTOSAR-PARAMETER-REF（由 autosarParameter IREF 推断）
autosar:TPS_SWCT_01374_AutosarParameterRefShape
    a sh:NodeShape ;
    sh:severity sh:Violation ;

    # 把 IREF 作为目标类的入口（AUTOSAR-PARAMETER-REF/AUTOSAR-PARAMETER-IREF）
    sh:targetClass autosar:AUTOSAR-PARAMETER-REF ;

    # AUTOSAR-PARAMETER-IREF 必须存在一次
    sh:property [
        sh:path autosar:AUTOSAR-PARAMETER-IREF ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

# 对 ParameterInAtomicSWCTypeInstanceRef 的结构约束
autosar:TPS_SWCT_01374_ParameterInAtomicSWCTypeInstanceRefShape
    a sh:NodeShape ;
    sh:severity sh:Violation ;
    sh:targetClass autosar:PARAMETER-IN-ATOMIC-SWC-TYPE-INSTANCE-REF ;

    # TARGET-DATA-PROTOTYPE-REF 必须存在一次
    sh:property [
        sh:path autosar:TARGET-DATA-PROTOTYPE-REF ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    # ROOT-PARAMETER-DATA-PROTOTYPE-REF 若存在，则 DEST 类型受限（交由实现根据 ref_dest_literals 处理）
    sh:property [
        sh:path autosar:ROOT-PARAMETER-DATA-PROTOTYPE-REF ;
        sh:maxCount 1 ;
    ] .

# 对 AutosarDataType 的 CATEGORY 仅做 if-present 结构约束（无强制）
autosar:TPS_SWCT_01374_AutosarDataTypeShape
    a sh:NodeShape ;
    sh:severity sh:Info ;
    sh:targetClass autosar:AUTOSAR-DATA-TYPE ;

    sh:property [
        sh:path autosar:CATEGORY ;
        sh:maxCount 1 ;
    ] .


# TPS_SWCT_01375 - Implementation of AutosarVariableRef
# 同 01374，结构层面仅能约束 IREF 和 target/root 引用的存在性。

