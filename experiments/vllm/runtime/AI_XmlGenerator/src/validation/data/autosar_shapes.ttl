      ]
    ) .

########## Table_7_63 ##########
# BswM interaction requires BswMgrNeeds in SwcServiceDependency
# Structural part: SERVICE-NEEDS must be present on SWC-SERVICE-DEPENDENCY
# The subtype “BswMgrNeeds” is semantic (subclass of ServiceNeeds) -> SMT

autosar:Table_7_63_BswMInteraction_ServiceNeedsPresence
    a sh:NodeShape ;
    sh:targetClass autosar:APPLICATION-SW-COMPONENT-TYPE ;
    sh:severity sh:Violation ;
    sh:message "All use cases for interaction of an application software-component with the BswM require SERVICE-NEEDS aggregation at SWC-SERVICE-DEPENDENCY." ;
    sh:sparql [
      a sh:SPARQLConstraint ;
      sh:message "SWC-SERVICE-DEPENDENCY elements used for BswM interaction shall aggregate SERVICE-NEEDS." ;
      sh:select """
        PREFIX autosar: <http://autosar.org/>
        SELECT ?this
        WHERE {
          ?this autosar:SWC-SERVICE-DEPENDENCY ?dep .
          FILTER NOT EXISTS { ?dep autosar:SERVICE-NEEDS ?sn . }
        }
      """ ;
    ] .

########## Table_7_64 ##########
# RoleBasedPortAssignment for Crypto Service ClientServerInterfaces
# Structural SHACL is not sufficient to express “for every used ClientServerInterface
# there is a RoleBasedPortAssignment whose ROLE equals the interface SHORT-NAME”.
# This is handled in SMT only.


#################################################################
# SHACL shapes
#################################################################

#################################################################
# Table_7_94_iumprGroup_values
# Possible values for ObdRatioServiceNeeds.iumprGroup
#################################################################

autosar:Table_7_94_iumprGroup_values
    a sh:NodeShape ;
    sh:targetClass autosar:OBD-RATIO-SERVICE-NEEDS ;
    sh:property [
        sh:path autosar:IUMPR-GROUP ;
        sh:minCount 1 ;
        sh:in (
            "CAT1" "CAT2" "OXS1" "OXS2" "EGR" "SAIR" "EVAP"
            "SECOXS1" "SECOXS2" "NMHCCAT" "NOXCAT" "NOXADSORB"
            "PMFILTER" "EGSENSOR" "BOOSTPRS" "NOGROUP" "NONE"
        ) ;
        sh:severity sh:Violation ;
        sh:message "IUMPR-GROUP of OBD-RATIO-SERVICE-NEEDS must be one of the enumerated values." ;
    ] .

#################################################################
# VFB_Requirement_InvalidValueSpecification
# VFB Requirement for InvalidValue Specification
# (Specification / recommendation; INVALID-VALUE is optional in schema)
#################################################################

autosar:VFB_Requirement_InvalidValueSpecification
    a sh:NodeShape ;
    sh:targetClass autosar:SW-DATA-DEF-PROPS-CONTENT ;
    sh:property [
        sh:path autosar:INVALID-VALUE ;
        sh:severity sh:Info ;
        sh:message "VFB requires specification of INVALID-VALUE to indicate invalidation." ;
    ] .

#################################################################
# constr_1001
# Value of dataId shall be unique
#################################################################

autosar:constr_1001
    a sh:NodeShape ;
    sh:targetClass autosar:END-TO-END-DESCRIPTION ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "DATA-ID values within an END-TO-END-DESCRIPTION must be unique." ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this ?dataId
            WHERE {
              ?this a autosar:END-TO-END-DESCRIPTION .
              ?this autosar:DATA-IDS ?dataIdsWrapper .
              ?dataIdsWrapper autosar:DATA-ID ?dataIdNode1 .
              ?dataIdNode1 autosar:DATA-ID ?dataId .
              ?dataIdsWrapper autosar:DATA-ID ?dataIdNode2 .
              ?dataIdNode2 autosar:DATA-ID ?dataId .
              FILTER(?dataIdNode1 != ?dataIdNode2)
            }
        """ ;
    ] .
#################################################################
# constr_1006
# applicable data categories (no concrete restriction given)
#################################################################

autosar:constr_1006
    a sh:NodeShape ;
    sh:targetClass autosar:APPLICATION-ARRAY-DATA-TYPE ,autosar:APPLICATION-RECORD-DATA-TYPE ,autosar:APPLICATION-PRIMITIVE-DATA-TYPE ,autosar:IMPLEMENTATION-DATA-TYPE ;
    sh:property [
        sh:path autosar:CATEGORY ;
        sh:severity sh:Info ;
        sh:message "CATEGORY of data types shall follow the applicable data categories defined in the specification (Table 5.7)." ;
    ] .


