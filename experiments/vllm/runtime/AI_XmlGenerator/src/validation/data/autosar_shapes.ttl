#################################################################

# No stable structural pattern expressible in SHACL from given info; handled in SMT only.

#################################################################
# constr_1029 - ConstantSpecificationMapping and ConstantSpecification
#################################################################

# Structural: APPL-CONSTANT-REF and IMPL-CONSTANT-REF must be present and of correct DEST type

autosar:Constr_1029_ConstantSpecificationMapping_StructureShape
    a sh:NodeShape ;
    sh:targetClass autosar:CONSTANT-SPECIFICATION-MAPPING ;
    sh:severity sh:Violation ;

    sh:property [
        sh:path autosar:APPL-CONSTANT-REF ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path autosar:IMPL-CONSTANT-REF ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

#################################################################
# constr_1030 - ParameterSwComponentType references ConstantSpecificationMappingSet
#################################################################

autosar:Constr_1030_ParameterSwComponentType_ConstantMappingShape
    a sh:NodeShape ;
    sh:targetClass autosar:PARAMETER-SW-COMPONENT-TYPE ;
    sh:severity sh:Violation ;

    sh:property [
        sh:path ( autosar:CONSTANT-MAPPING-REFS autosar:CONSTANT-MAPPING-REF ) ;
        # optional, but if present must be of type CONSTANT-SPECIFICATION-MAPPING-SET (DEST checked elsewhere)
    ] .


# SHACL shapes

#################################################################
# constr_1031 - NvBlockSwComponentType references ConstantSpecificationMappingSet
#################################################################

autosar:constr_1031 a sh:NodeShape ;
  sh:targetClass autosar:NV-BLOCK-DESCRIPTOR ;
  sh:property [
    sh:path ( autosar:CONSTANT-VALUE-MAPPING-REFS autosar:CONSTANT-VALUE-MAPPING-REF ) ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    sh:message "CONSTANT-VALUE-MAPPING-REF in NV-BLOCK-DESCRIPTOR shall reference a CONSTANT-SPECIFICATION-MAPPING-SET." ;
  ] .

#################################################################
# constr_1032 - DelegationSwConnector can only connect PortPrototypes of the same kind
#################################################################

autosar:constr_1032 a sh:NodeShape ;
  sh:targetClass autosar:DELEGATION-SW-CONNECTOR ;
  sh:severity sh:Info ;
  sh:message "A DelegationSwConnector shall only connect PortPrototypes of the same kind (PPortPrototype to PPortPrototype, RPortPrototype to RPortPrototype)." .

#################################################################
# constr_1033 - Communication scenarios for sender/receiver communication
#################################################################

autosar:constr_1033 a sh:NodeShape ;
  sh:targetClass autosar:PORT-PROTOTYPE ;
  sh:severity sh:Info ;
  sh:message "For sender/receiver communication, it is not allowed to create a communication scenario where n senders are connected to m receivers with m>1 and n>1." .

#################################################################
# constr_1035 - Recursive definition of CompositionSwComponentType
#################################################################

autosar:constr_1035 a sh:NodeShape ;
  sh:targetClass autosar:COMPOSITION-SW-COMPONENT-TYPE ;
  sh:severity sh:Info ;
  sh:message "Recursive definition of a CompositionSwComponentType that eventually contains a SwComponentPrototype typed by the same CompositionSwComponentType shall not be feasible." .

#################################################################
# constr_1036 - Connect kinds of PortInterfaces
#################################################################

autosar:constr_1036 a sh:NodeShape ;
  sh:targetClass autosar:DATA-INTERFACE ;
  sh:severity sh:Info ;
  sh:message "PortPrototypes typed by PortInterfaces of different kinds shall not be connected. Subclasses of DataInterface are an exception and may be connected to each other." .

#################################################################
# constr_1037 - Client shall not be connected to multiple servers
#################################################################

autosar:constr_1037 a sh:NodeShape ;
  sh:targetClass autosar:CLIENT-SERVER-INTERFACE ;
  sh:severity sh:Info ;
  sh:message "A client shall not be connected to multiple servers such that an operation call would be handled by more than one server." .

#################################################################
# constr_1038 - Reference to ApplicationError
#################################################################

autosar:constr_1038 a sh:NodeShape ;
  sh:targetClass autosar:CLIENT-SERVER-OPERATION ;
  sh:property [
    sh:path ( autosar:POSSIBLE-ERROR-REFS autosar:POSSIBLE-ERROR-REF ) ;
    sh:nodeKind sh:IRI ;
    sh:severity sh:Violation ;
    sh:message "Each POSSIBLE-ERROR-REF of a ClientServerOperation shall reference an APPLICATION-ERROR owned by the same ClientServerInterface that owns the operation (checked by SMT)." ;
  ] .


#################################################################
# SHACL shapes for given constraints
#################################################################

########## constr_1039 – Relevance of swImplPolicy ##########
# Semantic: mapping constraint between elements with different swImplPolicy.
# Purely behavioral / mapping-level; no stable structural pattern given.
# → Leave to SMT only, no SHACL shape.

########## constr_1040 – Conversion of SenderReceiverInterfaces ##########
# Semantic: Conversion is possible if at least one of three conditions holds.
# No directly observable structural pattern (chapters 6.2 / 4.3.2 / transformation availability).
# → Leave to SMT only, no SHACL shape.

########## constr_1041 – Conversion of ClientServerInterfaces ##########
# Semantic: Either compatible AutosarDataTypes or conversion available.
# No directly observable structural pattern.
# → Leave to SMT only, no SHACL shape.

########## constr_1043 – PortInterface vs. ComSpec ##########
# Semantic: allowed combinations documented in a table, no explicit logic here.
# → Leave to SMT / external rule set, no SHACL shape.

########## constr_1044 – Applicability of DataFilter ##########
# Semantic: DataFilters can only be applied to values with an integer base type.
# No explicit path to the base type or its encoding is provided in the structured data.
# → Leave to SMT only, no SHACL shape.

########## constr_1045 – Supported value encodings for SwBaseType in the context of PortInterfaces ##########
# Semantic: restricts value encodings for SwBaseType when used in PortInterfaces.
# No explicit path from PORT-INTERFACE to the encoding attribute is provided.
# → Leave to SMT only, no SHACL shape.

########## constr_1046 – Applicability of [constr_1045] ##########
# Semantic: [constr_1045] applies only if isService = false.
# This is a conditional applicability rule, not a pure structural constraint.
# We only model the existence and boolean type of IS-SERVICE structurally.

autosar:Constr_1046_IsServiceShape
    a sh:NodeShape ;
    sh:severity sh:Info ;
    # Target concrete PortInterface XML tags (owner is abstract PORT-INTERFACE)
    sh:targetClass autosar:CLIENT-SERVER-INTERFACE ,autosar:NV-DATA-INTERFACE ,autosar:PARAMETER-INTERFACE ,autosar:SENDER-RECEIVER-INTERFACE ,autosar:MODE-SWITCH-INTERFACE ,autosar:TRIGGER-INTERFACE ;

    sh:property [
        sh:name "isService" ;
        sh:path autosar:IS-SERVICE ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
    ] .


# SHACL shapes for compatibility-related structural aspects

#################################################################
# constr_1047 - Compatibility of ApplicationPrimitiveDataTypes
#################################################################

autosar:Constr_1047_ApplicationPrimitiveDataType_Structure
    a sh:NodeShape ;
    sh:targetClass autosar:APPLICATION-PRIMITIVE-DATA-TYPE ;

    # CATEGORY is optional, if present must be a CATEGORY-STRING
    sh:property [
        sh:path autosar:CATEGORY ;
        sh:class autosar:CATEGORY-STRING ;
        sh:severity sh:Violation ;
        sh:message "If CATEGORY is present on APPLICATION-PRIMITIVE-DATA-TYPE it shall be of type CATEGORY-STRING." ;
    ] ;

    # SW-DATA-DEF-PROPS is optional, if present must be SW-DATA-DEF-PROPS
    sh:property [
        sh:path autosar:SW-DATA-DEF-PROPS ;
        sh:class autosar:SW-DATA-DEF-PROPS ;
        sh:severity sh:Violation ;
        sh:message "If SW-DATA-DEF-PROPS is present on APPLICATION-PRIMITIVE-DATA-TYPE it shall be of type SW-DATA-DEF-PROPS." ;
    ] .

#################################################################
# constr_1048 - Compatibility of ApplicationRecordDataTypes
#################################################################

autosar:Constr_1048_ApplicationRecordDataType_Structure
    a sh:NodeShape ;
    sh:targetClass autosar:APPLICATION-RECORD-DATA-TYPE ;

    # At least one APPLICATION-RECORD-ELEMENT via ELEMENTS wrapper
    sh:property [
        sh:path ( autosar:ELEMENTS autosar:APPLICATION-RECORD-ELEMENT ) ;
        sh:minCount 1 ;
        sh:class autosar:APPLICATION-RECORD-ELEMENT ;
        sh:severity sh:Violation ;
        sh:message "APPLICATION-RECORD-DATA-TYPE shall have at least one APPLICATION-RECORD-ELEMENT in ELEMENTS." ;
    ] .

#################################################################
# constr_1049 - Compatibility of ApplicationArrayDataTypes
#################################################################

autosar:Constr_1049_ApplicationArrayDataType_Structure
    a sh:NodeShape ;
    sh:targetClass autosar:APPLICATION-ARRAY-DATA-TYPE ;

    # Exactly one ELEMENT of type APPLICATION-ARRAY-ELEMENT
    sh:property [
        sh:path autosar:ELEMENT ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class autosar:APPLICATION-ARRAY-ELEMENT ;
        sh:severity sh:Violation ;
        sh:message "APPLICATION-ARRAY-DATA-TYPE shall have exactly one ELEMENT of type APPLICATION-ARRAY-ELEMENT." ;
    ] .

# Element-level structure (ARRAY-SIZE-SEMANTICS, MAX-NUMBER-OF-ELEMENTS)
autosar:Constr_1049_ApplicationArrayElement_Structure
    a sh:NodeShape ;
    sh:targetClass autosar:APPLICATION-ARRAY-ELEMENT ;

    sh:property [
        sh:path autosar:ARRAY-SIZE-SEMANTICS ;
        sh:class autosar:ARRAY-SIZE-SEMANTICS-ENUM ;
        sh:severity sh:Violation ;
        sh:message "If ARRAY-SIZE-SEMANTICS is present it shall be of type ARRAY-SIZE-SEMANTICS-ENUM." ;
    ] ;

    sh:property [
        sh:path autosar:MAX-NUMBER-OF-ELEMENTS ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class autosar:POSITIVE-INTEGER-VALUE-VARIATION-POINT ;
        sh:severity sh:Violation ;
        sh:message "MAX-NUMBER-OF-ELEMENTS shall be present exactly once and be of type POSITIVE-INTEGER-VALUE-VARIATION-POINT." ;
    ] .

#################################################################
# constr_1050 - Compatibility of ImplementationDataTypes
#################################################################

autosar:Constr_1050_ImplementationDataType_Structure
    a sh:NodeShape ;
    sh:targetClass autosar:IMPLEMENTATION-DATA-TYPE ;

    # CATEGORY optional, typed
    sh:property [
        sh:path autosar:CATEGORY ;
        sh:class autosar:CATEGORY-STRING ;
        sh:severity sh:Violation ;
        sh:message "If CATEGORY is present on IMPLEMENTATION-DATA-TYPE it shall be of type CATEGORY-STRING." ;
    ] ;

    # SW-DATA-DEF-PROPS optional, typed
    sh:property [
        sh:path autosar:SW-DATA-DEF-PROPS ;
        sh:class autosar:SW-DATA-DEF-PROPS ;
        sh:severity sh:Violation ;
        sh:message "If SW-DATA-DEF-PROPS is present on IMPLEMENTATION-DATA-TYPE it shall be of type SW-DATA-DEF-PROPS." ;
    ] ;

    # SUB-ELEMENTS/IMPLEMENTATION-DATA-TYPE-ELEMENT (0..*)
    sh:property [
        sh:path ( autosar:SUB-ELEMENTS autosar:IMPLEMENTATION-DATA-TYPE-ELEMENT ) ;
        sh:class autosar:IMPLEMENTATION-DATA-TYPE-ELEMENT ;
        sh:severity sh:Violation ;
        sh:message "SUB-ELEMENTS/IMPLEMENTATION-DATA-TYPE-ELEMENT, if present, shall be of type IMPLEMENTATION-DATA-TYPE-ELEMENT." ;
    ] .

# Element-level structure (ARRAY-SIZE, ARRAY-SIZE-SEMANTICS, nested SUB-ELEMENTS)
autosar:Constr_1050_ImplementationDataTypeElement_Structure
    a sh:NodeShape ;
    sh:targetClass autosar:IMPLEMENTATION-DATA-TYPE-ELEMENT ;

    sh:property [
        sh:path autosar:ARRAY-SIZE ;
        sh:class autosar:POSITIVE-INTEGER-VALUE-VARIATION-POINT ;
        sh:severity sh:Violation ;
        sh:message "If ARRAY-SIZE is present it shall be of type POSITIVE-INTEGER-VALUE-VARIATION-POINT." ;
    ] ;

    sh:property [
        sh:path autosar:ARRAY-SIZE-SEMANTICS ;
        sh:class autosar:ARRAY-SIZE-SEMANTICS-ENUM ;
        sh:severity sh:Violation ;
        sh:message "If ARRAY-SIZE-SEMANTICS is present it shall be of type ARRAY-SIZE-SEMANTICS-ENUM." ;
    ] ;

    sh:property [
        sh:path ( autosar:SUB-ELEMENTS autosar:IMPLEMENTATION-DATA-TYPE-ELEMENT ) ;
        sh:class autosar:IMPLEMENTATION-DATA-TYPE-ELEMENT ;
        sh:severity sh:Violation ;
        sh:message "Nested SUB-ELEMENTS/IMPLEMENTATION-DATA-TYPE-ELEMENT, if present, shall be of type IMPLEMENTATION-DATA-TYPE-ELEMENT." ;
    ] .

#################################################################
# constr_1051 - Compatibility of SwDataDefProps
#################################################################

autosar:Constr_1051_SwDataDefPropsContent_Structure
    a sh:NodeShape ;
    sh:targetClass autosar:SW-DATA-DEF-PROPS-CONTENT ;

    sh:property [
        sh:path autosar:SW-CALIBRATION-ACCESS ;
        sh:class autosar:SW-CALIBRATION-ACCESS-ENUM ;
        sh:severity sh:Violation ;
        sh:message "If SW-CALIBRATION-ACCESS is present it shall be of type SW-CALIBRATION-ACCESS-ENUM." ;
    ] ;

    sh:property [
        sh:path autosar:COMPU-METHOD-REF ;
        sh:class autosar:COMPU-METHOD ;
        sh:severity sh:Violation ;
        sh:message "If COMPU-METHOD-REF is present it shall reference a COMPU-METHOD." ;
    ] ;

    sh:property [
        sh:path autosar:DATA-CONSTR-REF ;
        sh:class autosar:DATA-CONSTR ;
        sh:severity sh:Violation ;
        sh:message "If DATA-CONSTR-REF is present it shall reference a DATA-CONSTR." ;
    ] ;

    sh:property [
        sh:path autosar:INVALID-VALUE ;
        sh:severity sh:Info ;
        sh:message "INVALID-VALUE participates in SwDataDefProps compatibility checks (see constr_1051)." ;
    ] ;

    sh:property [
        sh:path autosar:SW-RECORD-LAYOUT-REF ;
        sh:class autosar:SW-RECORD-LAYOUT ;
        sh:severity sh:Violation ;
        sh:message "If SW-RECORD-LAYOUT-REF is present it shall reference a SW-RECORD-LAYOUT." ;
    ] ;

    sh:property [
        sh:path autosar:UNIT-REF ;
        sh:class autosar:UNIT ;
        sh:severity sh:Violation ;
        sh:message "If UNIT-REF is present it shall reference a UNIT." ;
    ] .

#################################################################
# constr_1052 - Compatibility of Units
#################################################################

autosar:Constr_1052_Unit_Structure
    a sh:NodeShape ;
    sh:targetClass autosar:UNIT ;

    sh:property [
        sh:path autosar:FACTOR-SI-TO-UNIT ;
        sh:class autosar:FLOAT ;
        sh:severity sh:Violation ;
        sh:message "If FACTOR-SI-TO-UNIT is present it shall be of type FLOAT." ;
    ] ;

    sh:property [
        sh:path autosar:OFFSET-SI-TO-UNIT ;
        sh:class autosar:FLOAT ;
        sh:severity sh:Violation ;
        sh:message "If OFFSET-SI-TO-UNIT is present it shall be of type FLOAT." ;
    ] ;

    sh:property [
        sh:path autosar:PHYSICAL-DIMENSION-REF ;
        sh:class autosar:PHYSICAL-DIMENSION ;
        sh:severity sh:Violation ;
        sh:message "If PHYSICAL-DIMENSION-REF is present it shall reference a PHYSICAL-DIMENSION." ;
    ] .

#################################################################
# constr_1053 - Compatibility of PhysicalDimensions
#################################################################

autosar:Constr_1053_PhysicalDimension_Structure
    a sh:NodeShape ;
    sh:targetClass autosar:PHYSICAL-DIMENSION ;

    sh:property [
        sh:path autosar:LENGTH-EXP ;
        sh:severity sh:Violation ;
        sh:message "If LENGTH-EXP is present it participates in PhysicalDimension compatibility checks (constr_1053)." ;
    ] ;

    sh:property [
        sh:path autosar:MASS-EXP ;
        sh:severity sh:Violation ;
        sh:message "If MASS-EXP is present it participates in PhysicalDimension compatibility checks (constr_1053)." ;
    ] ;

    sh:property [
        sh:path autosar:TIME-EXP ;
        sh:severity sh:Violation ;
        sh:message "If TIME-EXP is present it participates in PhysicalDimension compatibility checks (constr_1053)." ;
    ] ;

    sh:property [
        sh:path autosar:CURRENT-EXP ;
        sh:severity sh:Violation ;
        sh:message "If CURRENT-EXP is present it participates in PhysicalDimension compatibility checks (constr_1053)." ;
    ] ;

    sh:property [
        sh:path autosar:TEMPERATURE-EXP ;
        sh:severity sh:Violation ;
        sh:message "If TEMPERATURE-EXP is present it participates in PhysicalDimension compatibility checks (constr_1053)." ;
    ] ;

    sh:property [
        sh:path autosar:MOLAR-AMOUNT-EXP ;
        sh:severity sh:Violation ;
        sh:message "If MOLAR-AMOUNT-EXP is present it participates in PhysicalDimension compatibility checks (constr_1053)." ;
    ] ;

    sh:property [
        sh:path autosar:LUMINOUS-INTENSITY-EXP ;
        sh:severity sh:Violation ;
        sh:message "If LUMINOUS-INTENSITY-EXP is present it participates in PhysicalDimension compatibility checks (constr_1053)." ;
    ] ;

    sh:property [
        sh:path autosar:SHORT-NAME ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class autosar:IDENTIFIER ;
        sh:severity sh:Violation ;
        sh:message "PHYSICAL-DIMENSION shall have exactly one SHORT-NAME of type IDENTIFIER." ;
    ] .


# 1) SHACL 约束

# constr_1054 - No DataConstr available at the provider
# 语义涉及“provider/receiver”兼容性，缺少明确 XML 结构，交由 SMT 处理，此处不建模。


# constr_1055 - ImplementationDataType has category VALUE
# 语义：BASE-TYPE-REF 的 DEST 必须是 SW-BASE-TYPE（跨文件引用类型约束）
# 结构路径信息不足（SW-DATA-DEF-PROPS-CONTENT 未给出从 IMPLEMENTATION-DATA-TYPE 的完整 path），
# 仅建模 BASE-TYPE-REF 的存在性与 DEST 类型由 SMT 负责。
autosar:Constr_1055_BaseTypeRefShape
    a sh:NodeShape ;
    sh:targetClass autosar:SW-BASE-TYPE ;
    sh:severity sh:Violation ;
    # BASE-TYPE-REF 是可选的（minOccurs=0），只做 if-present-then-type
    sh:property [
        sh:path autosar:BASE-TYPE-REF ;
        sh:nodeKind sh:IRI ;
    ] .


# constr_1056 - ImplementationDataType has category TYPE_REFERENCE
# 语义：SwDataDefProps.implementationDataType 引用的 ImplementationDataType 之间要“compatible”，
# 兼容性为复杂语义，交由 SMT；此处仅给出引用的结构路径。
autosar:Constr_1056_ImplDataTypeRefShape
    a sh:NodeShape ;
    sh:severity sh:Violation ;
    # 目标类无法从 expression 中唯一确定（只是“referenced ImplementationDataTypes”之间的关系），
    # 因此不设置 sh:targetClass，仅提供属性路径信息。
    sh:property [
        sh:path autosar:IMPLEMENTATION-DATA-TYPE-REF ;
        sh:nodeKind sh:IRI ;
    ] .


# constr_1057 - ImplementationDataType has category DATA_REFERENCE
# 语义：SwDataDefProps.swPointerTargetProps 的 targetCategory 相同且引用的 SwDataDefProps 完全相同。
# “完全相同”与“相同 targetCategory”为复杂全局条件，交由 SMT；此处仅建模结构路径。
autosar:Constr_1057_SwPointerTargetPropsShape
    a sh:NodeShape ;
    sh:severity sh:Violation ;
    sh:property [
        sh:path autosar:SW-POINTER-TARGET-PROPS ;
    ] ;
    sh:property [
        sh:path ( autosar:SW-POINTER-TARGET-PROPS autosar:TARGET-CATEGORY ) ;
    ] .


# constr_1058 - ImplementationDataType has category FUNCTION_REFERENCE
# 语义：swPointerTargetProps.functionPointerSignature 引用的 BswModuleEntry 必须解析到相同函数签名。
# 函数签名等运行时/语义信息交由 SMT；此处仅建模目标类与结构路径。
autosar:Constr_1058_FunctionPointerSignatureShape
    a sh:NodeShape ;
    sh:targetClass autosar:BSW-MODULE-ENTRY ;
    sh:severity sh:Violation ;
    sh:property [
        sh:path autosar:SW-POINTER-TARGET-PROPS ;
    ] .


# constr_1059 - Compatibility of data types with category VALUE
# 语义：ApplicationDataType(category=VALUE) 与 ImplementationDataType(category=VALUE) 的数值范围兼容，
# 需要 DataConstr、CompuMethod、SwBaseType 等多方信息，属于复杂数值/范围逻辑，交由 SMT。
# 此处仅建模 ApplicationDataType 的 SW-DATA-DEF-PROPS 与 CATEGORY 的结构路径。
autosar:Constr_1059_AppDataTypeValueShape
    a sh:NodeShape ;
    sh:targetClass autosar:APPLICATION-DATA-TYPE ;
    sh:severity sh:Violation ;
    sh:property [
        sh:path autosar:SW-DATA-DEF-PROPS ;
    ] ;
    sh:property [
        sh:path autosar:CATEGORY ;
    ] .


# constr_1060 - Compatibility of data types with category ARRAY, VAL_BLK
# 语义：ApplicationDataType(category in {ARRAY, VAL_BLK}) 只能映射到
#  ImplementationDataType(category=ARRAY 或 Variable-Size Array)，并要求 array size 等 1:1 映射。
# 这些匹配条件交由 SMT；此处仅建模相关结构路径。
autosar:Constr_1060_ArrayValBlkShape
    a sh:NodeShape ;
    sh:targetClass autosar:APPLICATION-DATA-TYPE ;
    sh:severity sh:Violation ;
    sh:property [
        sh:path autosar:CATEGORY ;
    ] ;
    sh:property [
        sh:path autosar:DYNAMIC-ARRAY-SIZE-PROFILE ;
    ] ;
    sh:property [
        sh:path ( autosar:SUB-ELEMENTS autosar:IMPLEMENTATION-DATA-TYPE-ELEMENT ) ;
    ] .


#################################################################
# SHACL shapes for selected structural parts
#################################################################

######## constr_1066 – Forbidden mappings to ImplementationDataType
# Only the ImplementationDataType side is structurally checkable here.

autosar:Constr_1066_ImplementationDataType_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:IMPLEMENTATION-DATA-TYPE ;
    sh:property [
        sh:path autosar:CATEGORY ;
        sh:datatype xsd:string ;
    ] ;
    sh:severity sh:Violation ;
    sh:name "Forbidden mappings to ImplementationDataType – category presence" .

######## constr_1068 – Compatibility of Variable/ParameterDataPrototypes (primitive types)
# Only simple structural constraints (presence and DEST typing) are modeled.

autosar:Constr_1068_TypeRef_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:AUTOSAR-DATA-PROTOTYPE ;
    sh:property [
        sh:path autosar:TYPE-TREF ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:severity sh:Violation ;
    sh:name "Primitive-typed DataPrototype must have TYPE-TREF" .

autosar:Constr_1068_SwDataDefProps_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:DATA-PROTOTYPE ;
    sh:property [
        sh:path autosar:SW-DATA-DEF-PROPS ;
        sh:maxCount 1 ;
    ] ;
    sh:severity sh:Violation ;
    sh:name "At most one SW-DATA-DEF-PROPS per DataPrototype" .

autosar:Constr_1068_DataPrototypeMapping_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:DATA-PROTOTYPE-MAPPING ;
    sh:property [
        sh:path autosar:FIRST-DATA-PROTOTYPE-REF ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path autosar:SECOND-DATA-PROTOTYPE-REF ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:severity sh:Violation ;
    sh:name "DataPrototypeMapping must reference first/second DataPrototype" .

autosar:Constr_1068_ApplicationPrimitiveDataType_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:APPLICATION-PRIMITIVE-DATA-TYPE ;
    sh:property [
        sh:path autosar:CATEGORY ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path autosar:SHORT-NAME ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:severity sh:Violation ;
    sh:name "ApplicationPrimitiveDataType basic structure for compatibility" .

######## constr_1069 – AssemblySwConnector / PortPrototype compatibility (isService + mapping)
# Only structural parts: presence of IS-SERVICE, SHORT-NAME, MAPPING-REF, DATA-PROTOTYPE-MAPPING.

autosar:Constr_1069_PortInterface_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:PORT-INTERFACE ;
    sh:property [
        sh:path autosar:IS-SERVICE ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
    ] ;
    sh:severity sh:Violation ;
    sh:name "PortInterface must have IS-SERVICE for compatibility checks (AssemblySwConnector)" .

autosar:Constr_1069_AssemblySwConnector_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:ASSEMBLY-SW-CONNECTOR ;
    sh:property [
        sh:path autosar:SHORT-NAME ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path autosar:MAPPING-REF ;
        sh:datatype xsd:string ;
    ] ;
    sh:severity sh:Info ;
    sh:name "AssemblySwConnector optional mapping reference" .

autosar:Constr_1069_VariableAndParameterInterfaceMapping_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:VARIABLE-AND-PARAMETER-INTERFACE-MAPPING ;
    sh:property [
        sh:path ( autosar:DATA-MAPPINGS autosar:DATA-PROTOTYPE-MAPPING ) ;
        sh:minCount 1 ;
    ] ;
    sh:severity sh:Violation ;
    sh:name "VariableAndParameterInterfaceMapping must have at least one DATA-PROTOTYPE-MAPPING" .

######## constr_1070 – DelegationSwConnector / DataInterface compatibility (isService + mapping)
# Only structural parts: IS-SERVICE, SHORT-NAME, DATA-PROTOTYPE-MAPPING.

autosar:Constr_1070_PortInterface_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:PORT-INTERFACE ;
    sh:property [
        sh:path autosar:IS-SERVICE ;
        sh:minCount 1 ;
        sh:datatype xsd:boolean ;
    ] ;
    sh:severity sh:Violation ;
    sh:name "PortInterface must have IS-SERVICE for compatibility checks (DelegationSwConnector)" .

autosar:Constr_1070_DataInterface_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:DATA-INTERFACE ;
    sh:property [
        sh:path autosar:SHORT-NAME ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:severity sh:Violation ;
    sh:name "DataInterface must have SHORT-NAME for compatibility checks" .

autosar:Constr_1070_VariableAndParameterInterfaceMapping_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:VARIABLE-AND-PARAMETER-INTERFACE-MAPPING ;
    sh:property [
        sh:path ( autosar:DATA-MAPPINGS autosar:DATA-PROTOTYPE-MAPPING ) ;
        sh:minCount 1 ;
    ] ;
    sh:severity sh:Violation ;
    sh:name "VariableAndParameterInterfaceMapping must have at least one DATA-PROTOTYPE-MAPPING (Delegation)" .


autosar:Constr_1071_ParameterVariableCompatibilityShape
    a sh:NodeShape ;
    sh:targetClass autosar:PARAMETER-DATA-PROTOTYPE ;
    sh:severity sh:Violation ;
    sh:message "Combinations of ParameterDataPrototype and VariableDataPrototype used in PortPrototypes typed by various kinds of PortInterfaces shall only be allowed where Table 6.1 contains the value 'yes'." .

autosar:Constr_1072_ModeSwitchInterfaces_AssemblySwConnectorShape
    a sh:NodeShape ;
    sh:targetClass autosar:ASSEMBLY-SW-CONNECTOR ;
    sh:severity sh:Violation ;
    sh:message "PortPrototypes of different ModeSwitchInterfaces connected by an AssemblySwConnector are compatible only if the ModeDeclarationGroupPrototypes are compatible (directly or via ModeInterfaceMapping.modeMapping) and the corresponding ModeSwitchInterfaces have identical isService values." .

autosar:Constr_1073_ModeSwitchInterfaces_DelegationSwConnectorShape
    a sh:NodeShape ;
    sh:targetClass autosar:DELEGATION-SW-CONNECTOR ;
    sh:severity sh:Violation ;
    sh:message "PortPrototypes of different ModeSwitchInterfaces connected by a DelegationSwConnector are compatible only if the ModeDeclarationGroupPrototypes are compatible (directly or via ModeInterfaceMapping.modeMapping) and the corresponding ModeSwitchInterfaces have identical isService values." .

autosar:Constr_1074_ModeDeclarationGroupPrototypeCompatibilityShape
    a sh:NodeShape ;
    sh:targetClass autosar:MODE-DECLARATION-GROUP ;
    sh:severity sh:Violation ;
    sh:message "ModeDeclarationGroupPrototypes are compatible if and only if they are typed by compatible ModeDeclarationGroups or a ModeDeclarationGroupPrototypeMapping exists that identifies the corresponding ModeDeclarationGroupPrototypes." .

autosar:Constr_1075_ModeDeclarationGroupCompatibilityShape
    a sh:NodeShape ;
    sh:targetClass autosar:MODE-DECLARATION-MAPPING ;
    sh:severity sh:Violation ;
    sh:property [
        sh:path ( autosar:MODE-DECLARATION-GROUP autosar:CATEGORY ) ;
        sh:datatype autosar:CATEGORY-STRING
    ] ;
    sh:property [
        sh:path ( autosar:MODE-DECLARATION autosar:VALUE ) ;
        sh:datatype autosar:POSITIVE-INTEGER
    ] ;
    sh:property [
        sh:path ( autosar:MODE-DECLARATION-GROUP autosar:INITIAL-MODE-REF ) ;
        sh:class autosar:MODE-DECLARATION
    ] ;
    sh:property [
        sh:path ( autosar:MODE-DECLARATION-GROUP autosar:MODE-DECLARATIONS autosar:MODE-DECLARATION ) ;
        sh:class autosar:MODE-DECLARATION
    ] ;
    sh:property [
        sh:path ( autosar:MODE-DECLARATION-GROUP autosar:MODE-MANAGER-ERROR-BEHAVIOR ) ;
        sh:class autosar:MODE-ERROR-BEHAVIOR
    ] ;
    sh:property [
        sh:path ( autosar:MODE-DECLARATION-GROUP autosar:MODE-USER-ERROR-BEHAVIOR ) ;
        sh:class autosar:MODE-ERROR-BEHAVIOR
    ] ;
    sh:property [
        sh:path ( autosar:MODE-DECLARATION-GROUP autosar:ON-TRANSITION-VALUE ) ;
        sh:datatype autosar:POSITIVE-INTEGER
    ] ;
    sh:property [
        sh:path ( autosar:MODE-DECLARATION autosar:SHORT-NAME ) ;
        sh:datatype autosar:IDENTIFIER
    ] ;
    sh:message "ModeDeclarationGroups are compatible if and only if they satisfy the detailed structural and attribute equivalence conditions or a ModeDeclarationMapping is applied that identifies corresponding ModeDeclarations; corresponding ModeTransitions must also be compatible." .

autosar:Constr_1076_ArgumentDataPrototypeCompatibilityShape
    a sh:NodeShape ;
    sh:targetClass autosar:AUTOSAR-DATA-TYPE ;
    sh:severity sh:Violation ;
    sh:property [
        sh:path ( autosar:ARGUMENT-DATA-PROTOTYPE autosar:DIRECTION ) ;
        sh:datatype autosar:ARGUMENT-DIRECTION-ENUM ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path ( autosar:ARGUMENT-DATA-PROTOTYPE autosar:TYPE-TREF ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path ( autosar:CLIENT-SERVER-OPERATION-MAPPING autosar:ARGUMENT-MAPPINGS autosar:DATA-PROTOTYPE-MAPPING ) ;
        sh:class autosar:DATA-PROTOTYPE-MAPPING
    ] ;
    sh:message "Two ArgumentDataPrototypes are compatible if and only if they are typed by compatible AutosarDataTypes or are related by a ClientServerOperationMapping.argumentMapping, and they have the same argument direction." .

autosar:Constr_1077_ApplicationErrorCompatibilityShape
    a sh:NodeShape ;
    sh:severity sh:Violation ;
    sh:property [
        sh:path ( autosar:APPLICATION-ERROR autosar:ERROR-CODE ) ;
        sh:datatype autosar:INTEGER ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path ( autosar:APPLICATION-ERROR autosar:SHORT-NAME ) ;
        sh:datatype autosar:IDENTIFIER ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path ( autosar:CLIENT-SERVER-INTERFACE-MAPPING autosar:ERROR-MAPPINGS autosar:CLIENT-SERVER-APPLICATION-ERROR-MAPPING ) ;
        sh:class autosar:CLIENT-SERVER-APPLICATION-ERROR-MAPPING
    ] ;
    sh:message "Two ApplicationErrors are compatible if and only if they have identical shortName and attributes (especially errorCode) or are related by a ClientServerInterfaceMapping.errorMapping." .


# SHACL for constr_1078 - Compatibility of ClientServerOperations
autosar:Constr_1078_Compatibility_of_ClientServerOperations
    a sh:NodeShape ;
    sh:severity sh:Violation ;
    sh:targetClass autosar:CLIENT-SERVER-OPERATION ;

    # Structural: SHORT-NAME must exist (Referrable, minOccurs=1)
    sh:property [
        sh:path autosar:SHORT-NAME ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    # Structural: ARGUMENT-DATA-PROTOTYPE path (if present, via ARGUMENTS)
    sh:property [
        sh:path ( autosar:ARGUMENTS autosar:ARGUMENT-DATA-PROTOTYPE ) ;
    ] ;

    # Structural: POSSIBLE-ERROR-REF path (if present, via POSSIBLE-ERROR-REFS)
    sh:property [
        sh:path ( autosar:POSSIBLE-ERROR-REFS autosar:POSSIBLE-ERROR-REF ) ;
    ] ;

    # Logical aspects (pairwise compatibility, iff, ordering, ApplicationError coverage)
    # are handled in SMT, not SHACL.
.

# SHACL for constr_1079 - Compatibility of ClientServerInterfaces in AssemblySwConnector context
autosar:Constr_1079_Compatibility_of_ClientServerInterfaces_Assembly a sh:NodeShape ; sh:severity sh:Violation ; sh:targetClass autosar:ASSEMBLY-SW-CONNECTOR ; sh:property [ sh:path ( autosar:CLIENT-SERVER-INTERFACE autosar:IS-SERVICE ) ; sh:minCount 1 ; sh:maxCount 1 ] ; sh:property [ sh:path ( autosar:CLIENT-SERVER-INTERFACE-MAPPING autosar:OPERATION-MAPPINGS autosar:CLIENT-SERVER-OPERATION-MAPPING ) ] .


# SHACL for constr_1080 - Compatibility of ClientServerInterfaces in DelegationSwConnector context
autosar:Constr_1080_Compatibility_of_ClientServerInterfaces_Delegation a sh:NodeShape ; sh:severity sh:Violation ; sh:targetClass autosar:DELEGATION-SW-CONNECTOR ; sh:property [ sh:path ( autosar:CLIENT-SERVER-INTERFACE autosar:IS-SERVICE ) ; sh:minCount 1 ; sh:maxCount 1 ] ; sh:property [ sh:path ( autosar:CLIENT-SERVER-INTERFACE-MAPPING autosar:OPERATION-MAPPINGS autosar:CLIENT-SERVER-OPERATION-MAPPING ) ] .

# SHACL for constr_1081 - Compatibility of TriggerInterfaces in AssemblySwConnector context
autosar:Constr_1081_Compatibility_of_TriggerInterfaces_Assembly a sh:NodeShape ; sh:severity sh:Violation ; sh:targetClass autosar:ASSEMBLY-SW-CONNECTOR ; sh:property [ sh:path ( autosar:TRIGGER-INTERFACE autosar:IS-SERVICE ) ; sh:minCount 1 ; sh:maxCount 1 ] ; sh:property [ sh:path ( autosar:TRIGGER-INTERFACE-MAPPING autosar:TRIGGER-MAPPINGS autosar:TRIGGER-MAPPING ) ] .

# SHACL for constr_1082 - Compatibility of TriggerInterfaces in DelegationSwConnector context
autosar:Constr_1082_Compatibility_of_TriggerInterfaces_Delegation a sh:NodeShape ; sh:severity sh:Violation ; sh:targetClass autosar:DELEGATION-SW-CONNECTOR ; sh:property [ sh:path ( autosar:TRIGGER-INTERFACE autosar:IS-SERVICE ) ; sh:minCount 1 ; sh:maxCount 1 ] ; sh:property [ sh:path ( autosar:TRIGGER-INTERFACE-MAPPING autosar:TRIGGER-MAPPINGS autosar:TRIGGER-MAPPING ) ] .


# SHACL for constr_1083 - Compatibility of Triggers (pairwise, handled in SMT)
autosar:Constr_1083_Compatibility_of_Triggers
    a sh:NodeShape ;
    sh:severity sh:Violation ;

    # Target is pairwise compatibility between Triggers; no concrete XML
    # target class can be bound here without a pairing mechanism.
    # Leave sh:targetClass empty and delegate to SMT.
.

# SHACL for constr_1084 - Delegation of a provided outer PortPrototype
autosar:Constr_1084_Delegation_of_Provided_Outer_PortPrototype
    a sh:NodeShape ;
    sh:severity sh:Violation ;
    sh:targetClass autosar:CLIENT-SERVER-INTERFACE ;

    # Structural: SHORT-NAME of CLIENT-SERVER-OPERATION (minOccurs=1)
    sh:property [
        sh:path ( autosar:CLIENT-SERVER-OPERATION autosar:SHORT-NAME ) ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    # Structural: SW-IMPL-POLICY on SW-DATA-DEF-PROPS-CONTENT (optional)
    sh:property [
        sh:path ( autosar:SW-DATA-DEF-PROPS-CONTENT autosar:SW-IMPL-POLICY ) ;
    ] ;
.


autosar:Constr_1085_CompatibilityFlatEcuExtract
    a sh:NodeShape ;
    sh:severity sh:Violation ;
    sh:targetClass autosar:NV-DATA-INTERFACE ;
    .

autosar:Constr_1086_SwConnectorBetweenTwoPortPrototypes
    a sh:NodeShape ;
    sh:severity sh:Violation ;
    sh:targetClass autosar:PORT-PROTOTYPE ;
    .

autosar:Constr_1087_AssemblySwConnectorInsideComposition
    a sh:NodeShape ;
    sh:severity sh:Violation ;
    sh:targetClass autosar:ASSEMBLY-SW-CONNECTOR ;
    .

autosar:Constr_1088_DelegationSwConnectorInsideComposition
    a sh:NodeShape ;
    sh:severity sh:Violation ;
    sh:targetClass autosar:COMPOSITION-SW-COMPONENT-TYPE ;
    sh:property [
        sh:path ( autosar:DELEGATION-SW-CONNECTOR autosar:INNER-PORT-IREF ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    sh:property [
        sh:path ( autosar:DELEGATION-SW-CONNECTOR autosar:OUTER-PORT-REF ) ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    .

autosar:Constr_1090_WaitPointAndRunnableEntity
    a sh:NodeShape ;
    sh:severity sh:Violation ;
    sh:targetClass autosar:RUNNABLE-ENTITY ;
    sh:property [
        sh:path ( autosar:WAIT-POINTS autosar:WAIT-POINT ) ;
        sh:maxCount 1
    ] ;
    .

autosar:Constr_1091_RteEventsThatCanUnblockWaitPoint
    a sh:NodeShape ;
    sh:severity sh:Violation ;
    sh:targetClass autosar:WAIT-POINT ;
    sh:property [
        sh:path autosar:TRIGGER-REF ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] ;
    .

autosar:Constr_1092_ParameterSwComponentType
    a sh:NodeShape ;
    sh:severity sh:Violation ;
    sh:targetClass autosar:PARAMETER-SW-COMPONENT-TYPE ;
    sh:property [
        sh:path autosar:PORTS
    ] ;
    .


#################################################################
# SHACL shapes
#################################################################

########## constr_1095 – Values of nDataSets vs. reliability ##########

autosar:constr_1095
    a sh:NodeShape ;
    sh:targetClass autosar:NV-BLOCK-NEEDS ;
    sh:severity sh:Violation ;

    # nDataSets present and > 0  ⇒  reliability must not be "errorCorrection"
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "If N-DATA-SETS is greater than 0 the RELIABILITY shall not be set to errorCorrection." ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this WHERE {
              ?this autosar:N-DATA-SETS ?n .
              FILTER(xsd:integer(?n) > 0) .
              ?this autosar:RELIABILITY ?rel .
              FILTER(str(?rel) = "errorCorrection")
            }
        """ ;
    ] .

########## constr_1096 – SwcModeSwitchEvent and WaitPoint ##########

autosar:constr_1096
    a sh:NodeShape ;
    sh:targetClass autosar:SWC-MODE-SWITCH-EVENT ;
    sh:severity sh:Violation ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A RunnableEntity that has a WAIT-POINT shall not be referenced by a SwcModeSwitchEvent via START-ON-EVENT-REF." ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this WHERE {
              ?this autosar:START-ON-EVENT-REF ?runRef .
              ?runRef autosar:ref ?runnable .
              ?runnable autosar:WAIT-POINTS ?wps .
              ?wps autosar:WAIT-POINT ?wp .
            }
        """ ;
    ] .

########## constr_1097 – RunnableEntity that has a WaitPoint ##########

# Abstract RTE-EVENT has many concrete XML tags; SHACL left empty per rules.
# Constraint handled in SMT only.

########## constr_1098 – Mode switch and mode disabling ##########

autosar:constr_1098
    a sh:NodeShape ;
    sh:targetClass autosar:SWC-MODE-SWITCH-EVENT ;
    sh:severity sh:Violation ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "A SwcModeSwitchEvent shall not reference the same ModeDeclaration in both MODE-IREF and DISABLED-MODE-IREF." ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this WHERE {
              ?this autosar:MODE-IREFS ?mwrap .
              ?mwrap autosar:MODE-IREF ?mref .
              ?mref autosar:ref ?modeDecl .

              ?this autosar:DISABLED-MODE-IREFS ?dwrap .
              ?dwrap autosar:DISABLED-MODE-IREF ?dref .
              ?dref autosar:ref ?modeDecl .
            }
        """ ;
    ] .

########## constr_1100 – Unconnected RPortPrototype typed by a DataInterface ##########

# Structural part: if REQUIRED-COM-SPECS exist, they must contain NONQUEUED-RECEIVER-COM-SPEC
autosar:constr_1100
    a sh:NodeShape ;
    sh:targetClass autosar:R-PORT-PROTOTYPE ;
    sh:severity sh:Violation ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For any element in an unconnected RPortPrototype typed by a DataInterface there shall be a REQUIRED-COM-SPECS/NONQUEUED-RECEIVER-COM-SPEC with INIT-VALUE." ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this WHERE {
              ?this autosar:type ?ifc .
              ?ifc a autosar:DATA-INTERFACE .

              # assume unconnected is determined outside SHACL; here we only check initValue coverage
              ?this autosar:REQUIRED-COM-SPECS ?rcs .

              # some data element of the interface
              ?ifc autosar:NONQUEUED-RECEIVER-COM-SPEC ?nqcs .

              FILTER NOT EXISTS {
                ?rcs autosar:NONQUEUED-RECEIVER-COM-SPEC ?nqcs .
                ?nqcs autosar:INIT-VALUE ?iv .
              }
            }
        """ ;
    ] .

########## constr_1101 – Mode-related communication ##########

# No stable path information for SwConnector/RPortPrototype relation; SHACL left empty.
# Constraint handled in SMT only.

########## constr_1103 – NonqueuedReceiverComSpec and enableUpdate ##########

autosar:constr_1103
    a sh:NodeShape ;
    sh:targetClass autosar:NONQUEUED-RECEIVER-COM-SPEC ;
    sh:severity sh:Violation ;

    sh:property [
        sh:path autosar:ENABLE-UPDATE ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
    ] ;

    sh:property [
        sh:path autosar:DATA-ELEMENT-REF ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "If ENABLE-UPDATE is true, the referenced dataElement may not be referenced by a VARIABLE-ACCESS in role dataReadAccess." ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this WHERE {
              ?this autosar:ENABLE-UPDATE ?flag .
              FILTER(xsd:boolean(?flag) = true) .
              ?this autosar:DATA-ELEMENT-REF ?deRef .
              ?deRef autosar:ref ?de .

              ?va autosar:VARIABLE-ACCESS-DATA-READ ?de .
            }
        """ ;
    ] .


#################################################################
# SHACL for constr_1104 - Trigger sink and trigger source
#################################################################

autosar:constr_1104 a sh:NodeShape ;
  sh:targetClass autosar:P-PORT-PROTOTYPE ;
  sh:severity sh:Violation ;
  sh:message "An RPortPrototype typed by a TriggerInterface shall not be referenced by more than one SwConnectors that are in turn referencing PPortPrototypes typed by TriggerInterfaces that contain Triggers with the same SHORT-NAME."@en .

#################################################################
# SHACL for constr_1105 - Value of arraySize
#################################################################

# Target 1: ImplementationDataTypeElement owned by ImplementationDataType of category ARRAY
autosar:constr_1105_IDT a sh:NodeShape ;
  sh:targetClass autosar:IMPLEMENTATION-DATA-TYPE ;
  sh:severity sh:Violation ;
  sh:message "For ImplementationDataType of category ARRAY, the value of ARRAY-SIZE of its owned ImplementationDataTypeElement shall be greater than 0."@en ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "ARRAY-SIZE must be > 0 for ImplementationDataTypeElement owned by ImplementationDataType of category ARRAY."@en ;
    sh:select """
      PREFIX autosar: <http://autosar.org/>
      SELECT ?this
      WHERE {
        ?this autosar:CATEGORY ?cat .
        FILTER(?cat = "ARRAY") .
        ?this autosar:SUB-ELEMENTS ?subs .
        ?subs autosar:IMPLEMENTATION-DATA-TYPE-ELEMENT ?elt .
        ?elt autosar:ARRAY-SIZE ?asz .
        FILTER(?asz <= 0) .
      }
    """
  ] .

# Target 2: ImplementationDataTypeElement whose owner is an ImplementationDataTypeElement of category ARRAY
autosar:constr_1105_IDTE a sh:NodeShape ;
  sh:targetClass autosar:IMPLEMENTATION-DATA-TYPE-ELEMENT ;
  sh:severity sh:Violation ;
  sh:message "For ImplementationDataTypeElement of category ARRAY, the value of ARRAY-SIZE shall be greater than 0."@en ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "ARRAY-SIZE must be > 0 for ImplementationDataTypeElement of category ARRAY."@en ;
    sh:select """
      PREFIX autosar: <http://autosar.org/>
      SELECT ?this
      WHERE {
        ?this autosar:CATEGORY ?cat .
        FILTER(?cat = "ARRAY") .
        ?this autosar:ARRAY-SIZE ?asz .
        FILTER(?asz <= 0) .
      }
    """
  ] .

#################################################################
# SHACL for constr_1106 - Structure shall have at least one element
#################################################################

# Target 1: ImplementationDataType of category STRUCTURE
autosar:constr_1106_IDT a sh:NodeShape ;
  sh:targetClass autosar:IMPLEMENTATION-DATA-TYPE ;
  sh:severity sh:Violation ;
  sh:message "An ImplementationDataType of category STRUCTURE shall own at least one IMPLEMENTATION-DATA-TYPE-ELEMENT."@en ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "STRUCTURE ImplementationDataType must own at least one IMPLEMENTATION-DATA-TYPE-ELEMENT."@en ;
    sh:select """
      PREFIX autosar: <http://autosar.org/>
      SELECT ?this
      WHERE {
        ?this autosar:CATEGORY ?cat .
        FILTER(?cat = "STRUCTURE") .
        OPTIONAL {
          ?this autosar:SUB-ELEMENTS ?subs .
          ?subs autosar:IMPLEMENTATION-DATA-TYPE-ELEMENT ?elt .
        }
        FILTER(!BOUND(?elt)) .
      }
    """
  ] .

# Target 2: ImplementationDataTypeElement of category STRUCTURE
autosar:constr_1106_IDTE a sh:NodeShape ;
  sh:targetClass autosar:IMPLEMENTATION-DATA-TYPE-ELEMENT ;
  sh:severity sh:Violation ;
  sh:message "An ImplementationDataTypeElement of category STRUCTURE shall own at least one IMPLEMENTATION-DATA-TYPE-ELEMENT."@en ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "STRUCTURE ImplementationDataTypeElement must own at least one IMPLEMENTATION-DATA-TYPE-ELEMENT."@en ;
    sh:select """
      PREFIX autosar: <http://autosar.org/>
      SELECT ?this
      WHERE {
        ?this autosar:CATEGORY ?cat .
        FILTER(?cat = "STRUCTURE") .
        OPTIONAL {
          ?this autosar:SUB-ELEMENTS ?subs .
          ?subs autosar:IMPLEMENTATION-DATA-TYPE-ELEMENT ?elt .
        }
        FILTER(!BOUND(?elt)) .
      }
    """
  ] .

