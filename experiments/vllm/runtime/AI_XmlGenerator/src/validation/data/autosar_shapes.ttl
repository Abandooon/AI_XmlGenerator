#################################################################
# SHACL for constr_1108 - Value of ApplicationError.errorCode
#################################################################

autosar:constr_1108 a sh:NodeShape ;
  sh:targetClass autosar:APPLICATION-ERROR ;
  sh:severity sh:Violation ;
  sh:message "ApplicationError.errorCode shall be in 1..63, except that 0 is allowed only if the possibleError represents E_OK (handled by SMT/semantics)."@en ;
  sh:property [
    sh:path autosar:ERROR-CODE ;
    sh:datatype xsd:integer ;
    sh:minInclusive 0 ;
    sh:maxInclusive 63
  ] .

#################################################################
# SHACL for constr_1109 - Mapping of SwComponentPrototypes typed by a SensorActuatorSwComponentType
#################################################################

autosar:constr_1109 a sh:NodeShape ;
  sh:targetClass autosar:HW-ELEMENT ;
  sh:severity sh:Info ;
  sh:message "A SwComponentPrototype typed by a SensorActuatorSwComponentType needs to be mapped and run on exactly that ECU that contains the HwElement corresponding to the HwType that its SensorActuatorSwComponentType refers to when accessing hardware via the I/O hardware abstraction layer. (Detailed mapping checked by SMT/other tooling.)"@en .

#################################################################
# SHACL for constr_1110 - Value of category in EndToEndDescription
#################################################################

autosar:constr_1110 a sh:NodeShape ;
  sh:targetClass autosar:END-TO-END-DESCRIPTION ;
  sh:severity sh:Violation ;
  sh:message "The attribute CATEGORY of EndToEndDescription can only have the values: NONE, PROFILE_01, PROFILE_02."@en ;
  sh:property [
    sh:path autosar:CATEGORY ;
    sh:minCount 1 ;
    sh:in ( "NONE" "PROFILE_01" "PROFILE_02" )
  ] .


#################################################################
# SHACL for PROFILE_01 constraints
#################################################################

########## constr_1111 – Constraints of dataId in PROFILE_01 ##########

autosar:Constr_1111_Profile01_DataId
    a sh:NodeShape ;
    sh:severity sh:Violation ;

    # Target: END-TO-END-DESCRIPTION with CATEGORY = "PROFILE_01"
    sh:targetClass autosar:END-TO-END-DESCRIPTION ;

    # CATEGORY must be PROFILE_01
    sh:property [
        sh:path autosar:CATEGORY ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "PROFILE_01" ;
    ] ;

    # Only one DATA-ID element in DATA-IDS
    sh:property [
        sh:path ( autosar:DATA-IDS autosar:DATA-ID ) ;
        sh:maxCount 1 ;
    ] ;

    # DATA-ID value range [0 .. 65535]
    sh:property [
        sh:path ( autosar:DATA-IDS autosar:DATA-ID ) ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxInclusive 65535 ;
    ] ;
.

########## constr_1112 – Constraints of dataIdMode in PROFILE_01 ##########

autosar:Constr_1112_Profile01_DataIdMode
    a sh:NodeShape ;
    sh:severity sh:Violation ;

    sh:targetClass autosar:END-TO-END-DESCRIPTION ;

    sh:property [
        sh:path autosar:CATEGORY ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "PROFILE_01" ;
    ] ;

    # DATA-ID-MODE value range [0 .. 3]
    sh:property [
        sh:path autosar:DATA-ID-MODE ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxInclusive 3 ;
    ] ;
.

########## constr_1113 – Existence of attributes in PROFILE_01 ##########

autosar:Constr_1113_Profile01_Existence
    a sh:NodeShape ;
    sh:severity sh:Violation ;

    sh:targetClass autosar:END-TO-END-DESCRIPTION ;

    sh:property [
        sh:path autosar:CATEGORY ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "PROFILE_01" ;
    ] ;

    # DATA-LENGTH must exist (exactly one)
    sh:property [
        sh:path autosar:DATA-LENGTH ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    # DATA-ID must exist (at least one in DATA-IDS)
    sh:property [
        sh:path ( autosar:DATA-IDS autosar:DATA-ID ) ;
        sh:minCount 1 ;
    ] ;
.

########## constr_1114 – Constraints of crcOffset in PROFILE_01 ##########

autosar:Constr_1114_Profile01_CrcOffset
    a sh:NodeShape ;
    sh:severity sh:Violation ;

    sh:targetClass autosar:END-TO-END-DESCRIPTION ;

    sh:property [
        sh:path autosar:CATEGORY ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "PROFILE_01" ;
    ] ;

    # CRC-OFFSET value range [0 .. 65535]
    sh:property [
        sh:path autosar:CRC-OFFSET ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxInclusive 65535 ;
    ] ;

    # CRC-OFFSET mod 4 = 0
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "In PROFILE_01, CRC-OFFSET must be a multiple of 4." ;
        sh:severity sh:Violation ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this WHERE {
              ?this autosar:CATEGORY \"PROFILE_01\" .
              ?this autosar:CRC-OFFSET ?v .
              FILTER ( (xsd:integer(?v) MOD 4) != 0 )
            }
        """ ;
    ] ;
.

########## constr_1115 – Constraints of counterOffset in PROFILE_01 ##########

autosar:Constr_1115_Profile01_CounterOffset
    a sh:NodeShape ;
    sh:severity sh:Violation ;

    sh:targetClass autosar:END-TO-END-DESCRIPTION ;

    sh:property [
        sh:path autosar:CATEGORY ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "PROFILE_01" ;
    ] ;

    # COUNTER-OFFSET value range [0 .. 65535]
    sh:property [
        sh:path autosar:COUNTER-OFFSET ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxInclusive 65535 ;
    ] ;

    # COUNTER-OFFSET mod 4 = 0
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "In PROFILE_01, COUNTER-OFFSET must be a multiple of 4." ;
        sh:severity sh:Violation ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this WHERE {
              ?this autosar:CATEGORY \"PROFILE_01\" .
              ?this autosar:COUNTER-OFFSET ?v .
              FILTER ( (xsd:integer(?v) MOD 4) != 0 )
            }
        """ ;
    ] ;
.

########## constr_1116 – Constraints of dataLength in PROFILE_01 ##########

autosar:Constr_1116_Profile01_DataLength
    a sh:NodeShape ;
    sh:severity sh:Violation ;

    sh:targetClass autosar:END-TO-END-DESCRIPTION ;

    sh:property [
        sh:path autosar:CATEGORY ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "PROFILE_01" ;
    ] ;

    # DATA-LENGTH value range [0 .. 240]
    sh:property [
        sh:path autosar:DATA-LENGTH ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxInclusive 240 ;
    ] ;

    # DATA-LENGTH mod 8 = 0
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "In PROFILE_01, DATA-LENGTH must be a multiple of 8." ;
        sh:severity sh:Violation ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this WHERE {
              ?this autosar:CATEGORY \"PROFILE_01\" .
              ?this autosar:DATA-LENGTH ?v .
              FILTER ( (xsd:integer(?v) MOD 8) != 0 )
            }
        """ ;
    ] ;
.

########## constr_1117 – Constraints of maxDeltaCounterInit in PROFILE_01 ##########

autosar:Constr_1117_Profile01_MaxDeltaCounterInit
    a sh:NodeShape ;
    sh:severity sh:Violation ;

    # This shape applies to all three concrete XML elements that carry MAX-DELTA-COUNTER-INIT
    sh:targetClass autosar:END-TO-END-DESCRIPTION ;
    sh:targetClass autosar:NONQUEUED-RECEIVER-COM-SPEC ;
    sh:targetClass autosar:QUEUED-RECEIVER-COM-SPEC ;

    # For END-TO-END-DESCRIPTION with CATEGORY PROFILE_01
    sh:property [
        sh:path autosar:CATEGORY ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "PROFILE_01" ;
    ] ;

    # MAX-DELTA-COUNTER-INIT in END-TO-END-DESCRIPTION
    sh:property [
        sh:path autosar:MAX-DELTA-COUNTER-INIT ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxInclusive 14 ;
    ] ;

    # MAX-DELTA-COUNTER-INIT in NONQUEUED-RECEIVER-COM-SPEC
    sh:property [
        sh:path autosar:MAX-DELTA-COUNTER-INIT ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxInclusive 14 ;
    ] ;

    # MAX-DELTA-COUNTER-INIT in QUEUED-RECEIVER-COM-SPEC
    sh:property [
        sh:path autosar:MAX-DELTA-COUNTER-INIT ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxInclusive 14 ;
    ] ;
.


# SHACL for constr_1118 - PROFILE_02 attributes
autosar:Constr_1118_PROFILE02_Attributes a sh:NodeShape ; sh:severity sh:Violation ; sh:targetClass autosar:END-TO-END-DESCRIPTION ; sh:property [ sh:path autosar:CATEGORY ; sh:hasValue "PROFILE_02" ] ; sh:sparql [ sh:message "In PROFILE_02, only dataLength and dataId attributes shall exist on END-TO-END-DESCRIPTION." ; sh:severity sh:Violation ; sh:select """PREFIX autosar: <http://autosar.org/> SELECT ?this ?p ?o WHERE { ?this a autosar:END-TO-END-DESCRIPTION ; autosar:CATEGORY "PROFILE_02" ; ?p ?o . FILTER(?p NOT IN ( autosar:CATEGORY, autosar:DATA-LENGTH, autosar:DATA-IDS )) }""" ] .

# SHACL for constr_1119 - PROFILE_02 dataLength
autosar:Constr_1119_PROFILE02_DataLength a sh:NodeShape ; sh:severity sh:Violation ; sh:targetClass autosar:END-TO-END-DESCRIPTION ; sh:property [ sh:path autosar:CATEGORY ; sh:hasValue "PROFILE_02" ] ; sh:property [ sh:path autosar:DATA-LENGTH ; sh:minInclusive 0 ; sh:maxInclusive 65535 ; sh:datatype xsd:integer ] ; sh:sparql [ sh:message "In PROFILE_02, DATA-LENGTH must be a multiple of 8." ; sh:severity sh:Violation ; sh:select """PREFIX autosar: <http://autosar.org/> PREFIX xsd: <http://www.w3.org/2001/XMLSchema#> SELECT ?this ?value WHERE { ?this a autosar:END-TO-END-DESCRIPTION ; autosar:CATEGORY "PROFILE_02" ; autosar:DATA-LENGTH ?value . FILTER ( (xsd:integer(?value) MOD 8) != 0 ) }""" ] .


autosar:Constr_1120_PROFILE02_DataId
    a sh:NodeShape ;
    sh:severity sh:Violation ;
    sh:targetClass autosar:END-TO-END-DESCRIPTION ;

    sh:property [
        sh:path autosar:CATEGORY ;
        sh:hasValue "PROFILE_02" ;
    ] ;

    # exactly 16 DATA-ID elements
    sh:property [
        sh:path ( autosar:DATA-IDS autosar:DATA-ID ) ;
        sh:minCount 16 ;
        sh:maxCount 16 ;
    ] ;

    # each DATA-ID in [0..255]
    sh:property [
        sh:path ( autosar:DATA-IDS autosar:DATA-ID ) ;
        sh:minInclusive 0 ;
        sh:maxInclusive 255 ;
        sh:datatype xsd:integer ;
    ] .

autosar:Constr_1121_PROFILE02_MaxDeltaCounterInit_EndToEndDescription
    a sh:NodeShape ;
    sh:severity sh:Violation ;
    sh:targetClass autosar:END-TO-END-DESCRIPTION ;

    sh:property [
        sh:path autosar:CATEGORY ;
        sh:hasValue "PROFILE_02" ;
    ] ;

    sh:property [
        sh:path autosar:MAX-DELTA-COUNTER-INIT ;
        sh:minInclusive 0 ;
        sh:maxInclusive 15 ;
        sh:datatype xsd:integer ;
    ] .

autosar:Constr_1121_PROFILE02_MaxDeltaCounterInit_ReceiverComSpec
    a sh:NodeShape ;
    sh:severity sh:Violation ;

    sh:targetClass autosar:NONQUEUED-RECEIVER-COM-SPEC ;
    sh:property [
        sh:path autosar:MAX-DELTA-COUNTER-INIT ;
        sh:minInclusive 0 ;
        sh:maxInclusive 15 ;
        sh:datatype xsd:integer ;
    ] ;

    sh:targetClass autosar:QUEUED-RECEIVER-COM-SPEC ;
    sh:property [
        sh:path autosar:MAX-DELTA-COUNTER-INIT ;
        sh:minInclusive 0 ;
        sh:maxInclusive 15 ;
        sh:datatype xsd:integer ;
    ] .

autosar:Constr_1126_DataConstr_Compatibility
    a sh:NodeShape ;
    sh:severity sh:Info ;
    sh:targetClass autosar:DATA-CONSTR .

autosar:Constr_1128_QueueLength_SameRunnable
    a sh:NodeShape ;
    sh:severity sh:Info ;
    sh:targetClass autosar:CLIENT-SERVER-OPERATION .

autosar:Constr_1129_swImplPolicy_NonqueuedReceiverComSpec
    a sh:NodeShape ;
    sh:severity sh:Violation ;
    sh:targetClass autosar:NONQUEUED-RECEIVER-COM-SPEC ;

    sh:property [
        sh:path autosar:DATA-ELEMENT-REF ;
        sh:minCount 1 ;
    ] .


autosar:constr_1130_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:QUEUED-RECEIVER-COM-SPEC ;
    sh:severity sh:Violation ;
    sh:message "The attribute swImplPolicy of a dataElement referenced by a QueuedReceiverComSpec shall be set to the value queued." ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "swImplPolicy of the referenced dataElement shall be 'queued' for QUEUED-RECEIVER-COM-SPEC." ;
        sh:severity sh:Violation ;
        sh:select """
PREFIX autosar: <http://autosar.org/>

SELECT ?this
WHERE {
  ?this a autosar:QUEUED-RECEIVER-COM-SPEC .
  ?this autosar:DATA-ELEMENT-REF ?dataElem .
  ?dataElem autosar:SW-DATA-DEF-PROPS-CONTENT ?swProps .
  ?swProps autosar:SW-IMPL-POLICY ?pol .
  FILTER (STR(?pol) != "queued")
}
        """ ;
    ] .

autosar:constr_1131_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:NONQUEUED-SENDER-COM-SPEC ;
    sh:severity sh:Violation ;
    sh:message "The attribute swImplPolicy of a dataElement referenced by a NonqueuedSenderComSpec shall not be set to the value queued." ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "swImplPolicy of the referenced dataElement shall NOT be 'queued' for NONQUEUED-SENDER-COM-SPEC." ;
        sh:severity sh:Violation ;
        sh:select """
PREFIX autosar: <http://autosar.org/>

SELECT ?this
WHERE {
  ?this a autosar:NONQUEUED-SENDER-COM-SPEC .
  ?this autosar:DATA-ELEMENT-REF ?dataElem .
  ?dataElem autosar:SW-DATA-DEF-PROPS-CONTENT ?swProps .
  ?swProps autosar:SW-IMPL-POLICY ?pol .
  FILTER (STR(?pol) = "queued")
}
        """ ;
    ] .

autosar:constr_1132_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:QUEUED-SENDER-COM-SPEC ;
    sh:severity sh:Violation ;
    sh:message "The attribute swImplPolicy of a dataElement referenced by a QueuedSenderComSpec shall be set to the value queued." ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "swImplPolicy of the referenced dataElement shall be 'queued' for QUEUED-SENDER-COM-SPEC." ;
        sh:severity sh:Violation ;
        sh:select """
PREFIX autosar: <http://autosar.org/>

SELECT ?this
WHERE {
  ?this a autosar:QUEUED-SENDER-COM-SPEC .
  ?this autosar:DATA-ELEMENT-REF ?dataElem .
  ?dataElem autosar:SW-DATA-DEF-PROPS-CONTENT ?swProps .
  ?swProps autosar:SW-IMPL-POLICY ?pol .
  FILTER (STR(?pol) != "queued")
}
        """ ;
    ] .

autosar:constr_1133_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:COMPU-METHOD ;
    sh:severity sh:Violation ;
    sh:message "In a CompuMethod subject to constr_1146, CompuScales with identical symbolic names shall have identical lower/upper limits." ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "CompuScales with identical SYMBOL within a COMPU-METHOD shall have the same LOWER-LIMIT and UPPER-LIMIT." ;
        sh:severity sh:Violation ;
        sh:select """
PREFIX autosar: <http://autosar.org/>

SELECT ?this
WHERE {
  ?this a autosar:COMPU-METHOD .
  ?this autosar:COMPU-SCALE ?scale1 .
  ?this autosar:COMPU-SCALE ?scale2 .
  FILTER (?scale1 != ?scale2) .
  ?scale1 autosar:SYMBOL ?sym .
  ?scale2 autosar:SYMBOL ?sym .
  OPTIONAL { ?scale1 autosar:LOWER-LIMIT ?ll1 . }
  OPTIONAL { ?scale2 autosar:LOWER-LIMIT ?ll2 . }
  OPTIONAL { ?scale1 autosar:UPPER-LIMIT ?ul1 . }
  OPTIONAL { ?scale2 autosar:UPPER-LIMIT ?ul2 . }
  FILTER ( (BOUND(?ll1) && BOUND(?ll2) && ?ll1 != ?ll2) ||
           (BOUND(?ul1) && BOUND(?ul2) && ?ul1 != ?ul2) )
}
        """ ;
    ] .

autosar:constr_1134_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:COMPU-METHOD ;
    sh:severity sh:Violation ;
    sh:message "physConstr is not allowed. compuInternalToPhys shall exist with CompuScales consisting of upperLimit and lowerLimit (TEXTTABLE structure)." ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For COMPU-METHOD of category TEXTTABLE: no physConstr, compuInternalToPhys must exist, and each COMPU-SCALE must have LOWER-LIMIT and UPPER-LIMIT." ;
        sh:severity sh:Violation ;
        sh:select """
PREFIX autosar: <http://autosar.org/>

SELECT ?this
WHERE {
  ?this a autosar:COMPU-METHOD .
  ?this autosar:CATEGORY ?cat .
  FILTER (STR(?cat) = "TEXTTABLE") .

  OPTIONAL { ?this autosar:PHYS-CONSTR ?physConstr . }
  FILTER (!BOUND(?physConstr)) .

  FILTER NOT EXISTS { ?this autosar:COMPU-INTERNAL-TO-PHYS ?cip . }

  OPTIONAL {
    ?this autosar:COMPU-SCALE ?scale .
    OPTIONAL { ?scale autosar:LOWER-LIMIT ?ll . }
    OPTIONAL { ?scale autosar:UPPER-LIMIT ?ul . }
    FILTER (!BOUND(?ll) || !BOUND(?ul))
  }
}
        """ ;
    ] .

autosar:constr_1135_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:COMPU-METHOD ;
    sh:severity sh:Violation ;
    sh:message "For BITFIELD_TEXTTABLE, the separator is '|' and is forbidden in vt." ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "For COMPU-METHOD of category BITFIELD_TEXTTABLE, VT must not contain the character '|'." ;
        sh:severity sh:Violation ;
        sh:select """
PREFIX autosar: <http://autosar.org/>

SELECT ?this
WHERE {
  ?this a autosar:COMPU-METHOD .
  ?this autosar:CATEGORY ?cat .
  FILTER (STR(?cat) = "BITFIELD_TEXTTABLE") .
  ?this autosar:COMPU-CONST-TEXT-CONTENT ?cctc .
  ?cctc autosar:VT ?vt .
  FILTER CONTAINS(STR(?vt), "|")
}
        """ ;
    ] .

autosar:constr_1137_Shape
    a sh:NodeShape ;
    sh:targetClass autosar:P-PORT-PROTOTYPE ;
    sh:severity sh:Violation ;
    sh:message "A PPortPrototype typed by a ParameterInterface can only be owned by a ParameterSwComponentType." ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "If a P-PORT-PROTOTYPE is typed by a PARAMETER-INTERFACE, its owning component must be a PARAMETER-SW-COMPONENT-TYPE." ;
        sh:severity sh:Violation ;
        sh:select """
PREFIX autosar: <http://autosar.org/>

SELECT ?this
WHERE {
  ?this a autosar:P-PORT-PROTOTYPE .
  ?this autosar:PROVIDED-INTERFACE-REF ?ifRef .
  ?ifRef autosar:DEST ?ifDest .
  FILTER (STR(?ifDest) = "PARAMETER-INTERFACE") .
  ?owner autosar:P-PORT-PROTOTYPE ?this .
  FILTER NOT EXISTS {
    ?owner a autosar:PARAMETER-SW-COMPONENT-TYPE .
  }
}
        """ ;
    ] .


#################################################################
# SHACL for constr_1138 - assignedPort and DiagEventDebounceMonitorInternal
#################################################################

autosar:constr_1138_AssignedPortAndDiagEventDebounceMonitorInternalShape
    a sh:NodeShape ;
    sh:targetClass autosar:DIAG-EVENT-DEBOUNCE-MONITOR-INTERNAL ;
    sh:severity sh:Violation ;
    sh:message "The existence of an assignedPort in combination with a DiagEventDebounceAlgorithm shall only be respected for the concrete subclass DiagEventDebounceMonitorInternal."@en ;
    # Structural: if a DIAG-EVENT-DEBOUNCE-MONITOR-INTERNAL exists, it may have a DIAG-EVENT-DEBOUNCE-ALGORITHM.
    sh:property [
        sh:path ( autosar:DIAGNOSTIC-EVENT-NEEDS autosar:DIAG-EVENT-DEBOUNCE-ALGORITHM ) ;
    ] .

#################################################################
# SHACL for constr_1139 - assignedPort of DiagEventDebounceMonitorInternal
#################################################################

autosar:constr_1139_AssignedPortOfDiagEventDebounceMonitorInternalShape
    a sh:NodeShape ;
    sh:targetClass autosar:DIAG-EVENT-DEBOUNCE-MONITOR-INTERNAL ;
    sh:severity sh:Violation ;
    sh:message "assignedPort defined with respect to a DiagEventDebounceMonitorInternal may only refer to an RPortPrototype and shall have role DiagFaultDetectionCounterPort."@en ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "assignedPort of DiagEventDebounceMonitorInternal shall refer to an RPortPrototype and have role DiagFaultDetectionCounterPort."@en ;
        sh:select """
PREFIX autosar: <http://autosar.org/>

SELECT ?this
WHERE {
  ?this autosar:ASSIGNED-PORTS ?apContainer .
  ?apContainer autosar:ROLE-BASED-PORT-ASSIGNMENT ?ap .
  ?ap autosar:ROLE ?roleLiteral .
  FILTER (STR(?roleLiteral) != "DiagFaultDetectionCounterPort")
}
""" ;
    ] .

#################################################################
# SHACL for constr_1140 - Combination of invalidValue with handleInvalid
#################################################################

autosar:constr_1140_CombinationInvalidValueHandleInvalidShape
    a sh:NodeShape ;
    sh:severity sh:Violation ;
    sh:message "The combination of handleInvalid='replace' with initValue effectively equal to invalidValue is not supported."@en ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "handleInvalid='replace' must not be combined with initValue equal to invalidValue."@en ;
        sh:select """
PREFIX autosar: <http://autosar.org/>

SELECT ?this
WHERE {
  ?this autosar:INVALIDATION-POLICY ?invPol .
  ?invPol autosar:HANDLE-INVALID ?handleInvalid .
  FILTER (STR(?handleInvalid) = "replace") .

  ?this autosar:NONQUEUED-RECEIVER-COM-SPEC ?nqrcs .
  ?nqrcs autosar:INIT-VALUE ?initVal .

  ?this autosar:SW-DATA-DEF-PROPS-CONTENT ?swdp .
  ?swdp autosar:INVALID-VALUE ?invalidVal .

  FILTER (STR(?initVal) = STR(?invalidVal))
}
""" ;
    ] .

