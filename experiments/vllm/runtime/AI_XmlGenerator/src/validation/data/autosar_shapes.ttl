    sh:targetClass autosar:COMPOSITION-SW-COMPONENT-TYPE .

# TPS_SWCT_01405 – Creation of the ServiceSwComponentTypes
# 语义：在 ECU 配置中，为每个 Service 所需端口在 ServiceSwComponentType 上创建足够数量的 PortPrototypes。
# 这是行为性/方法学约束，无法从给定结构中提取精确计数规则，因此仅绑定目标类。
autosar:TPS_SWCT_01405_Shape
    a sh:NodeShape ;
    sh:severity sh:Info ;
    sh:targetClass autosar:PORT-PROTOTYPE .

# TPS_SWCT_01406 – Creation of SwComponentPrototype typed by a ServiceSwComponentType
# 语义核心：SwComponentPrototype 的 TYPE-TREF 可以指向多种 SW-COMPONENT-TYPE，
# 但“Per Service exactly one SwComponentPrototype typed by a ServiceSwComponentType”是全局计数/方法学约束，
# 无法仅凭局部结构精确表达；结构上只保留 TYPE-TREF 的存在与类型信息由其他约束承担。
autosar:TPS_SWCT_01406_Shape
    a sh:NodeShape ;
    sh:severity sh:Info ;
    sh:targetClass autosar:PORT-PROTOTYPE .

# TPS_SWCT_01407 – Creation of InternalBehavior typed by a ServiceSwComponentType
# 语义：每个 ServiceSwComponentType 有一个 SwcInternalBehavior，其中包含 RunnableEntity、RTEEvents 等。
# 给定信息不足以在 SHACL 中表达“每个 ServiceSwComponentType 至少一个 SwcInternalBehavior 且其内容满足特定关系”，
# 因此仅绑定目标类。
autosar:TPS_SWCT_01407_Shape
    a sh:NodeShape ;
    sh:severity sh:Info ;
    sh:targetClass autosar:PORT-DEFINED-ARGUMENT-VALUE .


