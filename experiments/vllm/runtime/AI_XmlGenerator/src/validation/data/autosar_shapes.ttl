########## Table_5_8_AppDataType_COM_AXIS_swCalibrationAccess_Multiplicity ##########

# Target: ApplicationDataType specializations with CATEGORY = "COM_AXIS"
# Concrete XML classes (applies_to_class is abstract-ish APPLICATION-DATA-TYPE):
#   APPLICATION-ARRAY-DATA-TYPE
#   APPLICATION-RECORD-DATA-TYPE
#   APPLICATION-PRIMITIVE-DATA-TYPE

autosar:Table_5_8_AppDataType_COM_AXIS_swCalibrationAccess_Multiplicity_Array
    a sh:NodeShape ;
    sh:targetClass autosar:APPLICATION-ARRAY-DATA-TYPE ;
    sh:severity sh:Violation ;
    sh:message "For an ApplicationDataType with category COM_AXIS, SW-CALIBRATION-ACCESS must have multiplicity 1." ;
    sh:and (
      [ sh:path autosar:CATEGORY ;
        sh:hasValue "COM_AXIS"
      ]
      [ sh:path ( autosar:SW-DATA-DEF-PROPS autosar:SW-DATA-DEF-PROPS-CONTENT autosar:SW-CALIBRATION-ACCESS ) ;
        sh:minCount 1 ;
        sh:maxCount 1
      ]
    ) .

autosar:Table_5_8_AppDataType_COM_AXIS_swCalibrationAccess_Multiplicity_Record
    a sh:NodeShape ;
    sh:targetClass autosar:APPLICATION-RECORD-DATA-TYPE ;
    sh:severity sh:Violation ;
    sh:message "For an ApplicationDataType with category COM_AXIS, SW-CALIBRATION-ACCESS must have multiplicity 1." ;
    sh:and (
      [ sh:path autosar:CATEGORY ;
        sh:hasValue "COM_AXIS"
      ]
      [ sh:path ( autosar:SW-DATA-DEF-PROPS autosar:SW-DATA-DEF-PROPS-CONTENT autosar:SW-CALIBRATION-ACCESS ) ;
        sh:minCount 1 ;
        sh:maxCount 1
      ]
    ) .

autosar:Table_5_8_AppDataType_COM_AXIS_swCalibrationAccess_Multiplicity_Primitive
    a sh:NodeShape ;
    sh:targetClass autosar:APPLICATION-PRIMITIVE-DATA-TYPE ;
    sh:severity sh:Violation ;
    sh:message "For an ApplicationDataType with category COM_AXIS, SW-CALIBRATION-ACCESS must have multiplicity 1." ;
    sh:and (
      [ sh:path autosar:CATEGORY ;
        sh:hasValue "COM_AXIS"
      ]
      [ sh:path ( autosar:SW-DATA-DEF-PROPS autosar:SW-DATA-DEF-PROPS-CONTENT autosar:SW-CALIBRATION-ACCESS ) ;
        sh:minCount 1 ;
        sh:maxCount 1
      ]
    ) .

########## Table_5_8_AppDataType_STRUCTURE_RecordElement_Multiplicity ##########

# Target: ApplicationRecordDataType with category STRUCTURE
# CATEGORY is on APPLICATION-RECORD-DATA-TYPE; path for elements is
# APPLICATION-RECORD-DATA-TYPE/ELEMENTS/APPLICATION-RECORD-ELEMENT

autosar:Table_5_8_AppDataType_STRUCTURE_RecordElement_Multiplicity
    a sh:NodeShape ;
    sh:targetClass autosar:APPLICATION-RECORD-DATA-TYPE ;
    sh:severity sh:Violation ;
    sh:message "For an ApplicationDataType with category STRUCTURE, APPLICATION-RECORD-ELEMENT must have multiplicity 1..*." ;
    sh:and (
      [ sh:path autosar:CATEGORY ;
        sh:hasValue "STRUCTURE"
      ]
      [ sh:path ( autosar:ELEMENTS autosar:APPLICATION-RECORD-ELEMENT ) ;
        sh:minCount 1
      ]
    ) .

########## Table_5_8_AppDataType_VAL_BLK_swRecordLayout_Multiplicity ##########

# Target: ApplicationDataType specializations with CATEGORY = "VAL_BLK"
# swRecordLayout is a REF inside SW-DATA-DEF-PROPS-CONTENT

autosar:Table_5_8_AppDataType_VAL_BLK_swRecordLayout_Multiplicity_Array
    a sh:NodeShape ;
    sh:targetClass autosar:APPLICATION-ARRAY-DATA-TYPE ;
    sh:severity sh:Violation ;
    sh:message "For an ApplicationDataType with category VAL_BLK, SW-RECORD-LAYOUT-REF has multiplicity 0..1." ;
    sh:and (
      [ sh:path autosar:CATEGORY ;
        sh:hasValue "VAL_BLK"
      ]
      [ sh:path ( autosar:SW-DATA-DEF-PROPS autosar:SW-DATA-DEF-PROPS-CONTENT autosar:SW-RECORD-LAYOUT-REF ) ;
        sh:maxCount 1
      ]
    ) .

autosar:Table_5_8_AppDataType_VAL_BLK_swRecordLayout_Multiplicity_Record
    a sh:NodeShape ;
    sh:targetClass autosar:APPLICATION-RECORD-DATA-TYPE ;
    sh:severity sh:Violation ;
    sh:message "For an ApplicationDataType with category VAL_BLK, SW-RECORD-LAYOUT-REF has multiplicity 0..1." ;
    sh:and (
      [ sh:path autosar:CATEGORY ;
        sh:hasValue "VAL_BLK"
      ]
      [ sh:path ( autosar:SW-DATA-DEF-PROPS autosar:SW-DATA-DEF-PROPS-CONTENT autosar:SW-RECORD-LAYOUT-REF ) ;
