# constr_1277 - SwDataDefProps.swImplPolicy not queued for VariableAccess in dataReceivePointByValue
#################################################################



# SHACL for constr_1278 - PhysConstrs references a Unit
autosar:constr_1278_Shape
  a sh:NodeShape ;
  sh:targetClass autosar:DATA-CONSTR ;
  sh:severity sh:Violation ;
  sh:message "DataConstrs are only compatible if the DataConstr.dataConstrRule.physConstrs.unit are compatible or neither DataConstr.dataConstrRule.physConstrs.unit exist." ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "DataConstrs are only compatible if the referenced Units in physConstrs are compatible or no Units are referenced." ;
    sh:severity sh:Violation ;
    sh:select """
      PREFIX autosar: <http://autosar.org/>
      SELECT ?this
      WHERE {
        ?this a autosar:DATA-CONSTR .
        # Placeholder: compatibility of Units between DataConstrs is a cross-object semantic
        # and is not expressible in simple SHACL without a project-specific notion of
        # 'compatible units'. This constraint is therefore delegated to SMT.
        FILTER(false)
      }
    """
  ] .

# SHACL for constr_1279 - Unmapped elements ... and swImplPolicy
# No stable XML path from swImplPolicy (TRIGGER) to unmapped elements of composite data types.
# Constraint delegated to SMT only; no SHACL node shape emitted.

# SHACL for constr_1280 - Unmapped dataElement on the receiver side shall have an initValue
autosar:constr_1280_Shape
  a sh:NodeShape ;
  sh:targetClass autosar:ABSTRACT-REQUIRED-PORT-PROTOTYPE ;
  sh:severity sh:Violation ;
  sh:message "If elements of composite data types (STRUCTURE/ARRAY) are not considered in a SubElementMapping then the enclosing dataElement shall have an initValue if the NonqueuedReceiverComSpec is aggregated by an AbstractRequiredPortPrototype." ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "Unmapped elements on the receiver side require an initValue in the enclosing dataElement when aggregated by a NonqueuedReceiverComSpec." ;
    sh:severity sh:Violation ;
    sh:select """
      PREFIX autosar: <http://autosar.org/>
      SELECT ?this
      WHERE {
        ?this a autosar:ABSTRACT-REQUIRED-PORT-PROTOTYPE .
        # Detailed navigation from port prototype to NonqueuedReceiverComSpec,
        # to dataElement, to SubElementMapping, and to Application/Implementation
        # composite data types is model-specific and not available in this snippet.
        # This structural/behavioral constraint is therefore handled in SMT.
        FILTER(false)
      }
    """
  ] .

# SHACL for constr_1281 - invalidValue is inside the scope of the compuMethod
autosar:constr_1281_Shape
  a sh:NodeShape ;
  sh:targetClass autosar:APPLICATION-VALUE-SPECIFICATION ;
  sh:severity sh:Violation ;
  sh:message "If invalidValue of an ApplicationPrimitiveDataType of category VALUE is supposed to be inside the scope of the applicable CompuMethod then an ApplicationValueSpecification shall be used to describe the invalidValue." ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "ApplicationPrimitiveDataType of category VALUE with invalidValue inside compuMethod scope shall use ApplicationValueSpecification." ;
    sh:severity sh:Violation ;
    sh:select """
      PREFIX autosar: <http://autosar.org/>
      SELECT ?this
      WHERE {
        ?this a autosar:APPLICATION-VALUE-SPECIFICATION .
        # The trigger 'invalidValue is inside the scope of the applicable CompuMethod'
        # is semantic and not directly observable from XML structure alone.
        # Enforcement is delegated to SMT.
        FILTER(false)
      }
    """
  ] .

# SHACL for constr_1281_Explanation - Value range for ApplicationValueSpecification used as invalidValue
autosar:constr_1281_Explanation_Shape
  a sh:NodeShape ;
  sh:targetClass autosar:APPLICATION-VALUE-SPECIFICATION ;
  sh:severity sh:Violation ;
  sh:message "The value of the ApplicationValueSpecification used for invalidValue shall be within the bounds defined by the applicable CompuMethod (physToInternal or internalToPhys)." ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "ApplicationValueSpecification used as invalidValue must lie within the lower/upper limits of the applicable CompuMethod scale (physToInternal or internalToPhys)." ;
    sh:severity sh:Violation ;
    sh:select """
      PREFIX autosar: <http://autosar.org/>
      SELECT ?this
      WHERE {
        ?this a autosar:APPLICATION-VALUE-SPECIFICATION .
        # Requires numeric comparison against compuMethod scale limits, which are
        # not directly accessible in this abstracted path model. Delegated to SMT.
        FILTER(false)
      }
    """
  ] .

# SHACL for constr_1282 - Restriction on RuleBasedValueSpecification / ReferenceValueSpecification
autosar:constr_1282_Shape
  a sh:NodeShape ;
  sh:targetClass autosar:REFERENCE-VALUE-SPECIFICATION ;
  sh:severity sh:Violation ;
  sh:message "The aggregation of a RuleBasedValueSpecification or a ReferenceValueSpecification for the definition of ApplicationPrimitiveDataType.swDataDefProps.invalidValue is not supported." ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "REFERENCE-VALUE-SPECIFICATION shall not be used as invalidValue of ApplicationPrimitiveDataType.swDataDefProps." ;
    sh:severity sh:Violation ;
    sh:select """
      PREFIX autosar: <http://autosar.org/>
      SELECT ?this
      WHERE {
        ?this a autosar:REFERENCE-VALUE-SPECIFICATION .
        # This constraint forbids using REFERENCE-VALUE-SPECIFICATION as the
        # INVALID-VALUE under SW-DATA-DEF-PROPS-CONTENT. Detecting that context
        # requires model-specific parent navigation; delegated to SMT.
        FILTER(false)
      }
    """
  ] .

# SHACL for constr_1283 - invalidValue is outside the scope of the compuMethod
autosar:constr_1283_Shape
  a sh:NodeShape ;
  sh:targetClass autosar:NUMERICAL-VALUE-SPECIFICATION ;
  sh:severity sh:Violation ;
  sh:message "If invalidValue of an ApplicationPrimitiveDataType of category VALUE is supposed to be outside the scope of the applicable CompuMethod then a NumericalValueSpecification shall be used to describe the invalidValue." ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "ApplicationPrimitiveDataType of category VALUE with invalidValue outside compuMethod scope shall use NumericalValueSpecification." ;
    sh:severity sh:Violation ;
    sh:select """
      PREFIX autosar: <http://autosar.org/>
      SELECT ?this
      WHERE {
        ?this a autosar:NUMERICAL-VALUE-SPECIFICATION .
        # The trigger 'invalidValue is outside the scope of the applicable CompuMethod'
        # is semantic and not directly observable from XML structure alone.
        # Enforcement is delegated to SMT.
        FILTER(false)
      }
    """
  ] .


# SHACL for constr_1284 - Limitation of the use of TextValueSpecification
autosar:constr_1284 a sh:NodeShape ;
  sh:targetClass autosar:AUTOSAR-DATA-TYPE ;
  sh:severity sh:Violation ;
  sh:message "TextValueSpecification shall only be used in the context of an AutosarDataType that references a CompuMethod of category TEXTTABLE, BITFIELD_TEXTTABLE, SCALE_LINEAR_AND_TEXTTABLE, or SCALE_RATIONAL_AND_TEXTTABLE."@en ;
  sh:property [
    sh:path autosar:SW-DATA-DEF-PROPS ;
  ] .

# SHACL for constr_1285 - Applicability of roles vs. PortPrototypes
autosar:constr_1285 a sh:NodeShape ;
  sh:targetClass autosar:NV-BLOCK-DATA-MAPPING ;
  sh:severity sh:Violation ;
  sh:message "Roles writtenNvData, writtenReadNvData, and readNvData in NvBlockDataMapping are restricted by the type of the corresponding PortPrototype."@en ;
