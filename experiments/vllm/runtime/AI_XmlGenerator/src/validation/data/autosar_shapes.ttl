#################################################################
# SHACL shapes for AUTOSAR constraints
#################################################################

#################################################################
# constr_1307 - Consistency of values and masks in TextTableMapping
#################################################################

autosar:Constr_1307_TextTableMappingShape
    a sh:NodeShape ;
    sh:targetClass autosar:TEXT-TABLE-MAPPING ;

    # BITFIELD-TEXT-TABLE-MASK-FIRST (optional)
    sh:property [
        sh:path autosar:BITFIELD-TEXT-TABLE-MASK-FIRST ;
        sh:class autosar:POSITIVE-INTEGER-VALUE-VARIATION-POINT ;
        sh:severity sh:Violation ;
        sh:message "BITFIELD-TEXT-TABLE-MASK-FIRST, if present, shall be a POSITIVE-INTEGER-VALUE-VARIATION-POINT." ;
    ] ;

    # BITFIELD-TEXT-TABLE-MASK-SECOND (optional)
    sh:property [
        sh:path autosar:BITFIELD-TEXT-TABLE-MASK-SECOND ;
        sh:class autosar:POSITIVE-INTEGER-VALUE-VARIATION-POINT ;
        sh:severity sh:Violation ;
        sh:message "BITFIELD-TEXT-TABLE-MASK-SECOND, if present, shall be a POSITIVE-INTEGER-VALUE-VARIATION-POINT." ;
    ] ;

    # MAPPING-DIRECTION (mandatory)
    sh:property [
        sh:path autosar:MAPPING-DIRECTION ;
        sh:class autosar:MAPPING-DIRECTION-ENUM ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "MAPPING-DIRECTION shall exist exactly once and be of type MAPPING-DIRECTION-ENUM." ;
    ] ;

    # VALUE-PAIRS/TEXT-TABLE-VALUE-PAIR (0..*)
    sh:property [
        sh:path ( autosar:VALUE-PAIRS autosar:TEXT-TABLE-VALUE-PAIR ) ;
        sh:class autosar:TEXT-TABLE-VALUE-PAIR ;
        sh:severity sh:Violation ;
        sh:message "VALUE-PAIRS/TEXT-TABLE-VALUE-PAIR elements shall be of type TEXT-TABLE-VALUE-PAIR." ;
    ] ;

    # Informational SPARQL stub for mask/value consistency
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Info ;
        sh:message "If bitfieldTextTableMaskFirst or bitfieldTextTableMaskSecond is defined, all valuePair.firstValue and valuePair.secondValue shall not be ruled out by the relevant bit mask depending on mappingDirection. This check is delegated to SMT/implementation." ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this
            WHERE {
              ?this a autosar:TEXT-TABLE-MAPPING .
              OPTIONAL { ?this autosar:BITFIELD-TEXT-TABLE-MASK-FIRST ?maskFirst . }
              OPTIONAL { ?this autosar:BITFIELD-TEXT-TABLE-MASK-SECOND ?maskSecond . }
              OPTIONAL { ?this autosar:MAPPING-DIRECTION ?mappingDir . }
              OPTIONAL {
                ?this autosar:VALUE-PAIRS ?vpCont .
                ?vpCont autosar:TEXT-TABLE-VALUE-PAIR ?vp .
                OPTIONAL { ?vp autosar:FIRST-VALUE ?firstVal . }
                OPTIONAL { ?vp autosar:SECOND-VALUE ?secondVal . }
              }
              FILTER(BOUND(?maskFirst) || BOUND(?maskSecond))
            }
        """ ;
    ] ;
.

#################################################################
# constr_1308 - Existence of NvBlockNeeds.cyclicWritingPeriod
#################################################################

autosar:Constr_1308_NvBlockNeedsShape
    a sh:NodeShape ;
    sh:targetClass autosar:NV-BLOCK-NEEDS ;

    # STORE-CYCLIC (0..1, Boolean)
    sh:property [
        sh:path autosar:STORE-CYCLIC ;
        sh:class autosar:BOOLEAN ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "STORE-CYCLIC, if present, shall be of type BOOLEAN and occur at most once." ;
    ] ;

    # CYCLIC-WRITING-PERIOD (0..1, TimeValue)
    sh:property [
        sh:path autosar:CYCLIC-WRITING-PERIOD ;
        sh:class autosar:TIME-VALUE ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "CYCLIC-WRITING-PERIOD, if present, shall be of type TIME-VALUE and occur at most once." ;
    ] ;

    # Iff relation expressed as Info-level SPARQL stub
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Info ;
        sh:message "CYCLIC-WRITING-PERIOD shall exist iff STORE-CYCLIC exists and is true. Exact iff semantics are enforced in SMT." ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this
            WHERE {
              ?this a autosar:NV-BLOCK-NEEDS .
              OPTIONAL { ?this autosar:STORE-CYCLIC ?storeCyclic . }
              OPTIONAL { ?this autosar:CYCLIC-WRITING-PERIOD ?cycPeriod . }
            }
        """ ;
    ] ;
.

#################################################################
# constr_1309 - Existence of NvBlockDescriptor.timingEvent
#################################################################

autosar:Constr_1309_NvBlockDescriptorShape
    a sh:NodeShape ;
    sh:targetClass autosar:NV-BLOCK-DESCRIPTOR ;

    # NV-BLOCK-NEEDS (1..1)
    sh:property [
        sh:path autosar:NV-BLOCK-NEEDS ;
        sh:class autosar:NV-BLOCK-NEEDS ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "NV-BLOCK-NEEDS shall exist exactly once and be of type NV-BLOCK-NEEDS." ;
    ] ;

    # TIMING-EVENT-REF (0..1, cross-file ref to TIMING-EVENT)
    sh:property [
        sh:path autosar:TIMING-EVENT-REF ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "TIMING-EVENT-REF, if present, shall occur at most once and reference a TIMING-EVENT." ;
    ] ;

    # STORE-CYCLIC inside NV-BLOCK-NEEDS (0..1, Boolean)
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Info ;
        sh:message "TIMING-EVENT-REF shall exist iff NV-BLOCK-NEEDS/STORE-CYCLIC exists and is true. Exact iff semantics are enforced in SMT." ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this
            WHERE {
              ?this a autosar:NV-BLOCK-DESCRIPTOR .
              OPTIONAL { ?this autosar:TIMING-EVENT-REF ?timingEventRef . }
              OPTIONAL {
                ?this autosar:NV-BLOCK-NEEDS ?nvNeeds .
                OPTIONAL { ?nvNeeds autosar:STORE-CYCLIC ?storeCyclic . }
              }
            }
        """ ;
    ] ;
.

#################################################################
# constr_1309_note_conceptual_connection - Conceptual connection
#################################################################

autosar:Constr_1309_ConceptualConnectionShape
    a sh:NodeShape ;
    sh:targetClass autosar:NV-BLOCK-DESCRIPTOR ;

    # TIMING-EVENT-REF presence/type
    sh:property [
        sh:path autosar:TIMING-EVENT-REF ;
        sh:severity sh:Info ;
        sh:message "TIMING-EVENT-REF conceptually connects its TIMING-EVENT/PERIOD to NvBlockNeeds.cyclicWritingPeriod and SwcServiceDependency.serviceNeeds.cyclicWritingPeriod." ;
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Info ;
        sh:message "Conceptual connection: NvBlockDescriptor.timingEvent.period is supposed to fulfill SwcServiceDependency.serviceNeeds.cyclicWritingPeriod. This is a non-binding note and not automatically checked." ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this
            WHERE {
              ?this a autosar:NV-BLOCK-DESCRIPTOR .
              OPTIONAL { ?this autosar:TIMING-EVENT-REF ?timingEventRef . }
            }
        """ ;
    ] ;
.

#################################################################
# constr_1310 - Existence of attributes of meta-class NvBlockNeeds
#################################################################

autosar:Constr_1310_ApplicationSwComponentTypeShape
    a sh:NodeShape ;
    sh:targetClass autosar:APPLICATION-SW-COMPONENT-TYPE ;

    # SERVICE-NEEDS under SWC-SERVICE-DEPENDENCY
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "If SwcServiceDependency.serviceNeeds is implemented by NvBlockNeeds, then NvBlockNeeds.storeCyclic, NvBlockNeeds.cyclicWritingPeriod, NvBlockNeeds.storeEmergency and NvBlockNeeds.storeImmediate shall only exist if the same SwcServiceDependency has an assignedPort with role = NvDataPort." ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this
            WHERE {
              ?this a autosar:APPLICATION-SW-COMPONENT-TYPE .
              ?this autosar:SWC-SERVICE-DEPENDENCY ?dep .

              # serviceNeeds implemented by NvBlockNeeds (modeled as type/class check)
              ?dep autosar:SERVICE-NEEDS ?serviceNeeds .
              ?serviceNeeds a autosar:NV-BLOCK-NEEDS .

              OPTIONAL { ?serviceNeeds autosar:STORE-CYCLIC ?storeCyclic . }
              OPTIONAL { ?serviceNeeds autosar:CYCLIC-WRITING-PERIOD ?cycPeriod . }
              OPTIONAL { ?serviceNeeds autosar:STORE-EMERGENCY ?storeEmergency . }
              OPTIONAL { ?serviceNeeds autosar:STORE-IMMEDIATE ?storeImmediate . }

              OPTIONAL {
                ?dep autosar:ASSIGNED-PORTS ?apCont .
                ?apCont autosar:ROLE-BASED-PORT-ASSIGNMENT ?assignedPort .
                OPTIONAL { ?assignedPort autosar:ROLE ?role . }
              }

              FILTER(
                (BOUND(?storeCyclic) || BOUND(?cycPeriod) || BOUND(?storeEmergency) || BOUND(?storeImmediate))
                && ( !BOUND(?assignedPort) || !BOUND(?role) || ?role != "NvDataPort" )
              )
            }
        """ ;
    ] ;
.

#################################################################
# constr_1311 - Safety-related options in MemorySection/SwAddrMethod
#################################################################

autosar:Constr_1311_MemorySectionShape
    a sh:NodeShape ;
    sh:targetClass autosar:MEMORY-SECTION ;

    sh:property [
        sh:path ( autosar:OPTIONS autosar:OPTION ) ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "OPTION values shall be identifiers (strings)." ;
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "Any given list of OPTION values in MemorySection shall include at most one of: safetyQM, safetyAsilA, safetyAsilB, safetyAsilC, safetyAsilD." ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this
            WHERE {
              ?this a autosar:MEMORY-SECTION .
              OPTIONAL {
                ?this autosar:OPTIONS ?optCont .
                ?optCont autosar:OPTION ?optVal .
              }
              BIND( IF(?optVal IN ("safetyQM","safetyAsilA","safetyAsilB","safetyAsilC","safetyAsilD"), 1, 0) AS ?isSafety )
            }
        """ ;
    ] ;
.

autosar:Constr_1311_SwAddrMethodShape
    a sh:NodeShape ;
    sh:targetClass autosar:SW-ADDR-METHOD ;

    sh:property [
        sh:path ( autosar:OPTIONS autosar:OPTION ) ;
        sh:datatype xsd:string ;
        sh:severity sh:Violation ;
        sh:message "OPTION values shall be identifiers (strings)." ;
    ] ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:severity sh:Violation ;
        sh:message "Any given list of OPTION values in SwAddrMethod shall include at most one of: safetyQM, safetyAsilA, safetyAsilB, safetyAsilC, safetyAsilD." ;
        sh:select """
            PREFIX autosar: <http://autosar.org/>
            SELECT ?this
            WHERE {
              ?this a autosar:SW-ADDR-METHOD .
              OPTIONAL {
                ?this autosar:OPTIONS ?optCont .
                ?optCont autosar:OPTION ?optVal .
              }
              BIND( IF(?optVal IN ("safetyQM","safetyAsilA","safetyAsilB","safetyAsilC","safetyAsilD"), 1, 0) AS ?isSafety )
            }
        """ ;
    ] ;
.

#################################################################
# constr_1312 - PortPrototypes typed by a ParameterInterface
#################################################################

autosar:Constr_1312_PPortPrototypeShape
    a sh:NodeShape ;
    sh:targetClass autosar:P-PORT-PROTOTYPE ;
    sh:severity sh:Violation ;
    sh:message "PortPrototypes typed by a ParameterInterface can be PPortPrototypes or RPortPrototypes; PRPortPrototypes typed by a ParameterInterface are not supported. This shape targets P-PORT-PROTOTYPE; additional checks are handled in SMT/other shapes." ;
.


# SHACL for constr_1313 - Completeness of TextTableMapping for the values of a given bit mask on the sender side
autosar:constr_1313 a sh:NodeShape ;
  sh:targetClass autosar:DATA-PROTOTYPE ;
  sh:severity sh:Violation ;
  sh:message "If a DataPrototypeMapping contains one or more TextTableMapping(s) where the DataPrototype on the sender side refers to a CompuMethod of category BITFIELD_TEXTTABLE then all DataPrototypeMapping.textTableMapping shall aggregate a collection of TextTableMapping.valuePair where each possible value of the sender bit mask is represented by exactly one TextTableValuePair.firstValue/secondValue depending on the applicable mask."@en ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "TextTableMapping value pairs must be complete and non-ambiguous for the sender bit mask when the sender CompuMethod category is BITFIELD_TEXTTABLE."@en ;
    sh:severity sh:Violation ;
    sh:select """
PREFIX autosar: <http://autosar.org/>

SELECT ?this
WHERE {
  ?this a autosar:DATA-PROTOTYPE .

  # DataPrototypeMapping(s) for this DATA-PROTOTYPE
  ?dpm autosar:DATA-PROTOTYPE ?this .

  # Sender side CompuMethod with category BITFIELD_TEXTTABLE
  ?dpm autosar:SENDER-COMPU-METHOD ?cm .
  ?cm autosar:CATEGORY ?cat .
  FILTER(str(?cat) = "BITFIELD_TEXTTABLE") .

  # At least one TEXT-TABLE-MAPPING
  ?dpm autosar:TEXT-TABLE-MAPPINGS ?ttmWrap .
  ?ttmWrap autosar:TEXT-TABLE-MAPPING ?ttm .

  # For each TEXT-TABLE-MAPPING, check completeness/uniqueness of value pairs
  FILTER EXISTS {
    ?dpm autosar:TEXT-TABLE-MAPPINGS ?ttmWrap2 .
    ?ttmWrap2 autosar:TEXT-TABLE-MAPPING ?ttm2 .

    # Optional masks
    OPTIONAL { ?ttm2 autosar:BITFIELD-TEXT-TABLE-MASK-FIRST ?maskFirst . }
    OPTIONAL { ?ttm2 autosar:BITFIELD-TEXT-TABLE-MASK-SECOND ?maskSecond . }

    # Value pairs
    ?ttm2 autosar:VALUE-PAIRS ?vpWrap .
    ?vpWrap autosar:TEXT-TABLE-VALUE-PAIR ?vp .

    OPTIONAL { ?vp autosar:FIRST-VALUE ?firstVal . }
    OPTIONAL { ?vp autosar:SECOND-VALUE ?secondVal . }

    # NOTE:
    # The exact arithmetic coverage of all possible bit mask values and
    # uniqueness of FIRST-VALUE/SECOND-VALUE per mask value is not expressed
    # here due to complexity; it is handled in SMT.
  }
}
""" ] .



# SHACL for constr_1314 - Profile VSA_LINEAR for ApplicationArrayDataType
autosar:constr_1314 a sh:NodeShape ;
  sh:targetClass autosar:APPLICATION-ARRAY-ELEMENT ;
  sh:severity sh:Violation ;
  sh:message "If the dynamicArraySizeProfile of the owning ApplicationArrayDataType is VSA_LINEAR, the contained ApplicationArrayElement must have arraySizeSemantics=variableSize, maxNumberOfElements defined, arraySizeHandling=allIndicesSameArraySize, and be typed by a non-array ApplicationDataType without dynamicArraySizeProfile."@en ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "ApplicationArrayElement does not fulfill VSA_LINEAR profile requirements."@en ;
    sh:severity sh:Violation ;
    sh:select """
PREFIX autosar: <http://autosar.org/>

SELECT ?this
WHERE {
  ?this a autosar:APPLICATION-ARRAY-ELEMENT .

  # Owning ApplicationArrayDataType with profile VSA_LINEAR
  ?aadt autosar:APPLICATION-ARRAY-ELEMENT ?this .
  ?aadt autosar:DYNAMIC-ARRAY-SIZE-PROFILE ?profile .
  FILTER(str(?profile) = "VSA_LINEAR") .

  # arraySizeSemantics = variableSize
  OPTIONAL { ?this autosar:ARRAY-SIZE-SEMANTICS ?sem . }
  FILTER(str(?sem) = "variableSize") .

  # maxNumberOfElements defined
  FILTER EXISTS { ?this autosar:MAX-NUMBER-OF-ELEMENTS ?maxEl . }

  # arraySizeHandling = allIndicesSameArraySize
  OPTIONAL { ?this autosar:ARRAY-SIZE-HANDLING ?ash . }
  FILTER(str(?ash) = "allIndicesSameArraySize") .

  # TYPE-TREF present (typed by some ApplicationDataType)
  FILTER EXISTS { ?this autosar:TYPE-TREF ?typeRef . }

  # NOTE: The exclusion of ApplicationArrayDataType with its own dynamicArraySizeProfile
  # is handled in SMT due to cross-type reasoning.
}
""" ] .



# SHACL for constr_1315 - Profile VSA_SQUARE for ApplicationArrayDataType
autosar:constr_1315 a sh:NodeShape ;
  sh:targetClass autosar:APPLICATION-ARRAY-ELEMENT ;
  sh:severity sh:Violation ;
  sh:message "If the dynamicArraySizeProfile of the owning ApplicationArrayDataType is VSA_SQUARE, the contained ApplicationArrayElement and the referenced chain of ApplicationArrayDataTypes must fulfill the VSA_SQUARE profile conditions."@en ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "ApplicationArrayElement does not fulfill VSA_SQUARE profile requirements (local checks only; full chain semantics in SMT)."@en ;
    sh:severity sh:Violation ;
    sh:select """
PREFIX autosar: <http://autosar.org/>

SELECT ?this
WHERE {
  ?this a autosar:APPLICATION-ARRAY-ELEMENT .

  # Owning ApplicationArrayDataType with profile VSA_SQUARE
  ?aadt autosar:APPLICATION-ARRAY-ELEMENT ?this .
  ?aadt autosar:DYNAMIC-ARRAY-SIZE-PROFILE ?profile .
  FILTER(str(?profile) = "VSA_SQUARE") .

  # arraySizeSemantics = variableSize
  OPTIONAL { ?this autosar:ARRAY-SIZE-SEMANTICS ?sem . }
  FILTER(str(?sem) = "variableSize") .

  # maxNumberOfElements NOT defined
  FILTER NOT EXISTS { ?this autosar:MAX-NUMBER-OF-ELEMENTS ?maxEl . }

  # arraySizeHandling = inheritedFromArrayElementTypeSize
  OPTIONAL { ?this autosar:ARRAY-SIZE-HANDLING ?ash . }
  FILTER(str(?ash) = "inheritedFromArrayElementTypeSize") .

  # TYPE-TREF present (typed by some ApplicationArrayDataType)
  FILTER EXISTS { ?this autosar:TYPE-TREF ?typeRef . }

  # NOTE: The full nested chain conditions are handled in SMT.
}
""" ] .



# SHACL for constr_1316 - Profile VSA_RECTANGULAR for ApplicationArrayDataType
autosar:constr_1316 a sh:NodeShape ;
  sh:targetClass autosar:APPLICATION-ARRAY-ELEMENT ;
  sh:severity sh:Violation ;
  sh:message "If the dynamicArraySizeProfile of the owning ApplicationArrayDataType is VSA_RECTANGULAR, the contained ApplicationArrayElement and the referenced chain of ApplicationArrayDataTypes must fulfill the VSA_RECTANGULAR profile conditions."@en ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "ApplicationArrayElement does not fulfill VSA_RECTANGULAR profile requirements (local checks only; full chain semantics in SMT)."@en ;
    sh:severity sh:Violation ;
    sh:select """
PREFIX autosar: <http://autosar.org/>

SELECT ?this
WHERE {
  ?this a autosar:APPLICATION-ARRAY-ELEMENT .

  # Owning ApplicationArrayDataType with profile VSA_RECTANGULAR
  ?aadt autosar:APPLICATION-ARRAY-ELEMENT ?this .
  ?aadt autosar:DYNAMIC-ARRAY-SIZE-PROFILE ?profile .
  FILTER(str(?profile) = "VSA_RECTANGULAR") .

  # arraySizeSemantics = variableSize
  OPTIONAL { ?this autosar:ARRAY-SIZE-SEMANTICS ?sem . }
  FILTER(str(?sem) = "variableSize") .

  # maxNumberOfElements defined
  FILTER EXISTS { ?this autosar:MAX-NUMBER-OF-ELEMENTS ?maxEl . }

  # arraySizeHandling = allIndicesSameArraySize
  OPTIONAL { ?this autosar:ARRAY-SIZE-HANDLING ?ash . }
  FILTER(str(?ash) = "allIndicesSameArraySize") .

  # TYPE-TREF present (typed by some ApplicationArrayDataType)
  FILTER EXISTS { ?this autosar:TYPE-TREF ?typeRef . }

  # NOTE: The full nested chain conditions are handled in SMT.
}
""" ] .



# SHACL for constr_1317 - Profile VSA_FULLY_FLEXIBLE for ApplicationArrayDataType
autosar:constr_1317 a sh:NodeShape ;
  sh:targetClass autosar:APPLICATION-ARRAY-ELEMENT ;
  sh:severity sh:Violation ;
  sh:message "If the dynamicArraySizeProfile of the owning ApplicationArrayDataType is VSA_FULLY_FLEXIBLE, the contained ApplicationArrayElement and the referenced chain of ApplicationArrayDataTypes must fulfill the VSA_FULLY_FLEXIBLE profile conditions."@en ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "ApplicationArrayElement does not fulfill VSA_FULLY_FLEXIBLE profile requirements (local checks only; full chain semantics in SMT)."@en ;
    sh:severity sh:Violation ;
    sh:select """
PREFIX autosar: <http://autosar.org/>

SELECT ?this
WHERE {
  ?this a autosar:APPLICATION-ARRAY-ELEMENT .

  # Owning ApplicationArrayDataType with profile VSA_FULLY_FLEXIBLE
  ?aadt autosar:APPLICATION-ARRAY-ELEMENT ?this .
  ?aadt autosar:DYNAMIC-ARRAY-SIZE-PROFILE ?profile .
  FILTER(str(?profile) = "VSA_FULLY_FLEXIBLE") .

  # arraySizeSemantics = variableSize
  OPTIONAL { ?this autosar:ARRAY-SIZE-SEMANTICS ?sem . }
  FILTER(str(?sem) = "variableSize") .

  # maxNumberOfElements defined
  FILTER EXISTS { ?this autosar:MAX-NUMBER-OF-ELEMENTS ?maxEl . }

  # arraySizeHandling = allIndicesDifferentArraySize
  OPTIONAL { ?this autosar:ARRAY-SIZE-HANDLING ?ash . }
  FILTER(str(?ash) = "allIndicesDifferentArraySize") .

  # TYPE-TREF present (typed by some ApplicationArrayDataType)
  FILTER EXISTS { ?this autosar:TYPE-TREF ?typeRef . }

  # NOTE: The full nested chain conditions are handled in SMT.
}
""" ] .



# SHACL for constr_1318 - Profile VSA_LINEAR for ImplementationDataType
autosar:constr_1318 a sh:NodeShape ;
  sh:targetClass autosar:IMPLEMENTATION-DATA-TYPE ;
  sh:severity sh:Violation ;
  sh:message "If ImplementationDataType.dynamicArraySizeProfile is VSA_LINEAR, it shall aggregate a VSA Payload ImplementationDataTypeElement and an immediately aggregated ImplementationDataTypeElement fulfilling the specified conditions."@en ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "ImplementationDataType does not fulfill VSA_LINEAR profile requirements (local checks only; full aggregation-chain semantics in SMT)."@en ;
    sh:severity sh:Violation ;
    sh:select """
PREFIX autosar: <http://autosar.org/>

SELECT ?this
WHERE {
  ?this a autosar:IMPLEMENTATION-DATA-TYPE .

  ?this autosar:DYNAMIC-ARRAY-SIZE-PROFILE ?profile .
  FILTER(str(?profile) = "VSA_LINEAR") .

  # VSA Payload ImplementationDataTypeElement
  ?this autosar:SUB-ELEMENTS ?subWrap .
  ?subWrap autosar:IMPLEMENTATION-DATA-TYPE-ELEMENT ?payload .

  # payload: category = ARRAY, no arraySizeSemantics, no arraySize, no arraySizeHandling
  OPTIONAL { ?payload autosar:CATEGORY ?cat . }
  FILTER(str(?cat) = "ARRAY") .
  FILTER NOT EXISTS { ?payload autosar:ARRAY-SIZE-SEMANTICS ?pSem . }
  FILTER NOT EXISTS { ?payload autosar:ARRAY-SIZE ?pSize . }
  FILTER NOT EXISTS { ?payload autosar:ARRAY-SIZE-HANDLING ?pAsh . }

  # Immediately aggregated inner ImplementationDataTypeElement
  ?payload autosar:SUB-ELEMENTS ?innerWrap .
  ?innerWrap autosar:IMPLEMENTATION-DATA-TYPE-ELEMENT ?inner .

  OPTIONAL { ?inner autosar:ARRAY-SIZE-SEMANTICS ?iSem . }
  FILTER(str(?iSem) = "variableSize") .

  FILTER EXISTS { ?inner autosar:ARRAY-SIZE ?iSize . }

  OPTIONAL { ?inner autosar:ARRAY-SIZE-HANDLING ?iAsh . }
  FILTER(str(?iAsh) = "allIndicesSameArraySize") .
}
""" ] .



# SHACL for constr_1319 - Profile VSA_SQUARE for ImplementationDataType
autosar:constr_1319 a sh:NodeShape ;
  sh:targetClass autosar:IMPLEMENTATION-DATA-TYPE ;
  sh:severity sh:Violation ;
  sh:message "If ImplementationDataType.dynamicArraySizeProfile is VSA_SQUARE, it shall aggregate a VSA Payload ImplementationDataTypeElement and a chain of ImplementationDataTypeElements fulfilling the specified conditions."@en ;
  sh:sparql [
    a sh:SPARQLConstraint ;
    sh:message "ImplementationDataType does not fulfill VSA_SQUARE profile requirements (local checks only; full aggregation-chain semantics in SMT)."@en ;
    sh:severity sh:Violation ;
    sh:select """
PREFIX autosar: <http://autosar.org/>

SELECT ?this
WHERE {
  ?this a autosar:IMPLEMENTATION-DATA-TYPE .

  ?this autosar:DYNAMIC-ARRAY-SIZE-PROFILE ?profile .
  FILTER(str(?profile) = "VSA_SQUARE") .

  # VSA Payload ImplementationDataTypeElement
  ?this autosar:SUB-ELEMENTS ?subWrap .
  ?subWrap autosar:IMPLEMENTATION-DATA-TYPE-ELEMENT ?payload .

  OPTIONAL { ?payload autosar:CATEGORY ?pCat . }
  FILTER(str(?pCat) = "ARRAY") .
  FILTER NOT EXISTS { ?payload autosar:ARRAY-SIZE-SEMANTICS ?pSem . }
  FILTER NOT EXISTS { ?payload autosar:ARRAY-SIZE ?pSize . }
  FILTER NOT EXISTS { ?payload autosar:ARRAY-SIZE-HANDLING ?pAsh . }

  # First dimension element
  ?payload autosar:SUB-ELEMENTS ?firstWrap .
  ?firstWrap autosar:IMPLEMENTATION-DATA-TYPE-ELEMENT ?first .

  OPTIONAL { ?first autosar:ARRAY-SIZE-SEMANTICS ?fSem . }
  FILTER(str(?fSem) = "variableSize") .
  OPTIONAL { ?first autosar:CATEGORY ?fCat . }
  FILTER(str(?fCat) = "ARRAY") .
  FILTER NOT EXISTS { ?first autosar:ARRAY-SIZE ?fSize . }
  OPTIONAL { ?first autosar:ARRAY-SIZE-HANDLING ?fAsh . }
  FILTER(str(?fAsh) = "inheritedFromArrayElementTypeSize") .

  # NOTE: The full chain of intermediate and terminating elements is handled in SMT.
}
""" ] .


#################################################################
# SHACL shapes
#################################################################

#################################################################
# constr_1320 - Profile VSA_RECTANGULAR for ImplementationDataType
#################################################################

autosar:Constr_1320_VSA_RECTANGULAR a sh:NodeShape ;
  sh:severity sh:Violation ;

  # 目标：IMPLEMENTATION-DATA-TYPE
  sh:targetClass autosar:IMPLEMENTATION-DATA-TYPE ;

  # 结构层面仅检查触发条件字段存在性/取值，其余链式语义交由 SMT
  sh:rule [
    a sh:TripleRule ;
    sh:condition [
      a sh:NodeShape ;
      sh:property [
        sh:path autosar:DYNAMIC-ARRAY-SIZE-PROFILE ;
        sh:hasValue "VSA_RECTANGULAR"
      ]
    ] ;
    sh:subject sh:this ;
    sh:predicate autosar:dummy ;  # 无实际三元组输出，仅作为触发器
    sh:object "VSA_RECTANGULAR_PROFILE_CHECK" ;
  ] .

#################################################################
# constr_1321 - Profile VSA_FULLY_FLEXIBLE for ImplementationDataType
#################################################################

autosar:Constr_1321_VSA_FULLY_FLEXIBLE a sh:NodeShape ;
  sh:severity sh:Violation ;
  sh:targetClass autosar:IMPLEMENTATION-DATA-TYPE ;

  sh:rule [
    a sh:TripleRule ;
    sh:condition [
      a sh:NodeShape ;
      sh:property [
        sh:path autosar:DYNAMIC-ARRAY-SIZE-PROFILE ;
        sh:hasValue "VSA_FULLY_FLEXIBLE"
      ]
    ] ;
    sh:subject sh:this ;
    sh:predicate autosar:dummy ;
    sh:object "VSA_FULLY_FLEXIBLE_PROFILE_CHECK" ;
  ] .

#################################################################
# constr_1322 - Size Indicator for undefined dynamicArraySizeProfile
#################################################################

autosar:Constr_1322_SizeIndicator a sh:NodeShape ;
  sh:severity sh:Violation ;
  sh:targetClass autosar:IMPLEMENTATION-DATA-TYPE ;

  sh:property [
    sh:path autosar:CATEGORY ;
    sh:message "If IMPLEMENTATION-DATA-TYPE has no DYNAMIC-ARRAY-SIZE-PROFILE but its mapped APPLICATION-ARRAY-DATA-TYPE has one, then CATEGORY shall be STRUCTURE (checked by SMT)." ;
  ] .

#################################################################
# constr_1323 - Applicability of attribute ReceiverComSpec.usesEndToEndProtection
#################################################################

# NONQUEUED-RECEIVER-COM-SPEC
autosar:Constr_1323_UsesE2E_NonQueued a sh:NodeShape ;
  sh:severity sh:Violation ;
  sh:targetClass autosar:NONQUEUED-RECEIVER-COM-SPEC ;

  sh:property [
    sh:path autosar:USES-END-TO-END-PROTECTION ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
  ] .

