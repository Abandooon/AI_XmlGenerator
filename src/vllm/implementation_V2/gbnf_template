# AUTOSAR Parametric GBNF Template
# 使用 {变量名} 作为占位符，将在运行时替换

start: autosar_component

autosar_component: "<APPLICATION-SW-COMPONENT-TYPE>" component_content "</APPLICATION-SW-COMPONENT-TYPE>"

component_content: short_name ports internal_behaviors

# 基础元素
short_name: "<SHORT-NAME>" name_value "</SHORT-NAME>"
name_value: /[A-Za-z][A-Za-z0-9_]*/

# PORTS - 参数化版本
ports: "<PORTS>" {p_ports_rule} {r_ports_rule} "</PORTS>"

# P-PORT规则将动态生成: p_port_1 p_port_2 ... p_port_n
{p_port_definitions}

# R-PORT规则将动态生成: r_port_1 r_port_2 ... r_port_n
{r_port_definitions}

# P-PORT-PROTOTYPE 模板
p_port_template: "<P-PORT-PROTOTYPE" " " uuid_attr ">" p_port_content_{port_id} "</P-PORT-PROTOTYPE>"
p_port_content_{port_id}: short_name provided_interface_tref_{port_id}

provided_interface_tref_{port_id}: "<PROVIDED-INTERFACE-TREF" " " "DEST=\"SENDER-RECEIVER-INTERFACE\">" "{interface_path}" "</PROVIDED-INTERFACE-TREF>"

# R-PORT-PROTOTYPE 模板
r_port_template: "<R-PORT-PROTOTYPE" " " uuid_attr ">" r_port_content_{port_id} "</R-PORT-PROTOTYPE>"
r_port_content_{port_id}: short_name required_com_specs_{port_id} required_interface_tref_{port_id}

required_com_specs_{port_id}: "<REQUIRED-COM-SPECS>" nonqueued_receiver_com_spec_{port_id} "</REQUIRED-COM-SPECS>"
nonqueued_receiver_com_spec_{port_id}: "<NONQUEUED-RECEIVER-COM-SPEC>" com_spec_content_{port_id} "</NONQUEUED-RECEIVER-COM-SPEC>"
com_spec_content_{port_id}: data_element_ref_{port_id} alive_timeout handle_timeout_type

data_element_ref_{port_id}: "<DATA-ELEMENT-REF" " " "DEST=\"VARIABLE-DATA-PROTOTYPE\">" "{data_element_path}" "</DATA-ELEMENT-REF>"
alive_timeout: "<ALIVE-TIMEOUT>{alive_timeout_value}</ALIVE-TIMEOUT>"
handle_timeout_type: "<HANDLE-TIMEOUT-TYPE>{handle_timeout_type_value}</HANDLE-TIMEOUT-TYPE>"

required_interface_tref_{port_id}: "<REQUIRED-INTERFACE-TREF" " " "DEST=\"SENDER-RECEIVER-INTERFACE\">" "{interface_path}" "</REQUIRED-INTERFACE-TREF>"

# INTERNAL-BEHAVIORS
internal_behaviors: "<INTERNAL-BEHAVIORS>" swc_internal_behavior "</INTERNAL-BEHAVIORS>"
swc_internal_behavior: "<SWC-INTERNAL-BEHAVIOR>" behavior_content "</SWC-INTERNAL-BEHAVIOR>"
behavior_content: short_name events runnables

# EVENTS - 参数化
events: "<EVENTS>" {timing_events_rule} "</EVENTS>"
{timing_event_definitions}

# RUNNABLES - 参数化
runnables: "<RUNNABLES>" {runnable_entities_rule} "</RUNNABLES>"
{runnable_definitions}

# 数据访问点 - 参数化
data_receive_points: "<DATA-RECEIVE-POINT-BY-ARGUMENTS>" {receive_access_rule} "</DATA-RECEIVE-POINT-BY-ARGUMENTS>"
data_send_points: "<DATA-SEND-POINTS>" {send_access_rule} "</DATA-SEND-POINTS>"

# 通用模板
variable_access_template: "<VARIABLE-ACCESS" " " uuid_attr ">" variable_access_content_{access_id} "</VARIABLE-ACCESS>"
variable_access_content_{access_id}: short_name accessed_variable_{access_id}

accessed_variable_{access_id}: "<ACCESSED-VARIABLE>" autosar_variable_iref_{access_id} "</ACCESSED-VARIABLE>"
autosar_variable_iref_{access_id}: "<AUTOSAR-VARIABLE-IREF>" port_prototype_ref_{access_id} target_data_prototype_ref_{access_id} "</AUTOSAR-VARIABLE-IREF>"

port_prototype_ref_{access_id}: "<PORT-PROTOTYPE-REF" " " "{port_dest_attr}" ">" "{port_ref_path}" "</PORT-PROTOTYPE-REF>"
target_data_prototype_ref_{access_id}: "<TARGET-DATA-PROTOTYPE-REF" " " "DEST=\"VARIABLE-DATA-PROTOTYPE\">" "{data_prototype_path}" "</TARGET-DATA-PROTOTYPE-REF>"

# 属性
uuid_attr: "UUID=\"" uuid_value "\""
uuid_value: /[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}/

symbol: "<SYMBOL>" symbol_name "</SYMBOL>"
symbol_name: /[A-Za-z_][A-Za-z0-9_]*/

# 动态路径将在运行时生成
{path_definitions}