# SHACL shapes for given constraints

#################################################################
# TPS_SWCT_01323 - Read and write access to a dataElement
#################################################################

autosar:TPS_SWCT_01323
    a sh:NodeShape ;
    sh:targetClass autosar:RUNNABLE-ENTITY ;

    # Read access VARIABLE-ACCESS elements
    sh:property [
        sh:path ( autosar:RUNNABLE-ENTITY autosar:VARIABLE-ACCESS ) ;
        sh:class autosar:VARIABLE-ACCESS ;
        sh:severity sh:Info
    ] ;

    # Write access VARIABLE-ACCESS elements
    sh:property [
        sh:path ( autosar:RUNNABLE-ENTITY autosar:VARIABLE-ACCESS ) ;
        sh:class autosar:VARIABLE-ACCESS ;
        sh:severity sh:Info
    ] ;
.

#################################################################
# TPS_SWCT_01004 - Default value if serviceKind is not defined
#################################################################

# PortInterface is abstract; concrete XML tags are given in path_variants.
# We create one shape per concrete interface kind.

autosar:TPS_SWCT_01004_CLIENT-SERVER-INTERFACE
    a sh:NodeShape ;
    sh:targetClass autosar:CLIENT-SERVER-INTERFACE ;
    sh:property [
        sh:path autosar:SERVICE-KIND ;
        sh:maxCount 1 ;
        sh:severity sh:Info
    ] ;
.

autosar:TPS_SWCT_01004_NV-DATA-INTERFACE
    a sh:NodeShape ;
    sh:targetClass autosar:NV-DATA-INTERFACE ;
    sh:property [
        sh:path autosar:SERVICE-KIND ;
        sh:maxCount 1 ;
        sh:severity sh:Info
    ] ;
.

