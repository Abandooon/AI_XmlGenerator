        sh:severity sh:Info
    ] ;
.

#################################################################
# Constr_ApplicationCompositeDataType_SemanticMeaning
# (purely semantic / documentation, no structural constraint)
#################################################################

# No SHACL generated – handled by SMT/documentation only.


#################################################################
# Constr_ApplicationDataType_Precedence
#################################################################

autosar:Constr_ApplicationDataType_Precedence
    a sh:NodeShape ;
    sh:targetClass autosar:SW-DATA-DEF-PROPS-CONTENT ;

    # Structural typing of the involved references (if present)
    sh:property [
        sh:path autosar:BASE-TYPE-REF ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path autosar:COMPU-METHOD-REF ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path autosar:UNIT-REF ;
        sh:severity sh:Violation
    ] ;
    sh:property [
        sh:path autosar:VALUE-AXIS-DATA-TYPE-REF ;
        sh:severity sh:Violation
    ] ;
.
