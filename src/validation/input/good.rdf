<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:ex="http://example.org/autosar#">

  <ex:CompuMethod rdf:about="http://example.org/autosar#CompuMethod_2">
    <ex:category>SCALE_LINEAR_AND_TEXTTABLE</ex:category>
  </ex:CompuMethod>

  <ex:CompuScale rdf:about="http://example.org/autosar#CompuScale_1">
    <ex:symbol>SYM</ex:symbol>
    <ex:hasCompuMethod rdf:resource="http://example.org/autosar#CompuMethod_2"/>
  </ex:CompuScale>

  <ex:CompuMethod rdf:about="http://example.org/autosar#CompuMethod_1">
    <ex:category>BITFIELD_TEXTTABLE</ex:category>
  </ex:CompuMethod>
  <ex:CompuConstTextContent rdf:about="http://example.org/autosar#ConstText_1">
    <ex:vt>OK</ex:vt>
    <ex:belongsToMethod rdf:resource="http://example.org/autosar#CompuMethod_1"/>
  </ex:CompuConstTextContent>

  <ex:UnitGroup rdf:about="http://example.org/autosar#UnitGroup_1">
    <ex:category>EQUIV_UNITS</ex:category>
  </ex:UnitGroup>
  <ex:Unit rdf:about="http://example.org/autosar#Unit_1">
    <ex:physicalDimension>LENGTH</ex:physicalDimension>
    <ex:inUnitGroup rdf:resource="http://example.org/autosar#UnitGroup_1"/>
    <ex:convertTo rdf:resource="http://example.org/autosar#Unit_2"/>
  </ex:Unit>
  <ex:Unit rdf:about="http://example.org/autosar#Unit_2">
    <ex:physicalDimension>LENGTH</ex:physicalDimension>
    <ex:inUnitGroup rdf:resource="http://example.org/autosar#UnitGroup_1"/>
  </ex:Unit>

  <ex:VariableAccess rdf:about="http://example.org/autosar#VariableAccess_1">
    <ex:scope>process</ex:scope>
  </ex:VariableAccess>
  <ex:RunnableEntity rdf:about="http://example.org/autosar#RunnableEntity_1">
    <ex:dataReadAccess rdf:resource="http://example.org/autosar#VariableAccess_1"/>
  </ex:RunnableEntity>

  <ex:AsynchronousServerCallPoint rdf:about="http://example.org/autosar#CallPoint_1"/>
  <ex:AsynchronousServerCallResultPoint rdf:about="http://example.org/autosar#ResultPoint_1">
    <ex:resultOf rdf:resource="http://example.org/autosar#CallPoint_1"/>
  </ex:AsynchronousServerCallResultPoint>

  <ex:PerInstanceMemory rdf:about="http://example.org/autosar#PerInstanceMemory_1">
    <ex:typeDefinition>int count;</ex:typeDefinition>
  </ex:PerInstanceMemory>
</rdf:RDF>
