<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:ex="http://example.org/autosar#">

  <!-- symbol 出现但方法类别不在允许集合 -->
  <ex:CompuMethod rdf:about="http://example.org/autosar#CompuMethod_3">
    <ex:category>LINEAR</ex:category>
  </ex:CompuMethod>
  <ex:CompuScale rdf:about="http://example.org/autosar#CompuScale_3">
    <ex:symbol>S</ex:symbol>
    <ex:hasCompuMethod rdf:resource="http://example.org/autosar#CompuMethod_3"/>
  </ex:CompuScale>

  <!-- BITFIELD_TEXTTABLE 下 vt 含 '|' -->
  <ex:CompuMethod rdf:about="http://example.org/autosar#CompuMethod_4">
    <ex:category>BITFIELD_TEXTTABLE</ex:category>
  </ex:CompuMethod>
  <ex:CompuConstTextContent rdf:about="http://example.org/autosar#ConstText_2">
    <ex:vt>a|b</ex:vt>
    <ex:belongsToMethod rdf:resource="http://example.org/autosar#CompuMethod_4"/>
  </ex:CompuConstTextContent>

  <!-- UnitGroup 推荐以外（Warning） -->
  <ex:UnitGroup rdf:about="http://example.org/autosar#UnitGroup_2">
    <ex:category>CUSTOM</ex:category>
  </ex:UnitGroup>

  <!-- 维度不相等 + 偏好未满足（Warning） -->
  <ex:UnitGroup rdf:about="http://example.org/autosar#UnitGroup_3">
    <ex:category>EQUIV_UNITS</ex:category>
  </ex:UnitGroup>
  <ex:Unit rdf:about="http://example.org/autosar#Unit_3">
    <ex:physicalDimension>LENGTH</ex:physicalDimension>
    <ex:inUnitGroup rdf:resource="http://example.org/autosar#UnitGroup_3"/>
    <ex:convertTo rdf:resource="http://example.org/autosar#Unit_4"/>
  </ex:Unit>
  <ex:Unit rdf:about="http://example.org/autosar#Unit_4">
    <ex:physicalDimension>TIME</ex:physicalDimension>
    <ex:inUnitGroup rdf:resource="http://example.org/autosar#UnitGroup_2"/>
  </ex:Unit>

  <!-- scope 出现但不被允许角色引用 -->
  <ex:VariableAccess rdf:about="http://example.org/autosar#VariableAccess_2">
    <ex:scope>global</ex:scope>
  </ex:VariableAccess>
  <ex:RunnableEntity rdf:about="http://example.org/autosar#RunnableEntity_2">
    <ex:otherAccess rdf:resource="http://example.org/autosar#VariableAccess_2"/>
  </ex:RunnableEntity>

  <!-- CallPoint 被 0 个/2 个 ResultPoint 引用 -->
  <ex:AsynchronousServerCallPoint rdf:about="http://example.org/autosar#CallPoint_2"/>
  <ex:AsynchronousServerCallResultPoint rdf:about="http://example.org/autosar#ResultPoint_2">
    <ex:resultOf rdf:resource="http://example.org/autosar#CallPoint_2"/>
  </ex:AsynchronousServerCallResultPoint>
  <ex:AsynchronousServerCallResultPoint rdf:about="http://example.org/autosar#ResultPoint_3">
    <ex:resultOf rdf:resource="http://example.org/autosar#CallPoint_2"/>
  </ex:AsynchronousServerCallResultPoint>
  <ex:AsynchronousServerCallPoint rdf:about="http://example.org/autosar#CallPoint_3"/>

  <!-- C 声明缺少 ';' -->
  <ex:PerInstanceMemory rdf:about="http://example.org/autosar#PerInstanceMemory_2">
    <ex:typeDefinition>int x</ex:typeDefinition>
  </ex:PerInstanceMemory>
</rdf:RDF>
