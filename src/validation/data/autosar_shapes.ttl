    ] .

# Constraint 18: TPS_SWCT_01095 - Category NONE behavior
ex:Shape_TPS_SWCT_01095 a sh:NodeShape ;
    sh:targetClass autosar:END-TO-END-DESCRIPTION ;
    sh:property [
        sh:path autosar:CATEGORY ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Category set to NONE — If category is NONE, existing attributes shall be ignored."
    ] .



# Constraint 1: TPS_SWCT_01122 - Synchronous call
ex:Shape_TPS_SWCT_01122 a sh:NodeShape ;
    sh:targetClass autosar:ARGUMENT-DATA-PROTOTYPE ;
    sh:property [
        sh:path autosar:DIRECTION ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Synchronous call of ClientServerOperation — Client receives response with values for ArgumentDataPrototypes of direction out or inout."
    ] .

ex:Shape_TPS_SWCT_01122_Type a sh:NodeShape ;
    sh:targetClass autosar:AUTOSAR-DATA-PROTOTYPE ;
    sh:property [
        sh:path autosar:TYPE-TREF ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:class autosar:APPLICATION-ARRAY-DATA-TYPE ]
            [ sh:class autosar:APPLICATION-COMPOSITE-DATA-TYPE ]
            [ sh:class autosar:APPLICATION-DATA-TYPE ]
            [ sh:class autosar:APPLICATION-PRIMITIVE-DATA-TYPE ]
            [ sh:class autosar:APPLICATION-RECORD-DATA-TYPE ]
            [ sh:class autosar:AUTOSAR-DATA-TYPE ]
            [ sh:class autosar:IMPLEMENTATION-DATA-TYPE ]
        ) ;
        sh:severity sh:Violation ;
        sh:message "Synchronous call of ClientServerOperation — ArgumentDataPrototype must be typed by correct AutosarDataType."
    ] .

# Constraint 2: TPS_SWCT_01123 - No default values for ArgumentDataPrototypes
ex:Shape_TPS_SWCT_01123 a sh:NodeShape ;
    sh:targetClass autosar:CLIENT-SERVER-OPERATION ;
    sh:property [
        sh:path ( autosar:ARGUMENTS autosar:ARGUMENT-DATA-PROTOTYPE ) ;
        sh:severity sh:Violation ;
        sh:message "No default values for ArgumentDataPrototypes — Default values not possible for ArgumentDataPrototypes in ClientServerOperation context."
    ] .

# Constraint 3: TPS_SWCT_01125 - serverArgumentImplPolicy
ex:Shape_TPS_SWCT_01125 a sh:NodeShape ;
    sh:targetClass autosar:ARGUMENT-DATA-PROTOTYPE ;
    sh:property [
        sh:path autosar:SERVER-ARGUMENT-IMPL-POLICY ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "serverArgumentImplPolicy — Controls compatibility requirements and data type handling for array/structure arguments."
    ] .

# Constraint 6: TPS_SWCT_01128 - SwRecordLayout for STRING category
ex:Shape_TPS_SWCT_01128_1 a sh:NodeShape ;
    sh:targetClass autosar:AUTOSAR-DATA-TYPE ;
    sh:property [
        sh:path autosar:SW-DATA-DEF-PROPS ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "SwRecordLayout needed for ApplicationPrimitiveDataType of category STRING — SwDataDefProps must reference SwRecordLayout."
    ] .

ex:Shape_TPS_SWCT_01128_2 a sh:NodeShape ;
    sh:targetClass autosar:IDENTIFIABLE ;
    sh:property [
        sh:path autosar:CATEGORY ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "SwRecordLayout needed for ApplicationPrimitiveDataType of category STRING — Category STRING requires SwRecordLayout reference."
    ] .

