# --- Constr_CustomProfilePrefix_GeneralRule (信息性 - 警告) ---
# id: Constr_CustomProfilePrefix_GeneralRule
# title: Custom Profile and Category Value Prefix Recommendation
# expression: As it is a general rule for the definition of custom profiles or values of category, the custom value should start with a company-specific prefix in order to avoid clashes with later extensions of the AUTOSAR standard.
# severity: Warning (id_type: additional_not_binding)
# 

# 
# --- Constr_CyclicWrite_Requirements_from_TPS_SWCT_01586 (Group 1/2) ---
# 
ex:Shape_Constr_CyclicWrite_Requirements_from_TPS_SWCT_01586_NV_BLOCK_DESCRIPTOR a sh:NodeShape ;
    sh:targetClass autosar:NV-BLOCK-DESCRIPTOR ;
    sh:property [
        a sh:PropertyShape ;
        sh:path autosar:NV-BLOCK-NEEDS ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Requirements for Cyclic Writing Strategy — Cyclic writing use case requires NvBlockDescriptor.nvBlockNeeds.storeCyclic to be true..." ;
        sh:severity sh:Violation ;
    ] .

# 
# --- Constr_CyclicWrite_Requirements_from_TPS_SWCT_01586 (Group 2/2) ---
# 
ex:Shape_Constr_CyclicWrite_Requirements_from_TPS_SWCT_01586_NV_BLOCK_NEEDS a sh:NodeShape ;
    sh:targetClass autosar:NV-BLOCK-NEEDS ;
    sh:message "Requirements for Cyclic Writing Strategy — Cyclic writing use case requires NvBlockDescriptor.nvBlockNeeds.storeCyclic to be true..." ;
    sh:severity sh:Violation ;
    sh:property
        [ a sh:PropertyShape ; sh:path autosar:CYCLIC-WRITING-PERIOD ; sh:maxCount 1 ; ],
        [ a sh:PropertyShape ; sh:path autosar:STORE-CYCLIC ; sh:maxCount 1 ; ]
    .

