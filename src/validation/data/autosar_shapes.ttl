# constr_1159: Consistency of VariableAndParameterInterfaceMapping with respect to the referenced DataInterfaces
ex:Shape_constr_1159 a sh:NodeShape ;
  sh:targetClass autosar:DATA-PROTOTYPE-MAPPING ;
  sh:message "Consistency of VariableAndParameterInterfaceMapping with respect to the referenced DataInterfaces — Within one VariableAndParameterInterfaceMapping all firstDataPrototypes shall belong to one and only one DataInterface and all secondDataPrototypes shall belong to one other and only one other DataInterface." ;
  sh:severity sh:Violation ;
  sh:property
    [
      a sh:PropertyShape ;
      sh:path autosar:FIRST-DATA-PROTOTYPE-REF ;
      sh:minCount 1 ;
      sh:maxCount 1 ;
      sh:or (
        [ sh:class autosar:ARGUMENT-DATA-PROTOTYPE ]
        [ sh:class autosar:AUTOSAR-DATA-PROTOTYPE ]
        [ sh:class autosar:PARAMETER-DATA-PROTOTYPE ]
        [ sh:class autosar:VARIABLE-DATA-PROTOTYPE ]
      ) ;
    ] ,
    [
      a sh:PropertyShape ;
      sh:path autosar:SECOND-DATA-PROTOTYPE-REF ;
      sh:minCount 1 ;
      sh:maxCount 1 ;
      sh:or (
        [ sh:class autosar:ARGUMENT-DATA-PROTOTYPE ]
        [ sh:class autosar:AUTOSAR-DATA-PROTOTYPE ]
        [ sh:class autosar:PARAMETER-DATA-PROTOTYPE ]
        [ sh:class autosar:VARIABLE-DATA-PROTOTYPE ]
      ) ;
    ] .

