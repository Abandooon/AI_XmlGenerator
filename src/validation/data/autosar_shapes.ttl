# constr_1309_note_conceptual_connection: Conceptual connection between timingEvent.period and cyclicWritingPeriod
# (按 owner NV-BLOCK-DESCRIPTOR 拆分)
ex:Shape_constr_1309_note_conceptual_connection_NV_BLOCK_DESCRIPTOR a sh:NodeShape ;
  sh:targetClass autosar:NV-BLOCK-DESCRIPTOR ;
  sh:message "Conceptual connection between timingEvent.period and cyclicWritingPeriod — There is a conceptual connection between the values of the two attributes NvBlockDescriptor.timingEvent.period and SwcServiceDependency.serviceNeeds.cyclicWritingPeriod. Specifically, the SwcServiceDependency.serviceNeeds.cyclicWritingPeriod represents a requirement and the NvBlockDescriptor.timingEvent.period is supposed to fulfill the requirement." ;
  sh:severity sh:Warning ;
  sh:property [
    a sh:PropertyShape ;
    sh:path autosar:TIMING-EVENT-REF ;
    sh:maxCount 1 ;
    sh:class autosar:TIMING-EVENT ;
  ] .

