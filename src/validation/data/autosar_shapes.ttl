# constr_1156: Relevance of "names" of CompuScales
ex:Shape_constr_1156 a sh:NodeShape ;
  sh:targetClass autosar:COMPU-SCALE ;
  sh:message "Relevance of \"names\" of CompuScales — CompuScales which contribute to tabular conversion by having a compuConst are compatible if and only if the \"names\" of the compuScales, (namely shortLabel, compuConst and symbol) are equal. If the scale has no compuConst, \"names\" of CompuScales are not relevant for compatibility." ;
  sh:severity sh:Violation ;
  sh:property
    [
      a sh:PropertyShape ;
      sh:path autosar:SHORT-LABEL ;
      sh:maxCount 1 ;
    ] ,
    [
      a sh:PropertyShape ;
      sh:path autosar:SYMBOL ;
      sh:maxCount 1 ;
    ] ,
    [
      a sh:PropertyShape ;
      sh:path autosar:COMPU-CONST ;
      sh:minCount 1 ;
      sh:maxCount 1 ;
    ] .

