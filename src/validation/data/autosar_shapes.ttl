        sh:maxCount 1 ;
        sh:message "NvBlockNeeds.cyclicWritingPeriod ignored in favor of TimingEvent.period — The value of NvBlockDescriptor.nvBlockNeeds.cyclicWritingPeriod shall be ignored..." ;
        sh:severity sh:Violation ;
    ] .

