    ] .

# Constraint 21: TPS_SWCT_01147 - No romBlock behavior
ex:Shape_TPS_SWCT_01147 a sh:NodeShape ;
    sh:targetClass autosar:NV-BLOCK-DESCRIPTOR ;
    sh:property [
        sh:path autosar:ROM-BLOCK ;
        sh:maxCount 1 ;
