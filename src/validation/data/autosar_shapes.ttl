ex:Shape_constr_2057 a sh:NodeShape ;
    sh:targetClass autosar:RULE-BASED-AXIS-CONT ;
    sh:property ex:Prop_constr_2057_swAxisIndex, ex:Prop_constr_2057_swArraysize ;
    sh:severity sh:Violation ;
    sh:message "Mandatory information of RuleBasedAxisCont — Must define swAxisIndex and swArraysize" .

ex:Prop_constr_2057_swAxisIndex a sh:PropertyShape ;
    sh:path autosar:SW-AXIS-INDEX ;
    sh:minCount 1 ;
    sh:maxCount 1 .

ex:Prop_constr_2057_swArraysize a sh:PropertyShape ;
    sh:path autosar:SW-ARRAYSIZE ;
    sh:minCount 1 ;
    sh:maxCount 1 .