# Constr_DelegatedPortAnnotation_SignalFan_Nfold_Split
ex:Shape_Constr_DelegatedPortAnnotation_SignalFan_Nfold_Split
  a sh:NodeShape ;
  sh:targetClass autosar:COMPOSITION-SW-COMPONENT-TYPE ;
  sh:property ex:Prop_Constr_DelegatedPortAnnotation_SignalFan_Nfold_Split_signalFan .

ex:Prop_Constr_DelegatedPortAnnotation_SignalFan_Nfold_Split_signalFan
  a sh:PropertyShape ;
  sh:path autosar:SIGNAL-FAN ;
  sh:minCount 0 ;
  sh:maxCount 1 ;
  sh:message "DelegatedPortAnnotation signalFan for 1:n split — For a 1:n communication pattern (...), the attribute signalFan of DelegatedPortAnnotation is required to be set to 'nfold'." ;
  sh:severity sh:Violation .

