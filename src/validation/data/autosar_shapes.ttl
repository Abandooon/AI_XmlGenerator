        sh:severity sh:Violation ;
        sh:message "Variation on the behavior level — ParameterDataPrototype existence in constantMemory role may vary."
    ] .

ex:Shape_TPS_SWCT_01085_RTEEvent a sh:NodeShape ;
    sh:targetClass autosar:RTE-EVENT ;
    sh:property [
        sh:path autosar:VARIATION-POINT ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Variation on the behavior level — RTEEvent existence may vary."
    ] .

ex:Shape_TPS_SWCT_01085_RunnableEntity a sh:NodeShape ;
    sh:targetClass autosar:RUNNABLE-ENTITY ;
    sh:property [
        sh:path autosar:VARIATION-POINT ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Variation on the behavior level — RunnableEntity existence may vary."
    ] .

ex:Shape_TPS_SWCT_01085_ExplicitIRV a sh:NodeShape ;
    sh:targetClass autosar:SWC-INTERNAL-BEHAVIOR ;
    sh:property [
        sh:path ( autosar:EXPLICIT-INTER-RUNNABLE-VARIABLES autosar:VARIABLE-DATA-PROTOTYPE ) ;
