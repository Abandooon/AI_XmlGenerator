      [ sh:class autosar:APPLICATION-DATA-TYPE ]
      [ sh:class autosar:APPLICATION-PRIMITIVE-DATA-TYPE ]
      [ sh:class autosar:APPLICATION-RECORD-DATA-TYPE ]
      [ sh:class autosar:AUTOSAR-DATA-TYPE ]
      [ sh:class autosar:IMPLEMENTATION-DATA-TYPE ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "Compatibility of VariableDataPrototypes or ParameterDataPrototypes typed by primitive data types — Two prototypes compatible iff typed by compatible types & other conditions / or mapped." ;
  ] ;
  sh:property [
    sh:name "swDataDefProps" ;
    sh:path autosar:SW-DATA-DEF-PROPS ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    sh:message "Compatibility of Variable/ParameterDataPrototypes — swDataDefProps presence as referenced." ;
  ] ;
  sh:property [
    sh:name "firstDataPrototype" ;
    sh:path autosar:FIRST-DATA-PROTOTYPE-REF ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:or (
      [ sh:class autosar:ARGUMENT-DATA-PROTOTYPE ]
      [ sh:class autosar:AUTOSAR-DATA-PROTOTYPE ]
      [ sh:class autosar:PARAMETER-DATA-PROTOTYPE ]
      [ sh:class autosar:VARIABLE-DATA-PROTOTYPE ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "Compatibility via DataPrototypeMapping — firstDataPrototype reference." ;
  ] ;
  sh:property [
    sh:name "secondDataPrototype" ;
    sh:path autosar:SECOND-DATA-PROTOTYPE-REF ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:or (
      [ sh:class autosar:ARGUMENT-DATA-PROTOTYPE ]
      [ sh:class autosar:AUTOSAR-DATA-PROTOTYPE ]
      [ sh:class autosar:PARAMETER-DATA-PROTOTYPE ]
      [ sh:class autosar:VARIABLE-DATA-PROTOTYPE ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "Compatibility via DataPrototypeMapping — secondDataPrototype reference." ;
  ] ;
  sh:property [
    sh:name "category" ;
    sh:path autosar:CATEGORY ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    sh:message "Applicability limited to VALUE/BOOLEAN/STRING (checked globally)." ;
  ] ;
  sh:property [
    sh:name "shortName" ;
    sh:path autosar:SHORT-NAME ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    sh:message "Prototypes must have identical shortNames (checked globally)." ;
  ] .

