ex:Shape_TPS_SWCT_01129 a sh:NodeShape ;
    sh:targetClass autosar:ROLE-BASED-PORT-ASSIGNMENT ;
    sh:property [
        sh:path autosar:ROLE ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
        sh:message "Express diagnostic capabilities — Role must be set to name of used standardized ClientServerInterface."
    ] .

# Constraint 18: TPS_SWCT_01142 - NvBlockSwComponentType provides non-volatile data
ex:Shape_TPS_SWCT_01142 a sh:NodeShape ;
    sh:targetClass autosar:SW-COMPONENT-TYPE ;
    sh:property [
        sh:path autosar:PORTS ;
        sh:severity sh:Violation ;
        sh:message "Non-volatile data are provided by specialized AtomicSwComponentType — NvBlockSwComponentType ports exclusively typed by NvDataInterfaces."
    ] .

# Constraint 19: TPS_SWCT_01143 - NvBlockSwComponentType read/write capability
ex:Shape_TPS_SWCT_01143 a sh:NodeShape ;
    sh:targetClass autosar:SW-COMPONENT-TYPE ;
    sh:property [
        sh:path autosar:PORTS ;
        sh:severity sh:Violation ;
        sh:message "Non-volatile data can be read and written — NvBlockSwComponentType allowed to have PPortPrototypes and RPortPrototypes."
    ] .

# Constraint 20: TPS_SWCT_01146 - romBlock optional
ex:Shape_TPS_SWCT_01146 a sh:NodeShape ;
    sh:targetClass autosar:NV-BLOCK-DESCRIPTOR ;
    sh:property [
        sh:path autosar:ROM-BLOCK ;
        sh:maxCount 1 ;
        sh:severity sh:Violation ;
