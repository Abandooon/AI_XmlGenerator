@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix autosar: <http://autosar.org/> .
@prefix ex: <http://example.org/shape#> .

# 4.3.1_Constr_SwConnector_PIMReference
[] a sh:NodeShape ;
  sh:targetClass autosar:PORT-INTERFACE-MAPPING ;
  sh:property [
    sh:path [
      sh:alternativePath (
        ( autosar:ASSEMBLY-SW-CONNECTOR autosar:MAPPING-REF )
        ( autosar:DELEGATION-SW-CONNECTOR autosar:MAPPING-REF )
        ( autosar:PASS-THROUGH-SW-CONNECTOR autosar:MAPPING-REF )
      )
    ] ;
    sh:message "To apply a PortInterfaceMapping, a SwConnector has to reference that PortInterfaceMapping." ;
    sh:severity sh:Violation ;
    sh:nodeKind sh:IRI ;
    sh:in (
      autosar:CLIENT-SERVER-INTERFACE-MAPPING
      autosar:MODE-INTERFACE-MAPPING
      autosar:PORT-INTERFACE-MAPPING
      autosar:TRIGGER-INTERFACE-MAPPING
      autosar:VARIABLE-AND-PARAMETER-INTERFACE-MAPPING
    )
  ] .

# ComMgrUserNeeds_PortGroupAssociation
[] a sh:NodeShape ;
  sh:targetClass autosar:COM-MGR-USER-NEEDS ;
  sh:property [
    sh:path autosar:REPRESENTED-PORT-GROUP-REF ;
    sh:message "ComMgrUserNeeds defines which PortGroup is associated with this user." ;
    sh:severity sh:Info ;
    sh:nodeKind sh:IRI ;
    sh:class autosar:PORT-GROUP
  ] .

# Constr_4.8_BSWInterfacingAlternatives
[] a sh:NodeShape ;
  sh:message "BSW interfacing for partial networking shall use exactly one of the standardized alternatives (ComM_UserRequest.GetCurrentComMode, ComM_CurrentMode.currentMode, AppModeInterface.currentMode)." ;
  sh:severity sh:Info .

# Constr_4.8_ComMRetrievalChoice
[] a sh:NodeShape ;
  sh:message "The ComM can be retrieved by either a ClientServerInterface or a SenderReceiverInterface; the choice is up to the software-component author." ;
  sh:severity sh:Info .

# Constr_4.8_PartialNetworkStatusCheck
[] a sh:NodeShape ;
  sh:message "Before communicating via PortPrototypes that belong to a partial network, the software component shall consider the status of the partial network to assure valid communication." ;
  sh:severity sh:Info .


