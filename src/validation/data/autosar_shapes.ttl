# constr_2536
ex:Shape_constr_2536 a sh:NodeShape;
  sh:targetClass autosar:AUTOSAR-VARIABLE-REF;
  sh:severity sh:Violation;
  sh:message "Target of an autosarVariable in AutosarVariableRef shall refer to a variable — The target of autosarVariable (which in fact is an instance ref) in AutosarVariableRef shall either be or be nested in VariableDataPrototype. This means that the target shall either be a VariableDataPrototype or an ApplicationCompositeElementDataPrototype that in turn is owned by a VariableDataPrototype.";
  sh:property [
    sh:path autosar:AUTOSAR-VARIABLE-IREF;
    sh:maxCount 1;
    sh:node ex:Prop_constr_2536_autosarVariable;
  ].






# constr_2047: ArgumentDataPrototype.swImplPolicy must be "standard"
ex:Shape_constr_2047 a sh:NodeShape ;
    sh:targetClass autosar:ARGUMENT-DATA-PROTOTYPE ;
    sh:property ex:Prop_constr_2047_swImplPolicy ;
    sh:severity sh:Violation ;
    sh:message "swImplPolicy for ArgumentDataPrototype — Must be 'standard'" .

ex:Prop_constr_2047_swImplPolicy a sh:PropertyShape ;
    sh:path ( autosar:SW-DATA-DEF-PROPS autosar:SW-IMPL-POLICY ) ;
    sh:maxCount 1 ;
    sh:hasValue "standard" .

# constr_2050: SwAxisCont mandatory attributes
ex:Shape_constr_2050 a sh:NodeShape ;
    sh:targetClass autosar:SW-AXIS-CONT ;
    sh:property ex:Prop_constr_2050_swAxisIndex, ex:Prop_constr_2050_swArraysize ;
    sh:severity sh:Violation ;
    sh:message "Mandatory information of SwAxisCont — Must define swAxisIndex and swArraysize" .

ex:Prop_constr_2050_swAxisIndex a sh:PropertyShape ;
    sh:path autosar:SW-AXIS-INDEX ;
    sh:minCount 1 ;
    sh:maxCount 1 .

ex:Prop_constr_2050_swArraysize a sh:PropertyShape ;
    sh:path autosar:SW-ARRAYSIZE ;
    sh:minCount 1 ;
    sh:maxCount 1 .

# constr_2054: System in role rptSystem must have category RPT_SYSTEM
ex:Shape_constr_2054 a sh:NodeShape ;
    sh:targetClass autosar:SYSTEM ;
    sh:sparql [
        sh:message "Valid targets of rptSystem — System must have category RPT_SYSTEM" ;
        sh:select """
            PREFIX autosar: <http://example.org/autosar#>
            SELECT $this
            WHERE {
                ?scenario autosar:RPT-SYSTEM-REF $this .
                FILTER NOT EXISTS {
                    $this autosar:CATEGORY "RPT_SYSTEM" .
                }
            }
        """ ;
    ] .

