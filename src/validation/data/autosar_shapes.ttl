ex:Prop_TPS_SWCT_01318_trigger a sh:PropertyShape ;
    sh:path autosar:TRIGGER-REF ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:or ( 
        [ sh:class autosar:ASYNCHRONOUS-SERVER-CALL-RETURNS-EVENT ]
        [ sh:class autosar:BACKGROUND-EVENT ]
        [ sh:class autosar:DATA-RECEIVE-ERROR-EVENT ]
        [ sh:class autosar:DATA-RECEIVED-EVENT ]
        [ sh:class autosar:DATA-SEND-COMPLETED-EVENT ]
        [ sh:class autosar:DATA-WRITE-COMPLETED-EVENT ]
        [ sh:class autosar:EXTERNAL-TRIGGER-OCCURRED-EVENT ]
        [ sh:class autosar:INIT-EVENT ]
        [ sh:class autosar:INTERNAL-TRIGGER-OCCURRED-EVENT ]
        [ sh:class autosar:MODE-SWITCHED-ACK-EVENT ]
