######## NvBlockDescriptor / NvBlockNeeds — recommendations (warnings) ########

ex:Shape_NVBlockDescriptor_hasNeeds
  a sh:NodeShape ;
  sh:targetClass autosar:NV-BLOCK-DESCRIPTOR ;
  sh:property [
    sh:path autosar:NV-BLOCK-NEEDS ;
    sh:minCount 1 ;
    sh:message "NvBlockDescriptor shall have NvBlockNeeds element." ;
    sh:severity sh:Violation
  ] .

# Each recommended field: presence + warning message (values checked via SMT)
ex:Shape_NvBlockNeeds_recommendations
  a sh:NodeShape ;
  sh:targetClass autosar:NV-BLOCK-NEEDS ;
  sh:property
    [ sh:path autosar:RAM-BLOCK-STATUS-CONTROL ;
      sh:maxCount 1 ;
      sh:message "Recommended: set RAM-BLOCK-STATUS-CONTROL=true if any mapped nv data port requests RAM-block API." ;
      sh:severity sh:Warning ],
    [ sh:path autosar:READONLY ;
      sh:maxCount 1 ;
      sh:message "Recommended: READONLY matches requests of mapped nv data ports." ;
      sh:severity sh:Warning ],
    [ sh:path autosar:RELIABILITY ;
      sh:maxCount 1 ;
      sh:message "Recommended: RELIABILITY = highest class requested by mapped nv data ports." ;
      sh:severity sh:Warning ],
    [ sh:path autosar:RESISTANT-TO-CHANGED-SW ;
      sh:maxCount 1 ;
      sh:message "Recommended: RESISTANT-TO-CHANGED-SW matches requests of mapped nv data ports." ;
      sh:severity sh:Warning ],
    [ sh:path autosar:RESTORE-AT-START ;
      sh:maxCount 1 ;
      sh:message "Recommended: RESTORE-AT-START matches requests of mapped nv data ports." ;
      sh:severity sh:Warning ],
    [ sh:path autosar:STORE-AT-SHUTDOWN ;
      sh:maxCount 1 ;
      sh:message "Recommended: STORE-AT-SHUTDOWN=true if any mapped port requests write at shutdown." ;
      sh:severity sh:Warning ],
    [ sh:path autosar:STORE-CYCLIC ;
      sh:maxCount 1 ;
      sh:message "Recommended: STORE-CYCLIC=true if any mapped port requests cyclic writing." ;
      sh:severity sh:Warning ],
    [ sh:path autosar:STORE-EMERGENCY ;
      sh:maxCount 1 ;
      sh:message "Recommended: STORE-EMERGENCY=true if any mapped port requests emergency writing." ;
      sh:severity sh:Warning ],
    [ sh:path autosar:STORE-IMMEDIATE ;
      sh:maxCount 1 ;
      sh:message "Recommended: STORE-IMMEDIATE=true if any mapped port requests immediate writing." ;
      sh:severity sh:Warning ],
    [ sh:path autosar:WRITE-ONLY-ONCE ;
      sh:maxCount 1 ;
      sh:message "Recommended: WRITE-ONLY-ONCE matches requests of mapped nv data ports." ;
      sh:severity sh:Warning ],
    [ sh:path autosar:WRITE-VERIFICATION ;
      sh:maxCount 1 ;
      sh:message "Recommended: WRITE-VERIFICATION=true if any mapped port requests write verification." ;
      sh:severity sh:Warning ],
    [ sh:path autosar:WRITING-FREQUENCY ;
      sh:maxCount 1 ;
      sh:message "Recommended: WRITING-FREQUENCY = highest requested frequency." ;
      sh:severity sh:Warning ],
    [ sh:path autosar:WRITING-PRIORITY ;
      sh:maxCount 1 ;
      sh:message "Recommended: WRITING-PRIORITY = highest requested priority." ;
      sh:severity sh:Warning ] .

# PortPrototype-context recommendations (ports should agree)
ex:Shape_PortPrototype_NvNeeds_consistency
  a sh:NodeShape ;
  sh:targetClass autosar:PORT-PROTOTYPE ;
  sh:message "Recommended: connected nv data PortPrototypes agree on NvBlockNeeds flags (readonly/resistantToChangedSw/restoreAtStart/storeAtShutdown/writeOnlyOnce)." ;
  sh:severity sh:Warning .

######## RptContainer categories (binding) ########

ex:Shape_RptContainer_common
  a sh:NodeShape ;
  sh:targetClass autosar:RPT-CONTAINER ;
  sh:property [
      sh:path autosar:CATEGORY ;
      sh:minCount 1 ;
      sh:in ("ACCESS_POINTS" "DATA_PROTOTYPE" "RUNNABLE_ENTITY" "SW_COMPONENT_PROTOTYPE") ;
      sh:message "RPT-CONTAINER/CATEGORY must be one of: ACCESS_POINTS, DATA_PROTOTYPE, RUNNABLE_ENTITY, SW_COMPONENT_PROTOTYPE." ;
      sh:severity sh:Violation
  ] .

# ACCESS_POINTS
ex:Shape_RptContainer_ACCESS_POINTS
  a sh:NodeShape ;
  sh:targetClass autosar:RPT-CONTAINER ;
  sh:condition [ sh:hasValue "ACCESS_POINTS" ; sh:path autosar:CATEGORY ] ;
  sh:property
    [ sh:path ( autosar:BY-PASS-POINT-IREFS autosar:BY-PASS-POINT-IREF ) ;
      sh:minCount 1 ;
      sh:message "ACCESS_POINTS: at least one BY-PASS-POINT-IREF referencing VariableAccess/ParameterAccess/ServerCallPoint/AsynchronousServerCallResultPoint/InternalTriggeringPoint/ModeSwitchPoint/ModeAccessPoint/ExternalTriggeringPoint." ;
      sh:severity sh:Violation ] .

# DATA_PROTOTYPE
ex:Shape_RptContainer_DATA_PROTOTYPE
  a sh:NodeShape ;
  sh:targetClass autosar:RPT-CONTAINER ;
  sh:condition [ sh:hasValue "DATA_PROTOTYPE" ; sh:path autosar:CATEGORY ] ;
  sh:property
    [ sh:path ( autosar:BY-PASS-POINT-IREFS autosar:BY-PASS-POINT-IREF ) ;
      sh:minCount 1 ;
      sh:message "DATA_PROTOTYPE: BY-PASS-POINT-IREF references a DataPrototype in PortPrototypes." ;
      sh:severity sh:Violation ] .

# RUNNABLE_ENTITY
ex:Shape_RptContainer_RUNNABLE_ENTITY
  a sh:NodeShape ;
  sh:targetClass autosar:RPT-CONTAINER ;
  sh:condition [ sh:hasValue "RUNNABLE_ENTITY" ; sh:path autosar:CATEGORY ] ;
  sh:property
    [ sh:path ( autosar:BY-PASS-POINT-IREFS autosar:BY-PASS-POINT-IREF ) ;
      sh:minCount 1 ;
      sh:message "RUNNABLE_ENTITY: BY-PASS-POINT-IREF references a RunnableEntity." ;
      sh:severity sh:Violation ] .

# SW_COMPONENT_PROTOTYPE
ex:Shape_RptContainer_SW_COMPONENT_PROTOTYPE
  a sh:NodeShape ;
  sh:targetClass autosar:RPT-CONTAINER ;
  sh:condition [ sh:hasValue "SW_COMPONENT_PROTOTYPE" ; sh:path autosar:CATEGORY ] ;
  sh:property
    [ sh:path ( autosar:BY-PASS-POINT-IREFS autosar:BY-PASS-POINT-IREF ) ;
      sh:minCount 1 ;
      sh:message "SW_COMPONENT_PROTOTYPE: BY-PASS-POINT-IREF references a SwComponentPrototype." ;
      sh:severity sh:Violation ] .

######## Default invalidation policy note (info) ########

ex:Shape_SenderReceiverInterface_invalidDefault
  a sh:NodeShape ;
  sh:targetClass autosar:SENDER-RECEIVER-INTERFACE ;
  sh:message "If no InvalidationPolicy points to a dataElement, behavior is identical to handleInvalid=dontInvalidate (modeled in SMT as effective default)." ;
  sh:severity sh:Info .

######## AssemblySwConnector matrix (binding; SR/NvData only) ########

ex:Shape_AssemblySwConnector_SR_Nv_matrix
  a sh:NodeShape ;
  sh:targetClass autosar:ASSEMBLY-SW-CONNECTOR ;
  sh:property
    [ sh:path autosar:PROVIDER-IREF ; sh:maxCount 1 ],
    [ sh:path autosar:REQUESTER-IREF ; sh:maxCount 1 ] ;
  sh:message "Connections between R/P/PR ports typed by SenderReceiverInterface or NvDataInterface must follow Table 4.4 matrix (checked in SMT)." ;
  sh:severity sh:Violation .







# TPS_SWCT_01191 — mapped ApplicationDataType and ImplementationDataType shall be compatible
ex:Shape_TPS_SWCT_01191_APPLICATION_DATA_TYPE
  a sh:NodeShape ;
  sh:targetClass autosar:APPLICATION-DATA-TYPE ;
  sh:property ex:Prop_TPS_SWCT_01191_applicationDataType ,
              ex:Prop_TPS_SWCT_01191_implementationDataType .

ex:Prop_TPS_SWCT_01191_applicationDataType
  a sh:PropertyShape ;
  sh:path autosar:APPLICATION-DATA-TYPE-REF ;
  sh:minCount 1 ;
  sh:or (
    [ sh:class autosar:APPLICATION-ARRAY-DATA-TYPE ]
    [ sh:class autosar:APPLICATION-COMPOSITE-DATA-TYPE ]
    [ sh:class autosar:APPLICATION-DATA-TYPE ]
    [ sh:class autosar:APPLICATION-PRIMITIVE-DATA-TYPE ]
    [ sh:class autosar:APPLICATION-RECORD-DATA-TYPE ]
  ) ;
  sh:severity sh:Violation ;
  sh:message "mapped ApplicationDataType and ImplementationDataType shall be compatible — In order to set up a valid DataTypeMap..." .

ex:Prop_TPS_SWCT_01191_implementationDataType
  a sh:PropertyShape ;
  sh:path autosar:IMPLEMENTATION-DATA-TYPE-REF ;
  sh:minCount 1 ;
  sh:class autosar:IMPLEMENTATION-DATA-TYPE ;
  sh:severity sh:Violation ;
  sh:message "mapped ApplicationDataType and ImplementationDataType shall be compatible — In order to set up a valid DataTypeMap..." .

# TPS_SWCT_01192 — Meta-classes that have an association to a DataTypeMappingSet
ex:Shape_TPS_SWCT_01192_DATA_TYPE_MAPPING_SET
  a sh:NodeShape ;
  sh:targetClass autosar:DATA-TYPE-MAPPING-SET ;
