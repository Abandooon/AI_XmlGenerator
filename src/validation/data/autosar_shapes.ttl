# constr_1027 — split by owner
ex:Shape_constr_1027_AUTOSAR_DATA_PROTOTYPE a sh:NodeShape ;
  sh:targetClass autosar:AUTOSAR-DATA-PROTOTYPE ;
  sh:property [
    sh:name "type" ;
    sh:path autosar:TYPE-TREF ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:or ( 
      [ sh:class autosar:APPLICATION-ARRAY-DATA-TYPE ]
      [ sh:class autosar:APPLICATION-COMPOSITE-DATA-TYPE ]
      [ sh:class autosar:APPLICATION-DATA-TYPE ]
      [ sh:class autosar:APPLICATION-PRIMITIVE-DATA-TYPE ]
      [ sh:class autosar:APPLICATION-RECORD-DATA-TYPE ]
      [ sh:class autosar:AUTOSAR-DATA-TYPE ]
      [ sh:class autosar:IMPLEMENTATION-DATA-TYPE ]
    ) ;
    sh:severity sh:Violation ;
    sh:message "Types for record layouts — ParameterDataPrototypes shall be typed to proper ApplicationDataTypes or ImplementationDataTypes." ;
  ] .

ex:Shape_constr_1027_AUTOSAR_DATA_TYPE a sh:NodeShape ;
  sh:targetClass autosar:AUTOSAR-DATA-TYPE ;
  sh:property [
