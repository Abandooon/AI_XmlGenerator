# constr_2050
ex:Shape_constr_2050 a sh:NodeShape;
  sh:targetClass autosar:SW-AXIS-CONT;
  sh:severity sh:Violation;
  sh:message "Mandatory information of a SwAxisCont — If the attribute swAxisCont is defined for an ApplicationValueSpecification the SwAxisCont shall define one swAxisIndex value and one swArraysize value per dimension, even in the case when the owning ApplicationValueSpecification defines only the content of a single dimensional object like a CURVE.";
  sh:property [
    sh:path autosar:SW-AXIS-INDEX;
    sh:minCount 1;
    sh:maxCount 1;
    sh:node ex:Prop_constr_2050_swAxisIndex;
  ];
  sh:property [
    sh:path autosar:SW-ARRAYSIZE;
    sh:minCount 1;
    sh:maxCount 1;
    sh:node ex:Prop_constr_2050_swArraysize;
  ].

# constr_2051
ex:Shape_constr_2051 a sh:NodeShape;
  sh:targetClass autosar:SW-VALUE-CONT;
  sh:severity sh:Violation;
  sh:message "Mandatory information of a SwValueCont — If the attribute swValueCont is defined for an ApplicationValueSpecification the SwValueCont shall always define the attribute swArraysize if the ApplicationValueSpecification is of category CURVE, MAP, CUBOID, CUBE_4, CUBE_5, COM_AXIS, RES_AXIS, or VAL_BLK.";
  sh:property [
    sh:path autosar:SW-ARRAYSIZE;
    sh:maxCount 1;
    sh:node ex:Prop_constr_2051_swArraysize;
  ].

