################################################################################
ex:Shape_Constr_DltService_RoleBasedPortAssignment_Rule
  a sh:NodeShape ;
  sh:targetClass autosar:CLIENT-SERVER-INTERFACE ;

  # 至少（可选：恰好）一个 RoleBasedPortAssignment
  sh:property [
    sh:path autosar:ROLE-BASED-PORT-ASSIGNMENT ;      # 接口 → RPA 的关系谓词
    sh:minCount 1 ;
    sh:maxCount 1 ;                                    # 若业务是一对一就保留；否则删掉
    sh:node [
      a sh:NodeShape ;
      sh:class autosar:ROLE-BASED-PORT-ASSIGNMENT ;    # RPA 对象类型（若数据里有类型声明，建议保留）

      # 在 RPA 上：ROLE（作为属性类）必须且仅有一个 VALUE
      sh:property [
        sh:path (autosar:ROLE autosar:VALUE) ;         # RPA → ROLE(Identifier) → VALUE(文字)
        sh:minCount 1 ;
        sh:maxCount 1 ;
      ] ;
    ] ;
  ] ;

  sh:severity sh:Violation ;
  sh:message "Each used ClientServerInterface must have one RoleBasedPortAssignment with exactly one ROLE value." .

