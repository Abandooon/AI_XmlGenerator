ex:Shape_Constr_Recommend_Define_RomBlock a sh:NodeShape ;
    sh:targetClass autosar:NV-BLOCK-DESCRIPTOR ; # From path owners
    sh:message "Recommendation to define romBlock — As a mitigation against a failed read operation from NV memory..." ;
    sh:severity sh:Warning ; # id_type: additional_not_binding
    sh:property
        [
            a sh:PropertyShape ;
            sh:path autosar:RAM-BLOCK ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
