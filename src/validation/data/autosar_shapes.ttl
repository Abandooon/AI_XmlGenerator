# Constr_ApplicationDataType_Precedence
[
  a sh:NodeShape ;
  sh:targetClass autosar:SW-DATA-DEF-PROPS-CONTENT ;

  sh:sparql [
    sh:message "If VALUE-AXIS-DATA-TYPE-REF is present, its referenced ApplicationDataType supersedes COMPU-METHOD-REF, UNIT-REF, and BASE-TYPE-REF if these are defined in parallel (precedence rule, not a structural violation)." ;
    sh:severity sh:Info ;
    sh:select """
      PREFIX autosar: <http://autosar.org/schema/r4.0#>
      SELECT ?this
      WHERE {
        ?this autosar:VALUE-AXIS-DATA-TYPE-REF ?valueAxisDtRef .
        OPTIONAL { ?this autosar:COMPU-METHOD-REF ?compuMethodRef . }
        OPTIONAL { ?this autosar:UNIT-REF ?unitRef . }
        OPTIONAL { ?this autosar:BASE-TYPE-REF ?baseTypeRef . }
      }
    """ ;
  ] ;
] .

# Constr_ApplicationPrimitiveDataType_ShortNameNotRequiredForCompatibility
[
  a sh:NodeShape ;
  sh:targetClass autosar:APPLICATION-PRIMITIVE-DATA-TYPE ;

  sh:sparql [
    sh:message "ShortName identity is not required in order to consider two ApplicationPrimitiveDataTypes as compatible (documentation / non-restrictive statement)." ;
    sh:severity sh:Info ;
    sh:select """
      PREFIX autosar: <http://autosar.org/schema/r4.0#>
      SELECT ?this
      WHERE {
        ?this a autosar:APPLICATION-PRIMITIVE-DATA-TYPE .
      }
    """ ;
  ] ;
] .

# Constr_AutosarTypedPIM_NoCppOrPointerTypes
[
  a sh:NodeShape ;
  sh:targetClass autosar:AUTOSAR-DATA-TYPE ;

  sh:property [
    sh:path autosar:TYPE-TREF ;
    sh:severity sh:Violation ;
    sh:message "AutosarDataType used for AUTOSAR-typed PerInstanceMemory shall not be a C++-specific type or a pointer type (logical restriction, see SMT for details)." ;
  ] ;
] .

# Constr_AvoidMultipleRunnableEntitysSameSymbol_7_2_4
[
  a sh:NodeShape ;
  sh:targetClass autosar:ATOMIC-SW-COMPONENT-TYPE ;

  sh:sparql [
    sh:message "Mapping several RunnableEntitys to the same symbol for an AtomicSwComponentType shall be avoided as this scenario is not supported by RTE." ;
    sh:severity sh:Warning ;
    sh:select """
      PREFIX autosar: <http://autosar.org/schema/r4.0#>
      SELECT ?this ?symbol
      WHERE {
        ?this a autosar:ATOMIC-SW-COMPONENT-TYPE .
        ?this autosar:RUNNABLE-ENTITY ?r1 .
        ?this autosar:RUNNABLE-ENTITY ?r2 .
        FILTER (?r1 != ?r2) .
        ?r1 autosar:SYMBOL ?symbol .
        ?r2 autosar:SYMBOL ?symbol .
      }
    """ ;
  ] ;
] .

# Constr_AxisDescription_Determination
[
  a sh:NodeShape ;
  sh:targetClass autosar:SW-DATA-DEF-PROPS ;

  sh:sparql [
    sh:message "The SwDataDefProps determine an axis description (semantic relationship, not enforced structurally here)." ;
    sh:severity sh:Info ;
    sh:select """
      PREFIX autosar: <http://autosar.org/schema/r4.0#>
      SELECT ?this
      WHERE {
        ?this a autosar:SW-DATA-DEF-PROPS .
      }
    """ ;
  ] ;
] .


# Constr_AxisValuesType_Determination
# No structural constraint derivable for this relationship-oriented rule.

# Constr_BehavioralVariability_BindingTime_PreCompile
# No structural constraint on XML structure; binding time is a semantic/behavioral notion.

# Constr_BitfieldMask_SenderValueMappingCompleteness
# The rule is about completeness of value mappings within a mask; no stable structural pattern given.

# Constr_CalibParamAccess_InstantiationDataDefProps
# Behavioral / modeling recommendation only; no structural constraint.

# Constr_CategoryConsistency_AuthorResponsibility
# Consistency with the structure is delegated to the author; no structural constraint.


# Constr_Chapter_atpVariation
[] a sh:NodeShape ;
  sh:targetClass autosar:CHAPTER ;
  sh:property [
    sh:path autosar:VARIATION-POINT ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
  ] ;
  sh:message "Each predefined or free CHAPTER that has a VARIATION-POINT must use the atpVariation stereotype with post-build binding time."@en .

# Constr_ClientServerOperation_SyncAsyncExclusivity
[] a sh:NodeShape ;
  sh:targetClass autosar:CLIENT-SERVER-OPERATION ;
  sh:sparql [
    sh:message "A CLIENT-SERVER-OPERATION instance shall not be invoked both synchronously and asynchronously."@en ;
    sh:severity sh:Violation ;
    sh:select """
      SELECT ?this
      WHERE {
        ?this a autosar:CLIENT-SERVER-OPERATION .
        ?this autosar:HAS-SYNC-INVOCATION true .
        ?this autosar:HAS-ASYNC-INVOCATION true .
      }
    """ ;
  ] .

# Constr_ClientServer_StaticCorrectness_Rationale
[] a sh:NodeShape ;
  sh:severity sh:Info ;
  sh:message "Rationale: For static Client/Server compatibility, a client shall call the required operations so that the server can work correctly."@en .
