# constr_4004: SenderReceiverAnnotation context
ex:Shape_constr_4004 a sh:NodeShape ;
    sh:targetClass autosar:PORT-PROTOTYPE ;
    sh:sparql [
        sh:message "Context of SenderReceiverAnnotation — Must be typed by SenderReceiverInterface" ;
        sh:select """
            PREFIX autosar: <http://example.org/autosar#>
            SELECT $this
            WHERE {
                $this autosar:SENDER-RECEIVER-ANNOTATIONS ?annotation .
                FILTER NOT EXISTS {
                    $this autosar:type ?interface .
                    ?interface a autosar:SENDER-RECEIVER-INTERFACE .
                }
            }
        """ ;
    ] .

