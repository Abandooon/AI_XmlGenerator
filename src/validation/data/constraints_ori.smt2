(declare-fun D0 (COMPU-SCALE) Real)
(declare-fun D1 (COMPU-SCALE) Real)
; Higher-order coefficients – abstracted as “rest is zero”
(declare-fun higherNumeratorZero (COMPU-SCALE) Bool)
(declare-fun higherDenominatorZero (COMPU-SCALE) Bool)

; ---------- For ModeDeclaration / ModeDeclarationGroup / ModeTransition ----------
(declare-fun groupOfMode (MODE-DECLARATION) MODE-DECLARATION-GROUP)
(declare-fun has_initialMode (MODE-DECLARATION-GROUP MODE-DECLARATION) Bool)
(declare-fun has_modeTransition (MODE-DECLARATION-GROUP MODE-TRANSITION) Bool)
(declare-fun enteredMode (MODE-TRANSITION) MODE-DECLARATION)
(declare-fun exitedMode (MODE-TRANSITION) MODE-DECLARATION)

; helper: group has at least one transition
