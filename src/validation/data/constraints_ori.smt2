; ---------------------------------------------------------------------------
; constr_1183
; All EndToEndProtectionVariablePrototypes aggregated by the same
; EndToEndProtection shall refer to the identical sender.
; ---------------------------------------------------------------------------

(assert
  (forall ((e END-TO-END-PROTECTION)
           (v1 END-TO-END-PROTECTION-VARIABLE-PROTOTYPE)
           (v2 END-TO-END-PROTECTION-VARIABLE-PROTOTYPE)
           (s1 VariableDataPrototypeInSystemInstanceRef)
           (s2 VariableDataPrototypeInSystemInstanceRef))
    (=> (and (has_e2eVarProt e v1)
             (has_e2eVarProt e v2)
             (has_senderIRef v1 s1)
             (has_senderIRef v2 s2))
        (= s1 s2))))

; ---------------------------------------------------------------------------
; constr_1185
; contextDataPrototype and targetDataPrototype shall be enclosed in the
; context of the definition of the data type used to type rootDataPrototype.
; ---------------------------------------------------------------------------

(assert
  (forall ((x APPLICATION-COMPOSITE-ELEMENT-IN-PORT-INTERFACE-INSTANCE-REF)
           (r RootDataPrototypeRef)
           (c ContextDataPrototypeRef))
    (=> (and (has_rootDataPrototype x r)
             (has_contextDataPrototype x c))
        (sameTypeContext_AppComposite r c))))

(assert
  (forall ((x APPLICATION-COMPOSITE-ELEMENT-IN-PORT-INTERFACE-INSTANCE-REF)
           (r RootDataPrototypeRef)
           (t TargetDataPrototypeRef))
    (=> (and (has_rootDataPrototype x r)
             (has_targetDataPrototype x t))
        (sameTypeContext_AppComposite_Target r t))))

; ---------------------------------------------------------------------------
; constr_1186
; contextDataPrototype and targetDataPrototype shall be enclosed in the
; context of the definition of the data type used to type rootVariableDataPrototype.
; ---------------------------------------------------------------------------

(assert
  (forall ((x AR-VARIABLE-IN-IMPLEMENTATION-DATA-INSTANCE-REF)
           (r RootVariableDataPrototypeRef)
           (c ContextDataPrototypeRef_ArVariableInImplementationDataInstanceRef))
    (=> (and (has_rootVariableDataPrototype x r)
             (has_contextDataPrototype_ArVar x c))
        (sameTypeContext_Impl r c))))

(assert
  (forall ((x AR-VARIABLE-IN-IMPLEMENTATION-DATA-INSTANCE-REF)
           (r RootVariableDataPrototypeRef)
           (t TargetDataPrototypeRef_ArVariableInImplementationDataInstanceRef))
    (=> (and (has_rootVariableDataPrototype x r)
             (has_targetDataPrototype_ArVar x t))
        (sameTypeContext_Impl_Target r t))))

; ---------------------------------------------------------------------------
; constr_1187
; Compatibility of VariableDataPrototypes or ParameterDataPrototypes typed
; by composite data types.
;
; We capture the idea that compatibility is a symmetric relation and that
; it is implied by the existence of appropriate SubElementMappings.
; The detailed four cases are abstracted into the predicate
; compatibleCompositeDataPrototypes.
; ---------------------------------------------------------------------------

; Symmetry of compatibility
(assert
  (forall ((a APPLICATION-COMPOSITE-ELEMENT-DATA-PROTOTYPE)
           (b APPLICATION-COMPOSITE-ELEMENT-DATA-PROTOTYPE))
    (= (compatibleCompositeDataPrototypes a b)
       (compatibleCompositeDataPrototypes b a))))

; If there is a DataPrototypeMapping that provides a bijective mapping
; between sub-elements of a and b (abstracted), then they are compatible.
; (This is schematic; the concrete bijection conditions are left to the
; template designer to refine if needed.)

(assert
  (forall ((m DATA-PROTOTYPE-MAPPING)
           (a APPLICATION-COMPOSITE-ELEMENT-DATA-PROTOTYPE)
           (b APPLICATION-COMPOSITE-ELEMENT-DATA-PROTOTYPE))
    (=> (exists ((s SUB-ELEMENT-MAPPING))
          (has_subElementMapping m s))
        (compatibleCompositeDataPrototypes a b)))

)

; ---------------------------------------------------------------------------
; constr_1188
; Existence of ReceiverComSpec.replaceWith (iff)
; REPLACE-WITH exists  <=>  (handleOutOfRange==externalReplacement
;                            or associated SenderReceiverInterface has an
;                            InvalidationPolicy with handleInvalid==externalReplacement)
; ---------------------------------------------------------------------------

; Helper: condition for NONQUEUED-RECEIVER-COM-SPEC
(define-fun cond_NQ ((x NONQUEUED-RECEIVER-COM-SPEC)) Bool
  (or
    (exists ((h HandleOutOfRangeEnum))
      (and (has_handleOutOfRange_NQ x h)
           (= h externalReplacement_HandleOutOfRange)))
    (exists ((i SenderReceiverInterface)
             (p InvalidationPolicy)
             (hi HandleInvalidEnum))
      (and (associatedInterface_NQ x i)
           (has_invalidationPolicy i p)
           (handleInvalid p hi)
           (= hi externalReplacement_HandleInvalid)))))

; Helper: condition for QUEUED-RECEIVER-COM-SPEC
(define-fun cond_Q ((x QUEUED-RECEIVER-COM-SPEC)) Bool
  (or
    (exists ((h HandleOutOfRangeEnum))
      (and (has_handleOutOfRange_Q x h)
           (= h externalReplacement_HandleOutOfRange)))
    (exists ((i SenderReceiverInterface)
             (p InvalidationPolicy)
             (hi HandleInvalidEnum))
      (and (associatedInterface_Q x i)
           (has_invalidationPolicy i p)
           (handleInvalid p hi)
           (= hi externalReplacement_HandleInvalid)))))

; Iff for NONQUEUED
(assert
  (forall ((x NONQUEUED-RECEIVER-COM-SPEC))
    (let ((hasRW (exists ((v VariableAccess)) (has_replaceWith_NQ x v)))
          (cond (cond_NQ x))
      (= hasRW cond))))

; Iff for QUEUED
(assert
  (forall ((x QUEUED-RECEIVER-COM-SPEC))
    (let ((hasRW (exists ((v VariableAccess)) (has_replaceWith_Q x v)))
          (cond (cond_Q x))
      (= hasRW cond))))

; ---------------------------------------------------------------------------
; constr_1190
; Only one subElementMapping shall exist at the enclosing DataPrototypeMapping.
; ---------------------------------------------------------------------------

(assert
  (forall ((m DATA-PROTOTYPE-MAPPING)
           (s1 SUB-ELEMENT-MAPPING)
           (s2 SUB-ELEMENT-MAPPING))
    (=> (and (has_subElementMapping m s1)
             (has_subElementMapping m s2))
        (= s1 s2))))

; ---------------------------------------------------------------------------
; constr_1191
; After all variability is bound, the content obtained from a limit shall
; yield a numerical value.
; We model this as: every LIMIT has (at least one) associated NumericValue.
; ---------------------------------------------------------------------------

(assert
  (forall ((l LIMIT))
    (exists ((v NumericValue))
      (limitContent l v)))


