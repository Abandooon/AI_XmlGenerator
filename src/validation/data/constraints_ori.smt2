;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; TPS_SWCT_01624 – Hard error occurs during the execution of a transformer chain
; "this server RunnableEntity or trigger sink RunnableEntity cannot be started
;  because the re-transformed data are not available."
; Purely behavioral; we introduce abstract predicates to document the intent.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; A transformer chain is executed on behalf of a runnable
(declare-fun executedFor (TRANSFORMER-CHAIN RUNNABLE-ENTITY) Bool)

; Hard error occurrence on a transformer chain
(declare-fun hardError (TRANSFORMER-CHAIN) Bool)

; Runnable startability (whether it can be started)
(declare-fun canBeStarted (RUNNABLE-ENTITY) Bool)

; Core intent: if a hard error occurs on a chain executed for runnable r,
; then r cannot be started.
(assert
  (forall ((tc TRANSFORMER-CHAIN) (r RUNNABLE-ENTITY))
    (=> (and (executedFor tc r)
             (hardError tc))
        (not (canBeStarted r)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; TPS_SWCT_01625 – Coherence vs. stability with DataPrototypeGroup
; If a sending SwComponentType owns a DataPrototypeGroup in role dpgRequiresCoherence,
; then RunnableEntityGroups in role regDoesNotRequireStability may exist.
; Reads from runnables in those groups see intermediary (non-coherent) values.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Ownership / role relations
(declare-fun ownsDataPrototypeGroup_dpgRequiresCoherence
  (SW-COMPONENT-TYPE DATA-PROTOTYPE-GROUP) Bool)

(declare-fun hasRunnableEntityGroup_regDoesNotRequireStability
  (SW-COMPONENT-TYPE RUNNABLE-ENTITY-GROUP) Bool)

; Membership of runnables in groups
(declare-fun memberOfGroup (RUNNABLE-ENTITY RUNNABLE-ENTITY-GROUP) Bool)

; Predicates about read semantics
(declare-fun readCoherentValues (RUNNABLE-ENTITY) Bool)
(declare-fun readIntermediaryValues (RUNNABLE-ENTITY) Bool)

; Intent: runnables in regDoesNotRequireStability groups do NOT read coherent values
; but intermediary values, if the component uses a dpgRequiresCoherence group.
(assert
  (forall ((c SW-COMPONENT-TYPE)
           (dpg DATA-PROTOTYPE-GROUP)
           (reg RUNNABLE-ENTITY-GROUP)
           (r RUNNABLE-ENTITY))
    (=> (and (ownsDataPrototypeGroup_dpgRequiresCoherence c dpg)
             (hasRunnableEntityGroup_regDoesNotRequireStability c reg)
             (memberOfGroup r reg))
        (and (readIntermediaryValues r)
             (not (readCoherentValues r))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; TPS_SWCT_01626 – Error notification of data transformer errors
; If PortAPIOption.errorHandling == transformerErrorHandling then all
; RunnableEntitys accessing the referenced PortPrototype shall handle
; extended transformer error notification.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Enumeration for DATA-TRANSFORMATION-ERROR-HANDLING-ENUM
(declare-datatypes ()
  ((DATA-TRANSFORMATION-ERROR-HANDLING-ENUM
     transformerErrorHandling
     otherErrorHandling))) ; 'otherErrorHandling' stands for all non-transformer cases

; Attribute of PortAPIOption
(declare-fun errorHandling (PORT-API-OPTION) DATA-TRANSFORMATION-ERROR-HANDLING-ENUM)

; Reference from PortAPIOption to PortPrototype
(declare-fun portRef (PORT-API-OPTION) PORT-PROTOTYPE)

; Access relation: which runnables access which port
(declare-fun accessesPort (RUNNABLE-ENTITY PORT-PROTOTYPE) Bool)

; Whether a runnable handles extended transformer error notification
(declare-fun handlesExtendedTransformerError (RUNNABLE-ENTITY) Bool)

; Core constraint:
; For all PortAPIOption p, if errorHandling(p) = transformerErrorHandling,
; then every runnable r accessing portRef(p) must handle extended transformer errors.
(assert
  (forall ((p PORT-API-OPTION) (r RUNNABLE-ENTITY))
    (=> (and (= (errorHandling p) transformerErrorHandling)
             (accessesPort r (portRef p)))
        (handlesExtendedTransformerError r))))

