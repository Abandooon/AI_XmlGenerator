; 逻辑公理
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;-------------------------------------------------------------------
; TPS_SWCT_01513 - React on the change of Pretended Networking mode
; 若某 SwComponentType 需要对 Pretended Networking 模式变化作出反应，
; 则必须存在至少一个 RPortPrototype，其 requiredInterface 为 ModeSwitchInterface。
;-------------------------------------------------------------------

(assert
  (forall ((c SW-COMPONENT-TYPE))
    (=> (needsPretendedNetworkingModeReaction c)
        (exists ((p R-PORT-PROTOTYPE))
          (and (has_RPort c p)
               (has_requiredInterface p)
               (requiredInterface_is_ModeSwitchInterface p))))))

;-------------------------------------------------------------------
; TPS_SWCT_01514 - Duplicate existence of enhancedModeApi in PRPortPrototype context
; 若 ModeSwitchReceiverComSpec 由 PRPortPrototype 拥有且定义了 enhancedModeApi，
; 则其值在语义上被忽略：enhancedModeApi_Ignored = true。
;-------------------------------------------------------------------

(assert
  (forall ((m MODE-SWITCH-RECEIVER-COM-SPEC) (p PR-PORT-PROTOTYPE))
    (=> (and (ownedBy_PRPort m p)
             (has_enhancedModeApi m))
        (enhancedModeApi_Ignored m)))

; 可选：定义忽略谓词与值无关
(assert
  (forall ((m MODE-SWITCH-RECEIVER-COM-SPEC))
    (=> (enhancedModeApi_Ignored m)
        (has_enhancedModeApi m))))

;-------------------------------------------------------------------
; TPS_SWCT_01515 - PPortInCompositionInstanceRef shall be used
; 对于附着到 inner PRPortPrototype 的 DelegationSwConnector，
; 当且仅当存在 PPortInCompositionInstanceRef 用于该附着。
;-------------------------------------------------------------------

(assert
  (forall ((d DELEGATION-SW-CONNECTOR) (p PR-PORT-PROTOTYPE))
    (=> (attachedToInnerPRPort d p)
        (exists ((r PPortInCompositionInstanceRef))
          (uses_PPortInCompositionInstanceRef d r))))

; 可选：iff 方向（如果使用了 PPortInCompositionInstanceRef，则必然是附着到某 inner PRPortPrototype）
; 由于缺少可观测右项，这里不强制双向，只保留必要方向。

;-------------------------------------------------------------------
; TPS_SWCT_01517 - ClientServerOperation cannot be passed as a reference
; 任意 ArgumentDataPrototype，其 TYPE-TREF 不得指向 ClientServerOperation。
;-------------------------------------------------------------------

(assert
  (forall ((a ARGUMENT-DATA-PROTOTYPE))
    (=> (has_typeRef a)
        (not (typeRef_is_ClientServerOperation a))))

;-------------------------------------------------------------------
; TPS_SWCT_01518 - Priority of initial value definition
; 低优先级概念层上的初始值被忽略：
; 若存在更高优先级层级也定义了初始值，则低优先级层级上的初始值被忽略。
;-------------------------------------------------------------------

(assert
  (forall ((l_low CONCEPTUAL-LEVEL))
    (=> (has_initialValueAtLevel l_low)
        (=> (exists ((l_high CONCEPTUAL-LEVEL))
              (and (has_initialValueAtLevel l_high)
                   (higherPriority l_high l_low)))
            (initialValue_Ignored l_low))))

;-------------------------------------------------------------------
; TPS_SWCT_01519 - RTE executes certain RunnableEntity periodically
; 若某 AtomicSwComponentType 的 SwcInternalBehavior 要求对某 RunnableEntity 进行周期性执行，
; 则必须存在 TimingEvent，具有 PERIOD，并通过 START-ON-EVENT-REF 指向该 RunnableEntity。
;-------------------------------------------------------------------

(assert
  (forall ((c ATOMIC-SW-COMPONENT-TYPE)
           (b SWC-INTERNAL-BEHAVIOR)
           (r RUNNABLE-ENTITY))
    (=> (and (has_SwcInternalBehavior c b)
             (requiresPeriodicExecution b r))
        (exists ((e TIMING-EVENT))
          (and (has_TimingEvent b e)
               (has_period e)
               (has_startOnEventRef e)
               (startOnEventRef_targets e r)))))


