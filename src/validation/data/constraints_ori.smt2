;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; semantic predicate: apiFunctionsPresent(p) – RTE API functions for port p are present in implementation
(declare-fun apiFunctionsPresent (PORT-PROTOTYPE) Bool)

; semantic predicate: bindingTimeOfPortExistence(p, bt) – binding time for conditional existence
(declare-sort BINDING-TIME 0)
(declare-const preCompileTime BINDING-TIME)
(declare-fun bindingTimeOfPortExistence (PORT-PROTOTYPE BINDING-TIME) Bool)

; latest reasonable binding time is preCompileTime:
; if existence is conditional (modeled via variation point), its binding time is not later than preCompileTime.
(declare-fun has_variationPoint_Port (PORT-PROTOTYPE) Bool)

(assert
  (forall ((p PORT-PROTOTYPE) (bt BINDING-TIME))
    (=> (and (has_variationPoint_Port p)
             (bindingTimeOfPortExistence p bt))
        (= bt preCompileTime)))
)

; API functions remain present even if connectors do not exist in a variant
(assert
  (forall ((p PORT-PROTOTYPE))
    (=> (has_variationPoint_Port p)
        (apiFunctionsPresent p)))
)

