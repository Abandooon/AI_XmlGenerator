; ---------- Constraint assertions ----------

; constr_1225:
; If a DataPrototype is typed by an ImplementationDataType that references
; a TEXTTABLE or BITFIELD_TEXTTABLE CompuMethod, then:
;  - the applicable ValueSpecification is a TextValueSpecification
;  - its value matches one of vt / shortLabel / symbol of some applicable CompuScale.
(assert
  (forall ((v VALUE-SPECIFICATION))
    (=> (dataPrototypeUsesTextTableCompuMethod v)
        (and (isTextValueSpecification v)
             (has_textValue v)
             (exists ((cs COMPU-SCALE))
               (and (has_compuScale v cs)
                    (or (= (textValue v) (compuScale_vt cs))
                        (= (textValue v) (compuScale_shortLabel cs))
                        (= (textValue v) (compuScale_symbol cs)))))))))

; constr_1226:
; bitPosition in range 0 .. 31 (if present).
(assert
  (forall ((x EXECUTABLE-ENTITY-ACTIVATION-REASON))
    (=> (has_bitPosition x)
        (and (<= 0 (bitPosition x))
             (<= (bitPosition x) 31)))))

; constr_1227:
