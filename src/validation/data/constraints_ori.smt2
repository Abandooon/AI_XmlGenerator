; ---------- constr_1300 ----------

; Helper predicates
(declare-fun isPrimitiveProvider_VALUE (DATA-PROTOTYPE-MAPPING) Bool)
(declare-fun mapsToCompositeElement (DATA-PROTOTYPE-MAPPING) Bool)

(assert
  (forall ((m DATA-PROTOTYPE-MAPPING))
    (= (isPrimitiveProvider_VALUE m)
       (let ((p (providerOf m)))
         (or
           ; ApplicationPrimitiveDataType of category VALUE
           (exists ((t APPLICATION-PRIMITIVE-DATA-TYPE))
             (= (typeOf p) t)
             (= (category_APDT t) cat_VALUE))
           ; ImplementationDataType of category VALUE or TYPE_REFERENCE that resolves to VALUE
           (exists ((t IMPLEMENTATION-DATA-TYPE))
             (= (typeOf p) t)
             (or
               (= (category_IDT t) cat_VALUE)
               (and
                 (= (category_IDT t) cat_TYPE_REFERENCE)
                 (= (resolvedCategory_IDT t) cat_VALUE)))))))))

(assert
  (forall ((m DATA-PROTOTYPE-MAPPING))
    (= (mapsToCompositeElement m)
       (let ((e (mappedRequesterElement m)))
         (or
           (exists ((ie IMPLEMENTATION-DATA-TYPE-ELEMENT))
             (= e ie) (isImplElement ie))
           (exists ((ae APPLICATION-COMPOSITE-ELEMENT-DATA-PROTOTYPE))
             (= e ae) (isAppCompositeElem ae)))))))

; Core constraint: primitive provider VALUE must not map to composite element
(assert
  (forall ((m DATA-PROTOTYPE-MAPPING))
    (=> (isPrimitiveProvider_VALUE m)
        (not (mapsToCompositeElement m)))))

