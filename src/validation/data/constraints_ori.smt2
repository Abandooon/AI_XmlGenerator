; ---------- Constraint constr_1404 ----------
; All NvDataInterface.nvData of PortPrototypes in the context of a specific
; SwcServiceDependency shall be mapped to the same NvBlockDescriptor.ramBlock.

(assert
  (forall ((swc ATOMIC-SW-COMPONENT-TYPE) (dep SWC-SERVICE-DEPENDENCY))
    (=> (swcHasServiceDependency swc dep)
        (forall ((v1 VARIABLE-DATA-PROTOTYPE) (v2 VARIABLE-DATA-PROTOTYPE)
                 (rb1 RAM-BLOCK) (rb2 RAM-BLOCK))
          (=> (and (depNvData dep v1)
                   (depNvData dep v2)
                   (nvBlockNvDataOnRamBlock v1 rb1)
                   (nvBlockNvDataOnRamBlock v2 rb2))
              (= rb1 rb2)))))

; ---------- Constraint constr_2002 ----------
; dataReadAccess: VariableAccess must refer to RPortPrototype or PRPortPrototype
; typed by SenderReceiverInterface or NvDataInterface.

(assert
  (forall ((r RUNNABLE-ENTITY) (va VARIABLE-ACCESS))
    (=> (runnableHasDataReadAccess r va)
        (exists ((ar AUTOSAR-VARIABLE-REF)
                 (ir VARIABLE-IN-ATOMIC-SWC-TYPE-INSTANCE-REF)
                 (p PORT-PROTOTYPE))
          (and (vaAccessedVariable va ar)
               (avarIRef ar ir)
               (irefPortRef ir p)
               (or (isRPortPrototype p) (isPRPortPrototype p))
               (or (portTypedBySenderReceiverInterface p)
                   (portTypedByNvDataInterface p)))))))

; ---------- Constraint constr_2003 ----------
; dataWriteAccess: VariableAccess must refer to PPortPrototype or PRPortPrototype
; typed by SenderReceiverInterface or NvDataInterface.

(assert
  (forall ((r RUNNABLE-ENTITY) (va VARIABLE-ACCESS))
    (=> (runnableHasDataWriteAccess r va)
        (exists ((ar AUTOSAR-VARIABLE-REF)
                 (ir VARIABLE-IN-ATOMIC-SWC-TYPE-INSTANCE-REF)
                 (p PORT-PROTOTYPE))
          (and (vaAccessedVariable va ar)
               (avarIRef ar ir)
               (irefPortRef ir p)
               (or (isPPortPrototype p) (isPRPortPrototype p))
               (or (portTypedBySenderReceiverInterface p)
                   (portTypedByNvDataInterface p)))))))

; ---------- Constraint constr_2004 ----------
; dataSendPoint: VariableAccess must refer to PPortPrototype or PRPortPrototype
; typed by SenderReceiverInterface or NvDataInterface.

(assert
  (forall ((r RUNNABLE-ENTITY) (va VARIABLE-ACCESS))
    (=> (runnableHasDataSendPoint r va)
        (exists ((ar AUTOSAR-VARIABLE-REF)
                 (ir VARIABLE-IN-ATOMIC-SWC-TYPE-INSTANCE-REF)
                 (p PORT-PROTOTYPE))
          (and (vaAccessedVariable va ar)
               (avarIRef ar ir)
               (irefPortRef ir p)
               (or (isPPortPrototype p) (isPRPortPrototype p))
               (or (portTypedBySenderReceiverInterface p)
                   (portTypedByNvDataInterface p)))))))

; ---------- Constraint constr_2005 ----------
; dataReceivePointByValue / ByArgument: VariableAccess must refer to
