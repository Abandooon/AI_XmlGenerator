; TPS_SWCT_01464 - ModeDeclaration mapping
; =========================================================

(declare-sort MODE-DECLARATION 0)
(declare-sort MODE-USER 0)
(declare-sort MODE-MANAGER 0)
(declare-sort MODE-DECLARATION-MAPPING 0)

; Associations:
; - which ModeDeclaration belongs to which ModeUser / ModeManager
(declare-fun modeOfUser (MODE-USER) MODE-DECLARATION)
(declare-fun modeOfManager (MODE-MANAGER) MODE-DECLARATION)

; Mapping objects linking a user-mode declaration to a manager-mode declaration
(declare-fun mappedUserMode (MODE-DECLARATION-MAPPING) MODE-DECLARATION)
(declare-fun mappedManagerMode (MODE-DECLARATION-MAPPING) MODE-DECLARATION)

; Predicate: mapping object is active / used
(declare-fun mappingActive (MODE-DECLARATION-MAPPING) Bool)

; Core idea: each ModeDeclaration of a mode user is mapped to exactly one
; ModeDeclaration of a mode manager via ModeDeclarationMapping.
; We model this as: for each user mode declaration mu, there exists a unique mapping m
; such that mappedUserMode(m) = mu.
(assert
  (forall ((mu MODE-DECLARATION))
    (=> (exists ((u MODE-USER)) (= mu (modeOfUser u)))
        (and
          (exists ((m MODE-DECLARATION-MAPPING))
            (and (mappingActive m)
                 (= mu (mappedUserMode m))))
          (forall ((m1 MODE-DECLARATION-MAPPING)
                  (m2 MODE-DECLARATION-MAPPING))
            (=> (and (mappingActive m1)
                     (mappingActive m2)
                     (= mu (mappedUserMode m1))
                     (= mu (mappedUserMode m2)))
                (= m1 m2))))))

; Note: we do not constrain how many user modes may map to the same manager mode.

