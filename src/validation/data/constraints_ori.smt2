; WaitPoint has TIMEOUT
(declare-fun has_WAITPOINT_TIMEOUT (WAIT-POINT TIME-VALUE) Bool)

; WaitPoint has TRIGGER-REF to various event types, including DATA-SEND-COMPLETED-EVENT
(declare-fun has_TRIGGER_REF_DATA-SEND-COMPLETED-EVENT (WAIT-POINT DATA-SEND-COMPLETED-EVENT) Bool)

; DataSendCompletedEvent has EVENT-SOURCE-REF to VARIABLE-ACCESS
(declare-fun has_EVENT-SOURCE-REF (DATA-SEND-COMPLETED-EVENT VARIABLE-ACCESS) Bool)

