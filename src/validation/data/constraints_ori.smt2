; ---------- 1) Axis Description Determination by SwDataDefProps ----------
; SwDataDefProps determines an axis description.
; 由于缺少“axis description”在模型中的可观测结构，这里仅引入语义谓词，供其他公理或工具使用。

(declare-sort SW-DATA-DEF-PROPS 0)

; 语义谓词：给定 SwDataDefProps，是否确定了轴描述
(declare-fun determinesAxisDescription (SW-DATA-DEF-PROPS) Bool)

; 不添加额外公理（仅作为语义挂钩）

; ---------- 2) Axis Values Type Determination ----------
; The type of the axis values is determined when the type of the referenced input value (swVariableRef) has been set.

(declare-sort SW-AXIS-INDIVIDUAL 0)
(declare-sort SW-VARIABLE-REFS 0)

; swVariableRef 是否存在
(declare-fun has_swVariableRef (SW-AXIS-INDIVIDUAL) Bool)
; swVariableRef 的类型是否已经设置完毕（语义谓词）
(declare-fun inputTypeSet (SW-AXIS-INDIVIDUAL) Bool)
; 轴值类型是否已确定（语义谓词）
(declare-fun axisValuesTypeDetermined (SW-AXIS-INDIVIDUAL) Bool)

; 核心约束：当且仅当输入类型已设置时，轴值类型被确定
(assert
  (forall ((x SW-AXIS-INDIVIDUAL))
    (= (axisValuesTypeDetermined x)
       (inputTypeSet x))))

; 注意：has_swVariableRef 可用于其他约束（例如：只有存在引用时才谈 inputTypeSet），
; 这里不强制其与 inputTypeSet 的关系，由上层模板或工具补充。

; ---------- 3) Binding Time for Behavioral Element Variability ----------
; latest Binding Time of these kinds of variability is preCompileTime.

(declare-sort SWC-INTERNAL-BEHAVIOR 0)
(declare-sort RUNNABLE-ENTITY 0)
(declare-sort RTE-EVENT 0)
(declare-sort VARIABLE-DATA-PROTOTYPE 0)
(declare-sort PARAMETER-DATA-PROTOTYPE 0)
(declare-sort VARIATION-POINT 0)

; 语义枚举：绑定时间
(declare-datatypes () ((BindingTime preCompileTime postBuildTime otherBindingTime)))

; 关联：行为元素是否存在变体点
(declare-fun has_variationPoint_runnable (RUNNABLE-ENTITY) Bool)
(declare-fun has_variationPoint_rteEvent (RTE-EVENT) Bool)
(declare-fun has_variationPoint_chapter (VARIATION-POINT) Bool) ; 用于章节约束（复用）

; 绑定时间函数
(declare-fun bindingTime_runnable (RUNNABLE-ENTITY) BindingTime)
(declare-fun bindingTime_rteEvent (RTE-EVENT) BindingTime)
(declare-fun bindingTime_variable (VARIABLE-DATA-PROTOTYPE) BindingTime)
(declare-fun bindingTime_parameter (PARAMETER-DATA-PROTOTYPE) BindingTime)

; 角色谓词：这些元素是否处于特定角色（implicit/explicitInterRunnableVariable, perInstanceParameter, sharedParameter, constantMemory）
(declare-fun is_explicitInterRunnableVariable (VARIABLE-DATA-PROTOTYPE) Bool)
(declare-fun is_implicitInterRunnableVariable (VARIABLE-DATA-PROTOTYPE) Bool)
(declare-fun is_perInstanceParameter (PARAMETER-DATA-PROTOTYPE) Bool)
(declare-fun is_sharedParameter (PARAMETER-DATA-PROTOTYPE) Bool)
(declare-fun is_constantMemory (PARAMETER-DATA-PROTOTYPE) Bool)

; 核心约束：这些变体的 latest binding time 为 preCompileTime
(assert
  (forall ((v VARIABLE-DATA-PROTOTYPE))
    (=> (or (is_explicitInterRunnableVariable v)
            (is_implicitInterRunnableVariable v))
        (= (bindingTime_variable v) preCompileTime))))

(assert
  (forall ((p PARAMETER-DATA-PROTOTYPE))
    (=> (or (is_perInstanceParameter p)
            (is_sharedParameter p)
            (is_constantMemory p))
        (= (bindingTime_parameter p) preCompileTime))))

(assert
  (forall ((r RUNNABLE-ENTITY))
    (=> (has_variationPoint_runnable r)
        (= (bindingTime_runnable r) preCompileTime))))

(assert
  (forall ((e RTE-EVENT))
    (=> (has_variationPoint_rteEvent e)
        (= (bindingTime_rteEvent e) preCompileTime))))

; ---------- 4) Completeness of Sender Value Mapping within a Single Bitfield Mask ----------
; Within a single mask (for BITFIELD_TEXTTABLE category on sender side),
; all values on the sender side shall have a mapping to the receiver side.

(declare-sort COMPU-METHOD 0)
(declare-sort COMPU-MASK 0)
(declare-sort SENDER-VALUE 0)
(declare-sort RECEIVER-VALUE 0)

; CompuMethod 的类别
(declare-fun compuCategory (COMPU-METHOD) String)

; 一个 CompuMethod 是否为 BITFIELD_TEXTTABLE（sender side）
(declare-fun isBitfieldTexttableSender (COMPU-METHOD) Bool)

(assert
  (forall ((cm COMPU-METHOD))
    (= (isBitfieldTexttableSender cm)
       (= (compuCategory cm) "BITFIELD_TEXTTABLE")))

; 关联：掩码与 CompuMethod
(declare-fun maskOf (COMPU-METHOD SENDER-VALUE) COMPU-MASK)

; 关联：sender value 是否在某个 CompuMethod 的定义域中
(declare-fun senderValueOf (COMPU-METHOD SENDER-VALUE) Bool)

; 关联：sender value 到 receiver value 的映射是否存在
(declare-fun hasMappingToReceiver (COMPU-METHOD SENDER-VALUE) Bool)

; 核心覆盖性约束：对 BITFIELD_TEXTTABLE sender side，
; 每个 sender value 都必须有映射到 receiver side
(assert
  (forall ((cm COMPU-METHOD) (sv SENDER-VALUE))
    (=> (and (isBitfieldTexttableSender cm)
             (senderValueOf cm sv))
        (hasMappingToReceiver cm sv)))

