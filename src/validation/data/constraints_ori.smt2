; ------------------------------------------------------------
; Generic predicates for RoleBasedPortAssignment
; ------------------------------------------------------------

; Whether a given RoleBasedPortAssignment exists in the model
(declare-fun isRoleBasedPortAssignment (ROLE-BASED-PORT-ASSIGNMENT) Bool)

; Role value of a RoleBasedPortAssignment (as an abstract identifier)
(declare-fun roleValue (ROLE-BASED-PORT-ASSIGNMENT) String)

; Helper predicates for specific role literals
(define-fun hasRole_EcuM_BootTarget ((x ROLE-BASED-PORT-ASSIGNMENT)) Bool
  (= (roleValue x) "EcuM_BootTarget"))

(define-fun hasRole_EcuM_AlarmClock ((x ROLE-BASED-PORT-ASSIGNMENT)) Bool
  (= (roleValue x) "EcuM_AlarmClock"))

(define-fun hasRole_ComM_CurrentMode ((x ROLE-BASED-PORT-ASSIGNMENT)) Bool
  (= (roleValue x) "ComM_CurrentMode"))

(define-fun hasRole_ComM_UserRequest ((x ROLE-BASED-PORT-ASSIGNMENT)) Bool
  (= (roleValue x) "ComM_UserRequest"))

(define-fun hasRole_ComM_ECUModeLimitation ((x ROLE-BASED-PORT-ASSIGNMENT)) Bool
  (= (roleValue x) "ComM_ECUModeLimitation"))

; ------------------------------------------------------------
; TPS_SWCT_01017 – AtomicSwComponentType wants to select a boot target
; RoleBasedPortAssignment valid roles: EcuM_BootTarget [1]
; Here we only enforce that if such an assignment is used, its role is EcuM_BootTarget.
; Cardinality (exactly one) is left to higher-level modeling if needed.

(assert
  (forall ((x ROLE-BASED-PORT-ASSIGNMENT))
    (=> (isRoleBasedPortAssignment x)
        (hasRole_EcuM_BootTarget x))))

; ------------------------------------------------------------
; TPS_SWCT_01018 – AtomicSwComponentType wants to use an alarm clock
; RoleBasedPortAssignment valid roles: EcuM_AlarmClock [1]

(assert
  (forall ((x ROLE-BASED-PORT-ASSIGNMENT))
    (=> (isRoleBasedPortAssignment x)
        (hasRole_EcuM_AlarmClock x))))

; ------------------------------------------------------------
; TPS_SWCT_01019 – AtomicSwComponentType reads the current ComM mode
; RoleBasedPortAssignment valid roles: ComM_CurrentMode [1]

(assert
  (forall ((x ROLE-BASED-PORT-ASSIGNMENT))
    (=> (isRoleBasedPortAssignment x)
        (hasRole_ComM_CurrentMode x))))

; ------------------------------------------------------------
; TPS_SWCT_01020 – AtomicSwComponentType requests a ComM mode...
; RoleBasedPortAssignment valid roles:
;   ComM_CurrentMode [1]
;   ComM_UserRequest [1]
; We model: role must be one of these two.

(assert
  (forall ((x ROLE-BASED-PORT-ASSIGNMENT))
    (=> (isRoleBasedPortAssignment x)
        (or (hasRole_ComM_CurrentMode x)
            (hasRole_ComM_UserRequest x)))))

; ------------------------------------------------------------
; TPS_SWCT_01021 – AtomicSwComponentType acts as a mode manager...
; RoleBasedPortAssignment valid roles:
;   ComM_CurrentMode [0..1]
;   ComM_UserRequest [0..1]
;   ComM_ECUModeLimitation [1]
; We enforce that any such assignment uses one of these roles.
; Exact per-role cardinalities would require modeling of collections and are omitted here.

(assert
  (forall ((x ROLE-BASED-PORT-ASSIGNMENT))
    (=> (isRoleBasedPortAssignment x)
        (or (hasRole_ComM_CurrentMode x)
            (hasRole_ComM_UserRequest x)
            (hasRole_ComM_ECUModeLimitation x)))))

