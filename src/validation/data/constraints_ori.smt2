;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Helper definitions
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; groupHasTransition: true iff there exists at least one MODE-TRANSITION in the group
(assert
  (forall ((g MODE-DECLARATION-GROUP))
    (= (groupHasTransition g)
       (exists ((t MODE-TRANSITION))
         (has_modeTransition g t)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; constr_1192 – Compatibility of "IDENTICAL" to "RAT_FUNC" or "LINEAR"
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; int = (N0+N1*phys+Ni*phys^i) / (D0+D1*phys+Di*phys^i) = phys
; This is the case for N0 ~ 0, D0 ~ 1, N1 ~ 1, D1 ~ 0, Ni ~ Di ~ 0 (i>1).
; We approximate "~" with small tolerances eps0, eps1.

(declare-const eps0 Real)
(declare-const eps1 Real)

(assert (> eps0 0.0))
(assert (> eps1 0.0))

(define-fun approxZero ((x Real)) Bool
  (<= (abs x) eps0))

(define-fun approxOne ((x Real)) Bool
  (<= (abs (- x 1.0)) eps1))

; Compatibility predicate between two COMPU-SCALEs
(declare-fun compuScaleCompatible (COMPU-SCALE COMPU-SCALE) Bool)

(assert
  (forall ((s1 COMPU-SCALE) (s2 COMPU-SCALE))
    (let ((m1 (enclosingCompuMethod s1))
          (m2 (enclosingCompuMethod s2)))
      (=
        (compuScaleCompatible s1 s2)
        (and
          ; categories IDENTICAL vs RAT_FUNC or LINEAR
          (or (and (= (compuMethodCategory m1) "IDENTICAL")
                   (or (= (compuMethodCategory m2) "RAT_FUNC")
                       (= (compuMethodCategory m2) "LINEAR")))
              (and (= (compuMethodCategory m2) "IDENTICAL")
                   (or (= (compuMethodCategory m1) "RAT_FUNC")
                       (= (compuMethodCategory m1) "LINEAR"))))
          ; numeric condition
          (approxZero (N0 s1))
          (approxOne  (D0 s1))
          (approxOne  (N1 s1))
          (approxZero (D1 s1))
          (higherNumeratorZero s1)
          (higherDenominatorZero s1))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; constr_1193 – ModeDeclaration referenced by at least one ModeTransition (enteredMode)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(assert
  (forall ((m MODE-DECLARATION))
    (let ((g (groupOfMode m)))
      (=> (and (groupHasTransition g)
               (not (has_initialMode g m)))
          (exists ((t MODE-TRANSITION))
            (and (has_modeTransition g t)
                 (= (enteredMode t) m)))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; constr_1194 – Identical ModeTransitions (iff)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Predicate: two ModeDeclarationGroups have identical ModeTransitions
(declare-fun identicalModeTransitions (MODE-DECLARATION-GROUP MODE-DECLARATION-GROUP) Bool)

(assert
  (forall ((g1 MODE-DECLARATION-GROUP) (g2 MODE-DECLARATION-GROUP))
    (=
      (identicalModeTransitions g1 g2)
      (and
        ; 1. For each ModeTransition in g1 there is a ModeTransition in g2
        ;    with same shortName and identical entered/exited targets.
        (forall ((t1 MODE-TRANSITION))
          (=> (has_modeTransition g1 t1)
              (exists ((t2 MODE-TRANSITION))
                (and (has_modeTransition g2 t2)
                     ; shortName equality abstracted as equality of transition ids
                     (= t1 t2)
                     (= (enteredMode t1) (enteredMode t2))
                     (= (exitedMode  t1) (exitedMode  t2))))))
        ; 2. Symmetric condition from g2 to g1
        (forall ((t2 MODE-TRANSITION))
          (=> (has_modeTransition g2 t2)
              (exists ((t1 MODE-TRANSITION))
                (and (has_modeTransition g1 t1)
                     (= t1 t2)
                     (= (enteredMode t1) (enteredMode t2))
                     (= (exitedMode  t1) (exitedMode  t2))))))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; constr_1195 – SwcModeSwitchEvent and definition of ModeTransition
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(assert
  (forall ((e SWC-MODE-SWITCH-EVENT))
    (let ((g (modeGroupOfEvent e))
          (mFrom (modeRef1 e))
          (mTo   (modeRef2 e)))
      (=> (and (= (activation e) "onTransition")
               (groupHasTransition g))
          (exists ((t MODE-TRANSITION))
            (and (has_modeTransition g t)
                 (= (exitedMode  t) mFrom)
                 (= (enteredMode t) mTo)))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; constr_1196 – networkRepresentation vs compositeNetworkRepresentation
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Receiver – NONQUEUED
(assert
  (forall ((c NONQUEUED-RECEIVER-COM-SPEC))
    (not
      (and
        (exists ((p SW-DATA-DEF-PROPS))
          (has_networkRepresentation_NR c p))
        (exists ((r COMPOSITE-NETWORK-REPRESENTATION))
          (has_compositeNetworkRepresentation_NR c r))))))

; Receiver – QUEUED
(assert
  (forall ((c QUEUED-RECEIVER-COM-SPEC))
    (not
      (and
        (exists ((p SW-DATA-DEF-PROPS))
          (has_networkRepresentation_QR c p))
        (exists ((r COMPOSITE-NETWORK-REPRESENTATION))
          (has_compositeNetworkRepresentation_QR c r))))))

; Sender – NONQUEUED
(assert
  (forall ((c NONQUEUED-SENDER-COM-SPEC))
    (not
      (and
        (exists ((p SW-DATA-DEF-PROPS))
          (has_networkRepresentation_NS c p))
        (exists ((r COMPOSITE-NETWORK-REPRESENTATION))
          (has_compositeNetworkRepresentation_NS c r))))))

; Sender – QUEUED
(assert
  (forall ((c QUEUED-SENDER-COM-SPEC))
    (not
      (and
        (exists ((p SW-DATA-DEF-PROPS))
          (has_networkRepresentation_QS c p))
        (exists ((r COMPOSITE-NETWORK-REPRESENTATION))
          (has_compositeNetworkRepresentation_QS c r))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; constr_1197 – compositeNetworkRepresentation shall be comprehensive
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; If at least one compositeNetworkRepresentation exists for an
; ApplicationCompositeDataType, then for each leaf element exactly one
; compositeNetworkRepresentation shall be defined.

(assert
  (forall ((t APPLICATION-COMPOSITE-DATA-TYPE))
    (let ((hasAny
            (exists ((r COMPOSITE-NETWORK-REPRESENTATION))
              (= (appTypeOfCompositeNetRep r) t))))
      (=> hasAny
          (forall ((e APPLICATION-COMPOSITE-ELEMENT-DATA-PROTOTYPE))
            (=> (isLeafElementOf e t)
                (exists ((r COMPOSITE-NETWORK-REPRESENTATION))
                  (and (= (appTypeOfCompositeNetRep r) t)
                       (= (leafElementOfCompositeNetRep r) e)
                       ; uniqueness: no second distinct representation for same leaf
                       (forall ((r2 COMPOSITE-NETWORK-REPRESENTATION))
                         (=> (and (= (appTypeOfCompositeNetRep r2) t)
                                  (= (leafElementOfCompositeNetRep r2) e))
                             (= r2 r))))))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; constr_1200 – Queued communication not applicable for dataElements
;               owned by PRPortPrototype
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(assert
  (forall ((v VARIABLE-DATA-PROTOTYPE))
    (let ((p (ownerPort v)))
      (=> (exists ((s SW-DATA-DEF-PROPS))
            (and (has_swDataDefProps v s)
                 (= p (ownerPort v))))
          (forall ((s SW-DATA-DEF-PROPS))
            (=> (has_swDataDefProps v s)
                (not (= (swImplPolicy s) "queued")))))))

