; shall be at most 1 (mutual exclusivity). We encode this with pairwise exclusion.

(assert
  (forall ((d DATA-TRANSFORMATION))
    (let (
          (existsDPM (exists ((m DATA-PROTOTYPE-MAPPING))
                         (and (has_firstToSecondDataTransformation m)
                              (= (firstToSecondDataTransformation m) d))))
          (existsSig (exists ((s I-SIGNAL))
                         (uses_dataTransformation s d)))
          (existsGrp (exists ((g I-SIGNAL-GROUP))
                         (uses_comBasedSignalGroupTransformation g d)))
         )
      (and
        (=> existsDPM (and (not existsSig) (not existsGrp)))
        (=> existsSig (and (not existsDPM) (not existsGrp)))
        (=> existsGrp (and (not existsDPM) (not existsSig)))
      ))))

; ===== constr_1401: Restrictions on relation between DataPrototypeMapping and DataTransformation =====
; Informal restatement:
; A VariableDataPrototype in the context of a PortPrototype shall not be referenced by
; a DataPrototypeMapping that references a DataTransformation while a DataMapping exists
; that points to this VariableDataPrototype (via the SystemSignal) that also refers to an
; ISignal that in turn references a DataTransformation.

; We approximate the narrative with the following predicate:
; For any VariableDataPrototype v and ISignal s, it is forbidden that:
;  - there exists a DataPrototypeMapping m with dpm_variableData(m) = v and
;    dpm_hasDataTransformation(m) and some DataTransformation dt1 = dpm_dataTransformation(m)
;  - and there exists a DataMapping dm with dataMapping_variableData(dm) = v and
;    dataMapping_iSignal(dm) = s and some DataTransformation dt2 such that uses_dataTransformation(s, dt2)

(assert
  (forall ((v VARIABLE-DATA-PROTOTYPE))
    (forall ((s I-SIGNAL))
      (not
        (and
          (exists ((m DATA-PROTOTYPE-MAPPING))
            (and (= (dpm_variableData m) v)
                 (dpm_hasDataTransformation m)))
          (exists ((dm DATA-MAPPING))
            (and (= (dataMapping_variableData dm) v)
                 (= (dataMapping_iSignal dm) s)
                 (exists ((dt DATA-TRANSFORMATION))
                   (uses_dataTransformation s dt))))
        )))))

; ===== constr_1402: Applicability of core-related possible values =====
; If SwAddrMethod.option or MemorySection.option is coreLocal then
; SwAddrMethod.sectionInitializationPolicy shall be INIT or CLEARED.

; SwAddrMethod-local rule:
(assert
  (forall ((a SW-ADDR-METHOD))
    (=> (swAddrMethod_hasOption_coreLocal a)
        (and (has_sectionInitializationPolicy a)
             (or (= (sectionInitializationPolicy a) "INIT")
                 (= (sectionInitializationPolicy a) "CLEARED"))))))

; MemorySection rule:
; If a MemorySection has OPTION coreLocal, then its associated SwAddrMethod
; must have sectionInitializationPolicy INIT or CLEARED.

(assert
  (forall ((m MEMORY-SECTION))
    (=> (memSection_hasOption_coreLocal m)
        (let ((a (memSection_swAddrMethod m)))
          (and (has_sectionInitializationPolicy a)
               (or (= (sectionInitializationPolicy a) "INIT")
                   (= (sectionInitializationPolicy a) "CLEARED")))))))

; ===== constr_1403: NvBlockDataMappings to a given nvData shall be unambiguous =====
; If an NvBlockDataMapping exists that directly and completely maps a specific
; NvDataInterface.nvData, then no other NvBlockDataMapping which maps sub-elements
; of that nvData shall exist.

(assert
  (forall ((v VARIABLE-DATA-PROTOTYPE))
    (forall ((m1 NV-BLOCK-DATA-MAPPING))
      (=> (and (= (nbm_nvData m1) v)
               (nbm_isComplete m1))
          (forall ((m2 NV-BLOCK-DATA-MAPPING))
            (=> (= (nbm_nvData m2) v)
                (not (nbm_isSubElementMapping m2)))))))

