; =========================
; constr_1085 - Compatibility in the case of a flat ECU extract
; =========================

(declare-sort NV-DATA-INTERFACE 0)
(declare-sort SENDER-RECEIVER-INTERFACE 0)
(declare-sort PARAMETER-INTERFACE 0)
(declare-sort PORT-PROTOTYPE 0)
(declare-sort R-PORT-PROTOTYPE 0)
(declare-sort P-PORT-PROTOTYPE 0)
