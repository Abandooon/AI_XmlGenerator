; =========================
; constr_1078 - Compatibility of ClientServerOperations
; =========================

; Semantic predicate: two ClientServerOperations are compatible
(declare-fun CSOperationCompatible (CLIENT-SERVER-OPERATION CLIENT-SERVER-OPERATION) Bool)

(assert
  (forall ((r CLIENT-SERVER-OPERATION) (p CLIENT-SERVER-OPERATION))
    (= (CSOperationCompatible r p)
       (and
         ; 1. Same number of arguments
         (= (csop_argCount r) (csop_argCount p))

         ; 2. n-th arguments compatible (ordering)
         (forall ((i Int))
           (=> (and (<= 0 i) (< i (csop_argCount r)))
               (ArgCompatible (csop_nthArgument r i)
                              (csop_nthArgument p i))))

         ; 3. Same shortName
         (= (csop_shortName r) (csop_shortName p))

         ; 4. ApplicationError coverage:
         ;    For each possible error of provided p, required r has a compatible one.
         (forall ((j Int))
           (=> (and (<= 0 j) (< j (csop_possibleErrorCount p)))
               (exists ((k Int))
                 (and (<= 0 k) (< k (csop_possibleErrorCount r))
                      (AppErrorCompatible
                        (csop_nthPossibleError r k)
                        (csop_nthPossibleError p j)))))))))

; Note: special E_OK semantics are encoded inside AppErrorCompatible, not here.

; =========================
; constr_1079 - Compatibility of ClientServerInterfaces (AssemblySwConnector)
; =========================

; Semantic predicate: two ClientServerInterfaces are compatible in Assembly context
(declare-fun CSInterfaceCompatible_Assembly (CLIENT-SERVER-INTERFACE CLIENT-SERVER-INTERFACE ASSEMBLY-SW-CONNECTOR) Bool)

(assert
  (forall ((req CLIENT-SERVER-INTERFACE)
           (prov CLIENT-SERVER-INTERFACE)
           (c ASSEMBLY-SW-CONNECTOR))
    (= (CSInterfaceCompatible_Assembly req prov c)
       (and
         ; 1. Either (a) name-based coverage or (b) mapping-based
         (or
           ; (a) For each operation in required, there exists compatible in provided by shortName
           (forall ((i Int))
             (=> (and (<= 0 i) (< i (csif_operationCount req)))
                 (exists ((j Int))
                   (and (<= 0 j) (< j (csif_operationCount prov))
                        (= (csop_shortName (csif_nthOperation req i))
                           (csop_shortName (csif_nthOperation prov j)))
                        (CSOperationCompatible
                          (csif_nthOperation req i)
                          (csif_nthOperation prov j))))))

           ; (b) There exists a mapping referenced by connector
           (let ((m (asm_csifMapping c)))
             (and
               ; i. m is referenced by c (captured by using asm_csifMapping)
               ; ii. each mapping pairs two operations
               (forall ((k Int))
                 (=> (and (<= 0 k) (< k (csifm_operationMappingCount m)))
                     (let ((om (csifm_nthOperationMapping m)))
                       (and
                         (CSOperationCompatible
                           (opmap_firstOperation om)
                           (opmap_secondOperation om)))))))))

         ; 2. isService identical for each such pair of interfaces
         (= (csif_isService req) (csif_isService prov))))))

; Connector-level requirement: the interfaces connected by an AssemblySwConnector must be compatible
(assert
  (forall ((c ASSEMBLY-SW-CONNECTOR))
    (CSInterfaceCompatible_Assembly
      (asm_requiredInterface c)
      (asm_providedInterface c)
      c)))

