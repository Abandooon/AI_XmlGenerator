(define-fun isVSA_LINEAR ((p String)) Bool (= p "VSA_LINEAR"))
(define-fun isVSA_SQUARE ((p String)) Bool (= p "VSA_SQUARE"))
(define-fun isVSA_FULLY_FLEXIBLE ((p String)) Bool (= p "VSA_FULLY_FLEXIBLE"))
(define-fun isVSA_RECTANGULAR ((p String)) Bool (= p "VSA_RECTANGULAR"))

(define-fun isVSA_LINEAR_SQUARE_OR_FULLY_FLEXIBLE ((p String)) Bool
  (or (isVSA_LINEAR p) (isVSA_SQUARE p) (isVSA_FULLY_FLEXIBLE p)))

; ================================================================
; TPS_SWCT_01615 - Custom profiles naming (logical placeholder)
; ================================================================
; Custom profiles can be added to dynamicArraySizeProfile. They shall
; have a company-specific prefix.
