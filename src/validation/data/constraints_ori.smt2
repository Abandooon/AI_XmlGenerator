; ExecutableEntityActivationReasons are unique.
(assert
  (forall ((r RUNNABLE-ENTITY)
           (a1 EXECUTABLE-ENTITY-ACTIVATION-REASON)
           (a2 EXECUTABLE-ENTITY-ACTIVATION-REASON))
    (=> (and (runnable_has_activationReason r a1)
             (runnable_has_activationReason r a2)
             (not (= a1 a2))
             (has_bitPosition a1)
             (has_bitPosition a2)
             (has_symbol a1)
             (has_symbol a2))
        (and (not (= (bitPosition a1) (bitPosition a2)))
             (not (= (symbol a1) (symbol a2)))))))

; constr_1228:
; If an RTEEvent is referenced by some WaitPoint as trigger,
; then it shall not reference ExecutableEntityActivationReason
; in activationReasonRepresentation.
(assert
  (forall ((e RTE-EVENT))
    (=> (waitPointExistsFor e)
        (not (has_activationReasonRepresentationRef e))))

; constr_1231:
; If ConsistencyNeeds are aggregated by a CompositionSwComponentType,
; its instanceRef associations may only refer to elements within
; the context of this CompositionSwComponentType.
(assert
  (forall ((c COMPOSITION-SW-COMPONENT-TYPE)
           (cn CONSISTENCY-NEEDS))
    (=> (compo_has_consistencyNeeds c cn)
        (consistencyNeedsInstanceRefWithinCompositionContext cn c))))

; constr_1232:
; If ConsistencyNeeds are aggregated by an AtomicSwComponentType,
; its instanceRef associations may only refer to elements within
; the context of this AtomicSwComponentType.
(assert
  (forall ((a ATOMIC-SW-COMPONENT-TYPE)
           (cn CONSISTENCY-NEEDS))
    (=> (atomic_has_consistencyNeeds a cn)
        (consistencyNeedsInstanceRefWithinAtomicContext cn a))))

; constr_1233:
; InstantiationTimingEventProps shall only reference TimingEvent
; in the role refinedEvent.
(assert
  (forall ((p INSTANTIATION-TIMING-EVENT-PROPS))
    (=> (has_refinedEvent p)
        (isTimingEvent (refinedEvent p)))))


