(assert
  (forall ((a APPLICATION-PRIMITIVE-DATA-TYPE) (i IMPLEMENTATION-DATA-TYPE))
    (=> (and (compatibleImpl a i)
             (has_invalidValue_app a)
             (has_invalidValue_impl i))
