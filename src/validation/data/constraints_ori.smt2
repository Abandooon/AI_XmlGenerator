(assert
  (forall ((a ATOMIC-SW-COMPONENT-TYPE))
    (forall ((r1 ROLE-BASED-PORT-ASSIGNMENT) (r2 ROLE-BASED-PORT-ASSIGNMENT))
      (=> (and (belongsToAtomic r1 a)
