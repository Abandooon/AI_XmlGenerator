;;;;;;;;;;;;;;;;;;;;;;;
; constr_1243
; NumericalOrText shall either define vf or vt (exclusive or, and at least one)
;;;;;;;;;;;;;;;;;;;;;;;

(assert
  (forall ((x NUMERICAL-OR-TEXT))
    (let ((vf (has_vf x))
          (vt (has_vt x)))
      (and
        ; at least one
        (or vf vt)
        ; not both
        (not (and vf vt))))))

;;;;;;;;;;;;;;;;;;;;;;;
; constr_1244
; A DataPrototype used in an AtomicSwComponentType shall not set
; swDataDefProps.additionalNativeTypeQualifier to "enum".
;;;;;;;;;;;;;;;;;;;;;;;

(assert
  (forall ((d DATA-PROTOTYPE) (a ATOMIC-SW-COMPONENT-TYPE))
    (=> (usedInAtomicSwComponent d a)
        (forall ((p SW-DATA-DEF-PROPS))
          (=> (has_swDataDefProps d p)
              (forall ((c SW-DATA-DEF-PROPS-CONTENT))
                (=> (has_swDataDefPropsContent p c)
                    (=> (has_additionalNativeTypeQualifier c)
                        (not (= (additionalNativeTypeQualifier c) (lit_enum)))))))))))

;;;;;;;;;;;;;;;;;;;;;;;
; constr_1245
; Consideration of ModeTransitions for compatibility of ModeDeclarationGroups
;
; One of:
;  - Either provider or user define ModeTransitions.
;  - Transitions of provider and user are identical OR a mapping is applied.
;;;;;;;;;;;;;;;;;;;;;;;

(declare-fun isModeProvider (MODE-DECLARATION-GROUP) Bool)
(declare-fun isModeUser (MODE-DECLARATION-GROUP) Bool)

(assert
  (forall ((p MODE-DECLARATION-GROUP) (u MODE-DECLARATION-GROUP))
    (=> (and (isModeProvider p) (isModeUser u))
        (or
          ; either provider or user define transitions
          (or (hasModeTransitions p) (hasModeTransitions u))
          ; or transitions are compatible / mapped
          (or (transitionsCompatible p u)
              (hasModeDeclarationMapping p u))))))

;;;;;;;;;;;;;;;;;;;;;;;
; constr_1246
; Within one ModeDeclarationMappingSet:
; - all firstModes belong to one and only one ModeDeclarationGroup
; - all secondModes belong to one and only one other ModeDeclarationGroup
;;;;;;;;;;;;;;;;;;;;;;;

(assert
  (forall ((s MODE-DECLARATION-MAPPING-SET))
    (and
      ; there exists a unique group G1 such that every firstMode in s belongs to G1
      (exists ((g1 MODE-DECLARATION-GROUP))
        (and
          ; every firstMode in s has ownerGroup g1
          (forall ((m MODE-DECLARATION-MAPPING) (md MODE-DECLARATION))
            (=> (and (inMappingSet m s) (firstMode m md))
                (ownerGroup md g1)))
          ; uniqueness of g1
          (forall ((g1' MODE-DECLARATION-GROUP))
            (=> (forall ((m MODE-DECLARATION-MAPPING) (md MODE-DECLARATION))
                  (=> (and (inMappingSet m s) (firstMode m md))
                      (ownerGroup md g1')))
                (= g1' g1)))))
      ; there exists a unique group G2 such that every secondMode in s belongs to G2
      (exists ((g2 MODE-DECLARATION-GROUP))
        (and
          (forall ((m MODE-DECLARATION-MAPPING) (md MODE-DECLARATION))
            (=> (and (inMappingSet m s) (secondMode m md))
                (ownerGroup md g2)))
          (forall ((g2' MODE-DECLARATION-GROUP))
            (=> (forall ((m MODE-DECLARATION-MAPPING) (md MODE-DECLARATION))
                  (=> (and (inMappingSet m s) (secondMode m md))
                      (ownerGroup md g2')))
                (= g2' g2))))
      ; and G1 and G2 are different groups
      (forall ((g1 MODE-DECLARATION-GROUP) (g2 MODE-DECLARATION-GROUP))
        (=> (and
              (exists ((m MODE-DECLARATION-MAPPING) (md MODE-DECLARATION))
                (and (inMappingSet m s) (firstMode m md) (ownerGroup md g1)))
              (exists ((m MODE-DECLARATION-MAPPING) (md MODE-DECLARATION))
                (and (inMappingSet m s) (secondMode m md) (ownerGroup md g2))))
            (not (= g1 g2)))))))

;;;;;;;;;;;;;;;;;;;;;;;
; constr_1247
; If a ModeDeclarationGroupPrototypeMapping.modeDeclarationMappingSet exists:
; - the group owning firstModes is the type of firstModeGroup
; - the group owning secondModes is the type of secondModeGroup
;;;;;;;;;;;;;;;;;;;;;;;

(assert
  (forall ((m MODE-DECLARATION-GROUP-PROTOTYPE-MAPPING))
    (forall ((s MODE-DECLARATION-MAPPING-SET))
      (=> (modeDeclarationMappingSetRef m s)
          (forall ((fgp MODE-DECLARATION-GROUP-PROTOTYPE)
                   (sgp MODE-DECLARATION-GROUP-PROTOTYPE))
            (=> (and (firstModeGroup m fgp)
                     (secondModeGroup m sgp))
                (forall ((g1 MODE-DECLARATION-GROUP)
                         (g2 MODE-DECLARATION-GROUP))
                  (=> (and (mdgPrototypeType fgp g1)
                           (mdgPrototypeType sgp g2))
                      (and
                        ; all firstModes in s belong to g1
                        (forall ((mm MODE-DECLARATION-MAPPING) (md MODE-DECLARATION))
                          (=> (and (inMappingSet mm s) (firstMode mm md))
                              (ownerGroup md g1)))
                        ; all secondModes in s belong to g2
                        (forall ((mm MODE-DECLARATION-MAPPING) (md MODE-DECLARATION))
                          (=> (and (inMappingSet mm s) (secondMode mm md))
                              (ownerGroup md g2)))))))))))

;;;;;;;;;;;;;;;;;;;;;;;
; constr_1248
; Compatibility of PortPrototypes of different DataInterfaces in PassThroughSwConnector
;
; Abstracted as:
; For a required port r and provided port p that are connected:
; 1) For at least one data element in r's interface, there is a compatible one in p's interface
;    (by same shortName or via PortInterfaceMapping, and with compatible swImplPolicy).
; 2) For each such pair, PortInterface.isService values are identical.
;;;;;;;;;;;;;;;;;;;;;;;

; connectivity in PassThroughSwConnector
(declare-fun connectedInPassThrough (PORT-PROTOTYPE PORT-PROTOTYPE) Bool)

(assert
  (forall ((r PORT-PROTOTYPE) (p PORT-PROTOTYPE))
    (=> (and (isRequiredOuterPort r)
             (isProvidedOuterPort p)
             (connectedInPassThrough r p))
        (forall ((di_r DATA-INTERFACE) (di_p DATA-INTERFACE)
                 (pi_r PORT-INTERFACE) (pi_p PORT-INTERFACE))
          (=> (and (portOfInterface r di_r)
                   (portOfInterface p di_p)
                   (portInterface r pi_r)
                   (portInterface p pi_p))
              (let (
                    (service_r (exists ((b Bool)) (isService pi_r b)))
                    (service_p (exists ((b Bool)) (isService pi_p b)))
                   )
                (and
                  ; 1. existence of at least one compatible pair of data elements
                  (or
                    (exists ((x VARIABLE-DATA-PROTOTYPE) (y VARIABLE-DATA-PROTOTYPE) (sn STRING) (polx SW-IMPL-POLICY-ENUM) (poly SW-IMPL-POLICY-ENUM))
                      (and
                        (hasVariableDataPrototype di_r x)
                        (hasVariableDataPrototype di_p y)
                        (shortName_Var x sn)
                        (shortName_Var y sn)
                        (has_swImplPolicy_Var x polx)
                        (has_swImplPolicy_Var y poly)
                        (= polx poly)))
                    (exists ((x PARAMETER-DATA-PROTOTYPE) (y PARAMETER-DATA-PROTOTYPE) (sn STRING) (polx SW-IMPL-POLICY-ENUM) (poly SW-IMPL-POLICY-ENUM))
                      (and
                        (hasParameterDataPrototype di_r x)
                        (hasParameterDataPrototype di_p y)
                        (shortName_Param x sn)
                        (shortName_Param y sn)
                        (has_swImplPolicy_Param x polx)
                        (has_swImplPolicy_Param y poly)
                        (= polx poly)))
                    ; or via PortInterfaceMapping
                    (exists ((m PORT-INTERFACE))
                      (and
                        (hasPortInterfaceMapping pi_r pi_p)
                        (or
                          (exists ((x PARAMETER-DATA-PROTOTYPE) (y PARAMETER-DATA-PROTOTYPE) (polx SW-IMPL-POLICY-ENUM) (poly SW-IMPL-POLICY-ENUM))
                            (and
                              (mappedParamPair pi_r pi_p x y)
                              (has_swImplPolicy_Param x polx)
                              (has_swImplPolicy_Param y poly)
                              (= polx poly)))
                          (exists ((x VARIABLE-DATA-PROTOTYPE) (y VARIABLE-DATA-PROTOTYPE) (polx SW-IMPL-POLICY-ENUM) (poly SW-IMPL-POLICY-ENUM))
                            (and
                              (mappedVarPair pi_r pi_p x y)
                              (has_swImplPolicy_Var x polx)
                              (has_swImplPolicy_Var y poly)
                              (= polx poly)))))))
                  ; 2. isService identical
                  (forall ((br Bool) (bp Bool))
                    (=> (and (isService pi_r br) (isService pi_p bp))
                        (= br bp)))))))))

;;;;;;;;;;;;;;;;;;;;;;;
; constr_1249
; Compatibility of ModeSwitchInterfaces in PassThroughSwConnector
;
; 1. For the ModeDeclarationGroupPrototype in required interface, a compatible one exists in provided
;    (by same shortName or via ModeInterfaceMapping).
; 2. For each such pair, PortInterface.isService values are identical.
;;;;;;;;;;;;;;;;;;;;;;;

(assert
  (forall ((r PORT-PROTOTYPE) (p PORT-PROTOTYPE))
    (=> (and (isRequiredOuterPort r)
             (isProvidedOuterPort p)
             (connectedInPassThrough r p))
        (forall ((ms_r MODE-SWITCH-INTERFACE) (ms_p MODE-SWITCH-INTERFACE)
                 (pi_r PORT-INTERFACE) (pi_p PORT-INTERFACE))
          (=> (and (modeSwitchInterfaceOfPort r ms_r)
                   (modeSwitchInterfaceOfPort p ms_p)
                   (portInterface r pi_r)
                   (portInterface p pi_p))
              (and
                ; 1. existence of compatible ModeDeclarationGroupPrototype pair
                (or
                  (exists ((g1 MODE-DECLARATION-GROUP-PROTOTYPE)
                           (g2 MODE-DECLARATION-GROUP-PROTOTYPE)
                           (sn STRING))
                    (and
                      (hasModeDeclarationGroupPrototype ms_r g1)
                      (hasModeDeclarationGroupPrototype ms_p g2)
                      (shortName_MDGProto g1 sn)
                      (shortName_MDGProto g2 sn)))
                  (exists ((m MODE-INTERFACE-MAPPING)
                           (g1 MODE-DECLARATION-GROUP-PROTOTYPE)
                           (g2 MODE-DECLARATION-GROUP-PROTOTYPE))
                    (and
                      (hasModeInterfaceMapping ms_r ms_p m)
                      (mappedMDGProtoPair m g1 g2)
                      (hasModeDeclarationGroupPrototype ms_r g1)
                      (hasModeDeclarationGroupPrototype ms_p g2))))
                ; 2. isService identical
                (forall ((br Bool) (bp Bool))
                  (=> (and (isService pi_r br) (isService pi_p bp))
                      (= br bp)))))))))

