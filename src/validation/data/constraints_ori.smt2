(declare-fun role_is_DataServices (ROLE-BASED-PORT-ASSIGNMENT) Bool)

; Core logical pattern (documentation-level, not fully enforced without cardinality modeling):
; If an AtomicSwComponentType uses DiagnosticValueNeeds, then it must have exactly one RoleBasedPortAssignment
; with role DataServices. Here we only express existence and role restriction; exact cardinality is left to tooling.

(assert
  (forall ((c ATOMIC-SW-COMPONENT-TYPE))
    (=> (exists ((sd SWC-SERVICE-DEPENDENCY) (sn SERVICE-NEEDS))
          (and (has_serviceDependency c sd)
               (has_serviceNeeds sd sn)
