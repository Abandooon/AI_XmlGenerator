; ---------- TPS_SWCT_01001  Prefix symbols generated for the RunnableEntity ----------

; For each component type specialization: if and only if SYMBOL-PROPS/SYMBOL exists,
; its value is used as prefix for symbols of owned RUNNABLE-ENTITYs.

(assert
  (forall ((c APPLICATION-SW-COMPONENT-TYPE) (r RUNNABLE-ENTITY))
    (=> (ownsRunnable_APP c r)
        (= (and (has_symbolProps_APP c)
                (has_symbol (symbolPropsOf_APP c)))
           (isPrefixOf (symbolValue (symbolPropsOf_APP c))
                       (runnableSymbol r))))))

(assert
  (forall ((c COMPLEX-DEVICE-DRIVER-SW-COMPONENT-TYPE) (r RUNNABLE-ENTITY))
    (=> (ownsRunnable_CDD c r)
        (= (and (has_symbolProps_CDD c)
                (has_symbol (symbolPropsOf_CDD c)))
           (isPrefixOf (symbolValue (symbolPropsOf_CDD c))
                       (runnableSymbol r))))))

(assert
  (forall ((c ECU-ABSTRACTION-SW-COMPONENT-TYPE) (r RUNNABLE-ENTITY))
    (=> (ownsRunnable_ECU c r)
        (= (and (has_symbolProps_ECU c)
                (has_symbol (symbolPropsOf_ECU c)))
           (isPrefixOf (symbolValue (symbolPropsOf_ECU c))
                       (runnableSymbol r))))))

(assert
  (forall ((c NV-BLOCK-SW-COMPONENT-TYPE) (r RUNNABLE-ENTITY))
    (=> (ownsRunnable_NV c r)
        (= (and (has_symbolProps_NV c)
                (has_symbol (symbolPropsOf_NV c)))
           (isPrefixOf (symbolValue (symbolPropsOf_NV c))
                       (runnableSymbol r))))))

(assert
  (forall ((c SENSOR-ACTUATOR-SW-COMPONENT-TYPE) (r RUNNABLE-ENTITY))
    (=> (ownsRunnable_SA c r)
        (= (and (has_symbolProps_SA c)
                (has_symbol (symbolPropsOf_SA c)))
           (isPrefixOf (symbolValue (symbolPropsOf_SA c))
                       (runnableSymbol r))))))

(assert
  (forall ((c SERVICE-PROXY-SW-COMPONENT-TYPE) (r RUNNABLE-ENTITY))
    (=> (ownsRunnable_SPROXY c r)
        (= (and (has_symbolProps_SPROXY c)
                (has_symbol (symbolPropsOf_SPROXY c)))
           (isPrefixOf (symbolValue (symbolPropsOf_SPROXY c))
                       (runnableSymbol r))))))

(assert
  (forall ((c SERVICE-SW-COMPONENT-TYPE) (r RUNNABLE-ENTITY))
    (=> (ownsRunnable_SVC c r)
        (= (and (has_symbolProps_SVC c)
                (has_symbol (symbolPropsOf_SVC c)))
           (isPrefixOf (symbolValue (symbolPropsOf_SVC c))
                       (runnableSymbol r))))))

; ---------- TPS_SWCT_01002  SwComponentTypes may only interact by PortPrototypes ----------

(assert
  (forall ((a SW-COMPONENT-TYPE) (b SW-COMPONENT-TYPE))
    (=> (interactsWith a b)
        (interactsViaPort a b))))

; ---------- TPS_SWCT_01003  serviceKind vs implementation of PortInterface ----------

; If there is an inconsistency between serviceKindValue and implementationKind,
; the implementation wins: effectiveServiceKind equals implementationKind.

(assert
  (forall ((p PORT-INTERFACE))
    (=> (and (has_serviceKind p)
             (not (= (serviceKindValue p) (implementationKind p))))
        (= (effectiveServiceKind p) (implementationKind p)))))

; If they are consistent or serviceKind is absent, effectiveServiceKind
; can be equal to serviceKindValue or implementationKind; we do not further constrain.

; ---------- TPS_SWCT_01004  Default value if serviceKind is not defined ----------

(assert
  (forall ((p PORT-INTERFACE))
    (=> (not (has_serviceKind p))
        (= (effectiveServiceKind p) "anyStandardized"))))

; ---------- TPS_SWCT_01005  SwcServiceDependencys for vendor-specific services ----------

(assert
  (forall ((d SWC-SERVICE-DEPENDENCY) (n SERVICE-NEEDS))
    (=> (and (isVendorSpecific d)
             (containsStandardizedServiceNeed d n))
        (not (isStandardizedServiceNeed n)))))

; ---------- TPS_SWCT_01006  ImplementationDataType.subElement.arraySize used for array size ----------

; For an ImplementationDataType that implements an array data type, the
; semantic array size equals the arraySize of its subElement(s).
; We model: if isArrayType, then there exists at least one subElement with arraySize,
; and all such arraySizes are equal to arraySemanticSize.

(assert
  (forall ((t IMPLEMENTATION-DATA-TYPE))
    (=> (isArrayType t)
        (and
          (exists ((e IMPLEMENTATION-DATA-TYPE-ELEMENT))
            (and (has_subElement t e)
                 (has_arraySize e)))
          (forall ((e IMPLEMENTATION-DATA-TYPE-ELEMENT))
            (=> (and (has_subElement t e)
                     (has_arraySize e))
                (= (arraySemanticSize t) (arraySizeValue e)))))))

; ---------- TPS_SWCT_01007  Semantics of array index ----------

; For an ImplementationDataType that implements an array data type, the
; valid indices are exactly 0 .. arraySemanticSize-1.

(assert
  (forall ((t IMPLEMENTATION-DATA-TYPE) (i Int))
    (=> (isArrayType t)
        (= (validArrayIndex t i)
           (and (<= 0 i)
                (< i (arraySemanticSize t)))))))

; End of template – (check-sat) is added by the validator.


