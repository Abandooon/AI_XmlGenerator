(assert
  (forall ((m CLIENT-SERVER-OPERATION-MAPPING)
           (a1 ARGUMENT-DATA-PROTOTYPE)
           (a2 ARGUMENT-DATA-PROTOTYPE))
    (=> (and (inMapping m a1)
             (inMapping m a2))
        (= (direction a1) (direction a2)))))

