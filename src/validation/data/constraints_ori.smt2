(declare-fun isFixedVariant     (ECU-STATE-MGR-USER-NEEDS) Bool)

; exactly two variants, mutually exclusive, and each instance is one of them
(assert
  (forall ((e ECU-STATE-MGR-USER-NEEDS))
    (and (xor (isFlexibleVariant e) (isFixedVariant e))
         (or (isFlexibleVariant e) (isFixedVariant e)))))


