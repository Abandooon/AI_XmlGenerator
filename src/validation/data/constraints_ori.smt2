; explicitInterRunnableVariable.
; ------------------------------------------------------------

; The text is permissive: "possible (but not mandatory)".
; So there is no requirement that initValue must exist.
; We only ensure that if an initValue is present, it is attached
; to a VariableDataPrototype that is used as an inter-runnable
; variable (explicit or implicit).

(assert
  (forall ((beh SWC-INTERNAL-BEHAVIOR) (v VARIABLE-DATA-PROTOTYPE))
    (=> (hasInitValue v)
        (or (isExplicitInterRunnableVariable beh v)
            (isImplicitInterRunnableVariable beh v)))))

; ------------------------------------------------------------
; TPS_SWCT_01638
; [constr_1086] applies also in the case that two PRPortPrototypes
; are connected with each other. The roles
;  • AssemblySwConnector.requester
;  • AssemblySwConnector.provider
;  • PassThroughSwConnector.providedOuterPort
;  • PassThroughSwConnector.requiredOuterPort
; do not establish a direction in this case.
; ------------------------------------------------------------

; We model this as: whenever an AssemblySwConnector or
; PassThroughSwConnector connects two PR-PORT-PROTOTYPEs,
; the connection is logically undirected (symmetric).

(assert
  (forall ((ac ASSEMBLY-SW-CONNECTOR)
           (p1 PR-PORT-PROTOTYPE)
           (p2 PR-PORT-PROTOTYPE))
    (=> (connectsPRPorts_Assembly ac p1 p2)
        (and (connectsPRPorts_Assembly ac p2 p1)
             (not (hasDirection_Assembly ac))))))

(assert
  (forall ((pc PASS-THROUGH-SW-CONNECTOR)
           (p1 PR-PORT-PROTOTYPE)
