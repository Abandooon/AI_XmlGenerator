; =========================
; constr_1313 - Completeness of TextTableMapping for bit mask values
; =========================

; If a DataPrototypeMapping for a DATA-PROTOTYPE has a sender CompuMethod of
; category BITFIELD_TEXTTABLE and at least one TextTableMapping, then for each
; such TextTableMapping:
; - for every possible mask value v (according to the applicable mask),
;   there exists exactly one value pair representing v.

(assert
  (forall ((dp DATA-PROTOTYPE) (m DATA-PROTOTYPE-MAPPING))
    (=> (senderMappingOf dp m)
        (let ((existsBitfield
                (exists ((cm COMPU-METHOD))
                  (and (senderCompuMethodOf m cm)
                       (= (compuCategory cm) "BITFIELD_TEXTTABLE")))))
          (=> existsBitfield
              (forall ((ttm TEXT-TABLE-MAPPING))
                (=> (hasTextTableMapping m ttm)
                    (and
                      ; Case 1: first mask applies
                      (=> (hasMaskFirst ttm)
                          (forall ((v Int))
                            (=> (maskAppliesFirst ttm v)
                                (and
                                  (exists ((vp TEXT-TABLE-VALUE-PAIR))
                                    (and (hasValuePair ttm vp)
                                         (valuePairRepresentsFirst ttm vp v)))
                                  (forall ((vp1 TEXT-TABLE-VALUE-PAIR)
                                           (vp2 TEXT-TABLE-VALUE-PAIR))
                                    (=> (and (hasValuePair ttm vp1)
                                             (hasValuePair ttm vp2)
                                             (valuePairRepresentsFirst ttm vp1 v)
                                             (valuePairRepresentsFirst ttm vp2 v))
                                        (= vp1 vp2)))))))
                      ; Case 2: second mask applies
                      (=> (hasMaskSecond ttm)
                          (forall ((v Int))
                            (=> (maskAppliesSecond ttm v)
                                (and
                                  (exists ((vp TEXT-TABLE-VALUE-PAIR))
                                    (and (hasValuePair ttm vp)
                                         (valuePairRepresentsSecond ttm vp v)))
                                  (forall ((vp1 TEXT-TABLE-VALUE-PAIR)
                                           (vp2 TEXT-TABLE-VALUE-PAIR))
                                    (=> (and (hasValuePair ttm vp1)
                                             (hasValuePair ttm vp2)
                                             (valuePairRepresentsSecond ttm vp1 v)
                                             (valuePairRepresentsSecond ttm vp2 v))
                                        (= vp1 vp2)))))))))))))


; =========================
; constr_1314 - Profile VSA_LINEAR for ApplicationArrayDataType
; =========================

; If dynamicArraySizeProfile(aadt) = VSA_LINEAR, then every contained element e
; must satisfy:
; - arraySizeSemantics = variableSize
; - maxNumberOfElements is defined
; - arraySizeHandling = allIndicesSameArraySize
; - e is typed by an ApplicationDataType that is NOT an ApplicationArrayDataType
;   with an existing dynamicArraySizeProfile.

(assert
  (forall ((aadt APPLICATION-ARRAY-DATA-TYPE) (e APPLICATION-ARRAY-ELEMENT))
    (=> (and (elementOf aadt e)
             (= (dynamicArraySizeProfile aadt) "VSA_LINEAR"))
        (and
          (= (arraySizeSemantics_app e) "variableSize")
          (hasMaxNumberOfElements e)
          (= (arraySizeHandling_app e) "allIndicesSameArraySize")
          (exists ((t APPLICATION-DATA-TYPE))
            (and (typeOf_appElem e t)
                 (or (not (isApplicationArrayDataType t))
                     (not (dynamicArraySizeProfile_exists t)))))))))


; =========================
; constr_1315 - Profile VSA_SQUARE for ApplicationArrayDataType
; =========================

; Root condition on contained element e of root ApplicationArrayDataType aadt:
; - arraySizeSemantics = variableSize
; - maxNumberOfElements not defined
; - arraySizeHandling = inheritedFromArrayElementTypeSize
; - e typed by an ApplicationArrayDataType t0.

(assert
  (forall ((aadt APPLICATION-ARRAY-DATA-TYPE) (e APPLICATION-ARRAY-ELEMENT))
    (=> (and (elementOf aadt e)
             (= (dynamicArraySizeProfile aadt) "VSA_SQUARE"))
        (and
          (= (arraySizeSemantics_app e) "variableSize")
          (not (hasMaxNumberOfElements e))
          (= (arraySizeHandling_app e) "inheritedFromArrayElementTypeSize")
          (exists ((t0 APPLICATION-ARRAY-DATA-TYPE))
            (and (typeOf_appElem e t0)
                 (isApplicationArrayDataType t0)))))))

; Chain semantics (informal, abstracted):
; There exists a finite chain of nested ApplicationArrayDataTypes starting at t0
; and ending at t_last, where:
; - t_last refers (via its element) to a non-array ApplicationDataType t_base
;   without dynamicArraySizeProfile.
; - The element of t_last has:
;     arraySizeSemantics = variableSize
;     maxNumberOfElements defined
;     arraySizeHandling = allIndicesSameArraySize
; - All previous ApplicationArrayDataTypes in the chain have elements with:
;     arraySizeSemantics = variableSize
;     maxNumberOfElements not defined
;     arraySizeHandling = inheritedFromArrayElementTypeSize
;     typed by an ApplicationArrayDataType.

; We encode this as a per-root-aadt requirement using an abstract chain predicate.
(declare-fun VSASquareChainOK (APPLICATION-ARRAY-DATA-TYPE) Bool)

(assert
  (forall ((aadt APPLICATION-ARRAY-DATA-TYPE))
    (=> (= (dynamicArraySizeProfile aadt) "VSA_SQUARE")
        (VSASquareChainOK aadt))))


