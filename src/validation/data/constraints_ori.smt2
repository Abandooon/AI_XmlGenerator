; 6) Constr_CompositionSwCT_DataTypeMappingCapability
; 语义：CompositionSwComponentType 可以（但不必须）拥有
; - DataTypeMappingSet（dataTypeMapping 角色）
; - ConstantSpecificationMappingSet（constantValueMapping 角色）

(declare-sort COMPOSITION-SW-COMPONENT-TYPE 0)
(declare-sort DATA-TYPE-MAPPING-SET 0)
(declare-sort CONSTANT-SPECIFICATION-MAPPING-SET 0)

