; 6) Figure_6_11
; "Illegal split of delegation connector: Data set partitioning"

(declare-sort DELEGATION-SW-CONNECTOR 0)
(declare-sort ABSTRACT-PROVIDED-PORT-PROTOTYPE 0)
(declare-sort ABSTRACT-REQUIRED-PORT-PROTOTYPE 0)
(declare-sort DATA-PROTOTYPE 0)

; connector endpoints
(declare-fun outerPort (DELEGATION-SW-CONNECTOR) ABSTRACT-PROVIDED-PORT-PROTOTYPE)
(declare-fun innerPort (DELEGATION-SW-CONNECTOR) ABSTRACT-REQUIRED-PORT-PROTOTYPE)

; data elements of a port
(declare-fun hasDataElementProvided
  (ABSTRACT-PROVIDED-PORT-PROTOTYPE DATA-PROTOTYPE) Bool)
(declare-fun hasDataElementRequired
  (ABSTRACT-REQUIRED-PORT-PROTOTYPE DATA-PROTOTYPE) Bool)

; semantic: for a given outer port, the set of data elements of all inner ports
; connected via DelegationSwConnector must form an exact, non-overlapping partition
; of the outer port's data elements.

; helper predicate: connector is attached to a given outer port
(declare-fun attachedToOuter
  (DELEGATION-SW-CONNECTOR ABSTRACT-PROVIDED-PORT-PROTOTYPE) Bool)

(assert
  (forall ((d DELEGATION-SW-CONNECTOR) (p ABSTRACT-PROVIDED-PORT-PROTOTYPE))
    (= (attachedToOuter d p)
       (= (outerPort d) p))))

; exact coverage: every data element of outer port appears in at least one inner port
(assert
  (forall ((p ABSTRACT-PROVIDED-PORT-PROTOTYPE) (x DATA-PROTOTYPE))
    (=> (hasDataElementProvided p x)
        (exists ((d DELEGATION-SW-CONNECTOR) (r ABSTRACT-REQUIRED-PORT-PROTOTYPE))
          (and (attachedToOuter d p)
               (= (innerPort d) r)
               (hasDataElementRequired r x))))))

; no new elements: inner ports cannot introduce elements not in outer port
(assert
  (forall ((p ABSTRACT-PROVIDED-PORT-PROTOTYPE)
           (d DELEGATION-SW-CONNECTOR)
           (r ABSTRACT-REQUIRED-PORT-PROTOTYPE)
           (x DATA-PROTOTYPE))
    (=> (and (attachedToOuter d p)
             (= (innerPort d) r)
             (hasDataElementRequired r x))
        (hasDataElementProvided p x))))

; non-overlapping: each data element of outer port is assigned to exactly one inner port
(assert
  (forall ((p ABSTRACT-PROVIDED-PORT-PROTOTYPE) (x DATA-PROTOTYPE))
    (=> (hasDataElementProvided p x)
        (exists ((d1 DELEGATION-SW-CONNECTOR) (r1 ABSTRACT-REQUIRED-PORT-PROTOTYPE))
          (and (attachedToOuter d1 p)
               (= (innerPort d1) r1)
               (hasDataElementRequired r1 x)
               (forall ((d2 DELEGATION-SW-CONNECTOR) (r2 ABSTRACT-REQUIRED-PORT-PROTOTYPE))
                 (=> (and (attachedToOuter d2 p)
                          (= (innerPort d2) r2)
                          (hasDataElementRequired r2 x))
                     (= d2 d1))))))))


; 7) Figure_6_12
; "Illegal merge of delegation connector: Interface compatibility"

; AssemblySwConnector merging multiple AbstractProvidedPortPrototypes into one DelegationSwConnector
(declare-sort ASSEMBLY-SW-CONNECTOR 0)

; endpoints of assembly connectors
(declare-fun providedPort (ASSEMBLY-SW-CONNECTOR) ABSTRACT-PROVIDED-PORT-PROTOTYPE)
(declare-fun requiredPort (ASSEMBLY-SW-CONNECTOR) ABSTRACT-REQUIRED-PORT-PROTOTYPE)

; semantic predicate: interface compatibility between a set of provided ports and a target required port
(declare-fun interfacesCompatible
  (ABSTRACT-REQUIRED-PORT-PROTOTYPE ABSTRACT-PROVIDED-PORT-PROTOTYPE) Bool)

; rule: when multiple AssemblySwConnectors are merged into a single DelegationSwConnector
; to a required port, all contributing provided ports must be interface-compatible with the target.

; helper: assembly connector participates in a merge to a given required port
(declare-fun mergedToRequired
  (ASSEMBLY-SW-CONNECTOR ABSTRACT-REQUIRED-PORT-PROTOTYPE) Bool)

(assert
  (forall ((a ASSEMBLY-SW-CONNECTOR) (r ABSTRACT-REQUIRED-PORT-PROTOTYPE))
    (= (mergedToRequired a r)
       (= (requiredPort a) r))))

(assert
  (forall ((r ABSTRACT-REQUIRED-PORT-PROTOTYPE)
           (a ASSEMBLY-SW-CONNECTOR))
    (=> (mergedToRequired a r)
        (interfacesCompatible r (providedPort a))))


