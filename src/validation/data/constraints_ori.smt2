; TPS_SWCT_01659 - Mapping of VariableDataPrototype to a NvBlockDescriptor
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(declare-sort PORT-PROTOTYPE 0)
(declare-sort AUTOSAR-VARIABLE-REF 0)
(declare-sort VARIABLE-DATA-PROTOTYPE 0)
(declare-sort NV-BLOCK-DESCRIPTOR 0)
(declare-sort NV-DATA-INTERFACE 0)

; 关联
(declare-fun autosarVariableRefOf (PORT-PROTOTYPE) AUTOSAR-VARIABLE-REF)
(declare-fun ramBlockOf (NV-BLOCK-DESCRIPTOR) VARIABLE-DATA-PROTOTYPE)
(declare-fun nvDataOf (NV-DATA-INTERFACE) (Array Int VARIABLE-DATA-PROTOTYPE))

; AutosarVariableRef 的两种引用方式
(declare-fun has_autosarVariableInImplDatatype (AUTOSAR-VARIABLE-REF) Bool)
(declare-fun has_autosarVariable (AUTOSAR-VARIABLE-REF) Bool)

(declare-fun autosarVariableInImplDatatype_target (AUTOSAR-VARIABLE-REF) VARIABLE-DATA-PROTOTYPE)
(declare-fun autosarVariable_target (AUTOSAR-VARIABLE-REF) VARIABLE-DATA-PROTOTYPE)

; 辅助谓词：是否为 NvDataInterface.nvData 的叶元素 / 子元素
(declare-fun isLeafOfNvData (VARIABLE-DATA-PROTOTYPE NV-DATA-INTERFACE) Bool)
(declare-fun isSubElementOfNvData (VARIABLE-DATA-PROTOTYPE NV-DATA-INTERFACE) Bool)

; 1) 直接完整映射：ramBlock == nvData，且 autosarVariableRef.autosarVariable 指向该 nvData
(declare-fun isDirectCompleteMapping (PORT-PROTOTYPE NV-DATA-INTERFACE NV-BLOCK-DESCRIPTOR) Bool)

(assert
  (forall ((p PORT-PROTOTYPE) (ndi NV-DATA-INTERFACE) (nbd NV-BLOCK-DESCRIPTOR))
    (let* ((avr (autosarVariableRefOf p))
           (ram (ramBlockOf nbd)))
      (=> (isDirectCompleteMapping p ndi nbd)
          (and
            (has_autosarVariable avr)
            (= (autosarVariable_target avr) ram)))))

; 2) 每个叶元素单独映射：对每个叶元素，存在 autosarVariableInImplDatatype 或 autosarVariable 指向它
(declare-fun isPerLeafMapping (PORT-PROTOTYPE NV-DATA-INTERFACE NV-BLOCK-DESCRIPTOR) Bool)

(assert
  (forall ((p PORT-PROTOTYPE) (ndi NV-DATA-INTERFACE) (nbd NV-BLOCK-DESCRIPTOR))
    (=> (isPerLeafMapping p ndi nbd)
        (forall ((idx Int))
          (let ((v (select (nvDataOf ndi) idx))
                (avr (autosarVariableRefOf p)))
            (=> (isLeafOfNvData v ndi)
                (or (and (has_autosarVariableInImplDatatype avr)
                         (= (autosarVariableInImplDatatype_target avr) v))
                    (and (has_autosarVariable avr)
                         (= (autosarVariable_target avr) v))))))))

; 3) 子元素映射：某个非叶子子元素直接映射，所有其叶子间接映射
(declare-fun isSubElementMapping (PORT-PROTOTYPE NV-DATA-INTERFACE NV-BLOCK-DESCRIPTOR) Bool)

(assert
  (forall ((p PORT-PROTOTYPE) (ndi NV-DATA-INTERFACE) (nbd NV-BLOCK-DESCRIPTOR))
    (=> (isSubElementMapping p ndi nbd)
        (exists ((sub VARIABLE-DATA-PROTOTYPE))
          (let* ((avr (autosarVariableRefOf p))
                 (ram (ramBlockOf nbd)))
            (and
              (isSubElementOfNvData sub ndi)
              (= ram sub)
              (or (and (has_autosarVariableInImplDatatype avr)
                       (= (autosarVariableInImplDatatype_target avr) sub))
                  (and (has_autosarVariable avr)
                       (= (autosarVariable_target avr) sub))))))))

; 互斥/覆盖性（至少采用三种方式之一；可根据需要加强为互斥）
(declare-fun mappingMode_01659 (PORT-PROTOTYPE NV-DATA-INTERFACE NV-BLOCK-DESCRIPTOR) Bool)

(assert
  (forall ((p PORT-PROTOTYPE) (ndi NV-DATA-INTERFACE) (nbd NV-BLOCK-DESCRIPTOR))
    (=> (mappingMode_01659 p ndi nbd)
        (or (isDirectCompleteMapping p ndi nbd)
            (isPerLeafMapping p ndi nbd)
            (isSubElementMapping p ndi nbd))))


