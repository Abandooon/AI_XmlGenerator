; =========================
; Constraint 5:
; Constr_ModeUserMultipleMappings_Semantics
; Semantics of Mode User mapped to multiple Mode Manager declarations via multiple mappings
; =========================
; If one ModeDeclaration of a mode user is mapped to several ModeDeclarations of a mode manager
; by means of several ModeDeclarationMappings, transitions are recognizable to the mode user.

(assert
  (forall ((u MODE-DECLARATION))
    (=> (and (isModeUser u)
             (exists ((m1 MODE-DECLARATION-MAPPING)
                      (m2 MODE-DECLARATION-MAPPING)
                      (mm1 MODE-DECLARATION)
                      (mm2 MODE-DECLARATION))
               (and (mappingOfUser m1 u)
                    (mappingOfUser m2 u)
                    (not (= m1 m2))
                    (isModeManager mm1)
                    (isModeManager mm2)
                    (not (= mm1 mm2))
                    (secondMode m1 mm1)
                    (secondMode m2 mm2))))
        (forall ((m MODE-DECLARATION-MAPPING))
          (=> (mappingOfUser m u)
              (transitionsRecognizableToUser m))))))

; =========================
; Constraint 6:
; Constr_ModeUserSingleMappingMultipleModes_Semantics
; Semantics of Mode User mapped to multiple Mode Manager declarations via single mapping
; =========================
; If one ModeDeclaration of a mode user is mapped to several ModeDeclarations of a mode manager
; in the context of a single ModeDeclarationMapping (multiplicity of firstMode),
; transitions are NOT recognizable to the mode user.

(assert
  (forall ((m MODE-DECLARATION-MAPPING)
           (u MODE-DECLARATION))
    (=> (and (mappingOfUser m u)
             (exists ((mm1 MODE-DECLARATION)
                      (mm2 MODE-DECLARATION))
               (and (isModeManager mm1)
                    (isModeManager mm2)
                    (not (= mm1 mm2))
                    (firstMode m mm1)
                    (firstMode m mm2))))
        (not (transitionsRecognizableToUser m)))))

; =========================
; Constraint 7:
; Constr_NV_Memory_Option1_PerInstanceMemory
; NV Memory Access via PerInstanceMemory
; =========================
; Option 1 pattern: SWC defines in its InternalBehavior a PerInstanceMemory and a NvBlockNeeds
; referring to the PerInstanceMemory via a RoleBasedDataAssignment. In this case the NVRAM Block
; is exclusively accessed by this SWC and NvM, and nv data is encapsulated inside the SWC.

(assert
  (forall ((swc ATOMIC-SW-COMPONENT-TYPE))
    (=> (exists ((ib SWC-INTERNAL-BEHAVIOR)
                 (pim PER-INSTANCE-MEMORY)
                 (nv NVM-BLOCK-NEEDS)
                 (r ROLE-BASED-DATA-ASSIGNMENT))
          (and (internalBehaviorOfSwc swc ib)
               (hasPerInstanceMemory ib pim)
               (hasNvBlockNeeds ib nv)
               (roleBasedAssignment nv pim r)))
        (nvDataEncapsulatedInSwc swc)))

; Typing of PerInstanceMemory: either AutosarDataType (arTypedPerInstanceMemory) or C data type
(assert
  (forall ((pim PER-INSTANCE-MEMORY))
    (=> (exists ((t AUTOSAR-DATA-TYPE)) (typedWithAutosarDataType pim t))
        (not (exists ((c C-DATA-TYPE)) (typedWithCDataType pim c)))))

(assert
  (forall ((pim PER-INSTANCE-MEMORY))
    (=> (exists ((c C-DATA-TYPE)) (typedWithCDataType pim c))
        (not (exists ((t AUTOSAR-DATA-TYPE)) (typedWithAutosarDataType pim t)))))

