; SMT Template for TPS_SWCT_01502 – Precedence of the Unit of the input axis
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Sorts
(declare-sort SW-AXIS-INDIVIDUAL 0)
(declare-sort UNIT 0)
(declare-sort COMPU-METHOD 0)
(declare-sort APPLICATION-PRIMITIVE-DATA-TYPE 0)
(declare-sort AUTOSAR-VARIABLE 0)
(declare-sort SW-DATA-DEF-PROPS-CONTENT 0)

; Basic predicates / functions
(declare-fun has_unitRef (SW-AXIS-INDIVIDUAL) Bool)
(declare-fun unitRef (SW-AXIS-INDIVIDUAL) UNIT)

(declare-fun has_compuMethodRef (SW-AXIS-INDIVIDUAL) Bool)
(declare-fun compuMethodRef (SW-AXIS-INDIVIDUAL) COMPU-METHOD)

(declare-fun has_inputVariableTypeRef (SW-AXIS-INDIVIDUAL) Bool)
(declare-fun inputVariableTypeRef (SW-AXIS-INDIVIDUAL) APPLICATION-PRIMITIVE-DATA-TYPE)

(declare-fun has_swVariableRef (SW-AXIS-INDIVIDUAL AUTOSAR-VARIABLE) Bool)

; Downstream structure for precedence chain
(declare-fun has_swDataDefProps (APPLICATION-PRIMITIVE-DATA-TYPE SW-DATA-DEF-PROPS-CONTENT) Bool)
(declare-fun has_swDataDefProps_var (AUTOSAR-VARIABLE SW-DATA-DEF-PROPS-CONTENT) Bool)

(declare-fun has_unit_in_compuMethod (COMPU-METHOD) Bool)
(declare-fun unit_in_compuMethod (COMPU-METHOD) UNIT)

(declare-fun has_unit_in_swDataDefProps (SW-DATA-DEF-PROPS-CONTENT) Bool)
(declare-fun unit_in_swDataDefProps (SW-DATA-DEF-PROPS-CONTENT) UNIT)

; Semantic predicate: effective unit of the input axis
(declare-fun effectiveUnit (SW-AXIS-INDIVIDUAL) UNIT)
(declare-fun has_effectiveUnit (SW-AXIS-INDIVIDUAL) Bool)

; Axiom: precedence chain for effectiveUnit
(assert
  (forall ((x SW-AXIS-INDIVIDUAL))
    (=> (has_effectiveUnit x)
        (or
          ; 1) SwAxisIndividual.unit
          (and (has_unitRef x)
               (= (effectiveUnit x) (unitRef x)))

          ; 2) SwAxisIndividual.compuMethod.unit
          (and (not (has_unitRef x))
               (has_compuMethodRef x)
               (has_unit_in_compuMethod (compuMethodRef x))
               (= (effectiveUnit x)
                  (unit_in_compuMethod (compuMethodRef x))))

          ; 3) SwAxisIndividual.inputVariableType.swDataDefProps.unit
          (and (not (has_unitRef x))
               (not (has_compuMethodRef x))
               (has_inputVariableTypeRef x)
               (exists ((p APPLICATION-PRIMITIVE-DATA-TYPE)
                        (d SW-DATA-DEF-PROPS-CONTENT))
                 (and (= p (inputVariableTypeRef x))
                      (has_swDataDefProps p d)
                      (has_unit_in_swDataDefProps d)
                      (= (effectiveUnit x)
                         (unit_in_swDataDefProps d)))))

          ; 4) SwAxisIndividual.swVariableRef.autosarVariable.type.swDataDefProps.compuMethod.unit
          ; 5) SwAxisIndividual.swVariableRef.autosarVariable.type.swDataDefProps.unit
          (and (not (has_unitRef x))
               (not (has_compuMethodRef x))
               (not (has_inputVariableTypeRef x))
               (exists ((v AUTOSAR-VARIABLE)
                        (d SW-DATA-DEF-PROPS-CONTENT))
                 (and (has_swVariableRef x v)
                      (has_swDataDefProps_var v d)
                      (or
                        (and (has_unit_in_swDataDefProps d)
                             (= (effectiveUnit x)
                                (unit_in_swDataDefProps d)))
                        (exists ((cm COMPU-METHOD))
                          (and (has_unit_in_compuMethod cm)
                               (= (effectiveUnit x)
                                  (unit_in_compuMethod cm))))))))))))

