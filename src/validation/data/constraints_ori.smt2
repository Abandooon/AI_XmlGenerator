(assert
  (forall ((vp VARIATION-POINT-PROXY))
    (let ((idt (implDataTypeRef vp))
          (cat (category_IMPL-DATA-TYPE (implDataTypeRef vp))))
      (and
        (not (isDisallowedImplCategory cat))
        (isAllowedImplCategory cat)
        (=> (= cat "TYPE_REFERENCE")
            (resolvesToValueCategory idt))))))

