; =========================
; constr_1318 - Profile VSA_LINEAR for ImplementationDataType
; =========================

; If dynamicArraySizeProfile_impl(idt) = VSA_LINEAR, then:
; - There exists a VSA Payload element p:
;     category = ARRAY
;     no arraySizeSemantics, no arraySize, no arraySizeHandling
; - p immediately aggregates an inner element e:
;     arraySizeSemantics = variableSize
;     arraySize defined
;     arraySizeHandling = allIndicesSameArraySize

(assert
  (forall ((idt IMPLEMENTATION-DATA-TYPE))
    (=> (= (dynamicArraySizeProfile_impl idt) "VSA_LINEAR")
        (exists ((p IMPLEMENTATION-DATA-TYPE-ELEMENT)
                 (e IMPLEMENTATION-DATA-TYPE-ELEMENT))
          (and
            (hasSubElement idt p)
            (isVSAPayloadElement idt p)
            (= (category_impl p) "ARRAY")
            (not (hasArraySize p))
            (not (exists ((dummy String))
                   (= dummy (arraySizeSemantics_impl p))))
            (not (exists ((dummy2 String))
                   (= dummy2 (arraySizeHandling_impl p))))
            (hasInnerElement p e)
            (= (arraySizeSemantics_impl e) "variableSize")
            (hasArraySize e)
            (= (arraySizeHandling_impl e) "allIndicesSameArraySize"))))))


; =========================
