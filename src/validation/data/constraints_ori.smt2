; ------------------------------------------------------------
; 4) Constr_ComSpec_PortInterface_Typing
; 语义：特定 ComSpec 子类只能被与之对应类型的 PortInterface 所拥有。
; 由于缺少具体子类与接口类型映射，这里仅给出抽象谓词框架。

(declare-sort COM-SPEC 0)
(declare-sort PORT-PROTOTYPE 0)
(declare-sort PORT-INTERFACE 0)

; 所有权关系：某 PortPrototype 是否拥有某 ComSpec
(declare-fun ownsComSpec (PORT-PROTOTYPE COM-SPEC) Bool)
; PortPrototype 的 PortInterface 类型
(declare-fun portInterfaceOf (PORT-PROTOTYPE) PORT-INTERFACE)

; 抽象分类谓词：示例（实际子类需在具体模板中扩展）
(declare-fun isClientComSpec (COM-SPEC) Bool)
(declare-fun isServerComSpec (COM-SPEC) Bool)
(declare-fun isClientServerInterface (PORT-INTERFACE) Bool)
(declare-fun isSenderReceiverInterface (PORT-INTERFACE) Bool)

; 示例性约束：客户端/服务端 ComSpec 只能出现在 ClientServerInterface 上
(assert
  (forall ((p PORT-PROTOTYPE) (c COM-SPEC))
    (=> (and (ownsComSpec p c)
             (isClientComSpec c))
        (isClientServerInterface (portInterfaceOf p)))))

(assert
  (forall ((p PORT-PROTOTYPE) (c COM-SPEC))
    (=> (and (ownsComSpec p c)
             (isServerComSpec c))
        (isClientServerInterface (portInterfaceOf p)))))

; 其他 ComSpec 子类与接口类型的匹配可在扩展模板中继续添加。

