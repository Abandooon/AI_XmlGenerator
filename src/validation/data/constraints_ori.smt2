;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; TPS_SWCT_01061 - Conversion of units
; If a unit has to be converted according to the chosen country
; code the physicalDimension of both units shall be the same.
; If another unit shares the same UnitGroup with a category of
; EQUIV_UNITS it is preferred as target of the conversion.
;
; This is behavioral and refers to "chosen country code" and
; "conversion target selection" which are not directly observable
; in the static XML model. We therefore introduce abstract
; predicates and capture only the core logical relationships.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Sorts
(declare-sort UNIT 0)
(declare-sort UNIT-GROUP 0)
(declare-sort PHYSICAL-DIMENSION 0)
(declare-sort COUNTRY-CODE 0)

; Basic functions / predicates
(declare-fun unitGroupOf (UNIT) UNIT-GROUP)
(declare-fun physicalDimensionOf (UNIT) PHYSICAL-DIMENSION)

; Whether a unit conversion is requested for a given country code
(declare-fun conversionRequested (UNIT COUNTRY-CODE) Bool)

; The chosen conversion target unit for a given source unit and country code
(declare-fun conversionTarget (UNIT COUNTRY-CODE) UNIT)

; Category of a UnitGroup, e.g. "EQUIV_UNITS"
(declare-fun unitGroupCategory (UNIT-GROUP) String)

; Preference relation: whether a unit is preferred as conversion target
(declare-fun preferredTarget (UNIT UNIT COUNTRY-CODE) Bool)
; preferredTarget src tgt cc  == tgt is preferred target for src under cc

; Axiom 1:
; If a unit has to be converted according to the chosen country code
; then the physicalDimension of source and target shall be the same.
(assert
  (forall ((u UNIT) (cc COUNTRY-CODE))
    (=> (conversionRequested u cc)
        (= (physicalDimensionOf u)
           (physicalDimensionOf (conversionTarget u cc))))))

; Axiom 2 (informal preference rule):
; If another unit shares the same UnitGroup with category EQUIV_UNITS
; it is preferred as target of the conversion.
; We model this as: for any source u and candidate v, if they share
; a UnitGroup whose category is "EQUIV_UNITS", then v is preferred.
(assert
  (forall ((u UNIT) (v UNIT) (cc COUNTRY-CODE))
    (=> (and (= (unitGroupOf u) (unitGroupOf v))
             (= (unitGroupCategory (unitGroupOf u)) "EQUIV_UNITS"))
        (preferredTarget u v cc)))

