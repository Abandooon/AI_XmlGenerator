; 2) SMT 模板：NvBlockDescriptor.NvBlockNeeds 推荐性约束
; 所有约束均为 Info 级别（推荐），但在 SMT 中仍建模为逻辑公理

; Sort 声明
(declare-sort NV-BLOCK-DESCRIPTOR 0)
(declare-sort NV-BLOCK-NEEDS 0)
(declare-sort PORT-PROTOTYPE 0)

; 关系：每个 NvBlockDescriptor 关联一个 NvBlockNeeds
(declare-fun nvBlockNeedsOf (NV-BLOCK-DESCRIPTOR) NV-BLOCK-NEEDS)

; 关系：哪些 PortPrototypes 映射到给定的 NvBlockDescriptor
(declare-fun mappedPortPrototype (PORT-PROTOTYPE NV-BLOCK-DESCRIPTOR) Bool)

; NvBlockNeeds 属性谓词/函数
(declare-fun checkStaticBlockId (NV-BLOCK-NEEDS) Bool)
(declare-fun has_checkStaticBlockId (NV-BLOCK-NEEDS) Bool)

(declare-datatypes () ((RAM-BLOCK-STATUS-CONTROL-ENUM
  RAM-BLOCK-STATUS-CONTROL-NONE
  RAM-BLOCK-STATUS-CONTROL-API
  RAM-BLOCK-STATUS-CONTROL-OTHER)))
(declare-fun ramBlockStatusControl (NV-BLOCK-NEEDS) RAM-BLOCK-STATUS-CONTROL-ENUM)
(declare-fun has_ramBlockStatusControl (NV-BLOCK-NEEDS) Bool)

(declare-fun readonly (NV-BLOCK-NEEDS) Bool)
(declare-fun has_readonly (NV-BLOCK-NEEDS) Bool)

(declare-datatypes () ((NV-BLOCK-NEEDS-RELIABILITY-ENUM
  NV-REL-LOW
  NV-REL-MEDIUM
  NV-REL-HIGH)))
(declare-fun reliability (NV-BLOCK-NEEDS) NV-BLOCK-NEEDS-RELIABILITY-ENUM)
(declare-fun has_reliability (NV-BLOCK-NEEDS) Bool)

(declare-fun resistantToChangedSw (NV-BLOCK-NEEDS) Bool)
(declare-fun has_resistantToChangedSw (NV-BLOCK-NEEDS) Bool)

(declare-fun restoreAtStart (NV-BLOCK-NEEDS) Bool)
(declare-fun has_restoreAtStart (NV-BLOCK-NEEDS) Bool)

(declare-fun storeAtShutdown (NV-BLOCK-NEEDS) Bool)
(declare-fun has_storeAtShutdown (NV-BLOCK-NEEDS) Bool)

; PortPrototype 侧的“请求”谓词（抽象语义谓词，用于表达推荐逻辑）
(declare-fun requestsCheckStaticBlockId (PORT-PROTOTYPE) Bool)
(declare-fun requestsRamBlockStatusControlAPI (PORT-PROTOTYPE) Bool)
(declare-fun requestedReadonly (PORT-PROTOTYPE) Bool)
(declare-fun requestedReliability (PORT-PROTOTYPE) NV-BLOCK-NEEDS-RELIABILITY-ENUM)
(declare-fun requestsResistantToChangedSw (PORT-PROTOTYPE) Bool)
(declare-fun requestsRestoreAtStart (PORT-PROTOTYPE) Bool)
(declare-fun requestsStoreAtShutdown (PORT-PROTOTYPE) Bool)

; 辅助：reliability 的“<=”偏序（低 <= 中 <= 高）
(declare-fun rel_le (NV-BLOCK-NEEDS-RELIABILITY-ENUM NV-BLOCK-NEEDS-RELIABILITY-ENUM) Bool)
(assert (forall ((r NV-BLOCK-NEEDS-RELIABILITY-ENUM))
  (and (rel_le NV-REL-LOW r)
       (rel_le r NV-REL-HIGH))))
(assert (rel_le NV-REL-LOW NV-REL-MEDIUM))
(assert (rel_le NV-REL-MEDIUM NV-REL-HIGH))
(assert (rel_le NV-REL-LOW NV-REL-HIGH))
(assert (forall ((r NV-BLOCK-NEEDS-RELIABILITY-ENUM))
  (rel_le r r)))

; 约束 1：checkStaticBlockId 推荐为 true
; “if any of the nv data PortPrototypes requests a check of the static block ID”
(assert
  (forall ((d NV-BLOCK-DESCRIPTOR))
    (let ((n (nvBlockNeedsOf d)))
      (=> (exists ((p PORT-PROTOTYPE))
            (and (mappedPortPrototype p d)
                 (requestsCheckStaticBlockId p)))
          (and (has_checkStaticBlockId n)
               (checkStaticBlockId n))))))

; 约束 2：ramBlockStatusControl 推荐为启用 API
; “if any of the nv data PortPrototypes requests a use of the API for accessing the block”
(assert
  (forall ((d NV-BLOCK-DESCRIPTOR))
    (let ((n (nvBlockNeedsOf d)))
      (=> (exists ((p PORT-PROTOTYPE))
            (and (mappedPortPrototype p d)
                 (requestsRamBlockStatusControlAPI p)))
          (has_ramBlockStatusControl n)))))

; 约束 3：readonly 推荐与 PortPrototypes 请求一致
(assert
  (forall ((d NV-BLOCK-DESCRIPTOR))
    (let ((n (nvBlockNeedsOf d)))
      (=> (and (has_readonly n)
               (exists ((p PORT-PROTOTYPE)) (mappedPortPrototype p d)))
          (forall ((p PORT-PROTOTYPE))
            (=> (mappedPortPrototype p d)
                (= (readonly n) (requestedReadonly p))))))))

; 约束 4：reliability 推荐为所有映射 PortPrototypes 请求的最高等级
(assert
  (forall ((d NV-BLOCK-DESCRIPTOR))
    (let ((n (nvBlockNeedsOf d)))
      (=> (and (has_reliability n)
               (exists ((p PORT-PROTOTYPE)) (mappedPortPrototype p d)))
          (and
            ; 不低于任何一个请求
            (forall ((p PORT-PROTOTYPE))
              (=> (mappedPortPrototype p d)
                  (rel_le (requestedReliability p) (reliability n))))
            ; 不高于所有请求中的某个（即为某个请求值或更低，这里采用“存在等于”表达最高）
            (exists ((p PORT-PROTOTYPE))
              (and (mappedPortPrototype p d)
                   (= (reliability n) (requestedReliability p)))))))))

; 约束 5：resistantToChangedSw 推荐与 PortPrototypes 请求一致
(assert
  (forall ((d NV-BLOCK-DESCRIPTOR))
    (let ((n (nvBlockNeedsOf d)))
      (=> (and (has_resistantToChangedSw n)
               (exists ((p PORT-PROTOTYPE)) (mappedPortPrototype p d)))
          (forall ((p PORT-PROTOTYPE))
            (=> (mappedPortPrototype p d)
                (= (resistantToChangedSw n)
                   (requestsResistantToChangedSw p))))))))

; 约束 6：restoreAtStart 推荐与 PortPrototypes 请求一致
(assert
  (forall ((d NV-BLOCK-DESCRIPTOR))
    (let ((n (nvBlockNeedsOf d)))
      (=> (and (has_restoreAtStart n)
               (exists ((p PORT-PROTOTYPE)) (mappedPortPrototype p d)))
          (forall ((p PORT-PROTOTYPE))
            (=> (mappedPortPrototype p d)
                (= (restoreAtStart n)
                   (requestsRestoreAtStart p))))))))

; 约束 7：storeAtShutdown 推荐为 true
; “if any of the nv data PortPrototypes requests writing at shutdown”
(assert
  (forall ((d NV-BLOCK-DESCRIPTOR))
    (let ((n (nvBlockNeedsOf d)))
      (=> (exists ((p PORT-PROTOTYPE))
            (and (mappedPortPrototype p d)
                 (requestsStoreAtShutdown p)))
          (and (has_storeAtShutdown n)
               (storeAtShutdown n))))))

