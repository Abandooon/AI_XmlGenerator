  (forall ((s COMPU-SCALE))
    (=> (not (symbol_applicable s))
        (not (has_symbol s)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Constraint: Table_5_74_Annotation_8
; Mandatory/Enforced definition for CompuInternalToPhys (Table 5.74 Ann.8)
;
; For CompuMethod category SCALE_LINEAR_AND_TEXTTABLE:
;  - compuInternalToPhys is mandatory if CompuScale uses CompuConst
;  - compuInternalToPhys is enforced if CompuScale uses CompuRationalCoeffs
;
; We model “uses CompuConst / CompuRationalCoeffs” via has_compuConst /
; has_compuRationalCoeffs on some associated COMPU-SCALE.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Helper predicates: whether a method has a scale using CompuConst / RationalCoeffs
(declare-fun uses_ConstScale (COMPU-METHOD) Bool)
(declare-fun uses_RationalScale (COMPU-METHOD) Bool)

(assert
  (forall ((m COMPU-METHOD))
    (= (uses_ConstScale m)
       (exists ((s COMPU-SCALE) (c COMPU-CONST))
         (and (has_compuScale m s)
              (has_compuConst s c))))))

(assert
  (forall ((m COMPU-METHOD))
    (= (uses_RationalScale m)
       (exists ((s COMPU-SCALE) (r COMPU-RATIONAL-COEFFS))
         (and (has_compuScale m s)
              (has_compuRationalCoeffs s r))))))

; Core rule:
; If category = SCALE_LINEAR_AND_TEXTTABLE and method uses Const or Rational scale,
; then compuInternalToPhys must exist.
(assert
  (forall ((m COMPU-METHOD))
    (let ((isTargetCat (and (has_category_COMPU-METHOD m)
                            (= (category_COMPU-METHOD m) "SCALE_LINEAR_AND_TEXTTABLE"))))
      (=> (and isTargetCat
               (or (uses_ConstScale m)
                   (uses_RationalScale m)))
          (exists ((c COMPU))
            (has_compuInternalToPhys m c))))))

