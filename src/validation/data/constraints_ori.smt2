; -------------------------
; Logical constraints
; -------------------------

; TPS_SWCT_01586 – Writing strategies for nv data
; This paragraph is descriptive; we only encode that if a strategy flag is present,
; then the corresponding configuration elements must exist. Detailed timing and
; API-calling behavior is out of scope.

; Cyclic writing: if storeCyclic is configured true, a cyclicWritingPeriod must exist.
(assert
  (forall ((n NV-BLOCK-NEEDS))
    (=> (and (has_storeCyclic n) (storeCyclic n))
        (has_cyclicWritingPeriod n))))

; TPS_SWCT_01587 – cyclic writing requires a TimingEvent triggering a RunnableEntity
(assert
  (forall ((d NV-BLOCK-DESCRIPTOR))
    (let ((n (nvBlockNeeds d)))
      (=> (and (has_nvBlockNeeds d)
               (has_storeCyclic n)
               (storeCyclic n))
          (has_TimingEventForCyclicNvWrite d)))))

; TPS_SWCT_01588 – immediate storing requires DataReceivedEvent activating a RunnableEntity
(assert
  (forall ((d NV-BLOCK-DESCRIPTOR))
    (let ((n (nvBlockNeeds d))
          (r (dataReceivedRunnable d)))
      (=> (and (has_nvBlockNeeds d)
               (has_storeImmediate n)
               (storeImmediate n))
          (has_DataReceivedEventForImmediateNvWrite d)))))

; TPS_SWCT_01589 – storeEmergency implemented by Complex Driver
; This is largely implementation-specific; we only document that the flag itself
; does not guarantee semantics. No hard logical restriction is added.

; TPS_SWCT_01590 – combinations of strategies are allowed
; No mutual exclusion: we explicitly do NOT assert any exclusivity between
; storeCyclic, storeImmediate, storeEmergency, storeAtShutdown.

; TPS_SWCT_01591 – reportBehavior shall be ignored in SwcServiceDependency context
; If DiagnosticEventNeeds is used in the context of SwcServiceDependency,
; then reportBehavior, even if present, has no semantic effect.
(assert
  (forall ((s SWC-SERVICE-DEPENDENCY))
    (=> (has_diagnosticEventNeeds s)
        (let ((den (diagnosticEventNeeds s))
              )
          (= (reportBehaviorEffective den) false))))

; TPS_SWCT_01592 – communication among RunnableEntitys of different instances
; of the same AtomicSwComponentType is only supported via PortPrototypes.
(assert
  (forall ((r1 RUNNABLE-ENTITY) (r2 RUNNABLE-ENTITY))
    (let ((c1 (runnableOwner r1))
          (c2 (runnableOwner r2)))
      (=> (and (communicatesWith r1 r2)
               (not (= c1 c2)))
          (exists ((p PORT-PROTOTYPE))
            (and (has_portPrototype c1 p)
                 (has_portPrototype c2 p)
                 (communicationViaPortPrototype r1 r2 p))))))

