(declare-fun arrayLength (ARRAY-INSTANCE) Int)
(declare-fun lastArgumentValueAppliedToPrefix (RULE-BASED-VALUE-SPECIFICATION ARRAY-INSTANCE Int) Bool)

; ###############################################################
; Logical axioms
; ###############################################################

; TPS_SWCT_01598:
; If more than one user-defined transformer is used within one
; TRANSFORMATION-TECHNOLOGY, then each UserDefinedTransformationComSpecProps
; is assigned to the correct user-defined transformer.
; Here we encode: whenever a ComSpecProps exists for a transformer that is
; used in the chain, it is linked back to that transformer.
(assert
  (forall ((tt TRANSFORMATION-TECHNOLOGY)
           (t1 USER-DEFINED-TRANSFORMER)
           (t2 USER-DEFINED-TRANSFORMER)
           (p  USER-DEFINED-TRANSFORMATION-COM-SPEC-PROPS))
    (=> (and (not (= t1 t2))
             (usesUserDefinedTransformer tt t1)
             (usesUserDefinedTransformer tt t2)
             (hasUserDefinedTransformationComSpecProps tt p))
        ; p must be assigned to exactly one transformer in this chain.
        (and (exists ((t USER-DEFINED-TRANSFORMER))
               (and (usesUserDefinedTransformer tt t)
                    (comSpecPropsAssignedToTransformer p t)))
             (forall ((t USER-DEFINED-TRANSFORMER))
               (=> (comSpecPropsAssignedToTransformer p t)
                   (usesUserDefinedTransformer tt t))))))

; TPS_SWCT_01601:
; If a SW-C changes the number of valid elements in a variable size array,
; it shall update the Size Indicator in the ImplementationDataType.
(assert
  (forall ((swc SW-COMPONENT)
           (idt IMPLEMENTATION-DATA-TYPE)
           (arr ARRAY-INSTANCE))
    (=> (and (isVariableSizeArrayType idt)
             (writesArrayOfType swc idt arr)
             (changesNumberOfValidElements swc arr))
        (hasSizeIndicator idt)))

; TPS_SWCT_01602:
; If a SW-C receives a variable size array, it shall use the Size Indicator
; to determine the number of valid elements.
(assert
  (forall ((swc SW-COMPONENT)
           (idt IMPLEMENTATION-DATA-TYPE)
           (arr ARRAY-INSTANCE))
    (=> (and (isVariableSizeArrayType idt)
             (readsArrayOfType swc idt arr))
        (usesSizeIndicatorToDetermineValidElements swc arr)))

; TPS_SWCT_01604:
; ApplicationArrayDataType.dynamicArraySizeProfile and
; ApplicationArrayElement.arraySizeHandling shall be set.
(assert
  (forall ((adt APPLICATION-ARRAY-DATA-TYPE))
    (has_dynamicArraySizeProfile adt)))

(assert
  (forall ((ae APPLICATION-ARRAY-ELEMENT))
    (has_arraySizeHandling ae)))

; TPS_SWCT_01607:
; dynamicArraySizeProfile is one of the defined profiles when used
; for the structure of the mapped ImplementationDataType.
(assert
  (forall ((adt APPLICATION-ARRAY-DATA-TYPE))
    (or (= (dynamicArraySizeProfile adt) "VSA_LINEAR")
        (= (dynamicArraySizeProfile adt) "VSA_SQUARE")
        (= (dynamicArraySizeProfile adt) "VSA_RECTANGULAR")
        (= (dynamicArraySizeProfile adt) "VSA_FULLY_FLEXIBLE"))))

; TPS_SWCT_01608:
; Custom profiles can be added and shall have a company-specific prefix.
; Here we only document the intent; concrete prefix policy is project-specific.
; (No additional axiom beyond TPS_SWCT_01607; project may extend.)

; TPS_SWCT_01609:
; Rule FILL_UNTIL_MAX_SIZE semantics (schema-level approximation):
; If rule = "FILL_UNTIL_MAX_SIZE" and numArguments < arrayLength and
; numArguments < maxSizeToFill, then the last argument value is applied
; to all elements up to maxSizeToFill.
(assert
  (forall ((rbs RULE-BASED-VALUE-SPECIFICATION)
           (ra  RULE-ARGUMENTS)
           (arr ARRAY-INSTANCE))
    (=> (and (= (rule rbs) "FILL_UNTIL_MAX_SIZE")
             (argumentsOf rbs ra)
             (appliedToArray rbs arr)
             (< (numArguments ra) (arrayLength arr))
             (< (numArguments ra) (maxSizeToFill rbs)))
        (lastArgumentValueAppliedToPrefix rbs arr (maxSizeToFill rbs))))


