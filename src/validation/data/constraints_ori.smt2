    (=> (isTriggeredRunnable e r)
        (and (has_minimumStartInterval r)
             (= (minimumStartInterval r) 0)))))

;---------------------------------------------------------------
; constr_1259
; Aggregation of AsynchronousServerCallPoint and AsynchronousServerCallResultPoint
; "A RunnableEntity referenced by an InitEvent in the role startOnEvent may
;  aggregate an AsynchronousServerCallPoint but it shall not aggregate an
;  AsynchronousServerCallResultPoint."
;---------------------------------------------------------------
(assert
  (forall ((e INIT-EVENT) (r RUNNABLE-ENTITY))
    (=> (startOnEventRef e r)
        (not (aggregates_AsynchronousServerCallResultPoint r)))))

;---------------------------------------------------------------
; constr_1260
; No mode disabling for InitEvents
; "An InitEvent shall not have a reference to a ModeDeclaration in the role disabledMode."
;---------------------------------------------------------------
(assert
  (forall ((e INIT-EVENT) (m MODE-DECLARATION))
    (not (has_disabledModeRef e m))))

;---------------------------------------------------------------
; constr_1261
; Applicability for EndToEndDescription.dataIdNibbleOffset
; "EndToEndDescription.dataIdNibbleOffset shall be used only if
;  EndToEndDescription.dataIdMode is set to the value 3 and at the same time
;  EndToEndDescription.category is set to PROFILE_01."
;---------------------------------------------------------------
(assert
  (forall ((x END-TO-END-DESCRIPTION))
    (=> (has_dataIdNibbleOffset x)
        (and (has_dataIdMode x)
             (= (dataIdMode x) 3)
             (has_category_E2E x)
             ; category_E2E(x) = PROFILE_01
             ))))

;---------------------------------------------------------------
; constr_1263
; Existence of ModeErrorBehavior.defaultMode
; "The optional attribute ModeErrorBehavior.defaultMode shall exist if the
;  value of the attribute ModeErrorBehavior.errorReactionPolicy is set to defaultMode."
;---------------------------------------------------------------
(assert
  (forall ((m MODE-ERROR-BEHAVIOR))
    (=> (= (errorReactionPolicy m) ; MODE_ERROR_REACTION_POLICY_defaultMode
           (errorReactionPolicy m)) ; placeholder equality to the enum value
        (exists ((md MODE-DECLARATION))
          (has_defaultModeRef m md)))))

;---------------------------------------------------------------
; constr_1264
; Iteration along output axis is only supported for VALUE and VAL_BLK
; "swRecordLayoutVIndex in SwRecordLayoutV cannot be 0 for any value of
;  SwRecordLayoutV.category other than VALUE and VAL_BLK."
;---------------------------------------------------------------
(assert
  (forall ((x SW-RECORD-LAYOUT-V))
    (=> (and (has_swRecordLayoutVIndex x)
             (= (swRecordLayoutVIndex x) 0))
        (or (= (category_SwRLV x) (category_SwRLV x)) ; VALUE placeholder
            (= (category_SwRLV x) (category_SwRLV x)) ; VAL_BLK placeholder
            ))))

;---------------------------------------------------------------
; constr_1268
; ArgumentDataPrototype.direction shall be preserved in a ClientServerOperationMapping
; "Within the context of a ClientServerOperationMapping, the value of the argument
;  ArgumentDataPrototype.direction of two mapped ArgumentDataPrototype shall be identical."
