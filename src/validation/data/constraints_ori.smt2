(declare-sort SENDER-RECEIVER-INTERFACE 0)

; PortPrototype -> its owning SwComponentType
(declare-sort SW-COMPONENT-TYPE 0)
(declare-fun ownerComponentType (PORT-PROTOTYPE) SW-COMPONENT-TYPE)

; ServiceProxySwComponentType subset predicate on SW-COMPONENT-TYPE
(declare-fun isServiceProxyType (SW-COMPONENT-TYPE) Bool)

; PortPrototype -> its PortInterface
(declare-fun portInterface (PORT-PROTOTYPE) PORT-INTERFACE)

; PortInterface classification and attribute
(declare-fun isSenderReceiverInterface (PORT-INTERFACE) Bool)
(declare-fun isServicePortInterface (PORT-INTERFACE) Bool) ; corresponds to IS-SERVICE = true

; RPortPrototype subtype predicate
(declare-fun isRPort (PORT-PROTOTYPE) Bool)

; Core constraint:
; For any PortPrototype p whose owner is a ServiceProxySwComponentType:
;   either p is an RPortPrototype and its interface is SenderReceiverInterface
;   or its PortInterface has isService=true.
(assert
  (forall ((p PORT-PROTOTYPE))
    (let ((ct (ownerComponentType p))
          (pi (portInterface p)))
      (=> (isServiceProxyType ct)
          (or (and (isRPort p)
                   (isSenderReceiverInterface pi))
              (isServicePortInterface pi))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; constr_2018 - Supported remote communication of a ServiceProxySwComponentType
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; RPortPrototype already declared as PORT-PROTOTYPE with isRPort predicate.
; We add a predicate for "remote communication" and "1:n scenario".

(declare-fun isRemoteCommunicationPort (R-PORT-PROTOTYPE) Bool)
(declare-fun isOneToManyScenario (R-PORT-PROTOTYPE) Bool)
(declare-fun rPortInterface (R-PORT-PROTOTYPE) PORT-INTERFACE)

; SenderReceiverInterface classification for RPortPrototype
(declare-fun isSenderReceiverInterface_R (PORT-INTERFACE) Bool)

; Core constraint:
; For remote communication, ServiceProxySwComponentType can have only
; RPortPrototypes typed by SenderReceiverInterfaces in a 1:n scenario.
(assert
  (forall ((rp R-PORT-PROTOTYPE))
    (let ((ct (ownerComponentType rp))
          (pi (rPortInterface rp)))
      (=> (and (isServiceProxyType ct)
               (isRemoteCommunicationPort rp))
          (and (isSenderReceiverInterface_R pi)
               (isOneToManyScenario rp))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; constr_2019 - ServiceSwComponentType shall have service ports only
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(declare-sort SERVICE-SW-COMPONENT-TYPE 0)

; Predicate: a SW-COMPONENT-TYPE is a ServiceSwComponentType
(declare-fun isServiceSwComponentType (SW-COMPONENT-TYPE) Bool)

; Reuse ownerComponentType and portInterface, isServicePortInterface

; Core constraint:
; If a component type is ServiceSwComponentType, then all its ports
; must be typed by PortInterface with isService=true.
(assert
  (forall ((p PORT-PROTOTYPE))
    (let ((ct (ownerComponentType p))
          (pi (portInterface p)))
      (=> (isServiceSwComponentType ct)
          (isServicePortInterface pi)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; constr_2020 - dataReadAccess can not be used for queued communication
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(declare-sort VARIABLE-DATA-PROTOTYPE 0)
(declare-sort SW-DATA-DEF-PROPS 0)
(declare-sort RUNNABLE-ENTITY 0)
(declare-sort VARIABLE-ACCESS 0)

; VariableDataPrototype -> SW-DATA-DEF-PROPS
(declare-fun swDataDefProps (VARIABLE-DATA-PROTOTYPE) SW-DATA-DEF-PROPS)
(declare-fun has_swDataDefProps (VARIABLE-DATA-PROTOTYPE) Bool)

; swImplPolicy on SW-DATA-DEF-PROPS
(declare-datatypes () ((SwImplPolicy queued nonQueued otherPolicy)))
(declare-fun swImplPolicy (SW-DATA-DEF-PROPS) SwImplPolicy)

; RunnableEntity -> VariableAccess in role dataReadAccess
(declare-fun has_dataReadAccess (RUNNABLE-ENTITY VARIABLE-ACCESS) Bool)

; VariableAccess -> accessed VariableDataPrototype
(declare-fun accessedVariable (VARIABLE-ACCESS) VARIABLE-DATA-PROTOTYPE)

; Core constraint:
; For any VariableAccess va used as dataReadAccess, the swImplPolicy of the
; referenced VariableDataPrototype shall not be queued.
(assert
  (forall ((re RUNNABLE-ENTITY) (va VARIABLE-ACCESS))
    (=> (has_dataReadAccess re va)
        (let* ((v (accessedVariable va))
               (hasProps (has_swDataDefProps v)))
          (and hasProps
               (not (= (swImplPolicy (swDataDefProps v)) queued))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; constr_2021 - WaitPoint referencing a DataReceivedEvent can not be used for non-queued communication
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(declare-sort WAIT-POINT 0)
(declare-sort DATA-RECEIVED-EVENT 0)

; WaitPoint -> TRIGGER-REF (here: DataReceivedEvent)
(declare-fun triggerEvent (WAIT-POINT) DATA-RECEIVED-EVENT)
(declare-fun isDataReceivedEventTrigger (WAIT-POINT) Bool)

; DataReceivedEvent -> referenced VariableDataPrototype
(declare-fun dataEventVariable (DATA-RECEIVED-EVENT) VARIABLE-DATA-PROTOTYPE)

; Core constraint (iff):
; A WaitPoint referencing a DataReceivedEvent is permitted
; iff the swImplPolicy of the referenced VariableDataPrototype is queued.
(assert
  (forall ((wp WAIT-POINT))
    (let* ((isDataEv (isDataReceivedEventTrigger wp))
           (ev (triggerEvent wp))
           (v (dataEventVariable ev))
           (hasProps (has_swDataDefProps v)))
      (and
        (=> isDataEv
            (and hasProps
                 (= (swImplPolicy (swDataDefProps v)) queued)))
        (=> (and hasProps
                 (= (swImplPolicy (swDataDefProps v)) queued))
            isDataEv))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; constr_2022 - Mutually exclusive use of SynchronousServerCallPoints and AsynchronousServerCallPoints
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(declare-sort ASYNCHRONOUS-SERVER-CALL-POINT 0)
(declare-sort SYNCHRONOUS-SERVER-CALL-POINT 0)
(declare-sort CLIENT-SERVER-OPERATION 0)
(declare-sort R-PORT-PROTOTYPE-CS 0)

; Each call point references a ClientServerOperation of a particular RPortPrototype
(declare-fun asyncOperation (ASYNCHRONOUS-SERVER-CALL-POINT) CLIENT-SERVER-OPERATION)
(declare-fun asyncRPort (ASYNCHRONOUS-SERVER-CALL-POINT) R-PORT-PROTOTYPE-CS)

(declare-fun syncOperation (SYNCHRONOUS-SERVER-CALL-POINT) CLIENT-SERVER-OPERATION)
(declare-fun syncRPort (SYNCHRONOUS-SERVER-CALL-POINT) R-PORT-PROTOTYPE-CS)

; Core constraint:
; A ClientServerOperation of a particular RPortPrototype shall be mutually
; exclusive referenced by either SynchronousServerCallPoints or AsynchronousServerCallPoints.
(assert
  (forall ((op CLIENT-SERVER-OPERATION) (rp R-PORT-PROTOTYPE-CS))
    (let ((existsAsync
            (exists ((a ASYNCHRONOUS-SERVER-CALL-POINT))
              (and (= (asyncOperation a) op)
                   (= (asyncRPort a) rp))))
          (existsSync
            (exists ((s SYNCHRONOUS-SERVER-CALL-POINT))
              (and (= (syncOperation s) op)
                   (= (syncRPort s) rp)))))
      (not (and existsAsync existsSync)))))


