; =========================
; TPS_SWCT_02504
; Setup for Nvm Use Case: RAM Block with explicit synchronization using Mirror Interfaces
; =========================

; 1) RoleBasedPortAssignment:
; For every used ClientServerInterface provided by the Nvm it is necessary to create a RoleBasedPortAssignment
; and set ROLE to the name of the used ClientServerInterface.
; Here we capture that any ROLE used must be one of the allowed names, and that NvMMirror must be present at least once.

(assert
  (forall ((c ATOMIC-SW-COMPONENT-TYPE) (d SWC-SERVICE-DEPENDENCY) (r ROLE-BASED-PORT-ASSIGNMENT))
    (=> (and (has_swcServiceDependency c d)
             (has_assignedPort d r))
        (or (= (roleValue r) "NvMService")
            (= (roleValue r) "NvMNotifyJobFinished")
            (= (roleValue r) "NvMNotifyInitBlock")
            (= (roleValue r) "NvMAdmin")
            (= (roleValue r) "NvMMirror")))))

; At least one RoleBasedPortAssignment with ROLE = "NvMMirror" per AtomicSwComponentType that uses Nvm
(assert
  (forall ((c ATOMIC-SW-COMPONENT-TYPE))
    (=> (exists ((d SWC-SERVICE-DEPENDENCY))
          (has_swcServiceDependency c d))
        (exists ((d SWC-SERVICE-DEPENDENCY) (r ROLE-BASED-PORT-ASSIGNMENT))
          (and (has_swcServiceDependency c d)
               (has_assignedPort d r)
               (= (roleValue r) "NvMMirror"))))))

; 2) RoleBasedDataAssignment:
; If a RoleBasedDataAssignment exists, its USED-PARAMETER-ELEMENT must reference a ParameterDataPrototype
; aggregated by the enclosing SwcInternalBehavior in perInstanceParameter or sharedParameter.

(assert
  (forall ((c ATOMIC-SW-COMPONENT-TYPE)
           (d SWC-SERVICE-DEPENDENCY)
           (a ROLE-BASED-DATA-ASSIGNMENT)
           (ib SWC-INTERNAL-BEHAVIOR)
           (p PARAMETER-DATA-PROTOTYPE))
    (=> (and (has_swcServiceDependency c d)
             (has_assignedData d a)
             (has_internalBehavior c ib)
             (has_usedParameterElement a p))
        (or (has_perInstanceParameter ib p)
            (has_sharedParameter ib p)))))

; 3) RoleBasedDataTypeAssignment:
; USED-IMPLEMENTATION-DATA-TYPE-REF must resolve to IMPLEMENTATION-DATA-TYPE.
; This is structurally enforced via DEST in SHACL; here we only ensure that if such a ref exists,
; it is associated with some IMPLEMENTATION-DATA-TYPE instance (already captured by the sort).

(assert
  (forall ((s BSW-SERVICE-DEPENDENCY)
           (a ROLE-BASED-DATA-TYPE-ASSIGNMENT)
           (t IMPLEMENTATION-DATA-TYPE))
    (=> (and (has_assignedDataType s a)
             (has_usedImplementationDataTypeRef a t))
        true)))

; =========================
; TPS_SWCT_02505
; Setup for Function Inhibition Manager Service use Case: read function permission
; =========================

; RoleBasedPortAssignment valid roles: FunctionInhibition [1]
; Every ROLE used must be "FunctionInhibition" and at least one such assignment must exist.

(assert
  (forall ((c ATOMIC-SW-COMPONENT-TYPE) (d SWC-SERVICE-DEPENDENCY) (r ROLE-BASED-PORT-ASSIGNMENT))
    (=> (and (has_swcServiceDependency c d)
             (has_assignedPort d r))
        (= (roleValue r) "FunctionInhibition"))))

(assert
  (forall ((c ATOMIC-SW-COMPONENT-TYPE))
    (=> (exists ((d SWC-SERVICE-DEPENDENCY))
          (has_swcServiceDependency c d))
        (exists ((d SWC-SERVICE-DEPENDENCY) (r ROLE-BASED-PORT-ASSIGNMENT))
          (and (has_swcServiceDependency c d)
               (has_assignedPort d r)
               (= (roleValue r) "FunctionInhibition"))))))

; =========================
; TPS_SWCT_02506
; Setup for Dlt use Case: Application software component accesses the Synchronized Time-Base Manager
; =========================

; RoleBasedPortAssignment valid roles:
; DLTService [1], LogTraceSessionControl [1], VerboseModeControl [0..1], InjectionCallback [0..1]

(assert
  (forall ((c ATOMIC-SW-COMPONENT-TYPE) (d SWC-SERVICE-DEPENDENCY) (r ROLE-BASED-PORT-ASSIGNMENT))
    (=> (and (has_swcServiceDependency c d)
             (has_assignedPort d r))
        (or (= (roleValue r) "DLTService")
            (= (roleValue r) "LogTraceSessionControl")
            (= (roleValue r) "VerboseModeControl")
            (= (roleValue r) "InjectionCallback")))))

; At least one DLTService and one LogTraceSessionControl per component using this scenario
(assert
  (forall ((c ATOMIC-SW-COMPONENT-TYPE))
    (=> (exists ((d SWC-SERVICE-DEPENDENCY))
          (has_swcServiceDependency c d))
        (and
          (exists ((d SWC-SERVICE-DEPENDENCY) (r ROLE-BASED-PORT-ASSIGNMENT))
            (and (has_swcServiceDependency c d)
                 (has_assignedPort d r)
                 (= (roleValue r) "DLTService")))
          (exists ((d SWC-SERVICE-DEPENDENCY) (r ROLE-BASED-PORT-ASSIGNMENT))
            (and (has_swcServiceDependency c d)
                 (has_assignedPort d r)
                 (= (roleValue r) "LogTraceSessionControl")))))))

