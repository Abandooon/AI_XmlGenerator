;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Logical axioms for "iff" constraints
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;------------------------------
; constr_1047 - ApplicationPrimitiveDataType compatibility
;------------------------------

(assert
  (forall ((a1 APPLICATION-PRIMITIVE-DATA-TYPE)
           (a2 APPLICATION-PRIMITIVE-DATA-TYPE))
    (= (compatible_ApplicationPrimitive a1 a2)
       (or
        ; 1. same category + compatible SwDataDefProps (if present)
        (and
          (hasCategory_ApplicationPrimitive a1)
          (hasCategory_ApplicationPrimitive a2)
          (= (category_ApplicationPrimitive a1)
             (category_ApplicationPrimitive a2))
          (=> (and (hasSwDataDefProps_ApplicationPrimitive a1)
                   (hasSwDataDefProps_ApplicationPrimitive a2))
              (compatible_SwDataDefProps
                (swDataDefPropsOfApplicationPrimitive a1)
                (swDataDefPropsOfApplicationPrimitive a2))))
        ; 2. existence of a DataPrototypeMapping between DataPrototypes
        ; typed by a1 and a2 (either direction)
        (exists ((m DATA-PROTOTYPE-MAPPING)
                 (p1 DATA-PROTOTYPE)
                 (p2 DATA-PROTOTYPE))
          (and
            (= (firstDataPrototype m) p1)
            (= (secondDataPrototype m) p2)
            (typedBy_ApplicationPrimitive p1 a1)
            (typedBy_ApplicationPrimitive p2 a2)))
        ; 3. DataPrototypeMapping via ApplicationCompositeDataType with subElementRef
        ; (abstracted as existence of some mapping; details of subElementRef
        ; resolution are left to the mapping layer)
        (exists ((m DATA-PROTOTYPE-MAPPING)
                 (p1 DATA-PROTOTYPE)
                 (p2 DATA-PROTOTYPE)
                 (c APPLICATION-COMPOSITE-DATA-TYPE)
                 (s APPLICATION-COMPOSITE-DATA-TYPE-SUB-ELEMENT-REF))
          (and
            (= (firstDataPrototype m) p1)
            (= (secondDataPrototype m) p2)
            (typedBy_ApplicationPrimitive p2 a2)
            (typedBy_ApplicationComposite p1 c)
            ; s is a sub-element ref on the composite side; details abstracted
            (or (firstElement_AppComposite (as m SUB-ELEMENT-MAPPING) s)
                (secondElement_AppComposite (as m SUB-ELEMENT-MAPPING) s))))))))

;------------------------------
; constr_1048 - ApplicationRecordDataType compatibility
;------------------------------

(assert
  (forall ((r1 APPLICATION-RECORD-DATA-TYPE)
           (r2 APPLICATION-RECORD-DATA-TYPE))
    (= (compatible_ApplicationRecord r1 r2)
       (or
        ; 1. all elements at same record position are compatible
        (elementsCompatible_Record r1 r2)
        ; 2. existence of SubElementMappings between record elements
        (exists ((m SUB-ELEMENT-MAPPING))
          ; Details of firstElement/secondElement and their referenced
          ; ApplicationRecordElements are abstracted into elementsCompatible_Record
          true)))))

;------------------------------
; constr_1049 - ApplicationArrayDataType compatibility
;------------------------------

(assert
  (forall ((a1 APPLICATION-ARRAY-DATA-TYPE)
           (a2 APPLICATION-ARRAY-DATA-TYPE))
    (= (compatible_ApplicationArray a1 a2)
       (or
        ; 1. element type compatible + identical maxNumberOfElements and arraySizeSemantics (if present)
        (and
          (elementTypeCompatible_Array a1 a2)
          (let ((e1 (elementOfArray a1))
                (e2 (elementOfArray a2)))
            (and
              (=> (and (hasMaxNumberOfElements e1)
                       (hasMaxNumberOfElements e2))
                  (= (maxNumberOfElements e1)
                     (maxNumberOfElements e2)))
              (=> (and (hasArraySizeSemantics_Array e1)
                       (hasArraySizeSemantics_Array e2))
                  (= (arraySizeSemantics_Array e1)
                     (arraySizeSemantics_Array e2))))))
        ; 2. existence of SubElementMappings between array elements
        (exists ((m SUB-ELEMENT-MAPPING))
          true)))))

;------------------------------
; constr_1050 - ImplementationDataType compatibility
;------------------------------

(assert
  (forall ((i1 IMPLEMENTATION-DATA-TYPE)
           (i2 IMPLEMENTATION-DATA-TYPE))
    (= (compatible_Implementation i1 i2)
       (or
        ; 1. same category + identical structure + identical array attributes + compatible SwDataDefProps
        (and
          (hasCategory_Implementation i1)
          (hasCategory_Implementation i2)
          (= (category_Implementation i1)
             (category_Implementation i2))
          (sameStructure_Impl i1 i2)
          ; arraySize / arraySizeSemantics equality is subsumed by sameStructure_Impl,
          ; but we keep explicit guards for clarity
          (=> (and (hasSwDataDefProps_Implementation i1)
                   (hasSwDataDefProps_Implementation i2))
              (compatible_SwDataDefProps
                (swDataDefPropsOfImplementation i1)
                (swDataDefPropsOfImplementation i2))))
        ; 2. DataPrototypeMapping between DataPrototypes typed by i1 and i2
        (exists ((m DATA-PROTOTYPE-MAPPING)
                 (p1 DATA-PROTOTYPE)
                 (p2 DATA-PROTOTYPE))
          (and
            (= (firstDataPrototype m) p1)
            (= (secondDataPrototype m) p2)
            (typedBy_Implementation p1 i1)
            (typedBy_Implementation p2 i2)))
        ; 3. DataPrototypeMapping via ImplementationDataType with subElementRef
        (exists ((m DATA-PROTOTYPE-MAPPING)
                 (p1 DATA-PROTOTYPE)
                 (p2 DATA-PROTOTYPE)
                 (e IMPLEMENTATION-DATA-TYPE-ELEMENT)
                 (s IMPLEMENTATION-DATA-TYPE-SUB-ELEMENT-REF))
          (and
            (= (firstDataPrototype m) p1)
            (= (secondDataPrototype m) p2)
            (typedBy_Implementation p2 i2)
            (typedBy_Implementation p1 i1)
            (or (firstElement_Impl (as m SUB-ELEMENT-MAPPING) s)
                (secondElement_Impl (as m SUB-ELEMENT-MAPPING) s))))))))

;------------------------------
; constr_1051 - SwDataDefProps compatibility
;------------------------------

(assert
  (forall ((p1 SW-DATA-DEF-PROPS-CONTENT)
           (p2 SW-DATA-DEF-PROPS-CONTENT))
    (= (compatible_SwDataDefProps p1 p2)
       (and
        ; 1. Units compatible or both absent
        (or
          (and (hasUnitRef p1)
               (hasUnitRef p2)
               (compatible_Unit (unitRef p1) (unitRef p2)))
          (and (not (hasUnitRef p1))
               (not (hasUnitRef p2))))
        ; 2. CompuMethods compatible or both absent
        (or
          (and (hasCompuMethodRef p1)
               (hasCompuMethodRef p2)
               ; abstract: equality of ids stands for "compatible"
               (= (compuMethodRef p1) (compuMethodRef p2)))
          (and (not (hasCompuMethodRef p1))
               (not (hasCompuMethodRef p2))))
        ; 3. INVALID-VALUE compatibility via ValueSpecifications
        (or
          (and (hasInvalidValue p1)
               (hasInvalidValue p2)
               (compatible_ValueSpec (invalidValue p1) (invalidValue p2)))
          (and (not (hasInvalidValue p1))
               (not (hasInvalidValue p2))))
        ; 4. dataConstr compatible or both absent
        (or
          (and (hasDataConstrRef p1)
               (hasDataConstrRef p2)
               (= (dataConstrRef p1) (dataConstrRef p2)))
          (and (not (hasDataConstrRef p1))
               (not (hasDataConstrRef p2))))
        ; 5. swRecordLayout compatible or both absent
        (or
          (and (hasSwRecordLayoutRef p1)
               (hasSwRecordLayoutRef p2)
               (= (swRecordLayoutRef p1) (swRecordLayoutRef p2)))
          (and (not (hasSwRecordLayoutRef p1))
               (not (hasSwRecordLayoutRef p2))))))))

;------------------------------
; constr_1052 - Unit compatibility
;------------------------------

(assert
  (forall ((u1 UNIT)
           (u2 UNIT))
    (= (compatible_Unit u1 u2)
       (and
        ; 1. compatible factorSiToUnit and offsetSiToUnit
        (=> (and (hasFactorSiToUnit u1)
                 (hasFactorSiToUnit u2))
            (= (factorSiToUnit u1) (factorSiToUnit u2)))
        (=> (and (hasOffsetSiToUnit u1)
                 (hasOffsetSiToUnit u2))
            (= (offsetSiToUnit u1) (offsetSiToUnit u2)))
        ; 2. identical PhysicalDimension or both absent
        (or
          (and (hasPhysicalDimensionRef u1)
               (hasPhysicalDimensionRef u2)
               (= (physicalDimensionRef u1)
                  (physicalDimensionRef u2)))
          (and (not (hasPhysicalDimensionRef u1))
               (not (hasPhysicalDimensionRef u2))))))))

;------------------------------
; constr_1053 - PhysicalDimension compatibility
;------------------------------

(assert
  (forall ((d1 PHYSICAL-DIMENSION)
           (d2 PHYSICAL-DIMENSION))
    (= (compatible_PhysicalDimension d1 d2)
       (and
        ; identical exponents (if present on both sides)
        (=> (and (hasLengthExp d1) (hasLengthExp d2))
            (= (lengthExp d1) (lengthExp d2)))
        (=> (and (hasMassExp d1) (hasMassExp d2))
            (= (massExp d1) (massExp d2)))
        (=> (and (hasTimeExp d1) (hasTimeExp d2))
            (= (timeExp d1) (timeExp d2)))
        (=> (and (hasCurrentExp d1) (hasCurrentExp d2))
            (= (currentExp d1) (currentExp d2)))
        (=> (and (hasTemperatureExp d1) (hasTemperatureExp d2))
            (= (temperatureExp d1) (temperatureExp d2)))
        (=> (and (hasMolarAmountExp d1) (hasMolarAmountExp d2))
            (= (molarAmountExp d1) (molarAmountExp d2)))
        (=> (and (hasLuminousIntensityExp d1) (hasLuminousIntensityExp d2))
            (= (luminousIntensityExp d1) (luminousIntensityExp d2)))
        ; and either identical shortName or a PhysicalDimensionMapping exists
        (or
          (= (shortName_PhysicalDimension d1)
             (shortName_PhysicalDimension d2))
          (exists ((m PHYSICAL-DIMENSION-MAPPING))
            (or
              (and (= (firstPhysicalDimension m) d1)
                   (= (secondPhysicalDimension m) d2))
              (and (= (firstPhysicalDimension m) d2)
                   (= (secondPhysicalDimension m) d1)))))))))

; Note: no (check-sat) here; the validator will add it.


; 2) SMT 模板

; ========= Sort 声明 =========
(declare-sort DATA-CONSTR 0)
(declare-sort APPLICATION-DATA-TYPE 0)
(declare-sort APPLICATION-PRIMITIVE-DATA-TYPE 0)
(declare-sort APPLICATION-ARRAY-DATA-TYPE 0)
(declare-sort APPLICATION-RECORD-DATA-TYPE 0)
(declare-sort IMPLEMENTATION-DATA-TYPE 0)
(declare-sort SW-BASE-TYPE 0)
(declare-sort SW-DATA-DEF-PROPS 0)
(declare-sort SW-DATA-DEF-PROPS-CONTENT 0)
(declare-sort SW-POINTER-TARGET-PROPS 0)
(declare-sort BSW-MODULE-ENTRY 0)
(declare-sort COMPU-METHOD 0)
(declare-sort IMPLEMENTATION-DATA-TYPE-ELEMENT 0)

; ========= 基本谓词/函数（由模板统一提供，这里只声明签名） =========

; 存在性/关联谓词
(declare-fun has_dataConstr (APPLICATION-DATA-TYPE) Bool)
(declare-fun has_providerDataConstr (APPLICATION-DATA-TYPE) Bool)
(declare-fun has_receiverDataConstr (APPLICATION-DATA-TYPE) Bool)

(declare-fun has_swDataDefProps (APPLICATION-DATA-TYPE) Bool)
(declare-fun swDataDefPropsOf (APPLICATION-DATA-TYPE) SW-DATA-DEF-PROPS)

(declare-fun has_swDataDefProps_impl (IMPLEMENTATION-DATA-TYPE) Bool)
(declare-fun swDataDefPropsOf_impl (IMPLEMENTATION-DATA-TYPE) SW-DATA-DEF-PROPS)

(declare-fun has_content (SW-DATA-DEF-PROPS) Bool)
(declare-fun contentOf (SW-DATA-DEF-PROPS) SW-DATA-DEF-PROPS-CONTENT)

(declare-fun has_baseTypeRef (SW-DATA-DEF-PROPS-CONTENT) Bool)
(declare-fun baseTypeRefOf (SW-DATA-DEF-PROPS-CONTENT) SW-BASE-TYPE)

(declare-fun has_implDataTypeRef (SW-DATA-DEF-PROPS-CONTENT) Bool)
(declare-fun implDataTypeRefOf (SW-DATA-DEF-PROPS-CONTENT) IMPLEMENTATION-DATA-TYPE)

(declare-fun has_swPointerTargetProps (SW-DATA-DEF-PROPS-CONTENT) Bool)
(declare-fun swPointerTargetPropsOf (SW-DATA-DEF-PROPS-CONTENT) SW-POINTER-TARGET-PROPS)

(declare-fun has_functionPointerSignatureRef (SW-POINTER-TARGET-PROPS) Bool)
(declare-fun functionPointerSignatureRefOf (SW-POINTER-TARGET-PROPS) BSW-MODULE-ENTRY)

(declare-fun has_category_app (APPLICATION-DATA-TYPE) Bool)
(declare-fun category_app (APPLICATION-DATA-TYPE) String)

(declare-fun has_category_impl (IMPLEMENTATION-DATA-TYPE) Bool)
(declare-fun category_impl (IMPLEMENTATION-DATA-TYPE) String)

(declare-fun has_targetCategory (SW-POINTER-TARGET-PROPS) Bool)
(declare-fun targetCategoryOf (SW-POINTER-TARGET-PROPS) String)

(declare-fun has_dynamicArraySizeProfile (IMPLEMENTATION-DATA-TYPE) Bool)
(declare-fun dynamicArraySizeProfileOf (IMPLEMENTATION-DATA-TYPE) String)

(declare-fun has_subElement (IMPLEMENTATION-DATA-TYPE) Bool)
(declare-fun subElementOf (IMPLEMENTATION-DATA-TYPE) IMPLEMENTATION-DATA-TYPE-ELEMENT)

; DataConstr / CompuMethod / SwBaseType 相关辅助谓词
(declare-fun dataConstrOf (APPLICATION-DATA-TYPE) DATA-CONSTR)
(declare-fun compuMethodOf (APPLICATION-DATA-TYPE) COMPU-METHOD)
(declare-fun baseTypeOf (IMPLEMENTATION-DATA-TYPE) SW-BASE-TYPE)

; 数值范围与函数签名抽象谓词
(declare-fun coversRange (SW-BASE-TYPE DATA-CONSTR) Bool)
(declare-fun coversCompuMethodRange (SW-BASE-TYPE COMPU-METHOD) Bool)
(declare-fun sameFunctionSignature (BSW-MODULE-ENTRY BSW-MODULE-ENTRY) Bool)

; 兼容性抽象谓词
(declare-fun compatibleImplTypes (IMPLEMENTATION-DATA-TYPE IMPLEMENTATION-DATA-TYPE) Bool)
(declare-fun compatibleDataRefProps (SW-POINTER-TARGET-PROPS SW-POINTER-TARGET-PROPS) Bool)
(declare-fun compatibleArrayMapping (APPLICATION-DATA-TYPE IMPLEMENTATION-DATA-TYPE) Bool)

; provider/receiver 关系抽象（用于 constr_1054）
(declare-fun providerOf (APPLICATION-DATA-TYPE) APPLICATION-DATA-TYPE)
(declare-fun receiverOf (APPLICATION-DATA-TYPE) APPLICATION-DATA-TYPE)
(declare-fun has_providerConstraints (APPLICATION-DATA-TYPE) Bool)
(declare-fun has_receiverConstraints (APPLICATION-DATA-TYPE) Bool)

; ========= 逻辑公理 =========

; --- constr_1054: No DataConstr available at the provider ---
; If the provider defines no constraints it is only compatible with a receiver
; which also defines no constraints at all.
(assert
  (forall ((a APPLICATION-DATA-TYPE))
    (let ((p (providerOf a))
          (r (receiverOf a)))
      (=> (not (has_providerConstraints p))
          (not (has_receiverConstraints r))))))

; --- constr_1055: ImplementationDataType has category VALUE ---
; The attributes baseType shall refer to a compatible SwBaseType.
; 这里仅建模“BASE-TYPE-REF 的 DEST 为 SW-BASE-TYPE”已经由 mapping/解析保证，
; 逻辑层增加“兼容性”抽象谓词，可在扩展模板中细化。
(assert
  (forall ((idt IMPLEMENTATION-DATA-TYPE))
    (=> (and (has_swDataDefProps_impl idt)
             (has_content (swDataDefPropsOf_impl idt))
             (has_baseTypeRef (contentOf (swDataDefPropsOf_impl idt))))
        ; 兼容性条件：可在后续模板中细化为 coversRange/coversCompuMethodRange 等
        true)))

; --- constr_1056: ImplementationDataType has category TYPE_REFERENCE ---
; The ImplementationDataTypes referenced by SwDataDefProps.implementationDataType shall be compatible.
(assert
  (forall ((s SW-DATA-DEF-PROPS-CONTENT))
    (=> (has_implDataTypeRef s)
        (let ((idt (implDataTypeRefOf s)))
          ; 所有通过 implementationDataTypeRef 关联的 ImplementationDataType 之间兼容
          ; 这里使用抽象谓词 compatibleImplTypes
          (forall ((idt2 IMPLEMENTATION-DATA-TYPE))
            (=> (exists ((s2 SW-DATA-DEF-PROPS-CONTENT))
                  (and (has_implDataTypeRef s2)
                       (= (implDataTypeRefOf s2) idt2)))
                (compatibleImplTypes idt idt2))))))

; --- constr_1057: ImplementationDataType has category DATA_REFERENCE ---
; SwDataDefProps.swPointerTargetProps shall have identical targetCategory
; and shall refer to SwDataDefProps where all attributes are identical.
(assert
  (forall ((p1 SW-POINTER-TARGET-PROPS) (p2 SW-POINTER-TARGET-PROPS))
    (=> (and (has_targetCategory p1)
             (has_targetCategory p2)
             (= (targetCategoryOf p1) (targetCategoryOf p2)))
        (compatibleDataRefProps p1 p2)))

)

; --- constr_1058: ImplementationDataType has category FUNCTION_REFERENCE ---
; swPointerTargetProps.functionPointerSignature shall refer to BswModuleEntrys
; which each resolve to the same function signature.
(assert
  (forall ((p SW-POINTER-TARGET-PROPS))
    (=> (has_functionPointerSignatureRef p)
        (let ((e1 (functionPointerSignatureRefOf p)))
          (forall ((e2 BSW-MODULE-ENTRY))
            (=> (exists ((p2 SW-POINTER-TARGET-PROPS))
                  (and (has_functionPointerSignatureRef p2)
                       (= (functionPointerSignatureRefOf p2) e2)))
                (sameFunctionSignature e1 e2))))))

; --- constr_1059: Compatibility of data types with category VALUE ---
; ApplicationDataType(category=VALUE) <-> ImplementationDataType(category=VALUE)
; ImplementationDataType.baseType shall be able to express all numerical values
; required by ApplicationDataType.swDataDefProps.dataConstr / CompuMethod.
(assert
  (forall ((adt APPLICATION-DATA-TYPE) (idt IMPLEMENTATION-DATA-TYPE))
    (=> (and (has_category_app adt)
             (= (category_app adt) "VALUE")
             (has_category_impl idt)
             (= (category_impl idt) "VALUE")
             (has_swDataDefProps adt)
             (has_dataConstr adt)
             (has_swDataDefProps_impl idt))
        (let ((dc (dataConstrOf adt))
              (cm (compuMethodOf adt))
              (bt (baseTypeOf idt)))
          (or (coversRange bt dc)
              (coversCompuMethodRange bt cm))))))

; --- constr_1060: Compatibility of data types with category ARRAY, VAL_BLK ---
; ApplicationDataType(category in {ARRAY, VAL_BLK}) can only be mapped to
; ImplementationDataType of category ARRAY or Variable-Size Array Data Type.
; And array size, arraySizeSemantics, element type must allow 1:1 mapping.
(assert
  (forall ((adt APPLICATION-DATA-TYPE) (idt IMPLEMENTATION-DATA-TYPE))
    (=> (and (has_category_app adt)
             (or (= (category_app adt) "ARRAY")
                 (= (category_app adt) "VAL_BLK")))
        (=> (and (has_category_impl idt)
                 (or (= (category_impl idt) "ARRAY")
                     ; Variable-Size Array Data Type 通过 dynamicArraySizeProfile 等特征识别
                     (has_dynamicArraySizeProfile idt)))
            (compatibleArrayMapping adt idt))))

; 末尾不写 (check-sat)


; ================================================================
; SMT template for AUTOSAR data type and port/interface compatibility
; Covers:
;   constr_1061, constr_1063, constr_1064, constr_1066,
;   constr_1068, constr_1069, constr_1070
; ================================================================

;-----------------------------
; Sort declarations
;-----------------------------

(declare-sort APPLICATION-DATA-TYPE 0)
(declare-sort IMPLEMENTATION-DATA-TYPE 0)
(declare-sort AUTOSAR-DATA-TYPE 0)

(declare-sort APPLICATION-PRIMITIVE-DATA-TYPE 0)
(declare-sort AUTOSAR-DATA-PROTOTYPE 0)
(declare-sort DATA-PROTOTYPE 0)
(declare-sort DATA-PROTOTYPE-MAPPING 0)

(declare-sort PORT-PROTOTYPE 0)
(declare-sort PORT-INTERFACE 0)
(declare-sort DATA-INTERFACE 0)
(declare-sort ASSEMBLY-SW-CONNECTOR 0)
(declare-sort DELEGATION-SW-CONNECTOR 0)
(declare-sort VARIABLE-AND-PARAMETER-INTERFACE-MAPPING 0)

;-----------------------------
; Basic attribute / relation predicates
;-----------------------------

; Categories
(declare-fun category_ApplicationDataType (APPLICATION-DATA-TYPE) String)
(declare-fun category_ImplementationDataType (IMPLEMENTATION-DATA-TYPE) String)
(declare-fun category_ApplicationPrimitiveDataType (APPLICATION-PRIMITIVE-DATA-TYPE) String)

; Short names
(declare-fun shortName_ApplicationPrimitiveDataType (APPLICATION-PRIMITIVE-DATA-TYPE) String)
(declare-fun shortName_PortPrototype (PORT-PROTOTYPE) String)
(declare-fun shortName_DataInterface (DATA-INTERFACE) String)

; Mapping relations between ApplicationDataType and ImplementationDataType
; (abstract relation capturing "mapped/connected to")
(declare-fun mappedTo (APPLICATION-DATA-TYPE IMPLEMENTATION-DATA-TYPE) Bool)

;-----------------------------
; constr_1061 – STRUCTURE compatibility
;-----------------------------
; An ApplicationDataType of category STRUCTURE can only be mapped/connected
; to an ImplementationDataType of category STRUCTURE.

(assert
  (forall ((a APPLICATION-DATA-TYPE) (i IMPLEMENTATION-DATA-TYPE))
    (=> (and (mappedTo a i)
             (= (category_ApplicationDataType a) "STRUCTURE"))
        (= (category_ImplementationDataType i) "STRUCTURE"))))

;-----------------------------
; constr_1063 – BOOLEAN to VALUE
;-----------------------------
; An ApplicationDataType of category BOOLEAN can only be mapped/connected
; to an ImplementationDataType of category VALUE.

(assert
  (forall ((a APPLICATION-DATA-TYPE) (i IMPLEMENTATION-DATA-TYPE))
    (=> (and (mappedTo a i)
             (= (category_ApplicationDataType a) "BOOLEAN"))
        (= (category_ImplementationDataType i) "VALUE"))))

;-----------------------------
; constr_1064 – COM_AXIS / RES_AXIS / CURVE / MAP / CUBOID / CUBE_4 / CUBE_5
;-----------------------------
; These ApplicationDataTypes can only be mapped/connected to ImplementationDataType
; of category STRUCTURE or ARRAY.

(define-fun appCategory_IsAxisOrCurve ( (c String) ) Bool
  (or (= c "COM_AXIS")
      (= c "RES_AXIS")
      (= c "CURVE")
      (= c "MAP")
      (= c "CUBOID")
      (= c "CUBE_4")
      (= c "CUBE_5")))

(assert
  (forall ((a APPLICATION-DATA-TYPE) (i IMPLEMENTATION-DATA-TYPE))
    (=> (and (mappedTo a i)
             (appCategory_IsAxisOrCurve (category_ApplicationDataType a)))
        (or (= (category_ImplementationDataType i) "STRUCTURE")
            (= (category_ImplementationDataType i) "ARRAY")))))

;-----------------------------
; constr_1066 – Forbidden mappings to ImplementationDataType
;-----------------------------
; An ApplicationDataType shall never be mapped to an ImplementationDataType
; of category UNION, DATA_REFERENCE, or FUNCTION_REFERENCE.

(define-fun implCategory_Forbidden ( (c String) ) Bool
  (or (= c "UNION")
      (= c "DATA_REFERENCE")
      (= c "FUNCTION_REFERENCE")))

(assert
  (forall ((a APPLICATION-DATA-TYPE) (i IMPLEMENTATION-DATA-TYPE))
    (=> (mappedTo a i)
        (not (implCategory_Forbidden (category_ImplementationDataType i))))))

;-----------------------------
; constr_1068 – Compatibility of Variable/ParameterDataPrototypes
; typed by primitive data types
;-----------------------------
; We introduce abstract predicates to capture compatibility and typing.
; The iff in the text is modeled via equality of Booleans.

; DataPrototype typing
(declare-fun typeOf (AUTOSAR-DATA-PROTOTYPE) AUTOSAR-DATA-TYPE)

; Category of underlying AutosarDataType (primitive/value/bool/string etc.)
(declare-fun category_AutosarDataType (AUTOSAR-DATA-TYPE) String)

; swImplPolicy attribute on DataPrototype
(declare-fun swImplPolicy (AUTOSAR-DATA-PROTOTYPE) String)
(define-fun isQueued ( (p AUTOSAR-DATA-PROTOTYPE) ) Bool
  (= (swImplPolicy p) "QUEUED"))

; Predicate: two AutosarDataTypes are compatible (primitive/value/bool/string case)
(declare-fun compatibleAutosarDataTypes (AUTOSAR-DATA-TYPE AUTOSAR-DATA-TYPE) Bool)

; Predicate: two DataPrototypes are compatible in the sense of constr_1068
(declare-fun compatibleDataPrototypes (AUTOSAR-DATA-PROTOTYPE AUTOSAR-DATA-PROTOTYPE) Bool)

; Helper: sameShortName for DataPrototypes (abstracted)
(declare-fun shortName_DataPrototype (AUTOSAR-DATA-PROTOTYPE) String)

; DataPrototypeMapping roles
(declare-fun firstDataPrototype (DATA-PROTOTYPE-MAPPING) AUTOSAR-DATA-PROTOTYPE)
(declare-fun secondDataPrototype (DATA-PROTOTYPE-MAPPING) AUTOSAR-DATA-PROTOTYPE)

; Condition 1: direct compatibility via same shortName, compatible types, and swImplPolicy
(define-fun cond1_constr1068 ((p1 AUTOSAR-DATA-PROTOTYPE) (p2 AUTOSAR-DATA-PROTOTYPE)) Bool
  (and (compatibleAutosarDataTypes (typeOf p1) (typeOf p2))
       (= (shortName_DataPrototype p1) (shortName_DataPrototype p2))
       (= (isQueued p1) (isQueued p2))))

; Condition 2: existence of a DataPrototypeMapping relating the two
(declare-fun mappingRelates (DATA-PROTOTYPE-MAPPING AUTOSAR-DATA-PROTOTYPE AUTOSAR-DATA-PROTOTYPE) Bool)

(assert
  (forall ((m DATA-PROTOTYPE-MAPPING) (p1 AUTOSAR-DATA-PROTOTYPE) (p2 AUTOSAR-DATA-PROTOTYPE))
    (= (mappingRelates m p1 p2)
       (or (and (= (firstDataPrototype m) p1)
                (= (secondDataPrototype m) p2))
           (and (= (firstDataPrototype m) p2)
                (= (secondDataPrototype m) p1))))))

(define-fun cond2_constr1068 ((p1 AUTOSAR-DATA-PROTOTYPE) (p2 AUTOSAR-DATA-PROTOTYPE)) Bool
  (exists ((m DATA-PROTOTYPE-MAPPING))
    (mappingRelates m p1 p2)))

; Iff: compatibleDataPrototypes <=> (cond1 or cond2)
(assert
  (forall ((p1 AUTOSAR-DATA-PROTOTYPE) (p2 AUTOSAR-DATA-PROTOTYPE))
    (= (compatibleDataPrototypes p1 p2)
       (or (cond1_constr1068 p1 p2)
           (cond2_constr1068 p1 p2)))))

;-----------------------------
; constr_1069 – Compatibility of PortPrototypes (AssemblySwConnector)
;-----------------------------
; We abstract the "PortPrototypes of different DataInterfaces" and reuse
; compatibleDataPrototypes from constr_1068.

; Ports and their interfaces
(declare-fun interfaceOf (PORT-PROTOTYPE) PORT-INTERFACE)
(declare-fun isService (PORT-INTERFACE) Bool)

; DataPrototypes defined in a PortInterface
(declare-fun inInterface (AUTOSAR-DATA-PROTOTYPE PORT-INTERFACE) Bool)

; SwConnector mapping reference
(declare-fun mappingOf_Assembly (ASSEMBLY-SW-CONNECTOR) VARIABLE-AND-PARAMETER-INTERFACE-MAPPING)

; VariableAndParameterInterfaceMapping to DataPrototypeMappings
(declare-fun hasDataMapping (VARIABLE-AND-PARAMETER-INTERFACE-MAPPING DATA-PROTOTYPE-MAPPING) Bool)

; SwConnector endpoints (required/provided PortPrototypes)
(declare-fun requiredPort (ASSEMBLY-SW-CONNECTOR) PORT-PROTOTYPE)
(declare-fun providedPort (ASSEMBLY-SW-CONNECTOR) PORT-PROTOTYPE)

; Predicate: portsCompatible_Assembly – main subject of constr_1069
(declare-fun portsCompatible_Assembly (ASSEMBLY-SW-CONNECTOR) Bool)

; Condition 1(a): for each DP in required interface, there exists compatible DP in provided interface
(define-fun cond1a_constr1069 ((c ASSEMBLY-SW-CONNECTOR)) Bool
  (forall ((p1 AUTOSAR-DATA-PROTOTYPE))
    (=> (inInterface p1 (interfaceOf (requiredPort c)))
        (exists ((p2 AUTOSAR-DATA-PROTOTYPE))
          (and (inInterface p2 (interfaceOf (providedPort c)))
               (compatibleDataPrototypes p1 p2)
               (= (shortName_DataPrototype p1) (shortName_DataPrototype p2)))))))

; Condition 1(b): existence of VariableAndParameterInterfaceMapping.dataMapping relating pairs
(define-fun cond1b_constr1069 ((c ASSEMBLY-SW-CONNECTOR)) Bool
  (let ((m (mappingOf_Assembly c)))
    (exists ((d DATA-PROTOTYPE-MAPPING))
      (and (hasDataMapping m d)
           (compatibleDataPrototypes (firstDataPrototype d) (secondDataPrototype d))))))

; Condition 2: for each such pair, isService attributes identical
; We abstract "such pair" by requiring that whenever two DPs are considered
; compatible across the two interfaces, the isService flags of their interfaces match.
(define-fun cond2_constr1069 ((c ASSEMBLY-SW-CONNECTOR)) Bool
  (forall ((p1 AUTOSAR-DATA-PROTOTYPE) (p2 AUTOSAR-DATA-PROTOTYPE))
    (=> (and (inInterface p1 (interfaceOf (requiredPort c)))
             (inInterface p2 (interfaceOf (providedPort c)))
             (compatibleDataPrototypes p1 p2))
        (= (isService (interfaceOf (requiredPort c)))
           (isService (interfaceOf (providedPort c)))))))

; Iff: portsCompatible_Assembly <=> ((1a or 1b) and 2)
(assert
  (forall ((c ASSEMBLY-SW-CONNECTOR))
    (= (portsCompatible_Assembly c)
       (and (or (cond1a_constr1069 c)
                (cond1b_constr1069 c))
            (cond2_constr1069 c)))))

;-----------------------------
; constr_1070 – Compatibility of PortPrototypes (DelegationSwConnector)
;-----------------------------
; Similar abstraction for DelegationSwConnector.

(declare-fun innerRequiredPort (DELEGATION-SW-CONNECTOR) PORT-PROTOTYPE)
(declare-fun outerRequiredPort (DELEGATION-SW-CONNECTOR) PORT-PROTOTYPE)
(declare-fun innerProvidedPort (DELEGATION-SW-CONNECTOR) PORT-PROTOTYPE)
(declare-fun outerProvidedPort (DELEGATION-SW-CONNECTOR) PORT-PROTOTYPE)

(declare-fun mappingOf_Delegation (DELEGATION-SW-CONNECTOR) VARIABLE-AND-PARAMETER-INTERFACE-MAPPING)

; Predicate: portsCompatible_Delegation – main subject of constr_1070
(declare-fun portsCompatible_Delegation (DELEGATION-SW-CONNECTOR) Bool)

; 1(a): for each DP in required inner interface, exists compatible DP in required outer interface
(define-fun cond1a_constr1070 ((c DELEGATION-SW-CONNECTOR)) Bool
  (forall ((p1 AUTOSAR-DATA-PROTOTYPE))
    (=> (inInterface p1 (interfaceOf (innerRequiredPort c)))
        (exists ((p2 AUTOSAR-DATA-PROTOTYPE))
          (and (inInterface p2 (interfaceOf (outerRequiredPort c)))
               (compatibleDataPrototypes p1 p2)
               (= (shortName_DataPrototype p1) (shortName_DataPrototype p2)))))))

; 1(b): mapping-based condition
(define-fun cond1b_constr1070 ((c DELEGATION-SW-CONNECTOR)) Bool
  (let ((m (mappingOf_Delegation c)))
    (exists ((d DATA-PROTOTYPE-MAPPING))
      (and (hasDataMapping m d)
           (compatibleDataPrototypes (firstDataPrototype d) (secondDataPrototype d))))))

; 2(a): at least one DP in provided inner interface has compatible DP in provided outer interface
(define-fun cond2a_constr1070 ((c DELEGATION-SW-CONNECTOR)) Bool
  (exists ((p1 AUTOSAR-DATA-PROTOTYPE))
    (and (inInterface p1 (interfaceOf (innerProvidedPort c)))
         (exists ((p2 AUTOSAR-DATA-PROTOTYPE))
           (and (inInterface p2 (interfaceOf (outerProvidedPort c)))
                (compatibleDataPrototypes p1 p2)
                (= (shortName_DataPrototype p1) (shortName_DataPrototype p2)))))))

; 2(b): mapping-based condition for provided side
(define-fun cond2b_constr1070 ((c DELEGATION-SW-CONNECTOR)) Bool
  (let ((m (mappingOf_Delegation c)))
    (exists ((d DATA-PROTOTYPE-MAPPING))
      (and (hasDataMapping m d)
           (compatibleDataPrototypes (firstDataPrototype d) (secondDataPrototype d))))))

; 3: for each such pair, isService attributes identical
(define-fun cond3_constr1070 ((c DELEGATION-SW-CONNECTOR)) Bool
  (forall ((p1 AUTOSAR-DATA-PROTOTYPE) (p2 AUTOSAR-DATA-PROTOTYPE))
    (=> (and (or (and (inInterface p1 (interfaceOf (innerRequiredPort c)))
                      (inInterface p2 (interfaceOf (outerRequiredPort c))))
                 (and (inInterface p1 (interfaceOf (innerProvidedPort c)))
                      (inInterface p2 (interfaceOf (outerProvidedPort c)))))
             (compatibleDataPrototypes p1 p2))
        (= (isService (interfaceOf (innerRequiredPort c)))
           (isService (interfaceOf (outerRequiredPort c)))))))

