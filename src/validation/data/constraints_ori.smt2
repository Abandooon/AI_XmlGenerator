; ---------- Logical axioms ----------

; 1) Requirement for Shutdown Writing Strategy
; Shutdown writing use case corresponds to setting NvBlockDescriptor.nvBlockNeeds.storeAtShutdown to true.
(assert
  (forall ((d NV-BLOCK-DESCRIPTOR))
    (=> (has_nvBlockNeeds d)
        (and (has_storeAtShutdown (nvBlockNeeds d))
             (= (storeAtShutdown (nvBlockNeeds d)) true)))))

; 2) RoleBasedPortAssignment for StbM Service ClientServerInterface
; For every used ClientServerInterface in the StbM Service use cases,
; it is necessary to create a RoleBasedPortAssignment whose role equals
; the name of the used standardized ClientServerInterface.
; Here we abstract "name" as a predicate over the role string.
(declare-fun interfaceNameMatchesRole (CLIENT-SERVER-INTERFACE String) Bool)

(assert
  (forall ((i CLIENT-SERVER-INTERFACE))
    (=> (is_StbM_Service_Interface i)
        (exists ((r ROLE-BASED-PORT-ASSIGNMENT))
          (and (has_roleBasedPortAssignment i r)
               (has_role r)
               (interfaceNameMatchesRole i (role r)))))))

; 3) Client Port requirement for AtomicSwComponentType in StbM Use Case 1
; In the StbM_TimeBaseValue use case, the SWC has to provide one Client Port
; to access the synchronized time-base.
(assert
  (forall ((c ATOMIC-SW-COMPONENT-TYPE))
    (=> (uses_StbM_TimeBaseValue_UseCase c)
        (exists ((p PORT))
          (and (has_port c p)
               (is_ClientPort p)))))

)

; 4) Setup for StbM Use Case (accesses Sync Time-Base Mgr): RoleBasedPortAssignment
; For an AtomicSwComponentType autonomously calling the Synchronized Time Base Manager,
; valid roles for RoleBasedPortAssignment are exactly StbM_TimeBaseValue.
(assert
  (forall ((c ATOMIC-SW-COMPONENT-TYPE) (p PORT) (r ROLE-BASED-PORT-ASSIGNMENT))
    (=> (and (uses_StbM_TimeBaseValue_Service c)
             (has_port c p)
             (has_roleBasedPortAssignment_forPort p r)
             (has_role r))
        (is_StbM_TimeBaseValue_Role (role r)))))

; 5) Minimum RoleBasedPortAssignment for StbM Use Case 2
; At least one of the two possible RoleBasedPortAssignments
; (StbM_TimeBase_TriggerCustomer or StbM_TimeBase_StateNotification) shall exist.
(assert
  (forall ((c ATOMIC-SW-COMPONENT-TYPE))
    (=> (uses_StbM_Notification_UseCase c)
        (exists ((p PORT) (r ROLE-BASED-PORT-ASSIGNMENT))
          (and (has_port c p)
               (has_roleBasedPortAssignment_forPort p r)
               (has_role r)
               (or (is_StbM_TimeBase_TriggerCustomer_Role (role r))
                   (is_StbM_TimeBase_StateNotification_Role (role r))))))))

; 6) Receiver Port requirements for AtomicSwComponentType in StbM Use Case 2
; The SWC has to provide one Receiver Port (TriggerCustomer) and/or one Receiver Port (StateNotification).
(assert
  (forall ((c ATOMIC-SW-COMPONENT-TYPE))
    (=> (uses_StbM_Notification_UseCase c)
        (or
          (exists ((p PORT))
            (and (has_port c p)
                 (is_ReceiverPort p)
                 (is_StbM_TimeBase_TriggerCustomer_Port p)))
          (exists ((p PORT))
            (and (has_port c p)
                 (is_ReceiverPort p)
                 (is_StbM_TimeBase_StateNotification_Port p)))))))

; 7) Setup for StbM Use Case (StbM notifies SWC): RoleBasedPortAssignment
; For an AtomicSwComponentType to be informed by the Synchronized Time-Base Manager,
; valid roles are StbM_TimeBase_TriggerCustomer [0..1] and StbM_TimeBase_StateNotification [0..1].
; Here we enforce the upper bound 1 for each role per component.
(assert
  (forall ((c ATOMIC-SW-COMPONENT-TYPE))
    (=> (uses_StbM_Notification_UseCase c)
        (and
          (<=
            (cardinality
              (lambda ((p PORT) (r ROLE-BASED-PORT-ASSIGNMENT))
                (and (has_port c p)
                     (has_roleBasedPortAssignment_forPort p r)
                     (has_role r)
                     (is_StbM_TimeBase_TriggerCustomer_Role (role r)))))
            1)
          (<=
            (cardinality
              (lambda ((p PORT) (r ROLE-BASED-PORT-ASSIGNMENT))
                (and (has_port c p)
                     (has_roleBasedPortAssignment_forPort p r)
                     (has_role r)
                     (is_StbM_TimeBase_StateNotification_Role (role r)))))
            1)))))

