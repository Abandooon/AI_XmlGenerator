; =========================
; Constraint 1:
; Constr_MergeDelegation_Nfold_EntireDelegation
; Provision of outer PPort data for nfold merge (entire delegation)
; =========================
(assert
  (forall ((c COMPOSITION-SW-COMPONENT-TYPE)
           (ann DELEGATED-PORT-ANNOTATION)
           (outerP PPORT-PROTOTYPE)
           (d VARIABLE-DATA-PROTOTYPE))
    (=> (and (hasDelegatedPortAnnotation c ann)
             (= (signalFan ann) "nfold")
             (outerDelegationPPort ann outerP)
             (dataElementOfPPort outerP d))
        (exists ((scp SW-COMPONENT-PROTOTYPE)
                (innerP PPORT-PROTOTYPE))
          (and (innerPPortOfComposition c scp innerP)
               (providesDataElement innerP d))))))

; =========================
; Constraint 2:
; Constr_MergeDelegation_OuterPPort_ProvidedByOneInnerPPort
; Provision of outer PPort data by inner PPorts in merge (single fan)
; =========================
(assert
  (forall ((c COMPOSITION-SW-COMPONENT-TYPE)
           (ann DELEGATED-PORT-ANNOTATION)
           (outerP PPORT-PROTOTYPE)
           (d VARIABLE-DATA-PROTOTYPE))
    (=> (and (hasDelegatedPortAnnotation c ann)
             (= (signalFan ann) "single")
             (outerDelegationPPort ann outerP)
             (dataElementOfPPort outerP d))
        (exists ((scp SW-COMPONENT-PROTOTYPE)
                (innerP PPORT-PROTOTYPE))
          (and (innerPPortOfComposition c scp innerP)
               (providesDataElement innerP d)
               ; uniqueness: exactly one inner PPort provides d
               (forall ((scp2 SW-COMPONENT-PROTOTYPE)
                        (innerP2 PPORT-PROTOTYPE))
                 (=> (and (innerPPortOfComposition c scp2 innerP2)
                          (providesDataElement innerP2 d))
                     (= innerP2 innerP))))))))

