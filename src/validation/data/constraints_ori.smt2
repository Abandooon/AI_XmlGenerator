; ---------- constr_1250 ----------
; Compatibility of ClientServerInterfaces in the context of a PassThroughSwConnector
; “iff” semantics captured via csInterfaceCompatible

; Direction 1: definition of csInterfaceCompatible
(assert
  (forall ((iP CLIENT-SERVER-INTERFACE) (iR CLIENT-SERVER-INTERFACE))
    (=> (csInterfaceCompatible iP iR)
        (and
          ; 1. For at least one operation in provided interface, there exists a compatible operation in required interface
          (exists ((opP CLIENT-SERVER-OPERATION))
            (and
              (ownsOperation iP opP)
              (exists ((opR CLIENT-SERVER-OPERATION))
                (and
                  (ownsOperation iR opR)
                  ; Either same shortName or mapped via some mapping
                  (or
                    (= (shortName opP) (shortName opR))
                    (exists ((m CLIENT-SERVER-INTERFACE-MAPPING))
                      (mapsOperations m opP opR)))
                  ; 2. For each such pair, isService identical
                  (= (isService_ClientServer iP) (isService_ClientServer iR))))))))))

; Direction 2: if the structural conditions hold, then interfaces are compatible
(assert
  (forall ((iP CLIENT-SERVER-INTERFACE) (iR CLIENT-SERVER-INTERFACE))
    (=> 
      (exists ((opP CLIENT-SERVER-OPERATION))
        (and
          (ownsOperation iP opP)
          (exists ((opR CLIENT-SERVER-OPERATION))
            (and
              (ownsOperation iR opR)
              (or
                (= (shortName opP) (shortName opR))
                (exists ((m CLIENT-SERVER-INTERFACE-MAPPING))
                  (mapsOperations m opP opR)))
              (= (isService_ClientServer iP) (isService_ClientServer iR))))))
      (csInterfaceCompatible iP iR))))

; ---------- constr_1251 ----------
; Compatibility of PortPrototypes of TriggerInterfaces in the context of a PassThroughSwConnector

; Direction 1: definition of triggerInterfaceCompatible
(assert
  (forall ((iReq TRIGGER-INTERFACE) (iProv TRIGGER-INTERFACE))
    (=> (triggerInterfaceCompatible iReq iProv)
        (and
          ; 1. For at least one Trigger in required interface, there exists a compatible Trigger in provided interface
          (exists ((tReq TRIGGER))
            (and
              (ownsTrigger iReq tReq)
              (exists ((tProv TRIGGER))
                (and
                  (ownsTrigger iProv tProv)
                  (or
                    (= (shortNameTrigger tReq) (shortNameTrigger tProv))
                    (exists ((m TRIGGER-INTERFACE-MAPPING))
                      (mapsTriggers m tReq tProv)))
                  ; 2. isService identical
                  (= (isService_Trigger iReq) (isService_Trigger iProv))))))))))

; Direction 2: structural conditions imply compatibility
(assert
  (forall ((iReq TRIGGER-INTERFACE) (iProv TRIGGER-INTERFACE))
    (=> 
      (exists ((tReq TRIGGER))
        (and
          (ownsTrigger iReq tReq)
          (exists ((tProv TRIGGER))
            (and
              (ownsTrigger iProv tProv)
              (or
                (= (shortNameTrigger tReq) (shortNameTrigger tProv))
                (exists ((m TRIGGER-INTERFACE-MAPPING))
                  (mapsTriggers m tReq tProv)))
              (= (isService_Trigger iReq) (isService_Trigger iProv))))))
      (triggerInterfaceCompatible iReq iProv))))

; Note: binding to PassThroughSwConnector (which ports/interfaces are involved) is handled in mapping.


; ---------- constr_1252 ----------
; Creation of a loop involving a PassThroughSwConnector is not allowed
; If requiredOuterPort is connected (directly or indirectly) to providedOuterPort
; and there is no AtomicSwComponentType on the path, then such PassThroughSwConnector is forbidden.

(assert
  (forall ((c PASS-THROUGH-SW-CONNECTOR))
    (let ((req (requiredOuterPort c))
          (prov (providedOuterPort c)))
      (=> (and (connectedViaSwConnector req prov)
               (not (hasAtomicSwcOnPath req prov)))
          false))))


; ---------- constr_1253 ----------
; Supported usage of VariationPointProxy
; 具体 multiplicity 依赖外部表 7.111，此处不添加额外逻辑公理。


; ---------- constr_1255 ----------
; ApplicationPrimitiveDataTypes of category BOOLEAN and STRING
; If a Unit is referenced from SwDataDefProps and/or PhysConstrs, it must be “meaningless”:
; all exponents of its PhysicalDimension are 0.

(define-fun isMeaninglessUnit ((u UNIT)) Bool
  (let ((pd (physicalDimensionOf u)))
    (and
      (= (lengthExp pd) 0)
      (= (massExp pd) 0)
      (= (timeExp pd) 0)
      (= (currentExp pd) 0)
      (= (temperatureExp pd) 0)
      (= (molarAmountExp pd) 0)
      (= (luminousIntensityExp pd) 0))))

(assert
  (forall ((t APPLICATION-PRIMITIVE-DATA-TYPE))
    (let ((cat (category t)))
      (=> (or (= cat "BOOLEAN") (= cat "STRING"))
          (and
            (=> (hasSwDataDefPropsUnit t)
                (isMeaninglessUnit (swDataDefPropsUnit t)))
            (=> (hasPhysConstrsUnit t)
                (isMeaninglessUnit (physConstrsUnit t))))))))


; ---------- constr_1256 ----------
; Acknowledgement feedback in n:1 writer case
; Within one SwcInternalBehavior, it is forbidden that two or more Runnables write/send
; to the same targetDataPrototype if transmissionAcknowledge is requested for that data element.

(assert
  (forall ((beh SWC-INTERNAL-BEHAVIOR))
    (forall ((r1 RUNNABLE-ENTITY) (r2 RUNNABLE-ENTITY))
      (=> (and (runnableOf beh r1)
               (runnableOf beh r2)
               (not (= r1 r2)))
          (forall ((va1 VARIABLE-ACCESS) (va2 VARIABLE-ACCESS))
            (=> (and
                  (or (dataSendPoint r1 va1) (dataWriteAccess r1 va1))
                  (or (dataSendPoint r2 va2) (dataWriteAccess r2 va2))
                  (= (targetDataPrototype (accessedVariable va1))
                     (targetDataPrototype (accessedVariable va2))))
                (let* ((varRef (accessedVariable va1))
                       (port   (portPrototypeOf varRef))
                       (data   (targetDataPrototype varRef))
                       (spec   (senderComSpecOf port data)))
                  (=> (transmissionAcknowledge spec) false))))))))


; ---------- constr_1257 ----------
; No WaitPoints allowed
; A RunnableEntity referenced by an InitEvent in the role startOnEvent shall not aggregate a WaitPoint.

(assert
  (forall ((e INIT-EVENT))
    (=> (hasStartOnEvent e)
        (let ((r (startOnEvent e)))
          (forall ((w WAIT-POINT))
            (=> (waitPointOf r w) false)))))

)
