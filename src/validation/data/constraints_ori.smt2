; --- constr_1160: Size of Compound Primitive Data Type is variant ---

; whether a compound primitive data type has variant size
(declare-fun isVariantSize (COMPOUND-PRIMITIVE-DATA-TYPE) Bool)

; size of the compound primitive data type (e.g., number of elements)
(declare-fun cpdtSize (COMPOUND-PRIMITIVE-DATA-TYPE) Int)

; the SwSystemconst that constrains the size
(declare-fun cpdtSystemConst (COMPOUND-PRIMITIVE-DATA-TYPE) SW-SYSTEMCONST)

; range of the SwSystemconst (min/max or equivalent)
(declare-fun swSystemConstMin (SW-SYSTEMCONST) Int)
(declare-fun swSystemConstMax (SW-SYSTEMCONST) Int)

; size of the specified initValues for the data type
(declare-fun initValuesSize (COMPOUND-PRIMITIVE-DATA-TYPE) Int)

; Core constraint:
; For CPDTs with variant size, the size of initValues shall match
; the range of the involved SwSystemconst.
(assert
  (forall ((x COMPOUND-PRIMITIVE-DATA-TYPE))
    (=> (isVariantSize x)
        (= (initValuesSize x)
           (- (swSystemConstMax (cpdtSystemConst x))
              (swSystemConstMin (cpdtSystemConst x)))))))


; --- constr_1161: Applicability of the index attribute of Ref ---

; index attribute presence on a Ref
(declare-fun hasIndex (REF) Bool)

; classification of Ref use cases
(declare-fun isMcDataInstance_instanceInMemory (REF) Bool)
(declare-fun isAutosarVariableRef (REF) Bool)
(declare-fun isAutosarParameterRef (REF) Bool)
(declare-fun isFlatInstanceDescriptor_AnyInstanceRef (REF) Bool)

; Core constraint:
; If a Ref has an index attribute, it must belong to one of the allowed use cases.
(assert
  (forall ((r REF))
    (=> (hasIndex r)
        (or (isMcDataInstance_instanceInMemory r)
            (isAutosarVariableRef r)
            (isAutosarParameterRef r)
            (isFlatInstanceDescriptor_AnyInstanceRef r)))))


; --- constr_1162: Compatibility of SwRecordLayouts ---

; Observational equality of all "relevant" attributes of SW-RECORD-LAYOUT
; (i.e., all except shortName, desc, introduction, longName, adminData, annotation)
(declare-fun swRecordLayoutCoreEqual (SW-RECORD-LAYOUT SW-RECORD-LAYOUT) Bool)

; Compatibility predicate
(declare-fun swRecordLayoutCompatible (SW-RECORD-LAYOUT SW-RECORD-LAYOUT) Bool)

; IFF: compatible <-> coreEqual
(assert
  (forall ((a SW-RECORD-LAYOUT) (b SW-RECORD-LAYOUT))
    (= (swRecordLayoutCompatible a b)
       (swRecordLayoutCoreEqual a b))))


; --- constr_1163: Compatibility of CompuMethods ---

; Core equality of all attributes except:
; shortName, desc, introduction, longName, adminData, annotation, displayFormat
(declare-fun compuMethodCoreEqual (COMPU-METHOD COMPU-METHOD) Bool)

; Compatibility of compuScales and units
(declare-fun compuScalesAndUnitsCompatible (COMPU-METHOD COMPU-METHOD) Bool)

; Compatibility predicate
(declare-fun compuMethodCompatible (COMPU-METHOD COMPU-METHOD) Bool)

; IFF: compatible <-> (coreEqual ∧ compuScalesAndUnitsCompatible)
(assert
  (forall ((a COMPU-METHOD) (b COMPU-METHOD))
    (= (compuMethodCompatible a b)
       (and (compuMethodCoreEqual a b)
            (compuScalesAndUnitsCompatible a b)))))


; --- constr_1164: Number of arguments owned by a RunnableEntity ---

; Association: which RunnableEntity is triggered by an OperationInvokedEvent
(declare-fun triggeredRunnable (OPERATION-INVOKED-EVENT) RUNNABLE-ENTITY)

; Association: which ClientServerOperation is referenced by an OperationInvokedEvent
(declare-fun invokedOperation (OPERATION-INVOKED-EVENT) CLIENT-SERVER-OPERATION)

; Association: which PortPrototype is referenced by the PortAPIOption that
; corresponds to the OperationInvokedEvent (abstracted as a direct link)
(declare-fun portPrototypeForEvent (OPERATION-INVOKED-EVENT) PORT-PROTOTYPE)

; Association: PortAPIOption relevant for a given OperationInvokedEvent
(declare-fun portApiOptionForEvent (OPERATION-INVOKED-EVENT) PORT-API-OPTION)

; Counting functions
(declare-fun runnableArgumentCount (RUNNABLE-ENTITY) Int)
(declare-fun portArgValueCount (PORT-API-OPTION) Int)
(declare-fun operationArgumentCount (CLIENT-SERVER-OPERATION) Int)

; Predicate: whether a RunnableEntity "owns RunnableEntityArguments in the role argument"
(declare-fun hasRunnableArguments (RUNNABLE-ENTITY) Bool)

; Core constraint:
; If a RunnableEntity has arguments, then:
;   #RunnableEntityArguments =
;     #portArgValues (of the PortAPIOption for the PortPrototype referenced
;                     via the OperationInvokedEvent)
;   + #ArgumentDataPrototypes (of the ClientServerOperation referenced by the event).
(assert
  (forall ((e OPERATION-INVOKED-EVENT))
    (let ((r (triggeredRunnable e))
          (op (invokedOperation e))
          (pao (portApiOptionForEvent e)))
      (=> (hasRunnableArguments r)
          (= (runnableArgumentCount r)
             (+ (portArgValueCount pao)
                (operationArgumentCount op)))))))


; --- constr_1165: Applicability of RunnableEntityArgument ---

; Predicate: RunnableEntity is triggered by a ClientServerOperation
(declare-fun triggeredByClientServerOperation (RUNNABLE-ENTITY) Bool)

; Predicate: RunnableEntity has at least one RunnableEntityArgument
(declare-fun hasRunnableEntityArgument (RUNNABLE-ENTITY) Bool)

; Core constraint:
; Existence of RunnableEntityArgument is limited to RunnableEntitys
; triggered by a ClientServerOperation.
(assert
  (forall ((r RUNNABLE-ENTITY))
    (=> (hasRunnableEntityArgument r)
        (triggeredByClientServerOperation r))))


; --- constr_1166: Restrictions of ModeRequestTypeMap ---

; Associations for the structural chain described in the expression

; ApplicationSwComponentType owns PortPrototypes
(declare-fun ownsPortPrototype (APPLICATION-SW-COMPONENT-TYPE PORT-PROTOTYPE) Bool)

; PortPrototype is typed by an Interface
(declare-fun portType (PORT-PROTOTYPE) MODE-SWITCH-INTERFACE)

; ModeSwitchInterface uses ModeDeclarationGroupPrototypes
(declare-fun usesModeDeclGroupPrototype (MODE-SWITCH-INTERFACE MODE-DECLARATION-GROUP-PROTOTYPE) Bool)

; ModeDeclarationGroupPrototype references a ModeDeclarationGroup
(declare-fun mdgOfPrototype (MODE-DECLARATION-GROUP-PROTOTYPE) MODE-DECLARATION-GROUP)

; ApplicationSwComponentType owns a SwcInternalBehavior
(declare-fun internalBehaviorOf (APPLICATION-SW-COMPONENT-TYPE) SWC-INTERNAL-BEHAVIOR)

; SwcInternalBehavior references a DataTypeMappingSet
(declare-fun mappingSetOf (SWC-INTERNAL-BEHAVIOR) DATA-TYPE-MAPPING-SET)

; DataTypeMappingSet aggregates ModeRequestTypeMaps
(declare-fun hasModeRequestTypeMap (DATA-TYPE-MAPPING-SET MODE-REQUEST-TYPE-MAP) Bool)

; ModeRequestTypeMap points to a ModeDeclarationGroup and an ImplementationDataType
(declare-fun mrtmModeGroup (MODE-REQUEST-TYPE-MAP) MODE-DECLARATION-GROUP)
(declare-fun mrtmImplDataType (MODE-REQUEST-TYPE-MAP) IMPLEMENTATION-DATA-TYPE)

; Predicate: ImplementationDataType is "eligible" for the ModeDeclarationGroup
(declare-fun eligibleImplDataType (MODE-DECLARATION-GROUP IMPLEMENTATION-DATA-TYPE) Bool)

; Core constraint:
; For every ModeDeclarationGroup referenced by a ModeDeclarationGroupPrototype
; used in a PortPrototype typed by a ModeSwitchInterface of an
; ApplicationSwComponentType, there exists a ModeRequestTypeMap in the
; DataTypeMappingSet referenced from the SwcInternalBehavior of that
; ApplicationSwComponentType, such that:
;   - mrtmModeGroup = that ModeDeclarationGroup
;   - mrtmImplDataType is eligible for that ModeDeclarationGroup.
(assert
  (forall ((swc APPLICATION-SW-COMPONENT-TYPE)
           (p PORT-PROTOTYPE)
           (iface MODE-SWITCH-INTERFACE)
           (mdgp MODE-DECLARATION-GROUP-PROTOTYPE))
    (=> (and (ownsPortPrototype swc p)
             (= (portType p) iface)
             (usesModeDeclGroupPrototype iface mdgp))
        (let* ((mdg (mdgOfPrototype mdgp))
               (beh (internalBehaviorOf swc))
               (dset (mappingSetOf beh)))
          (exists ((m MODE-REQUEST-TYPE-MAP))
            (and (hasModeRequestTypeMap dset m)
                 (= (mrtmModeGroup m) mdg)
                 (eligibleImplDataType mdg (mrtmImplDataType m))))))))

