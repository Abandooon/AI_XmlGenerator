; TPS_SWCT_01156 - Required if the AutosarDataType is not used for any DataPrototype
; 语义：如果某 AutosarDataType 未被本软件组件的任何 DataPrototype 使用，
; 则某“信息”（例如 C 标识符前缀）是必需的。规范片段未给出该信息的具体 XML 名称，
; 这里抽象为 has_typeInfo，并给出条件存在性约束。
; ------------------------------------------------------------

(declare-sort AUTOSAR-DATA-TYPE 0)
(declare-sort SW-COMPONENT-TYPE 0)
(declare-sort DATA-PROTOTYPE 0)

; 组件拥有的 DataPrototype
(declare-fun has_dataPrototype (SW-COMPONENT-TYPE DATA-PROTOTYPE) Bool)

; DataPrototype 使用的 AutosarDataType
(declare-fun dataType_of (DATA-PROTOTYPE AUTOSAR-DATA-TYPE) Bool)

; AutosarDataType 所属的软件组件（用于“owned by this software component”）
(declare-fun owner_component (AUTOSAR-DATA-TYPE SW-COMPONENT-TYPE) Bool)

; AutosarDataType 上的“附加信息”（例如 C 标识符前缀等）
(declare-fun has_typeInfo (AUTOSAR-DATA-TYPE) Bool)

; 逻辑：对于任意 AutosarDataType a，如果其所属组件 c 中不存在任何 DataPrototype 使用 a，
; 则 a 必须具有 typeInfo。
(assert
  (forall ((a AUTOSAR-DATA-TYPE) (c SW-COMPONENT-TYPE))
    (=> (owner_component a c)
        (=> (not (exists ((p DATA-PROTOTYPE))
                    (and (has_dataPrototype c p)
