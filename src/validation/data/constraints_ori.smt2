; ================================================================
; TPS_SWCT_01617 - Structure of ImplementationDataType for variable-sized array
; ================================================================
; The ImplementationDataType that represents a Variable-Size Array Data Type
; shall have the category STRUCTURE and two subElements.
; Here we only capture that such types (identified via mapping) must have
; CATEGORY = STRUCTURE; cardinality is partly enforced in SHACL.

(declare-fun representsVariableSizeArray (IMPLEMENTATION-DATA-TYPE) Bool)

(assert
  (forall ((t IMPLEMENTATION-DATA-TYPE))
    (=> (representsVariableSizeArray t)
        (and (has_category_Impl t)
             (= (category_Impl t) "STRUCTURE")))))

; ================================================================
; TPS_SWCT_01618 - Size Indicator for VSA_LINEAR / VSA_SQUARE / VSA_FULLY_FLEXIBLE
; ================================================================
; If an ImplementationDataType is mapped to an ApplicationArrayDataType
; with dynamicArraySizeProfile in {VSA_LINEAR, VSA_SQUARE, VSA_FULLY_FLEXIBLE},
; then the first subElement is an integer large enough to hold maxArraySize.

(assert
  (forall ((t IMPLEMENTATION-DATA-TYPE) (a APPLICATION-ARRAY-DATA-TYPE) (e IMPLEMENTATION-DATA-TYPE-ELEMENT))
    (=> (and (mappedToApplicationArray t a)
             (has_dynamicArraySizeProfile_App a)
             (isVSA_LINEAR_SQUARE_OR_FULLY_FLEXIBLE (dynamicArraySizeProfile_App a))
             (isFirstSubElement t e))
        (and (isIntegerElement e)
             (>= (arraySize_Elem e) (maxArraySize a)))))

)

; ================================================================
; TPS_SWCT_01619 - Size Indicator for VSA_RECTANGULAR
; ================================================================
; If mapped to ApplicationArrayDataType with dynamicArraySizeProfile = VSA_RECTANGULAR,
; the first ImplementationDataType.subElement shall:
;  - have CATEGORY = ARRAY
;  - have arraySize equal to the number of the according dimension
;    of the corresponding ApplicationDataType (modeled via correspondence
;    to ApplicationArrayElement and its MAX-NUMBER-OF-ELEMENTS).

(assert
  (forall ((t IMPLEMENTATION-DATA-TYPE)
           (a APPLICATION-ARRAY-DATA-TYPE)
           (e IMPLEMENTATION-DATA-TYPE-ELEMENT)
           (ae APPLICATION-ARRAY-ELEMENT))
    (=> (and (mappedToApplicationArray t a)
             (has_dynamicArraySizeProfile_App a)
             (isVSA_RECTANGULAR (dynamicArraySizeProfile_App a))
             (isFirstSubElement t e)
             (correspondsToApplicationArrayElement t e ae)
             (has_maxNumberOfElements_AppElem ae))
        (and (has_category_Elem e)
             (= (category_Elem e) "ARRAY")
             (has_arraySize_Elem e)
             (= (arraySize_Elem e) (maxNumberOfElements_AppElem ae))))))

; ================================================================
; TPS_SWCT_01620 - Elements of Size Indicator array
; ================================================================
; The elements of this Size Indicator array shall consist of integers
; large enough to hold the maximum number of valid elements (maxArraySize).

(assert
  (forall ((t IMPLEMENTATION-DATA-TYPE)
           (a APPLICATION-ARRAY-DATA-TYPE)
           (sizeArray IMPLEMENTATION-DATA-TYPE-ELEMENT)
           (elem IMPLEMENTATION-DATA-TYPE-ELEMENT))
    (=> (and (mappedToApplicationArray t a)
             (has_dynamicArraySizeProfile_App a)
             (isVSA_RECTANGULAR (dynamicArraySizeProfile_App a))
             ; sizeArray is the first subElement (size indicator array)
             (isFirstSubElement t sizeArray)
             (isSizeIndicatorArrayElement sizeArray elem)
             (isIntegerValue elem))
        (>= (valueOfElement elem) (maxArraySize a)))))

; ================================================================
; TPS_SWCT_01621 - Payload for dynamicArraySizeProfile
; ================================================================
; If mapped to ApplicationArrayDataType where dynamicArraySizeProfile exists,
; the second ImplementationDataType.subElement shall be an array which can
; hold the data of the variable size array with all dimensions defined.
; CATEGORY = ARRAY and ARRAY-SIZE = maxArraySize.

(assert
  (forall ((t IMPLEMENTATION-DATA-TYPE)
           (a APPLICATION-ARRAY-DATA-TYPE)
           (payload IMPLEMENTATION-DATA-TYPE-ELEMENT))
    (=> (and (mappedToApplicationArray t a)
             (has_dynamicArraySizeProfile_App a)
             (isSecondSubElement t payload))
        (and (has_category_Elem payload)
             (= (category_Elem payload) "ARRAY")
             (has_arraySize_Elem payload)
             (= (arraySize_Elem payload) (maxArraySize a))))))

