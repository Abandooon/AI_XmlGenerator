; constr_1258
; Value of minimumStartInterval for RunnableEntitys triggered by an InitEvent
; "The value of the attribute ExecutableEntity.minimumStartInterval for a
;  RunnableEntity that is triggered by an InitEvent shall always be set to 0."
;---------------------------------------------------------------
(assert
