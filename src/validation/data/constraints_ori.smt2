; -----------------------------
; Axioms
; -----------------------------

; TPS_SWCT_01122:
; For synchronous operations, for each argument of direction out or inout,
; there is a return value and the type is compatible.
(assert
  (forall ((op CLIENT-SERVER-OPERATION) (a ARGUMENT-DATA-PROTOTYPE))
    (=> (and (isSynchronous op)
             (hasArgument op a)
             (or (direction_out a) (direction_inout a)))
        (and (hasReturnValueForArg op a)
             (argTypeCompatible a)))))

; TPS_SWCT_01123:
; ArgumentDataPrototypes in the context of a ClientServerOperation shall not have default values.
(assert
  (forall ((op CLIENT-SERVER-OPERATION) (a ARGUMENT-DATA-PROTOTYPE))
    (=> (hasArgument op a)
        (not (hasDefaultValue a))))

)

; TPS_SWCT_01125:
; If serverArgumentImplPolicy is useArrayBaseType, RTE does not require compatibility
; for array-typed arguments.
(assert
  (forall ((a ARGUMENT-DATA-PROTOTYPE))
    (=> (and (has_serverArgumentImplPolicy a)
             (serverArgumentImplPolicy_useArrayBaseType a)
             (isArrayTypedArgument a))
        (not (rteRequiresCompatibility a)))))

; If serverArgumentImplPolicy is useVoid, RTE does not require compatibility
; for struct-like arguments.
(assert
  (forall ((a ARGUMENT-DATA-PROTOTYPE))
    (=> (and (has_serverArgumentImplPolicy a)
             (serverArgumentImplPolicy_useVoid a)
             (isStructLikeArgument a))
        (not (rteRequiresCompatibility a)))))

; TPS_SWCT_01128:
; ApplicationPrimitiveDataType of category STRING must have SwDataDefProps
; and reference a SwRecordLayout.
(assert
  (forall ((t APPLICATION-PRIMITIVE-DATA-TYPE))
    (=> (category_STRING t)
        (and (has_SwDataDefProps t)
             (exists ((l SW-RECORD-LAYOUT))
               (swRecordLayoutRef t l)))))

)

; TPS_SWCT_01126:
; RoleBasedPortAssignment valid roles: control [0..1], status [0..1].
; (Cardinality constraints are typically handled structurally; here we only
; document that any RoleBasedPortAssignment must have one of the valid roles.)
(assert
  (forall ((r ROLE-BASED-PORT-ASSIGNMENT))
    (=> (or (role_control r) (role_status r))
        (representedPortGroup r)))

)

; TPS_SWCT_01129:
; For every used ClientServerInterface there exists a RoleBasedPortAssignment
; whose role equals the name of the standardized ClientServerInterface.
(assert
  (forall ((ci CLIENT-SERVER-INTERFACE))
    (=> (usesClientServerInterface ci)
        (exists ((r ROLE-BASED-PORT-ASSIGNMENT))
          (and (hasRoleBasedPortAssignment ci r)
               (roleMatchesInterfaceName r ci)))))

)

