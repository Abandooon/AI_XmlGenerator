             (forall ((k Int))
               (=> (and (<= 0 k) (< k (trigifm_triggerMappingCount m)))
                   (let ((tm (trigifm_nthTriggerMapping m)))
                     true))))) ; mapping existence is enough here

         ; 2. isService identical
         (= (trigif_isService req) (trigif_isService prov))))))

; Connector-level requirement for TriggerInterfaces on AssemblySwConnector
(assert
  (forall ((c ASSEMBLY-SW-CONNECTOR))
    (TriggerInterfaceCompatible_Assembly
      (asm_requiredTriggerInterface c)
      (asm_providedTriggerInterface c)
      c)))

; =========================
; constr_1082 - Compatibility of TriggerInterfaces (DelegationSwConnector)
; =========================

; Semantic predicate: TriggerInterfaces compatible in Delegation context
(declare-fun TriggerInterfaceCompatible_Delegation (TRIGGER-INTERFACE TRIGGER-INTERFACE TRIGGER-INTERFACE TRIGGER-INTERFACE DELEGATION-SW-CONNECTOR) Bool)

(assert
  (forall ((reqInner TRIGGER-INTERFACE)
           (reqOuter TRIGGER-INTERFACE)
           (provInner TRIGGER-INTERFACE)
           (provOuter TRIGGER-INTERFACE)
           (c DELEGATION-SW-CONNECTOR))
    (= (TriggerInterfaceCompatible_Delegation reqInner reqOuter provInner provOuter c)
       (and
         ; 1. One of subconditions (a), (b), (c)
         (or
           ; (a) For each Trigger in required inner, exists compatible in required outer
           (forall ((i Int))
             (=> (and (<= 0 i) (< i (trigif_triggerCount reqInner)))
                 (exists ((j Int))
                   (and (<= 0 j) (< j (trigif_triggerCount reqOuter))
                        (= (trigger_shortName (trigif_nthTrigger reqInner i))
                           (trigger_shortName (trigif_nthTrigger reqOuter j)))))))

           ; (b) For at least one Trigger in provided outer, exists compatible in provided inner
           (exists ((i Int))
             (and (<= 0 i) (< i (trigif_triggerCount provOuter))
                  (exists ((j Int))
                    (and (<= 0 j) (< j (trigif_triggerCount provInner))
                         (= (trigger_shortName (trigif_nthTrigger provOuter i))
                            (trigger_shortName (trigif_nthTrigger provInner j)))))))

           ; (c) Mapping-based
           (let ((m (del_trigifMapping c)))
             (forall ((k Int))
               (=> (and (<= 0 k) (< k (trigifm_triggerMappingCount m)))
                   (let ((tm (trigifm_nthTriggerMapping m)))
                     true)))))

         ; 2. isService identical for each such pair of interfaces
         (= (trigif_isService reqInner) (trigif_isService reqOuter))
         (= (trigif_isService provInner) (trigif_isService provOuter))))))

; Connector-level requirement for TriggerInterfaces on DelegationSwConnector
(assert
  (forall ((c DELEGATION-SW-CONNECTOR))
    (TriggerInterfaceCompatible_Delegation
      (del_requiredInnerTriggerInterface c)
      (del_requiredOuterTriggerInterface c)
      (del_providedInnerTriggerInterface c)
      (del_providedOuterTriggerInterface c)
      c)))

