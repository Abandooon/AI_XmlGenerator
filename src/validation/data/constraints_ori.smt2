;------------------------------

; constr_1039 – Relevance of swImplPolicy
; It is not possible to define a mapping between an element where the swImplPolicy
; is set to queued and another element where the swImplPolicy is set differently.
(assert
  (forall ((a AUTOSAR-DATA-PROTOTYPE) (b AUTOSAR-DATA-PROTOTYPE))
    (=> (mappedTo a b)
        (not (and (swImplPolicyQueued a)
                  (swImplPolicyNonQueued b))))))

(assert
  (forall ((a AUTOSAR-DATA-PROTOTYPE) (b AUTOSAR-DATA-PROTOTYPE))
    (=> (mappedTo a b)
        (not (and (swImplPolicyQueued b)
                  (swImplPolicyNonQueued a))))))

; constr_1040 – Conversion of SenderReceiverInterfaces
; Conversion is possible if one of:
; 1) AutosarDataTypes compatible
; 2) A conversion of the data is available
; 3) A DataPrototypeMapping.firstToSecondDataTransformation is defined
; We model this as: whenever a mapping is used, at least one condition holds.
(declare-fun senderPrototype (DATA-PROTOTYPE-MAPPING AUTOSAR-DATA-PROTOTYPE) Bool)
(declare-fun receiverPrototype (DATA-PROTOTYPE-MAPPING AUTOSAR-DATA-PROTOTYPE) Bool)

(assert
  (forall ((m DATA-PROTOTYPE-MAPPING)
           (s AUTOSAR-DATA-PROTOTYPE)
           (r AUTOSAR-DATA-PROTOTYPE)
           (ts AUTOSAR-DATA-TYPE)
           (tr AUTOSAR-DATA-TYPE))
    (=> (and (senderPrototype m s)
             (receiverPrototype m r)
             (autosarDataTypeOf s ts)
             (autosarDataTypeOf r tr))
        (or (autosarDataTypesCompatible ts tr)
            (providesDataConversion m)
            (has_firstToSecondDataTransformationRef m)))))

; constr_1041 – Conversion of ClientServerInterfaces
; Either the AutosarDataTypes of the referred ArgumentDataPrototypes are compatible
; or a conversion of the data is available.
(assert
  (forall ((a1 ARGUMENT-DATA-PROTOTYPE)
           (a2 ARGUMENT-DATA-PROTOTYPE)
           (t1 AUTOSAR-DATA-TYPE)
           (t2 AUTOSAR-DATA-TYPE))
    (=> (and (autosarDataTypeOfArgument a1 t1)
             (autosarDataTypeOfArgument a2 t2))
        (or (autosarDataTypesCompatible t1 t2)
            (hasDataConversionForArguments a1 a2)))))

; constr_1043 – PortInterface vs. ComSpec
; Only allowed combinations according to Table 4.59 are valid.
; We introduce an abstract predicate allowedPortInterfaceComSpec.
(declare-sort COM-SPEC 0)
(declare-fun portHasComSpec (PORT-INTERFACE COM-SPEC) Bool)
(declare-fun allowedPortInterfaceComSpec (PORT-INTERFACE COM-SPEC) Bool)

(assert
  (forall ((p PORT-INTERFACE) (c COM-SPEC))
    (=> (portHasComSpec p c)
        (allowedPortInterfaceComSpec p c))))

; constr_1044 – Applicability of DataFilter
; DataFilters can only be applied to values with an integer base type.
(assert
  (forall ((f DATA-FILTER) (t AUTOSAR-DATA-TYPE))
    (=> (dataFilterAppliesTo f t)
        (hasIntegerBaseType t))))

; constr_1045 – Supported value encodings for SwBaseType in the context of PortInterfaces
; We model the allowed encodings as a whitelist on the encoding string.
(define-fun allowedEncoding ((e String)) Bool
  (or (= e "2C")
      (= e "IEEE754")
      (= e "ISO-8859-1")
      (= e "ISO-8859-2")
      (= e "WINDOWS-1252")
      (= e "UTF-8")
      (= e "UTF-16")
      (= e "UCS-2")
      (= e "NONE")
      (= e "BOOLEAN")))

; constr_1046 – Applicability of [constr_1045]
; [constr_1045] applies only if isService = false.
; We encode: if a PortInterface is not a service, then its SwBaseType encoding
; (when present) must be one of the allowed encodings.
(assert
  (forall ((p PORT-INTERFACE) (b SW-BASE-TYPE) (enc String))
    (=> (and (not (isService p))
             (swBaseTypeOfPort p b)
             (valueEncoding b enc))
        (allowedEncoding enc))))
