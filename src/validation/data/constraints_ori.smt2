; =========================
(assert
  (forall ((m MODE-ACCESS-POINT-IDENT))
    (=> (isModeAccessPointIdent m)
        true))) ; marker predicate; subclassing is modeled via asIdentCaption

; Optionally, we can state that every ModeAccessPointIdent corresponds to some IdentCaption
(assert
  (forall ((m MODE-ACCESS-POINT-IDENT))
    (isModeAccessPointIdent m)))

