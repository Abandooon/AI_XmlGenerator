; =========================

; Semantic predicate: two Triggers are compatible iff same shortName
(declare-fun TriggerCompatible (TRIGGER TRIGGER) Bool)

(assert
  (forall ((t1 TRIGGER) (t2 TRIGGER))
    (= (TriggerCompatible t1 t2)
       (= (trigger_shortName t1) (trigger_shortName t2)))))

