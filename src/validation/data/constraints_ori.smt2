; ------------------------------------------------------------
; TPS_SWCT_01337 - DataReceivedEvent
; "A receiver is notified through the same event mechanism when a VariableDataPrototype is received.
;  As shown in Figure 7.23, the DataReceivedEvent is directly associated with the corresponding VariableDataPrototype."
; ------------------------------------------------------------

(declare-sort DATA-RECEIVED-EVENT 0)
(declare-sort VARIABLE-DATA-PROTOTYPE 0)

; 语义谓词：事件与变量数据原型的关联
(declare-fun dataOf (DATA-RECEIVED-EVENT) VARIABLE-DATA-PROTOTYPE)

; 语义谓词：某 VariableDataPrototype 的接收是否通过 RTE 事件机制通知
; （此处仅声明，具体含义由工具/环境解释）
(declare-fun notifiedViaDataReceivedEvent (VARIABLE-DATA-PROTOTYPE) Bool)

; 逻辑：如果某 VariableDataPrototype 是某 DataReceivedEvent 的 dataOf，
; 则该 VariableDataPrototype 的接收是通过 DataReceivedEvent 机制通知的。
(assert
  (forall ((e DATA-RECEIVED-EVENT))
    (notifiedViaDataReceivedEvent (dataOf e))))

; ------------------------------------------------------------
; TPS_SWCT_01338 - DataReceiveErrorEvent / aliveTimeout
; "A receiver is notified of DataReceiveErrorEvent through the activation of its RunnableEntity which is referenced by this RTEEvent.
;  A DataReceiveErrorEvent includes a reference to a VariableDataPrototype and is raised by the RTE when an error concerning the
;  reception of the referenced data is detected by the COM layer.
;  ... COM layer monitors the validity of the signal’s value based on the value of the aliveTimeout attribute of ReceiverComSpec
;  referencing the VariableDataPrototype associated with the signal."
; ------------------------------------------------------------

(declare-sort DATA-RECEIVE-ERROR-EVENT 0)
(declare-sort RUNNABLE-ENTITY 0)
(declare-sort NONQUEUED-RECEIVER-COM-SPEC 0)
(declare-sort TIME-VALUE 0)

; 事件关联的 RunnableEntity（被激活以处理错误）
(declare-fun handlerRunnable (DATA-RECEIVE-ERROR-EVENT) RUNNABLE-ENTITY)

; 事件关联的 VariableDataPrototype
(declare-fun errorDataOf (DATA-RECEIVE-ERROR-EVENT) VARIABLE-DATA-PROTOTYPE)

; ReceiverComSpec 及其 aliveTimeout
(declare-fun comSpecOf (VARIABLE-DATA-PROTOTYPE) NONQUEUED-RECEIVER-COM-SPEC)
(declare-fun aliveTimeout (NONQUEUED-RECEIVER-COM-SPEC) TIME-VALUE)

; 语义谓词：COM 层检测到与某 VariableDataPrototype 接收相关的错误
(declare-fun comErrorOnReception (VARIABLE-DATA-PROTOTYPE) Bool)

; 语义谓词：RTE 因 COM 错误而触发 DataReceiveErrorEvent
(declare-fun raisedDueToComError (DATA-RECEIVE-ERROR-EVENT) Bool)

; 逻辑：如果某 DataReceiveErrorEvent 是由于 COM 错误触发，
; 则其引用的数据上存在 COM 接收错误。
(assert
  (forall ((e DATA-RECEIVE-ERROR-EVENT))
    (=> (raisedDueToComError e)
        (comErrorOnReception (errorDataOf e))))

; 注：关于 aliveTimeout 的具体时间逻辑（超时、信号过期等）属于运行时/时序语义，
; 在此模板中不展开为定量时间约束，仅保留结构性谓词。

; ------------------------------------------------------------
; TPS_SWCT_01339 - RTE activates RunnableEntity in response to DataReceiveErrorEvent
; "A DataReceiveErrorEvent is used by the RTE to activate a RunnableEntity that is supposed to handle the above-mentioned errors."
; ------------------------------------------------------------

; 语义谓词：RTE 在某事件发生时激活其 handlerRunnable
(declare-fun rteActivatesHandler (DATA-RECEIVE-ERROR-EVENT) Bool)

; 逻辑：如果 RTE 因 DataReceiveErrorEvent 激活 handler，
; 则该 handlerRunnable 确实是为处理该事件错误而设计的。
(declare-fun handlesDataReceiveError (RUNNABLE-ENTITY DATA-RECEIVE-ERROR-EVENT) Bool)

(assert
  (forall ((e DATA-RECEIVE-ERROR-EVENT))
    (=> (rteActivatesHandler e)
        (handlesDataReceiveError (handlerRunnable e) e)))

; ------------------------------------------------------------
; TPS_SWCT_01340 - DataReceiveErrorEvent cannot be combined with a WaitPoint
; "... It can only be used for the receiver software-component in a sender-receiver communication
;  and its data reference is restricted to VariableDataPrototypes with their swImplPolicy attribute not set to queued."
; ------------------------------------------------------------

(declare-sort SW-DATA-DEF-PROPS-CONTENT 0)
(declare-sort SW-IMPL-POLICY-ENUM 0)
(declare-sort ATOMIC-SW-COMPONENT-TYPE 0)

; 语义：VariableDataPrototype 的实现属性
(declare-fun swDataDefPropsOf (VARIABLE-DATA-PROTOTYPE) SW-DATA-DEF-PROPS-CONTENT)
(declare-fun swImplPolicy (SW-DATA-DEF-PROPS-CONTENT) SW-IMPL-POLICY-ENUM)

; 常量：队列策略枚举值
(declare-const SW-IMPL-POLICY-QUEUED SW-IMPL-POLICY-ENUM)

; 语义谓词：某 DataReceiveErrorEvent 用于 sender-receiver 通信的接收端 SWC
(declare-fun usedForReceiverInSenderReceiver (DATA-RECEIVE-ERROR-EVENT) Bool)

; 逻辑：如果 DataReceiveErrorEvent 被使用（即用于接收端 sender-receiver 通信），
; 则其引用的 VariableDataPrototype 的 swImplPolicy 不得为 queued。
(assert
  (forall ((e DATA-RECEIVE-ERROR-EVENT))
    (=> (usedForReceiverInSenderReceiver e)
        (distinct (swImplPolicy (swDataDefPropsOf (errorDataOf e)))
                  SW-IMPL-POLICY-QUEUED)))

; 关于“不能与 WaitPoint 组合”的部分缺少可观测结构（例如显式的 WaitPoint 引用），
; 在此模板中不引入额外谓词，以避免无根据的建模。

; ------------------------------------------------------------
; TPS_SWCT_01341 - DataReceiveErrorEvent is directly associated with the corresponding VariableDataPrototype
; "As shown in Figure 7.24, the DataReceiveErrorEvent is directly associated with the corresponding VariableDataPrototype
;  and references the RunnableEntity that is activated due to the occurrence of this RTEEvent."
; ------------------------------------------------------------

; 该约束与 TPS_SWCT_01338/01339 的 data 及 handlerRunnable 建模一致，
; 已通过 errorDataOf 与 handlerRunnable 体现“直接关联”和“引用 RunnableEntity”的语义。
; 此处不再重复添加公理。

; ------------------------------------------------------------
; TPS_SWCT_01342 - Invocation of a server operation
; "A RunnableEntity invokes a server operation formally defined as a ClientServerOperation via an RPortPrototype
;  of the enclosing SwComponentPrototype typed by a particular AtomicSwComponentType."
; ------------------------------------------------------------

(declare-sort CLIENT-SERVER-OPERATION 0)
(declare-sort R-PORT-PROTOTYPE 0)
(declare-sort SW-COMPONENT-PROTOTYPE 0)

; 语义：Runnable 所在的 AtomicSwComponentType / SwComponentPrototype / RPort
(declare-fun enclosingSwComponentPrototype (RUNNABLE-ENTITY) SW-COMPONENT-PROTOTYPE)
(declare-fun typeOfSwComponentPrototype (SW-COMPONENT-PROTOTYPE) ATOMIC-SW-COMPONENT-TYPE)
(declare-fun rPortUsedForInvocation (RUNNABLE-ENTITY CLIENT-SERVER-OPERATION) R-PORT-PROTOTYPE)

; 语义谓词：RunnableEntity 调用某 ClientServerOperation
(declare-fun invokes (RUNNABLE-ENTITY CLIENT-SERVER-OPERATION) Bool)

; 逻辑（文档化）：如果某 RunnableEntity 调用某 ClientServerOperation，
; 则该调用是通过其所在组件的某 RPortPrototype 完成的。
(assert
  (forall ((re RUNNABLE-ENTITY) (op CLIENT-SERVER-OPERATION))
    (=> (invokes re op)
        (exists ((p R-PORT-PROTOTYPE))
          (= p (rPortUsedForInvocation re op)))))

; ------------------------------------------------------------
; TPS_SWCT_01343 - Synchronous vs. asynchronous invocation
; "A ClientServerOperation itself can be invoked either \"synchronously\" or \"asynchronously\"."
; ------------------------------------------------------------

; 语义枚举：调用模式
(declare-sort INVOCATION-MODE 0)
(declare-const INVOCATION-MODE-SYNC INVOCATION-MODE)
(declare-const INVOCATION-MODE-ASYNC INVOCATION-MODE)

; 语义：某次调用的模式
(declare-fun invocationMode (RUNNABLE-ENTITY CLIENT-SERVER-OPERATION) INVOCATION-MODE)

; 逻辑：每次调用的模式要么同步要么异步（排他二选一）
(assert
  (forall ((re RUNNABLE-ENTITY) (op CLIENT-SERVER-OPERATION))
    (=> (invokes re op)
        (or (= (invocationMode re op) INVOCATION-MODE-SYNC)
            (= (invocationMode re op) INVOCATION-MODE-ASYNC))))

