; No additional logical axiom beyond typing; association is structural.

;-------------------------------------------------------------------
; constr_1032 - DelegationSwConnector can only connect PortPrototypes of the same kind
; i.e. PPortPrototype to PPortPrototype and RPortPrototype to RPortPrototype.
;-------------------------------------------------------------------

(assert
  (forall ((c DELEGATION-SW-CONNECTOR))
    (let ((s (srcPort c))
          (d (dstPort c)))
      (or
        (and (isPPort s) (isPPort d))
        (and (isRPort s) (isRPort d))))))

;-------------------------------------------------------------------
; constr_1033 - Communication scenarios for sender/receiver communication
; "it is not allowed to create a communication scenario where n sender
;  are connected to m receivers where m and n are both greater than 1."
;
; We model this as: there must not exist a set of links that induces
; a bipartite subgraph with |Senders|>1 and |Receivers|>1.
; For tractability in SMT, we approximate with a pairwise formulation:
; if two distinct senders are both connected to two distinct receivers,
; this is forbidden.
;-------------------------------------------------------------------

(assert
  (forall ((l1 SR-LINK) (l2 SR-LINK) (l3 SR-LINK) (l4 SR-LINK))
    (let ((s1 (senderPort l1))
          (s2 (senderPort l2))
          (r1 (receiverPort l3))
          (r2 (receiverPort l4)))
      (=> (and (isSenderPort s1)
               (isSenderPort s2)
               (isReceiverPort r1)
               (isReceiverPort r2)
               (distinct s1 s2)
               (distinct r1 r2)
               ; connectivity: each sender connected to each receiver
               (= s1 (senderPort l3))
               (= r1 (receiverPort l3))
               (= s1 (senderPort l4))
               (= r2 (receiverPort l4))
               (= s2 (senderPort l1))
               (= r1 (receiverPort l1))
               (= s2 (senderPort l2))
               (= r2 (receiverPort l2)))
          false))))

;-------------------------------------------------------------------
; constr_1035 - Recursive definition of CompositionSwComponentType
; "The recursive definition of a CompositionSwComponentType that eventually
;  contains a SwComponentPrototype typed by the same CompositionSwComponentType
;  shall not be feasible."
;
; We define reaches as the reflexive-transitive closure of the component graph
; and forbid cycles (x reaches x).
;-------------------------------------------------------------------

; Basic reachability axioms (under-approximation of transitive closure)

(assert
  (forall ((c COMPOSITION-SW-COMPONENT-TYPE) (p SW-COMPONENT-PROTOTYPE))
    (=> (has_component c p)
        (reaches c (typeOf p)))))

(assert
  (forall ((c1 COMPOSITION-SW-COMPONENT-TYPE)
           (c2 COMPOSITION-SW-COMPONENT-TYPE)
           (c3 COMPOSITION-SW-COMPONENT-TYPE))
    (=> (and (reaches c1 c2)
             (reaches c2 c3))
        (reaches c1 c3)))

; No composition may (eventually) contain a prototype typed by itself

(assert
  (forall ((c COMPOSITION-SW-COMPONENT-TYPE))
    (not (reaches c c))))

;-------------------------------------------------------------------
; constr_1036 - Connect kinds of PortInterfaces
; "It shall not be possible to connect PortPrototypes typed by PortInterfaces
;  of different kinds. Subclasses of DataInterface make an exception from this
;  rule and can be used for creating connections to each other."
;
; We assume sameInterfaceKind encodes 'same kind' (including subclassing),
; and isDataInterface marks DataInterface and its subclasses.
;-------------------------------------------------------------------

(assert
  (forall ((k PORT-CONNECTOR))
    (let ((p1 (pc_src k))
          (p2 (pc_dst k))
          (i1 (portInterfaceOf p1))
          (i2 (portInterfaceOf p2)))
      (=> (not (and (isDataInterface i1) (isDataInterface i2)))
          (sameInterfaceKind i1 i2)))))

;-------------------------------------------------------------------
; constr_1037 - Client shall not be connected to multiple servers
; "A client shall not be connected to multiple servers such that an
;  operation call would be handled by more than one server."
;
; We approximate: for any client port, there is at most one distinct
; server port connected to it.
;-------------------------------------------------------------------

(assert
  (forall ((c1 CLIENT-SERVER-CONNECTOR)
           (c2 CLIENT-SERVER-CONNECTOR))
    (let ((cp1 (cs_clientPort c1))
          (cp2 (cs_clientPort c2))
          (sp1 (cs_serverPort c1))
          (sp2 (cs_serverPort c2)))
      (=> (and (isClientPort cp1)
               (isClientPort cp2)
               (= cp1 cp2)
               (isServerPort sp1)
               (isServerPort sp2))
          (= sp1 sp2))))

;-------------------------------------------------------------------
; constr_1038 - Reference to ApplicationError
; "A possibleError referenced by a ClientServerOperation shall be owned
;  by the ClientServerInterface that also owns the ClientServerOperation."
;-------------------------------------------------------------------

(assert
  (forall ((iface CLIENT-SERVER-INTERFACE)
           (op CLIENT-SERVER-OPERATION)
           (err APPLICATION-ERROR))
    (=> (and (ownsOperation iface op)
             (has_possibleErrorRef op err))
        (ownsApplicationError iface err))))


