; -----------------------------
; 通用谓词 / 函数声明（按约束需要）
; -----------------------------

; TPS_SWCT_01520 - possibleError 与兼容性
(declare-fun has_possibleError (CLIENT-SERVER-OPERATION) Bool)
; “兼容性”抽象为谓词：两个 ClientServerOperation 是否兼容
(declare-fun compatible (CLIENT-SERVER-OPERATION CLIENT-SERVER-OPERATION) Bool)

; TPS_SWCT_01521 - 读写本地变量时必须使用 localVariable 引用
; 角色谓词：RunnableEntity 是否定义某种 VariableAccess
(declare-fun has_readLocalVariable (RUNNABLE-ENTITY VARIABLE-ACCESS) Bool)
(declare-fun has_writtenLocalVariable (RUNNABLE-ENTITY VARIABLE-ACCESS) Bool)

; VariableAccess -> AutosarVariableRef
(declare-fun accessedVariable (VARIABLE-ACCESS AUTOSAR-VARIABLE-REF) Bool)

; AutosarVariableRef 是否通过 localVariable 引用某个 VARIABLE-DATA-PROTOTYPE
(declare-fun uses_localVariable (AUTOSAR-VARIABLE-REF VARIABLE-DATA-PROTOTYPE) Bool)

; VARIABLE-DATA-PROTOTYPE 是否为 inter-runnable variable（显式/隐式）
(declare-fun is_interRunnableVariable (VARIABLE-DATA-PROTOTYPE) Bool)

; TPS_SWCT_01522 - 读取未初始化 inter-runnable variable 行为未定义
; 读取/写入关系
(declare-fun readsVariable (RUNNABLE-ENTITY VARIABLE-DATA-PROTOTYPE) Bool)
(declare-fun writesVariable (RUNNABLE-ENTITY VARIABLE-DATA-PROTOTYPE) Bool)
; 是否指定 INIT-VALUE
(declare-fun has_initValue (VARIABLE-DATA-PROTOTYPE) Bool)
; 抽象谓词：行为定义良好
(declare-fun behaviorWellDefined () Bool)

; TPS_SWCT_01523 - InternalTriggerOccurredEvent 结构关系
(declare-fun eventSource (INTERNAL-TRIGGER-OCCURRED-EVENT INTERNAL-TRIGGERING-POINT) Bool)
(declare-fun startOnEvent_ITOE (INTERNAL-TRIGGER-OCCURRED-EVENT RUNNABLE-ENTITY) Bool)

; TPS_SWCT_01524 - IoHwAbstractionServerAnnotation 使用限制
; 注解关联的 PortInterface
(declare-fun annotatedPortInterface (IO-HW-ABSTRACTION-SERVER-ANNOTATION PORT-INTERFACE) Bool)
; PortInterface 是否为 NvDataInterface
(declare-fun is_NvDataInterface (PORT-INTERFACE) Bool)

; TPS_SWCT_01525 - InitEvent references RunnableEntity in role startOnEvent
(declare-fun startOnEvent_Init (INIT-EVENT RUNNABLE-ENTITY) Bool)

; TPS_SWCT_01529 - EndToEndDescription.dataIdNibbleOffset 默认值
; 属性访问函数
(declare-fun has_dataIdMode (END-TO-END-DESCRIPTION) Bool)
(declare-fun dataIdMode (END-TO-END-DESCRIPTION) Int)
(declare-fun has_category (END-TO-END-DESCRIPTION) Bool)
(declare-fun category (END-TO-END-DESCRIPTION) Int)
; PROFILE_01 常量编码为整数（由工具映射）
(declare-const PROFILE_01 Int)
(declare-fun has_dataIdNibbleOffset (END-TO-END-DESCRIPTION) Bool)
(declare-fun dataIdNibbleOffset (END-TO-END-DESCRIPTION) Int)

; ============================================================
; 约束公理
; ============================================================

; ------------------------------------------------------------
; TPS_SWCT_01520
; “有 possibleError 的 ClientServerOperation 与完全没有 possibleError 的 ClientServerOperation 不兼容”
; ------------------------------------------------------------
(assert
  (forall ((c1 CLIENT-SERVER-OPERATION) (c2 CLIENT-SERVER-OPERATION))
    (=> (and (has_possibleError c1)
             (not (has_possibleError c2)))
        (not (compatible c1 c2)))))

; ------------------------------------------------------------
; TPS_SWCT_01521
; “在 writtenLocalVariable / readLocalVariable 角色下的 VariableAccess 必须使用 AutosarVariableRef.localVariable”
; 形式化为：若某 VariableAccess 被某 RunnableEntity 作为读/写本地变量使用，
; 则其 accessedVariable 至少有一个 AutosarVariableRef 使用 localVariable 指向 inter-runnable variable
; ------------------------------------------------------------
(assert
  (forall ((r RUNNABLE-ENTITY) (va VARIABLE-ACCESS) (ref AUTOSAR-VARIABLE-REF) (v VARIABLE-DATA-PROTOTYPE))
    (=> (or (has_readLocalVariable r va)
            (has_writtenLocalVariable r va))
        (=> (accessedVariable va ref)
            (and (uses_localVariable ref v)
                 (is_interRunnableVariable v)))))

; ------------------------------------------------------------
; TPS_SWCT_01522
; “若未指定初始值且在被任何 RunnableEntity 写入之前就被读取，则行为未定义”
; 这里不直接禁止，而是将其与 behaviorWellDefined 关联，供上层选择是否要求行为良好
; ------------------------------------------------------------
(assert
  (forall ((v VARIABLE-DATA-PROTOTYPE))
    (=> (and (is_interRunnableVariable v)
             (not (has_initValue v)))
        (=> behaviorWellDefined
            (forall ((r RUNNABLE-ENTITY))
              (=> (readsVariable r v)
                  (exists ((w RUNNABLE-ENTITY))
                    (writesVariable w v)))))))

; ------------------------------------------------------------
; TPS_SWCT_01523
; “InternalTriggerOccurredEvent 通过 InternalTriggeringPoint 触发，并可选引用要激活的 RunnableEntity”
; 结构性约束：每个 InternalTriggerOccurredEvent 至少有一个 eventSource
; ------------------------------------------------------------
(assert
  (forall ((e INTERNAL-TRIGGER-OCCURRED-EVENT))
    (exists ((p INTERNAL-TRIGGERING-POINT))
      (eventSource e p)))

; 对 startOnEvent_ITOE 不强制存在，仅声明其语义角色：
; 若存在 startOnEvent_ITOE(e, r)，则表示 e 触发 r 的执行（不再额外形式化）

; ------------------------------------------------------------
; TPS_SWCT_01524
; “IoHwAbstractionServerAnnotation 可用于所有 PortInterfaces，除了 NvDataInterface”
; ------------------------------------------------------------
(assert
  (forall ((ann IO-HW-ABSTRACTION-SERVER-ANNOTATION) (pi PORT-INTERFACE))
    (=> (annotatedPortInterface ann pi)
        (not (is_NvDataInterface pi))))

; ------------------------------------------------------------
; TPS_SWCT_01525
; “InitEvent 可以引用 RunnableEntity 作为 startOnEvent；该触发在 RTE 完全初始化之后”
; 这里只形式化结构关系：若存在 startOnEvent_Init(e, r)，则 e 触发 r
; 不对时序/RTE 初始化阶段做进一步逻辑建模
; ------------------------------------------------------------
; 无额外约束，仅保留谓词作为语义钩子

; ------------------------------------------------------------
; TPS_SWCT_01529
; “若 dataIdMode=3 且 category=PROFILE_01 且未指定 dataIdNibbleOffset，则默认值为 12”
; 形式化为：在该条件下，若 has_dataIdNibbleOffset 为假，则逻辑上视为值为 12
; ------------------------------------------------------------
(assert
  (forall ((e END-TO-END-DESCRIPTION))
    (=> (and (has_dataIdMode e)
             (= (dataIdMode e) 3)
             (has_category e)
             (= (category e) PROFILE_01)
             (not (has_dataIdNibbleOffset e)))
        (= (dataIdNibbleOffset e) 12)))


