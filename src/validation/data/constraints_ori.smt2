(declare-fun isPPort (PORT-PROTOTYPE) Bool)

; Data prototypes owned by interfaces
(declare-fun nvInterfaceVariable (NV-DATA-INTERFACE VARIABLE-DATA-PROTOTYPE) Bool)
(declare-fun nvInterfaceParameter (NV-DATA-INTERFACE PARAMETER-DATA-PROTOTYPE) Bool)

; Implementation policy and identification
(declare-fun swImplPolicy (VARIABLE-DATA-PROTOTYPE) Int)
(declare-fun swImplPolicyParam (PARAMETER-DATA-PROTOTYPE) Int)
(declare-fun usesShortNameIdentification (NV-DATA-INTERFACE) Bool)
(declare-fun usesMappingIdentification (NV-DATA-INTERFACE) Bool)

(declare-fun shortNameVar (VARIABLE-DATA-PROTOTYPE) String)
(declare-fun shortNameParam (PARAMETER-DATA-PROTOTYPE) String)

; Mapping between differently named elements
(declare-fun mappedVariablePair (PORT-INTERFACE-MAPPING VARIABLE-DATA-PROTOTYPE VARIABLE-DATA-PROTOTYPE) Bool)
(declare-fun mappedParameterPair (PORT-INTERFACE-MAPPING PARAMETER-DATA-PROTOTYPE PARAMETER-DATA-PROTOTYPE) Bool)
(declare-fun mappingForInterfaces (PORT-INTERFACE-MAPPING NV-DATA-INTERFACE NV-DATA-INTERFACE) Bool)

; Compatibility predicate between ports
(declare-fun portsCompatible (PORT-PROTOTYPE PORT-PROTOTYPE) Bool)

; Axiom: compatibility iff there exists at least one compatible data prototype pair
(assert
  (forall ((rp PORT-PROTOTYPE) (pp PORT-PROTOTYPE))
    (let ((ri (portInterface rp))
          (pi (portInterface pp)))
      (= (portsCompatible rp pp)
         (or
           ; VariableDataPrototype based compatibility
           (exists ((v1 VARIABLE-DATA-PROTOTYPE) (v2 VARIABLE-DATA-PROTOTYPE))
             (and
               (nvInterfaceVariable ri v1)
               (nvInterfaceVariable pi v2)
               (or
                 (and (usesShortNameIdentification ri)
                      (= (shortNameVar v1) (shortNameVar v2)))
                 (exists ((m PORT-INTERFACE-MAPPING))
                   (and (mappingForInterfaces m ri pi)
                        (mappedVariablePair m v1 v2))))))
           ; ParameterDataPrototype based compatibility
           (exists ((p1 PARAMETER-DATA-PROTOTYPE) (p2 PARAMETER-DATA-PROTOTYPE))
             (and
               (nvInterfaceParameter ri p1)
               (nvInterfaceParameter pi p2)
               (or
                 (and (usesShortNameIdentification ri)
                      (= (shortNameParam p1) (shortNameParam p2)))
                 (exists ((m2 PORT-INTERFACE-MAPPING))
                   (and (mappingForInterfaces m2 ri pi)
                        (mappedParameterPair m2 p1 p2)))))))))))

