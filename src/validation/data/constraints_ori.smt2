; Helper: correspondence between RPortPrototype and EndToEndProtectionVariablePrototype
; receiver is identical to requiredComSpec.dataElement
(define-fun correspondence_ok_NQ
  ((p R-PORT-PROTOTYPE) (v END-TO-END-PROTECTION-VARIABLE-PROTOTYPE) (r NONQUEUED-RECEIVER-COM-SPEC))
  Bool
  (= (receiver v) (rcs_dataElement_NQ r)))

(define-fun correspondence_ok_Q
  ((p R-PORT-PROTOTYPE) (v END-TO-END-PROTECTION-VARIABLE-PROTOTYPE) (r QUEUED-RECEIVER-COM-SPEC))
  Bool
  (= (receiver v) (rcs_dataElement_Q r)))

; 1) Preference rule for maxNoNewOrRepeatedData (PROFILE_01 & PROFILE_02)
; If correspondence holds and RCS.maxNoNewOrRepeatedData is defined,
; then the RCS value is preferred over EndToEndProfile.maxNoNewOrRepeatedData.
; We model this as equality when both exist.

(assert
  (forall ((p R-PORT-PROTOTYPE)
           (v END-TO-END-PROTECTION-VARIABLE-PROTOTYPE)
           (prot END-TO-END-PROTECTION)
           (e END-TO-END-DESCRIPTION)
           (rN NONQUEUED-RECEIVER-COM-SPEC)
           (rQ QUEUED-RECEIVER-COM-SPEC))
    (let ((prof (endToEndProfile prot)))
      (and
        (=> (and (e2eVarProtOf p v)
                 (uses_nonqueued_rcs p rN)
                 (correspondence_ok_NQ p v rN)
                 (has_rcs_maxNoNewOrRepeatedData_NQ rN)
                 (has_profile_maxNoNewOrRepeatedData prof))
            (= (profile_maxNoNewOrRepeatedData prof)
               (rcs_maxNoNewOrRepeatedData_NQ rN)))
        (=> (and (e2eVarProtOf p v)
                 (uses_queued_rcs p rQ)
                 (correspondence_ok_Q p v rQ)
                 (has_rcs_maxNoNewOrRepeatedData_Q rQ)
                 (has_profile_maxNoNewOrRepeatedData prof))
            (= (profile_maxNoNewOrRepeatedData prof)
               (rcs_maxNoNewOrRepeatedData_Q rQ)))))))

; 2) Existence rule for EndToEndProfile.maxNoNewOrRepeatedData in PROFILE_01 (constr_1215)
; If category = PROFILE_01 and (correspondence not fulfilled OR RCS.maxNoNewOrRepeatedData not defined)
; then EndToEndProfile.maxNoNewOrRepeatedData shall exist.

(assert
  (forall ((p R-PORT-PROTOTYPE)
           (v END-TO-END-PROTECTION-VARIABLE-PROTOTYPE)
           (prot END-TO-END-PROTECTION)
           (rN NONQUEUED-RECEIVER-COM-SPEC)
           (rQ QUEUED-RECEIVER-COM-SPEC))
    (let ((prof (endToEndProfile prot)))
      (=> (and (is_PROFILE_01 prof)
               (e2eVarProtOf p v))
          (and
            (=> (or (not (and (uses_nonqueued_rcs p rN)
                              (correspondence_ok_NQ p v rN)))
                    (and (uses_nonqueued_rcs p rN)
                         (not (has_rcs_maxNoNewOrRepeatedData_NQ rN))))
                (has_profile_maxNoNewOrRepeatedData prof))
            (=> (or (not (and (uses_queued_rcs p rQ)
                              (correspondence_ok_Q p v rQ)))
                    (and (uses_queued_rcs p rQ)
                         (not (has_rcs_maxNoNewOrRepeatedData_Q rQ))))
                (has_profile_maxNoNewOrRepeatedData prof))))))

; 3) Existence rule for EndToEndProfile.syncCounterInit in PROFILE_01 (constr_1216)

(assert
  (forall ((p R-PORT-PROTOTYPE)
           (v END-TO-END-PROTECTION-VARIABLE-PROTOTYPE)
           (prot END-TO-END-PROTECTION)
           (rN NONQUEUED-RECEIVER-COM-SPEC)
           (rQ QUEUED-RECEIVER-COM-SPEC))
    (let ((prof (endToEndProfile prot)))
      (=> (and (is_PROFILE_01 prof)
               (e2eVarProtOf p v))
          (and
            (=> (or (not (and (uses_nonqueued_rcs p rN)
                              (correspondence_ok_NQ p v rN)))
                    (and (uses_nonqueued_rcs p rN)
                         (not (has_rcs_syncCounterInit_NQ rN))))
                (has_profile_syncCounterInit prof))
            (=> (or (not (and (uses_queued_rcs p rQ)
                              (correspondence_ok_Q p v rQ)))
                    (and (uses_queued_rcs p rQ)
                         (not (has_rcs_syncCounterInit_Q rQ))))
                (has_profile_syncCounterInit prof))))))

; 4) Existence rule for EndToEndProfile.maxNoNewOrRepeatedData in PROFILE_02 (constr_1217)

(assert
  (forall ((p R-PORT-PROTOTYPE)
           (v END-TO-END-PROTECTION-VARIABLE-PROTOTYPE)
           (prot END-TO-END-PROTECTION)
           (rN NONQUEUED-RECEIVER-COM-SPEC)
           (rQ QUEUED-RECEIVER-COM-SPEC))
    (let ((prof (endToEndProfile prot)))
      (=> (and (is_PROFILE_02 prof)
               (e2eVarProtOf p v))
          (and
            (=> (or (not (and (uses_nonqueued_rcs p rN)
                              (correspondence_ok_NQ p v rN)))
                    (and (uses_nonqueued_rcs p rN)
                         (not (has_rcs_maxNoNewOrRepeatedData_NQ rN))))
                (has_profile_maxNoNewOrRepeatedData prof))
            (=> (or (not (and (uses_queued_rcs p rQ)
                              (correspondence_ok_Q p v rQ)))
                    (and (uses_queued_rcs p rQ)
                         (not (has_rcs_maxNoNewOrRepeatedData_Q rQ))))
                (has_profile_maxNoNewOrRepeatedData prof))))))

