; Trigger: a sending SwComponentType owns a DataPrototypeGroup in role dpgRequiresCoherence
(declare-fun isSendingSwComponentType (SW-COMPONENT-TYPE) Bool)
(declare-fun ownsDataPrototypeGroup_dpgRequiresCoherence
  (SW-COMPONENT-TYPE DATA-PROTOTYPE-GROUP) Bool)

; Producing / consuming runnable membership and propagation time
(declare-fun isProducingRunnableForGroup
  (RUNNABLE-ENTITY DATA-PROTOTYPE-GROUP) Bool)
(declare-fun isConsumingRunnableForGroup
  (RUNNABLE-ENTITY DATA-PROTOTYPE-GROUP) Bool)
(declare-fun runnableBelongsToComponent
  (RUNNABLE-ENTITY SW-COMPONENT-TYPE) Bool)

; Time abstraction: when values of a group are propagated to a runnable
; (e.g. logical clock ticks or scheduling steps)
(declare-sort TIME 0)
(declare-fun propagationTime
  (RUNNABLE-ENTITY DATA-PROTOTYPE-GROUP) TIME)

; Core coherence requirement:
; For a given group g that requires coherence in component c,
; all consuming runnables outside the producing group see the group
; at the same propagation time.
(assert
  (forall ((c SW-COMPONENT-TYPE) (g DATA-PROTOTYPE-GROUP))
    (=> (and (isSendingSwComponentType c)
             (ownsDataPrototypeGroup_dpgRequiresCoherence c g))
        (forall ((r1 RUNNABLE-ENTITY) (r2 RUNNABLE-ENTITY))
          (=> (and (isConsumingRunnableForGroup r1 g)
                   (isConsumingRunnableForGroup r2 g)
                   (runnableBelongsToComponent r1 c)
                   (runnableBelongsToComponent r2 c)
                   (not (isProducingRunnableForGroup r1 g))
                   (not (isProducingRunnableForGroup r2 g)))
              (= (propagationTime r1 g)
                 (propagationTime r2 g)))))))

;---------------------------------------------------------------
; TPS_SWCT_01476 – implicit communication within same RunnableEntityGroup
;---------------------------------------------------------------

; Association of runnables to groups
(declare-fun runnableInGroup
  (RUNNABLE-ENTITY RUNNABLE-ENTITY-GROUP) Bool)

; Implicit communication relation between runnables via a VariableDataPrototypeGroup
(declare-fun implicitlyCommunicatesViaGroup
  (RUNNABLE-ENTITY RUNNABLE-ENTITY DATA-PROTOTYPE-GROUP) Bool)

; Visibility time of implicitly communicated values
(declare-fun valueVisibleTime
  (RUNNABLE-ENTITY RUNNABLE-ENTITY DATA-PROTOTYPE-GROUP) TIME)

; Termination time of producing runnable
(declare-fun terminationTime
  (RUNNABLE-ENTITY) TIME)

; If sender and receiver of the same implicitly communicated VariableDataPrototypes
; are associated with the same RunnableEntityGroup, then:
; - TPS_SWCT_01472/01473/01475 apply (captured abstractly by a predicate),
; - and updates become visible immediately after producer termination.
(declare-fun basicImplicitCommPoliciesHold
  (RUNNABLE-ENTITY RUNNABLE-ENTITY DATA-PROTOTYPE-GROUP) Bool)

(assert
  (forall ((s RUNNABLE-ENTITY) (r RUNNABLE-ENTITY)
           (g RUNNABLE-ENTITY-GROUP) (d DATA-PROTOTYPE-GROUP))
    (=> (and (implicitlyCommunicatesViaGroup s r d)
             (runnableInGroup s g)
             (runnableInGroup r g))
        (and (basicImplicitCommPoliciesHold s r d)
             (= (valueVisibleTime s r d)
                (terminationTime s))))))

