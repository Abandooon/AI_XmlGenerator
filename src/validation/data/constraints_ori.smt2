; 不在静态结构层面强制，因此此模板中不添加对应 assert。


; =========================
; SMT Template for TPS_SWCT_01330 .. TPS_SWCT_01336
; =========================

; Sort declarations
(declare-sort ATOMIC-SW-COMPONENT-TYPE 0)
(declare-sort SWC-INTERNAL-BEHAVIOR 0)
(declare-sort RUNNABLE-ENTITY 0)
(declare-sort VARIABLE-ACCESS 0)
(declare-sort VARIABLE-DATA-PROTOTYPE 0)
(declare-sort DATA-RECEIVED-EVENT 0)
(declare-sort DATA-SEND-COMPLETED-EVENT 0)
(declare-sort WAIT-POINT 0)
(declare-sort TIME-VALUE 0)

; ---------- Common structural predicates ----------
; ownership / containment
(declare-fun has_internalBehavior (ATOMIC-SW-COMPONENT-TYPE SWC-INTERNAL-BEHAVIOR) Bool)
(declare-fun has_runnable (SWC-INTERNAL-BEHAVIOR RUNNABLE-ENTITY) Bool)

; variable accesses on a runnable
(declare-fun has_dataSendPoint (RUNNABLE-ENTITY VARIABLE-ACCESS) Bool)
(declare-fun has_dataWriteAccess (RUNNABLE-ENTITY VARIABLE-ACCESS) Bool)
(declare-fun has_dataReadAccess (RUNNABLE-ENTITY VARIABLE-ACCESS) Bool)
(declare-fun has_dataReceivePointByArgument (RUNNABLE-ENTITY VARIABLE-ACCESS) Bool)
(declare-fun has_dataReceivePointByValue (RUNNABLE-ENTITY VARIABLE-ACCESS) Bool)

; wait points on a runnable
(declare-fun has_waitPoint (RUNNABLE-ENTITY WAIT-POINT) Bool)

; wait point attributes
(declare-fun has_timeout (WAIT-POINT TIME-VALUE) Bool)
(declare-fun has_triggerRef (WAIT-POINT) Bool)

; runnable category
(declare-fun has_category (RUNNABLE-ENTITY String) Bool)

; events in internal behavior
(declare-fun has_dataSendCompletedEvent (SWC-INTERNAL-BEHAVIOR DATA-SEND-COMPLETED-EVENT) Bool)
(declare-fun has_dataReceivedEvent (SWC-INTERNAL-BEHAVIOR DATA-RECEIVED-EVENT) Bool)

; event source reference
(declare-fun has_eventSourceRef (DATA-SEND-COMPLETED-EVENT VARIABLE-ACCESS) Bool)

; =========================
; TPS_SWCT_01330 - RunnableEntity can also have dataSendPoints
; Relationship narrative only -> no hard logical axiom introduced.
; =========================

; =========================
; TPS_SWCT_01331 - dataWriteAccess vs. dataSendPoint
; Presence of a dataSendPoint per definition lets the corresponding RunnableEntity attain cat. 1B.
; We model: if a runnable has at least one dataSendPoint then its category is "1B".
; =========================
(assert
  (forall ((r RUNNABLE-ENTITY))
    (=> (exists ((va VARIABLE-ACCESS)) (has_dataSendPoint r va))
        (has_category r "1B"))))

; =========================
; TPS_SWCT_01332 - dataReceivePointByValue vs. dataReceivePointByArgument
; Purely descriptive comparison -> no hard axiom.
; =========================

; =========================
; TPS_SWCT_01333 - dataReceivePointByValue/dataReceivePointByArgument vs. dataReadAccess
; Describes timing/locking behavior, which is runtime semantics -> not encoded here.
; =========================

; =========================
; TPS_SWCT_01334 - RunnableEntitys of category 1 may have dataReceivePointByValues/dataReceivePointByArguments
; "may have" is permissive, not mandatory -> no axiom.
; =========================

; =========================
; TPS_SWCT_01335 - Combine dataReceivePointByValue or dataReceivePointByArgument with a WaitPoint
; It is possible to combine receive points with a WaitPoint, but:
; In case of non-queued communication it is NOT supported that a DataReceivedEvent is used in combination with a WaitPoint.
; We only capture the prohibition part, abstracting "non-queued" as a predicate.
; =========================

; abstract predicate: whether a DATA-RECEIVED-EVENT uses non-queued communication
(declare-fun isNonQueued (DATA-RECEIVED-EVENT) Bool)

; abstract relation: which wait point is associated with a given DataReceivedEvent (if any)
(declare-fun uses_waitPoint (DATA-RECEIVED-EVENT WAIT-POINT) Bool)

; Prohibition: for non-queued communication, a DataReceivedEvent must not be used with a WaitPoint
(assert
  (forall ((e DATA-RECEIVED-EVENT) (w WAIT-POINT))
    (=> (isNonQueued e)
        (not (uses_waitPoint e w)))))

; Additionally, every WAIT-POINT must have exactly one TIMEOUT and one TRIGGER-REF
(assert
  (forall ((w WAIT-POINT))
    (exists ((t TIME-VALUE)) (has_timeout w t)))
(assert
  (forall ((w WAIT-POINT) (t1 TIME-VALUE) (t2 TIME-VALUE))
    (=> (and (has_timeout w t1) (has_timeout w t2))
        (= t1 t2))))

(assert
  (forall ((w WAIT-POINT))
    (has_triggerRef w))
; triggerRef is functional at the XML level; we model only existence as Bool here.

; =========================
; TPS_SWCT_01336 - dataSendPoint also allows for the definition of a DataSendCompletedEvent
; If a DataSendCompletedEvent exists, its EVENT-SOURCE-REF must point to a dataSendPoint of some RunnableEntity
; within the same SWC-INTERNAL-BEHAVIOR.
; =========================
(assert
  (forall ((ib SWC-INTERNAL-BEHAVIOR) (e DATA-SEND-COMPLETED-EVENT))
    (=> (has_dataSendCompletedEvent ib e)
        (exists ((r RUNNABLE-ENTITY) (va VARIABLE-ACCESS))
          (and (has_runnable ib r)
               (has_dataSendPoint r va)
               (has_eventSourceRef e va))))))

