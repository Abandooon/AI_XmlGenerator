; TPS_SWCT_01151 - RunnableEntitys do not have further attributes
; TPS_SWCT_01152 - InternalBehavior does not have further attributes
; 语义：针对上述“用于 NvM API 的 InternalBehavior 及其 RunnableEntity”，
; 不应再定义额外属性（ExclusiveAreas、per-instance memory、inter-runnable variables 等）。
; 这里引入谓词表示“存在额外属性”，并给出禁止性公理。
; ------------------------------------------------------------

; 额外属性谓词（抽象表示）
(declare-fun has_exclusiveArea (RUNNABLE-ENTITY) Bool)
(declare-fun has_perInstanceMemory (RUNNABLE-ENTITY) Bool)
(declare-fun has_interRunnableVariable (RUNNABLE-ENTITY) Bool)

(declare-fun ib_has_exclusiveArea (INTERNAL-BEHAVIOR) Bool)
(declare-fun ib_has_perInstanceMemory (INTERNAL-BEHAVIOR) Bool)
(declare-fun ib_has_interRunnableVariable (INTERNAL-BEHAVIOR) Bool)

; 辅助谓词：InternalBehavior 是否“用于 NvM API”
(declare-fun isNvMApiInternalBehavior (INTERNAL-BEHAVIOR) Bool)

; 逻辑：如果 InternalBehavior 被标记为 isNvMApiInternalBehavior，
; 则其自身和其 RunnableEntity 不得有上述“额外属性”。
(assert
  (forall ((ib INTERNAL-BEHAVIOR))
    (=> (isNvMApiInternalBehavior ib)
        (and
          (not (ib_has_exclusiveArea ib))
          (not (ib_has_perInstanceMemory ib))
          (not (ib_has_interRunnableVariable ib))
          (forall ((r RUNNABLE-ENTITY))
            (=> (has_serverRunnable ib r)
                (and
                  (not (has_exclusiveArea r))
                  (not (has_perInstanceMemory r))
                  (not (has_interRunnableVariable r))))))))


