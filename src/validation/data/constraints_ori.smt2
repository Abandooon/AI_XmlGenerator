;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; constr_2016 - Connections between SwComponentPrototypes of type ServiceProxySwComponentType
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(declare-sort PORT-PROTOTYPE 0)
(declare-sort SW-COMPONENT-PROTOTYPE 0)
(declare-sort SERVICE-PROXY-SW-COMPONENT-TYPE 0)

; PortPrototype -> its owning SwComponentPrototype
(declare-fun ownerSwComponent (PORT-PROTOTYPE) SW-COMPONENT-PROTOTYPE)

; SwComponentPrototype -> TYPE-TREF is SERVICE-PROXY-SW-COMPONENT-TYPE ?
(declare-fun isServiceProxyComponent (SW-COMPONENT-PROTOTYPE) Bool)

; Connection between two PortPrototypes (direction-agnostic)
(declare-fun connected (PORT-PROTOTYPE PORT-PROTOTYPE) Bool)

; Symmetry of 'connected' (optional but typical)
(assert
  (forall ((p1 PORT-PROTOTYPE) (p2 PORT-PROTOTYPE))
    (= (connected p1 p2) (connected p2 p1))))

; Core constraint:
; A connection between PortPrototypes belonging to SwComponentPrototypes
; where both are typed by ServiceProxySwComponentType is not permitted.
(assert
  (forall ((p1 PORT-PROTOTYPE) (p2 PORT-PROTOTYPE))
    (=> (connected p1 p2)
        (let ((c1 (ownerSwComponent p1))
              (c2 (ownerSwComponent p2)))
          (not (and (isServiceProxyComponent c1)
                    (isServiceProxyComponent c2)))))))

