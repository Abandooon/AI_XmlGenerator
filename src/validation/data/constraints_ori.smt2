; =========================
; Constraint 2056:
; Consistency of RapidPrototypingScenario with respect to rptSystem and rptArHook references
; =========================

; Helper predicates: uniqueness of referenced Systems
(declare-fun unique_rptSystemTarget (RAPID-PROTOTYPING-SCENARIO) Bool)
(declare-fun unique_rptArHookTarget (RAPID-PROTOTYPING-SCENARIO) Bool)

; Axiomatize uniqueness in terms of has_rptSystemRef / has_rptArHookRef
(assert
  (forall ((s RAPID-PROTOTYPING-SCENARIO))
    (= (unique_rptSystemTarget s)
       (exists ((sys SYSTEM))
         (and (has_rptSystemRef s sys)
              (forall ((sys2 SYSTEM))
                (=> (has_rptSystemRef s sys2)
                    (= sys2 sys))))))))

(assert
  (forall ((s RAPID-PROTOTYPING-SCENARIO))
    (= (unique_rptArHookTarget s)
       (or
         (forall ((sys SYSTEM)) (not (has_rptArHookRef s sys)))
         (exists ((sys SYSTEM))
           (and (has_rptArHookRef s sys)
                (forall ((sys2 SYSTEM))
                  (=> (has_rptArHookRef s sys2)
                      (= sys2 sys)))))))))

; Core constraint: one and only one System for rptSystem, and if any rptArHook then one and only one other System
(assert
  (forall ((s RAPID-PROTOTYPING-SCENARIO))
    (and
      (unique_rptSystemTarget s)
      (=> (exists ((sys SYSTEM)) (has_rptArHookRef s sys))
          (and (unique_rptArHookTarget s)
               (forall ((sys1 SYSTEM) (sys2 SYSTEM))
                 (=> (and (has_rptSystemRef s sys1)
                          (has_rptArHookRef s sys2))
                     (distinct sys1 sys2))))))))

