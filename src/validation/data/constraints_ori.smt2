(declare-fun categoryIs_SCALE_RATIONAL_AND_TEXTTABLE (CATEGORY-STRING) Bool)
(declare-fun categoryIs_TEXTTABLE (CATEGORY-STRING) Bool)

(declare-fun has_compuPhysToInternal (COMPU-METHOD COMPU) Bool)
(declare-fun has_compuInternalToPhys (COMPU-METHOD COMPU) Bool)
(declare-fun has_compuDefaultValue (COMPU-METHOD) Bool)

; COMPU-SCALE structure
(declare-fun has_compuScales (COMPU-METHOD COMPU-SCALE) Bool)
(declare-fun has_compuInverseValue (COMPU-SCALE COMPU-CONST) Bool)
(declare-fun has_compuConst (COMPU-SCALE COMPU-CONST) Bool)
(declare-fun has_lowerLimit (COMPU-SCALE LIMIT) Bool)
(declare-fun has_upperLimit (COMPU-SCALE LIMIT) Bool)

; Behavioral predicates (not directly observable from XML)
(declare-fun inputOutsidePlausibilityLimits (COMPU-METHOD) Bool)
(declare-fun defaultValueUsedForOutOfRange (COMPU-METHOD) Bool)

; -------------------------
; 1) Usage of swIntendedResolution (informational)
;     Non-binding: no hard logical constraint, only documentation.
; -------------------------

; No assert: swIntendedResolution is a non-binding requirement that
; shall later be considered when defining an appropriate CompuMethod.

; -------------------------
; 2) Condition for compuInternalToPhys definition (Table 5.74 Ann.1)
;    For certain categories (LINEAR, SCALE_LINEAR), compuInternalToPhys
;    shall be defined if not already defined by compuPhysToInternal.
; -------------------------

(assert
  (forall ((m COMPU-METHOD) (c CATEGORY-STRING))
    (=> (has_category m c)
        (=> (or (categoryIs_LINEAR c)
                (categoryIs_SCALE_LINEAR c))
            (or (exists ((cp COMPU)) (has_compuPhysToInternal m cp))
                (exists ((ci COMPU)) (has_compuInternalToPhys m ci)))))))

; -------------------------
; 3) Definition of both conversion directions or inverse value
;    (Table 5.74 Ann.2)
;    For certain categories (RAT_FUNC, SCALE_RAT_FUNC, etc.), both
;    compuPhysToInternal and compuInternalToPhys shall be defined
;    unless some CompuScale has compuInverseValue.
; -------------------------

(assert
  (forall ((m COMPU-METHOD) (c CATEGORY-STRING))
    (=> (has_category m c)
        (=> (or (categoryIs_RAT_FUNC c)
                (categoryIs_SCALE_RAT_FUNC c))
            (let ((hasInv
                    (exists ((s COMPU-SCALE) (k COMPU-CONST))
                      (and (has_compuScales m s)
                           (has_compuInverseValue s k)))))
              (=> (not hasInv)
                  (and (exists ((cp COMPU)) (has_compuPhysToInternal m cp))
                       (exists ((ci COMPU)) (has_compuInternalToPhys m ci))))))))

; -------------------------
; 4) Non-applicability with CompuConst (Table 5.74 Ann.3)
;    For category SCALE_RATIONAL_AND_TEXTTABLE, compuPhysToInternal
;    is not applicable if any CompuScale has compuConst.
; -------------------------

(assert
  (forall ((m COMPU-METHOD) (c CATEGORY-STRING))
    (=> (has_category m c)
        (=> (categoryIs_SCALE_RATIONAL_AND_TEXTTABLE c)
            (let ((hasConst
                    (exists ((s COMPU-SCALE) (k COMPU-CONST))
                      (and (has_compuScales m s)
                           (has_compuConst s k)))))
              (=> hasConst
                  (not (exists ((cp COMPU)) (has_compuPhysToInternal m cp))))))))

; -------------------------
; 5) Limit definition requirement (Table 5.74 Ann.4)
;    For certain categories (RAT_FUNC, SCALE_RAT_FUNC, etc.), each
;    CompuScale shall define both lowerLimit and upperLimit.
; -------------------------

(assert
  (forall ((m COMPU-METHOD) (c CATEGORY-STRING))
    (=> (has_category m c)
        (=> (or (categoryIs_RAT_FUNC c)
                (categoryIs_SCALE_RAT_FUNC c))
            (forall ((s COMPU-SCALE))
              (=> (has_compuScales m s)
                  (and (exists ((ll LIMIT)) (has_lowerLimit s ll))
                       (exists ((ul LIMIT)) (has_upperLimit s ul))))))))

; -------------------------
; 6) Structural restrictions from constr_1134 (Table 5.74 Ann.5)
;    This template only provides the hook predicate has_compuInverseValue.
;    Actual constr_1134 rules are modeled in its own SMT template.
; -------------------------

; No additional assert here; constr_1134 will refer to has_compuInverseValue.

; -------------------------
; 7) Default value on out-of-limit conversion (Table 5.74 Ann.6)
;    Behavioral recommendation: if input is outside plausibility limits
;    and compuDefaultValue is present, it should be used.
;    Modeled as a soft / informational implication.
; -------------------------

(assert
  (forall ((m COMPU-METHOD))
    (=> (and (inputOutsidePlausibilityLimits m)
             (has_compuDefaultValue m))
        (defaultValueUsedForOutOfRange m)))

; (check-sat) is intentionally omitted; the validator will add it.


