;-------------------------------
; Logical axioms
;-------------------------------

;---------------------------------------------------------------
; constr_1234 - Value of RunnableEntity.symbol
;---------------------------------------------------------------
(assert
  (forall ((c NV-BLOCK-SW-COMPONENT-TYPE)
           (r RUNNABLE-ENTITY)
           (e RTE-EVENT))
    (=> (and (ownsRunnable c r)
             (isTriggeredBy r e)
             (isOperationInvokedEvent e))
        (isNvMApiName (runnableSymbol r)))))

;---------------------------------------------------------------
; constr_1237 - Scope of mapped ClientServerOperations
;   firstOperation and secondOperation each belong to exactly
;   one (and different) ClientServerInterface.
;   Modeled via interfaceOfOperation as a functional mapping
;   to an interface id; we enforce inequality for the two roles.
;---------------------------------------------------------------
(assert
  (forall ((m CLIENT-SERVER-OPERATION-MAPPING))
    (let ((fo (firstOperation m))
          (so (secondOperation m)))
      (and
        ; each operation has exactly one interface (functionality
        ; of interfaceOfOperation is assumed globally)
        (distinct fo so)
        (distinct (interfaceOfOperation fo)
                  (interfaceOfOperation so))))))

;---------------------------------------------------------------
; constr_1238 - Scope of mapped ApplicationErrors
;   firstApplicationError and secondApplicationError belong to
;   exactly one and different ClientServerInterfaces.
;---------------------------------------------------------------
(assert
  (forall ((m CLIENT-SERVER-APPLICATION-ERROR-MAPPING))
    (let ((fe (firstApplicationError m))
          (se (secondApplicationError m)))
      (and
        (distinct fe se)
        (distinct (interfaceOfApplicationError fe)
                  (interfaceOfApplicationError se))))))

;---------------------------------------------------------------
; constr_1240 - Consistency of ArgumentDataPrototypes
;   For each argument owned by firstOperation and secondOperation
;   there exists a DataPrototypeMapping owned by the same
;   ClientServerOperationMapping that references it in either
;   firstDataPrototype or secondDataPrototype.
;---------------------------------------------------------------
(assert
  (forall ((m CLIENT-SERVER-OPERATION-MAPPING)
           (op CLIENT-SERVER-OPERATION)
           (arg ARGUMENT-DATA-PROTOTYPE))
    (=> (and (or (= op (firstOperationOfMapping m))
                 (= op (secondOperationOfMapping m)))
             (ownsArgument op arg))
        (exists ((mp DATA-PROTOTYPE-MAPPING))
          (and (ownsDataPrototypeMapping m mp)
               (or (= (firstDataPrototype mp) arg)
                   (= (secondDataPrototype mp) arg)))))))

;---------------------------------------------------------------
; constr_1241 - Compound Primitive Data Types and invalidValue
;   If category is set and not equal to "STRING", then
;   invalidValue must not be defined.
;---------------------------------------------------------------
(assert
  (forall ((t APPLICATION-PRIMITIVE-DATA-TYPE))
    (let ((cat (category t)))
      (=> (and (is-some cat)
               (not (= (get cat) "STRING")))
          (not (hasInvalidValue t)))))

)

;---------------------------------------------------------------
; constr_1242 - Restriction of invalidValue for STRING category
;   For STRING category, invalidValue (if present) must be either
;   a compatible ApplicationValueSpecification or a ConstantReference
;   that in turn points to a compatible ApplicationValueSpecification.
;---------------------------------------------------------------
(assert
  (forall ((t APPLICATION-PRIMITIVE-DATA-TYPE))
    (let ((cat (category t)))
      (=> (and (is-some cat)
               (= (get cat) "STRING")
               (hasInvalidValue t))
          (or (invalidValueIsApplicationValueSpec t)
              (and (invalidValueIsConstantRef t)
                   (constantRefTargetsCompatibleAppValueSpec t))))))

)

