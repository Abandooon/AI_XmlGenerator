;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; semantic predicate: connectorExistsInVariant(c) – whether connector is present in a given system variant
(declare-fun connectorExistsInVariant_Asm (ASSEMBLY-SW-CONNECTOR) Bool)
(declare-fun connectorExistsInVariant_Del (DELEGATION-SW-CONNECTOR) Bool)
(declare-fun connectorExistsInVariant_PT (PASS-THROUGH-SW-CONNECTOR) Bool)

; semantic predicate: rteBehavesAsUnconnected(p) – RTE API behaves as if port is unconnected
(declare-sort PORT-PROTOTYPE 0)
(declare-fun rteBehavesAsUnconnected (PORT-PROTOTYPE) Bool)

; attachment relation: connectorAttachedToPort(c, p)
(declare-fun connectorAttachedToPort_Asm (ASSEMBLY-SW-CONNECTOR PORT-PROTOTYPE) Bool)
(declare-fun connectorAttachedToPort_Del (DELEGATION-SW-CONNECTOR PORT-PROTOTYPE) Bool)
(declare-fun connectorAttachedToPort_PT (PASS-THROUGH-SW-CONNECTOR PORT-PROTOTYPE) Bool)

; If a SwConnector does not exist in a variant, the attached PortPrototype behaves as unconnected.
(assert
  (forall ((c ASSEMBLY-SW-CONNECTOR) (p PORT-PROTOTYPE))
    (=> (and (connectorAttachedToPort_Asm c p)
             (not (connectorExistsInVariant_Asm c)))
        (rteBehavesAsUnconnected p)))
)

(assert
  (forall ((c DELEGATION-SW-CONNECTOR) (p PORT-PROTOTYPE))
    (=> (and (connectorAttachedToPort_Del c p)
             (not (connectorExistsInVariant_Del c)))
        (rteBehavesAsUnconnected p)))
)

(assert
  (forall ((c PASS-THROUGH-SW-CONNECTOR) (p PORT-PROTOTYPE))
    (=> (and (connectorAttachedToPort_PT c p)
             (not (connectorExistsInVariant_PT c)))
        (rteBehavesAsUnconnected p)))
)

