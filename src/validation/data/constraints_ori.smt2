        (or (= (swImplPolicy t) "STANDARD")
            (= (swImplPolicy t) "QUEUED")))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Constraint constr_1170
; Interpretation of attribute maxDeltaCounterInit owned by EndToEndDescription
; (PROFILE_01 case)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Abstract predicate: an EndToEndProtection is associated with a given
; RPortPrototype and EndToEndProtectionVariablePrototype.
(declare-fun e2eProtectionFor (R-PORT-PROTOTYPE END-TO-END-PROTECTION-VARIABLE-PROTOTYPE) END-TO-END-PROTECTION)

; Helper predicate: correspondence rule concerning the referenced VariableDataPrototype
; is fulfilled (details of the rule are abstracted).
(declare-fun correspondenceRuleFulfilled (END-TO-END-PROTECTION-VARIABLE-PROTOTYPE R-PORT-PROTOTYPE) Bool)

; If receiver == dataElement and RPortPrototype.requiredComSpec.maxDeltaCounterInit is defined,
; then its value is preferred over EndToEndProfile.maxDeltaCounterInit.
; We encode this as equality when both exist.
(assert
  (forall ((r R-PORT-PROTOTYPE)
           (v END-TO-END-PROTECTION-VARIABLE-PROTOTYPE))
    (let* ((prot (e2eProtectionFor r v))
           (prof (endToEndProfile_of_EndToEndProtection prot))
           (cat  (category_EndToEndDescription prof)))
      (=> (and (= cat "PROFILE_01")
               (= (receiver_of_E2EProtVar v)
                  (dataElement_of_ReceiverComSpec (requiredComSpec_of_RPort r)))
               (has_rcs_maxDeltaCounterInit (requiredComSpec_of_RPort r)))
          (=> (has_e2e_maxDeltaCounterInit prof)
              (= (rcs_maxDeltaCounterInit (requiredComSpec_of_RPort r))
                 (e2e_maxDeltaCounterInit prof)))))))

; If category = PROFILE_01 and either the correspondence rule is not fulfilled
; or RPortPrototype.requiredComSpec.maxDeltaCounterInit is not defined,
; then EndToEndProfile.maxDeltaCounterInit shall exist.
(assert
  (forall ((r R-PORT-PROTOTYPE)
           (v END-TO-END-PROTECTION-VARIABLE-PROTOTYPE))
    (let* ((prot (e2eProtectionFor r v))
           (prof (endToEndProfile_of_EndToEndProtection prot))
           (cat  (category_EndToEndDescription prof)))
      (=> (= cat "PROFILE_01")
          (=> (or (not (correspondenceRuleFulfilled v r))
                  (not (has_rcs_maxDeltaCounterInit (requiredComSpec_of_RPort r))))
              (has_e2e_maxDeltaCounterInit prof)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Constraint constr_1171
; Interpretation of attribute maxDeltaCounterInit of EndToEndDescription
; (PROFILE_02 case)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(assert
  (forall ((r R-PORT-PROTOTYPE)
           (v END-TO-END-PROTECTION-VARIABLE-PROTOTYPE))
    (let* ((prot (e2eProtectionFor r v))
           (prof (endToEndProfile_of_EndToEndProtection prot))
           (cat  (category_EndToEndDescription prof)))
      (=> (= cat "PROFILE_02")
          (=> (or (not (correspondenceRuleFulfilled v r))
                  (not (has_rcs_maxDeltaCounterInit (requiredComSpec_of_RPort r))))
              (has_e2e_maxDeltaCounterInit prof)))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Constraint constr_1172
; Allowed values of SwCalibrationAccessEnum for ModeDeclarationGroupPrototype
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(assert
  (forall ((m MODE-DECLARATION-GROUP-PROTOTYPE))
    (=> (has_swCalibrationAccess m)
        (or (= (swCalibrationAccess m) "notAccessible")
            (= (swCalibrationAccess m) "readOnly")))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Constraint constr_1173
; Applicability of AutosarParameterRef referencing a VariableDataPrototype
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; A reference from AutosarParameterRef to VariableDataPrototype is only
; applicable if the AutosarParameterRef is used in the context of SwAxisGrouped.
; We model this as: whenever an AUTOSAR-PARAMETER-REF targets a VARIABLE-DATA-PROTOTYPE,
; there must exist some SwAxisGrouped in whose context it is used.
(assert
  (forall ((p AUTOSAR-PARAMETER-REF))
    (exists ((g SW-AXIS-GROUPED))
      (=> true
          (usedInContext p g))))

