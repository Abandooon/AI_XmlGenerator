(define-fun isDisallowedImplCategory ((c String)) Bool
  (or (= c "STRUCTURE")
      (= c "ARRAY")
      (= c "UNION")
      (= c "FUNCTION_REFERENCE")
      (= c "DATA_REFERENCE")))

; Helper predicate: category is VALUE or TYPE_REFERENCE
