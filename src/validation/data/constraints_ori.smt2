; standard does not impose a logical relation here that is checkable
; on static XML alone.

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; TPS_SWCT_01532 - The role of ModeErrorBehavior.defaultMode
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(assert
  (forall ((m MODE-ERROR-BEHAVIOR))
    (=> (and (has_errorReactionPolicy m)
             (is_defaultModePolicy (errorReactionPolicy m)))
        (has_defaultModeRef m))))

; Note: defaultModeRef is optional in general, but must be present
; whenever errorReactionPolicy is the literal 'defaultMode'.

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; TPS_SWCT_01533 - initialMode assumed if no modeManagerErrorBehavior
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; This is a behavioral / semantic assumption at runtime. On static XML
; level we only ensure that INITIAL-MODE-REF exists (cardinality via SHACL).
; No additional SMT axiom is introduced, as the "assumed applicable mode"
; is not directly observable in the model.

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; TPS_SWCT_01534 - initialMode assumed if no modeUserErrorBehavior
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Same reasoning as TPS_SWCT_01533: no additional static SMT constraint.

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; TPS_SWCT_01537 - GID synchronization roles
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; If a ServiceNeeds of kind DoIpGidSynchronizationNeeds is used,
; then the associated RoleBasedPortAssignment shall use the role
; 'CallbackTriggerGIDSynchronization'.

(assert
  (forall ((s SWC-SERVICE-DEPENDENCY)
           (sn SERVICE-NEEDS)
           (g DO-IP-GID-SYNCHRONIZATION-NEEDS)
           (rba ROLE-BASED-PORT-ASSIGNMENT)
           (rid IDENTIFIER))
    (=> (and (has_serviceNeeds s)
             (= sn (serviceNeeds s))
             (is_DoIpGidSynchronizationNeeds sn g)
             (has_role rba)
             (= rid (role rba)))
        (is_CallbackTriggerGIDSynchronization rid))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; TPS_SWCT_01538 - GID roles for DoIpGidNeeds
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; If a ServiceNeeds of kind DoIpGidNeeds is used,
; then the associated RoleBasedPortAssignment shall use the role
; 'CallbackGetGID'.

(assert
  (forall ((s SWC-SERVICE-DEPENDENCY)
           (sn SERVICE-NEEDS)
           (g DO-IP-GID-NEEDS)
           (rba ROLE-BASED-PORT-ASSIGNMENT)
           (rid IDENTIFIER))
    (=> (and (has_serviceNeeds s)
             (= sn (serviceNeeds s))
             (is_DoIpGidNeeds sn g)
             (has_role rba)
             (= rid (role rba)))
        (is_CallbackGetGID rid))))

