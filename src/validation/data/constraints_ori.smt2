; When any mapped manager mode is entered, the corresponding user mode is entered.
(assert
  (forall ((muMd MODE-DECLARATION) (mm MODE-MANAGER) (mmMd MODE-DECLARATION))
    (=> (and (mappedManagerMode muMd mm mmMd)
             (entered mmMd))
        (entered muMd))))

; When any mapped manager mode is exited and the new mode is not mapped
; to a related mode of the mode user, the corresponding user mode is exited.
(assert
  (forall ((muMd MODE-DECLARATION) (mm MODE-MANAGER) (mmMd MODE-DECLARATION))
    (=> (and (mappedManagerMode muMd mm mmMd)
             (exited mmMd)
             (not (mappedToRelatedUserMode mm (modeUserOf muMd))))
        (exited muMd))))

