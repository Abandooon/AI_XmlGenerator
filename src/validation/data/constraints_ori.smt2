; 1) Constr_ClientServerOperation_SyncAsyncExclusivity
; 语义：同一个 ClientServerOperation 实例不能同时被同步和异步调用。
; 需要运行时/行为信息，模板中仅提供抽象谓词。

(declare-sort CLIENT-SERVER-OPERATION 0)

; 是否存在某个同步调用使用该操作
(declare-fun hasSynchronousInvocation (CLIENT-SERVER-OPERATION) Bool)
; 是否存在某个异步调用使用该操作
(declare-fun hasAsynchronousInvocation (CLIENT-SERVER-OPERATION) Bool)

(assert
  (forall ((op CLIENT-SERVER-OPERATION))
    (not (and (hasSynchronousInvocation op)
              (hasAsynchronousInvocation op)))))

