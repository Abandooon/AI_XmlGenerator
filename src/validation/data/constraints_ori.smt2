; ---------- Logical axioms ----------

; ===== constr_1146: Applicability of a symbol for a CompuScale in C code =====
; If a COMPU-SCALE has a SYMBOL, then the category of its enclosing COMPU-METHOD
; must be one of the four allowed categories.
(assert
  (forall ((cs COMPU-SCALE))
    (=> (has_symbol cs)
        (let ((cm (enclosingCompuMethod cs)))
          (and (has_category_CompuMethod cm)
               (or (= (category_CompuMethod cm) SCALE_LINEAR_AND_TEXTTABLE)
                   (= (category_CompuMethod cm) SCALE_RATIONAL_AND_TEXTTABLE)
                   (= (category_CompuMethod cm) TEXTTABLE)
                   (= (category_CompuMethod cm) BITFIELD_TEXTTABLE)))))))

; ===== constr_1147: Standardized values for category of PortGroup =====
; Documentation-level: MODE_MANAGEMENT and PARTIAL_NETWORKING are reserved.
; We model that if category equals one of these, it is considered reserved.
(declare-fun isReservedCategory_PortGroup (PORT-GROUP) Bool)
(assert
  (forall ((pg PORT-GROUP))
    (= (isReservedCategory_PortGroup pg)
       (and (has_category_PortGroup pg)
            (or (= (category_PortGroup pg) MODE_MANAGEMENT)
                (= (category_PortGroup pg) PARTIAL_NETWORKING))))))

; ===== constr_1148: PortInterfaces used to connect to NvBlockSwComponentTypes =====
; For every PortInterface that is used by an NvBlockSwComponentType, IS-SERVICE must be false.
(assert
  (forall ((nv NV-BLOCK-SW-COMPONENT-TYPE) (pi PORT-INTERFACE))
    (=> (usesPortInterface nv pi)
        (and (has_isService pi)
             (= (isService pi) false)))))

; ===== constr_1149: PortPrototypes used for NV data management =====
; If a PortPrototype is used for NV data management, then its ClientServerInterface
; must be compatible to the MOD_GeneralBlueprints-derived interfaces.
(assert
  (forall ((pp PORT-PROTOTYPE) (pi PORT-INTERFACE))
    (=> (and (isNvDataManagementPort pp)
             (typedBy pp pi))
        (isCompatibleToMOD_GeneralBlueprints pi)))

)

; ===== constr_1150: Usage of valueType for PortDefinedArgumentValue =====
; valueType associated with PortDefinedArgumentValue shall be of category VALUE or TYPE_REFERENCE.
; If category is TYPE_REFERENCE, then the target data type's category must be VALUE.
(assert
  (forall ((pdav PORT-DEFINED-ARGUMENT-VALUE))
    (=> (has_valueType pdav)
        (let ((dt (valueType pdav)))
          (and (has_category_AutosarDataType dt)
               (or (= (category_AutosarDataType dt) VALUE)
                   (= (category_AutosarDataType dt) TYPE_REFERENCE)))))))

(assert
  (forall ((pdav PORT-DEFINED-ARGUMENT-VALUE))
    (=> (and (has_valueType pdav)
             (= (category_AutosarDataType (valueType pdav)) TYPE_REFERENCE))
        (= (category_AutosarDataType (valueType pdav)) VALUE)))

; Note: The last implication encodes the textual "latter case only supported if category of target data type is VALUE".
; In practice, this forces TYPE_REFERENCE only in combination with VALUE, which is contradictory unless
; the modeling distinguishes "valueType category" vs "target data type category". This template keeps it literal.

; ===== constr_1151: Applicability of PortInterfaceMapping =====
; A PortInterfaceMapping is applicable and valid for a SwConnector only if the two PortPrototypes
; referenced by the SwConnector are typed by the same two PortInterfaces mapped by the PortInterfaceMapping.
(assert
  (forall ((sc SW-CONNECTOR) (m PORT-INTERFACE-MAPPING))
    (=> (has_mapping sc m)
        (let ((p1 (port1 sc))
              (p2 (port2 sc))
              (i1 (mappedInterface1 m))
              (i2 (mappedInterface2 m)))
          (and (or (and (typedBy p1 i1) (typedBy p2 i2))
                   (and (typedBy p1 i2) (typedBy p2 i1)))))))

; ===== constr_1152: category sync between ApplicationArrayElement and referenced AutosarDataType =====
(assert
  (forall ((e APPLICATION-ARRAY-ELEMENT))
    (=> (and (has_typeRef e)
             (has_category_ApplicationArrayElement e)
             (has_category_AutosarDataType (typeRef e)))
        (= (category_ApplicationArrayElement e)
           (category_AutosarDataType (typeRef e)))))

