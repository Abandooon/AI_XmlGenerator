; -----------------------------
; TPS_SWCT_01163 - Conversion from firstValue to secondValue
; -----------------------------
; Behavioral / runtime semantics: if there is a data flow from firstDataPrototype
; to secondDataPrototype, then firstValue is converted to secondValue.
; We introduce an abstract predicate dataFlow to capture this.
(declare-fun dataFlow (DATA-PROTOTYPE DATA-PROTOTYPE) Bool)

; Abstract conversion predicate: value mapping under a given TextTableMapping
(declare-fun converts (TEXT-TABLE-MAPPING NumericalValueVariationPoint NumericalValueVariationPoint) Bool)

; If there is a data flow from firstDataPrototype to secondDataPrototype,
; then for all value pairs of the involved TextTableMapping, firstValue is
; converted to secondValue.
(assert
  (forall ((m DATA-PROTOTYPE-MAPPING)
           (ttm TEXT-TABLE-MAPPING)
           (vp TEXT-TABLE-VALUE-PAIR))
    (=> (and (has_firstDataPrototypeRef m)
             (has_secondDataPrototypeRef m)
             (dataFlow (firstDataPrototypeRef m) (secondDataPrototypeRef m))
             (has_valuePair ttm vp))
        (converts ttm (firstValue vp) (secondValue vp)))))

; -----------------------------
; TPS_SWCT_01164 - Conversion from secondValue to firstValue
; -----------------------------
; If there is a data flow from secondDataPrototype to firstDataPrototype,
; then secondValue is substituted by firstValue.
(assert
  (forall ((m DATA-PROTOTYPE-MAPPING)
           (ttm TEXT-TABLE-MAPPING)
           (vp TEXT-TABLE-VALUE-PAIR))
    (=> (and (has_firstDataPrototypeRef m)
             (has_secondDataPrototypeRef m)
             (dataFlow (secondDataPrototypeRef m) (firstDataPrototypeRef m))
             (has_valuePair ttm vp))
        (converts ttm (secondValue vp) (firstValue vp)))))

; -----------------------------
; TPS_SWCT_01165 - Invertible mapping
; -----------------------------
; If mappingDirection is bidirectional, then the mapping must be invertible.
; This is modeled as injectivity of firstValue and secondValue projections
; over the set of value pairs belonging to a given TextTableMapping.

; First-values must be unique within a bidirectional mapping
(assert
  (forall ((ttm TEXT-TABLE-MAPPING)
           (vp1 TEXT-TABLE-VALUE-PAIR)
           (vp2 TEXT-TABLE-VALUE-PAIR))
    (=> (and (is_bidirectional (mappingDirection ttm))
             (has_valuePair ttm vp1)
             (has_valuePair ttm vp2)
             (= (firstValue vp1) (firstValue vp2)))
        (= vp1 vp2))))

; Second-values must be unique within a bidirectional mapping
(assert
  (forall ((ttm TEXT-TABLE-MAPPING)
           (vp1 TEXT-TABLE-VALUE-PAIR)
           (vp2 TEXT-TABLE-VALUE-PAIR))
    (=> (and (is_bidirectional (mappingDirection ttm))
             (has_valuePair ttm vp1)
             (has_valuePair ttm vp2)
             (= (secondValue vp1) (secondValue vp2)))
        (= vp1 vp2))))

