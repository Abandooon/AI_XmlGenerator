;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Logical axioms
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; -------------------------------------------------------------------
; TPS_SWCT_01408 - Creation of SwcBswMapping
; -------------------------------------------------------------------
; Informal: For the RTE module configuration an implementation of the
; AUTOSAR Service described by a BSW module description needs to be
; selected. The SwcBswMapping to the corresponding SwComponentPrototype
; needs to be created accordingly. For each SwcInternalBehavior one
; SwcImplementation is being created. SwcImplementation must reference
; the selected SwcInternalBehavior.

; 1) If a BSW internal behavior is selected for a prototype, then there
;    exists a SwcBswMapping linking that prototype to that behavior and
;    to some SwcInternalBehavior.
(assert
  (forall ((p SW-COMPONENT-PROTOTYPE) (b BSW-INTERNAL-BEHAVIOR))
    (=> (selectedServiceForPrototype p b)
        (exists ((m SWC-BSW-MAPPING) (ib SWC-INTERNAL-BEHAVIOR))
          (and (has_SwcBswMapping p m)
               (bswBehaviorRef m b)
               (swcBehaviorRef m ib))))))

; 2) For each SwcInternalBehavior there exists exactly one SwcImplementation
;    and it references that behavior.
(assert
  (forall ((ib SWC-INTERNAL-BEHAVIOR))
    (exists ((impl SWC-IMPLEMENTATION))
      (and (implOfBehavior ib impl)
           (behaviorRef_SwcImplementation impl ib)))))

; Optional functionality (uniqueness) – can be strengthened if desired:
(assert
  (forall ((ib SWC-INTERNAL-BEHAVIOR) (i1 SWC-IMPLEMENTATION) (i2 SWC-IMPLEMENTATION))
    (=> (and (implOfBehavior ib i1)
             (implOfBehavior ib i2))
        (= i1 i2))))


; -------------------------------------------------------------------
; TPS_SWCT_01409 - Update of PortDefinedArgumentValues
; -------------------------------------------------------------------
; Depending on the configuration of the Service BSW it might be necessary
; to update the ValueSpecifications belonging to the PortDefinedArgumentValues.
; This is workflow / tool behavior; we only expose a flag. No hard axiom.


; -------------------------------------------------------------------
; TPS_SWCT_01411 - Use cases for a ServiceSwComponentType to express ServiceNeeds
; -------------------------------------------------------------------
; There are valid use cases where ServiceSwComponentType expresses ServiceNeeds.
; No hard logical restriction; we only allow the relation expressesServiceNeeds.
; No additional axiom is required here.


; -------------------------------------------------------------------
; TPS_SWCT_01412 - ServiceSwComponentType shall be added in ECU Configuration phase
; -------------------------------------------------------------------
; Informal core: For each ECU and AUTOSAR Service to be configured, exactly
; one SwComponentPrototype per ServiceSwComponentType per ECU is added.
; All AtomicSwComponentType instances are checked for service ports
; (PortInterfaces with isService = true) referenced by ServiceNeeds, and
; for each such PortInterface belonging to the AUTOSAR Service to be
; configured one PortPrototype implementing the same or a compatible
; PortInterface is created on the ServiceSwComponentType.

; 1) Service interfaces are those PortInterfaces with isServiceInterface = true.
;    This is a definition, not a constraint; no axiom needed beyond usage.

; 2) For each ECU and ServiceSwComponentType, there is at most one prototype
;    instance of that service type on that ECU.
(assert
  (forall ((p1 SW-COMPONENT-PROTOTYPE)
           (p2 SW-COMPONENT-PROTOTYPE)
           (t  SERVICE-SW-COMPONENT-TYPE)
           (e  ECU))
    (=> (and (isPrototypeOfServiceType p1 t)
             (isPrototypeOfServiceType p2 t)
             (deployedOn p1 e)
             (deployedOn p2 e))
        (= p1 p2))))

; 3) Coverage of service ports (high-level): if a service port of some
;    prototype is part of ServiceNeeds for a given AUTOSAR Service, then
;    there must be a corresponding port on the ServiceSwComponentType
;    with same or compatible PortInterface.
(assert
  (forall ((p SW-COMPONENT-PROTOTYPE)
           (port PORT-PROTOTYPE)
           (pi PORT-INTERFACE)
           (sn SERVICE-NEEDS)
           (svc SERVICE-SW-COMPONENT-TYPE)
           (svcPort PORT-PROTOTYPE)
           (svcPi PORT-INTERFACE))
    (=> (and (hasPort p port)
             (portInterfaceOf port pi)
             (isServiceInterface pi)
             (serviceNeedsPort sn port)
             (expressesServiceNeeds svc sn)
             (hasPort_ServiceType svc svcPort)
             (portInterfaceOf svcPort svcPi))
        (compatiblePortInterface pi svcPi))))


; -------------------------------------------------------------------
; TPS_SWCT_01413 - Local communication with services
; -------------------------------------------------------------------
; Application software components may communicate with an instance of a
; ServiceSwComponentType only locally on an ECU.

(assert
  (forall ((app SW-COMPONENT-PROTOTYPE)
           (svc SW-COMPONENT-PROTOTYPE)
           (e1 ECU) (e2 ECU))
    (=> (and (communicatesWithService app svc)
             (deployedOn app e1)
             (deployedOn svc e2))
        (= e1 e2))))


; -------------------------------------------------------------------
; TPS_SWCT_01414 - Mode manager needs to communicate with application
;                   software components located on other ECUs
; -------------------------------------------------------------------
; ServiceProxySwComponentType is used to enable cross-ECU communication
; with a mode manager service.

; If an application prototype communicates with a proxy, then the proxy
; must proxy some ServiceSwComponentType.
(assert
  (forall ((app SW-COMPONENT-PROTOTYPE)
           (proxy SERVICE-PROXY-SW-COMPONENT-TYPE))
    (=> (communicatesWithProxy app proxy)
        (exists ((svc SERVICE-SW-COMPONENT-TYPE))
          (proxiesService proxy svc))))

; Cross-ECU communication pattern: if an application prototype is on ECU e1
; and the proxied service is on ECU e2, the proxy is on e1 and mediates.
(assert
  (forall ((app SW-COMPONENT-PROTOTYPE)
           (proxy SERVICE-PROXY-SW-COMPONENT-TYPE)
           (svc SERVICE-SW-COMPONENT-TYPE)
           (e_app ECU) (e_svc ECU))
    (=> (and (communicatesWithProxy app proxy)
             (proxiesService proxy svc)
             (deployedOn app e_app)
             (deployedOn svc e_svc))
        (deployedOnProxy proxy e_app))))


; -------------------------------------------------------------------
; TPS_SWCT_01415 - Interfaces of ServiceProxySwComponentType
; -------------------------------------------------------------------
; On one side the proxy communicates over service ports with the ECU-local
; ServiceSwComponentType it represents; on the other side it offers the
; corresponding PortPrototypes to the ApplicationSwComponentTypes.

; 1) Every service port on the ServiceSwComponentType has a corresponding
;    port on the ServiceProxySwComponentType with compatible interface.
(assert
  (forall ((proxy SERVICE-PROXY-SW-COMPONENT-TYPE)
           (svc   SERVICE-SW-COMPONENT-TYPE)
           (svcPort PORT-PROTOTYPE)
           (svcPi   PORT-INTERFACE))
    (=> (and (proxiesService proxy svc)
             (hasPort_ServiceType svc svcPort)
             (portInterfaceOf svcPort svcPi)
             (isServiceInterface svcPi))
        (exists ((proxyPort PORT-PROTOTYPE)
                 (proxyPi   PORT-INTERFACE))
          (and (hasPort_ServiceProxy proxy proxyPort)
               (portInterfaceOf proxyPort proxyPi)
               (compatiblePortInterface svcPi proxyPi)))))

; 2) For each application port that uses the proxied service, there is a
;    corresponding port on the proxy with compatible interface.
(assert
  (forall ((proxy SERVICE-PROXY-SW-COMPONENT-TYPE)
           (svc   SERVICE-SW-COMPONENT-TYPE)
           (appType APPLICATION-SW-COMPONENT-TYPE)
           (appPort PORT-PROTOTYPE)
           (appPi   PORT-INTERFACE))
    (=> (and (proxiesService proxy svc)
             (hasPort_ApplicationType appType appPort)
             (portInterfaceOf appPort appPi)
             (isServiceInterface appPi))
        (exists ((proxyPort PORT-PROTOTYPE)
                 (proxyPi   PORT-INTERFACE))
          (and (hasPort_ServiceProxy proxy proxyPort)
               (portInterfaceOf proxyPort proxyPi)
               (compatiblePortInterface appPi proxyPi)))))

