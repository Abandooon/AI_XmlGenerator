; TPS_SWCT_01472
; Receiving SwComponentType owns a DataPrototypeGroup in the role dpgRequiresCoherence
; ============================================================

(declare-sort SW-COMPONENT-TYPE 0)
(declare-sort DATA-PROTOTYPE-GROUP 0)
(declare-sort VARIABLE-DATA-PROTOTYPE 0)

; ownership / roles
(declare-fun ownsDataPrototypeGroup_dpgRequiresCoherence (SW-COMPONENT-TYPE DATA-PROTOTYPE-GROUP) Bool)
(declare-fun memberOfGroup (VARIABLE-DATA-PROTOTYPE DATA-PROTOTYPE-GROUP) Bool)

; age of a variable value (abstract time stamp)
(declare-sort AGE 0)
(declare-fun ageOf (VARIABLE-DATA-PROTOTYPE) AGE)

; coherence: variables in same group have same age
(declare-fun coherentGroup (DATA-PROTOTYPE-GROUP) Bool)

; If a receiving SwComponentType owns a DataPrototypeGroup in the role dpgRequiresCoherence
; it is required that VariableDataPrototypes belonging to the same DataPrototypeGroup
; are produced coherently (same age).
(assert
  (forall ((c SW-COMPONENT-TYPE) (g DATA-PROTOTYPE-GROUP))
    (=> (ownsDataPrototypeGroup_dpgRequiresCoherence c g)
        (and (coherentGroup g)
             (forall ((v1 VARIABLE-DATA-PROTOTYPE) (v2 VARIABLE-DATA-PROTOTYPE))
               (=> (and (memberOfGroup v1 g)
                        (memberOfGroup v2 g))
                   (= (ageOf v1) (ageOf v2)))))))

; ============================================================
; TPS_SWCT_01473
; Receiving SwComponentType owns a RunnableEntityGroup in the role regRequiresStability
; ============================================================

(declare-sort RUNNABLE-ENTITY-GROUP 0)

; ownership / roles
(declare-fun ownsRunnableEntityGroup_regRequiresStability (SW-COMPONENT-TYPE RUNNABLE-ENTITY-GROUP) Bool)
(declare-fun memberOfRunnableGroup (RUNNABLE-ENTITY RUNNABLE-ENTITY-GROUP) Bool)

; implicit communication relation
(declare-fun implicitlyCommunicatedVar (RUNNABLE-ENTITY VARIABLE-DATA-PROTOTYPE) Bool)

; stability: value of a variable is stable during execution of a runnable
(declare-fun stableDuringExecution (VARIABLE-DATA-PROTOTYPE RUNNABLE-ENTITY) Bool)

; If a receiving SwComponentType owns a RunnableEntityGroup in the role regRequiresStability
; it is required that the values of implicitly communicated VariableDataPrototypes are kept
; stable over the execution of all RunnableEntitys belonging to the given group.
(assert
  (forall ((c SW-COMPONENT-TYPE) (g RUNNABLE-ENTITY-GROUP))
    (=> (ownsRunnableEntityGroup_regRequiresStability c g)
        (forall ((r RUNNABLE-ENTITY) (v VARIABLE-DATA-PROTOTYPE))
          (=> (and (memberOfRunnableGroup r g)
                   (implicitlyCommunicatedVar r v))
              (stableDuringExecution v r)))))

; ============================================================
; TPS_SWCT_01474
; RunnableEntityGroup regRequiresStability + DataPrototypeGroups dpgRequiresCoherence
; ============================================================

; Combined requirement: coherence + stability
(assert
  (forall ((c SW-COMPONENT-TYPE) (g RUNNABLE-ENTITY-GROUP) (dpg DATA-PROTOTYPE-GROUP))
    (=> (and (ownsRunnableEntityGroup_regRequiresStability c g)
             (ownsDataPrototypeGroup_dpgRequiresCoherence c dpg))
        (and
          ; coherence: same age for variables in same DataPrototypeGroup
          (forall ((v1 VARIABLE-DATA-PROTOTYPE) (v2 VARIABLE-DATA-PROTOTYPE))
            (=> (and (memberOfGroup v1 dpg)
                     (memberOfGroup v2 dpg))
                (= (ageOf v1) (ageOf v2))))
          ; stability: age is stable during execution of all runnables in the group
          (forall ((r RUNNABLE-ENTITY) (v VARIABLE-DATA-PROTOTYPE))
            (=> (and (memberOfRunnableGroup r g)
                     (memberOfGroup v dpg)
                     (implicitlyCommunicatedVar r v))
                (stableDuringExecution v r))))))

