;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Constraint constr_1167
; ImplementationDataTypes used as ModeRequestTypeMap.implementationDataType
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; If a ModeRequestTypeMap references an ImplementationDataType, then
; that ImplementationDataType must have category VALUE or TYPE_REFERENCE.
(assert
  (forall ((m MODE-REQUEST-TYPE-MAP))
    (=> (has_implementationDataTypeRef m)
        (let ((idt (implementationDataType_of_ModeRequestTypeMap m)))
          (or (= (category_ImplementationDataType idt) "VALUE")
              (= (category_ImplementationDataType idt) "TYPE_REFERENCE"))))))

; For any ImplementationDataType that is used by a ModeRequestTypeMap,
; its baseType (if present) must have BaseTypeDirectDefinition.baseTypeEncoding = "NONE".
(assert
  (forall ((m MODE-REQUEST-TYPE-MAP))
    (=> (has_implementationDataTypeRef m)
        (let ((idt (implementationDataType_of_ModeRequestTypeMap m)))
          (=> (has_baseTypeRef idt)
              (= (baseTypeEncoding
                    (baseTypeDirectDefinition_of_SWBaseType
                      (baseType_of_ImplementationDataType idt)))
                 "NONE"))))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Constraint constr_1168
; Compatibility of ImplementationDataTypes used in the ModeRequestTypeMap
; NOTE: This refers to constr_1167 and constr_1075; we only capture that
; both ImplementationDataTypes used on manager/user side must satisfy
; constr_1167. The detailed numeric range matching of constr_1075 is
; assumed to be encoded elsewhere.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Abstract predicates indicating that an ImplementationDataType is used
; on the mode manager / mode user side of a ModeRequestTypeMap.
(declare-fun usedAsModeManagerType (IMPLEMENTATION-DATA-TYPE) Bool)
(declare-fun usedAsModeUserType (IMPLEMENTATION-DATA-TYPE) Bool)

; Both ImplementationDataTypes (manager and user) shall fulfill constr_1167.
(assert
  (forall ((idt IMPLEMENTATION-DATA-TYPE))
    (=> (or (usedAsModeManagerType idt)
            (usedAsModeUserType idt))
        (and (or (= (category_ImplementationDataType idt) "VALUE")
                 (= (category_ImplementationDataType idt) "TYPE_REFERENCE"))
             (=> (has_baseTypeRef idt)
                 (= (baseTypeEncoding
                       (baseTypeDirectDefinition_of_SWBaseType
                         (baseType_of_ImplementationDataType idt)))
                    "NONE"))))))

