; TPS_SWCT_01287 – DataConstrRule / constrLevel
; We only model the structural pattern: existence of one or two rules
; and their constrLevel values. The exact linkage to a given
; DataConstr (or data type) is abstracted via an index 'c'.
; In a full model, DATA-CONSTR-RULE would be related to its owner.
(declare-fun constrLevel (DATA-CONSTR-RULE) Int)

; Helper predicates to classify rules (documentation-level)
(declare-fun isStandardLimitRule (DATA-CONSTR-RULE) Bool)
(declare-fun isExtendedLimitRule (DATA-CONSTR-RULE) Bool)

; TPS_SWCT_01291 – Association of MemorySection with SwAddrMethod
(declare-fun has_swAddrMethodRef (MEMORY-SECTION) Bool)
(declare-fun swAddrMethodRef    (MEMORY-SECTION) SW-ADDR-METHOD)

; TPS_SWCT_01294 – SwDataDefProps.swAddrMethod
(declare-fun has_swDataDefProps_swAddrMethodRef (SW-DATA-DEF-PROPS-CONTENT) Bool)
(declare-fun swDataDefProps_swAddrMethodRef    (SW-DATA-DEF-PROPS-CONTENT) SW-ADDR-METHOD)

; Helper predicate to express “conflicting association requests”
; for the same underlying object (e.g. same variable) via different
; component types. The concrete linkage to that object is left
; to the mapping / tooling.
(declare-fun conflictingSwAddrMethodRequests () Bool)

; -----------------------------
; Logical axioms
; -----------------------------

; TPS_SWCT_01287 – Standard limits and extended limits in ASAM-MCD2
; Documentation-level pattern:
;  - If exactly one DATA-CONSTR-RULE with constrLevel = 0 exists
;    for a given constrained object, it represents the standard limits.
;  - If two rules exist, then:
;      constrLevel = 0 -> extended limits
;      constrLevel = 1 -> standard limits
;
; Here we only encode local classification of rules by constrLevel.
; The “exactly one / two per constrained object” cardinalities are
; left to a more detailed model that introduces the owner relation.

(assert
  (forall ((r DATA-CONSTR-RULE))
    (and
      (= (isStandardLimitRule r) (= (constrLevel r) 1))
      (= (isExtendedLimitRule r) (= (constrLevel r) 0)))))

; TPS_SWCT_01291 – Association of MemorySection with SwAddrMethod
; Every MEMORY-SECTION shall be associated with exactly one SwAddrMethod.
; Structural existence is already enforced by SHACL; here we add
; a total-function style constraint.

(assert
  (forall ((m MEMORY-SECTION))
    (has_swAddrMethodRef m)))

; Optionally, we can state that the reference is functional:
; (no two different SwAddrMethods for the same MemorySection)
(assert
  (forall ((m MEMORY-SECTION) (a1 SW-ADDR-METHOD) (a2 SW-ADDR-METHOD))
    (=> (and (= (swAddrMethodRef m) a1)
             (= (swAddrMethodRef m) a2))
        (= a1 a2))))

