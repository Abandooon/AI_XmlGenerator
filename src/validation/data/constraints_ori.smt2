; Constraint: Table_5_8_AppDataType_COM_AXIS_swCalibrationAccess_Multiplicity
; For ApplicationDataType with category COM_AXIS, swCalibrationAccess multiplicity 1.
; SHACL already enforces min/maxCount structurally; SMT captures the
; conditional logic in a more abstract way.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Helper: exactly one swCalibrationAccess for a given content
(declare-fun swCalibrationAccess_count (SW-DATA-DEF-PROPS-CONTENT) Int)

(assert
  (forall ((c SW-DATA-DEF-PROPS-CONTENT))
    (=> (has_swCalibrationAccess c)
        (>= (swCalibrationAccess_count c) 1)))

  ; If count >= 1 then has_swCalibrationAccess must be true
)

(assert
  (forall ((c SW-DATA-DEF-PROPS-CONTENT))
    (=> (> (swCalibrationAccess_count c) 0)
        (has_swCalibrationAccess c)))

)

; For each ApplicationDataType specialization with category COM_AXIS,
; there must be exactly one swCalibrationAccess in its SW-DATA-DEF-PROPS-CONTENT.

(assert
  (forall ((a APPLICATION-ARRAY-DATA-TYPE))
    (let ((isCOM_AXIS (and (has_category_APP-ARRAY a)
                           (= (category_APP-ARRAY a) "COM_AXIS"))))
      (=> isCOM_AXIS
          (exists ((p SW-DATA-DEF-PROPS) (c SW-DATA-DEF-PROPS-CONTENT))
            (and (has_swDataDefProps_ARRAY a p)
                 (has_content p c)
                 (= (swCalibrationAccess_count c) 1))))))

(assert
  (forall ((a APPLICATION-RECORD-DATA-TYPE))
    (let ((isCOM_AXIS (and (has_category_APP-RECORD a)
                           (= (category_APP-RECORD a) "COM_AXIS"))))
      (=> isCOM_AXIS
          (exists ((p SW-DATA-DEF-PROPS) (c SW-DATA-DEF-PROPS-CONTENT))
            (and (has_swDataDefProps_RECORD a p)
                 (has_content p c)
                 (= (swCalibrationAccess_count c) 1))))))

(assert
  (forall ((a APPLICATION-PRIMITIVE-DATA-TYPE))
    (let ((isCOM_AXIS (and (has_category_APP-PRIMITIVE a)
                           (= (category_APP-PRIMITIVE a) "COM_AXIS"))))
      (=> isCOM_AXIS
          (exists ((p SW-DATA-DEF-PROPS) (c SW-DATA-DEF-PROPS-CONTENT))
            (and (has_swDataDefProps_PRIMITIVE a p)
                 (has_content p c)
                 (= (swCalibrationAccess_count c) 1))))))

