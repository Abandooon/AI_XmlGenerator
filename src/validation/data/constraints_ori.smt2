; Read and write access is only applicable for RunnableEntitys of category 1.
; 形式化为：如果某 RunnableEntity 有读/写 VARIABLE-ACCESS，则其 category = 1。

(assert
  (forall ((r RUNNABLE-ENTITY) (va VARIABLE-ACCESS))
    (=> (has_dataReadAccess r va)
        (= (category r) 1))))

(assert
  (forall ((r RUNNABLE-ENTITY) (va VARIABLE-ACCESS))
    (=> (has_dataWriteAccess r va)
        (= (category r) 1))))

