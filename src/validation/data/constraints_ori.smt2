; --- TPS_SWCT_01518 ---

; 概念层级（抽象表示）
(declare-sort CONCEPTUAL-LEVEL 0)

; 初始值定义在某概念层级上
(declare-fun has_initialValueAtLevel (CONCEPTUAL-LEVEL) Bool)

; 概念层级优先级比较：higherPriority l1 l2 表示 l1 的优先级高于 l2
(declare-fun higherPriority (CONCEPTUAL-LEVEL CONCEPTUAL-LEVEL) Bool)

; 初始值在给定层级是否被语义上忽略
