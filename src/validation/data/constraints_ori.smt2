; ---------- For ComSpecs and network representations (constr_1196, 1197) ----------
(declare-fun has_networkRepresentation_NR (NONQUEUED-RECEIVER-COM-SPEC SW-DATA-DEF-PROPS) Bool)
(declare-fun has_networkRepresentation_QR (QUEUED-RECEIVER-COM-SPEC SW-DATA-DEF-PROPS) Bool)
(declare-fun has_networkRepresentation_NS (NONQUEUED-SENDER-COM-SPEC SW-DATA-DEF-PROPS) Bool)
(declare-fun has_networkRepresentation_QS (QUEUED-SENDER-COM-SPEC SW-DATA-DEF-PROPS) Bool)

(declare-fun has_compositeNetworkRepresentation_NR (NONQUEUED-RECEIVER-COM-SPEC COMPOSITE-NETWORK-REPRESENTATION) Bool)
