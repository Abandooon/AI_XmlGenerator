; constr_1269: Number of arguments shall be preserved in a ClientServerOperationMapping
(assert
  (forall ((m CLIENT-SERVER-OPERATION-MAPPING))
    (= (numArguments (firstOperation m))
       (numArguments (secondOperation m)))))

; constr_1270: ArgumentDataPrototype shall be mapped only once in a ClientServerOperationMapping
(assert
  (forall ((m CLIENT-SERVER-OPERATION-MAPPING) (a DATA-PROTOTYPE))
    (=> (isArgumentDataPrototype a)
        (let ((ms (argumentMappings m)))
          (<=
            (card
              (set-filter
                (lambda ((mp DATA-PROTOTYPE-MAPPING))
                  (or (= (firstDataPrototype mp) a)
                      (= (secondDataPrototype mp) a)))
                ms))
            1)))))

; constr_1271: RecordValueSpecification.elements vs ApplicationRecordDataType.elements
(assert
  (forall ((d DATA-PROTOTYPE))
    (= (numRecordElements (typeOf d))
       (numRecordFields (initRecordValue d)))))

; constr_1272: RecordValueSpecification.elements vs ImplementationDataType.subElements (STRUCTURE)
(assert
  (forall ((d DATA-PROTOTYPE))
    (=> (= (implCategory (implTypeOf d)) "STRUCTURE")
        (= (numSubElements (implTypeOf d))
           (numRecordFields2 (initRecordValue2 d))))))

; constr_1273: ArrayValueSpecification.elements vs ApplicationArrayDataType.element.maxNumberOfElements
(assert
  (forall ((d DATA-PROTOTYPE))
    (= (maxNumberOfElements (appArrayTypeOf d))
       (numArrayElements (initArrayValue d)))))

; constr_1274: ArrayValueSpecification.elements vs ImplementationDataType.subElement.arraySize (ARRAY)
(assert
  (forall ((d DATA-PROTOTYPE))
    (=> (= (implArrayCategory (implArrayTypeOf d)) "ARRAY")
        (= (arraySize (implArrayTypeOf d))
           (numArrayElements2 (initArrayValue2 d))))))

; constr_1277: SwDataDefProps.swImplPolicy not queued for VariableAccess in dataReceivePointByValue
(assert
  (forall ((v VARIABLE-DATA-PROTOTYPE))
    (=> (exists ((r RUNNABLE-ENTITY) (va VARIABLE-ACCESS))
          (and (set-member va (dataReceivePointByValues r))
               (= (refersToVariable (accessedVariableRef va)) v)))
        (=> (hasSwDataDefProps v)
            (not (= (swImplPolicy (swDataDefProps v)) "queued"))))))


