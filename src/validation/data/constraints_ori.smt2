(declare-fun va_senderComSpec (VARIABLE-ACCESS SENDER-COM-SPEC) Bool)

; SENDER-COM-SPEC subtypes
(declare-fun is_NONQUEUED-SENDER-COM-SPEC (SENDER-COM-SPEC NONQUEUED-SENDER-COM-SPEC) Bool)
(declare-fun is_QUEUED-SENDER-COM-SPEC (SENDER-COM-SPEC QUEUED-SENDER-COM-SPEC) Bool)

; NONQUEUED-SENDER-COM-SPEC / QUEUED-SENDER-COM-SPEC have TRANSMISSION-ACKNOWLEDGE
(declare-fun has_TRANSMISSION-ACKNOWLEDGE_NQ (NONQUEUED-SENDER-COM-SPEC TRANSMISSION-ACKNOWLEDGEMENT-REQUEST) Bool)
(declare-fun has_TRANSMISSION-ACKNOWLEDGE_Q (QUEUED-SENDER-COM-SPEC TRANSMISSION-ACKNOWLEDGEMENT-REQUEST) Bool)

; TRANSMISSION-ACKNOWLEDGEMENT-REQUEST has TIMEOUT
(declare-fun has_TAR_TIMEOUT (TRANSMISSION-ACKNOWLEDGEMENT-REQUEST TIME-VALUE) Bool)

; 核心约束：
; For any WaitPoint w and DataSendCompletedEvent e where w.triggerRef = e,
; and e.eventSourceRef = va, and va.senderComSpec = sc, and sc has a
; TransmissionAcknowledgementRequest tar, the timeout of w equals the timeout of tar.
(assert
  (forall ((w WAIT-POINT) (e DATA-SEND-COMPLETED-EVENT)
          (va VARIABLE-ACCESS) (sc SENDER-COM-SPEC)
          (nq NONQUEUED-SENDER-COM-SPEC) (q QUEUED-SENDER-COM-SPEC)
          (tar TRANSMISSION-ACKNOWLEDGEMENT-REQUEST)
          (tw TIME-VALUE) (tt TIME-VALUE))
    (=> (and (has_TRIGGER_REF_DATA-SEND-COMPLETED-EVENT w e)
             (has_EVENT-SOURCE-REF e va)
             (va_senderComSpec va sc)
             (has_WAITPOINT_TIMEOUT w tw)
             (has_TAR_TIMEOUT tar tt)
             (or (and (is_NONQUEUED-SENDER-COM-SPEC sc nq)
                      (has_TRANSMISSION-ACKNOWLEDGE_NQ nq tar))
                 (and (is_QUEUED-SENDER-COM-SPEC sc q)
                      (has_TRANSMISSION-ACKNOWLEDGE_Q q tar)))
        (= (timeValue_value tw) (timeValue_value tt)))))

