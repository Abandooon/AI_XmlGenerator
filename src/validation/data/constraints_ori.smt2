(assert
  (forall ((a ATOMIC-SW-COMPONENT-TYPE))
    (exists ((r ROLE-BASED-PORT-ASSIGNMENT))
      (and (belongsToAtomic r a)
           (role_is_OperationCycle r)
           (forall ((r2 ROLE-BASED-PORT-ASSIGNMENT))
             (=> (and (belongsToAtomic r2 a)
                      (role_is_OperationCycle r2))
                 (= r2 r)))))))

