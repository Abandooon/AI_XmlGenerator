; SMT template for NvBlockDescriptor.NvBlockNeeds recommendations
; All are recommendations -> modeled as Info/Warning-style implications, not hard violations.

; Sort declarations
(declare-sort NV-BLOCK-DESCRIPTOR 0)
(declare-sort NV-BLOCK-NEEDS 0)
(declare-sort PORT-PROTOTYPE 0)

; Association between NvBlockDescriptor and its NvBlockNeeds
(declare-fun has_nvBlockNeeds (NV-BLOCK-DESCRIPTOR) Bool)
(declare-fun nvBlockNeeds_of (NV-BLOCK-DESCRIPTOR) NV-BLOCK-NEEDS)

; Association between NvBlockDescriptor and mapped PortPrototypes
; (abstract: “mapped nv data PortPrototypes”)
(declare-fun mappedPortPrototype (NV-BLOCK-DESCRIPTOR PORT-PROTOTYPE) Bool)

; Properties on NvBlockNeeds
(declare-fun has_storeCyclic (NV-BLOCK-NEEDS) Bool)
(declare-fun storeCyclic (NV-BLOCK-NEEDS) Bool)

(declare-fun has_storeEmergency (NV-BLOCK-NEEDS) Bool)
(declare-fun storeEmergency (NV-BLOCK-NEEDS) Bool)

(declare-fun has_storeImmediate (NV-BLOCK-NEEDS) Bool)
(declare-fun storeImmediate (NV-BLOCK-NEEDS) Bool)

(declare-fun has_writeOnlyOnce (NV-BLOCK-NEEDS) Bool)
(declare-fun writeOnlyOnce (NV-BLOCK-NEEDS) Bool)

(declare-fun has_writeVerification (NV-BLOCK-NEEDS) Bool)
(declare-fun writeVerification (NV-BLOCK-NEEDS) Bool)

(declare-fun has_writingFrequency (NV-BLOCK-NEEDS) Bool)
(declare-fun writingFrequency (NV-BLOCK-NEEDS) Int)

(declare-fun has_writingPriority (NV-BLOCK-NEEDS) Bool)
(declare-fun writingPriority (NV-BLOCK-NEEDS) Int)

; Request predicates on PortPrototype (abstracted from “requests … writing”)
(declare-fun requestsCyclicWriting (PORT-PROTOTYPE) Bool)
(declare-fun requestsEmergencyWriting (PORT-PROTOTYPE) Bool)
(declare-fun requestsImmediateWriting (PORT-PROTOTYPE) Bool)
(declare-fun requestsWriteOnlyOnce (PORT-PROTOTYPE) Bool)
(declare-fun requestsWriteVerification (PORT-PROTOTYPE) Bool)
(declare-fun requestedWritingFrequency (PORT-PROTOTYPE) Int)
(declare-fun requestedWritingPriority (PORT-PROTOTYPE) Int)

; Helper predicates: “any mapped PortPrototype requests X”
(declare-fun anyMappedRequestsCyclic (NV-BLOCK-DESCRIPTOR) Bool)
(declare-fun anyMappedRequestsEmergency (NV-BLOCK-DESCRIPTOR) Bool)
(declare-fun anyMappedRequestsImmediate (NV-BLOCK-DESCRIPTOR) Bool)
(declare-fun anyMappedRequestsWriteVerification (NV-BLOCK-DESCRIPTOR) Bool)

; Helper functions: “highest requested frequency/priority”
(declare-fun maxRequestedWritingFrequency (NV-BLOCK-DESCRIPTOR) Int)
(declare-fun maxRequestedWritingPriority (NV-BLOCK-DESCRIPTOR) Int)

; Axioms linking helper predicates/functions to mappedPortPrototype
(assert
  (forall ((d NV-BLOCK-DESCRIPTOR))
    (= (anyMappedRequestsCyclic d)
       (exists ((p PORT-PROTOTYPE))
         (mappedPortPrototype d p)
         (requestsCyclicWriting p)))))

(assert
  (forall ((d NV-BLOCK-DESCRIPTOR))
    (= (anyMappedRequestsEmergency d)
       (exists ((p PORT-PROTOTYPE))
         (mappedPortPrototype d p)
         (requestsEmergencyWriting p)))))

(assert
  (forall ((d NV-BLOCK-DESCRIPTOR))
    (= (anyMappedRequestsImmediate d)
       (exists ((p PORT-PROTOTYPE))
         (mappedPortPrototype d p)
         (requestsImmediateWriting p)))))

(assert
  (forall ((d NV-BLOCK-DESCRIPTOR))
    (= (anyMappedRequestsWriteVerification d)
       (exists ((p PORT-PROTOTYPE))
         (mappedPortPrototype d p)
         (requestsWriteVerification p)))))

; Max frequency: upper bound and attainability
(assert
  (forall ((d NV-BLOCK-DESCRIPTOR))
    (forall ((p PORT-PROTOTYPE))
      (=> (mappedPortPrototype d p)
          (<= (requestedWritingFrequency p)
              (maxRequestedWritingFrequency d)))))

(assert
  (forall ((d NV-BLOCK-DESCRIPTOR))
    (=> (exists ((p PORT-PROTOTYPE))
          (mappedPortPrototype d p))
        (exists ((p PORT-PROTOTYPE))
          (and (mappedPortPrototype d p)
               (= (requestedWritingFrequency p)
                  (maxRequestedWritingFrequency d))))))

; Max priority: upper bound and attainability
(assert
  (forall ((d NV-BLOCK-DESCRIPTOR))
    (forall ((p PORT-PROTOTYPE))
      (=> (mappedPortPrototype d p)
          (<= (requestedWritingPriority p)
              (maxRequestedWritingPriority d)))))

(assert
  (forall ((d NV-BLOCK-DESCRIPTOR))
    (=> (exists ((p PORT-PROTOTYPE))
          (mappedPortPrototype d p))
        (exists ((p PORT-PROTOTYPE))
          (and (mappedPortPrototype d p)
               (= (requestedWritingPriority p)
                  (maxRequestedWritingPriority d))))))

; Core recommendation constraints (modeled as implications)

; storeCyclic: if any mapped PortPrototype requests cyclic writing,
; then NvBlockNeeds.storeCyclic is recommended to be true.
(assert
  (forall ((d NV-BLOCK-DESCRIPTOR))
    (=> (and (has_nvBlockNeeds d)
             (anyMappedRequestsCyclic d))
        (let ((n (nvBlockNeeds_of d)))
          (=> (has_storeCyclic n)
              (= (storeCyclic n) true)))))

; storeEmergency: if any mapped PortPrototype requests emergency writing,
; then NvBlockNeeds.storeEmergency is recommended to be true.
(assert
  (forall ((d NV-BLOCK-DESCRIPTOR))
    (=> (and (has_nvBlockNeeds d)
             (anyMappedRequestsEmergency d))
        (let ((n (nvBlockNeeds_of d)))
          (=> (has_storeEmergency n)
              (= (storeEmergency n) true)))))

; storeImmediate: if any mapped PortPrototype requests immediate writing,
; then NvBlockNeeds.storeImmediate is recommended to be true.
(assert
  (forall ((d NV-BLOCK-DESCRIPTOR))
    (=> (and (has_nvBlockNeeds d)
             (anyMappedRequestsImmediate d))
        (let ((n (nvBlockNeeds_of d)))
          (=> (has_storeImmediate n)
              (= (storeImmediate n) true)))))

; writeOnlyOnce: recommended to be identical to the requests of the mapped nv data PortPrototypes.
; Here we model: if all mapped PortPrototypes request writeOnlyOnce, recommend true;
; if none request writeOnlyOnce, recommend false. Mixed cases are left unconstrained.
