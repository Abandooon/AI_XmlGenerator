; ---------- For SwcModeSwitchEvent (constr_1195) ----------
(declare-fun activation (SWC-MODE-SWITCH-EVENT) String)
(declare-fun modeRef1 (SWC-MODE-SWITCH-EVENT) MODE-DECLARATION)
(declare-fun modeRef2 (SWC-MODE-SWITCH-EVENT) MODE-DECLARATION)
