;---------------- constr_1095 – Values of nDataSets vs. reliability -----------

(assert
  (forall ((x NV-BLOCK-NEEDS))
    (=> (and (has_nDataSets x)
             (> (nDataSets x) 0)
             (has_reliability x))
        (not (= (reliability x) errorCorrection)))))

;---------------- constr_1096 – SwcModeSwitchEvent and WaitPoint --------------

(assert
  (forall ((e SWC-MODE-SWITCH-EVENT))
    (=> (has_startOnEventRef e)
        (let ((r (startOnEventRef e)))
          (not (has_waitPoint r))))))

;---------------- constr_1097 – RunnableEntity that has a WaitPoint -----------

(assert
  (forall ((e RTE-EVENT))
    (=> (and (has_startOnEventRef_RTE e)
             (has_disabledMode e))
        (let ((r (startOnEventRef_RTE e)))
          (not (has_waitPoint r))))))

;---------------- constr_1098 – Mode switch and mode disabling ----------------

(assert
  (forall ((e SWC-MODE-SWITCH-EVENT) (m MODE-DECLARATION))
    (not (and (modeRefs e m)
              (disabledModeRefs e m)))))

;---------------- constr_1100 – Unconnected RPortPrototype typed by a DataInterface ----

(assert
  (forall ((p R-PORT-PROTOTYPE) (d DATA-INTERFACE))
    (=> (and (isUnconnected p)
             (has_portType p)
             (= (portType p) d))
        (forall ((rcs REQUIRED-COM-SPECS) (nq NONQUEUED-RECEIVER-COM-SPEC))
          (=> (has_requiredComSpecs p rcs)
              (=> (has_nonqueuedReceiverComSpec rcs nq)
                  (has_initValue nq))))))

;---------------- constr_1101 – Mode-related communication --------------------

(assert
  (forall ((p R-PORT-PROTOTYPE))
    (=> (portType_isModeSwitchInterface p)
        (forall ((c1 SW-CONNECTOR) (c2 SW-CONNECTOR))
          (=> (and (has_rPortOf c1)
                   (has_rPortOf c2)
                   (= (rPortOf c1) p)
                   (= (rPortOf c2) p))
              (= c1 c2))))))

;---------------- constr_1103 – NonqueuedReceiverComSpec and enableUpdate -----

(assert
  (forall ((c NONQUEUED-RECEIVER-COM-SPEC))
    (=> (and (has_enableUpdate c)
             (enableUpdate c)
             (has_dataElement c))
        (let ((de (dataElement c)))
          (forall ((va VARIABLE-ACCESS))
            (not (dataReadAccesses va de))))))

)


