; 2) RoleBasedDataTypeAssignment: temporaryRamBlock [0..1] -> 至多一个 temporaryRamBlock

(declare-fun isDefaultValue_RBDA (ROLE-BASED-DATA-ASSIGNMENT) Bool)
(declare-fun isTemporaryRamBlock (ROLE-BASED-DATA-TYPE-ASSIGNMENT) Bool)

(assert
  (forall ((x ROLE-BASED-DATA-ASSIGNMENT))
    (= (isDefaultValue_RBDA x)
       (= (roleOf_RoleBasedDataAssignment x) "defaultValue"))))

(assert
  (forall ((x ROLE-BASED-DATA-TYPE-ASSIGNMENT))
    (= (isTemporaryRamBlock x)
       (= (roleOf_RoleBasedDataTypeAssignment x) "temporaryRamBlock"))))

; defaultValue 至多一个
(assert
  (forall ((x ROLE-BASED-DATA-ASSIGNMENT)
           (y ROLE-BASED-DATA-ASSIGNMENT))
    (=> (and (isDefaultValue_RBDA x)
             (isDefaultValue_RBDA y))
        (= x y))))

; temporaryRamBlock 至多一个
(assert
  (forall ((x ROLE-BASED-DATA-TYPE-ASSIGNMENT)
           (y ROLE-BASED-DATA-TYPE-ASSIGNMENT))
    (=> (and (isTemporaryRamBlock x)
             (isTemporaryRamBlock y))
        (= x y))))

; ========== TPS_SWCT_02503 ==========
; Software-Components using NvData:
; 对每个相关 SwcServiceDependency，至少一个 assigned RoleBasedPortAssignment 的 role = "NvDataPort"

(declare-fun isNvDataPort (ROLE-BASED-PORT-ASSIGNMENT) Bool)

(assert
  (forall ((p ROLE-BASED-PORT-ASSIGNMENT))
    (= (isNvDataPort p)
       (= (roleOf_RoleBasedPortAssignment p) "NvDataPort"))))

; 对每个 SwcServiceDependency：如果被视为“使用 NvData 的场景”，
; 则要求存在至少一个 NvDataPort。这里用谓词 usesNvData 标记该场景。
(declare-fun usesNvData (SWC-SERVICE-DEPENDENCY) Bool)

(assert
  (forall ((s SWC-SERVICE-DEPENDENCY))
    (=> (usesNvData s)
        (exists ((i Int))
          (and (<= 0 i)
               (< i (assignedPortsCount s))
               (isNvDataPort (select (assignedPorts s) i))))))

