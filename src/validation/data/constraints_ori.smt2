;---------------------------------------------------------------
; 4.3.1_Constr_SwConnector_PIMReference
; SwConnector Reference to PortInterfaceMapping
;---------------------------------------------------------------

; Sorts
(declare-sort PORT-INTERFACE-MAPPING 0)
(declare-sort ASSEMBLY-SW-CONNECTOR 0)
(declare-sort DELEGATION-SW-CONNECTOR 0)
(declare-sort PASS-THROUGH-SW-CONNECTOR 0)

; Predicates: whether a given SwConnector references a given PortInterfaceMapping
(declare-fun mappingRef_Assembly (ASSEMBLY-SW-CONNECTOR PORT-INTERFACE-MAPPING) Bool)
(declare-fun mappingRef_Delegation (DELEGATION-SW-CONNECTOR PORT-INTERFACE-MAPPING) Bool)
(declare-fun mappingRef_PassThrough (PASS-THROUGH-SW-CONNECTOR PORT-INTERFACE-MAPPING) Bool)

; For each PortInterfaceMapping that is "applied", there must exist at least one
; SwConnector that references it. We model "applied" as a semantic predicate.
(declare-fun pimApplied (PORT-INTERFACE-MAPPING) Bool)

(assert
  (forall ((p PORT-INTERFACE-MAPPING))
    (=> (pimApplied p)
        (or (exists ((c ASSEMBLY-SW-CONNECTOR))
              (mappingRef_Assembly c p))
            (exists ((c DELEGATION-SW-CONNECTOR))
              (mappingRef_Delegation c p))
            (exists ((c PASS-THROUGH-SW-CONNECTOR))
              (mappingRef_PassThrough c p))))))

;---------------------------------------------------------------
; ComMgrUserNeeds_PortGroupAssociation
; ComMgrUserNeeds PortGroup Association
;---------------------------------------------------------------

(declare-sort COM-MGR-USER-NEEDS 0)
(declare-sort SWC-SERVICE-DEPENDENCY 0)
(declare-sort PORT-GROUP 0)

; Association between ComMgrUserNeeds and its SwcServiceDependency
(declare-fun hasServiceDependency (COM-MGR-USER-NEEDS SWC-SERVICE-DEPENDENCY) Bool)

; Reference from SwcServiceDependency to PortGroup
(declare-fun representedPortGroupRef (SWC-SERVICE-DEPENDENCY PORT-GROUP) Bool)

; Each ComMgrUserNeeds that has a service dependency is associated with exactly
; one PortGroup via that dependency.
(assert
  (forall ((u COM-MGR-USER-NEEDS))
    (=> (exists ((d SWC-SERVICE-DEPENDENCY))
          (hasServiceDependency u d))
        (exists ((g PORT-GROUP))
          (and
            (exists ((d SWC-SERVICE-DEPENDENCY))
              (and (hasServiceDependency u d)
                   (representedPortGroupRef d g)))
            (forall ((g2 PORT-GROUP))
              (=> (exists ((d2 SWC-SERVICE-DEPENDENCY))
                    (and (hasServiceDependency u d2)
                         (representedPortGroupRef d2 g2)))
                  (= g2 g)))))))

;---------------------------------------------------------------
; Constr_4.8_BSWInterfacingAlternatives
; BSW Interfacing Alternatives for Partial Networking
;---------------------------------------------------------------

; We introduce a sort for the "user" (e.g. a component or configuration element)
(declare-sort PN-BSW-USER 0)

; Semantic predicates: which interfacing alternative is used
(declare-fun uses_ComM_CS (PN-BSW-USER) Bool)
(declare-fun uses_ComM_Mode (PN-BSW-USER) Bool)
(declare-fun uses_BswM_Mode (PN-BSW-USER) Bool)

; Exactly one of the three alternatives shall be used
(assert
  (forall ((u PN-BSW-USER))
    (let ((c (uses_ComM_CS u))
          (m (uses_ComM_Mode u))
          (b (uses_BswM_Mode u)))
      (and
        (or c m b)
        (not (and c m))
        (not (and c b))
        (not (and m b))))))

;---------------------------------------------------------------
; Constr_4.8_ComMRetrievalChoice
; Choice of ComM Retrieval Method for Software Component Author
;---------------------------------------------------------------

(declare-sort SW-COMPONENT 0)

; Retrieval methods
(declare-fun uses_ComM_CS_Retrieval (SW-COMPONENT) Bool)
(declare-fun uses_ComM_SR_Retrieval (SW-COMPONENT) Bool)

; At least one retrieval method must be chosen; both are allowed.
(assert
  (forall ((c SW-COMPONENT))
    (or (uses_ComM_CS_Retrieval c)
        (uses_ComM_SR_Retrieval c))))

;---------------------------------------------------------------
; Constr_4.8_PartialNetworkStatusCheck
; Partial Network Status Check Before Communication
;---------------------------------------------------------------

(declare-sort PORT-PROTOTYPE 0)
(declare-sort PARTIAL-NETWORK 0)

; Relations
(declare-fun belongsToPartialNetwork (PORT-PROTOTYPE PARTIAL-NETWORK) Bool)
(declare-fun communicatesVia (SW-COMPONENT PORT-PROTOTYPE) Bool)
(declare-fun checksPNStatusBeforeComm (SW-COMPONENT PARTIAL-NETWORK) Bool)

; If a component communicates via a port that belongs to a partial network,
; it shall check the status of that partial network before communication.
(assert
  (forall ((c SW-COMPONENT) (p PORT-PROTOTYPE) (n PARTIAL-NETWORK))
    (=> (and (communicatesVia c p)
             (belongsToPartialNetwork p n))
        (checksPNStatusBeforeComm c n))))

;---------------------------------------------------------------
; Constr_4.9_ConsistencyNeedsDefinitionContext
; Context for Defining ConsistencyNeeds in Component Types
;---------------------------------------------------------------

(declare-sort CONSISTENCY-NEEDS 0)
(declare-sort ATOMIC-SW-COMPONENT-TYPE 0)
(declare-sort COMPOSITION-SW-COMPONENT-TYPE 0)

; Where a given ConsistencyNeeds is defined
(declare-fun definedInAtomic (CONSISTENCY-NEEDS ATOMIC-SW-COMPONENT-TYPE) Bool)
(declare-fun definedInComposition (CONSISTENCY-NEEDS COMPOSITION-SW-COMPONENT-TYPE) Bool)

; Documentation-style constraint: a ConsistencyNeeds may be defined either
; in an AtomicSwComponentType or in a CompositionSwComponentType (or both).
(assert
  (forall ((c CONSISTENCY-NEEDS))
    (or (exists ((a ATOMIC-SW-COMPONENT-TYPE))
          (definedInAtomic c a))
        (exists ((k COMPOSITION-SW-COMPONENT-TYPE))
          (definedInComposition c k)))))

;---------------------------------------------------------------
; Constr_AppImplDataTypeMap_VSADT
; Companion ImplementationDataType and DataTypeMap for ApplicationDataType VSADT
;---------------------------------------------------------------

(declare-sort APPLICATION-DATA-TYPE 0)
(declare-sort IMPLEMENTATION-DATA-TYPE 0)
(declare-sort DATA-TYPE-MAP 0)

; Predicates
(declare-fun isVSADT (APPLICATION-DATA-TYPE) Bool)
(declare-fun companionImpl (APPLICATION-DATA-TYPE IMPLEMENTATION-DATA-TYPE) Bool)
(declare-fun dataTypeMapRefApp (DATA-TYPE-MAP APPLICATION-DATA-TYPE) Bool)
(declare-fun dataTypeMapRefImpl (DATA-TYPE-MAP IMPLEMENTATION-DATA-TYPE) Bool)

; If an ApplicationDataType is a VSADT, then there exists a companion
; ImplementationDataType and a DataTypeMap that refers to both.
(assert
  (forall ((a APPLICATION-DATA-TYPE))
    (=> (isVSADT a)
        (exists ((i IMPLEMENTATION-DATA-TYPE) (m DATA-TYPE-MAP))
          (and (companionImpl a i)
               (dataTypeMapRefApp m a)
               (dataTypeMapRefImpl m i)))))

; (check-sat) is intentionally omitted


; =========================
; SMT TEMPLATE
; =========================

; 1) Compatibility between ApplicationRecordDataType and ApplicationArrayDataType
; Constr_AppRecord_AppArray_Compatibility
; 语义：ApplicationRecordDataType 与 ApplicationArrayDataType 实例通常不兼容，
; 除非存在 PortInterfaceMapping 详细说明兼容性条款。

(declare-sort APPLICATION-RECORD-DATA-TYPE 0)
(declare-sort APPLICATION-ARRAY-DATA-TYPE 0)
(declare-sort PORT-INTERFACE-MAPPING 0)

; 兼容性谓词：record 与 array 之间是否被视为兼容
(declare-fun compatible_Record_Array (APPLICATION-RECORD-DATA-TYPE APPLICATION-ARRAY-DATA-TYPE) Bool)

; 是否存在一个 PortInterfaceMapping 使得这对类型被声明为兼容
(declare-fun has_PortInterfaceMappingForPair (APPLICATION-RECORD-DATA-TYPE APPLICATION-ARRAY-DATA-TYPE) Bool)

; 约束：如果 record/array 被视为兼容，则必须存在相应的 PortInterfaceMapping
(assert
  (forall ((r APPLICATION-RECORD-DATA-TYPE)
           (a APPLICATION-ARRAY-DATA-TYPE))
    (=> (compatible_Record_Array r a)
        (has_PortInterfaceMappingForPair r a))))

; （反向“不兼容”方向依赖“默认不兼容”的全局策略，此处不强制 iff，仅建必要条件）


; 2) Application Responsibility for Size Indicator Consistency
; Constr_App_SizeIndicatorConsistency
; 运行时行为约束（应用负责保持“有效元素数量”和 Size Indicator 一致），
; 无稳定的静态结构可验证，此处不建 SMT 公理。


; 3) Semantic Meaning of ApplicationCompositeDataType
; Constr_ApplicationCompositeDataType_SemanticMeaning
; 说明性约束：整体不能赋特定语义，但可对内部 ApplicationPrimitiveDataTypes 赋语义。
; 缺乏可观测布尔条件，此处不建 SMT 公理。


; 4) Precedence of ApplicationDataType for Functional Values Type
; Constr_ApplicationDataType_Precedence
; 语义：如果存在 valueAxisDataType 引用，则它在功能值类型上“优先于”
; CompuMethod、Unit 和 BaseType（如果这些并行定义）。

(declare-sort SW-DATA-DEF-PROPS-CONTENT 0)
(declare-sort APPLICATION-PRIMITIVE-DATA-TYPE 0)
(declare-sort COMPU-METHOD 0)
(declare-sort UNIT 0)
(declare-sort SW-BASE-TYPE 0)

; 存在性谓词（由 mapping 绑定到 XML 子元素是否存在）
(declare-fun has_valueAxisDataTypeRef (SW-DATA-DEF-PROPS-CONTENT) Bool)
(declare-fun has_compuMethodRef (SW-DATA-DEF-PROPS-CONTENT) Bool)
(declare-fun has_unitRef (SW-DATA-DEF-PROPS-CONTENT) Bool)
(declare-fun has_baseTypeRef (SW-DATA-DEF-PROPS-CONTENT) Bool)

; 约束：一旦 valueAxisDataTypeRef 存在，则其他三者不再“起作用”。
; 在结构层面可建成“互斥”近似：存在 valueAxisDataTypeRef 时，不应并行定义其他三者。
(assert
  (forall ((x SW-DATA-DEF-PROPS-CONTENT))
    (=> (has_valueAxisDataTypeRef x)
        (and (not (has_compuMethodRef x))
             (not (has_unitRef x))
             (not (has_baseTypeRef x))))))


; 5) ShortName identity not required for ApplicationPrimitiveDataType compatibility
; Constr_ApplicationPrimitiveDataType_ShortNameNotRequiredForCompatibility
; 语义：两个 ApplicationPrimitiveDataType 的兼容性不要求 shortName 相同。

(declare-sort APPLICATION-PRIMITIVE-DATA-TYPE_Compat 0)

; 兼容性谓词
(declare-fun compatible_Primitive (APPLICATION-PRIMITIVE-DATA-TYPE_Compat APPLICATION-PRIMITIVE-DATA-TYPE_Compat) Bool)

; shortName 访问函数（字符串 Sort 由模板其他部分声明，这里假设为 String）
(declare-sort String 0)
(declare-fun shortName (APPLICATION-PRIMITIVE-DATA-TYPE_Compat) String)

; 约束：兼容性不蕴含 shortName 相等（即不能把“shortName 相等”作为兼容性的必要条件）。
; 形式化为：存在一对兼容类型，其 shortName 可以不同。
; 注意：这是存在性约束，通常不适合作为一致性公理强制；此处仅文档化，不加 assert。
; （如果需要，可在特定环境中添加 witness 元素。）


; 6) AUTOSAR-typed PerInstanceMemory C++/Pointer Type Restriction
; Constr_AutosarTypedPIM_NoCppOrPointerTypes
; 语义：由于使用 AutosarDataType，AUTOSAR-typed PerInstanceMemory 不能直接支持 C++ 特定类型或指针类型。
; 在 XML 中 TYPE-TREF 的 DEST 已限制为 AUTOSAR 数据类型集合，本约束主要是语言层面说明，
; 不再添加额外 SMT 公理。


; 7) Avoid mapping multiple RunnableEntitys to the same symbol
; Constr_AvoidMultipleRunnableEntitysSameSymbol_7_2_4
; 语义：对于同一个 AtomicSwComponentType，不应有多个 RunnableEntity 映射到同一个 C 符号。

(declare-sort ATOMIC-SW-COMPONENT-TYPE 0)
(declare-sort RUNNABLE-ENTITY 0)

; 关联：某 AtomicSwComponentType 拥有哪些 RunnableEntity
(declare-fun ownsRunnable (ATOMIC-SW-COMPONENT-TYPE RUNNABLE-ENTITY) Bool)

; 每个 RunnableEntity 的 SYMBOL（C-IDENTIFIER）
(declare-fun symbol (RUNNABLE-ENTITY) String)

; 约束：同一 AtomicSwComponentType 下，两个不同的 RunnableEntity 不应拥有相同的 symbol。
(assert
  (forall ((c ATOMIC-SW-COMPONENT-TYPE)
           (r1 RUNNABLE-ENTITY)
           (r2 RUNNABLE-ENTITY))
    (=> (and (ownsRunnable c r1)
             (ownsRunnable c r2)
             (not (= r1 r2)))
        (not (= (symbol r1) (symbol r2)))))



