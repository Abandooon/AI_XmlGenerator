; =========================
; Text:
; "In particular, the RTE generator shall take over the value of the attribute
;  symbol of the symbolProps owned by a given AtomicSwComponentType.
;  If and only if symbolProps is not defined the RTE generator shall take the
;  shortName of the AtomicSwComponentType."
;
; We model this as an iff between "symbolProps exists" and "RTE uses symbolProps.symbol",
; and the complementary case for shortName.

; If symbolProps is defined, RTE must use symbolProps.symbol and not shortName.
(assert
  (forall ((c ATOMIC-SW-COMPONENT-TYPE))
    (=> (has_symbolProps c)
        (and (uses_symbolProps_symbol c)
             (not (uses_shortName_as_symbol c)))))

)

; If and only if symbolProps is not defined, RTE shall take the shortName.
; This gives the reverse direction and the complementary case.
(assert
  (forall ((c ATOMIC-SW-COMPONENT-TYPE))
    (= (not (has_symbolProps c))
       (uses_shortName_as_symbol c)))

)

