;---------------------------------------------------------------
; TPS_SWCT_01485 – The order of RuleArguments arguments shall be respected
;---------------------------------------------------------------

; RuleArguments is modeled as an ordered array of positions (indices)
(declare-sort INDEX 0)

; Presence of different argument kinds at a given index
(declare-fun hasV  (RULE-ARGUMENTS INDEX) Bool)
(declare-fun hasVF (RULE-ARGUMENTS INDEX) Bool)
(declare-fun hasVT (RULE-ARGUMENTS INDEX) Bool)
(declare-fun hasVTF(RULE-ARGUMENTS INDEX) Bool)

; The “order is respected” is essentially that the i-th argument in the
; conceptual argument list corresponds to the i-th element in the array.
; We capture this by stating that each index carries at most one kind.
(assert
  (forall ((ra RULE-ARGUMENTS) (i INDEX))
    (let ((kV   (hasV ra i))
          (kVF  (hasVF ra i))
          (kVT  (hasVT ra i))
          (kVTF (hasVTF ra i)))
      (=> (or kV kVF kVT kVTF)
          (and (=> kV   (and (not kVF) (not kVT) (not kVTF)))
               (=> kVF  (and (not kV)  (not kVT) (not kVTF)))
               (=> kVT  (and (not kV)  (not kVF) (not kVTF)))
               (=> kVTF (and (not kV)  (not kVF) (not kVT)))))))

