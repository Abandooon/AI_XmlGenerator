    (let ((bt (baseTypeDef_of_swBaseType x)))
      (=> (and (has_category_swBaseType x)
               (= (category_value_swBaseType x) "FIXED_LENGTH"))
          (and (has_baseTypeSize bt)
               (not (has_maxBaseTypeSize bt)))))))

; ###############################################################
; Constraint constr_1013 – Value of category is VARIABLE_LENGTH
; If SwBaseType.category = VARIABLE_LENGTH then:
;   maxBaseTypeSize shall exist
;   baseTypeSize shall NOT exist.

(assert
  (forall ((x SW-BASE-TYPE))
    (let ((bt (baseTypeDef_of_swBaseType x)))
      (=> (and (has_category_swBaseType x)
               (= (category_value_swBaseType x) "VARIABLE_LENGTH"))
          (and (has_maxBaseTypeSize bt)
               (not (has_baseTypeSize bt)))))))

