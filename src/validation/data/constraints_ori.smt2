; ---------- constr_1307: Consistency of values and masks ----------

; Definition of valueAllowedUnderMasks is left abstract; we only use it.
; Core requirement: if any mask is defined, all first/second values are allowed.

(assert
  (forall ((m TEXT-TABLE-MAPPING))
    (let ((n (valuePairs_count m)))
      (=> (or (has_bitfieldTextTableMaskFirst m)
              (has_bitfieldTextTableMaskSecond m))
          (and
            (forall ((i Int))
              (=> (and (<= 0 i) (< i n))
                  (let ((vp (select (valuePairs m) i)))
                    (and (valueAllowedUnderMasks m (firstValue vp))
                         (valueAllowedUnderMasks m (secondValue vp))))))))))

; ---------- constr_1308: NvBlockNeeds.cyclicWritingPeriod iff storeCyclic=true ----------

(assert
  (forall ((x NV-BLOCK-NEEDS))
    (= (has_cyclicWritingPeriod x)
       (and (has_storeCyclic x)
            (storeCyclic x)))))

; ---------- constr_1309: NvBlockDescriptor.timingEvent iff nvBlockNeeds.storeCyclic=true ----------

(assert
  (forall ((d NV-BLOCK-DESCRIPTOR))
    (let ((hasNeeds (has_nvBlockNeeds d))
          (needs    (nvBlockNeeds d)))
      (= (has_timingEventRef d)
         (and hasNeeds
              (has_storeCyclic needs)
              (storeCyclic needs))))))

; ---------- constr_1309 note: conceptual connection (documentation only) ----------

; No hard constraint; we only document intended relation:
; serviceNeeds_cyclicWritingPeriod(serviceNeeds_of(nvNeeds)) is a requirement
; that timingEvent_period(timingEventRef(descriptor)) is supposed to fulfill.

; ---------- constr_1310: NvBlockNeeds attributes vs assigned NvDataPort ----------

; Helper: there exists an assigned port with role = "NvDataPort"
(define-fun hasNvDataPortAssigned ((d SWC-SERVICE-DEPENDENCY)) Bool
  (let ((n (assignedPorts_count d)))
    (exists ((i Int))
      (and (<= 0 i) (< i n)
           (= (role (select (assignedPorts d) i)) "NvDataPort")))))

; For each ApplicationSwComponentType and each of its SwcServiceDependencies:
; if serviceNeeds is implemented by NvBlockNeeds and any of the four attributes
; exists, then there must be an assigned NvDataPort.
(assert
  (forall ((c APPLICATION-SW-COMPONENT-TYPE))
    (let ((n (swcServiceDependencies_count c)))
      (forall ((i Int))
        (=> (and (<= 0 i) (< i n))
            (let ((dep (select (swcServiceDependencies c) i))
                  (sn  (serviceNeeds dep)))
              (=> (serviceNeeds_isNvBlockNeeds sn)
