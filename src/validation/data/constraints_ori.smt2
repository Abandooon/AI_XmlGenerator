; ---------- TPS_SWCT_02003 - DiagnosticValueNeeds / signalBasedDiagnostics & RepresentedPortGroups N/A ----------
; AtomicSwComponentType offers PortPrototypes typed by SenderReceiverInterfaces to read/write current values via diagnostic services.
; Text gives:
;  - ServiceNeeds kind DiagnosticValueNeeds
;  - RoleBasedDataAssignment valid roles: signalBasedDiagnostics [1..2]
;  - RepresentedPortGroups: N/A (i.e., no represented port groups shall be used)

(declare-fun has_roleBasedDataAssignment (ATOMIC-SW-COMPONENT-TYPE ROLE-BASED-DATA-ASSIGNMENT) Bool)
(declare-fun role_is_signalBasedDiagnostics (ROLE-BASED-DATA-ASSIGNMENT) Bool)

; RepresentedPortGroups N/A: we model that no SWC-SERVICE-DEPENDENCY attached to such a component
; uses a represented port group. We introduce an abstract predicate for that usage.
(declare-fun uses_representedPortGroup (SWC-SERVICE-DEPENDENCY) Bool)

; If a component uses DiagnosticValueNeeds for signal-based diagnostics, then:
;  - it has at least one RoleBasedDataAssignment with role signalBasedDiagnostics
;  - none of its related service dependencies uses represented port groups
(assert
  (forall ((c ATOMIC-SW-COMPONENT-TYPE))
    (=> (exists ((sd SWC-SERVICE-DEPENDENCY) (sn SERVICE-NEEDS))
          (and (has_serviceDependency c sd)
               (has_serviceNeeds sd sn)
               (serviceNeeds_kind_DiagnosticValueNeeds sn)))
        (and
          (exists ((r ROLE-BASED-DATA-ASSIGNMENT))
            (and (has_roleBasedDataAssignment c r)
