          (forall ((sd SWC-SERVICE-DEPENDENCY))
            (=> (has_serviceDependency c sd)
                (not (uses_representedPortGroup sd))))))))


; ---------- TPS_SWCT_02003_PortOfferingRule - Port offering for diagnostic read/write signals ----------
; "To read the signal the AtomicSwComponentType shall offer an AbstractProvidedPortPrototype,
;  to write the signal the AtomicSwComponentType shall offer an AbstractRequiredPortPrototype."

; We introduce abstract predicates indicating that a component reads or writes a diagnostic signal.
(declare-fun reads_diagnosticSignal (ATOMIC-SW-COMPONENT-TYPE) Bool)
(declare-fun writes_diagnosticSignal (ATOMIC-SW-COMPONENT-TYPE) Bool)

; And predicates for port offerings:
(declare-fun offers_providedPort (ATOMIC-SW-COMPONENT-TYPE ABSTRACT-PROVIDED-PORT-PROTOTYPE) Bool)
(declare-fun offers_requiredPort (ATOMIC-SW-COMPONENT-TYPE ABSTRACT-REQUIRED-PORT-PROTOTYPE) Bool)

; Core constraints:
; If a component reads a diagnostic signal, it must offer at least one AbstractProvidedPortPrototype.
(assert
  (forall ((c ATOMIC-SW-COMPONENT-TYPE))
    (=> (reads_diagnosticSignal c)
        (exists ((p ABSTRACT-PROVIDED-PORT-PROTOTYPE))
          (offers_providedPort c p))))

; If a component writes a diagnostic signal, it must offer at least one AbstractRequiredPortPrototype.
(assert
  (forall ((c ATOMIC-SW-COMPONENT-TYPE))
