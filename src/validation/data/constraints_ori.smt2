; -------- Constraint 1278: PhysConstrs references a Unit --------
; DataConstrs are only compatible if the Units in their physConstrs are compatible
; or neither DataConstr has a unit reference.

(assert
  (forall ((d1 DATA-CONSTR) (d2 DATA-CONSTR))
    (=> (dataConstrsCompatible d1 d2)
        (let ((hasUnit1
                (exists ((r1 DATA-CONSTR-RULE) (p1 PHYS-CONSTRS) (u1 UNIT))
                  (and (has_dataConstrRule d1 r1)
                       (has_physConstrs r1 p1)
                       (has_unitRef p1 u1))))
              (hasUnit2
                (exists ((r2 DATA-CONSTR-RULE) (p2 PHYS-CONSTRS) (u2 UNIT))
                  (and (has_dataConstrRule d2 r2)
                       (has_physConstrs r2 p2)
                       (has_unitRef p2 u2)))))
          (or
            (and (not hasUnit1) (not hasUnit2))
            (exists ((r1 DATA-CONSTR-RULE) (p1 PHYS-CONSTRS) (u1 UNIT)
                     (r2 DATA-CONSTR-RULE) (p2 PHYS-CONSTRS) (u2 UNIT))
              (and (has_dataConstrRule d1 r1)
                   (has_physConstrs r1 p1)
                   (has_unitRef p1 u1)
                   (has_dataConstrRule d2 r2)
                   (has_physConstrs r2 p2)
                   (has_unitRef p2 u2)
                   (unitsCompatible u1 u2))))))))

; -------- Constraint 1279: swImplPolicy queued vs unmapped elements --------
; If swImplPolicy is queued it is not allowed to have unmapped elements of
; ApplicationCompositeDataTypes or ImplementationDataTypes of category STRUCTURE or ARRAY
; on the receiver side.

(assert
  (forall ((p ABSTRACT-REQUIRED-PORT-PROTOTYPE)
           (c NONQUEUED-RECEIVER-COM-SPEC)
           (e DATA-ELEMENT))
    (=> (and (= (swImplPolicyOfReceiver p) SWIMPL_QUEUED)
             (has_nonqueuedReceiverComSpec p c)
             (has_dataElement c e))
        (not (hasUnmappedElements e)))))

; The predicate hasUnmappedElements is expected to be defined (by mapping) such that it
; becomes true iff there exists an ApplicationCompositeDataType or ImplementationDataType
; of category STRUCTURE or ARRAY whose elements are not covered by any SubElementMapping
; for the given DATA-ELEMENT.

; -------- Constraint 1280: Unmapped dataElement shall have an initValue --------
; If elements of composite data types (STRUCTURE/ARRAY) are not considered in a
; SubElementMapping then the enclosing dataElement shall have an initValue, provided
; the NonqueuedReceiverComSpec is aggregated by an AbstractRequiredPortPrototype.

(assert
  (forall ((p ABSTRACT-REQUIRED-PORT-PROTOTYPE)
           (c NONQUEUED-RECEIVER-COM-SPEC)
           (e DATA-ELEMENT))
    (=> (and (has_nonqueuedReceiverComSpec p c)
             (has_dataElement c e)
             (hasUnmappedElements e))
        (has_initValue e true))))

; -------- Constraint 1281: invalidValue inside scope -> ApplicationValueSpecification --------
; If invalidValue of an ApplicationPrimitiveDataType of category VALUE is supposed to be
; inside the scope of the applicable CompuMethod, then an ApplicationValueSpecification
; is used to describe the invalidValue.

(assert
  (forall ((t APPLICATION-PRIMITIVE-DATA-TYPE)
           (p SW-DATA-DEF-PROPS)
           (c SW-DATA-DEF-PROPS-CONTENT))
    (=> (and (= (categoryOfAppPrimitive t) VALUE)
             (invalidInsideScope t)
             (has_swDataDefProps t p)
             (has_swDataDefPropsContent p c))
        (and
          (exists ((v APPLICATION-VALUE-SPECIFICATION))
            (has_invalidValue_AppVal c v))
          (not (exists ((n NUMERICAL-VALUE-SPECIFICATION))
                 (has_invalidValue_NumVal c n)))
          (not (exists ((r REFERENCE-VALUE-SPECIFICATION))
                 (has_invalidValue_RefVal c r)))
          (not (exists ((rb RULE-BASED-VALUE-SPECIFICATION))
                 (has_invalidValue_RuleVal c rb))))))

; -------- Constraint 1281_Explanation: Value range for ApplicationValueSpecification --------
; The value of the ApplicationValueSpecification (used for invalidValue as per 1281)
; shall be within the bounds defined by the applicable CompuMethod, either based on
; physToInternal or internalToPhys.

(assert
  (forall ((t APPLICATION-PRIMITIVE-DATA-TYPE)
           (p SW-DATA-DEF-PROPS)
           (c SW-DATA-DEF-PROPS-CONTENT)
           (m COMPU-METHOD)
           (v APPLICATION-VALUE-SPECIFICATION))
    (=> (and (= (categoryOfAppPrimitive t) VALUE)
             (invalidInsideScope t)
             (has_swDataDefProps t p)
             (has_swDataDefPropsContent p c)
             (has_compuMethod p m)
             (has_invalidValue_AppVal c v))
        (let ((val (valueOfAppVal v)))
          (or
            (exists ((cont COMPU-CONTENT) (s COMPU-SCALE))
              (and (has_compuPhysToInternal m cont)
                   (has_compuScale cont s)
                   (<= (lowerLimit s) val)
                   (<= val (upperLimit s))))
            (exists ((cont2 COMPU-CONTENT) (s2 COMPU-SCALE))
              (and (has_compuInternalToPhys m cont2)
                   (has_compuScale cont2 s2)
                   (<= (lowerLimit s2) val)
                   (<= val (upperLimit s2))))))))

; -------- Constraint 1282: Restriction on RuleBasedValueSpecification / ReferenceValueSpecification --------
; The aggregation of a RuleBasedValueSpecification or a ReferenceValueSpecification for
; the definition of ApplicationPrimitiveDataType.swDataDefProps.invalidValue is not supported.

(assert
  (forall ((t APPLICATION-PRIMITIVE-DATA-TYPE)
           (p SW-DATA-DEF-PROPS)
           (c SW-DATA-DEF-PROPS-CONTENT))
    (=> (and (has_swDataDefProps t p)
             (has_swDataDefPropsContent p c))
        (and
          (not (exists ((r REFERENCE-VALUE-SPECIFICATION))
                 (has_invalidValue_RefVal c r)))
          (not (exists ((rb RULE-BASED-VALUE-SPECIFICATION))
                 (has_invalidValue_RuleVal c rb))))))

; -------- Constraint 1283: invalidValue outside scope -> NumericalValueSpecification --------
; If invalidValue of an ApplicationPrimitiveDataType of category VALUE is supposed to be
; outside the scope of the applicable CompuMethod, then a NumericalValueSpecification
; shall be used to describe the invalidValue.

(assert
  (forall ((t APPLICATION-PRIMITIVE-DATA-TYPE)
           (p SW-DATA-DEF-PROPS)
           (c SW-DATA-DEF-PROPS-CONTENT))
    (=> (and (= (categoryOfAppPrimitive t) VALUE)
             (invalidOutsideScope t)
             (has_swDataDefProps t p)
             (has_swDataDefPropsContent p c))
        (and
          (exists ((n NUMERICAL-VALUE-SPECIFICATION))
            (has_invalidValue_NumVal c n))
          (not (exists ((v APPLICATION-VALUE-SPECIFICATION))
                 (has_invalidValue_AppVal c v)))
          (not (exists ((r REFERENCE-VALUE-SPECIFICATION))
                 (has_invalidValue_RefVal c r)))
          (not (exists ((rb RULE-BASED-VALUE-SPECIFICATION))
                 (has_invalidValue_RuleVal c rb))))))

