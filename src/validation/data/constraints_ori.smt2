; Axiom: if dynamicArraySizeProfile = "VSA_RECTANGULAR" then there exists a VSA payload element
(assert
  (forall ((t IMPLEMENTATION-DATA-TYPE))
    (=> (and (has_dynamicArraySizeProfile t)
             (= (dynamicArraySizeProfile t) "VSA_RECTANGULAR"))
        (exists ((e IMPLEMENTATION-DATA-TYPE-ELEMENT))
          (and (has_subElement t e)
               (is_VSA_Payload t e))))))

; VSA payload element conditions
(assert
  (forall ((t IMPLEMENTATION-DATA-TYPE) (e IMPLEMENTATION-DATA-TYPE-ELEMENT))
    (=> (is_VSA_Payload t e)
        (and
          ; arraySizeSemantics not defined
          (not (has_arraySizeSemantics e))
          ; category = ARRAY
          (and (has_category_IDTE e)
               (= (category_IDTE e) "ARRAY"))
          ; arraySize not defined
          (not (has_arraySize e))
          ; arraySizeHandling not defined
          (not (has_arraySizeHandling e))))))

; First dimension element conditions
(assert
  (forall ((e IMPLEMENTATION-DATA-TYPE-ELEMENT))
    (=> (is_firstDimensionElement e)
        (and
          (has_category_IDTE e)
          (= (category_IDTE e) "ARRAY")
          (has_arraySizeSemantics e)
          (= (arraySizeSemantics e) "variableSize")
          (has_arraySize e)
          (has_arraySizeHandling e)
          (= (arraySizeHandling e) "allIndicesSameArraySize")))))

; Intermediate elements conditions
(assert
  (forall ((e IMPLEMENTATION-DATA-TYPE-ELEMENT))
    (=> (is_intermediateElement e)
        (and
          (has_category_IDTE e)
          (= (category_IDTE e) "ARRAY")
          (has_arraySizeSemantics e)
          (= (arraySizeSemantics e) "variableSize")
          (has_arraySize e)
          (has_arraySizeHandling e)
          (= (arraySizeHandling e) "allIndicesSameArraySize")))))

; Terminating element conditions
(assert
  (forall ((e IMPLEMENTATION-DATA-TYPE-ELEMENT))
    (=> (is_terminatingElement e)
        (and
          (has_arraySizeSemantics e)
          (= (arraySizeSemantics e) "variableSize")
          (has_arraySize e)
          (has_arraySizeHandling e)
          (= (arraySizeHandling e) "allIndicesSameArraySize")))))

; Chain structure: VSA payload immediately aggregates first dimension element
(assert
  (forall ((t IMPLEMENTATION-DATA-TYPE) (p IMPLEMENTATION-DATA-TYPE-ELEMENT) (f IMPLEMENTATION-DATA-TYPE-ELEMENT))
    (=> (and (is_VSA_Payload t p)
             (aggregates_nextElement p f))
        (is_firstDimensionElement f)))

; Intermediate vs terminating: any non-terminating element with a nextElement is intermediate
(assert
  (forall ((e IMPLEMENTATION-DATA-TYPE-ELEMENT) (n IMPLEMENTATION-DATA-TYPE-ELEMENT))
    (=> (and (aggregates_nextElement e n)
             (not (= e n)))
        (is_intermediateElement e)))

; Element with no nextElement in the chain is terminating
(assert
  (forall ((e IMPLEMENTATION-DATA-TYPE-ELEMENT))
    (=> (and (not (exists ((n IMPLEMENTATION-DATA-TYPE-ELEMENT))
                     (aggregates_nextElement e n))))
        (is_terminatingElement e)))

;------------------------------
