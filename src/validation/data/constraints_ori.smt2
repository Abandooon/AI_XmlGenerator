(declare-fun effectiveDataConstr (SW-AXIS-INDIVIDUAL) DATA-CONSTR)
(declare-fun has_effectiveDataConstr (SW-AXIS-INDIVIDUAL) Bool)

(assert
  (forall ((x SW-AXIS-INDIVIDUAL))
    (=> (has_effectiveDataConstr x)
        (or
          ; 1) SwAxisIndividual.dataConstr
          (and (has_dataConstrRef x)
               (= (effectiveDataConstr x) (dataConstrRef x)))

          ; 2) SwAxisIndividual.inputVariableType.swDataDefProps.dataConstr
          (and (not (has_dataConstrRef x))
               (has_inputVariableTypeRef x)
               (exists ((p APPLICATION-PRIMITIVE-DATA-TYPE)
                        (d SW-DATA-DEF-PROPS-CONTENT))
                 (and (= p (inputVariableTypeRef x))
                      (has_swDataDefProps p d)
                      (has_dataConstr_in_swDataDefProps d)
                      (= (effectiveDataConstr x)
                         (dataConstr_in_swDataDefProps d)))))

          ; 3) SwAxisIndividual.swVariableRef.type.swDataDefProps.dataConstr
          (and (not (has_dataConstrRef x))
               (not (has_inputVariableTypeRef x))
               (exists ((v AUTOSAR-VARIABLE)
                        (d SW-DATA-DEF-PROPS-CONTENT))
                 (and (has_swVariableRef x v)
                      (has_dataConstr_in_var_swDataDefProps v d)
                      (has_dataConstr_in_swDataDefProps d)
                      (= (effectiveDataConstr x)
                         (dataConstr_in_swDataDefProps d)))))))))

