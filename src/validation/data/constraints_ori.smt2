; ---------- 7) Chapters support atpVariation with post-build binding time ----------
; Each chapter follows atpVariation stereotype; these variation points have post-build as latest binding time.

(declare-sort CHAPTER 0)
(declare-sort SW-COMPONENT-DOCUMENTATION 0)

; 章节是否有 VariationPoint
(declare-fun has_variationPoint_chapterNode (CHAPTER) Bool)
; 章节 VariationPoint 的绑定时间
(declare-fun bindingTime_chapter (CHAPTER) BindingTime)
; 章节是否使用 atpVariation stereotype
(declare-fun uses_atpVariation (CHAPTER) Bool)

; 核心约束：如果章节使用 atpVariation，则其 VariationPoint 的 latest binding time 为 postBuildTime
(assert
  (forall ((c CHAPTER))
    (=> (uses_atpVariation c)
        (= (bindingTime_chapter c) postBuildTime)))

