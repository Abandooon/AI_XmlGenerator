; ------------------------------------------------------------

(declare-sort INTERNAL-BEHAVIOR 0)
(declare-sort OPERATION-INVOKED-EVENT 0)
(declare-sort RUNNABLE-ENTITY 0)
(declare-sort PORT-DEFINED-ARGUMENT-VALUE 0)
(declare-sort CLIENT-SERVER-INTERFACE 0)
(declare-sort NVRAM-BLOCK-ID 0)

; InternalBehavior 所属的组件与接口
(declare-fun ib_of (NV-BLOCK-SW-COMPONENT-TYPE INTERNAL-BEHAVIOR) Bool)
(declare-fun uses_clientServerInterface
  (NV-BLOCK-SW-COMPONENT-TYPE CLIENT-SERVER-INTERFACE) Bool)

; InternalBehavior 中的元素
(declare-fun has_operationInvokedEvent
  (INTERNAL-BEHAVIOR OPERATION-INVOKED-EVENT) Bool)
(declare-fun has_serverRunnable
  (INTERNAL-BEHAVIOR RUNNABLE-ENTITY) Bool)
(declare-fun has_portDefinedArgumentValue
  (INTERNAL-BEHAVIOR PORT-DEFINED-ARGUMENT-VALUE) Bool)

; PortDefinedArgumentValue 携带的 NVRAM Block ID
(declare-fun nvramBlockId_of
  (PORT-DEFINED-ARGUMENT-VALUE NVRAM-BLOCK-ID) Bool)

; 可选：信息性约束（不作为强制 Violation）——如果组件通过 ClientServerInterface 使用 NvM API，
; 则其 InternalBehavior 应该至少包含一个 OperationInvokedEvent、一个 server Runnable、
; 和一个 PortDefinedArgumentValue。
; 验证器可根据 severity 将此视为 Warning/Info。
(assert
  (forall ((c NV-BLOCK-SW-COMPONENT-TYPE) (ib INTERNAL-BEHAVIOR))
    (=> (ib_of c ib)
        (=> (exists ((iface CLIENT-SERVER-INTERFACE))
              (uses_clientServerInterface c iface))
            (and
              (exists ((e OPERATION-INVOKED-EVENT))
                (has_operationInvokedEvent ib e))
              (exists ((r RUNNABLE-ENTITY))
                (has_serverRunnable ib r))
              (exists ((p PORT-DEFINED-ARGUMENT-VALUE))
                (has_portDefinedArgumentValue ib p)))))))


