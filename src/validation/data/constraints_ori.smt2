; ---------- constr_2009 ----------
; Supported kinds of PortPrototypes of a NvBlockSwComponentType
(assert
  (forall ((c NV-BLOCK-SW-COMPONENT-TYPE) (p PORT-PROTOTYPE))
    (=> (hasPort c p)
        (or
          ; Non-RPort: NvDataInterface or ClientServerInterface
          (and (not (isRPort p))
               (or (portTypedByNvDataInterface p)
                   (portTypedByClientServerInterface p)))
          ; RPort: ModeSwitchInterface
          (and (isRPort p)
               (rPortTypedByModeSwitchInterface (as p R-PORT-PROTOTYPE)))
        ))))

; ---------- constr_2010 ----------
; Connections between SwComponentPrototypes of type NvBlockSwComponentType
; "The existence of SwConnectors that refer to PortPrototypes belonging to
;  SwComponentPrototypes where both are typed by NvBlockSwComponentType is not permitted."
(assert
  (forall ((conn SW-CONNECTOR) (p1 PORT-PROTOTYPE) (p2 PORT-PROTOTYPE))
    (=> (connects conn p1 p2)
        (let ((c1 (ownerOfPort p1))
              (c2 (ownerOfPort p2)))
          (not (and
                 (isNvBlockSwComponentType (typeOfSwComponentPrototype c1))
                 (isNvBlockSwComponentType (typeOfSwComponentPrototype c2))))))))

; ---------- constr_2011 ----------
; Connections between SwComponentPrototypes typed by NvBlockSwComponentType
; and SwComponentPrototypes typed by other AtomicSwComponentTypes
; "The nv data PortPrototypes of the SwComponentPrototype typed by an NvBlockSwComponentType
;  are either connected with PortPrototypes typed by NvDataInterfaces or SenderReceiverInterfaces
;  of other AtomicSwComponentType."
(declare-fun portTypedBySenderReceiverInterface (PORT-PROTOTYPE) Bool)

(assert
  (forall ((conn SW-CONNECTOR) (pNv PORT-PROTOTYPE) (pOther PORT-PROTOTYPE))
    (=> (connects conn pNv pOther)
        (let ((cNv (ownerOfPort pNv))
              (cOther (ownerOfPort pOther)))
          (=> (isNvBlockSwComponentType (typeOfSwComponentPrototype cNv))
              (and
                (not (isNvBlockSwComponentType (typeOfSwComponentPrototype cOther)))
                (or (portTypedByNvDataInterface pOther)
                    (portTypedBySenderReceiverInterface pOther))))))))

; ---------- constr_2012 ----------
; Compatibility of ImplementationDataTypes used for ramBlock and romBlock
(assert
  (forall ((d NV-BLOCK-DESCRIPTOR))
    (let ((ram (ramBlockOf d)))
      (=> (hasRomBlock d)
          (let ((rom (romBlockOf d))
                (tRam (implTypeOfVar ram))
                (tRom (implTypeOfParam rom)))
            (implTypeCompatible tRam tRom))))))

; ---------- constr_2013 ----------
; Compatibility of ImplementationDataTypes for NvBlockDataMapping
(assert
  (forall ((m NV-BLOCK-DATA-MAPPING))
    (let ((ramElem (nvRamBlockElementOf m))
          (tRam (implTypeOfAutosarVariable (nvRamBlockElementOf m))))
      (and
        (=> (hasReadNvData m)
            (let ((tRead (implTypeOfAutosarVariable (readNvDataOf m)))
              )
              (implTypeCompatible tRam tRead)))
        (=> (hasWrittenNvData m)
            (let ((tW (implTypeOfAutosarVariable (writtenNvDataOf m)))
              )
              (implTypeCompatible tRam tW)))
        (=> (hasWrittenReadNvData m)
            (let ((tWR (implTypeOfAutosarVariable (writtenReadNvDataOf m)))
              )
              (implTypeCompatible tRam tWR)))))))

; ---------- constr_2014 ----------
; Limitation of RoleBasedPortAssignment.role in NvBlockDescriptors
; Only standardized AUTOSAR NVRAM Manager roles are allowed.
(assert
  (forall ((r ROLE-BASED-PORT-ASSIGNMENT))
    (or
      (= (roleName r) "NvMNotifyJobFinished")
      (= (roleName r) "NvMNotifyInitBlock"))))

; ---------- constr_2015 ----------
; Limitation of SwcInternalBehavior of a NvBlockSwComponentType

; 1) RunnableEntitys in the SwcInternalBehavior of NvBlockSwComponentType
;    must define only the mandatory attributes symbol and canBeInvokedConcurrently.
;    Here we enforce at least that these attributes are present.
(assert
  (forall ((c NV-BLOCK-SW-COMPONENT-TYPE) (r RUNNABLE-ENTITY))
    (=> (hasRunnable (internalBehaviorOf c) r)
        (and (hasSymbol r)
             (hasCanBeInvokedConcurrently r)))))

; 2) Only allowed event kinds and triggers are present in SwcInternalBehavior of NvBlockSwComponentType.
;    We model this as: any runnable belonging to such a behavior is triggered
;    only by the allowed event types.
(assert
  (forall ((c NV-BLOCK-SW-COMPONENT-TYPE) (r RUNNABLE-ENTITY))
    (=> (hasRunnable (internalBehaviorOf c) r)
        (or
          (exists ((e OPERATION-INVOKED-EVENT))
            (runnableTriggeredByOperationInvokedEvent r e))
          (exists ((e TIMING-EVENT))
            (runnableTriggeredByTimingEvent r e))
          (exists ((e DATA-RECEIVED-EVENT))
            (runnableTriggeredByDataReceivedEvent r e))
          (exists ((e SWC-MODE-SWITCH-EVENT))
            (runnableTriggeredBySwcModeSwitchEvent r e)))))

; 3) DataReceivedEvents and TimingEvents may include references to ModeDeclarations
;    in the role disabledMode – we only model existence of such references.
;    No additional restriction beyond typing is added here.
; (No extra assertion needed beyond the existence of hasDisabledMode / hasDisabledModeTiming.)

; Note: (check-sat) is intentionally omitted; the validator will add it.


