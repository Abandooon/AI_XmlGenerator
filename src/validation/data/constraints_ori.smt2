;-----------------------------
; Logical axioms (constraints)
;-----------------------------

;---------------------------------------------------------------
; constr_4000 – Local communication of mode switches
; Ports with ModeSwitchInterfaces cannot be connected across ECU boundaries.
;---------------------------------------------------------------
(assert
  (forall ((p1 PORT-PROTOTYPE) (p2 PORT-PROTOTYPE) (ifc MODE-SWITCH-INTERFACE) (e1 ECU) (e2 ECU))
    (=> (and (ports_connected p1 p2)
             (port_usesModeSwitchInterface p1 ifc)
             (port_usesModeSwitchInterface p2 ifc)
             (port_isOnEcu p1 e1)
             (port_isOnEcu p2 e2))
        (= e1 e2))))

;---------------------------------------------------------------
; constr_4002 – Unambiguous mapping of modes to data types
; Within one DataTypeMappingSet, a ModeDeclarationGroup shall not
; be mapped to different ImplementationDataTypes.
;---------------------------------------------------------------
(assert
  (forall ((d DATA-TYPE-MAPPING-SET)
           (g MODE-DECLARATION-GROUP)
           (t1 IMPLEMENTATION-DATA-TYPE)
           (t2 IMPLEMENTATION-DATA-TYPE))
    (=> (and (mappingSet_containsGroup d g)
             (mappingSet_mapsGroupToImplType d g t1)
             (mappingSet_mapsGroupToImplType d g t2))
        (= t1 t2))))

;---------------------------------------------------------------
; constr_4003 – Semantics of SwcModeSwitchEvent
; If activation is onTransition then event refers to two different
; ModeDeclarations in the same ModeDeclarationGroup; otherwise exactly one.
;---------------------------------------------------------------

; Helper: exactly-one and exactly-two cardinality over has_modeRef
; (expressed inline in the main axiom using quantifiers)

(assert
  (forall ((e SWC-MODE-SWITCH-EVENT))
    (let ((act (activation e)))
      (and
        ; Case 1: activation is onTransition → exactly two distinct modes
        (=> (isOnTransition act)
            (exists ((m1 MODE-DECLARATION) (m2 MODE-DECLARATION) (g MODE-DECLARATION-GROUP))
              (and (has_modeRef e m1)
                   (has_modeRef e m2)
                   (distinct m1 m2)
                   (mode_belongsToGroup m1 g)
                   (mode_belongsToGroup m2 g)
                   ; uniqueness: no third distinct mode referenced
                   (forall ((m3 MODE-DECLARATION))
                     (=> (has_modeRef e m3)
                         (or (= m3 m1) (= m3 m2)))))))
        ; Case 2: activation is not onTransition → exactly one mode
        (=> (not (isOnTransition act))
            (exists ((m MODE-DECLARATION))
              (and (has_modeRef e m)
                   (forall ((m2 MODE-DECLARATION))
                     (=> (has_modeRef e m2) (= m2 m))))))))))

;---------------------------------------------------------------
; constr_4004 – Context of SenderReceiverAnnotation
; A SenderReceiverAnnotation shall only be aggregated by a
; PortPrototype typed by a SenderReceiverInterface.
;---------------------------------------------------------------
(assert
  (forall ((a SENDER-RECEIVER-ANNOTATION) (p PORT-PROTOTYPE))
    (=> (annotation_ownerPort a p)
        (exists ((i SENDER-RECEIVER-INTERFACE))
          (port_typedBySenderReceiverInterface p i)))))

;---------------------------------------------------------------
; constr_4005 – Context of ClientServerAnnotation
; A ClientServerAnnotation shall only be aggregated by a
; PortPrototype typed by a ClientServerInterface.
;---------------------------------------------------------------
(assert
  (forall ((a CLIENT-SERVER-ANNOTATION) (p PORT-PROTOTYPE))
    (=> (csAnnotation_ownerPort a p)
        (exists ((i CLIENT-SERVER-INTERFACE))
          (port_typedByClientServerInterface p i)))))

;---------------------------------------------------------------
; constr_4006 – Context of ParameterPortAnnotation
; A ParameterPortAnnotation shall only be aggregated by a
; PPortPrototype owned by a ParameterSwComponentType.
;---------------------------------------------------------------
(assert
  (forall ((a PARAMETER-PORT-ANNOTATION) (p P-PORT-PROTOTYPE))
    (=> (paramAnnotation_ownerPort a p)
        (exists ((c PARAMETER-SW-COMPONENT-TYPE))
          (pPort_ownedByParamSwComponent p c)))))

;---------------------------------------------------------------
; constr_4007 – Context of ModePortAnnotation
; A ModePortAnnotation shall only be aggregated by a PortPrototype
; typed by a ModeSwitchInterface.
;---------------------------------------------------------------
(assert
  (forall ((a MODE-PORT-ANNOTATION) (p PORT-PROTOTYPE))
    (=> (modePortAnnotation_ownerPort a p)
        (exists ((i MODE-SWITCH-INTERFACE))
          (port_typedByModeSwitchInterface p i)))))

