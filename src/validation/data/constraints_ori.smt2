; Constr_SwDataDefProps_InvalidValueComparisonLimitation
; "if one is a NumericalValueSpecification and the other one is an
;  ApplicationValueSpecification and the application of the CompuMethod
;  on the side of the ApplicationValueSpecification does not yield a
;  valid number a comparison is not possible."
;
; This is a behavioral limitation: it states when comparison is *not*
; possible. It does not forbid any static configuration, it only
; constrains what a comparison operation may assume.
; We therefore introduce only documentation predicates, without
; enforcing additional static constraints.

(declare-sort NUMERICAL-VALUE-SPECIFICATION 0)
(declare-sort APPLICATION-VALUE-SPECIFICATION 0)
(declare-sort COMPU-METHOD 0)

; Whether a given ApplicationValueSpecification uses a given CompuMethod
(declare-fun usesCompuMethod
  (APPLICATION-VALUE-SPECIFICATION COMPU-METHOD) Bool)

; Whether applying a CompuMethod to an ApplicationValueSpecification yields a valid number
(declare-fun compuApplicationYieldsValidNumber
  (APPLICATION-VALUE-SPECIFICATION COMPU-METHOD) Bool)

; Whether a comparison between a NumericalValueSpecification and an
; ApplicationValueSpecification is possible (semantic predicate)
(declare-fun comparisonPossible
  (NUMERICAL-VALUE-SPECIFICATION APPLICATION-VALUE-SPECIFICATION) Bool)

; Logical documentation of the limitation:
; If the ApplicationValueSpecification uses some CompuMethod and that
; application does not yield a valid number, then comparison is not possible.
(assert
  (forall ((n NUMERICAL-VALUE-SPECIFICATION)
           (a APPLICATION-VALUE-SPECIFICATION)
           (c COMPU-METHOD))
    (=> (and (usesCompuMethod a c)
             (not (compuApplicationYieldsValidNumber a c)))
        (not (comparisonPossible n a)))))

