; ###############################################################
; constr_1291 - Limitation on the number of RPortComSpecs
; Within one RPortPrototype, at most one RPortComSpec per
; dataElement or clientServerOperation.
; ###############################################################

(assert
  (forall ((p R-PORT-PROTOTYPE)
           (c1 R-PORT-COM-SPEC)
           (c2 R-PORT-COM-SPEC)
           (de DATA-ELEMENT))
    (=> (and (has_RPortComSpec p c1)
             (has_RPortComSpec p c2)
             (rComSpec_dataElementRef c1 de)
             (rComSpec_dataElementRef c2 de))
        (= c1 c2))))

(assert
  (forall ((p R-PORT-PROTOTYPE)
           (c1 R-PORT-COM-SPEC)
           (c2 R-PORT-COM-SPEC)
           (op CLIENT-SERVER-OPERATION))
    (=> (and (has_RPortComSpec p c1)
             (has_RPortComSpec p c2)
             (rComSpec_operationRef c1 op)
             (rComSpec_operationRef c2 op))
        (= c1 c2))))

