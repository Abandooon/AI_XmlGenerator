; VSA payload element conditions for FULLY_FLEXIBLE
(assert
  (forall ((t IMPLEMENTATION-DATA-TYPE) (e IMPLEMENTATION-DATA-TYPE-ELEMENT))
    (=> (is_VSA_Payload_FF t e)
        (and
          (not (has_arraySizeSemantics e))
          (has_category_IDTE e)
          (= (category_IDTE e) "ARRAY")
          (not (has_arraySize e))
          (not (has_arraySizeHandling e))))))

; First dimension element existence (details of its attributes are not fully specified in the text snippet)
(assert
  (forall ((t IMPLEMENTATION-DATA-TYPE) (p IMPLEMENTATION-DATA-TYPE-ELEMENT))
