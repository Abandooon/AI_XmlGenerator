; Constr_SwDataDefProps_OverrideRestrictions_DataPrototype
; "the properties covering the structure shall not be redefined on
;  DataPrototype. Implementation policy, semantics and code generation
;  policy may be changed under consideration of compatibility rules."
;
; This is a meta-level rule about which SwDataDefProps aspects may be
; overridden. It requires a detailed model of which properties are
; "covering the structure" vs "policy" aspects. That information is not
; present in the current structural description, so we only introduce
; documentation-level predicates.

(declare-sort DATA-PROTOTYPE 0)
(declare-sort SW-DATA-DEF-PROPS 0)

; Whether a DataPrototype has its own SwDataDefProps
(declare-fun hasLocalSwDataDefProps (DATA-PROTOTYPE) Bool)

; Whether a given property of SwDataDefProps is structural (vs policy)
(declare-sort SWDDP-PROPERTY 0)
(declare-fun isStructuralProperty (SWDDP-PROPERTY) Bool)

; Whether a structural property is redefined on a DataPrototype
(declare-fun structuralPropertyRedefined
  (DATA-PROTOTYPE SWDDP-PROPERTY) Bool)

; Documentation axiom: structural properties shall not be redefined.
(assert
  (forall ((d DATA-PROTOTYPE) (p SWDDP-PROPERTY))
    (=> (isStructuralProperty p)
        (not (structuralPropertyRedefined d p))))

