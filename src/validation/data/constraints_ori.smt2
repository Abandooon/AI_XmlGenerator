; ---- constr_1104: Trigger sink and trigger source ----

; typing of ports
(declare-fun isTypedByTriggerInterface_P (P-PORT-PROTOTYPE) Bool)
(declare-fun isTypedByTriggerInterface_R (R-PORT-PROTOTYPE) Bool)

; connectors between ports
