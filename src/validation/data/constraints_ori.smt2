(declare-fun rPortOfConnector (SW-CONNECTOR) R-PORT-PROTOTYPE)

; PPortPrototype referenced by a connector
(declare-fun pPortOfConnector (SW-CONNECTOR) P-PORT-PROTOTYPE)

; ---- constr_1105: Value of arraySize (>0 for ARRAY) ----

; category of ImplementationDataType and ImplementationDataTypeElement
(declare-datatypes () ((ImplCategory ARRAY STRUCTURE UNION OTHER_CAT)))
(declare-fun category_IDT (IMPLEMENTATION-DATA-TYPE) ImplCategory)
(declare-fun category_IDTE (IMPLEMENTATION-DATA-TYPE-ELEMENT) ImplCategory)

; ownership
(declare-fun ownsElement (IMPLEMENTATION-DATA-TYPE IMPLEMENTATION-DATA-TYPE-ELEMENT) Bool)
(declare-fun ownsSubElement (IMPLEMENTATION-DATA-TYPE-ELEMENT IMPLEMENTATION-DATA-TYPE-ELEMENT) Bool)

; arraySize value (0 means absent)
(declare-fun arraySize (IMPLEMENTATION-DATA-TYPE-ELEMENT) Int)
(declare-fun has_arraySize (IMPLEMENTATION-DATA-TYPE-ELEMENT) Bool)

; ---- constr_1106 / 1107: STRUCTURE / UNION must have at least one element ----

; already covered by ownsElement / ownsSubElement and category_* above

; ---- constr_1108: Value of ApplicationError.errorCode ----

(declare-fun errorCode (APPLICATION-ERROR) Int)

; semantic predicate: whether this ApplicationError represents E_OK
(declare-fun representsE_OK (APPLICATION-ERROR) Bool)

; ---- constr_1109: Mapping of SwComponentPrototypes typed by a SensorActuatorSwComponentType ----

; typing
(declare-fun isTypedBy_SensorActuator (SW-COMPONENT-PROTOTYPE SENSOR-ACTUATOR-SW-COMPONENT-TYPE) Bool)

; reference from SensorActuatorSwComponentType to hardware description
(declare-fun sensorActuatorRef (SENSOR-ACTUATOR-SW-COMPONENT-TYPE) HW-TYPE)
(declare-fun has_sensorActuatorRef (SENSOR-ACTUATOR-SW-COMPONENT-TYPE) Bool)

; relation between HwType and HwElement
(declare-fun correspondsToHwType (HW-ELEMENT HW-TYPE) Bool)

; mapping of SW-COMPONENT-PROTOTYPE to ECU
(declare-fun mappedToECU (SW-COMPONENT-PROTOTYPE ECU) Bool)

; containment of HwElement in ECU
(declare-fun ecuContainsHwElement (ECU HW-ELEMENT) Bool)

; whether the SW-COMPONENT-PROTOTYPE accesses HW via I/O HAL
(declare-fun usesIOHAL (SW-COMPONENT-PROTOTYPE) Bool)

; -----------------------------
; Constraint assertions
; -----------------------------

; ---- constr_1104: Trigger sink and trigger source ----
; An RPortPrototype typed by a TriggerInterface shall not be referenced by
; more than one SwConnectors that are in turn referencing PPortPrototypes
; typed by TriggerInterfaces that contain Triggers with the same shortName.

(assert
  (forall ((r R-PORT-PROTOTYPE))
    (=> (isTypedByTriggerInterface_R r)
        (forall ((c1 SW-CONNECTOR) (c2 SW-CONNECTOR))
          (let ((r1 (rPortOfConnector c1))
                (r2 (rPortOfConnector c2)))
            (=> (and (= r1 r) (= r2 r)
                     (isTypedByTriggerInterface_P (pPortOfConnector c1))
                     (isTypedByTriggerInterface_P (pPortOfConnector c2)))
                (forall ((t1 TRIGGER) (t2 TRIGGER))
                  (=> (and (hasTrigger (interfaceOfTrigger t1) t1)
                           (hasTrigger (interfaceOfTrigger t2) t2)
                           (sameTriggerShortName t1 t2))
                      (= c1 c2))))))))

; ---- constr_1105: Value of arraySize (>0 for ARRAY) ----
; For ImplementationDataType or ImplementationDataTypeElement of category ARRAY,
; the value of arraySize of owned ImplementationDataTypeElement shall be > 0.

; Case 1: ImplementationDataType of category ARRAY
(assert
  (forall ((t IMPLEMENTATION-DATA-TYPE) (e IMPLEMENTATION-DATA-TYPE-ELEMENT))
    (=> (and (= (category_IDT t) ARRAY)
             (ownsElement t e)
             (has_arraySize e))
        (> (arraySize e) 0))))

; Case 2: ImplementationDataTypeElement of category ARRAY
(assert
  (forall ((e IMPLEMENTATION-DATA-TYPE-ELEMENT))
    (=> (and (= (category_IDTE e) ARRAY)
             (has_arraySize e))
        (> (arraySize e) 0))))

; ---- constr_1106: Structure shall have at least one element ----
; An ImplementationDataType or ImplementationDataTypeElement of category STRUCTURE
; shall own at least one ImplementationDataTypeElement.

; Case 1: ImplementationDataType of category STRUCTURE
(assert
  (forall ((t IMPLEMENTATION-DATA-TYPE))
    (=> (= (category_IDT t) STRUCTURE)
        (exists ((e IMPLEMENTATION-DATA-TYPE-ELEMENT))
          (ownsElement t e)))))

; Case 2: ImplementationDataTypeElement of category STRUCTURE
(assert
  (forall ((e IMPLEMENTATION-DATA-TYPE-ELEMENT))
    (=> (= (category_IDTE e) STRUCTURE)
        (exists ((sub IMPLEMENTATION-DATA-TYPE-ELEMENT))
          (ownsSubElement e sub)))))

; ---- constr_1107: Union shall have at least one element ----
; An ImplementationDataType or ImplementationDataTypeElement of category UNION
; shall own at least one ImplementationDataTypeElement.

; Case 1: ImplementationDataType of category UNION
(assert
  (forall ((t IMPLEMENTATION-DATA-TYPE))
    (=> (= (category_IDT t) UNION)
        (exists ((e IMPLEMENTATION-DATA-TYPE-ELEMENT))
          (ownsElement t e)))))

; Case 2: ImplementationDataTypeElement of category UNION
(assert
  (forall ((e IMPLEMENTATION-DATA-TYPE-ELEMENT))
    (=> (= (category_IDTE e) UNION)
        (exists ((sub IMPLEMENTATION-DATA-TYPE-ELEMENT))
          (ownsSubElement e sub)))))

; ---- constr_1108: Value of ApplicationError.errorCode ----
; errorCode shall not exceed 1..63, except that 0 is allowed only for E_OK.

(assert
  (forall ((a APPLICATION-ERROR))
    (let ((ec (errorCode a)))
      (and (>= ec 0)
           (<= ec 63)
           (=> (= ec 0) (representsE_OK a))
           (=> (representsE_OK a) (= ec 0))))))

; ---- constr_1109: Mapping of SwComponentPrototypes typed by a SensorActuatorSwComponentType ----
; A SwComponentPrototype typed by a SensorActuatorSwComponentType needs to be
; mapped and run on exactly that ECU that contains the HwElement corresponding
; to the HwType that its SensorActuatorSwComponentType refers to, if it uses IO HAL.

(assert
  (forall ((scp SW-COMPONENT-PROTOTYPE) (s SENSOR-ACTUATOR-SW-COMPONENT-TYPE))
    (=> (and (isTypedBy_SensorActuator scp s)
             (usesIOHAL scp)
             (has_sensorActuatorRef s))
        (let ((ht (sensorActuatorRef s)))
          (exists ((e HW-ELEMENT) (u ECU))
            (and (correspondsToHwType e ht)
                 (ecuContainsHwElement u e)
                 (mappedToECU scp u)
                 ; exactly-one ECU condition (functional mapping)
                 (forall ((u2 ECU))
                   (=> (mappedToECU scp u2) (= u2 u))))))))

; Note: (check-sat) is intentionally omitted.


