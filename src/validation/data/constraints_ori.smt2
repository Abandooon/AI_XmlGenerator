; Logical axioms
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;-------------------------
; constr_2536
; Target of an autosarVariable in AutosarVariableRef shall either be
; a VariableDataPrototype or an ApplicationCompositeElementDataPrototype
; that is owned by a VariableDataPrototype.
;-------------------------
(assert
  (forall ((r AUTOSAR-VARIABLE-REF))
    (=> (has_autosarVariableIRef r)
        (let ((iref (autosarVariableIRef r)))
          (or (irefTarget_is_VariableDataPrototype iref)
              (exists ((ace APPLICATION-COMPOSITE-ELEMENT-DATA-PROTOTYPE))
                (and (irefTarget_is_ApplicationCompositeElementDataPrototype iref)
                     ; ownership by some VariableDataPrototype
                     true)))))))

; Note: ownership relation is abstracted by ownerVariableDataPrototype and
; the predicate irefTarget_is_ApplicationCompositeElementDataPrototype.

;-------------------------
; constr_2544 – Limits need to be consistent
; 1) ApplicationDataType limits must be inside CompuMethod definition range.
; 2) Internal limits of ApplicationDataType (via CompuMethod) must be within
;    internalConstrs of mapped ImplementationDataType.
; 3) Limits of ImplementationDataType must be within limits defined by BaseType size.
;-------------------------

; 1) appType limits inside CompuMethod definition range
(assert
  (forall ((a APPLICATION-DATA-TYPE))
    (=> (and (has_swDataDefProps a)
             (has_compuMethodRef (swDataDefProps a)))
        (let* ((p (swDataDefProps a))
               (c (compuMethodRef p))
               (amin (appTypeLimitsMin a))
               (amax (appTypeLimitsMax a))
               (cmin (compuMethodInternalMin c amin))
               (cmax (compuMethodInternalMax c amax)))
          (and (<= cmin cmax)
               (<= cmin (compuMethodInternalMax c amin))
               (>= cmax (compuMethodInternalMin c amax)))))))

; 2) internal limits of ApplicationDataType within internalConstrs of ImplementationDataType
(assert
  (forall ((a APPLICATION-DATA-TYPE))
    (=> (and (has_swDataDefProps a)
             (has_compuMethodRef (swDataDefProps a))
             (has_implDataTypeRef a)
             (has_internalConstrs (implDataTypeRef a)))
        (let* ((p (swDataDefProps a))
               (c (compuMethodRef p))
               (i (implDataTypeRef a))
               (dc (internalConstrs i))
               (amin (appTypeLimitsMin a))
               (amax (appTypeLimitsMax a))
               (imin (compuMethodInternalMin c amin))
               (imax (compuMethodInternalMax c amax)))
          (and (>= imin (internalConstrMin dc))
               (<= imax (internalConstrMax dc)))))))

; 3) ImplementationDataType limits within BaseType limits
(assert
  (forall ((i IMPLEMENTATION-DATA-TYPE))
    (=> (and (has_internalConstrs i)
             (has_baseTypeRef i)
             (has_baseTypeSize (baseTypeRef i)))
        (let* ((dc (internalConstrs i))
               (b (baseTypeRef i))
               (size (baseTypeSize b))
               (imin (internalConstrMin dc))
               (imax (internalConstrMax dc))
               (bmin (baseTypeMin b size))
               (bmax (baseTypeMax b size)))
          (and (>= imin bmin)
               (<= imax bmax))))))

;-------------------------
; constr_2545 – invalidValue shall be in the range of the ImplementationDataType
;-------------------------
(assert
  (forall ((i IMPLEMENTATION-DATA-TYPE))
    (=> (and (has_swDataDefPropsContent i)
             (has_invalidValue (swDataDefPropsContent i))
             (has_internalConstrs i))
        (let* ((c (swDataDefPropsContent i))
               (iv (invalidValue c))
               (dc (internalConstrs i)))
          (and (>= iv (internalConstrMin dc))
               (<= iv (internalConstrMax dc)))))))

;-------------------------
; constr_2548 – Data constraint of value axis shall match
; Values compliant to SwDataDefProps.dataConstr shall also be compliant to
; SwDataDefProps.valueAxisDataType.swDataDefProps.dataConstr.
;-------------------------
(assert
  (forall ((p SW-DATA-DEF-PROPS-CONTENT))
    (=> (and (has_dataConstrRef p)
             (has_valueAxisDataTypeRef p))
        (let* ((dc_main (dataConstrRef p))
               (vat (valueAxisDataTypeRef p)))
          (=> (and (has_swDataDefProps_forValueAxis vat)
                   (has_dataConstrRef_forValueAxis
                     (swDataDefProps_forValueAxis vat)))
              (let ((dc_axis (dataConstrRef_forValueAxis
                               (swDataDefProps_forValueAxis vat))))
                (and (>= (internalConstrMin dc_main)
                         (internalConstrMin dc_axis))
                     (<= (internalConstrMax dc_main)
                         (internalConstrMax dc_axis))))))))

;-------------------------
; constr_2549 – Units of input axis shall be compatible
;-------------------------
(assert
  (forall ((a SW-AXIS-INDIVIDUAL))
    (let ((hasAnyUnit
            (or (and (has_inputVariableTypeRef a)
                     (has_unitRef_appType (inputVariableTypeRef a)))
                (and (has_compuMethodRef_axis a)
                     (has_unitRef_compu (compuMethodRef_axis a)))
                (has_unitRef_axis a))))
      (=> hasAnyUnit
          (and
            ; if both inputVariableType and axis unit present -> same unit
            (=> (and (has_inputVariableTypeRef a)
                     (has_unitRef_appType (inputVariableTypeRef a))
                     (has_unitRef_axis a))
                (= (unitRef_appType (inputVariableTypeRef a))
                   (unitRef_axis a)))
            ; if both compuMethod and axis unit present -> same unit
            (=> (and (has_compuMethodRef_axis a)
                     (has_unitRef_compu (compuMethodRef_axis a))
                     (has_unitRef_axis a))
                (= (unitRef_compu (compuMethodRef_axis a))
                   (unitRef_axis a)))
            ; if both inputVariableType and compuMethod units present -> compatible
            (=> (and (has_inputVariableTypeRef a)
                     (has_unitRef_appType (inputVariableTypeRef a))
                     (has_compuMethodRef_axis a)
                     (has_unitRef_compu (compuMethodRef_axis a)))
                (= (unitRef_appType (inputVariableTypeRef a))
                   (unitRef_compu (compuMethodRef_axis a))))))))

;-------------------------
; constr_2550 – Units of value axis shall be the same
;-------------------------
(assert
  (forall ((p SW-DATA-DEF-PROPS-CONTENT))
    (let ((hasAnyUnit
            (or (and (has_valueAxisDataTypeRef_valueAxis p)
                     (has_unitRef_appType
                       (valueAxisDataTypeRef_valueAxis p)))
                (and (has_compuMethodRef_valueAxis p)
                     (has_unitRef_compu (compuMethodRef_valueAxis p)))
                (has_unitRef_valueAxis p))))
      (=> hasAnyUnit
          (and
            ; valueAxisDataType vs local unit
            (=> (and (has_valueAxisDataTypeRef_valueAxis p)
                     (has_unitRef_appType
                       (valueAxisDataTypeRef_valueAxis p))
                     (has_unitRef_valueAxis p))
                (= (unitRef_appType (valueAxisDataTypeRef_valueAxis p))
                   (unitRef_valueAxis p)))
            ; compuMethod vs local unit
            (=> (and (has_compuMethodRef_valueAxis p)
                     (has_unitRef_compu (compuMethodRef_valueAxis p))
                     (has_unitRef_valueAxis p))
                (= (unitRef_compu (compuMethodRef_valueAxis p))
                   (unitRef_valueAxis p)))
            ; valueAxisDataType vs compuMethod
            (=> (and (has_valueAxisDataTypeRef_valueAxis p)
                     (has_unitRef_appType
                       (valueAxisDataTypeRef_valueAxis p))
                     (has_compuMethodRef_valueAxis p)
                     (has_unitRef_compu (compuMethodRef_valueAxis p)))
                (= (unitRef_appType (valueAxisDataTypeRef_valueAxis p))
                   (unitRef_compu (compuMethodRef_valueAxis p))))))))

;-------------------------
; constr_2561 – DataConstrRule.constrLevel limited to 0 or 1
;-------------------------
(assert
  (forall ((r DATA-CONSTR-RULE))
    (=> (has_constrLevel r)
        (or (= (constrLevel r) 0)
            (= (constrLevel r) 1)))))


