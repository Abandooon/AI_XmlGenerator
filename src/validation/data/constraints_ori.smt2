; ###############################################################
; constr_1295 - PortInterfaces and category DATA_REFERENCE
;
; A DataPrototype defined in a PortInterface used by an
; ApplicationSwComponentType or SensorActuatorSwComponentType
; that is (after TYPE_REFERENCE resolution) typed by or mapped to
; an ImplementationDataType of category DATA_REFERENCE shall only
; be used if either the provider or the requester of the
; information represents one of:
;   ServiceSwComponentType, ComplexDeviceDriverSwComponentType,
;   ParameterSwComponentType, NvBlockSwComponentType,
;   EcuAbstractionSwComponentType.
; ###############################################################

(assert
  (forall ((pi PORT-INTERFACE)
           (dp DATA-PROTOTYPE)
           (t IMPLEMENTATION-DATA-TYPE))
    (=> (and (dataPrototype_definedInPortInterface dp pi)
             (or (portInterface_usedByAppSwc pi (as @a APPLICATION-SW-COMPONENT-TYPE))
                 (portInterface_usedBySensorActuatorSwc pi (as @s SENSOR-ACTUATOR-SW-COMPONENT-TYPE)))
             (or (dataPrototype_typedBy dp t)
                 (dataPrototype_mappedTo dp t))
             (is_DATA_REFERENCE t))
        (or (portInterface_provider_ServiceSwc pi (as @svc SERVICE-SW-COMPONENT-TYPE))
            (portInterface_requester_ServiceSwc pi (as @svc2 SERVICE-SW-COMPONENT-TYPE))
            (portInterface_provider_CddSwc pi (as @cdd COMPLEX-DEVICE-DRIVER-SW-COMPONENT-TYPE))
            (portInterface_requester_CddSwc pi (as @cdd2 COMPLEX-DEVICE-DRIVER-SW-COMPONENT-TYPE))
            (portInterface_provider_ParameterSwc pi (as @par PARAMETER-SW-COMPONENT-TYPE))
            (portInterface_requester_ParameterSwc pi (as @par2 PARAMETER-SW-COMPONENT-TYPE))
            (portInterface_provider_NvBlockSwc pi (as @nv NV-BLOCK-SW-COMPONENT-TYPE))
            (portInterface_requester_NvBlockSwc pi (as @nv2 NV-BLOCK-SW-COMPONENT-TYPE))
            (portInterface_provider_EcuAbstractionSwc pi (as @ecu ECU-ABSTRACTION-SW-COMPONENT-TYPE))
            (portInterface_requester_EcuAbstractionSwc pi (as @ecu2 ECU-ABSTRACTION-SW-COMPONENT-TYPE))))))

; ###############################################################
; constr_1296 - IRV VariableDataPrototype and DATA_REFERENCE
;
; A VariableDataPrototype shall not be aggregated by
; SwcInternalBehavior as explicitInterRunnableVariable or
; implicitInterRunnableVariable if its ImplementationDataType
; (typed or mapped) has category DATA_REFERENCE.
; ###############################################################

(assert
  (forall ((b SWC-INTERNAL-BEHAVIOR)
           (v VARIABLE-DATA-PROTOTYPE)
           (t IMPLEMENTATION-DATA-TYPE))
    (=> (and (explicitIRV b v)
             (or (variable_typedBy v t)
                 (variable_mappedTo v t))
             (is_DATA_REFERENCE t))
        false)))

(assert
  (forall ((b SWC-INTERNAL-BEHAVIOR)
           (v VARIABLE-DATA-PROTOTYPE)
           (t IMPLEMENTATION-DATA-TYPE))
    (=> (and (implicitIRV b v)
             (or (variable_typedBy v t)
                 (variable_mappedTo v t))
             (is_DATA_REFERENCE t))
        false)))

; ###############################################################
; constr_1297 - Applicability of serverArgumentImplPolicy = useArrayBaseType
;
; serverArgumentImplPolicy may be set to useArrayBaseType only if
; the ArgumentDataPrototype is typed by or mapped to an
; ImplementationDataType of category ARRAY, or mapped to an
; ApplicationDataType which in turn is mapped to an
; ImplementationDataType of category ARRAY.
; ###############################################################

(assert
  (forall ((a ARGUMENT-DATA-PROTOTYPE))
    (=> (serverArgumentImplPolicy_useArrayBaseType a)
        (exists ((t IMPLEMENTATION-DATA-TYPE)
                 (adt APPLICATION-DATA-TYPE))
          (or (and (arg_typedBy a t)
                   (is_ARRAY t))
              (and (arg_mappedTo a t)
                   (is_ARRAY t))
              (and (arg_mappedToAppType a adt)
                   (exists ((t2 IMPLEMENTATION-DATA-TYPE))
                     (and (appType_mappedToImpl adt t2)
                          (is_ARRAY t2)))))))))

; ###############################################################
; constr_1298 - EXPLICIT_ORDER => onTransitionValue & ModeDeclaration.value set
; ###############################################################

(assert
  (forall ((g MODE-DECLARATION-GROUP))
    (=> (mdg_isExplicitOrder g)
        (mdg_onTransitionValue_set g))))

(assert
  (forall ((g MODE-DECLARATION-GROUP)
           (m MODE-DECLARATION))
    (=> (and (mdg_isExplicitOrder g)
             (mdg_hasModeDeclaration g m))
        (modeDecl_value_set m))))

; ###############################################################
; constr_1299 - category != EXPLICIT_ORDER => attributes not set
; ###############################################################

(assert
  (forall ((g MODE-DECLARATION-GROUP))
    (=> (not (mdg_isExplicitOrder g))
        (not (mdg_onTransitionValue_set g))))

(assert
  (forall ((g MODE-DECLARATION-GROUP)
           (m MODE-DECLARATION))
    (=> (and (not (mdg_isExplicitOrder g))
             (mdg_hasModeDeclaration g m))
        (not (modeDecl_value_set m)))))

