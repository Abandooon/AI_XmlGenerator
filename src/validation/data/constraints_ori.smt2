(assert
  (forall ((a APPLICATION-PRIMITIVE-DATA-TYPE))
    (=> (= (category_of a) STRING)
        (and (has_swDataDefProps a)
             (let ((p (swDataDefProps_of a)))
               (and (has_swTextProps p)
                    (let ((t (swTextProps_of p)))
                      (and (has_baseTypeRef t)
