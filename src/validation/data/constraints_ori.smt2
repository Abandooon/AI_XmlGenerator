; ========= TPS_SWCT_01425 =========
; AtomicSwComponentType provides one callback per event if diagnostic event data change
; 语义抽象：
;  - 若某 AtomicSwComponentType 具有 DiagnosticEventInfoNeeds，
;    则对每个相关事件应有且仅有一个 PPort，其 Role 为 CallbackEventDataChanged。
; 由于“每个事件”的建模超出当前结构信息，这里只表达：
;  - 若有 DiagnosticEventInfoNeeds，则至少存在一个 CallbackEventDataChanged 角色的 PPort。
;  - 且该角色在该组件内是功能性的（同一 PPort 不重复，且不同 PPort 不共享该角色）。
; （真正的“每事件一回调”需要事件维度的额外 Sort/谓词，这里不展开。）

(assert
  (forall ((c ATOMIC-SW-COMPONENT-TYPE))
    (=> (exists ((sn SERVICE-NEEDS))
          (and (has_ServiceNeeds c sn)
               (is_DiagnosticEventInfoNeeds sn)))
        (exists ((p P-PORT-PROTOTYPE) (r ROLE-BASED-PORT-ASSIGNMENT))
          (and (has_PPort c p)
               (has_RoleBasedPortAssignment p r)
               (role_CallbackEventDataChanged r)
               (uses_GeneralCallbackEventDataChanged_IF p))))))

; 可选：功能性（同一组件中 CallbackEventDataChanged 角色的 PPort 唯一）
(assert
  (forall ((c ATOMIC-SW-COMPONENT-TYPE) (p1 P-PORT-PROTOTYPE) (p2 P-PORT-PROTOTYPE)
           (r1 ROLE-BASED-PORT-ASSIGNMENT) (r2 ROLE-BASED-PORT-ASSIGNMENT))
    (=> (and (has_PPort c p1)
             (has_PPort c p2)
             (has_RoleBasedPortAssignment p1 r1)
             (has_RoleBasedPortAssignment p2 r2)
             (role_CallbackEventDataChanged r1)
             (role_CallbackEventDataChanged r2)
             (uses_GeneralCallbackEventDataChanged_IF p1)
             (uses_GeneralCallbackEventDataChanged_IF p2))
        (= p1 p2))))

; ========= TPS_SWCT_01426 =========
; AtomicSwComponentType provides callback if any diagnostic event data and/or status changed
; 语义抽象：
;  - 对 DiagnosticEventManagerNeeds：
;    • GeneralCallbackEventDataChanged [0..1]
;    • GeneralCallbackEventStatusChange [0..1]
;    • GeneralDiagnosticInfo [0..1]
;  - 文本进一步说明：
;    • 为状态变化提供单一 PPort（GeneralCallbackEventStatusChange 接口）
;    • 为数据变化提供单一 PPort（GeneralCallbackEventDataChanged 接口）
;    • 若还需读取更多信息，则提供一个 RPort（GeneralDiagnosticInfo 接口）并指定 DiagnosticEventInfoNeeds

; 若组件具有 DiagnosticEventManagerNeeds，则：
;  - 至多一个 GeneralCallbackEventDataChanged PPort
;  - 至多一个 GeneralCallbackEventStatusChange PPort
;  - 至多一个 GeneralDiagnosticInfo RPort（并且若存在则 has_DiagnosticEventInfoNeeds）

; GeneralCallbackEventDataChanged PPort 唯一性
(assert
  (forall ((c ATOMIC-SW-COMPONENT-TYPE)
           (p1 P-PORT-PROTOTYPE) (p2 P-PORT-PROTOTYPE)
           (r1 ROLE-BASED-PORT-ASSIGNMENT) (r2 ROLE-BASED-PORT-ASSIGNMENT))
    (=> (and (exists ((sn SERVICE-NEEDS))
                (and (has_ServiceNeeds c sn)
                     (is_DiagnosticEventManagerNeeds sn)))
             (has_PPort c p1)
             (has_PPort c p2)
             (has_RoleBasedPortAssignment p1 r1)
             (has_RoleBasedPortAssignment p2 r2)
             (role_GeneralCallbackEventDataChanged r1)
             (role_GeneralCallbackEventDataChanged r2)
             (uses_GeneralCallbackEventDataChanged_IF p1)
             (uses_GeneralCallbackEventDataChanged_IF p2))
        (= p1 p2))))

; GeneralCallbackEventStatusChange PPort 唯一性
(assert
  (forall ((c ATOMIC-SW-COMPONENT-TYPE)
           (p1 P-PORT-PROTOTYPE) (p2 P-PORT-PROTOTYPE)
           (r1 ROLE-BASED-PORT-ASSIGNMENT) (r2 ROLE-BASED-PORT-ASSIGNMENT))
    (=> (and (exists ((sn SERVICE-NEEDS))
                (and (has_ServiceNeeds c sn)
                     (is_DiagnosticEventManagerNeeds sn)))
             (has_PPort c p1)
             (has_PPort c p2)
             (has_RoleBasedPortAssignment p1 r1)
             (has_RoleBasedPortAssignment p2 r2)
             (role_GeneralCallbackEventStatusChange r1)
             (role_GeneralCallbackEventStatusChange r2)
             (uses_GeneralCallbackEventStatusChange_IF p1)
             (uses_GeneralCallbackEventStatusChange_IF p2))
        (= p1 p2))))

; GeneralDiagnosticInfo RPort 唯一性 + 若存在则 has_DiagnosticEventInfoNeeds
(assert
  (forall ((c ATOMIC-SW-COMPONENT-TYPE)
           (r1 R-PORT-PROTOTYPE) (r2 R-PORT-PROTOTYPE))
    (=> (and (exists ((sn SERVICE-NEEDS))
                (and (has_ServiceNeeds c sn)
                     (is_DiagnosticEventManagerNeeds sn)))
             (has_RPort c r1)
             (has_RPort c r2)
             (uses_GeneralDiagnosticInfo_IF_R r1)
             (uses_GeneralDiagnosticInfo_IF_R r2))
        (and (= r1 r2)
             (has_DiagnosticEventInfoNeeds c)))))

