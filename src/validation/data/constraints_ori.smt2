(declare-sort SW-COMPONENT-TYPE 0)

; 可选：抽象谓词，表明某 PortPrototype 属于某 SW-COMPONENT-TYPE
(declare-fun belongsToSwComponentType (PORT-PROTOTYPE SW-COMPONENT-TYPE) Bool)
(declare-fun isAtomicSwComponentType (SW-COMPONENT-TYPE) Bool)

; 不添加“only-if”之类的限制性公理，以保持“使用范围不受限”的语义。

