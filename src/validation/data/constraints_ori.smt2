;     category = ARRAY
;     no arraySize
;     arraySizeHandling = inheritedFromArrayElementTypeSize
; - There is a chain of intermediate elements i (zero or more) with:
;     arraySizeSemantics = variableSize
;     category = ARRAY
;     no arraySize
;     arraySizeHandling = inheritedFromArrayElementTypeSize
; - The terminating element t has:
;     arraySizeSemantics = variableSize
;     arraySize defined
;     arraySizeHandling = allIndicesSameArraySize

(declare-fun VSASquareImplChainOK (IMPLEMENTATION-DATA-TYPE IMPLEMENTATION-DATA-TYPE-ELEMENT) Bool)

(assert
  (forall ((idt IMPLEMENTATION-DATA-TYPE))
    (=> (= (dynamicArraySizeProfile_impl idt) "VSA_SQUARE")
        (exists ((p IMPLEMENTATION-DATA-TYPE-ELEMENT))
          (and
            (hasSubElement idt p)
            (isVSAPayloadElement idt p)
            (= (category_impl p) "ARRAY")
            (not (hasArraySize p))
            (not (exists ((dummy String))
                   (= dummy (arraySizeSemantics_impl p))))
            (not (exists ((dummy2 String))
                   (= dummy2 (arraySizeHandling_impl p))))
            (VSASquareImplChainOK idt p))))))

; VSASquareImplChainOK abstracts the chain conditions described above.


