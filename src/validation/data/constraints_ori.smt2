;---------------------------------------------------------------
; constr_4008 - Context of TriggerPortAnnotation
; A TriggerPortAnnotation shall only be aggregated by a
; PortPrototype typed by a TriggerInterface.
;---------------------------------------------------------------
(assert
  (forall ((a TRIGGER-PORT-ANNOTATION))
    (let ((p (parentPortOfTriggerPortAnnotation a)))
      (portTypeIsTriggerInterface p))))

;---------------------------------------------------------------
; constr_4009 - Context of NvDataPortAnnotation
; An NvDataPortAnnotation shall only be aggregated by a
; PortPrototype typed by an NvDataInterface.
;---------------------------------------------------------------
(assert
  (forall ((a NV-DATA-PORT-ANNOTATION))
    (let ((p (parentPortOfNvDataPortAnnotation a)))
      (portTypeIsNvDataInterface p))))

;---------------------------------------------------------------
; constr_4010 - Context of DelegatedPortAnnotation
; A DelegatedPortAnnotation shall only be aggregated by a
; PortPrototype aggregated by a CompositionSwComponentType.
;---------------------------------------------------------------
(assert
  (forall ((a DELEGATED-PORT-ANNOTATION))
    (let ((p (parentPortOfDelegatedPortAnnotation a)))
      (portIsInComposition p))))

;---------------------------------------------------------------
; constr_4012 - Timeout of ModeSwitchedAckEvent
; The timeout value of a Wait Point associated with a
; ModeSwitchedAckEvent shall be equal to the corresponding
; ModeSwitchedAckRequest.timeout.
;---------------------------------------------------------------
(assert
  (forall ((e MODE-SWITCHED-ACK-EVENT))
    (let ((wp (waitPointOfEvent e))
          (req (requestOfEvent e)))
      (timeValueEq (timeoutOfWaitPoint wp)
                   (timeoutOfRequest req)))))

;---------------------------------------------------------------
; constr_4035 - ValueSpecification shall fit into data type
; An instance of ValueSpecification which is used to assign a
; value to a software object typed by an AutosarDataType shall
; fit into this AutosarDataType without losing information.
;---------------------------------------------------------------
(assert
  (forall ((v VALUE-SPECIFICATION))
    (let ((dt (valueAssignedTo v)))
      (fitsInto v dt))))

;---------------------------------------------------------------
; constr_4082 - RunnableEntity.reentrancyLevel shall not be set.
;---------------------------------------------------------------
(assert
  (forall ((r RUNNABLE-ENTITY))
    (not (hasReentrancyLevel r))))

