;################################################################
; constr_1153 – Applicability of compatibility requirements for CompuScales
;################################################################
; Documentation: Compatibility requirements for CompuScales are only
; required for CompuScales whose enclosing CompuMethod has one of the
; listed categories. Here we encode the enabling condition as a predicate.

(define-fun compatibilityCategoryEnabled ((m COMPU-METHOD)) Bool
  (or (= (category m) "SCALE_LINEAR_AND_TEXTTABLE")
      (= (category m) "SCALE_RATIONAL_AND_TEXTTABLE")
      (= (category m) "TEXTTABLE")
      (= (category m) "TAB_NOINTP")
      (= (category m) "BITFIELD_TEXTTABLE")
      (= (category m) "LINEAR")
      (= (category m) "RAT_FUNC")
      (= (category m) "IDENTICAL")))

;################################################################
; constr_1154 – Compatibility of CompuScales for sender-receiver communication
;################################################################
; Logical pattern (documentation only):
; For sender-receiver communication, for each pair of provider/required
; CompuMethods (m_prov, m_req) used on PPort/RPort, we require:
;   { s | scaleOf(m_prov, s) } ⊆ { s | scaleOf(m_req, s) }
; This is a cross-component, communication-pattern-level constraint and
; depends on port wiring; we do not formalize the wiring here.

;################################################################
; constr_1155 – Compatibility of CompuScales for client-server communication
;################################################################
; Logical pattern (documentation only):
; For each client/server pair of CompuMethods and each operation argument:
;   - direction IN:   scales(client) ⊆ scales(server)
;   - direction OUT:  scales(server) ⊆ scales(client)
;   - direction INOUT: scales(client) = scales(server)
; This requires explicit modelling of operations, arguments and directions,
; which is outside the current template scope.

;################################################################
; constr_1156 – Relevance of \"names\" of CompuScales
;################################################################
; Text:
;   CompuScales which contribute to tabular conversion by having a
;   compuConst are compatible iff the \"names\" of the CompuScales
;   (shortLabel, compuConst and symbol) are equal.
;   If the scale has no compuConst, \"names\" are not relevant.

; We model a binary compatibility predicate between CompuScales.

(declare-fun compatibleScale (COMPU-SCALE COMPU-SCALE) Bool)

; Core iff constraint:
(assert
  (forall ((s1 COMPU-SCALE) (s2 COMPU-SCALE))
    (let ((c1 (has_compuConst s1))
          (c2 (has_compuConst s2)))
      (and
        ; If both contribute to tabular conversion, compatibility iff names equal
        (=> (and c1 c2)
            (= (compatibleScale s1 s2)
               (and (= (shortLabel s1) (shortLabel s2))
                    (= (symbol s1) (symbol s2))
                    (= (compuConstName s1) (compuConstName s2)))))
        ; If at least one does not have compuConst, this constraint does not
        ; impose conditions on compatibleScale (names not relevant).
      ))))

;################################################################
; constr_1157 – Applicability of constraints of CompuScales
;################################################################
; Text:
;   The constraints [constr_1154], [constr_1155], and [constr_1156]
;   shall only apply in the absence of a TextTableMapping which shall
;   take precedence regarding the compatibility if it exists.

; We encode this as an enabling predicate for each CompuScale:
; if has_TextTableMapping(s) then the compatibility constraints are disabled.

(define-fun compatibilityConstraintsEnabled ((s COMPU-SCALE)) Bool
  (not (has_TextTableMapping s)))

; Example: we gate the compatibleScale predicate by this enabling condition
; for scales that have compuConst (tabular conversion).
(assert
  (forall ((s1 COMPU-SCALE) (s2 COMPU-SCALE))
    (=> (and (has_compuConst s1)
             (has_compuConst s2)
             (compatibilityConstraintsEnabled s1)
             (compatibilityConstraintsEnabled s2))
        (= (compatibleScale s1 s2)
           (and (= (shortLabel s1) (shortLabel s2))
                (= (symbol s1) (symbol s2))
                (= (compuConstName s1) (compuConstName s2))))))

;################################################################
; constr_1158 – Applicable categories for ImplementationDataType.swDataDefProps.compuMethod
;################################################################
; Text:
;   The definition of the reference ImplementationDataType.swDataDefProps.compuMethod
;   is restricted to a CompuMethod of either category BITFIELD_TEXTTABLE or TEXTTABLE.

; We generalize to AUTOSAR-DATA-TYPE; the mapping will bind this to
; IMPLEMENTATION-DATA-TYPE where appropriate.

(assert
  (forall ((t AUTOSAR-DATA-TYPE))
    (=> (and (has_swDataDefProps t)
             (has_content (swDataDefProps t))
             (has_compuMethodRef (content (swDataDefProps t))))
        (let ((m (compuMethodRef (content (swDataDefProps t)))))
          (or (= (category m) "BITFIELD_TEXTTABLE")
              (= (category m) "TEXTTABLE"))))))

;################################################################
; constr_1159 – Consistency of VariableAndParameterInterfaceMapping
;################################################################
; Text:
;   Within one VariableAndParameterInterfaceMapping all firstDataPrototypes
;   shall belong to one and only one DataInterface and all secondDataPrototypes
;   shall belong to one other and only one other DataInterface.

; We model VariableAndParameterInterfaceMapping as a set of DATA-PROTOTYPE-MAPPING
; instances; here we express the "one and only one" per side at the level of
; each mapping set via helper functions dataInterfaceOf_First/Second.

; Axioms tying helper functions to underlying prototype refs are left to the
; environment; here we only state the uniqueness pattern:

; For any two mappings m1, m2 in the same VariableAndParameterInterfaceMapping
; (not explicitly modelled as a Sort here), we expect:
;   dataInterfaceOf_First(m1) = dataInterfaceOf_First(m2)
;   dataInterfaceOf_Second(m1) = dataInterfaceOf_Second(m2)
; and dataInterfaceOf_First(m) ≠ dataInterfaceOf_Second(m).
; Since the container sort is not declared, we document the pattern only.

; End of template (no (check-sat) here).


