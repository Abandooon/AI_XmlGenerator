; Helper predicates for VSA payload and chain roles
(declare-fun is_VSA_Payload (IMPLEMENTATION-DATA-TYPE IMPLEMENTATION-DATA-TYPE-ELEMENT) Bool)
(declare-fun is_firstDimensionElement (IMPLEMENTATION-DATA-TYPE-ELEMENT) Bool)
