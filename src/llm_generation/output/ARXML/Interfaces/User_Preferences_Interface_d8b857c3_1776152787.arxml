<?xml version="1.0" ?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_4-2-2.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>Interfaces</SHORT-NAME>
      <ELEMENTS>
        <PARAMETER-INTERFACE>
          <SHORT-NAME>User_Preferences_Interface</SHORT-NAME>
          <IS-SERVICE>true</IS-SERVICE>
          <PARAMETERS>
            <PARAMETER-DATA-PROTOTYPE>
              <SHORT-NAME>BRIGHTNESS_PRESET</SHORT-NAME>
              <TYPE-TREF DEST="APPLICATION-DATA-TYPE">BRIGHTNESS_PRESET_TYPE</TYPE-TREF>
            </PARAMETER-DATA-PROTOTYPE>
            <PARAMETER-DATA-PROTOTYPE>
              <SHORT-NAME>PREFERRED_MODE</SHORT-NAME>
              <TYPE-TREF DEST="APPLICATION-DATA-TYPE">PREFERRED_MODE_TYPE</TYPE-TREF>
            </PARAMETER-DATA-PROTOTYPE>
          </PARAMETERS>
        </PARAMETER-INTERFACE>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>