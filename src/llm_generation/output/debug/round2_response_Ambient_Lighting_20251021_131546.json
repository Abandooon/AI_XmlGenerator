                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "ARGUMENT-DATA-PROTOTYPE",
                      "#text": "/Components/Ambient_Lighting/DataPrototype/CAN_Lighting_Frame"
