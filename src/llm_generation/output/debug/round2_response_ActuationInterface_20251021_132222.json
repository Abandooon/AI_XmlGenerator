{
  "ECU-ABSTRACTION-SW-COMPONENT-TYPE": {
    "SHORT-NAME": "ActuationInterface",
    "PORTS": {
      "P-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "StatusPubPort",
          "PROVIDED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/System_Status_to_HMI_SR"
          }
        }
      ],
      "PR-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "PlannerServerPort",
          "PROVIDED-REQUIRED-INTERFACE-TREF": {
            "@DEST": "CLIENT-SERVER-INTERFACE",
            "#text": "/Interfaces/Planner_to_Actuation_CS"
          }
        }
      ],
      "R-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "ParameterClientPort",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "CLIENT-SERVER-INTERFACE",
            "#text": "/Interfaces/Parameter_Service_CS"
          }
        }
      ]
    },
    "SWC-INTERNAL-BEHAVIOR": {
      "SHORT-NAME": "ActuationInterface_Behavior",
      "RUNNABLE-ENTITY": [
        {
          "SHORT-NAME": "Actuation_Server_Runnable",
          "MINIMUM-START-INTERVAL": 25,
          "CAN-BE-INVOKED-CONCURRENTLY": "false",
          "DATA-WRITE-ACCESSS": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "Write_ActuationAck",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "P-PORT-PROTOTYPE",
                      "#text": "/Components/ActuationInterface/Ports/StatusPubPort"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "AUTOSAR-DATA-PROTOTYPE",
                      "#text": "/DataPrototypes/ActuationAck"
                    }
                  }
                }
              }
            ]
          },
          "SERVER-CALL-POINTS": [
            {
              "SYNCHRONOUS-SERVER-CALL-POINT": {
                "SHORT-NAME": "Planner_Control_CallPoint",
                "OPERATION-IREF": {
                  "CONTEXT-R-PORT-REF": {
                    "@DEST": "PR-PORT-PROTOTYPE",
                    "#text": "/Components/ActuationInterface/Ports/PlannerServerPort"
                  },
                  "TARGET-REQUIRED-OPERATION-REF": {
                    "@DEST": "CLIENT-SERVER-OPERATION",
                    "#text": "/Interfaces/Planner_to_Actuation_CS/Operations/SendControl"
                  }
                },
                "TIMEOUT": 100
              }
            }
          ],
          "SYMBOL": "ActuationInterface_Actuation_Server_Runnable"
        }
      ],
      "EVENTS": {
        "DATA-SEND-COMPLETED-EVENT": [
          {
            "SHORT-NAME": "CAN_Tx_Completed",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/PathPlanner/PathPlanner_Behavior/Planner_Main_Runnable"
            },
            "EVENT-SOURCE-REF": {
              "@DEST": "VARIABLE-ACCESS",
              "#text": "/Components/ActuationInterface/ActuationInterface_Behavior/Actuation_Server_Runnable/Write_ActuationAck"
            }
          }
        ],
        "OPERATION-INVOKED-EVENT": [
          {
            "SHORT-NAME": "Actuation_Command_Invoked",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/PathPlanner/PathPlanner_Behavior/Planner_Main_Runnable"
            },
            "OPERATION-IREF": {
              "CONTEXT-P-PORT-REF": {
                "@DEST": "PR-PORT-PROTOTYPE",
                "#text": "/Components/ActuationInterface/Ports/PlannerServerPort"
              },
              "TARGET-PROVIDED-OPERATION-REF": {
                "@DEST": "CLIENT-SERVER-OPERATION",
                "#text": "/Interfaces/Planner_to_Actuation_CS/Operations/SendControl"
              }
            }
          }
        ],
        "TRANSFORMER-HARD-ERROR-EVENT": [
          {
            "SHORT-NAME": "Actuation_Fault",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/PathPlanner/PathPlanner_Behavior/Planner_Main_Runnable"
            },
            "OPERATION-IREF": {
              "CONTEXT-P-PORT-REF": {
                "@DEST": "PR-PORT-PROTOTYPE",
                "#text": "/Components/ActuationInterface/Ports/PlannerServerPort"
              },
              "TARGET-PROVIDED-OPERATION-REF": {
                "@DEST": "CLIENT-SERVER-OPERATION",
                "#text": "/Interfaces/Planner_to_Actuation_CS/Operations/ReportFault"
              }
            }
          }
        ]
      }
    }
  }
}