{
  "APPLICATION-SW-COMPONENT-TYPE": {
    "SHORT-NAME": "Ambient_Light_Controller",
    "PORTS": {
      "P-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "P_Port_Status",
          "PROVIDED-INTERFACE-TREF": {
            "@DEST": "CLIENT-SERVER-INTERFACE",
            "#text": "/Interfaces/DOOR_STATUS_INTERFACE"
          }
        },
        {
          "SHORT-NAME": "P_Port_Environment_Data",
          "PROVIDED-INTERFACE-TREF": {
            "@DEST": "NV-DATA-INTERFACE",
            "#text": "/Interfaces/ENVIRONMENT_INTERFACE"
          }
        },
        {
          "SHORT-NAME": "P_Port_Control_Signal",
          "PROVIDED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/User_Preferences_Interface"
          }
        }
      ]
    },
    "SWC-INTERNAL-BEHAVIOR": {
      "SHORT-NAME": "Ambient_Light_Controller_Behavior",
      "SUPPORTS-MULTIPLE-INSTANTIATION": "false",
      "HANDLE-TERMINATION-AND-RESTART": "true",
      "RUNNABLE-ENTITY": [
        {
          "SHORT-NAME": "Ambient_Control_Runnable",
          "MINIMUM-START-INTERVAL": 0,
          "CAN-BE-INVOKED-CONCURRENTLY": "true",
          "DATA-RECEIVE-POINT-BY-VALUES": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "DoorStatus_Read",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "P-PORT-PROTOTYPE",
                      "#text": "/Components/Ambient_Light_Controller/P_Port_Status"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "DATA-PROTOTYPE",
                      "#text": "/Interfaces/ENVIRONMENT_INTERFACE/ENVIRONMENT_DATA"
                    }
                  }
                }
              },
              {
                "SHORT-NAME": "EnvData_Read",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "P-PORT-PROTOTYPE",
                      "#text": "/Components/Ambient_Light_Controller/P_Port_Environment_Data"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "PARAMETER-DATA-PROTOTYPE",
                      "#text": "/Interfaces/User_Preferences_Interface/BRIGHTNESS_PRESET"
                    }
                  }
                }
              }
            ]
          },
          "DATA-SEND-POINTS": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "Control_Signal_Send",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "P-PORT-PROTOTYPE",
                      "#text": "/Components/Ambient_Light_Controller/P_Port_Control_Signal"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "PARAMETER-DATA-PROTOTYPE",
                      "#text": "/Interfaces/User_Preferences_Interface/PREFERRED_MODE"
                    }
                  }
                }
              }
            ]
          },
          "SYMBOL": "Ambient_Control_Symbol"
        }
      ],
      "EVENTS": {
        "INIT-EVENT": [
          {
            "SHORT-NAME": "Init_E",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/Ambient_Light_Controller/Ambient_Control_Runnable"
            }
          }
        ],
        "TIMING-EVENT": [
          {
            "SHORT-NAME": "Sample_Tick",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/Ambient_Light_Controller/Ambient_Control_Runnable"
            },
            "PERIOD": 100
          }
        ]
      }
    }
  }
}