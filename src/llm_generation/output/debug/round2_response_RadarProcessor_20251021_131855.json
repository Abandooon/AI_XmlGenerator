{
  "APPLICATION-SW-COMPONENT-TYPE": {
    "SHORT-NAME": "RadarProcessor",
    "PORTS": {
      "P-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "RadarToFusion",
          "PROVIDED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/Radar_to_Fusion_SR"
          }
        }
      ],
      "R-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "ModeSwitchIn",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "MODE-SWITCH-INTERFACE",
            "#text": "/Interfaces/ADAS_Mode_Switch"
          }
        }
      ]
    },
    "SWC-INTERNAL-BEHAVIOR": {
      "SHORT-NAME": "RadarProcessor_Behavior",
      "RUNNABLE-ENTITY": [
        {
          "SHORT-NAME": "Radar_Processing_Runnable",
          "MINIMUM-START-INTERVAL": 50,
          "CAN-BE-INVOKED-CONCURRENTLY": "false",
          "DATA-RECEIVE-POINT-BY-ARGUMENTS": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "ModeSwitch_Access",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "R-PORT-PROTOTYPE",
                      "#text": "/Components/RadarProcessor/Ports/ModeSwitchIn"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "AUTOSAR-DATA-PROTOTYPE",
                      "#text": "/DataTypes/RequestedMode"
                    }
                  }
                }
              }
            ]
          },
          "DATA-SEND-POINTS": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "ObjectList_Publish",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "P-PORT-PROTOTYPE",
                      "#text": "/Components/RadarProcessor/Ports/RadarToFusion"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "AUTOSAR-DATA-PROTOTYPE",
                      "#text": "/DataTypes/ObjectList"
                    }
                  }
                }
              }
            ]
          },
          "SYMBOL": "RadarProcessor.Radar_Processing_Runnable"
        }
      ],
      "EVENTS": {
        "DATA-RECEIVED-EVENT": [
          {
            "SHORT-NAME": "ModeSwitch_Received",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/RadarProcessor/Runnables/Radar_Processing_Runnable"
            }
          }
        ],
        "TIMING-EVENT": [
          {
            "SHORT-NAME": "Radar_Cycle",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/RadarProcessor/Runnables/Radar_Processing_Runnable"
            },
            "PERIOD": 50
          }
        ],
        "TRANSFORMER-HARD-ERROR-EVENT": [
          {
            "SHORT-NAME": "Radar_Parse_Error",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/RadarProcessor/Runnables/Radar_Processing_Runnable"
            }
          }
        ]
      }
    }
  }
}