                          "MODE-SWITCH-INTERFACE",
                          "NV-DATA-INTERFACE",
                          "PARAMETER-INTERFACE",
                          "PORT-INTERFACE",
                          "SENDER-RECEIVER-INTERFACE",
                          "TRIGGER-INTERFACE"
