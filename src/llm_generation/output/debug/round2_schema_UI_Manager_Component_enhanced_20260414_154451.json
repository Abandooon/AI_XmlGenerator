                              "additionalProperties": false,
                              "x-xml-tag": "ACCESSED-VARIABLE",
                              "required": [
                                "LOCAL-VARIABLE-REF"
                              ]
                            }
                          },
                          "additionalProperties": false,
                          "required": [
                            "SHORT-NAME",
                            "ACCESSED-VARIABLE"
                          ]
                        }
                      }
                    },
                    "required": [
                      "VARIABLE-ACCESS"
                    ]
                  },
                  "DATA-SEND-POINTS": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "VARIABLE-ACCESS": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "SHORT-NAME": {
                              "type": "string",
                              "pattern": "[a-zA-Z][a-zA-Z0-9_]*",
                              "x-xml-tag": "SHORT-NAME"
                            },
                            "ACCESSED-VARIABLE": {
                              "type": "object",
                              "properties": {
                                "LOCAL-VARIABLE-REF": {
                                  "type": "object",
                                  "properties": {
                                    "@DEST": {
                                      "type": "string",
                                      "enum": [
                                        "VARIABLE-DATA-PROTOTYPE"
                                      ]
                                    },
                                    "#text": {
                                      "type": "string",
                                      "enum": [
                                        "/Interfaces/ENVIRONMENT_INTERFACE/ENVIRONMENT_DATA"
                                      ],
                                      "examples": [
                                        "/Interfaces/ENVIRONMENT_INTERFACE/ENVIRONMENT_DATA"
                                      ],
                                      "x-scope": "interface_element",
                                      "x-filter-info": "从1个候选路径过滤到1个"
                                    }
                                  },
                                  "required": [
                                    "#text",
                                    "@DEST"
                                  ],
                                  "x-xml-tag": "LOCAL-VARIABLE-REF",
                                  "additionalProperties": false
                                }
                              },
                              "additionalProperties": false,
                              "x-xml-tag": "ACCESSED-VARIABLE",
                              "required": [
                                "LOCAL-VARIABLE-REF"
                              ]
                            }
                          },
                          "additionalProperties": false,
                          "required": [
                            "SHORT-NAME",
                            "ACCESSED-VARIABLE"
                          ]
                        }
                      }
                    },
                    "required": [
                      "VARIABLE-ACCESS"
                    ]
                  },
                  "SYMBOL": {
                    "type": "string",
                    "pattern": "[a-zA-Z_][a-zA-Z0-9_]*",
