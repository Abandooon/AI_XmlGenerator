{
  "APPLICATION-SW-COMPONENT-TYPE": {
    "SHORT-NAME": "Door_Lock_Controller",
    "PORTS": {
      "P-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "MotorDriver_PPort",
          "PROVIDED-INTERFACE-TREF": {
            "@DEST": "CLIENT-SERVER-INTERFACE",
            "#text": "/Interfaces/UDS_Service_IF"
          }
        },
        {
          "SHORT-NAME": "Status_Publisher_PPort",
          "PROVIDED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/CAN_Command_IF"
          }
        }
      ],
      "R-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "Command_RPort",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/CAN_Command_IF"
          }
        },
        {
          "SHORT-NAME": "Diag_RPort",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "CLIENT-SERVER-INTERFACE",
            "#text": "/Interfaces/UDS_Service_IF"
          }
        }
      ]
    },
    "SWC-INTERNAL-BEHAVIOR": {
      "SHORT-NAME": "Door_Lock_Controller_Behavior",
      "RUNNABLE-ENTITY": [
        {
          "SHORT-NAME": "Lock_Control_Runnable",
          "MINIMUM-START-INTERVAL": 10,
          "CAN-BE-INVOKED-CONCURRENTLY": "false",
          "DATA-RECEIVE-POINT-BY-ARGUMENTS": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "Cmd_Input",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "R-PORT-PROTOTYPE",
                      "#text": "/Components/Door_Lock_Controller/Ports/Command_RPort"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "ARGUMENT-DATA-PROTOTYPE",
                      "#text": "/DataPrototypes/Control_Command"
                    }
                  }
                }
              }
            ]
          },
          "DATA-SEND-POINTS": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "Status_Output",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "P-PORT-PROTOTYPE",
                      "#text": "/Components/Door_Lock_Controller/Ports/Status_Publisher_PPort"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "AUTOSAR-DATA-PROTOTYPE",
                      "#text": "/DataPrototypes/DoorStatus"
                    }
                  }
                }
              }
            ]
          },
          "SERVER-CALL-POINTS": [
            {
              "SYNCHRONOUS-SERVER-CALL-POINT": {
                "SHORT-NAME": "Motor_Driver_Call",
                "OPERATION-IREF": {
                  "CONTEXT-R-PORT-REF": {
                    "@DEST": "R-PORT-PROTOTYPE",
                    "#text": "/Components/Door_Lock_Controller/Ports/Diag_RPort"
                  },
                  "TARGET-REQUIRED-OPERATION-REF": {
                    "@DEST": "CLIENT-SERVER-OPERATION",
                    "#text": "/Operations/MotorCommandService/SetMotorCmd"
                  }
                },
                "TIMEOUT": 50
              }
            }
          ],
          "SYMBOL": "Door_Lock_Controller_Lock_Control_Runnable"
        }
      ],
      "EVENTS": {
        "DATA-RECEIVED-EVENT": [
          {
            "SHORT-NAME": "Cmd_Received_Event",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/CAN_Gateway/CAN_Gateway_Behavior/Decode_Route_Runnable"
            }
          }
        ],
        "INIT-EVENT": [
          {
            "SHORT-NAME": "Init_Event",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/Diagnostic_Manager/Diagnostic_Manager_Behavior/UDS_Request_Handler"
            }
          }
        ],
        "TIMING-EVENT": [
          {
            "SHORT-NAME": "Control_Cycle_Event",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/CAN_Gateway/CAN_Gateway_Behavior/CAN_Rx_Runnable"
            },
            "PERIOD": 10
          }
        ]
      }
    }
  }
}