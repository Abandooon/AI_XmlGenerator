{
  "APPLICATION-SW-COMPONENT-TYPE": {
    "SHORT-NAME": "DataAggregator",
    "PORTS": {
      "P-PORT-PROTOTYPE": [],
      "R-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "R_Voltage_Port",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/Voltage_SR"
          }
        },
        {
          "SHORT-NAME": "R_Current_Port",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/Current_SR"
          }
        },
        {
          "SHORT-NAME": "R_Temp_Port",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/Temp_SR"
          }
        },
        {
          "SHORT-NAME": "R_CAN_Client_Port",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "CLIENT-SERVER-INTERFACE",
            "#text": "/Interfaces/CAN_Send_Service"
          }
        }
      ]
    },
    "SWC-INTERNAL-BEHAVIOR": {
      "SHORT-NAME": "DataAggregatorBehavior",
      "RUNNABLE-ENTITY": [
        {
          "SHORT-NAME": "Aggregation_Runnable",
          "MINIMUM-START-INTERVAL": 200,
          "CAN-BE-INVOKED-CONCURRENTLY": "false",
          "DATA-RECEIVE-POINT-BY-VALUES": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "Voltage_Access",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "R-PORT-PROTOTYPE",
                      "#text": "/Components/DataAggregator/Ports/R_Voltage_Port"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "VARIABLE-DATA-PROTOTYPE",
                      "#text": "/DataPrototypes/Voltage_Volt"
                    }
                  }
                }
              },
              {
                "SHORT-NAME": "Current_Access",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "R-PORT-PROTOTYPE",
                      "#text": "/Components/DataAggregator/Ports/R_Current_Port"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "VARIABLE-DATA-PROTOTYPE",
                      "#text": "/DataPrototypes/Current_Amp"
                    }
                  }
                }
              },
              {
                "SHORT-NAME": "Temp_Access",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "R-PORT-PROTOTYPE",
                      "#text": "/Components/DataAggregator/Ports/R_Temp_Port"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "VARIABLE-DATA-PROTOTYPE",
                      "#text": "/DataPrototypes/Temp_Celsius"
                    }
                  }
                }
              }
            ]
          },
          "DATA-SEND-POINTS": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "BatteryState_Send",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "R-PORT-PROTOTYPE",
                      "#text": "/Components/DataAggregator/Ports/R_CAN_Client_Port"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "AUTOSAR-DATA-PROTOTYPE",
                      "#text": "/DataPrototypes/BatteryState"
                    }
                  }
                }
              }
            ]
          },
          "SERVER-CALL-POINTS": [
            {
              "SYNCHRONOUS-SERVER-CALL-POINT": {
                "SHORT-NAME": "CAN_Send_Call",
                "OPERATION-IREF": {
                  "CONTEXT-R-PORT-REF": {
                    "@DEST": "R-PORT-PROTOTYPE",
                    "#text": "/Components/DataAggregator/Ports/R_CAN_Client_Port"
                  },
                  "TARGET-REQUIRED-OPERATION-REF": {
                    "@DEST": "CLIENT-SERVER-OPERATION",
                    "#text": "/Interfaces/CAN_Send_Service/SendBatteryState"
                  }
                },
                "TIMEOUT": 20
              }
            }
          ],
          "SYMBOL": "DataAggregator_Aggregation_Runnable"
        }
      ],
      "EVENTS": {
        "DATA-RECEIVED-EVENT": [
          {
            "SHORT-NAME": "Voltage_Input_Received",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/VoltageMonitor/VoltageMonitorBehavior/Voltage_Read_Runnable"
            }
          },
          {
            "SHORT-NAME": "Current_Input_Received",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/CurrentMonitor/CurrentMonitorBehavior/Current_Read_Runnable"
            }
          },
          {
            "SHORT-NAME": "Temp_Input_Received",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/TempMonitor/TempMonitorBehavior/Temp_Read_Runnable"
            }
          }
        ],
        "TIMING-EVENT": [
          {
            "SHORT-NAME": "Aggregation_Timer",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/VoltageMonitor/VoltageMonitorBehavior/Voltage_Read_Runnable"
            },
            "PERIOD": 200
          }
        ]
      }
    }
  }
}