{
  "SENSOR-ACTUATOR-SW-COMPONENT-TYPE": {
    "SHORT-NAME": "ActuatorDriver",
    "PORTS": {
      "P-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "Diagnostic_Service_P",
          "PROVIDED-INTERFACE-TREF": {
            "@DEST": "CLIENT-SERVER-INTERFACE",
            "#text": "/Interfaces/Diagnostic_Service"
          }
        }
      ],
      "R-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "Motor_Command_R",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/Motor_Command_Interface"
          }
        }
      ]
    },
    "SWC-INTERNAL-BEHAVIOR": {
      "SHORT-NAME": "ActuatorDriverBehavior",
      "RUNNABLE-ENTITY": [
        {
          "SHORT-NAME": "Apply_PWM",
          "MINIMUM-START-INTERVAL": 0.001,
          "CAN-BE-INVOKED-CONCURRENTLY": "false",
          "DATA-RECEIVE-POINT-BY-ARGUMENTS": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "MotorCommandAccess",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "R-PORT-PROTOTYPE",
                      "#text": "/Components/ActuatorDriver/Ports/Motor_Command_R"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "ARGUMENT-DATA-PROTOTYPE",
                      "#text": "/Components/ActuatorDriver/Ports/Motor_Command_R/MotorCommandData"
                    }
                  }
                }
              }
            ]
          },
          "SERVER-CALL-POINTS": [],
          "SYMBOL": "ActuatorDriver_Apply_PWM"
        },
        {
          "SHORT-NAME": "Diagnostics_Server",
          "MINIMUM-START-INTERVAL": 0.01,
          "CAN-BE-INVOKED-CONCURRENTLY": "false",
          "DATA-RECEIVE-POINT-BY-ARGUMENTS": {
            "VARIABLE-ACCESS": []
          },
          "SERVER-CALL-POINTS": [
            {
              "SYNCHRONOUS-SERVER-CALL-POINT": {
                "SHORT-NAME": "DiagnosticsCallPoint",
                "CALLED-FROM-WITHIN-EXCLUSIVE-AREA-REF": {
                  "@DEST": "EXCLUSIVE-AREA-NESTING-ORDER",
                  "#text": "/ExclusiveAreas/ActuatorDriverEA"
                },
                "OPERATION-IREF": {
                  "CONTEXT-R-PORT-REF": {
                    "@DEST": "R-PORT-PROTOTYPE",
                    "#text": "/Components/ControlLogic/Ports/Diagnostic_Client_R"
                  },
                  "TARGET-REQUIRED-OPERATION-REF": {
                    "@DEST": "CLIENT-SERVER-OPERATION",
                    "#text": "/Interfaces/Diagnostic_Service/get_status"
                  }
                },
                "TIMEOUT": 50
              }
            }
          ],
          "SYMBOL": "ActuatorDriver_Diagnostics_Server"
        }
      ],
      "EVENTS": {
        "DATA-RECEIVED-EVENT": [
          {
            "SHORT-NAME": "Cmd_Received",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/CANReceiver/CANReceiverBehavior/Can_Rx_Read"
            }
          }
        ],
        "TIMING-EVENT": [
          {
            "SHORT-NAME": "PWM_Update_1ms",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/CANReceiver/CANReceiverBehavior/Can_Rx_Read"
            },
            "PERIOD": 0.001
          }
        ]
      }
    }
  }
}