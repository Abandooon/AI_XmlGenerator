{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "NV-BLOCK-SW-COMPONENT-TYPE": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "SHORT-NAME": {
          "type": "string",
          "examples": [
            "HMI_Manager"
          ],
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$",
          "description": "Identifier must start with a letter, and can only contain letters, numbers, and underscores (_). Hyphens (-) are not allowed."
        },
        "PORTS": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "R-PORT-PROTOTYPE": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "SHORT-NAME": {
                    "type": "string",
                    "pattern": "[a-zA-Z][a-zA-Z0-9_]*",
                    "x-xml-tag": "SHORT-NAME"
                  },
                  "REQUIRED-INTERFACE-TREF": {
                    "type": "object",
                    "properties": {
                      "@DEST": {
                        "type": "string",
                        "enum": [
                          "CLIENT-SERVER-INTERFACE",
                          "DATA-INTERFACE",
                          "MODE-SWITCH-INTERFACE",
                          "NV-DATA-INTERFACE",
                          "PARAMETER-INTERFACE",
                          "PORT-INTERFACE",
                          "SENDER-RECEIVER-INTERFACE",
                          "TRIGGER-INTERFACE"
                        ]
                      },
                      "#text": {
                        "type": "string",
                        "enum": [
                          "/Interfaces/Actuation_Command_Interface",
                          "/Interfaces/Camera_Data_Interface",
                          "/Interfaces/Fusion_Data_Interface",
                          "/Interfaces/HMI_Status_Interface",
                          "/Interfaces/Radar_Data_Interface"
                        ],
                        "examples": [
                          "/Interfaces/Radar_Data_Interface"
                        ],
                        "x-scope": "global_type",
                        "x-filter-info": "从5个候选路径过滤到5个"
                      }
                    },
                    "required": [
                      "#text",
                      "@DEST"
                    ],
                    "x-xml-tag": "REQUIRED-INTERFACE-TREF",
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false,
                "required": [
                  "SHORT-NAME",
                  "REQUIRED-INTERFACE-TREF"
                ]
              },
              "x-xml-tag": "R-PORT-PROTOTYPE"
            }
          },
          "x-xml-tag": "PORTS",
          "required": [
            "R-PORT-PROTOTYPE"
          ]
        }
      },
      "required": [
        "PORTS",
        "SHORT-NAME"
      ]
    }
  },
  "required": [
    "NV-BLOCK-SW-COMPONENT-TYPE"
  ]
}