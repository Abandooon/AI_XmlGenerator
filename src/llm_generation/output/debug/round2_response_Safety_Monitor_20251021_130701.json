{
  "SERVICE-SW-COMPONENT-TYPE": {
    "SHORT-NAME": "Safety_Monitor",
    "PORTS": {
      "P-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "SafetyStatus_P",
          "PROVIDED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/Safety_Status"
          }
        },
        {
          "SHORT-NAME": "Gateway_Command_P",
          "PROVIDED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/CAN_Gateway_Interface"
          }
        }
      ],
      "R-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "WheelSpeed_R",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/CanBus_WheelSpeed"
          }
        },
        {
          "SHORT-NAME": "Gateway_HB_R",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/CAN_Gateway_Interface"
          }
        },
        {
          "SHORT-NAME": "BrakeActuator_Client_R",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "CLIENT-SERVER-INTERFACE",
            "#text": "/Interfaces/BrakeActuator_Service"
          }
        }
      ]
    },
    "SWC-INTERNAL-BEHAVIOR": {
      "SHORT-NAME": "Safety_Monitor_Behavior",
      "RUNNABLE-ENTITY": [
        {
          "SHORT-NAME": "Safety_Check_Runnable",
          "MINIMUM-START-INTERVAL": 1,
          "CAN-BE-INVOKED-CONCURRENTLY": "false",
          "DATA-RECEIVE-POINT-BY-ARGUMENTS": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "WheelSpeed_FL_Access",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "R-PORT-PROTOTYPE",
                      "#text": "/Components/Safety_Monitor/Ports/WheelSpeed_R"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "DATA-PROTOTYPE",
                      "#text": "/DataElements/WheelSpeed_FL"
                    }
                  }
                }
              },
              {
                "SHORT-NAME": "WheelSpeed_FR_Access",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "R-PORT-PROTOTYPE",
                      "#text": "/Components/Safety_Monitor/Ports/WheelSpeed_R"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "DATA-PROTOTYPE",
                      "#text": "/DataElements/WheelSpeed_FR"
                    }
                  }
                }
              },
              {
                "SHORT-NAME": "WheelSpeed_RL_Access",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "R-PORT-PROTOTYPE",
                      "#text": "/Components/Safety_Monitor/Ports/WheelSpeed_R"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "DATA-PROTOTYPE",
                      "#text": "/DataElements/WheelSpeed_RL"
                    }
                  }
                }
              },
              {
                "SHORT-NAME": "WheelSpeed_RR_Access",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "R-PORT-PROTOTYPE",
                      "#text": "/Components/Safety_Monitor/Ports/WheelSpeed_R"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "DATA-PROTOTYPE",
                      "#text": "/DataElements/WheelSpeed_RR"
                    }
                  }
                }
              },
              {
                "SHORT-NAME": "Controller_Heartbeat_Access",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "R-PORT-PROTOTYPE",
                      "#text": "/Components/Safety_Monitor/Ports/Gateway_HB_R"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "DATA-PROTOTYPE",
                      "#text": "/DataElements/Controller_Heartbeat"
                    }
                  }
                }
              }
            ]
          },
          "SERVER-CALL-POINTS": [
            {
              "ASYNCHRONOUS-SERVER-CALL-POINT": {
                "SHORT-NAME": "Reset_Service_Call",
                "OPERATION-IREF": {
                  "CONTEXT-R-PORT-REF": {
                    "@DEST": "R-PORT-PROTOTYPE",
                    "#text": "/Components/Safety_Monitor/Ports/BrakeActuator_Client_R"
                  },
                  "TARGET-REQUIRED-OPERATION-REF": {
                    "@DEST": "CLIENT-SERVER-OPERATION",
                    "#text": "/Interfaces/BrakeActuator_Service/ResetOperation"
                  }
                },
                "TIMEOUT": 10
              }
            }
          ],
          "SYMBOL": "Safety_Check_Runnable_Symbol"
        }
      ],
      "EVENTS": {
        "DATA-RECEIVED-EVENT": [
          {
            "SHORT-NAME": "Safety_Input_Update",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/Wheel_Speed_Processor/Wheel_Speed_Processor_Behavior/Process_WheelSpeeds"
            }
          }
        ],
        "SWC-MODE-SWITCH-EVENT": [
          {
            "SHORT-NAME": "Safety_Mode_Switch",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/ESP_Controller/ESP_Controller_Behavior/ESP_Control_Runnable"
            },
            "ACTIVATION": "ON",
            "MODE-IREFS": {
              "MODE-IREF": [
                {
                  "CONTEXT-MODE-DECLARATION-GROUP-PROTOTYPE-REF": {
                    "@DEST": "MODE-DECLARATION-GROUP-PROTOTYPE",
                    "#text": "/Modes/SafetyModeGroup"
                  },
                  "CONTEXT-PORT-REF": {
                    "@DEST": "R-PORT-PROTOTYPE",
                    "#text": "/Components/Safety_Monitor/Ports/Gateway_HB_R"
                  },
                  "TARGET-MODE-DECLARATION-REF": {
                    "@DEST": "MODE-DECLARATION",
                    "#text": "/Modes/SafetyMode"
                  }
                }
              ]
            }
          }
        ],
        "TIMING-EVENT": [
          {
            "SHORT-NAME": "Safety_Watchdog_1ms",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/ABS_Controller/ABS_Controller_Behavior/ABS_Control_Runnable"
            },
            "PERIOD": 1
          }
        ]
      }
    }
  }
}