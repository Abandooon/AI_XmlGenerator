{
  "COMPLEX-DEVICE-DRIVER-SW-COMPONENT-TYPE": {
    "SHORT-NAME": "CAN_Sender",
    "PORTS": {
      "R-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "ProcessedData_RPort",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/ProcessedData_SR_Interface"
          }
        },
        {
          "SHORT-NAME": "CanIf_RPort",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "CLIENT-SERVER-INTERFACE",
            "#text": "/Interfaces/CanIf_Transmit_Interface"
          }
        }
      ]
    },
    "SWC-INTERNAL-BEHAVIOR": {
      "SHORT-NAME": "CAN_Sender_Behavior",
      "RUNNABLE-ENTITY": [
        {
          "SHORT-NAME": "Send_CAN_Runnable",
          "MINIMUM-START-INTERVAL": 100,
          "CAN-BE-INVOKED-CONCURRENTLY": "false",
          "DATA-RECEIVE-POINT-BY-ARGUMENTS": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "ProcessedData_Access",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "P-PORT-PROTOTYPE",
                      "#text": "/Components/Data_Processor/Ports/ProcessedData_PPort"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "AUTOSAR-DATA-PROTOTYPE",
                      "#text": "/DataPrototypes/ProcessedData"
                    }
                  }
                }
              }
            ]
          },
          "SERVER-CALL-POINTS": [
            {
              "SYNCHRONOUS-SERVER-CALL-POINT": {
                "SHORT-NAME": "CanIf_Transmit_Call",
                "OPERATION-IREF": {
                  "CONTEXT-R-PORT-REF": {
                    "@DEST": "R-PORT-PROTOTYPE",
                    "#text": "/Components/CAN_Sender/Ports/CanIf_RPort"
                  },
                  "TARGET-REQUIRED-OPERATION-REF": {
                    "@DEST": "CLIENT-SERVER-OPERATION",
                    "#text": "/Interfaces/CanIf_Transmit_Interface/Operations/Transmit"
                  }
                },
                "TIMEOUT": 50
              }
            }
          ],
          "SYMBOL": "Send_CAN_Runnable_Symbol"
        }
      ],
      "EVENTS": {
        "DATA-RECEIVED-EVENT": [
          {
            "SHORT-NAME": "ProcessedData_Received_Event",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/Data_Processor/Data_Processor_Behavior/Process_Data_Runnable"
            }
          }
        ]
      }
    }
  }
}