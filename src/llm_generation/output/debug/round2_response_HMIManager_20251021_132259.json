{
  "SERVICE-SW-COMPONENT-TYPE": {
    "SHORT-NAME": "HMIManager",
    "PORTS": {
      "P-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "PPort_ModeSwitch",
          "PROVIDED-INTERFACE-TREF": {
            "@DEST": "MODE-SWITCH-INTERFACE",
            "#text": "/Interfaces/ADAS_Mode_Switch"
          }
        }
      ],
      "R-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "RPort_SystemStatus",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/System_Status_to_HMI_SR"
          }
        }
      ]
    },
    "SWC-INTERNAL-BEHAVIOR": {
      "SHORT-NAME": "HMIManager_Behavior",
      "RUNNABLE-ENTITY": [
        {
          "SHORT-NAME": "HMI_Display_Runnable",
          "MINIMUM-START-INTERVAL": 100,
          "CAN-BE-INVOKED-CONCURRENTLY": "false",
          "DATA-RECEIVE-POINT-BY-VALUES": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "ADAS_Status_Access",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "R-PORT-PROTOTYPE",
                      "#text": "/Components/HMIManager/Ports/RPort_SystemStatus"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "AUTOSAR-DATA-PROTOTYPE",
                      "#text": "/DataTypes/ADAS_Status"
                    }
                  }
                }
              }
            ]
          },
          "DATA-SEND-POINTS": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "ModeSwitch_Send",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "P-PORT-PROTOTYPE",
                      "#text": "/Components/HMIManager/Ports/PPort_ModeSwitch"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "ARGUMENT-DATA-PROTOTYPE",
                      "#text": "/DataTypes/RequestedMode"
                    }
                  }
                }
              }
            ]
          },
          "SYMBOL": "HMIManager_HMI_Display_Runnable"
        }
      ],
      "EVENTS": {
        "EXTERNAL-TRIGGER-OCCURRED-EVENT": [
          {
            "SHORT-NAME": "Driver_Input",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/CameraProcessor/CameraProcessor_Behavior/Camera_Inference_Runnable"
            }
          }
        ],
        "OPERATION-INVOKED-EVENT": [
          {
            "SHORT-NAME": "Mode_Switch_Invoked",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/PathPlanner/PathPlanner_Behavior/Planner_Main_Runnable"
            }
          }
        ],
        "TIMING-EVENT": [
          {
            "SHORT-NAME": "HMI_Update",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/PathPlanner/PathPlanner_Behavior/Planner_Main_Runnable"
            },
            "PERIOD": 100
          }
        ]
      }
    }
  }
}