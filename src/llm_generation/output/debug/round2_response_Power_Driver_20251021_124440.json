{
  "COMPLEX-DEVICE-DRIVER-SW-COMPONENT-TYPE": {
    "SHORT-NAME": "Power_Driver",
    "PORTS": {
      "P-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "Status_Port",
          "PROVIDED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/CAN_Message_Interface"
          }
        }
      ],
      "R-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "HeatCmd_Server_Port",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "CLIENT-SERVER-INTERFACE",
            "#text": "/Interfaces/HeatCmd_ClientServer"
          }
        }
      ]
    },
    "SWC-INTERNAL-BEHAVIOR": {
      "SHORT-NAME": "Power_Driver_Behavior",
      "RUNNABLE-ENTITY": [
        {
          "SHORT-NAME": "Apply_Power_Runnable",
          "MINIMUM-START-INTERVAL": 20,
          "CAN-BE-INVOKED-CONCURRENTLY": "false",
          "DATA-SEND-POINTS": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "Status_Var_Access",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "P-PORT-PROTOTYPE",
                      "#text": "/Components/Power_Driver/Ports/Status_Port"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "AUTOSAR-DATA-PROTOTYPE",
                      "#text": "/DataTypes/PowerDriverStatus"
                    }
                  }
                }
              }
            ]
          },
          "SERVER-CALL-POINTS": [
            {
              "SYNCHRONOUS-SERVER-CALL-POINT": {
                "SHORT-NAME": "HeatCmd_ServerCall",
                "OPERATION-IREF": {
                  "CONTEXT-R-PORT-REF": {
                    "@DEST": "R-PORT-PROTOTYPE",
                    "#text": "/Components/Power_Driver/Ports/HeatCmd_Server_Port"
                  },
                  "TARGET-REQUIRED-OPERATION-REF": {
                    "@DEST": "CLIENT-SERVER-OPERATION",
                    "#text": "/Interfaces/HeatCmd_ClientServer/setLevel"
                  }
                },
                "TIMEOUT": 50
              }
            }
          ],
          "SYMBOL": "Power_Driver::Apply_Power_Runnable"
        }
      ],
      "EVENTS": {
        "DATA-WRITE-COMPLETED-EVENT": [
          {
            "SHORT-NAME": "HW_Drive_Completed",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/Temperature_Sensor/Temperature_Sensor_Behavior/Read_Sensors_Runnable"
            },
            "EVENT-SOURCE-REF": {
              "@DEST": "VARIABLE-ACCESS",
              "#text": "/Components/Power_Driver/Ports/Status_Port/Status_Var_Access"
            }
          }
        ],
        "OPERATION-INVOKED-EVENT": [
          {
            "SHORT-NAME": "Power_Command_Invoked",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/Temperature_Sensor/Temperature_Sensor_Behavior/Read_Sensors_Runnable"
            },
            "OPERATION-IREF": {
              "CONTEXT-P-PORT-REF": {
                "@DEST": "P-PORT-PROTOTYPE",
                "#text": "/Components/Power_Driver/Ports/Status_Port"
              },
              "TARGET-PROVIDED-OPERATION-REF": {
                "@DEST": "CLIENT-SERVER-OPERATION",
                "#text": "/Interfaces/HeatCmd_ClientServer/setLevel"
              }
            }
          }
        ],
        "TRANSFORMER-HARD-ERROR-EVENT": [
          {
            "SHORT-NAME": "Driver_Hardware_Fault",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/Temperature_Sensor/Temperature_Sensor_Behavior/Read_Sensors_Runnable"
            },
            "OPERATION-IREF": {
              "CONTEXT-P-PORT-REF": {
                "@DEST": "P-PORT-PROTOTYPE",
                "#text": "/Components/Power_Driver/Ports/Status_Port"
              },
              "TARGET-PROVIDED-OPERATION-REF": {
                "@DEST": "CLIENT-SERVER-OPERATION",
                "#text": "/Interfaces/HeatCmd_ClientServer/reportFault"
              }
            }
          }
        ]
      }
    }
  }
}