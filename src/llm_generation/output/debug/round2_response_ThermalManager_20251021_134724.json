{
  "APPLICATION-SW-COMPONENT-TYPE": {
    "SHORT-NAME": "ThermalManager",
    "PORTS": {
      "P-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "ThermalStatus_PPort",
          "PROVIDED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/Thermal_Status_Interface"
          }
        },
        {
          "SHORT-NAME": "SafetyEvents_PPort",
          "PROVIDED-INTERFACE-TREF": {
            "@DEST": "TRIGGER-INTERFACE",
            "#text": "/Interfaces/Safety_Events_Interface"
          }
        }
      ],
      "R-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "SOC_SOH_RPort",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/SOC_SOH_Interface"
          }
        },
        {
          "SHORT-NAME": "ModeConfig_RPort",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "CLIENT-SERVER-INTERFACE",
            "#text": "/Interfaces/Charge_Control_Interface"
          }
        }
      ]
    },
    "SWC-INTERNAL-BEHAVIOR": {
      "SHORT-NAME": "ThermalManager_Behavior",
      "RUNNABLE-ENTITY": [
        {
          "SHORT-NAME": "ThermalMonitor_Runnable",
          "MINIMUM-START-INTERVAL": 100,
          "CAN-BE-INVOKED-CONCURRENTLY": "false",
          "DATA-RECEIVE-POINT-BY-VALUES": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "SOC_Access",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "R-PORT-PROTOTYPE",
                      "#text": "/Components/ThermalManager/Ports/SOC_SOH_RPort"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "VARIABLE-DATA-PROTOTYPE",
                      "#text": "/DataPrototypes/SOC"
                    }
                  }
                }
              },
              {
                "SHORT-NAME": "ModeConfig_Access",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "R-PORT-PROTOTYPE",
                      "#text": "/Components/ThermalManager/Ports/ModeConfig_RPort"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "VARIABLE-DATA-PROTOTYPE",
                      "#text": "/DataPrototypes/ChargeControlCmd"
                    }
                  }
                }
              }
            ]
          },
          "SERVER-CALL-POINTS": [
            {
              "SYNCHRONOUS-SERVER-CALL-POINT": {
                "SHORT-NAME": "PumpControl_CallPoint",
                "OPERATION-IREF": {
                  "CONTEXT-R-PORT-REF": {
                    "@DEST": "R-PORT-PROTOTYPE",
                    "#text": "/Components/ThermalManager/Ports/ModeConfig_RPort"
                  },
                  "TARGET-REQUIRED-OPERATION-REF": {
                    "@DEST": "CLIENT-SERVER-OPERATION",
                    "#text": "/Interfaces/Charge_Control_Interface/Operations/SetCooling"
                  }
                },
                "TIMEOUT": 200
              }
            }
          ],
          "SYMBOL": "ThermalManager_ThermalMonitor_Runnable"
        }
      ],
      "EVENTS": {
        "INTERNAL-TRIGGER-OCCURRED-EVENT": [
          {
            "SHORT-NAME": "Overtemp_Triggered_Event",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/CellMonitor/CellMonitor_Behavior/CellFaultDetect_Runnable"
            },
            "EVENT-SOURCE-REF": {
              "@DEST": "INTERNAL-TRIGGERING-POINT",
              "#text": "/Components/ThermalManager/InternalTrigger/Overtemp"
            }
          }
        ],
        "TIMING-EVENT": [
          {
            "SHORT-NAME": "Thermal_Sample_Event",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/CellMonitor/CellMonitor_Behavior/MeasureCells_Runnable"
            },
            "PERIOD": 100
          }
        ]
      }
    }
  }
}