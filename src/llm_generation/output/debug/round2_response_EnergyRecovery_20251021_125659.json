{
  "APPLICATION-SW-COMPONENT-TYPE": {
    "SHORT-NAME": "EnergyRecovery",
    "PORTS": {
      "P-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "PPort_RecoveryCapability",
          "PROVIDED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/RecoveryCapability_Interface"
          }
        },
        {
          "SHORT-NAME": "PPort_PowertrainCAN",
          "PROVIDED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/PowertrainCAN_Interface"
          }
        }
      ],
      "R-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "RPort_TorqueRequest",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/TorqueRequest_Interface"
          }
        },
        {
          "SHORT-NAME": "RPort_PowertrainCAN",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/PowertrainCAN_Interface"
          }
        },
        {
          "SHORT-NAME": "RPort_Diagnostic",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "CLIENT-SERVER-INTERFACE",
            "#text": "/Interfaces/DiagnosticUDS_Interface"
          }
        }
      ]
    },
    "SWC-INTERNAL-BEHAVIOR": {
      "SHORT-NAME": "EnergyRecoveryBehavior",
      "RUNNABLE-ENTITY": [
        {
          "SHORT-NAME": "Recovery_Evaluation_Runnable",
          "MINIMUM-START-INTERVAL": 50,
          "CAN-BE-INVOKED-CONCURRENTLY": "false",
          "DATA-RECEIVE-POINT-BY-ARGUMENTS": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "BrakeRequest_Access",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "R-PORT-PROTOTYPE",
                      "#text": "/Components/EnergyRecovery/Ports/RPort_PowertrainCAN"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "AUTOSAR-DATA-PROTOTYPE",
                      "#text": "/DataElements/BrakeRequest"
                    }
                  }
                }
              },
              {
                "SHORT-NAME": "VehicleSpeed_Access",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "R-PORT-PROTOTYPE",
                      "#text": "/Components/EnergyRecovery/Ports/RPort_PowertrainCAN"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "AUTOSAR-DATA-PROTOTYPE",
                      "#text": "/DataElements/VehicleSpeed"
                    }
                  }
                }
              },
              {
                "SHORT-NAME": "TorqueRequest_Access",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "R-PORT-PROTOTYPE",
                      "#text": "/Components/EnergyRecovery/Ports/RPort_TorqueRequest"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "AUTOSAR-DATA-PROTOTYPE",
                      "#text": "/DataElements/TorqueRequest"
                    }
                  }
                }
              }
            ]
          },
          "DATA-SEND-POINTS": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "RecoveryCapability_Access",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "P-PORT-PROTOTYPE",
                      "#text": "/Components/EnergyRecovery/Ports/PPort_RecoveryCapability"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "AUTOSAR-DATA-PROTOTYPE",
                      "#text": "/DataElements/RecoveryTorqueCapability"
                    }
                  }
                }
              },
              {
                "SHORT-NAME": "RecoveryStatus_Access",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "P-PORT-PROTOTYPE",
                      "#text": "/Components/EnergyRecovery/Ports/PPort_RecoveryCapability"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "AUTOSAR-DATA-PROTOTYPE",
                      "#text": "/DataElements/RecoveryStatus"
                    }
                  }
                }
              },
              {
                "SHORT-NAME": "CAN_Frame_Out",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "P-PORT-PROTOTYPE",
                      "#text": "/Components/EnergyRecovery/Ports/PPort_PowertrainCAN"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "AUTOSAR-DATA-PROTOTYPE",
                      "#text": "/DataElements/CAN_Frame"
                    }
                  }
                }
              }
            ]
          },
          "SERVER-CALL-POINTS": [
            {
              "ASYNCHRONOUS-SERVER-CALL-POINT": {
                "SHORT-NAME": "PowerElectronics_Notify",
                "OPERATION-IREF": {
                  "CONTEXT-R-PORT-REF": {
                    "@DEST": "R-PORT-PROTOTYPE",
                    "#text": "/Components/EnergyRecovery/Ports/RPort_PowertrainCAN"
                  },
                  "TARGET-REQUIRED-OPERATION-REF": {
                    "@DEST": "CLIENT-SERVER-OPERATION",
                    "#text": "/Interfaces/ShiftRequest_Interface/Operations/ExecuteRecovery"
                  }
                },
                "TIMEOUT": 100
              }
            }
          ],
          "SYMBOL": "EnergyRecovery_Recovery_Evaluation_Runnable"
        }
      ],
      "EVENTS": {
        "EXTERNAL-TRIGGER-OCCURRED-EVENT": [
          {
            "SHORT-NAME": "Brake_Press_Event",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/CANRouter/CANRouterBehavior/Routing_Process_Runnable"
            }
          }
        ],
        "TIMING-EVENT": [
          {
            "SHORT-NAME": "Recovery_Eval_Tick",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/CANRouter/CANRouterBehavior/Routing_Process_Runnable"
            },
            "PERIOD": 50
          }
        ]
      }
    }
  }
}