{
  "APPLICATION-SW-COMPONENT-TYPE": {
    "SHORT-NAME": "Balancer",
    "PORTS": {
      "P-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "BalancerControl_P",
          "PROVIDED-INTERFACE-TREF": {
            "@DEST": "CLIENT-SERVER-INTERFACE",
            "#text": "/Interfaces/Balancer_Control_Interface"
          }
        },
        {
          "SHORT-NAME": "BalancerStatus_P",
          "PROVIDED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/CAN_BMS_Status"
          }
        }
      ],
      "R-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "CellVoltages_R",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/Cell_Voltages_Interface"
          }
        },
        {
          "SHORT-NAME": "SOCSOH_R",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/SOC_SOH_Interface"
          }
        },
        {
          "SHORT-NAME": "SafetyEvents_R",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "TRIGGER-INTERFACE",
            "#text": "/Interfaces/Safety_Events_Interface"
          }
        },
        {
          "SHORT-NAME": "Driver_R",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "CLIENT-SERVER-INTERFACE",
            "#text": "/Interfaces/Balancer_Control_Interface"
          }
        }
      ]
    },
    "SWC-INTERNAL-BEHAVIOR": {
      "SHORT-NAME": "Balancer_Behavior",
      "RUNNABLE-ENTITY": [
        {
          "SHORT-NAME": "BalanceDecision_Runnable",
          "MINIMUM-START-INTERVAL": 1000,
          "CAN-BE-INVOKED-CONCURRENTLY": "false",
          "DATA-RECEIVE-POINT-BY-VALUES": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "va_CellVoltages",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "R-PORT-PROTOTYPE",
                      "#text": "/Components/Balancer/Ports/CellVoltages_R"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "VARIABLE-DATA-PROTOTYPE",
                      "#text": "/DataTypes/Cell_Voltages"
                    }
                  }
                }
              },
              {
                "SHORT-NAME": "va_SOC",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "R-PORT-PROTOTYPE",
                      "#text": "/Components/Balancer/Ports/SOCSOH_R"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "VARIABLE-DATA-PROTOTYPE",
                      "#text": "/DataTypes/SOC"
                    }
                  }
                }
              }
            ]
          },
          "DATA-SEND-POINTS": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "va_BalancerStatus",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "P-PORT-PROTOTYPE",
                      "#text": "/Components/Balancer/Ports/BalancerStatus_P"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "VARIABLE-DATA-PROTOTYPE",
                      "#text": "/DataTypes/BalancerStatus"
                    }
                  }
                }
              }
            ]
          },
          "SERVER-CALL-POINTS": [
            {
              "ASYNCHRONOUS-SERVER-CALL-POINT": {
                "SHORT-NAME": "ascp_ApplyBalance",
                "OPERATION-IREF": {
                  "CONTEXT-R-PORT-REF": {
                    "@DEST": "R-PORT-PROTOTYPE",
                    "#text": "/Components/Balancer/Ports/Driver_R"
                  },
                  "TARGET-REQUIRED-OPERATION-REF": {
                    "@DEST": "CLIENT-SERVER-OPERATION",
                    "#text": "/Operations/ApplyBalance"
                  }
                },
                "TIMEOUT": 1000
              }
            }
          ],
          "SYMBOL": "BalanceDecision"
        }
      ],
      "EVENTS": {
        "BACKGROUND-EVENT": [
          {
            "SHORT-NAME": "Balancer_Background_Event",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/SOCEstimator/SOCEstimator_Behavior/Estimate_Runnable"
            }
          }
        ],
        "EXTERNAL-TRIGGER-OCCURRED-EVENT": [
          {
            "SHORT-NAME": "Immediate_Balance_Event",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/SafetyManager/SafetyManager_Behavior/SafetyService_Runnable"
            }
          }
        ]
      }
    }
  }
}