{
  "APPLICATION-SW-COMPONENT-TYPE": {
    "SHORT-NAME": "EngineController",
    "PORTS": {
      "P-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "P_EngineStatus_Port",
          "PROVIDED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/EngineStatus_Interface"
          }
        },
        {
          "SHORT-NAME": "P_PowertrainCAN_Port",
          "PROVIDED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/PowertrainCAN_Interface"
          }
        }
      ],
      "R-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "R_TorqueRequest_Port",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/TorqueRequest_Interface"
          }
        },
        {
          "SHORT-NAME": "R_DiagnosticUDS_Port",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "CLIENT-SERVER-INTERFACE",
            "#text": "/Interfaces/DiagnosticUDS_Interface"
          }
        },
        {
          "SHORT-NAME": "R_PowertrainCAN_Port",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/PowertrainCAN_Interface"
          }
        }
      ]
    },
    "SWC-INTERNAL-BEHAVIOR": {
      "SHORT-NAME": "EngineControllerBehavior",
      "RUNNABLE-ENTITY": [
        {
          "SHORT-NAME": "Engine_Control_Runnable",
          "MINIMUM-START-INTERVAL": 20,
          "CAN-BE-INVOKED-CONCURRENTLY": "false",
          "DATA-RECEIVE-POINT-BY-ARGUMENTS": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "Receive_TorqueRequest",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "R-PORT-PROTOTYPE",
                      "#text": "/Components/EngineController/Ports/R_TorqueRequest_Port"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "ARGUMENT-DATA-PROTOTYPE",
                      "#text": "/DataPrototypes/TorqueRequest"
                    }
                  }
                }
              },
              {
                "SHORT-NAME": "Receive_CAN_Frame",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "R-PORT-PROTOTYPE",
                      "#text": "/Components/EngineController/Ports/R_PowertrainCAN_Port"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "AUTOSAR-DATA-PROTOTYPE",
                      "#text": "/DataPrototypes/CAN_Frame"
                    }
                  }
                }
              }
            ]
          },
          "DATA-SEND-POINTS": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "Send_EngineStatus",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "P-PORT-PROTOTYPE",
                      "#text": "/Components/EngineController/Ports/P_EngineStatus_Port"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "AUTOSAR-DATA-PROTOTYPE",
                      "#text": "/DataPrototypes/EngineStatus"
                    }
                  }
                }
              },
              {
                "SHORT-NAME": "Send_CAN_Frame",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "P-PORT-PROTOTYPE",
                      "#text": "/Components/EngineController/Ports/P_PowertrainCAN_Port"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "AUTOSAR-DATA-PROTOTYPE",
                      "#text": "/DataPrototypes/CAN_Frame"
                    }
                  }
                }
              }
            ]
          },
          "SERVER-CALL-POINTS": [
            {
              "SYNCHRONOUS-SERVER-CALL-POINT": {
                "SHORT-NAME": "HW_Driver_Call",
                "CALLED-FROM-WITHIN-EXCLUSIVE-AREA-REF": {
                  "@DEST": "EXCLUSIVE-AREA-NESTING-ORDER",
                  "#text": "/ExclusiveAreas/EngineControlEA"
                },
                "OPERATION-IREF": {
                  "CONTEXT-R-PORT-REF": {
                    "@DEST": "R-PORT-PROTOTYPE",
                    "#text": "/Components/EngineController/Ports/R_PowertrainCAN_Port"
                  },
                  "TARGET-REQUIRED-OPERATION-REF": {
                    "@DEST": "CLIENT-SERVER-OPERATION",
                    "#text": "/Operations/HWDriver/InjectFuelOperation"
                  }
                },
                "TIMEOUT": 5
              }
            }
          ],
          "SYMBOL": "EngineController::Engine_Control_Runnable"
        }
      ],
      "EVENTS": {
        "EXTERNAL-TRIGGER-OCCURRED-EVENT": [
          {
            "SHORT-NAME": "TorqueRequest_Event",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/CANRouter/CANRouterBehavior/Routing_Process_Runnable"
            }
          }
        ],
        "SWC-MODE-SWITCH-EVENT": [
          {
            "SHORT-NAME": "Engine_Mode_Switch",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/CANRouter/CANRouterBehavior/Routing_Process_Runnable"
            },
            "ACTIVATION": "activate",
            "MODE-IREFS": {
              "MODE-IREF": [
                {
                  "CONTEXT-MODE-DECLARATION-GROUP-PROTOTYPE-REF": {
                    "@DEST": "MODE-DECLARATION-GROUP-PROTOTYPE",
                    "#text": "/ModeGroups/EngineModeGroup"
                  },
                  "CONTEXT-PORT-REF": {
                    "@DEST": "R-PORT-PROTOTYPE",
                    "#text": "/Components/EngineController/Ports/R_TorqueRequest_Port"
                  },
                  "TARGET-MODE-DECLARATION-REF": {
                    "@DEST": "MODE-DECLARATION",
                    "#text": "/Modes/EngineMode"
                  }
                }
              ]
            }
          }
        ],
        "TIMING-EVENT": [
          {
            "SHORT-NAME": "Engine_Control_Tick",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/CANRouter/CANRouterBehavior/Routing_Process_Runnable"
            },
            "PERIOD": 20
          }
        ]
      }
    }
  }
}