{
  "ECU-ABSTRACTION-SW-COMPONENT-TYPE": {
    "SHORT-NAME": "LIN_Interface",
    "PORTS": {
      "P-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "LIN_Bus_P_Port",
          "PROVIDED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/LIN_Bus_Interface"
          }
        },
        {
          "SHORT-NAME": "Seat_CS_P_Port",
          "PROVIDED-INTERFACE-TREF": {
            "@DEST": "CLIENT-SERVER-INTERFACE",
            "#text": "/Interfaces/Seat_ClientServer_Interface"
          }
        }
      ],
      "R-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "Lighting_R_Port",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/Lighting_SR_Interface"
          }
        },
        {
          "SHORT-NAME": "DoorWindow_R_Port",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/DoorWindow_SR_Interface"
          }
        }
      ]
    },
    "SWC-INTERNAL-BEHAVIOR": {
      "SHORT-NAME": "LIN_Interface_InternalBehavior",
      "RUNNABLE-ENTITY": [
        {
          "SHORT-NAME": "LIN_Scheduler_Runnable",
          "MINIMUM-START-INTERVAL": 50,
          "CAN-BE-INVOKED-CONCURRENTLY": "false",
          "DATA-RECEIVE-POINT-BY-ARGUMENTS": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "LIN_Receive_VarAccess",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "R-PORT-PROTOTYPE",
                      "#text": "/Components/LIN_Interface/Ports/Lighting_R_Port"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "AUTOSAR-DATA-PROTOTYPE",
                      "#text": "/DataTypes/LIN_Slave_Frame"
                    }
                  }
                }
              }
            ]
          },
          "DATA-SEND-POINTS": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "LIN_Send_VarAccess",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "P-PORT-PROTOTYPE",
                      "#text": "/Components/LIN_Interface/Ports/LIN_Bus_P_Port"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "AUTOSAR-DATA-PROTOTYPE",
                      "#text": "/DataTypes/LIN_Scheduled_Frame"
                    }
                  }
                }
              }
            ]
          },
          "SYMBOL": "LIN_Interface_LIN_Scheduler"
        }
      ],
      "EVENTS": {
        "DATA-RECEIVED-EVENT": [
          {
            "SHORT-NAME": "LIN_Frame_Received",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/CAN_Interface/CAN_Interface_InternalBehavior/CAN_Rx_Dispatch_Runnable"
            }
          }
        ],
        "TIMING-EVENT": [
          {
            "SHORT-NAME": "LIN_Schedule_Tick",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/CAN_Interface/CAN_Interface_InternalBehavior/CAN_Rx_Dispatch_Runnable"
            },
            "PERIOD": 50
          }
        ]
      }
    }
  }
}