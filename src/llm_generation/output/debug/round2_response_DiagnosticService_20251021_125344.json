{
  "SERVICE-SW-COMPONENT-TYPE": {
    "SHORT-NAME": "DiagnosticService",
    "PORTS": {
      "P-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "P_DiagnosticUDS_Port",
          "PROVIDED-INTERFACE-TREF": {
            "@DEST": "CLIENT-SERVER-INTERFACE",
            "#text": "/Interfaces/DiagnosticUDS_Interface"
          }
        },
        {
          "SHORT-NAME": "P_PowertrainCAN_Port",
          "PROVIDED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/PowertrainCAN_Interface"
          }
        }
      ],
      "R-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "R_DiagnosticUDS_Client_Port",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "CLIENT-SERVER-INTERFACE",
            "#text": "/Interfaces/DiagnosticUDS_Interface"
          }
        },
        {
          "SHORT-NAME": "R_EngineStatus_Port",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/EngineStatus_Interface"
          }
        }
      ]
    },
    "SWC-INTERNAL-BEHAVIOR": {
      "SHORT-NAME": "DiagnosticServiceBehavior",
      "RUNNABLE-ENTITY": [
        {
          "SHORT-NAME": "UDS_Service_Runnable",
          "MINIMUM-START-INTERVAL": 50,
          "CAN-BE-INVOKED-CONCURRENTLY": "false",
          "DATA-RECEIVE-POINT-BY-ARGUMENTS": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "EngineStatus_Access",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "R-PORT-PROTOTYPE",
                      "#text": "/Components/DiagnosticService/Ports/R_EngineStatus_Port"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "AUTOSAR-DATA-PROTOTYPE",
                      "#text": "/DataPrototypes/EngineStatus"
                    }
                  }
                }
              },
              {
                "SHORT-NAME": "UDS_Request_Argument",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "R-PORT-PROTOTYPE",
                      "#text": "/Components/DiagnosticService/Ports/R_DiagnosticUDS_Client_Port"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "ARGUMENT-DATA-PROTOTYPE",
                      "#text": "/DataPrototypes/UDS_Request"
                    }
                  }
                }
              }
            ]
          },
          "SERVER-CALL-POINTS": [
            {
              "SYNCHRONOUS-SERVER-CALL-POINT": {
                "SHORT-NAME": "ReadDTC_Call",
                "OPERATION-IREF": {
                  "CONTEXT-R-PORT-REF": {
                    "@DEST": "R-PORT-PROTOTYPE",
                    "#text": "/Components/DiagnosticService/Ports/R_DiagnosticUDS_Client_Port"
                  },
                  "TARGET-REQUIRED-OPERATION-REF": {
                    "@DEST": "CLIENT-SERVER-OPERATION",
                    "#text": "/Components/EngineController/Operations/ReadDTC"
                  }
                },
                "TIMEOUT": 100
              }
            },
            {
              "SYNCHRONOUS-SERVER-CALL-POINT": {
                "SHORT-NAME": "ClearDTC_Call",
                "OPERATION-IREF": {
                  "CONTEXT-R-PORT-REF": {
                    "@DEST": "R-PORT-PROTOTYPE",
                    "#text": "/Components/DiagnosticService/Ports/R_DiagnosticUDS_Client_Port"
                  },
                  "TARGET-REQUIRED-OPERATION-REF": {
                    "@DEST": "CLIENT-SERVER-OPERATION",
                    "#text": "/Components/EngineController/Operations/ClearDTC"
                  }
                },
                "TIMEOUT": 200
              }
            }
          ],
          "SYMBOL": "DiagnosticService_UDS_Runnable"
        }
      ],
      "EVENTS": {
        "DATA-RECEIVED-EVENT": [
          {
            "SHORT-NAME": "Component_Diagnostic_Event",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/CANRouter/CANRouterBehavior/Routing_Process_Runnable"
            }
          }
        ],
        "OPERATION-INVOKED-EVENT": [
          {
            "SHORT-NAME": "UDS_Request_Event",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/CANRouter/CANRouterBehavior/Routing_Process_Runnable"
            },
            "OPERATION-IREF": {
              "CONTEXT-P-PORT-REF": {
                "@DEST": "P-PORT-PROTOTYPE",
                "#text": "/Components/DiagnosticService/Ports/P_DiagnosticUDS_Port"
              },
              "TARGET-PROVIDED-OPERATION-REF": {
                "@DEST": "CLIENT-SERVER-OPERATION",
                "#text": "/Components/DiagnosticService/Operations/HandleUDSRequest"
              }
            }
          }
        ]
      }
    }
  }
}