{
  "SENSOR-ACTUATOR-SW-COMPONENT-TYPE": {
    "SHORT-NAME": "CurrentMonitor",
    "PORTS": {
      "P-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "CurrentOut",
          "PROVIDED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/Current_SR"
          }
        }
      ],
      "R-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "ConfigReq",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "CLIENT-SERVER-INTERFACE",
            "#text": "/Interfaces/CAN_Send_Service"
          }
        }
      ]
    },
    "SWC-INTERNAL-BEHAVIOR": {
      "SHORT-NAME": "CurrentMonitorBehavior",
      "RUNNABLE-ENTITY": [
        {
          "SHORT-NAME": "Current_Read_Runnable",
          "MINIMUM-START-INTERVAL": 50,
          "CAN-BE-INVOKED-CONCURRENTLY": "false",
          "DATA-SEND-POINTS": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "Current_Out_Access",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "P-PORT-PROTOTYPE",
                      "#text": "/Components/CurrentMonitor/Ports/CurrentOut"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "AUTOSAR-DATA-PROTOTYPE",
                      "#text": "/DataTypes/Current_Amp"
                    }
                  }
                }
              }
            ]
          },
          "SYMBOL": "CurrentMonitor_Current_Read_Runnable"
        }
      ],
      "EVENTS": {
        "INIT-EVENT": [
          {
            "SHORT-NAME": "Current_Init",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/VoltageMonitor/VoltageMonitorBehavior/Voltage_Read_Runnable"
            }
          }
        ],
        "TIMING-EVENT": [
          {
            "SHORT-NAME": "Current_Timer",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/VoltageMonitor/VoltageMonitorBehavior/Voltage_Read_Runnable"
            },
            "PERIOD": 50
          }
        ]
      }
    }
  }
}