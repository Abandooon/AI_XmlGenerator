                      "@DEST": "P-PORT-PROTOTYPE",
                      "#text": "/Components/TemperatureMonitoringP1/P_Port_TemperatureStatus"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "VARIABLE-DATA-PROTOTYPE",
                      "#text": "/Interfaces/TemperatureStatusOutput/TemperatureStatus"
                    }
                  }
                }
              }
            ]
          },
          "SYMBOL": "ProcessTemperature"
        }
      ],
      "EVENTS": {
        "DATA-RECEIVED-EVENT": [
          {
            "SHORT-NAME": "SensorTemperature_DataReceived",
            "START-ON-EVENT-REF": {
