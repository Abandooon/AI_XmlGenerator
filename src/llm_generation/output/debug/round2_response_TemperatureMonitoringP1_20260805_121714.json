            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/TemperatureStatusOutput"
          }
        }
      ],
      "R-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "R_Port_SensorTemperature",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/SensorTemperatureInput"
          }
        }
      ]
    },
    "SWC-INTERNAL-BEHAVIOR": {
