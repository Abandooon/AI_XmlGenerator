      "SUPPORTS-MULTIPLE-INSTANTIATION": "false",
      "HANDLE-TERMINATION-AND-RESTART": "CAN-BE-TERMINATED-AND-RESTARTED",
      "RUNNABLE-ENTITY": [
        {
          "SHORT-NAME": "ProcessTemperature",
          "MINIMUM-START-INTERVAL": 0,
          "CAN-BE-INVOKED-CONCURRENTLY": "false",
