{
  "COMPLEX-DEVICE-DRIVER-SW-COMPONENT-TYPE": {
    "SHORT-NAME": "MotorDriver",
    "PORTS": {
      "PR-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "MotorCommand_Port",
          "PROVIDED-REQUIRED-INTERFACE-TREF": {
            "@DEST": "CLIENT-SERVER-INTERFACE",
            "#text": "/Interfaces/WiperControl_To_MotorDriver"
          }
        },
        {
          "SHORT-NAME": "Status_Port",
          "PROVIDED-REQUIRED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/RainSensor_To_WiperController"
          }
        }
      ],
      "R-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "CAN_Settings_Port",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/CAN_User_Settings"
          }
        }
      ]
    },
    "SWC-INTERNAL-BEHAVIOR": {
      "SHORT-NAME": "MotorDriver_Behavior",
      "RUNNABLE-ENTITY": [
        {
          "SHORT-NAME": "Motor_Control_Runnable",
          "MINIMUM-START-INTERVAL": 20,
          "CAN-BE-INVOKED-CONCURRENTLY": "false",
          "DATA-RECEIVE-POINT-BY-ARGUMENTS": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "Receive_Control_Arguments",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "PR-PORT-PROTOTYPE",
                      "#text": "/Components/MotorDriver/Ports/MotorCommand_Port"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "ARGUMENT-DATA-PROTOTYPE",
                      "#text": "/DataPrototypes/ControlCommandArg"
                    }
                  }
                }
              }
            ]
          },
          "DATA-SEND-POINTS": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "Send_Status",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "PR-PORT-PROTOTYPE",
                      "#text": "/Components/MotorDriver/Ports/Status_Port"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "DATA-PROTOTYPE",
                      "#text": "/DataPrototypes/MotorStatus"
                    }
                  }
                }
              }
            ]
          },
          "SERVER-CALL-POINTS": [
            {
              "SYNCHRONOUS-SERVER-CALL-POINT": {
                "SHORT-NAME": "HAL_Call_Point",
                "OPERATION-IREF": {
                  "CONTEXT-R-PORT-REF": {
                    "@DEST": "PR-PORT-PROTOTYPE",
                    "#text": "/Components/MotorDriver/Ports/MotorCommand_Port"
                  },
                  "TARGET-REQUIRED-OPERATION-REF": {
                    "@DEST": "CLIENT-SERVER-OPERATION",
                    "#text": "/Interfaces/WiperControl_To_MotorDriver/Operations/HardwareControlOp"
                  }
                },
                "TIMEOUT": 20
              }
            }
          ],
          "SYMBOL": "MotorDriver_Motor_Control"
        }
      ],
      "EVENTS": {
        "INTERNAL-TRIGGER-OCCURRED-EVENT": [
          {
            "SHORT-NAME": "HardwareFeedbackEvent",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/RainSensor/RainSensor_Behavior/Sensor_Read_Runnable"
            },
            "EVENT-SOURCE-REF": {
              "@DEST": "INTERNAL-TRIGGERING-POINT",
              "#text": "/Components/MotorDriver/InternalTrigger/HardwareFeedback"
            }
          }
        ],
        "TIMING-EVENT": [
          {
            "SHORT-NAME": "DriverWatchdogEvent",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/RainSensor/RainSensor_Behavior/Sensor_Read_Runnable"
            },
            "PERIOD": 100
          }
        ]
      }
    }
  }
}