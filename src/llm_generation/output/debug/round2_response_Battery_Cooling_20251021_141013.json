{
  "APPLICATION-SW-COMPONENT-TYPE": {
    "SHORT-NAME": "Battery_Cooling",
    "PORTS": {
      "P-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "BatteryCoolingStatus_P",
          "PROVIDED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/Cooling_Status_Interface"
          }
        },
        {
          "SHORT-NAME": "ThermalCoordination_P",
          "PROVIDED-INTERFACE-TREF": {
            "@DEST": "CLIENT-SERVER-INTERFACE",
            "#text": "/Interfaces/Thermal_Optimization_Interface"
          }
        }
      ],
      "R-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "Temperature_In",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/Temperature_Sensor_Interface"
          }
        },
        {
          "SHORT-NAME": "PumpControl_Client",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "CLIENT-SERVER-INTERFACE",
            "#text": "/Interfaces/PumpControl_Interface"
          }
        },
        {
          "SHORT-NAME": "ValveControl_Client",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "CLIENT-SERVER-INTERFACE",
            "#text": "/Interfaces/ValveControl_Interface"
          }
        }
      ]
    },
    "SWC-INTERNAL-BEHAVIOR": {
      "SHORT-NAME": "Battery_Cooling_Behavior",
      "RUNNABLE-ENTITY": [
        {
          "SHORT-NAME": "Battery_Control_Runnable",
          "MINIMUM-START-INTERVAL": 200,
          "CAN-BE-INVOKED-CONCURRENTLY": "false",
          "DATA-RECEIVE-POINT-BY-VALUES": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "BatteryTempAccess",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "R-PORT-PROTOTYPE",
                      "#text": "/Components/Battery_Cooling/Ports/Temperature_In"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "APPLICATION-ARRAY-ELEMENT",
                      "#text": "/DataTypes/TemperatureArray"
                    }
                  }
                }
              }
            ]
          },
          "SERVER-CALL-POINTS": [
            {
              "SYNCHRONOUS-SERVER-CALL-POINT": {
                "SHORT-NAME": "CallPump_SetCommand",
                "OPERATION-IREF": {
                  "CONTEXT-R-PORT-REF": {
                    "@DEST": "R-PORT-PROTOTYPE",
                    "#text": "/Components/Battery_Cooling/Ports/PumpControl_Client"
                  },
                  "TARGET-REQUIRED-OPERATION-REF": {
                    "@DEST": "CLIENT-SERVER-OPERATION",
                    "#text": "/Interfaces/PumpControl_Interface/Operations/SetPump"
                  }
                },
                "TIMEOUT": 150
              }
            },
            {
              "SYNCHRONOUS-SERVER-CALL-POINT": {
                "SHORT-NAME": "CallValve_SetPosition",
                "OPERATION-IREF": {
                  "CONTEXT-R-PORT-REF": {
                    "@DEST": "R-PORT-PROTOTYPE",
                    "#text": "/Components/Battery_Cooling/Ports/ValveControl_Client"
                  },
                  "TARGET-REQUIRED-OPERATION-REF": {
                    "@DEST": "CLIENT-SERVER-OPERATION",
                    "#text": "/Interfaces/ValveControl_Interface/Operations/SetValve"
                  }
                },
                "TIMEOUT": 150
              }
            }
          ],
          "SYMBOL": "Battery_Control_Runnable_Symbol"
        }
      ],
      "EVENTS": {
        "EXTERNAL-TRIGGER-OCCURRED-EVENT": [
          {
            "SHORT-NAME": "Emergency_Cooling_Triggered",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/Temp_Monitor/Temp_Monitor_Behavior/Sampling_Runnable"
            }
          }
        ],
        "TIMING-EVENT": [
          {
            "SHORT-NAME": "Battery_Control_200ms",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/Motor_Cooling/Motor_Cooling_Behavior/Control_Runnable"
            },
            "PERIOD": 200
          }
        ]
      }
    }
  }
}