                "TIMEOUT": 1000
              }
            }
          ],
          "SYMBOL": "Media_Player_Control_Runnable"
        }
      ],
      "EVENTS": {
        "DATA-WRITE-COMPLETED-EVENT": [
          {
            "SHORT-NAME": "Buffer_Write_Completed",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/Bluetooth_Stack/Bluetooth_Stack_Behavior/Audio_Stream_Runnable"
            },
            "EVENT-SOURCE-REF": {
              "@DEST": "VARIABLE-ACCESS",
              "#text": "/Components/Media_Player/SWC-INTERNAL-BEHAVIOR/Playback_Runnable/DATA-SEND-POINTS/VARIABLE-ACCESS/Send_DecodedAudio"
            }
          }
        ],
        "TIMING-EVENT": [
          {
            "SHORT-NAME": "Playback_Timer",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/Bluetooth_Stack/Bluetooth_Stack_Behavior/Audio_Stream_Runnable"
            },
            "PERIOD": 20
          }
        ]
      }
    }
  }
}