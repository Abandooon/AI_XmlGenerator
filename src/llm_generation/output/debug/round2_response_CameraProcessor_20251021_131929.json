{
  "APPLICATION-SW-COMPONENT-TYPE": {
    "SHORT-NAME": "CameraProcessor",
    "PORTS": {
      "P-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "PPort_CameraToFusion",
          "PROVIDED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/Camera_to_Fusion_SR"
          }
        }
      ],
      "R-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "RPort_ImageFrameIn",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "MODE-SWITCH-INTERFACE",
            "#text": "/Interfaces/ADAS_Mode_Switch"
          }
        }
      ]
    },
    "SWC-INTERNAL-BEHAVIOR": {
      "SHORT-NAME": "CameraProcessor_Behavior",
      "RUNNABLE-ENTITY": [
        {
          "SHORT-NAME": "Camera_Inference_Runnable",
          "MINIMUM-START-INTERVAL": 33,
          "CAN-BE-INVOKED-CONCURRENTLY": "false",
          "DATA-RECEIVE-POINT-BY-ARGUMENTS": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "Input_ImageFrame_Access",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "R-PORT-PROTOTYPE",
                      "#text": "/Components/CameraProcessor/Ports/RPort_ImageFrameIn"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "AUTOSAR-DATA-PROTOTYPE",
                      "#text": "/DataTypes/ImageFrame"
                    }
                  }
                }
              }
            ]
          },
          "DATA-SEND-POINTS": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "Output_DetectionList_Access",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "P-PORT-PROTOTYPE",
                      "#text": "/Components/CameraProcessor/Ports/PPort_CameraToFusion"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "AUTOSAR-DATA-PROTOTYPE",
                      "#text": "/DataTypes/DetectionList"
                    }
                  }
                }
              }
            ]
          },
          "SYMBOL": "CameraProcessor.Camera_Inference_Runnable"
        }
      ],
      "EVENTS": {
        "DATA-RECEIVE-ERROR-EVENT": [
          {
            "SHORT-NAME": "Image_Decode_Error",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/RadarProcessor/RadarProcessor_Behavior/Radar_Processing_Runnable"
            }
          }
        ],
        "DATA-RECEIVED-EVENT": [
          {
            "SHORT-NAME": "ImageFrame_Received",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/RadarProcessor/RadarProcessor_Behavior/Radar_Processing_Runnable"
            }
          }
        ],
        "TIMING-EVENT": [
          {
            "SHORT-NAME": "Camera_Cycle",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/RadarProcessor/RadarProcessor_Behavior/Radar_Processing_Runnable"
            },
            "PERIOD": 33
          }
        ]
      }
    }
  }
}