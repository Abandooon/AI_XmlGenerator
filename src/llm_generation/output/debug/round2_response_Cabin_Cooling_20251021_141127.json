{
  "APPLICATION-SW-COMPONENT-TYPE": {
    "SHORT-NAME": "Cabin_Cooling",
    "PORTS": {
      "P-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "P_CoolingStatus",
          "PROVIDED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/Cooling_Status_Interface"
          }
        },
        {
          "SHORT-NAME": "P_ModeAck",
          "PROVIDED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/Cooling_Status_Interface"
          }
        }
      ],
      "R-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "R_Temperature",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/Temperature_Sensor_Interface"
          }
        },
        {
          "SHORT-NAME": "R_ThermalOpt",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "CLIENT-SERVER-INTERFACE",
            "#text": "/Interfaces/Thermal_Optimization_Interface"
          }
        },
        {
          "SHORT-NAME": "R_PumpCtrl",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "CLIENT-SERVER-INTERFACE",
            "#text": "/Interfaces/PumpControl_Interface"
          }
        },
        {
          "SHORT-NAME": "R_ValveCtrl",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "CLIENT-SERVER-INTERFACE",
            "#text": "/Interfaces/ValveControl_Interface"
          }
        }
      ]
    },
    "SWC-INTERNAL-BEHAVIOR": {
      "SHORT-NAME": "Cabin_Cooling_Behavior",
      "RUNNABLE-ENTITY": [
        {
          "SHORT-NAME": "Cabin_Control_Runnable",
          "MINIMUM-START-INTERVAL": 200,
          "CAN-BE-INVOKED-CONCURRENTLY": "false",
          "DATA-RECEIVE-POINT-BY-ARGUMENTS": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "Access_TemperatureArray",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "R-PORT-PROTOTYPE",
                      "#text": "/Components/Cabin_Cooling/Ports/R_Temperature"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "VARIABLE-DATA-PROTOTYPE",
                      "#text": "/DataPrototypes/TemperatureArray"
                    }
                  }
                }
              },
              {
                "SHORT-NAME": "Access_Setpoint",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "R-PORT-PROTOTYPE",
                      "#text": "/Components/Cabin_Cooling/Ports/R_ThermalOpt"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "ARGUMENT-DATA-PROTOTYPE",
                      "#text": "/DataPrototypes/CabinSetpoint"
                    }
                  }
                }
              }
            ]
          },
          "SERVER-CALL-POINTS": [
            {
              "ASYNCHRONOUS-SERVER-CALL-POINT": {
                "SHORT-NAME": "AsyncCall_Pump_Set",
                "OPERATION-IREF": {
                  "CONTEXT-R-PORT-REF": {
                    "@DEST": "R-PORT-PROTOTYPE",
                    "#text": "/Components/Cabin_Cooling/Ports/R_PumpCtrl"
                  },
                  "TARGET-REQUIRED-OPERATION-REF": {
                    "@DEST": "CLIENT-SERVER-OPERATION",
                    "#text": "/Interfaces/PumpControl_Interface/Operations/SetPumpCommand"
                  }
                },
                "TIMEOUT": 150
              }
            },
            {
              "ASYNCHRONOUS-SERVER-CALL-POINT": {
                "SHORT-NAME": "AsyncCall_Valve_Set",
                "OPERATION-IREF": {
                  "CONTEXT-R-PORT-REF": {
                    "@DEST": "R-PORT-PROTOTYPE",
                    "#text": "/Components/Cabin_Cooling/Ports/R_ValveCtrl"
                  },
                  "TARGET-REQUIRED-OPERATION-REF": {
                    "@DEST": "CLIENT-SERVER-OPERATION",
                    "#text": "/Interfaces/ValveControl_Interface/Operations/SetValvePosition"
                  }
                },
                "TIMEOUT": 150
              }
            }
          ],
          "SYMBOL": "Cabin_Control_RunnableSymbol"
        }
      ],
      "EVENTS": {
        "MODE-SWITCHED-ACK-EVENT": [
          {
            "SHORT-NAME": "ModeSwitchAck",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/Temp_Monitor/Temp_Monitor_Behavior/Sampling_Runnable"
            },
            "EVENT-SOURCE-REF": {
              "@DEST": "MODE-SWITCH-POINT",
              "#text": "/ModeSwitchPoints/CabinModeSwitch"
            }
          }
        ],
        "TIMING-EVENT": [
          {
            "SHORT-NAME": "Cabin_Control_200ms",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/Temp_Monitor/Temp_Monitor_Behavior/Sampling_Runnable"
            },
            "PERIOD": 200
          }
        ]
      }
    }
  }
}