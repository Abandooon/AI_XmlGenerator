{
  "SENSOR-ACTUATOR-SW-COMPONENT-TYPE": {
    "SHORT-NAME": "Door_Sensor_Component",
    "PORTS": {
      "P-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "P_Port_Status",
          "PROVIDED-INTERFACE-TREF": {
            "@DEST": "CLIENT-SERVER-INTERFACE",
            "#text": "/Interfaces/DOOR_STATUS_INTERFACE"
          }
        }
      ]
    },
    "SWC-INTERNAL-BEHAVIOR": {
      "SHORT-NAME": "Door_Sensor_Behavior",
      "SUPPORTS-MULTIPLE-INSTANTIATION": "false",
      "HANDLE-TERMINATION-AND-RESTART": "true",
      "RUNNABLE-ENTITY": [
        {
          "SHORT-NAME": "DoorState_Runnable",
          "MINIMUM-START-INTERVAL": 0,
          "CAN-BE-INVOKED-CONCURRENTLY": "true",
          "DATA-RECEIVE-POINT-BY-VALUES": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "DoorStatus_Receive",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "P-PORT-PROTOTYPE",
                      "#text": "/Components/Door_Sensor_Component/P_Port_Status"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "VARIABLE-DATA-PROTOTYPE",
                      "#text": "/Interfaces/ENVIRONMENT_INTERFACE/ENVIRONMENT_DATA"
                    }
                  }
                }
              }
            ]
          },
          "DATA-SEND-POINTS": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "DoorStatus_Send",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "P-PORT-PROTOTYPE",
                      "#text": "/Components/Door_Sensor_Component/P_Port_Status"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "VARIABLE-DATA-PROTOTYPE",
                      "#text": "/Interfaces/ENVIRONMENT_INTERFACE/ENVIRONMENT_DATA"
                    }
                  }
                }
              }
            ]
          },
          "SYMBOL": "Door_Sensor_Status_Symbol"
        }
      ],
      "EVENTS": {
        "INIT-EVENT": [
          {
            "SHORT-NAME": "Init_E",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/Door_Sensor_Component/DoorState_Runnable"
            }
          }
        ],
        "TIMING-EVENT": [
          {
            "SHORT-NAME": "Sample_Tick",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/Door_Sensor_Component/DoorState_Runnable"
            },
            "PERIOD": 100
          }
        ]
      }
    }
  }
}