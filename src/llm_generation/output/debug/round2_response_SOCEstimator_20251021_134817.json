{
  "APPLICATION-SW-COMPONENT-TYPE": {
    "SHORT-NAME": "SOCEstimator",
    "PORTS": {
      "P-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "P_SOC_SOH_Port",
          "PROVIDED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/SOC_SOH_Interface"
          }
        }
      ],
      "R-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "R_CellVoltages_Port",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/Cell_Voltages_Interface"
          }
        },
        {
          "SHORT-NAME": "R_ThermalStatus_Port",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/Thermal_Status_Interface"
          }
        },
        {
          "SHORT-NAME": "R_Balancer_Client_Port",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "CLIENT-SERVER-INTERFACE",
            "#text": "/Interfaces/Balancer_Control_Interface"
          }
        }
      ]
    },
    "SWC-INTERNAL-BEHAVIOR": {
      "SHORT-NAME": "SOCEstimator_Behavior",
      "RUNNABLE-ENTITY": [
        {
          "SHORT-NAME": "Estimate_Runnable",
          "MINIMUM-START-INTERVAL": 200,
          "CAN-BE-INVOKED-CONCURRENTLY": "false",
          "DATA-RECEIVE-POINT-BY-ARGUMENTS": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "Read_CellVoltages",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "R-PORT-PROTOTYPE",
                      "#text": "/Components/SOCEstimator/Ports/R_CellVoltages_Port"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "APPLICATION-ARRAY-ELEMENT",
                      "#text": "/DataTypes/cell_voltage[96]"
                    }
                  }
                }
              },
              {
                "SHORT-NAME": "Read_Temperatures",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "R-PORT-PROTOTYPE",
                      "#text": "/Components/SOCEstimator/Ports/R_ThermalStatus_Port"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "APPLICATION-ARRAY-ELEMENT",
                      "#text": "/DataTypes/temperatures"
                    }
                  }
                }
              }
            ]
          },
          "DATA-SEND-POINTS": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "Write_SOC",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "P-PORT-PROTOTYPE",
                      "#text": "/Components/SOCEstimator/Ports/P_SOC_SOH_Port"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "AUTOSAR-DATA-PROTOTYPE",
                      "#text": "/DataTypes/SOC"
                    }
                  }
                }
              },
              {
                "SHORT-NAME": "Write_SOH",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "P-PORT-PROTOTYPE",
                      "#text": "/Components/SOCEstimator/Ports/P_SOC_SOH_Port"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "AUTOSAR-DATA-PROTOTYPE",
                      "#text": "/DataTypes/SOH"
                    }
                  }
                }
              },
              {
                "SHORT-NAME": "Write_StateFlags",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "P-PORT-PROTOTYPE",
                      "#text": "/Components/SOCEstimator/Ports/P_SOC_SOH_Port"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "AUTOSAR-DATA-PROTOTYPE",
                      "#text": "/DataTypes/state_flags"
                    }
                  }
                }
              }
            ]
          },
          "PARAMETER-ACCESSS": {
            "PARAMETER-ACCESS": [
              {
                "SHORT-NAME": "Read_Estimator_Params",
                "ACCESSED-PARAMETER": {
                  "AUTOSAR-PARAMETER-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "P-PORT-PROTOTYPE",
                      "#text": "/Components/SOCEstimator/Ports/P_SOC_SOH_Port"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "PARAMETER-DATA-PROTOTYPE",
                      "#text": "/Parameters/EstimatorParams"
                    }
                  }
                }
              }
            ]
          },
          "SYMBOL": "SOCEstimator_Estimate_Runnable"
        }
      ],
      "EVENTS": {
        "DATA-RECEIVED-EVENT": [
          {
            "SHORT-NAME": "CellData_Update_Event",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/CellMonitor/CellMonitor_Behavior/MeasureCells_Runnable"
            }
          }
        ],
        "TIMING-EVENT": [
          {
            "SHORT-NAME": "Estimate_Periodic_Event",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/ThermalManager/ThermalManager_Behavior/ThermalMonitor_Runnable"
            },
            "PERIOD": 200
          }
        ]
      }
    }
  }
}