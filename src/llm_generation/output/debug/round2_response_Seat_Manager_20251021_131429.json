{
  "APPLICATION-SW-COMPONENT-TYPE": {
    "SHORT-NAME": "Seat_Manager",
    "PORTS": {
      "P-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "P_CAN",
          "PROVIDED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/CAN_Bus_Interface"
          }
        },
        {
          "SHORT-NAME": "P_LIN",
          "PROVIDED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/LIN_Bus_Interface"
          }
        }
      ],
      "R-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "R_Seat_CS_Client",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "CLIENT-SERVER-INTERFACE",
            "#text": "/Interfaces/Seat_ClientServer_Interface"
          }
        }
      ]
    },
    "SWC-INTERNAL-BEHAVIOR": {
      "SHORT-NAME": "Seat_Manager_InternalBehavior",
      "RUNNABLE-ENTITY": [
        {
          "SHORT-NAME": "Seat_Control_Runnable",
          "MINIMUM-START-INTERVAL": 50,
          "CAN-BE-INVOKED-CONCURRENTLY": "false",
          "DATA-RECEIVE-POINT-BY-ARGUMENTS": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "Recv_UserInput",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "R-PORT-PROTOTYPE",
                      "#text": "/Components/Seat_Manager/Ports/R_Seat_CS_Client"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "VARIABLE-DATA-PROTOTYPE",
                      "#text": "/DataPrototypes/SeatTargetPosition"
                    }
                  }
                }
              },
              {
                "SHORT-NAME": "Recv_PositionFeedback",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "P-PORT-PROTOTYPE",
                      "#text": "/Components/Seat_Manager/Ports/P_LIN"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "VARIABLE-DATA-PROTOTYPE",
                      "#text": "/DataPrototypes/SeatPositionFeedback"
                    }
                  }
                }
              }
            ]
          },
          "DATA-SEND-POINTS": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "Send_MotorCommand",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "P-PORT-PROTOTYPE",
                      "#text": "/Components/Seat_Manager/Ports/P_CAN"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "VARIABLE-DATA-PROTOTYPE",
                      "#text": "/DataPrototypes/SeatCmd_Frame"
                    }
                  }
                }
              },
              {
                "SHORT-NAME": "Send_HeaterCmd",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "R-PORT-PROTOTYPE",
                      "#text": "/Components/Seat_Manager/Ports/R_Seat_CS_Client"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "VARIABLE-DATA-PROTOTYPE",
                      "#text": "/DataPrototypes/HeaterControl"
                    }
                  }
                }
              }
            ]
          },
          "SYMBOL": "SeatManager_Seat_Control_Runnable"
        }
      ],
      "EVENTS": {
        "EXTERNAL-TRIGGER-OCCURRED-EVENT": [
          {
            "SHORT-NAME": "Seat_Adjust_Request_Event",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/CAN_Interface/CAN_Interface_InternalBehavior/CAN_Rx_Dispatch_Runnable"
            }
          }
        ],
        "TIMING-EVENT": [
          {
            "SHORT-NAME": "Seat_Feedback_Sample",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/LIN_Interface/LIN_Interface_InternalBehavior/LIN_Scheduler_Runnable"
            },
            "PERIOD": 50
          }
        ]
      }
    }
  }
}