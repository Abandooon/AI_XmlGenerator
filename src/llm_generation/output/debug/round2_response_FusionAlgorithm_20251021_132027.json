{
  "APPLICATION-SW-COMPONENT-TYPE": {
    "SHORT-NAME": "FusionAlgorithm",
    "PORTS": {
      "P-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "FusionOutput_PPort",
          "PROVIDED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/Fusion_to_Planner_SR"
          }
        },
        {
          "SHORT-NAME": "SystemStatus_PPort",
          "PROVIDED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/System_Status_to_HMI_SR"
          }
        }
      ],
      "R-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "RadarInput_RPort",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/Radar_to_Fusion_SR"
          }
        },
        {
          "SHORT-NAME": "CameraInput_RPort",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/Camera_to_Fusion_SR"
          }
        },
        {
          "SHORT-NAME": "ParameterService_RPort",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "CLIENT-SERVER-INTERFACE",
            "#text": "/Interfaces/Parameter_Service_CS"
          }
        },
        {
          "SHORT-NAME": "ModeSwitch_RPort",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "MODE-SWITCH-INTERFACE",
            "#text": "/Interfaces/ADAS_Mode_Switch"
          }
        }
      ]
    },
    "SWC-INTERNAL-BEHAVIOR": {
      "SHORT-NAME": "FusionAlgorithm_Behavior",
      "RUNNABLE-ENTITY": [
        {
          "SHORT-NAME": "Fusion_Main_Runnable",
          "MINIMUM-START-INTERVAL": 50,
          "CAN-BE-INVOKED-CONCURRENTLY": "false",
          "DATA-RECEIVE-POINT-BY-VALUES": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "Radar_Input_VarAccess",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "R-PORT-PROTOTYPE",
                      "#text": "/Components/FusionAlgorithm/Ports/RadarInput_RPort"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "AUTOSAR-DATA-PROTOTYPE",
                      "#text": "/DataTypes/Radar/ObjectList"
                    }
                  }
                }
              },
              {
                "SHORT-NAME": "Camera_Input_VarAccess",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "R-PORT-PROTOTYPE",
                      "#text": "/Components/FusionAlgorithm/Ports/CameraInput_RPort"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "AUTOSAR-DATA-PROTOTYPE",
                      "#text": "/DataTypes/Camera/DetectionList"
                    }
                  }
                }
              }
            ]
          },
          "DATA-SEND-POINTS": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "Fusion_Output_VarAccess",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "P-PORT-PROTOTYPE",
                      "#text": "/Components/FusionAlgorithm/Ports/FusionOutput_PPort"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "AUTOSAR-DATA-PROTOTYPE",
                      "#text": "/DataTypes/Perception/FusedObjectList"
                    }
                  }
                }
              }
            ]
          },
          "SERVER-CALL-POINTS": [
            {
              "SYNCHRONOUS-SERVER-CALL-POINT": {
                "SHORT-NAME": "ParameterService_Call",
                "OPERATION-IREF": {
                  "CONTEXT-R-PORT-REF": {
                    "@DEST": "R-PORT-PROTOTYPE",
                    "#text": "/Components/FusionAlgorithm/Ports/ParameterService_RPort"
                  },
                  "TARGET-REQUIRED-OPERATION-REF": {
                    "@DEST": "CLIENT-SERVER-OPERATION",
                    "#text": "/Interfaces/Parameter_Service_CS/GetParameter"
                  }
                },
                "TIMEOUT": 200
              }
            }
          ],
          "SYMBOL": "Fusion_Main_Runnable_Symbol"
        }
      ],
      "EVENTS": {
        "DATA-RECEIVED-EVENT": [
          {
            "SHORT-NAME": "Radar_Data_Received",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/RadarProcessor/RadarProcessor_Behavior/Radar_Processing_Runnable"
            }
          },
          {
            "SHORT-NAME": "Camera_Data_Received",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/CameraProcessor/CameraProcessor_Behavior/Camera_Inference_Runnable"
            }
          }
        ],
        "SWC-MODE-SWITCH-EVENT": [
          {
            "SHORT-NAME": "Fusion_Mode_Switch",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/CameraProcessor/CameraProcessor_Behavior/Camera_Inference_Runnable"
            },
            "ACTIVATION": "NORMAL",
            "MODE-IREFS": {
              "MODE-IREF": [
                {
                  "CONTEXT-MODE-DECLARATION-GROUP-PROTOTYPE-REF": {
                    "@DEST": "MODE-DECLARATION-GROUP-PROTOTYPE",
                    "#text": "/Interfaces/ADAS_Mode_Switch/ADASModeGroup"
                  },
                  "CONTEXT-PORT-REF": {
                    "@DEST": "R-PORT-PROTOTYPE",
                    "#text": "/Components/FusionAlgorithm/Ports/ModeSwitch_RPort"
                  },
                  "TARGET-MODE-DECLARATION-REF": {
                    "@DEST": "MODE-DECLARATION",
                    "#text": "/Interfaces/ADAS_Mode_Switch/ADASModeGroup/ModeDeclarations"
                  }
                }
              ]
            }
          }
        ],
        "TIMING-EVENT": [
          {
            "SHORT-NAME": "Fusion_Cycle",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/RadarProcessor/RadarProcessor_Behavior/Radar_Processing_Runnable"
            },
            "PERIOD": 50
          }
        ]
      }
    }
  }
}