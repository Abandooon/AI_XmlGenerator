{
  "SERVICE-PROXY-SW-COMPONENT-TYPE": {
    "SHORT-NAME": "CAN_Gateway",
    "PORTS": {
      "P-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "PPort_CAN_Command",
          "PROVIDED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/CAN_Command_IF"
          }
        }
      ],
      "R-PORT-PROTOTYPE": [
        {
          "SHORT-NAME": "RPort_CAN_Bus",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "SENDER-RECEIVER-INTERFACE",
            "#text": "/Interfaces/CAN_Bus_IF"
          }
        },
        {
          "SHORT-NAME": "RPort_UDS_Service",
          "REQUIRED-INTERFACE-TREF": {
            "@DEST": "CLIENT-SERVER-INTERFACE",
            "#text": "/Interfaces/UDS_Service_IF"
          }
        }
      ]
    },
    "SWC-INTERNAL-BEHAVIOR": {
      "SHORT-NAME": "CAN_Gateway_Behavior",
      "RUNNABLE-ENTITY": [
        {
          "SHORT-NAME": "CAN_Rx_Runnable",
          "MINIMUM-START-INTERVAL": 0,
          "CAN-BE-INVOKED-CONCURRENTLY": "false",
          "DATA-RECEIVE-POINT-BY-VALUES": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "CAN_Frame_Access",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "R-PORT-PROTOTYPE",
                      "#text": "/Components/CAN_Gateway/Ports/RPort_CAN_Bus"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "AUTOSAR-DATA-PROTOTYPE",
                      "#text": "/DataPrototypes/Raw_CAN_Frame"
                    }
                  }
                }
              }
            ]
          },
          "DATA-SEND-POINTS": {
            "VARIABLE-ACCESS": []
          },
          "SERVER-CALL-POINTS": [],
          "SYMBOL": "CAN_Gateway_CAN_Rx_Runnable"
        },
        {
          "SHORT-NAME": "Decode_Route_Runnable",
          "MINIMUM-START-INTERVAL": 10,
          "CAN-BE-INVOKED-CONCURRENTLY": "false",
          "DATA-RECEIVE-POINT-BY-VALUES": {
            "VARIABLE-ACCESS": []
          },
          "DATA-SEND-POINTS": {
            "VARIABLE-ACCESS": [
              {
                "SHORT-NAME": "Decoded_Command_Send",
                "ACCESSED-VARIABLE": {
                  "AUTOSAR-VARIABLE-IREF": {
                    "PORT-PROTOTYPE-REF": {
                      "@DEST": "P-PORT-PROTOTYPE",
                      "#text": "/Components/CAN_Gateway/Ports/PPort_CAN_Command"
                    },
                    "TARGET-DATA-PROTOTYPE-REF": {
                      "@DEST": "AUTOSAR-DATA-PROTOTYPE",
                      "#text": "/DataPrototypes/Decoded_Command"
                    }
                  }
                }
              }
            ]
          },
          "SERVER-CALL-POINTS": [
            {
              "ASYNCHRONOUS-SERVER-CALL-POINT": {
                "SHORT-NAME": "UDS_Forward_Call",
                "OPERATION-IREF": {
                  "CONTEXT-R-PORT-REF": {
                    "@DEST": "R-PORT-PROTOTYPE",
                    "#text": "/Components/CAN_Gateway/Ports/RPort_UDS_Service"
                  },
                  "TARGET-REQUIRED-OPERATION-REF": {
                    "@DEST": "CLIENT-SERVER-OPERATION",
                    "#text": "/Interfaces/UDS_Service_IF/Operations/RequestResponse"
                  }
                },
                "TIMEOUT": 50
              }
            }
          ],
          "SYMBOL": "CAN_Gateway_Decode_Route_Runnable"
        }
      ],
      "EVENTS": {
        "ASYNCHRONOUS-SERVER-CALL-RETURNS-EVENT": [
          {
            "SHORT-NAME": "UDS_Response_Returned_Event",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/Diagnostic_Manager/Diagnostic_Manager_Behavior/UDS_Request_Handler"
            },
            "EVENT-SOURCE-REF": {
              "@DEST": "ASYNCHRONOUS-SERVER-CALL-RESULT-POINT",
              "#text": "/Components/CAN_Gateway/Events/UDS_Forward_Result"
            }
          }
        ],
        "DATA-RECEIVED-EVENT": [
          {
            "SHORT-NAME": "CAN_Frame_Received_Event",
            "START-ON-EVENT-REF": {
              "@DEST": "RUNNABLE-ENTITY",
              "#text": "/Components/Diagnostic_Manager/Diagnostic_Manager_Behavior/UDS_Request_Handler"
            }
          }
        ]
      }
    }
  }
}