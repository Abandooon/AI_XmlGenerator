  ],
  "content_guidance": {
    "content_elements": {
      "SHORT-NAME": {
        "type": "text",
        "context_dependent": true,
        "examples": {
          "component": ["ASW_COM", "BatteryController", "MotorManager"],
          "port": ["PPort_MCU01_EmergShutDown", "RPort_HCU01_TqCmd"],
          "runnable": ["RE_COM_SWC", "RE_Main_Task"],
          "event": ["TE_SWC_COM_10ms", "TE_Periodic_100ms"],
          "variable_access": ["DRPA_HCU01_Shift_0", "DSP_MCU01_CurCntTor_0"]
        }
      },
      "PROVIDED-INTERFACE-TREF": {
        "type": "reference",
        "pattern": "/COM_Interface/SR_Interface_{interface_name}",
        "attribute": "DEST=\"SENDER-RECEIVER-INTERFACE\"",
        "examples": [
          "/COM_Interface/SR_Interface_MCU01_EmergShutDown",
          "/COM_Interface/SR_Interface_MCU02_MaxTor"
        ]
      },
      "REQUIRED-INTERFACE-TREF": {
        "type": "reference",
        "pattern": "/COM_Interface/SR_Interface_{interface_name}",
        "attribute": "DEST=\"SENDER-RECEIVER-INTERFACE\"",
        "examples": [
          "/COM_Interface/SR_Interface_HCU01_TqCmd",
          "/COM_Interface/SR_Interface_HCU01_Shift"
        ]
      },
      "DATA-ELEMENT-REF": {
        "type": "reference",
        "pattern": "/COM_Interface/SR_Interface_{interface_name}/{data_element}",
        "attribute": "DEST=\"VARIABLE-DATA-PROTOTYPE\"",
        "examples": [
          "/COM_Interface/SR_Interface_HCU01_TqCmd/HCU01_Tq_Cmd",
          "/COM_Interface/SR_Interface_HCU01_Shift/HCU01_Shift"
        ]
      },
      "PORT-PROTOTYPE-REF": {
        "type": "reference",
        "pattern": "/COM_SWC/ASW_COM/{port_name}",
        "attribute": "DEST=\"{port_type}\"",
        "examples": [
          "/COM_SWC/ASW_COM/RPort_HCU01_Shift",
          "/COM_SWC/ASW_COM/PPort_MCU01_EmergShutDown"
        ]
      },
      "TARGET-DATA-PROTOTYPE-REF": {
        "type": "reference",
        "pattern": "/COM_Interface/SR_Interface_{interface_name}/{data_element}",
        "attribute": "DEST=\"VARIABLE-DATA-PROTOTYPE\"",
        "examples": [
          "/COM_Interface/SR_Interface_HCU01_Shift/HCU01_Shift",
          "/COM_Interface/SR_Interface_MCU01_EmergShutDown/MCU01_EmergShutDown"
        ]
      },
      "START-ON-EVENT-REF": {
        "type": "reference",
        "pattern": "/COM_SWC/ASW_COM/SwcInternalBehavior/{runnable_name}",
        "attribute": "DEST=\"RUNNABLE-ENTITY\"",
        "examples": [
          "/COM_SWC/ASW_COM/SwcInternalBehavior/RE_COM_SWC"
        ]
      },
      "PERIOD": {
        "type": "numeric",
        "examples": ["0.01", "0.005", "0.02", "0.1"],
        "description": "Timing period in seconds"
      },
      "ALIVE-TIMEOUT": {
        "type": "numeric",
        "examples": ["0.3", "0.5", "1.0"],
        "description": "Timeout value in seconds"
      },
      "HANDLE-TIMEOUT-TYPE": {
        "type": "enum",
        "values": ["NONE", "REPLACE", "KEEP"],
        "default": "NONE"
      },
      "SYMBOL": {
        "type": "text",
        "pattern": "{runnable_name}_func",
        "examples": ["RE_COM_SWC_func", "RE_Main_Task_func"]
      },
      "SD": {
        "type": "boolean",
        "examples": ["true", "false"],
        "default": "true"
      }
    },
    "uuid_elements": [
      "P-PORT-PROTOTYPE",
      "R-PORT-PROTOTYPE",
      "TIMING-EVENT",
      "RUNNABLE-ENTITY",
      "VARIABLE-ACCESS"
    ],
    "attribute_guidance": {
      "SDG": ["GID"],
      "PROVIDED-INTERFACE-TREF": ["DEST"],
      "REQUIRED-INTERFACE-TREF": ["DEST"],
      "DATA-ELEMENT-REF": ["DEST"],
      "PORT-PROTOTYPE-REF": ["DEST"],
      "TARGET-DATA-PROTOTYPE-REF": ["DEST"],
      "START-ON-EVENT-REF": ["DEST"]
    }
  }
}