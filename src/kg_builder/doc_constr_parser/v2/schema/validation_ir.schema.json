{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "validation_ir.schema.json",
  "title": "AUTOSAR Validation IR rule",
  "type": "object",
  "additionalProperties": false,
  "required": ["rule_id", "constraint_id", "applicability", "assertion"],
  "properties": {
    "rule_id": {"type": "string", "pattern": "^(TPS_SWCT|constr)_[A-Za-z0-9_]+#r[1-9][0-9]*$"},
    "constraint_id": {"type": "string", "pattern": "^(TPS_SWCT|constr)_[A-Za-z0-9_]+$"},
    "applicability": {"$ref": "#/$defs/expression"},
    "assertion": {"$ref": "#/$defs/expression"},
    "message": {"type": "string"}
  },
  "$defs": {
    "literal": {"type": ["string", "number", "integer", "boolean", "null"]},
    "expression": {
      "oneOf": [
        {"$ref": "#/$defs/literal"},
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["op"],
          "properties": {
            "op": {
              "enum": [
                "true", "false", "select", "value", "exists", "not_exists",
                "count", "min_count", "max_count", "exact_count", "equals",
                "not_equals", "in", "range", "matches", "and", "or", "not",
                "implies", "unique", "resolves_to", "same_value", "forall",
                "some", "aggregate", "plugin"
              ]
            }
          }
        }
      ]
    }
  }
}

