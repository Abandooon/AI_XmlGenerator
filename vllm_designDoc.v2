#### 5.2.2 本地启动脚本
```python
# run.py - 本地客户端启动脚本
import asyncio
import yaml
from pathlib import Path

from src.client.full_client import FullAutosarClient
from src.utils.logger import get_logger

async def main():
    """本地客户端主函数"""

    # 加载配置
    config_path = Path("config/main_config.yaml")
    with open(config_path, 'r', encoding='utf-8') as f:
        config = yaml.safe_load(f)

    # 初始化客户端
    client = FullAutosarClient(config)

    # 测试用例
    test_request = {
        "prompt": "Generate AUTOSAR APPLICATION-SW-COMPONENT-TYPE for motor controller",
        "autosar_context": {
            "domain": "motor_control",
            "component_type": "APPLICATION-SW-COMPONENT-TYPE"
        },
        "constraint_level": "mixed",
        "temperature": 0.7,
        "max_tokens": 1500
    }

    # 执行生成和验证
    response = await client.generate_and_validate_full(**test_request)

    # 结果处理
    if response.success:
        print(f"✅ Generation successful!")
        print(f"📄 Generated XML: {len(response.generation.generated_xml)} chars")
        print(f"🔍 Validation: {response.validation.overall_valid}")

        # 保存结果
        output_file = Path("outputs") / "generated_autosar.xml"
        with open(output_file, 'w', encoding='utf-8') as f:
            f.write(response.generation.generated_xml)

    else:
        print(f"❌ Generation failed: {response.error}")

if __name__ == "__main__":
    asyncio.run(main())
```

