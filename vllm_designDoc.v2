# tests/test_integration.py
class TestEndToEndFlow:
    """端到端集成测试"""

    @pytest.fixture
    async def mock_cloud_service(self):
        """模拟云端服务"""
        app = FastAPI()

        @app.post("/enhanced_generate")
        async def mock_generate(request: EnhancedGenerationRequest):
            return CloudGenerationResponse(
                request_id=request.request_id,
                success=True,
                generated_xml=self._generate_mock_xml(request),
                constraints_applied={"gbnf": True, "fsm": True},
                generation_time=1.0
            )

        return app

    async def test_full_generation_flow(self, mock_cloud_service):
        """测试完整生成流程"""

        # 准备测试数据
        config = self._load_test_config()
        client = FullAutosarClient(config)

        # 执行生成
        response = await client.generate_and_validate_full(
            prompt="Generate AUTOSAR timing event",
            constraint_level="mixed"
        )

        # 验证结果
        assert response.success == True
        assert response.generation is not None
        assert response.validation is not None
        assert response.validation.overall_valid == True
        assert response.execution_time < 5.0

    async def test_constraint_effectiveness(self):
        """测试约束效果"""

        test_cases = [
            {"constraint_level": "simple", "expected_constraints": ["gbnf"]},
            {"constraint_level": "mixed", "expected_constraints": ["gbnf", "fsm"]},
            {"constraint_level": "full", "expected_constraints": ["gbnf", "fsm", "domain"]}
        ]

        for case in test_cases:
            response = await self._generate_with_level(case["constraint_level"])

            # 验证约束应用
            constraints_applied = response.generation.metadata["constraints_applied"]
            for constraint in case["expected_constraints"]:
                assert constraints_applied.get(constraint) == True
```

### 8.2 性能测试
```python
# tests/test_performance.py
class TestPerformance:
    """性能测试套件"""

    async def test_concurrent_requests(self):
        """并发请求性能测试"""

        concurrent_requests = 10
        client = FullAutosarClient(self._load_test_config())

        # 创建并发请求
        requests = [
            self._create_test_request(f"request_{i}")
            for i in range(concurrent_requests)
        ]

        # 并发执行
        start_time = time.time()
        responses = await asyncio.gather(*[
            client.generate_and_validate_full(**req) for req in requests
        ])
        end_time = time.time()

        # 性能验证
        total_time = end_time - start_time
        avg_time_per_request = total_time / concurrent_requests

        assert total_time < 10.0  # 10个请求在10秒内完成
        assert avg_time_per_request < 3.0  # 平均每个请求3秒内
        assert all(r.success for r in responses)  # 所有请求成功

    async def test_large_constraint_handling(self):
        """大型约束处理性能测试"""

        # 创建大型GBNF语法
        large_grammar = self._generate_large_gbnf_grammar(10000)  # 10k行

        request = EnhancedGenerationRequest(
            request_id="large_constraint_test",
            prompt="Generate complex AUTOSAR component",
            constraint_info=ConstraintInfo(
                gbnf_enabled=True,
                grammar_rules=large_grammar
            )
        )

        start_time = time.time()
        response = await self._send_request(request)
        end_time = time.time()

        # 验证大型约束不显著影响性能
        assert end_time - start_time < 5.0
        assert response.success == True
```

