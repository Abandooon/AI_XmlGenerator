            "validation_level": "basic",
            "artifacts_dir": "./src/constraint_graph/artifacts"
        }
    }

    client = FullAutosarClient(config)

    response = await client.generate_and_validate_full(
        prompt="Generate AUTOSAR APPLICATION-SW-COMPONENT-TYPE for motor controller",
        autosar_context={
            "domain": "motor_control",
            "component_type": "APPLICATION-SW-COMPONENT-TYPE"
        },
        constraint_level="simple",
        temperature=0.7,
        max_tokens=1024
    )

    if response.success:
        print(f"✅ Generation successful!")
        print(f"Generated XML length: {len(response.generation.generated_xml)}")
        print(f"Validation passed: {response.validation.overall_valid}")

        # 保存结果
        with open("output.xml", "w") as f:
            f.write(response.generation.generated_xml)
    else:
        print(f"❌ Generation failed: {response.error}")

if __name__ == "__main__":
    asyncio.run(basic_test())
```

### 9.2 高级使用场景

#### 9.2.1 批量生成
```python
async def batch_generation_example():
    """批量生成示例"""

    client = FullAutosarClient(config)

    # 准备多个请求
    requests = [
        {
            "prompt": "Generate AUTOSAR timing event with 10ms period",
            "constraint_level": "mixed",
            "autosar_context": {"domain": "timing"}
        },
        {
            "prompt": "Generate AUTOSAR port interface with data elements",
            "constraint_level": "full",
            "autosar_context": {"domain": "interface"}
        },
        {
            "prompt": "Generate AUTOSAR runnable entity with data access",
            "constraint_level": "mixed",
            "autosar_context": {"domain": "behavior"}
        }
    ]

    # 并发执行
    tasks = [client.generate_and_validate_full(**req) for req in requests]
    responses = await asyncio.gather(*tasks)

    # 结果处理
    successful_responses = [r for r in responses if r.success]
    print(f"✅ Successfully generated {len(successful_responses)}/{len(requests)} XML files")

    return successful_responses
```

#### 9.2.2 约束效果分析
```python
async def constraint_effectiveness_analysis():
    """约束效果分析示例"""

    client = FullAutosarClient(config)

    # 测试不同约束级别
    constraint_levels = ["simple", "mixed", "full"]
    results = {}

    for level in constraint_levels:
        response = await client.generate_and_validate_full(
            prompt="Generate AUTOSAR component with timing constraints",
            constraint_level=level,
            autosar_context={"domain": "timing"}
        )

        if response.success:
            effectiveness = client.analyze_constraint_effectiveness(response)
            results[level] = effectiveness

    # 生成分析报告
    print("Constraint Effectiveness Analysis:")
    print("=" * 50)

    for level, analysis in results.items():
        print(f"\n{level.upper()} Level:")
        print(f"  Effectiveness Score: {analysis['effectiveness_score']:.2f}")
        print(f"  Constraints Applied: {analysis['constraints_applied']}")
        print(f"  Violations: {len(analysis['constraint_violations'])}")
        print(f"  Validation Passed: {analysis['validation_passed']}")

    return results
```

### 9.3 故障排查指南

#### 9.3.1 常见问题诊断
```python
class DiagnosticTools:
    """诊断工具集"""

    @staticmethod
    async def diagnose_connection_issues(config: Dict):
        """诊断连接问题"""

        print("🔍 Diagnosing connection issues...")

        # 1. 网络连通性测试
        import aiohttp
        try:
            async with aiohttp.ClientSession() as session:
                async with session.get(f"{config['cloud_service']['internal_endpoint']}/health") as resp:
                    if resp.status == 200:
                        print("✅ Network connectivity: OK")
                    else:
                        print(f"❌ HTTP error: {resp.status}")
        except Exception as e:
            print(f"❌ Network error: {e}")

        # 2. 服务状态检查
        health_status = await CloudServiceClient(config).health_check()
        print(f"Service status: {health_status}")

        # 3. 约束文件检查
        artifacts_dir = Path(config["local_validation"]["artifacts_dir"])
        required_files = ["autosar.gbnf", "autosar.fsm", "autosar_shapes.ttl"]

        for file in required_files:
            file_path = artifacts_dir / "grammar" / file if file.endswith(".gbnf") else artifacts_dir / "raw" / file
            if file_path.exists():
                print(f"✅ {file}: Found ({file_path.stat().st_size} bytes)")
            else:
                print(f"❌ {file}: Missing")

    @staticmethod
    def diagnose_validation_issues(validation_result: ValidationResult):
        """诊断验证问题"""

        print("🔍 Diagnosing validation issues...")

        if validation_result.overall_valid:
            print("✅ All validations passed")
            return

        for stage_name, stage_info in validation_result.stages.items():
            if stage_info["executed"]:
                result = stage_info["result"]
                if result["valid"]:
                    print(f"✅ {stage_name}: Passed")
                else:
                    print(f"❌ {stage_name}: Failed - {result.get('error_info', 'Unknown error')}")
```

#### 9.3.2 问题解决方案
| 问题类型 | 症状 | 解决方案 |
|----------|------|----------|
| **连接超时** | 请求响应超时 | 增加timeout配置、检查网络 |
| **约束加载失败** | 约束文件不存在 | 检查artifacts目录、重新生成约束文件 |
| **验证失败** | XML结构错误 | 检查AUTOSAR元素、调整约束级别 |
| **内存不足** | 进程崩溃 | 减少并发数、增加max_tokens限制 |
| **模型服务异常** | 云端500错误 | 重启云端服务、检查GPU资源 |

---

## 10. 总结与展望

### 10.1 当前架构优势

1. **清晰的职责分离**: 本地负责约束和验证，云端专注推理计算
2. **灵活的约束策略**: 支持simple/mixed/full三级约束，适应不同场景
3. **完整的验证保障**: 三段式验证确保生成质量
4. **良好的扩展性**: 插件化设计支持功能扩展
5. **全面的监控**: 性能指标和错误处理机制完善

### 10.2 技术创新点

- **约束信息的结构化传输**: 通过ConstraintInfo模型实现约束的标准化传输
- **分级约束策略**: 根据场景需求动态选择约束强度
- **云端约束应用**: 在vLLM层面直接应用GBNF和FSM约束
- **三段式验证编排**: 结构→语义→约束的渐进式验证流程

### 10.3 后续优化方向

#### 10.3.1 短期优化 (1-2个月)
- **缓存机制**: 实现约束信息和生成结果的智能缓存
- **批量处理**: 支持多请求批量处理提升吞吐量
- **验证优化**: 并行执行语义和约束验证阶段

#### 10.3.2 中期扩展 (3-6个月)
- **多模型支持**: 支持不同的LLM后端 (Claude, GPT-4等)
- **智能约束选择**: 基于上下文自动选择最优约束策略
- **增量验证**: 实现增量式验证减少重复计算

#### 10.3.3 长期演进 (6-12个月)
- **强化学习优化**: 基于历史结果优化约束参数
- **多域扩展**: 支持OPC UA、DDS等其他工业标准
- **可视化调试**: 提供约束和验证过程的可视化工具

---

*本设计文档基于当前项目实际架构，为"本地客户端 → 云端vLLM → 本地验证"工作流提供了完整的技术方案和实施指导。*