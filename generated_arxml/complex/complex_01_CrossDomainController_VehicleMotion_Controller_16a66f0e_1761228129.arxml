<?xml version="1.0" ?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_4-2-2.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>Components</SHORT-NAME>
      <ELEMENTS>
        <APPLICATION-SW-COMPONENT-TYPE>
          <SHORT-NAME>VehicleMotion_Controller</SHORT-NAME>
          <PORTS>
            <P-PORT-PROTOTYPE>
              <SHORT-NAME>P_Chassis_Commands</SHORT-NAME>
              <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/Interfaces/IF_Chassis_Commands_SR</PROVIDED-INTERFACE-TREF>
            </P-PORT-PROTOTYPE>
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>R_Vehicle_State</SHORT-NAME>
              <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/Interfaces/IF_Vehicle_State_SR</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>R_Power_Status</SHORT-NAME>
              <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/Interfaces/IF_Power_Status_SR</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>R_Config_Params</SHORT-NAME>
              <REQUIRED-INTERFACE-TREF DEST="PARAMETER-INTERFACE">/Interfaces/IF_Config_Params_PI</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
          </PORTS>
          <INTERNAL-BEHAVIORS>
            <SWC-INTERNAL-BEHAVIOR>
              <SHORT-NAME>VehicleMotion_Controller_InternalBehavior</SHORT-NAME>
              <EVENTS>
                <DATA-RECEIVED-EVENT>
                  <SHORT-NAME>VMC_PowerStatus_Update</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/Components/VehicleMotion_Controller/VMC_Cycle_10ms</START-ON-EVENT-REF>
                </DATA-RECEIVED-EVENT>
                <INIT-EVENT>
                  <SHORT-NAME>VMC_InitEvent</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/Components/VehicleMotion_Controller/VMC_Init</START-ON-EVENT-REF>
                </INIT-EVENT>
                <TIMING-EVENT>
                  <SHORT-NAME>VMC_Cyclic_10ms</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/Components/VehicleMotion_Controller/VMC_Cycle_10ms</START-ON-EVENT-REF>
                  <PERIOD>10</PERIOD>
                </TIMING-EVENT>
              </EVENTS>
              <RUNNABLES>
                <RUNNABLE-ENTITY>
                  <SHORT-NAME>VMC_Init</SHORT-NAME>
                  <MINIMUM-START-INTERVAL>0</MINIMUM-START-INTERVAL>
                  <CAN-BE-INVOKED-CONCURRENTLY>false</CAN-BE-INVOKED-CONCURRENTLY>
                  <DATA-RECEIVE-POINT-BY-ARGUMENTS>
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>Read_Vehicle_Speed_Init</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/Components/VehicleMotion_Controller/R_Vehicle_State</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/Interfaces/IF_Vehicle_State_SR/IF_Vehicle_State_SR/vehicle_speed</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>Read_Steering_Angle_Init</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/Components/VehicleMotion_Controller/R_Vehicle_State</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/Interfaces/IF_Vehicle_State_SR/IF_Vehicle_State_SR/steering_angle</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                  </DATA-RECEIVE-POINT-BY-ARGUMENTS>
                  <DATA-SEND-POINTS>
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>Send_Torque_Request_Init</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="P-PORT-PROTOTYPE">/Components/VehicleMotion_Controller/P_Chassis_Commands</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/Interfaces/IF_Chassis_Commands_SR/IF_Chassis_Commands_SR/torque_request</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>Send_Steering_Cmd_Init</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="P-PORT-PROTOTYPE">/Components/VehicleMotion_Controller/P_Chassis_Commands</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/Interfaces/IF_Chassis_Commands_SR/IF_Chassis_Commands_SR/steering_cmd</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                  </DATA-SEND-POINTS>
                  <PARAMETER-ACCESSS>
                    <PARAMETER-ACCESS>
                      <SHORT-NAME>Access_Controller_Gains_Init</SHORT-NAME>
                      <ACCESSED-PARAMETER>
                        <AUTOSAR-PARAMETER-IREF>
                          <PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/Components/VehicleMotion_Controller/R_Config_Params</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="PARAMETER-DATA-PROTOTYPE">/Interfaces/IF_Config_Params_PI/IF_Config_Params_PI/controller_gains</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-PARAMETER-IREF>
                      </ACCESSED-PARAMETER>
                    </PARAMETER-ACCESS>
                    <PARAMETER-ACCESS>
                      <SHORT-NAME>Access_Limits_Init</SHORT-NAME>
                      <ACCESSED-PARAMETER>
                        <AUTOSAR-PARAMETER-IREF>
                          <PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/Components/VehicleMotion_Controller/R_Config_Params</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="PARAMETER-DATA-PROTOTYPE">/Interfaces/IF_Config_Params_PI/IF_Config_Params_PI/limits</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-PARAMETER-IREF>
                      </ACCESSED-PARAMETER>
                    </PARAMETER-ACCESS>
                    <PARAMETER-ACCESS>
                      <SHORT-NAME>Access_Security_Policy_Init</SHORT-NAME>
                      <ACCESSED-PARAMETER>
                        <AUTOSAR-PARAMETER-IREF>
                          <PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/Components/VehicleMotion_Controller/R_Config_Params</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="PARAMETER-DATA-PROTOTYPE">/Interfaces/IF_Config_Params_PI/IF_Config_Params_PI/security_policy</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-PARAMETER-IREF>
                      </ACCESSED-PARAMETER>
                    </PARAMETER-ACCESS>
                  </PARAMETER-ACCESSS>
                  <SYMBOL>VMC_Init</SYMBOL>
                </RUNNABLE-ENTITY>
                <RUNNABLE-ENTITY>
                  <SHORT-NAME>VMC_Cycle_10ms</SHORT-NAME>
                  <MINIMUM-START-INTERVAL>10</MINIMUM-START-INTERVAL>
                  <CAN-BE-INVOKED-CONCURRENTLY>false</CAN-BE-INVOKED-CONCURRENTLY>
                  <DATA-RECEIVE-POINT-BY-ARGUMENTS>
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>Read_Vehicle_Speed_Cycle</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/Components/VehicleMotion_Controller/R_Vehicle_State</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/Interfaces/IF_Vehicle_State_SR/IF_Vehicle_State_SR/vehicle_speed</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>Read_Yaw_Rate_Cycle</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/Components/VehicleMotion_Controller/R_Vehicle_State</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/Interfaces/IF_Vehicle_State_SR/IF_Vehicle_State_SR/yaw_rate</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>Read_Longitudinal_Accel_Cycle</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/Components/VehicleMotion_Controller/R_Vehicle_State</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/Interfaces/IF_Vehicle_State_SR/IF_Vehicle_State_SR/longitudinal_accel</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>Read_Steering_Angle_Cycle</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/Components/VehicleMotion_Controller/R_Vehicle_State</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/Interfaces/IF_Vehicle_State_SR/IF_Vehicle_State_SR/steering_angle</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>Read_SOC_Cycle</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/Components/VehicleMotion_Controller/R_Power_Status</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/Interfaces/IF_Power_Status_SR/IF_Power_Status_SR/soc</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>Read_Power_Available_Cycle</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/Components/VehicleMotion_Controller/R_Power_Status</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/Interfaces/IF_Power_Status_SR/IF_Power_Status_SR/power_available</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>Read_Regen_Limit_Cycle</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/Components/VehicleMotion_Controller/R_Power_Status</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/Interfaces/IF_Power_Status_SR/IF_Power_Status_SR/regen_limit</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>Read_Thermal_Derate_Cycle</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/Components/VehicleMotion_Controller/R_Power_Status</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/Interfaces/IF_Power_Status_SR/IF_Power_Status_SR/thermal_derate</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                  </DATA-RECEIVE-POINT-BY-ARGUMENTS>
                  <DATA-SEND-POINTS>
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>Send_Torque_Request_Cycle</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="P-PORT-PROTOTYPE">/Components/VehicleMotion_Controller/P_Chassis_Commands</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/Interfaces/IF_Chassis_Commands_SR/IF_Chassis_Commands_SR/torque_request</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>Send_Brake_Pressure_Cmd_Cycle</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="P-PORT-PROTOTYPE">/Components/VehicleMotion_Controller/P_Chassis_Commands</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/Interfaces/IF_Chassis_Commands_SR/IF_Chassis_Commands_SR/brake_pressure_cmd</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>Send_Steering_Cmd_Cycle</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="P-PORT-PROTOTYPE">/Components/VehicleMotion_Controller/P_Chassis_Commands</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/Interfaces/IF_Chassis_Commands_SR/IF_Chassis_Commands_SR/steering_cmd</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>Send_Suspension_Mode_Cycle</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="P-PORT-PROTOTYPE">/Components/VehicleMotion_Controller/P_Chassis_Commands</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/Interfaces/IF_Chassis_Commands_SR/IF_Chassis_Commands_SR/suspension_mode</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                  </DATA-SEND-POINTS>
                  <PARAMETER-ACCESSS>
                    <PARAMETER-ACCESS>
                      <SHORT-NAME>Access_Limits_Cycle</SHORT-NAME>
                      <ACCESSED-PARAMETER>
                        <AUTOSAR-PARAMETER-IREF>
                          <PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/Components/VehicleMotion_Controller/R_Config_Params</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="PARAMETER-DATA-PROTOTYPE">/Interfaces/IF_Config_Params_PI/IF_Config_Params_PI/limits</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-PARAMETER-IREF>
                      </ACCESSED-PARAMETER>
                    </PARAMETER-ACCESS>
                    <PARAMETER-ACCESS>
                      <SHORT-NAME>Access_Controller_Gains_Cycle</SHORT-NAME>
                      <ACCESSED-PARAMETER>
                        <AUTOSAR-PARAMETER-IREF>
                          <PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/Components/VehicleMotion_Controller/R_Config_Params</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="PARAMETER-DATA-PROTOTYPE">/Interfaces/IF_Config_Params_PI/IF_Config_Params_PI/controller_gains</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-PARAMETER-IREF>
                      </ACCESSED-PARAMETER>
                    </PARAMETER-ACCESS>
                  </PARAMETER-ACCESSS>
                  <SYMBOL>VMC_Cycle_10ms</SYMBOL>
                </RUNNABLE-ENTITY>
              </RUNNABLES>
            </SWC-INTERNAL-BEHAVIOR>
          </INTERNAL-BEHAVIORS>
        </APPLICATION-SW-COMPONENT-TYPE>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>