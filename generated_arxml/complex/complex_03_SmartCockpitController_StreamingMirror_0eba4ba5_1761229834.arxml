<?xml version="1.0" ?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_4-2-2.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>Components</SHORT-NAME>
      <ELEMENTS>
        <APPLICATION-SW-COMPONENT-TYPE>
          <SHORT-NAME>StreamingMirror</SHORT-NAME>
          <PORTS>
            <P-PORT-PROTOTYPE>
              <SHORT-NAME>P_Port_MirrorVideo</SHORT-NAME>
              <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/Interfaces/IF_Mirror_Video_SR/IF_Mirror_Video_SR</PROVIDED-INTERFACE-TREF>
            </P-PORT-PROTOTYPE>
          </PORTS>
          <INTERNAL-BEHAVIORS>
            <SWC-INTERNAL-BEHAVIOR>
              <SHORT-NAME>StreamingMirror_InternalBehavior</SHORT-NAME>
              <EVENTS>
                <INIT-EVENT>
                  <SHORT-NAME>Mirror_Init_Event</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/Components/StreamingMirror/Mirror_Init</START-ON-EVENT-REF>
                </INIT-EVENT>
                <TIMING-EVENT>
                  <SHORT-NAME>Mirror_Frame_Tick</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/Components/StreamingMirror/Mirror_Process_33ms</START-ON-EVENT-REF>
                  <PERIOD>33</PERIOD>
                </TIMING-EVENT>
              </EVENTS>
              <RUNNABLES>
                <RUNNABLE-ENTITY>
                  <SHORT-NAME>Mirror_Init</SHORT-NAME>
                  <MINIMUM-START-INTERVAL>0</MINIMUM-START-INTERVAL>
                  <CAN-BE-INVOKED-CONCURRENTLY>false</CAN-BE-INVOKED-CONCURRENTLY>
                  <DATA-SEND-POINTS/>
                  <PARAMETER-ACCESSS>
                    <PARAMETER-ACCESS>
                      <SHORT-NAME>PA_Read_Default_Channel</SHORT-NAME>
                      <ACCESSED-PARAMETER>
                        <AUTOSAR-PARAMETER-IREF>
                          <PORT-PROTOTYPE-REF DEST="P-PORT-PROTOTYPE">/Components/StreamingMirror/P_Port_MirrorVideo</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/Interfaces/IF_Mirror_Video_SR/IF_Mirror_Video_SR/Channel_Id</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-PARAMETER-IREF>
                      </ACCESSED-PARAMETER>
                    </PARAMETER-ACCESS>
                  </PARAMETER-ACCESSS>
                  <SYMBOL>Mirror_Init</SYMBOL>
                </RUNNABLE-ENTITY>
                <RUNNABLE-ENTITY>
                  <SHORT-NAME>Mirror_Process_33ms</SHORT-NAME>
                  <MINIMUM-START-INTERVAL>33</MINIMUM-START-INTERVAL>
                  <CAN-BE-INVOKED-CONCURRENTLY>false</CAN-BE-INVOKED-CONCURRENTLY>
                  <DATA-SEND-POINTS>
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>VA_Send_Mirror_Frame</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="P-PORT-PROTOTYPE">/Components/StreamingMirror/P_Port_MirrorVideo</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/Interfaces/IF_Mirror_Video_SR/IF_Mirror_Video_SR/Mirror_Frame</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>VA_Send_Channel_Id</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="P-PORT-PROTOTYPE">/Components/StreamingMirror/P_Port_MirrorVideo</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/Interfaces/IF_Mirror_Video_SR/IF_Mirror_Video_SR/Channel_Id</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>VA_Send_Timestamp</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="P-PORT-PROTOTYPE">/Components/StreamingMirror/P_Port_MirrorVideo</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/Interfaces/IF_Mirror_Video_SR/IF_Mirror_Video_SR/Timestamp</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                  </DATA-SEND-POINTS>
                  <PARAMETER-ACCESSS>
                    <PARAMETER-ACCESS>
                      <SHORT-NAME>PA_Read_Current_Channel</SHORT-NAME>
                      <ACCESSED-PARAMETER>
                        <AUTOSAR-PARAMETER-IREF>
                          <PORT-PROTOTYPE-REF DEST="P-PORT-PROTOTYPE">/Components/StreamingMirror/P_Port_MirrorVideo</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/Interfaces/IF_Mirror_Video_SR/IF_Mirror_Video_SR/Channel_Id</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-PARAMETER-IREF>
                      </ACCESSED-PARAMETER>
                    </PARAMETER-ACCESS>
                  </PARAMETER-ACCESSS>
                  <SYMBOL>Mirror_Process_33ms</SYMBOL>
                </RUNNABLE-ENTITY>
              </RUNNABLES>
            </SWC-INTERNAL-BEHAVIOR>
          </INTERNAL-BEHAVIORS>
        </APPLICATION-SW-COMPONENT-TYPE>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>