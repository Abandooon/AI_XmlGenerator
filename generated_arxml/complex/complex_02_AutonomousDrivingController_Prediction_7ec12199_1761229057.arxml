                        </AUTOSAR-VARIABLE-IN-IMPL-DATATYPE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/Components/Prediction/R_Port_Tracked_Objects</PORT-PROTOTYPE-REF>
