            </P-PORT-PROTOTYPE>
            <P-PORT-PROTOTYPE>
              <SHORT-NAME>P_Port_Failsafe_Status</SHORT-NAME>
              <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/Interfaces/IF_Failsafe_Commands/IF_Failsafe_Commands</PROVIDED-INTERFACE-TREF>
            </P-PORT-PROTOTYPE>
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>R_Port_SensorHub_In</SHORT-NAME>
              <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/Interfaces/IF_Sensor_Hub_To_Sensor_Fusion/IF_Sensor_Hub_To_Sensor_Fusion</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
