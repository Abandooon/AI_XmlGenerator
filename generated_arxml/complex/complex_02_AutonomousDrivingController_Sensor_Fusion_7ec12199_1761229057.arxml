              <SHORT-NAME>Sensor_Fusion_InternalBehavior</SHORT-NAME>
              <EVENTS>
                <INIT-EVENT>
                  <SHORT-NAME>Sensor_Fusion_Init</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/Components/Sensor_Fusion/Init_Sensor_Fusion</START-ON-EVENT-REF>
                </INIT-EVENT>
                <TIMING-EVENT>
                  <SHORT-NAME>Sensor_Fusion_10ms</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/Components/Sensor_Fusion/Fuse_Measurements_10ms</START-ON-EVENT-REF>
                  <PERIOD>10</PERIOD>
                </TIMING-EVENT>
                <TIMING-EVENT>
                  <SHORT-NAME>Sensor_Fusion_100ms</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/Components/Sensor_Fusion/Publish_Status_100ms</START-ON-EVENT-REF>
                  <PERIOD>100</PERIOD>
                </TIMING-EVENT>
              </EVENTS>
