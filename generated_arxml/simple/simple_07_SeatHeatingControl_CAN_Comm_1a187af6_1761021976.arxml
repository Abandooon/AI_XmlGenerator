<?xml version="1.0" ?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_4-2-2.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>Components</SHORT-NAME>
      <ELEMENTS>
        <APPLICATION-SW-COMPONENT-TYPE>
          <SHORT-NAME>CAN_Comm</SHORT-NAME>
          <PORTS>
            <P-PORT-PROTOTYPE>
              <SHORT-NAME>CanTxPort</SHORT-NAME>
              <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/Interfaces/CAN_Message_Interface</PROVIDED-INTERFACE-TREF>
            </P-PORT-PROTOTYPE>
            <P-PORT-PROTOTYPE>
              <SHORT-NAME>HeatCmd_Server_Port</SHORT-NAME>
              <PROVIDED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/Interfaces/HeatCmd_ClientServer</PROVIDED-INTERFACE-TREF>
            </P-PORT-PROTOTYPE>
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>CanRxPort</SHORT-NAME>
              <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/Interfaces/CAN_Message_Interface</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
          </PORTS>
          <INTERNAL-BEHAVIORS>
            <SWC-INTERNAL-BEHAVIOR>
              <SHORT-NAME>CAN_Comm_Behavior</SHORT-NAME>
              <EVENTS>
                <DATA-RECEIVE-ERROR-EVENT>
                  <SHORT-NAME>CAN_Rx_Error</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/Components/Temperature_Sensor/Temperature_Sensor_Behavior/Read_Sensors_Runnable</START-ON-EVENT-REF>
                </DATA-RECEIVE-ERROR-EVENT>
                <DATA-SEND-COMPLETED-EVENT>
                  <SHORT-NAME>CAN_Tx_Completed</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/Components/Temperature_Sensor/Temperature_Sensor_Behavior/Read_Sensors_Runnable</START-ON-EVENT-REF>
                  <EVENT-SOURCE-REF DEST="VARIABLE-ACCESS">/Components/CAN_Comm/SWC-INTERNAL-BEHAVIOR/TxHandler_Runnable/DATA-SEND-POINTS/VARIABLE-ACCESS/Tx_Status_Access</EVENT-SOURCE-REF>
                </DATA-SEND-COMPLETED-EVENT>
                <EXTERNAL-TRIGGER-OCCURRED-EVENT>
                  <SHORT-NAME>CAN_Frame_Received</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/Components/Temperature_Sensor/Temperature_Sensor_Behavior/Read_Sensors_Runnable</START-ON-EVENT-REF>
                </EXTERNAL-TRIGGER-OCCURRED-EVENT>
              </EVENTS>
              <RUNNABLES>
                <RUNNABLE-ENTITY>
                  <SHORT-NAME>RxHandler_Runnable</SHORT-NAME>
                  <MINIMUM-START-INTERVAL>50</MINIMUM-START-INTERVAL>
                  <CAN-BE-INVOKED-CONCURRENTLY>false</CAN-BE-INVOKED-CONCURRENTLY>
                  <DATA-RECEIVE-POINT-BY-ARGUMENTS>
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>Rx_CanFrame_Access</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/Components/CAN_Comm/Ports/CanRxPort</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="AUTOSAR-DATA-PROTOTYPE">/DataTypes/Set_Level_Command</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                  </DATA-RECEIVE-POINT-BY-ARGUMENTS>
                  <DATA-SEND-POINTS>
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>Forward_Command_Access</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="P-PORT-PROTOTYPE">/Components/CAN_Comm/Ports/CanTxPort</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="AUTOSAR-DATA-PROTOTYPE">/DataTypes/Set_Level_Command</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                  </DATA-SEND-POINTS>
                  <SERVER-CALL-POINTS>
                    <ASYNCHRONOUS-SERVER-CALL-POINT>
                      <SHORT-NAME>CanDriver_Rx_Call</SHORT-NAME>
                      <OPERATION-IREF>
                        <CONTEXT-R-PORT-REF DEST="R-PORT-PROTOTYPE">/Components/CAN_Driver/Ports/CanDriver_R</CONTEXT-R-PORT-REF>
                        <TARGET-REQUIRED-OPERATION-REF DEST="CLIENT-SERVER-OPERATION">/Services/CAN_Driver/RxOperation</TARGET-REQUIRED-OPERATION-REF>
                      </OPERATION-IREF>
                      <TIMEOUT>50</TIMEOUT>
                    </ASYNCHRONOUS-SERVER-CALL-POINT>
                  </SERVER-CALL-POINTS>
                  <SYMBOL>CAN_Comm.RxHandler</SYMBOL>
                </RUNNABLE-ENTITY>
                <RUNNABLE-ENTITY>
                  <SHORT-NAME>TxHandler_Runnable</SHORT-NAME>
                  <MINIMUM-START-INTERVAL>1000</MINIMUM-START-INTERVAL>
                  <CAN-BE-INVOKED-CONCURRENTLY>false</CAN-BE-INVOKED-CONCURRENTLY>
                  <DATA-RECEIVE-POINT-BY-ARGUMENTS>
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>Tx_Status_Input_Access</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="P-PORT-PROTOTYPE">/Components/CAN_Comm/Ports/CanTxPort</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="AUTOSAR-DATA-PROTOTYPE">/DataTypes/Heater_Status_Report</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                  </DATA-RECEIVE-POINT-BY-ARGUMENTS>
                  <DATA-SEND-POINTS>
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>Tx_Status_Access</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="P-PORT-PROTOTYPE">/Components/CAN_Comm/Ports/CanTxPort</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="AUTOSAR-DATA-PROTOTYPE">/DataTypes/Heater_Status_Report</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                  </DATA-SEND-POINTS>
                  <SERVER-CALL-POINTS>
                    <ASYNCHRONOUS-SERVER-CALL-POINT>
                      <SHORT-NAME>CanDriver_Send_Call</SHORT-NAME>
                      <OPERATION-IREF>
                        <CONTEXT-R-PORT-REF DEST="R-PORT-PROTOTYPE">/Components/CAN_Driver/Ports/CanDriver_R</CONTEXT-R-PORT-REF>
                        <TARGET-REQUIRED-OPERATION-REF DEST="CLIENT-SERVER-OPERATION">/Services/CAN_Driver/SendOperation</TARGET-REQUIRED-OPERATION-REF>
                      </OPERATION-IREF>
                      <TIMEOUT>50</TIMEOUT>
                    </ASYNCHRONOUS-SERVER-CALL-POINT>
                  </SERVER-CALL-POINTS>
                  <SYMBOL>CAN_Comm.TxHandler</SYMBOL>
                </RUNNABLE-ENTITY>
              </RUNNABLES>
            </SWC-INTERNAL-BEHAVIOR>
          </INTERNAL-BEHAVIORS>
        </APPLICATION-SW-COMPONENT-TYPE>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>