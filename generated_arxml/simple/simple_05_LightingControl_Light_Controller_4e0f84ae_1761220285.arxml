                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="P-PORT-PROTOTYPE">/Components/Light_Controller/P_IF_PWM_Control</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/Interfaces/IF_PWM_Control/IF_PWM_Control/tail_lamp_duty_setpoint</TARGET-DATA-PROTOTYPE-REF>
