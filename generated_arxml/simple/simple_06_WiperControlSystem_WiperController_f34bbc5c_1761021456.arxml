<?xml version="1.0" ?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_4-2-2.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>Components</SHORT-NAME>
      <ELEMENTS>
        <APPLICATION-SW-COMPONENT-TYPE>
          <SHORT-NAME>WiperController</SHORT-NAME>
          <PORTS>
            <P-PORT-PROTOTYPE>
              <SHORT-NAME>State_Output</SHORT-NAME>
              <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/Interfaces/RainSensor_To_WiperController</PROVIDED-INTERFACE-TREF>
            </P-PORT-PROTOTYPE>
            <PR-PORT-PROTOTYPE>
              <SHORT-NAME>Motor_PR</SHORT-NAME>
              <PROVIDED-REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/Interfaces/WiperControl_To_MotorDriver</PROVIDED-REQUIRED-INTERFACE-TREF>
            </PR-PORT-PROTOTYPE>
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>RainSensor_R</SHORT-NAME>
              <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/Interfaces/RainSensor_To_WiperController</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>CAN_R</SHORT-NAME>
              <REQUIRED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/Interfaces/CAN_User_Settings</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>MotorClient_R</SHORT-NAME>
              <REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/Interfaces/WiperControl_To_MotorDriver</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
          </PORTS>
          <INTERNAL-BEHAVIORS>
            <SWC-INTERNAL-BEHAVIOR>
              <SHORT-NAME>WiperController_Behavior</SHORT-NAME>
              <EVENTS>
                <DATA-RECEIVED-EVENT>
                  <SHORT-NAME>RainDataReceived</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/Components/RainSensor/RainSensor_Behavior/Sensor_Read_Runnable</START-ON-EVENT-REF>
                </DATA-RECEIVED-EVENT>
                <EXTERNAL-TRIGGER-OCCURRED-EVENT>
                  <SHORT-NAME>CANSettingsReceived</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/Components/RainSensor/RainSensor_Behavior/Sensor_Read_Runnable</START-ON-EVENT-REF>
                </EXTERNAL-TRIGGER-OCCURRED-EVENT>
                <TIMING-EVENT>
                  <SHORT-NAME>ControlCycleEvent</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/Components/RainSensor/RainSensor_Behavior/Sensor_Read_Runnable</START-ON-EVENT-REF>
                  <PERIOD>100</PERIOD>
                </TIMING-EVENT>
              </EVENTS>
              <RUNNABLES>
                <RUNNABLE-ENTITY>
                  <SHORT-NAME>Can_Rx_Runnable</SHORT-NAME>
                  <MINIMUM-START-INTERVAL>50</MINIMUM-START-INTERVAL>
                  <CAN-BE-INVOKED-CONCURRENTLY>false</CAN-BE-INVOKED-CONCURRENTLY>
                  <DATA-RECEIVE-POINT-BY-ARGUMENTS>
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>CanInputVar</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/Components/WiperController/Ports/CAN_R</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/DataPrototypes/CanUserSettings</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                        <LOCAL-VARIABLE-REF DEST="VARIABLE-DATA-PROTOTYPE">/Components/WiperController/LocalVariables/CanSettings</LOCAL-VARIABLE-REF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                  </DATA-RECEIVE-POINT-BY-ARGUMENTS>
                  <DATA-RECEIVE-POINT-BY-VALUES>
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>CanInputVal</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/Components/WiperController/Ports/CAN_R</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/DataPrototypes/CanUserSettings</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                        <LOCAL-VARIABLE-REF DEST="VARIABLE-DATA-PROTOTYPE">/Components/WiperController/LocalVariables/CanSettings</LOCAL-VARIABLE-REF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                  </DATA-RECEIVE-POINT-BY-VALUES>
                  <MODE-SWITCH-POINTS>
                    <MODE-SWITCH-POINT>
                      <SHORT-NAME>ModeSwitchPoint_CAN</SHORT-NAME>
                      <MODE-GROUP-IREF>
                        <CONTEXT-P-PORT-REF DEST="P-PORT-PROTOTYPE">/Components/WiperController/Ports/State_Output</CONTEXT-P-PORT-REF>
                        <TARGET-MODE-GROUP-REF DEST="MODE-DECLARATION-GROUP-PROTOTYPE">/Components/WiperController/ModeGroups/WiperModeGroup</TARGET-MODE-GROUP-REF>
                      </MODE-GROUP-IREF>
                    </MODE-SWITCH-POINT>
                  </MODE-SWITCH-POINTS>
                  <SYMBOL>WIPER_CAN_RX</SYMBOL>
                </RUNNABLE-ENTITY>
                <RUNNABLE-ENTITY>
                  <SHORT-NAME>Sensor_Process_Runnable</SHORT-NAME>
                  <MINIMUM-START-INTERVAL>50</MINIMUM-START-INTERVAL>
                  <CAN-BE-INVOKED-CONCURRENTLY>false</CAN-BE-INVOKED-CONCURRENTLY>
                  <DATA-RECEIVE-POINT-BY-ARGUMENTS>
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>RainArg</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/Components/WiperController/Ports/RainSensor_R</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/DataPrototypes/rain_level</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                        <LOCAL-VARIABLE-REF DEST="VARIABLE-DATA-PROTOTYPE">/Components/WiperController/LocalVariables/BufferedRainLevel</LOCAL-VARIABLE-REF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                  </DATA-RECEIVE-POINT-BY-ARGUMENTS>
                  <DATA-RECEIVE-POINT-BY-VALUES>
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>RainVal</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/Components/WiperController/Ports/RainSensor_R</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/DataPrototypes/rain_level</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                        <LOCAL-VARIABLE-REF DEST="VARIABLE-DATA-PROTOTYPE">/Components/WiperController/LocalVariables/BufferedRainLevel</LOCAL-VARIABLE-REF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                  </DATA-RECEIVE-POINT-BY-VALUES>
                  <MODE-SWITCH-POINTS>
                    <MODE-SWITCH-POINT>
                      <SHORT-NAME>ModeSwitchPoint_Sensor</SHORT-NAME>
                      <MODE-GROUP-IREF>
                        <CONTEXT-P-PORT-REF DEST="P-PORT-PROTOTYPE">/Components/WiperController/Ports/State_Output</CONTEXT-P-PORT-REF>
                        <TARGET-MODE-GROUP-REF DEST="MODE-DECLARATION-GROUP-PROTOTYPE">/Components/WiperController/ModeGroups/WiperModeGroup</TARGET-MODE-GROUP-REF>
                      </MODE-GROUP-IREF>
                    </MODE-SWITCH-POINT>
                  </MODE-SWITCH-POINTS>
                  <SYMBOL>WIPER_SENSOR_PROC</SYMBOL>
                </RUNNABLE-ENTITY>
                <RUNNABLE-ENTITY>
                  <SHORT-NAME>Mode_Manager_Runnable</SHORT-NAME>
                  <MINIMUM-START-INTERVAL>100</MINIMUM-START-INTERVAL>
                  <CAN-BE-INVOKED-CONCURRENTLY>false</CAN-BE-INVOKED-CONCURRENTLY>
                  <DATA-RECEIVE-POINT-BY-ARGUMENTS>
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>ModeInput</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/Components/WiperController/Ports/CAN_R</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/DataPrototypes/CanUserSettings</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                        <LOCAL-VARIABLE-REF DEST="VARIABLE-DATA-PROTOTYPE">/Components/WiperController/LocalVariables/CurrentMode</LOCAL-VARIABLE-REF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                  </DATA-RECEIVE-POINT-BY-ARGUMENTS>
                  <DATA-RECEIVE-POINT-BY-VALUES>
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>ModeVal</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/Components/WiperController/Ports/CAN_R</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/DataPrototypes/CanUserSettings</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                        <LOCAL-VARIABLE-REF DEST="VARIABLE-DATA-PROTOTYPE">/Components/WiperController/LocalVariables/CurrentMode</LOCAL-VARIABLE-REF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                  </DATA-RECEIVE-POINT-BY-VALUES>
                  <MODE-SWITCH-POINTS>
                    <MODE-SWITCH-POINT>
                      <SHORT-NAME>ModeSwitchPoint_Manager</SHORT-NAME>
                      <MODE-GROUP-IREF>
                        <CONTEXT-P-PORT-REF DEST="P-PORT-PROTOTYPE">/Components/WiperController/Ports/State_Output</CONTEXT-P-PORT-REF>
                        <TARGET-MODE-GROUP-REF DEST="MODE-DECLARATION-GROUP-PROTOTYPE">/Components/WiperController/ModeGroups/WiperModeGroup</TARGET-MODE-GROUP-REF>
                      </MODE-GROUP-IREF>
                    </MODE-SWITCH-POINT>
                  </MODE-SWITCH-POINTS>
                  <SYMBOL>WIPER_MODE_MGR</SYMBOL>
                </RUNNABLE-ENTITY>
                <RUNNABLE-ENTITY>
                  <SHORT-NAME>Control_Logic_Runnable</SHORT-NAME>
                  <MINIMUM-START-INTERVAL>100</MINIMUM-START-INTERVAL>
                  <CAN-BE-INVOKED-CONCURRENTLY>false</CAN-BE-INVOKED-CONCURRENTLY>
                  <DATA-RECEIVE-POINT-BY-ARGUMENTS>
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>ControlArgs</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/Components/WiperController/Ports/RainSensor_R</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/DataPrototypes/rain_level</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                        <LOCAL-VARIABLE-REF DEST="VARIABLE-DATA-PROTOTYPE">/Components/WiperController/LocalVariables/FilteredRainLevel</LOCAL-VARIABLE-REF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                  </DATA-RECEIVE-POINT-BY-ARGUMENTS>
                  <DATA-RECEIVE-POINT-BY-VALUES>
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>ControlVals</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="R-PORT-PROTOTYPE">/Components/WiperController/Ports/CAN_R</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/DataPrototypes/CanUserSettings</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                        <LOCAL-VARIABLE-REF DEST="VARIABLE-DATA-PROTOTYPE">/Components/WiperController/LocalVariables/TargetSpeed</LOCAL-VARIABLE-REF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                  </DATA-RECEIVE-POINT-BY-VALUES>
                  <MODE-SWITCH-POINTS>
                    <MODE-SWITCH-POINT>
                      <SHORT-NAME>ModeSwitchPoint_Control</SHORT-NAME>
                      <MODE-GROUP-IREF>
                        <CONTEXT-P-PORT-REF DEST="P-PORT-PROTOTYPE">/Components/WiperController/Ports/State_Output</CONTEXT-P-PORT-REF>
                        <TARGET-MODE-GROUP-REF DEST="MODE-DECLARATION-GROUP-PROTOTYPE">/Components/WiperController/ModeGroups/WiperModeGroup</TARGET-MODE-GROUP-REF>
                      </MODE-GROUP-IREF>
                    </MODE-SWITCH-POINT>
                  </MODE-SWITCH-POINTS>
                  <SERVER-CALL-POINTS>
                    <SYNCHRONOUS-SERVER-CALL-POINT>
                      <SHORT-NAME>CallMotorDriver</SHORT-NAME>
                      <CALLED-FROM-WITHIN-EXCLUSIVE-AREA-REF DEST="EXCLUSIVE-AREA-NESTING-ORDER">/ExclusiveAreas/WiperControllerEA</CALLED-FROM-WITHIN-EXCLUSIVE-AREA-REF>
                      <OPERATION-IREF>
                        <CONTEXT-R-PORT-REF DEST="R-PORT-PROTOTYPE">/Components/WiperController/Ports/MotorClient_R</CONTEXT-R-PORT-REF>
                        <TARGET-REQUIRED-OPERATION-REF DEST="CLIENT-SERVER-OPERATION">/Interfaces/WiperControl_To_MotorDriver/Operations/ControlCommand</TARGET-REQUIRED-OPERATION-REF>
                      </OPERATION-IREF>
                      <TIMEOUT>20</TIMEOUT>
                    </SYNCHRONOUS-SERVER-CALL-POINT>
                  </SERVER-CALL-POINTS>
                  <SYMBOL>WIPER_CTRL_LOGIC</SYMBOL>
                </RUNNABLE-ENTITY>
              </RUNNABLES>
            </SWC-INTERNAL-BEHAVIOR>
          </INTERNAL-BEHAVIORS>
        </APPLICATION-SW-COMPONENT-TYPE>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>