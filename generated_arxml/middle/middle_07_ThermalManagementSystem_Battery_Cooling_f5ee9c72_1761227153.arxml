                    <VARIABLE-ACCESS>
                      <SHORT-NAME>VA_Rcv_TargetBatteryFlow_Cycle</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
