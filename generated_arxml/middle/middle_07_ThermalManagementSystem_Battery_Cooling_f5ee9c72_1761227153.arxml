                  <MODE-ACCESS-POINTS>
                    <MODE-ACCESS-POINT>
                      <MODE-GROUP-IREF>
                        <R-MODE-GROUP-IN-ATOMIC-SWC-INSTANCE-REF>
                          <CONTEXT-R-PORT-REF DEST="R-PORT-PROTOTYPE">/Components/Battery_Cooling/R_Thermal_Mode</CONTEXT-R-PORT-REF>
                          <TARGET-MODE-GROUP-REF DEST="MODE-DECLARATION-GROUP-PROTOTYPE">/Interfaces/IF_Thermal_Mode/IF_Thermal_Mode/ThermalModeGroup</TARGET-MODE-GROUP-REF>
                        </R-MODE-GROUP-IN-ATOMIC-SWC-INSTANCE-REF>
                      </MODE-GROUP-IREF>
                    </MODE-ACCESS-POINT>
                  </MODE-ACCESS-POINTS>
                  <SERVER-CALL-POINTS>
