<?xml version="1.0" ?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_4-2-2.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>Components</SHORT-NAME>
      <ELEMENTS>
        <APPLICATION-SW-COMPONENT-TYPE>
          <SHORT-NAME>ActuationInterface</SHORT-NAME>
          <PORTS>
            <P-PORT-PROTOTYPE>
              <SHORT-NAME>StatusPubPort</SHORT-NAME>
              <PROVIDED-INTERFACE-TREF DEST="SENDER-RECEIVER-INTERFACE">/Interfaces/System_Status_to_HMI_SR</PROVIDED-INTERFACE-TREF>
            </P-PORT-PROTOTYPE>
            <PR-PORT-PROTOTYPE>
              <SHORT-NAME>PlannerServerPort</SHORT-NAME>
              <PROVIDED-REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/Interfaces/Planner_to_Actuation_CS</PROVIDED-REQUIRED-INTERFACE-TREF>
            </PR-PORT-PROTOTYPE>
            <R-PORT-PROTOTYPE>
              <SHORT-NAME>ParameterClientPort</SHORT-NAME>
              <REQUIRED-INTERFACE-TREF DEST="CLIENT-SERVER-INTERFACE">/Interfaces/Parameter_Service_CS</REQUIRED-INTERFACE-TREF>
            </R-PORT-PROTOTYPE>
          </PORTS>
          <INTERNAL-BEHAVIORS>
            <SWC-INTERNAL-BEHAVIOR>
              <SHORT-NAME>ActuationInterface_Behavior</SHORT-NAME>
              <EVENTS>
                <DATA-SEND-COMPLETED-EVENT>
                  <SHORT-NAME>CAN_Tx_Completed</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/Components/PathPlanner/PathPlanner_Behavior/Planner_Main_Runnable</START-ON-EVENT-REF>
                  <EVENT-SOURCE-REF DEST="VARIABLE-ACCESS">/Components/ActuationInterface/ActuationInterface_Behavior/Actuation_Server_Runnable/Write_ActuationAck</EVENT-SOURCE-REF>
                </DATA-SEND-COMPLETED-EVENT>
                <OPERATION-INVOKED-EVENT>
                  <SHORT-NAME>Actuation_Command_Invoked</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/Components/PathPlanner/PathPlanner_Behavior/Planner_Main_Runnable</START-ON-EVENT-REF>
                  <OPERATION-IREF>
                    <CONTEXT-P-PORT-REF DEST="PR-PORT-PROTOTYPE">/Components/ActuationInterface/Ports/PlannerServerPort</CONTEXT-P-PORT-REF>
                    <TARGET-PROVIDED-OPERATION-REF DEST="CLIENT-SERVER-OPERATION">/Interfaces/Planner_to_Actuation_CS/Operations/SendControl</TARGET-PROVIDED-OPERATION-REF>
                  </OPERATION-IREF>
                </OPERATION-INVOKED-EVENT>
                <TRANSFORMER-HARD-ERROR-EVENT>
                  <SHORT-NAME>Actuation_Fault</SHORT-NAME>
                  <START-ON-EVENT-REF DEST="RUNNABLE-ENTITY">/Components/PathPlanner/PathPlanner_Behavior/Planner_Main_Runnable</START-ON-EVENT-REF>
                  <OPERATION-IREF>
                    <CONTEXT-P-PORT-REF DEST="PR-PORT-PROTOTYPE">/Components/ActuationInterface/Ports/PlannerServerPort</CONTEXT-P-PORT-REF>
                    <TARGET-PROVIDED-OPERATION-REF DEST="CLIENT-SERVER-OPERATION">/Interfaces/Planner_to_Actuation_CS/Operations/ReportFault</TARGET-PROVIDED-OPERATION-REF>
                  </OPERATION-IREF>
                </TRANSFORMER-HARD-ERROR-EVENT>
              </EVENTS>
              <RUNNABLES>
                <RUNNABLE-ENTITY>
                  <SHORT-NAME>Actuation_Server_Runnable</SHORT-NAME>
                  <MINIMUM-START-INTERVAL>25</MINIMUM-START-INTERVAL>
                  <CAN-BE-INVOKED-CONCURRENTLY>false</CAN-BE-INVOKED-CONCURRENTLY>
                  <DATA-WRITE-ACCESSS>
                    <VARIABLE-ACCESS>
                      <SHORT-NAME>Write_ActuationAck</SHORT-NAME>
                      <ACCESSED-VARIABLE>
                        <AUTOSAR-VARIABLE-IREF>
                          <PORT-PROTOTYPE-REF DEST="P-PORT-PROTOTYPE">/Components/ActuationInterface/Ports/StatusPubPort</PORT-PROTOTYPE-REF>
                          <TARGET-DATA-PROTOTYPE-REF DEST="AUTOSAR-DATA-PROTOTYPE">/DataPrototypes/ActuationAck</TARGET-DATA-PROTOTYPE-REF>
                        </AUTOSAR-VARIABLE-IREF>
                      </ACCESSED-VARIABLE>
                    </VARIABLE-ACCESS>
                  </DATA-WRITE-ACCESSS>
                  <SERVER-CALL-POINTS>
                    <SYNCHRONOUS-SERVER-CALL-POINT>
                      <SHORT-NAME>Planner_Control_CallPoint</SHORT-NAME>
                      <OPERATION-IREF>
                        <CONTEXT-R-PORT-REF DEST="PR-PORT-PROTOTYPE">/Components/ActuationInterface/Ports/PlannerServerPort</CONTEXT-R-PORT-REF>
                        <TARGET-REQUIRED-OPERATION-REF DEST="CLIENT-SERVER-OPERATION">/Interfaces/Planner_to_Actuation_CS/Operations/SendControl</TARGET-REQUIRED-OPERATION-REF>
                      </OPERATION-IREF>
                      <TIMEOUT>100</TIMEOUT>
                    </SYNCHRONOUS-SERVER-CALL-POINT>
                  </SERVER-CALL-POINTS>
                  <SYMBOL>ActuationInterface_Actuation_Server_Runnable</SYMBOL>
                </RUNNABLE-ENTITY>
              </RUNNABLES>
            </SWC-INTERNAL-BEHAVIOR>
          </INTERNAL-BEHAVIORS>
        </APPLICATION-SW-COMPONENT-TYPE>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>